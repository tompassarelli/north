#lang beagle

(ns north.scheduled-run-core-fixture
  (:require [north.scheduled-run-core :as run]))

(def origin run/OriginIdentity
  (run/->OriginIdentity "nightly-retention" "2026-08-20T10:00:00Z"))

(def predecessor run/PredecessorOutput
  (run/->PredecessorOutput "prepare-42" "receipt-prepare-42"))

(def dedupe run/DedupeIdentity
  (run/->DedupeIdentity origin 42))

(def scheduled-run run/ScheduledRun
  (run/->ScheduledRun
   "retention-42"
   origin
   predecessor
   7
   "worker-a"
   100
   "receipt-dispatched-42"
   dedupe))

(def request run/ReclaimRequest
  (run/->ReclaimRequest "retention-42" 7 "worker-a" "worker-b" 200 nil))

(def decision run/ReclamationDecision
  (run/stale-owner-reclamation scheduled-run request 101))

(def reclaimed Bool (run/reclamationdecision-accepted decision))
(def replacement run/ScheduledRun? (run/reclamationdecision-replacement decision))

(def terminal-evidence run/TerminalEvidence
  (run/->TerminalEvidence
   "retention-42"
   7
   "worker-a"
   dedupe
   "receipt-terminal-42"))

(def terminal-request run/ReclaimRequest
  (run/->ReclaimRequest
   "retention-42"
   7
   "worker-a"
   "worker-b"
   200
   terminal-evidence))

(def terminal-decision run/ReclamationDecision
  (run/stale-owner-reclamation scheduled-run terminal-request 99))

(def terminal-reclaimed-before-expiry Bool
  (and (run/reclamationdecision-accepted terminal-decision)
       (and (nil? (run/reclamationdecision-replacement terminal-decision))
            (and (= terminal-evidence
                    (run/reclamationdecision-terminal-evidence terminal-decision))
                 (= :terminal-claim-released
                    (run/reclamationdecision-reason terminal-decision))))))

(def previous-occurrence-evidence run/TerminalEvidence
  (run/->TerminalEvidence
   "retention-42"
   7
   "worker-a"
   (run/->DedupeIdentity origin 41)
   "receipt-terminal-41"))

(def previous-occurrence-request run/ReclaimRequest
  (run/->ReclaimRequest
   "retention-42"
   7
   "worker-a"
   "worker-b"
   200
   previous-occurrence-evidence))

(def previous-occurrence-decision run/ReclamationDecision
  (run/stale-owner-reclamation scheduled-run previous-occurrence-request 99))

(def previous-occurrence-rejected Bool
  (and (not (run/reclamationdecision-accepted previous-occurrence-decision))
       (= :terminal-evidence-mismatch
          (run/reclamationdecision-reason previous-occurrence-decision))))

(def wrong-revision-evidence run/TerminalEvidence
  (run/->TerminalEvidence
   "retention-42"
   6
   "worker-a"
   dedupe
   "receipt-terminal-42"))

(def wrong-revision-request run/ReclaimRequest
  (run/->ReclaimRequest
   "retention-42"
   7
   "worker-a"
   "worker-b"
   200
   wrong-revision-evidence))

(def wrong-revision-decision run/ReclamationDecision
  (run/stale-owner-reclamation scheduled-run wrong-revision-request 99))

(def wrong-revision-rejected Bool
  (and (not (run/reclamationdecision-accepted wrong-revision-decision))
       (= :terminal-evidence-mismatch
          (run/reclamationdecision-reason wrong-revision-decision))))

(def wrong-owner-evidence run/TerminalEvidence
  (run/->TerminalEvidence
   "retention-42"
   7
   "worker-z"
   dedupe
   "receipt-terminal-42"))

(def wrong-owner-request run/ReclaimRequest
  (run/->ReclaimRequest
   "retention-42"
   7
   "worker-a"
   "worker-b"
   200
   wrong-owner-evidence))

(def wrong-owner-decision run/ReclamationDecision
  (run/stale-owner-reclamation scheduled-run wrong-owner-request 99))

(def wrong-owner-rejected Bool
  (and (not (run/reclamationdecision-accepted wrong-owner-decision))
       (= :terminal-evidence-mismatch
          (run/reclamationdecision-reason wrong-owner-decision))))

(def expired-lease-fallback Bool
  (and reclaimed
       (and (some? replacement)
            (and (nil? (run/reclamationdecision-terminal-evidence decision))
                 (= :stale-owner-reclaimed
                    (run/reclamationdecision-reason decision))))))

(def all-reclamation-cases Bool
  (and terminal-reclaimed-before-expiry
       (and previous-occurrence-rejected
            (and wrong-revision-rejected
                 (and wrong-owner-rejected expired-lease-fallback)))))
