#!/usr/bin/env bash
# job-run [--path DIRS] [--user USER] [--notify] NAME -- CMD...: record a scheduled job's start and finish in
# NorthThreads' job_runs (name, host, started, finished, rc), run CMD and exit with its code.
# Recording never changes the job's result: the start record runs beside CMD and stops when CMD ends,
# and the finish record, which writes the whole row, spools when the ledger host is slow.
#   --path DIRS  prepended to PATH for the threads calls only (python3, ssh, timeout); bash's own directory is appended
#   --user USER  when running as root, record as USER (runuser) so rows reach USER's ledger
#   --notify     detach CMD into its own session and log, return at once, and send its exit to the fleet session
#                $NORTH_FLEET_SESSION, so an agent can end its turn and wake on the result;
#                north/jobs/*.job names that session and stays locked while the job runs, so the fleet sees the wait
set -u

usage() { echo "usage: job-run [--path DIRS] [--user USER] [--notify] NAME -- CMD..." >&2; exit 2; }

arguments=("$@")
record_path="" user="" notify=""
while [ $# -gt 0 ]; do
  case "$1" in
    --path) record_path=$2; shift 2 ;;
    --user) user=$2; shift 2 ;;
    --notify) notify=${NORTH_FLEET_SESSION:-}; [ -n "$notify" ] || { echo "job-run: --notify needs NORTH_FLEET_SESSION" >&2; exit 2; }; shift ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 3 ] && [ "$2" = "--" ] || usage
name=$1
shift 2

here=$(dirname "$(readlink -f "$0")")
host=$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname)
stamp() { local t=$EPOCHREALTIME; TZ=UTC printf '%(%Y-%m-%dT%H:%M:%S)T.%sZ' "${t%.*}" "${t#*.}"; }
north_path="PATH=$here:${record_path:+$record_path:}$PATH:${BASH%/*}"

log=${JOB_RUN_LOG:-}
unset JOB_RUN_LOG
if [ -n "$notify" ] && [ -z "$log" ]; then
  logs=${XDG_STATE_HOME:-$HOME/.local/state}/north/jobs
  mkdir -p "$logs" || exit 1
  log="$logs/${name//\//_}-$(TZ=UTC printf '%(%Y%m%dT%H%M%S)T')-$$.log"
  detach=$(PATH=${north_path#PATH=}; command -v setsid) || { echo "job-run: --notify needs setsid" >&2; exit 1; }
  JOB_RUN_LOG=$log "$detach" -f "$BASH" "$0" "${arguments[@]}" </dev/null >"$log" 2>&1 \
    || { echo "job-run: could not detach $name; see $log" >&2; exit 1; }
  echo "job-run: $name runs detached with its output in $log; its exit arrives as a fleet message to $notify, so end your turn."
  exit 0
fi

as_user() {
  cmd=(env "$north_path" "$@")
  if [ -n "$user" ] && [ "$(id -u)" = 0 ]; then
    local home
    home=$(eval echo "~$user")
    cmd=(runuser -u "$user" -- "${cmd[@]:0:2}" "HOME=$home" "USER=$user" "${cmd[@]:2}")
  fi
}
recorder() { as_user timeout 30 "$here/north" threads job-run "$name" --host "$host" "$@"; }

if [ -n "$notify" ] && [ -n "$log" ]; then
  record=${log%.log}.job
  printf "%s\n" "$notify" > "$record"
  exec 9>>"$record"
  flock -x 9
fi
started=$(stamp)
recorder --started "$started"
PATH="${record_path:+$record_path:}$PATH" "${cmd[@]}" </dev/null >/dev/null 2>&1 &
starting=$!
"$@" 9>&-
rc=$?
kill "$starting" 2>/dev/null
recorder --started "$started" --finished "$(stamp)" --rc "$rc"
PATH="${record_path:+$record_path:}$PATH" "${cmd[@]}" </dev/null >/dev/null || echo "job-run: recording $name finish failed; the job's result is unaffected" >&2
wait "$starting" 2>/dev/null
if [ -n "$notify" ]; then
  as_user "$here/north" fleet send "$notify" "job-run: $name exited $rc; output in $log"
  "${cmd[@]}" </dev/null \
    || echo "job-run: sending $name's exit to $notify failed" >&2
fi
[ -z "${record:-}" ] || rm -f "$record"
exit "$rc"
