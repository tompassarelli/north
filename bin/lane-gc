#!/usr/bin/env -S bun --no-install
import { existsSync, mkdirSync, mkdtempSync, readdirSync, readlinkSync, renameSync, rmSync, statSync, writeFileSync, readFileSync, realpathSync } from "fs";
import { hostname, tmpdir } from "os";
import { basename, dirname, join } from "path";

export type RetirementFacts = {
  age: number; minimumAge: number; merged: boolean; equivalent: boolean;
  evilMerge: boolean; archiveAge: number; protections: number;
};
export function retirementVerdict(f: RetirementFacts): "keep" | "retire" | "retire-equiv" | "archive-then-delete" {
  if (f.protections || f.age < f.minimumAge) return "keep";
  if (f.merged) return "retire";
  if (f.equivalent && !f.evilMerge) return "retire-equiv";
  if (f.archiveAge >= 0 && f.age >= f.archiveAge) return "archive-then-delete";
  return "keep";
}

export type LaneClass = "landed-elsewhere" | "superseded" | "stale-dirty" | "owned";
export type LaneFacts = { dirty: boolean; equivalent: boolean; issues: ("open" | "closed" | "unknown")[]; age: number; held: boolean };
export function laneClass(f: LaneFacts): LaneClass {
  if (f.dirty) return f.age >= 24 && !f.held ? "stale-dirty" : "owned";
  if (f.equivalent) return "landed-elsewhere";
  if (f.issues.length && f.issues.every((s) => s === "closed")) return "superseded";
  return "owned";
}

const USAGE = `usage: lane-gc [--remote] [--dry-run] [--repo NAME]... [--root DIR] [--idle-hours H] [--state FILE]
       lane-gc --unlanded

For every ~/code/<project> container with main/ and worktrees/ (clients,
resources and archive are skipped), retire what is already on origin/main:
  - a worktree under worktrees/ whose tip is contained in origin/main, patch-equivalent
    there (git cherry shows no +) or adds nothing when merged, that has no uncommitted or
    untracked files, no process with its cwd or an open file inside, is not locked and
    was not touched within --idle-hours (default 3): git worktree remove, then its branch;
  - a local branch with no worktree passing the same check;
  - origin branches already on origin/main that pass the remote liveness checks;
--remote checks every origin branch for landed patches or 24h inactivity, protecting
open PRs, active Actions, Autoland, claims and recent pushes; orphaned
claude/land-* refs idle 4h notify their Fleet parent, then archive after a 1h grace; stale branches
are archived before deletion. Local unlanded lanes are flagged at 24h and clean,
unlocked, unused lanes are archived and retired at 72h.
Every other lane and branch gets a class: landed-elsewhere (patch-equivalent to main or its
tree already there), superseded (every issue it names is closed), stale-dirty (uncommitted
work idle 24h with no live holder) or owned. The first three are archived to
archive/<container>/<branch-or-worktree>/<short tip> (a stale-dirty lane's tip is a commit of
its full working state), the tag is verified and pushed to origin, and only then are the
worktree, branch and origin branch deleted. An existing refs/archive/lanes/<name> at the same
state counts as the archive. Owned lanes are grouped by their active Fleet parent in stale.json;
parents with more than 25 or any over 72h get supply-alert. --dry-run prints each lane's class and action.
then git worktree prune and git fetch --prune. Everything with unique commits or dirty
state is kept and written to the unlanded report (default
~/.local/state/agents/lane-gc/unlanded.txt): age, container, path, branch, ahead count,
dirty, first commit subject, Refs. --unlanded prints that report.`;

const HOME = process.env.HOME!;
const SKIP = new Set(["clients", "resources", "archive"]);
const env = { ...process.env, GIT_TERMINAL_PROMPT: "0", GIT_OPTIONAL_LOCKS: "0", LC_ALL: "C" };

type R = { ok: boolean; out: string; err: string };
function git(cwd: string, args: string[], timeout = 120_000, extra: Record<string, string> = {}): R {
  try {
    const r = Bun.spawnSync(["git", "-c", "maintenance.auto=false", "-c", "gc.auto=0", "-C", cwd, ...args], { env: { ...env, ...extra }, stdout: "pipe", stderr: "pipe", timeout });
    return { ok: r.exitCode === 0, out: r.stdout.toString().trim(), err: r.exitedDueToTimeout ? `timed out after ${timeout / 1000}s` : r.stderr.toString().trim() };
  } catch (e) {
    return { ok: false, out: "", err: String(e) };
  }
}
const tilde = (p: string) => (p === HOME || p.startsWith(HOME + "/") ? "~" + p.slice(HOME.length) : p);
function real(p: string): string {
  try { return realpathSync(p); } catch { return p; }
}

export function liveRoots(): string[] {
  const out = new Set<string>();
  for (const pid of readdirSync("/proc")) {
    if (!/^\d+$/.test(pid)) continue;
    try { out.add(readlinkSync(`/proc/${pid}/cwd`)); } catch {}
    let fds: string[] = [];
    try { fds = readdirSync(`/proc/${pid}/fd`); } catch {}
    for (const fd of fds) {
      try {
        const t = readlinkSync(`/proc/${pid}/fd/${fd}`);
        if (t.startsWith("/")) out.add(t);
      } catch {}
    }
  }
  return [...out];
}

const inside = (p: string, roots: string[]) => roots.some((c) => c === p || c.startsWith(p + "/"));

function newestMtime(paths: string[]): number {
  let m = 0;
  for (const p of paths) {
    try { m = Math.max(m, statSync(p).mtimeMs); } catch {}
  }
  return m;
}

export type Verdict = { landed: boolean; ahead: number; how: string };
export function landed(repo: string, base: string, tip: string): Verdict {
  if (git(repo, ["merge-base", "--is-ancestor", tip, base]).ok) return { landed: true, ahead: 0, how: "ancestor" };
  const ahead = Number(git(repo, ["rev-list", "--count", `${base}..${tip}`]).out || "0");
  const cherry = git(repo, ["cherry", base, tip]);
  if (cherry.ok && !cherry.out.split("\n").some((l) => l.startsWith("+"))) return { landed: true, ahead, how: "patch-equivalent" };
  const merged = git(repo, ["merge-tree", "--write-tree", base, tip]);
  if (merged.ok && merged.out.split("\n")[0] === git(repo, ["rev-parse", `${base}^{tree}`]).out) return { landed: true, ahead, how: "adds nothing" };
  return { landed: false, ahead, how: "" };
}

type Opts = { remote: boolean; dryRun: boolean; root: string; repos: string[]; idleHours: number; state: string };
type Counts = { retiredWorktrees: number; deletedBranches: number; deletedRemote: number; kept: number; unlanded: number };
const reportRows: string[] = [];
const now = () => process.env.LANE_GC_NOW ? Date.parse(process.env.LANE_GC_NOW) : Date.now();
type LocalStale = { path: string; branch: string; age_h: number; dirty: boolean; owner: string; flagged_at: string; retire_at: string };
type Owned = { where: string; branch: string; age_h: number; refs: string[]; owner: string };
type RepoReport = { remote_landed: string[]; remote_stale: { branch: string; age_h: number; owner: string }[]; local_stale: LocalStale[]; owned?: Owned[] };
type LandingPing = { tip: string; pushed_at: number; pinged_at: string; owner: string };
type StaleReport = { landing_pings?: Record<string, LandingPing>; at: string; repos: Record<string, RepoReport>; notices?: string[]; alerts?: Record<string, string> };
let stale: StaleReport;
let stalePath: string;
const emptyRepo = (): RepoReport => ({ remote_landed: [], remote_stale: [], local_stale: [], owned: [] });
function command(args: string[]): R {
  try {
    const r = Bun.spawnSync(args, { env, stdout: "pipe", stderr: "pipe", timeout: 120_000 });
    return { ok: r.exitCode === 0, out: r.stdout.toString().trim(), err: r.stderr.toString().trim() };
  } catch (e) { return { ok: false, out: "", err: String(e) }; }
}
function api(endpoint: string): any {
  const r = command(["gh", "api", endpoint, "--paginate", "--slurp"]);
  if (!r.ok) throw new Error(`GitHub eligibility unavailable: ${r.err}`);
  return JSON.parse(r.out);
}
const pushActivity = new Map<string, Map<string, number> | null>();
function pushedRefs(repo: string): Map<string, number> | null {
  if (pushActivity.has(repo)) return pushActivity.get(repo)!;
  let refs: Map<string, number> | null = null;
  try {
    const pages = api(`repos/tompassarelli/${repo}/activity?time_period=day&per_page=100`);
    if (!Array.isArray(pages) || !pages.length || !pages.every(Array.isArray)) throw new Error("push activity incomplete");
    const rows = pages.flat();
    if (!rows.every((row: any) => typeof row.activity_type === "string" && typeof row.ref === "string" && typeof row.timestamp === "string" && Number.isFinite(Date.parse(row.timestamp)))) throw new Error("push activity incomplete");
    refs = new Map();
    for (const row of rows) {
      if (["push", "force_push", "branch_creation"].includes(row.activity_type)) refs.set(row.ref, Math.max(refs.get(row.ref) || 0, Date.parse(row.timestamp)));
    }
  } catch {}
  pushActivity.set(repo, refs);
  return refs;
}

function owner(name: string): string {
  const sessions = fleetSessions();
  const prefix = `/code/${name}/`;
  const holder = sessions.find((s: any) => typeof s.cwd === "string" && real(s.cwd).includes(prefix) && s.status !== "exited");
  return holder?.parent || holder?.name || "proxy";
}
let fleetMemo: any[] | undefined;
function fleetSessions(): any[] {
  if (fleetMemo) return fleetMemo;
  const result = command(["north", "fleet", "list", "--json"]);
  if (!result.ok) throw new Error("Fleet sessions unavailable");
  const sessions = JSON.parse(result.out);
  if (!Array.isArray(sessions)) throw new Error("Fleet session list malformed");
  return fleetMemo = sessions;
}
const itemRef = (item: string) => item.replace(/^nixos-config#/, "firn#");
const protectedBranch = (b: string) => b === "main" || b === "master" || b === "gh-pages" || b.startsWith("release/");
function originRepo(main: string): string | null {
  const url = git(main, ["remote", "get-url", "origin"]);
  return url.ok ? url.out.match(/^(?:https:\/\/github\.com\/|git@github\.com:|ssh:\/\/git@github\.com\/)tompassarelli\/([^/]+?)(?:\.git)?$/)?.[1] || null : null;
}
let claimsMemo: Set<string> | undefined;
function liveClaims(): Set<string> {
  return claimsMemo ||= readClaims();
}
function readClaims(): Set<string> {
  const r = command(["threads", "list"]);
  if (!r.ok || !r.out.startsWith("item")) throw new Error("NorthThread claims unavailable");
  const sessions = fleetSessions();
  const alive = (holder: string) => sessions.some((s: any) => [s.conversation, s.name, `${s.provider}:${s.conversation}`].includes(holder) && s.status !== "exited") || (/^\d+$/.test(holder) && pidAlive(Number(holder)));
  return new Set(r.out.split("\n").slice(1).map(l => l.trim().split(/\s+/)).filter(row => row.length >= 2 && alive(row[1])).map(row => itemRef(row[0])));
}
function pidAlive(pid: number): boolean {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try { process.kill(pid, 0); return true; } catch { return false; }
}
function refsOn(main: string, base: string, tip: string): string[] {
  const bodies = git(main, ["log", "--format=%B", `${base}..${tip}`]);
  if (!bodies.ok) throw new Error("branch claim evidence unavailable");
  return [...new Set([...bodies.out.matchAll(/\bRefs\s+([\w.-]+#\d+)/g)].map(m => itemRef(m[1])))];
}
type LiveTrees = { ok: boolean; branches: Record<string, string> };
const treeScan = String.raw`
import os, json, subprocess, datetime, sys
from pathlib import Path
root = Path(sys.argv[1]).expanduser()
cutoff = datetime.datetime.fromtimestamp(float(sys.argv[2])/1000-86400, datetime.timezone.utc).isoformat()
result = {"ok": True, "branches": {}}
live = set()
for p in Path("/proc").iterdir():
    if not p.name.isdigit(): continue
    try: live.add(os.readlink(p / "cwd"))
    except OSError: pass
    try:
        for fd in (p / "fd").iterdir():
            try: live.add(os.readlink(fd))
            except OSError: pass
    except OSError: pass
def run(args):
    p = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if p.returncode: raise RuntimeError("worktree scan command failed")
    return p.stdout.strip()
try:
    for container in root.iterdir():
        main, lanes = container / "main", container / "worktrees"
        if not (main / ".git").exists() or not lanes.exists(): continue
        for block in run(["git", "-C", str(main), "worktree", "list", "--porcelain"]).split("\n\n"):
            row = dict(line.partition(" ")[::2] for line in block.splitlines())
            path = Path(row.get("worktree", "/"))
            branch = row.get("branch", "").removeprefix("refs/heads/")
            if path.parent.resolve() != lanes.resolve() or not branch: continue
            key = container.name + ":" + branch
            if "locked" in row: result["branches"][key] = "locked worktree"; continue
            if not path.exists(): continue
            if any(p == str(path) or p.startswith(str(path) + "/") for p in live):
                result["branches"][key] = "process in " + str(path); continue
            if run(["git", "-C", str(path), "status", "--porcelain", "--untracked-files=normal"]):
                result["branches"][key] = "dirty " + str(path); continue
            if run(["find", str(path), "-type", "f", "-newermt", cutoff, "-print", "-quit"]):
                result["branches"][key] = "file modified under 24h in " + str(path)
except Exception:
    result["ok"] = False
print(json.dumps(result))
`;
let laptopTrees: LiveTrees, nexusTrees: LiveTrees, peer: { name: string; trees: LiveTrees };
function scanTrees(root: string, remote: boolean): LiveTrees {
  const args = remote ? ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "nexus", "python3", "-", "~/code", String(now())] : ["python3", "-", root, String(now())];
  try {
    const r = Bun.spawnSync(args, { env, stdin: Buffer.from(treeScan), stdout: "pipe", stderr: "pipe", timeout: 120_000 });
    return r.exitCode === 0 ? JSON.parse(r.stdout.toString()) : { ok: false, branches: {} };
  } catch { return { ok: false, branches: {} }; }
}
function notice(repo: string, branch: string, action: string, tag = "") {
  const line = `${new Date(now()).toISOString()} ${repo} ${branch} ${action} owner=${owner(repo)}${tag ? ` tag=${tag} restore=git push origin ${tag}:refs/heads/${branch}` : ""}`;
  stale.notices = [...(stale.notices || []), line];
  const path = join(dirname(stalePath), "notices.md");
  mkdirSync(dirname(path), { recursive: true });
  writeFileSync(path, (existsSync(path) ? readFileSync(path, "utf8") : "") + line + "\n");
}
const ZERO = "0000000000000000000000000000000000000000";
type Archived = { ok: true; tag: string } | { ok: false; why: string };
function archive(main: string, container: string, name: string, tip: string, target: string, shepherd = ""): Archived {
  const held = shepherd ? git(main, ["rev-parse", "-q", "--verify", `refs/archive/lanes/${shepherd}^{commit}`]) : { ok: false, out: "", err: "" };
  if (held.ok && git(main, ["rev-parse", `${held.out}^{tree}`]).out === git(main, ["rev-parse", `${target}^{tree}`]).out && git(main, ["merge-base", "--is-ancestor", tip, held.out]).ok) return { ok: true, tag: `refs/archive/lanes/${shepherd}` };
  const tag = `archive/${container}/${name}/${target.slice(0, 12)}`;
  const ref = `refs/tags/${tag}`;
  if (!git(main, ["check-ref-format", ref]).ok) return { ok: false, why: "invalid archive tag name" };
  const existing = git(main, ["rev-parse", "-q", "--verify", `${ref}^{commit}`]);
  if (existing.ok && existing.out !== target) return { ok: false, why: "archive tag conflict" };
  if (!existing.ok && !git(main, ["update-ref", ref, target, ZERO]).ok) return { ok: false, why: "archive tag write failed" };
  if (git(main, ["rev-parse", "-q", "--verify", `${ref}^{commit}`]).out !== target) return { ok: false, why: "archive tag unverified" };
  if (git(main, ["remote", "get-url", "origin"]).ok) {
    const pushed = git(main, ["push", "-q", "origin", `${ref}:${ref}`], 180_000);
    const seen = git(main, ["ls-remote", "origin", ref, `${ref}^{}`]);
    const refs = new Map(seen.out.split("\n").map(line => { const [oid, name] = line.split(/\s+/); return [name, oid]; }));
    if (!pushed.ok || !seen.ok || (refs.get(`${ref}^{}`) ?? refs.get(ref)) !== target) {
      const why = `archive tag push unverified${pushed.err ? `: ${pushed.err.split('\n').filter(l => l && !l.startsWith('error: failed to push some refs')).pop()}` : ""}`;
      notice(container, name, `kept (${why})`);
      return { ok: false, why };
    }
  }
  return { ok: true, tag };
}
function snapshot(path: string, main: string, tip: string, label: string): string {
  const dir = mkdtempSync(join(tmpdir(), "lane-gc-"));
  try {
    const index = { GIT_INDEX_FILE: join(dir, "index") };
    if (!git(path, ["read-tree", tip], 120_000, index).ok || !git(path, ["add", "-A"], 120_000, index).ok) return "";
    const tree = git(path, ["write-tree"], 120_000, index);
    if (!tree.ok || git(main, ["ls-tree", "-r", tree.out]).out.split("\n").some((l) => l.startsWith("160000 "))) return "";
    if (tree.out === git(main, ["rev-parse", `${tip}^{tree}`]).out) return tip;
    const commit = git(main, ["-c", "user.name=lane-gc", "-c", "user.email=lane-gc@localhost", "commit-tree", tree.out, "-p", tip, "-m", `Archive ${label} working state`]);
    return commit.ok ? commit.out : "";
  } finally { rmSync(dir, { recursive: true, force: true }); }
}
function deleteOrigin(main: string, branch: string, target: string): string {
  if (!branch || !git(main, ["remote", "get-url", "origin"]).ok) return "";
  const r = git(main, ["ls-remote", "origin", `refs/heads/${branch}`]);
  if (!r.ok) return "origin branch unverified; kept";
  if (!r.out) return "";
  const remoteTip = r.out.split(/\s+/)[0];
  if (!git(main, ["merge-base", "--is-ancestor", remoteTip, target]).ok) return "origin branch holds other work; kept";
  const deletion = git(main, ["push", "-q", `--force-with-lease=refs/heads/${branch}:${remoteTip}`, "origin", `:refs/heads/${branch}`], 180_000);
  return deletion.ok ? "" : "origin branch delete failed";
}
const ISSUES = /\b(?:Refs|Fixes|Closes|Part of)\s+([\w.-]*#\d+)/gi;
function namedIssues(main: string, name: string, base: string, tip: string): string[] {
  const bodies = git(main, ["log", "--format=%B", `${base}..${tip}`]);
  if (!bodies.ok) throw new Error("issue evidence unavailable");
  const own = originRepo(main) || name;
  return [...new Set([...bodies.out.matchAll(ISSUES)].map((m) => itemRef(m[1].startsWith("#") ? own + m[1] : m[1])))];
}
const issueStates = new Map<string, "open" | "closed" | "unknown">();
function issueState(item: string): "open" | "closed" | "unknown" {
  if (!issueStates.has(item)) {
    const [repo, number] = item.split("#");
    const r = command(["gh", "issue", "view", number, "-R", `tompassarelli/${repo}`, "--json", "state", "-q", ".state"]);
    issueStates.set(item, !r.ok ? "unknown" : r.out === "CLOSED" ? "closed" : r.out === "OPEN" ? "open" : "unknown");
  }
  return issueStates.get(item)!;
}
function remoteSweep(container: string, o: Opts, c: Counts) {
  const name = basename(container), main = join(container, "main"), repo = originRepo(main);
  const log = (s: string) => console.log(`${name}: ${s}`);
  if (!repo) return log("origin is not tompassarelli GitHub; remote read-only");
  const fetched = git(main, ["fetch", "-q", "--prune", "origin"], 180_000);
  if (!fetched.ok) throw new Error("origin fetch failed; remote read-only");
  const base = "refs/remotes/origin/main";
  if (!git(main, ["rev-parse", "--verify", base]).ok) throw new Error("origin/main unavailable");
  const query = `query($endCursor:String){repository(owner:"tompassarelli",name:${JSON.stringify(repo)}){refs(refPrefix:"refs/heads/",first:100,after:$endCursor){nodes{name target{... on Commit{oid committedDate status{contexts{context state}}}}} pageInfo{hasNextPage endCursor}}}}`;
  const refs = command(["gh", "api", "graphql", "--paginate", "--slurp", "-f", `query=${query}`]);
  if (!refs.ok) throw new Error("remote status evidence unavailable");
  const pages = JSON.parse(refs.out);
  if (!Array.isArray(pages) || !pages.length || pages.some((p: any, i: number) => p.errors || !Array.isArray(p.data?.repository?.refs?.nodes) || p.data.repository.refs.pageInfo?.hasNextPage !== (i < pages.length - 1))) throw new Error("remote status evidence incomplete");
  const branches = pages.flatMap((p: any) => p.data.repository.refs.nodes);
  const prs = new Set(api(`repos/tompassarelli/${repo}/pulls?state=open&per_page=100`).flat().map((p: any) => p.head.ref));
  const active = new Set<string>(), activeTips = new Set<string>();
  for (const status of ["queued", "in_progress", "waiting", "pending", "requested"]) {
    const runPages = api(`repos/tompassarelli/${repo}/actions/runs?status=${status}&per_page=100`);
    if (!Array.isArray(runPages) || !runPages.length || runPages.some((p: any) => !Array.isArray(p.workflow_runs) || !Number.isSafeInteger(p.total_count) || p.total_count < 0) || runPages.some((p: any) => p.total_count !== runPages[0].total_count) || runPages.reduce((n: number, p: any) => n + p.workflow_runs.length, 0) !== runPages[0].total_count) throw new Error("Actions eligibility incomplete");
    for (const page of runPages) {
      for (const run of page.workflow_runs) {
        if (typeof run.head_branch !== "string" || typeof run.head_sha !== "string") throw new Error("Actions eligibility incomplete");
        active.add(run.head_branch); activeTips.add(run.head_sha);
      }
    }
  }
  const pushes = pushedRefs(repo);
  let held: string[] | undefined, claims: Set<string> | undefined;
  const report = stale.repos[name] ||= emptyRepo();
  report.remote_landed = []; report.remote_stale = [];
  let deletable = 0, archivable = 0, skipped = 0;
  for (const { name: branch, target } of branches) {
    if (!target?.oid || !target.committedDate) throw new Error("branch tip evidence incomplete");
    const tip = target.oid;
    const landing = branch.startsWith("claude/land-");
    const pushedAt = pushes?.get(`refs/heads/${branch}`) ?? 0;
    const age = (now() - (landing ? pushedAt || now() - 24 * 3600_000 : Date.parse(target.committedDate))) / 3600_000;
    if (!Number.isFinite(age)) throw new Error("commit date unavailable");
    const ancestor = git(main, ["merge-base", "--is-ancestor", tip, base]).ok;
    const key = `${name}:${branch}`;
    const reason = protectedBranch(branch) ? "protected branch" : pushes === null ? "a push activity unavailable" : prs.has(branch) ? "b open PR" : active.has(branch) || activeTips.has(tip) ? "b active Actions" : target.status?.contexts?.some((s: any) => s.context === "autoland" && s.state === "PENDING") && (!landing || age < 4) ? "b pending autoland" : landing && age < 4 ? "a landing ref pushed under 4h" : !landing && ancestor ? "" : !landing && age < 24 ? "a fresh commit" : !landing && pushes.has(`refs/heads/${branch}`) ? "a branch pushed under 24h" : (() => {
      try {
        claims ||= liveClaims();
        const source = landing ? branch.slice("claude/land-".length).replace(/-[a-f0-9]{12}$/, "") : "";
        const author = source && [...Object.entries(laptopTrees.branches), ...Object.entries(nexusTrees.branches)].find(([key]) => key.startsWith(`${name}:`) && key.slice(name.length + 1).replace(/[^A-Za-z0-9._-]/g, "-") === source);
        return author ? `c live source author ${author[1]}` : laptopTrees.branches[key] ? `c laptop ${laptopTrees.branches[key]}` : nexusTrees.branches[key] ? `c nexus ${nexusTrees.branches[key]}` : !laptopTrees.ok || !nexusTrees.ok ? "c worktree liveness unavailable" : refsOn(main, base, tip).some(item => claims!.has(item)) ? "d live holder session (claim clock ignored)" : "";
      } catch { return "c Fleet holder liveness unavailable"; }
    })();
    const remoteFacts: RetirementFacts = { age, minimumAge: landing ? 4 : ancestor ? -Infinity : 24, merged: ancestor, equivalent: false, evilMerge: false, archiveAge: landing ? 4 : 24, protections: reason ? 1 : 0 };
    if (retirementVerdict(remoteFacts) === "keep") {
      if (landing && !o.dryRun && stale.landing_pings) delete stale.landing_pings[key];
      skipped++; log(`origin ${branch}: LIVE(${reason})`); continue;
    }
    if (landing) {
      const parent = owner(name), pings = stale.landing_pings ||= {};
      const ping = pings[key];
      if (!ping || ping.tip !== tip || ping.pushed_at !== pushedAt || ping.owner !== parent) {
        if (o.dryRun) { log(`origin ${branch}: would notify ${parent}; keep for 1h grace`); skipped++; continue; }
        if (parent === "unknown") { log(`origin ${branch}: keep (Fleet parent unavailable)`); skipped++; continue; }
        const text = `${parent}: orphan landing ${name}:${branch} idle ${Math.floor(age)}h; lane-gc will archive and retire after 1h unless live Fleet ownership resumes`;
        const sent = command(["north", "fleet", "send", parent, text]);
        if (!sent.ok) { log(`origin ${branch}: keep (Fleet parent notification failed)`); skipped++; continue; }
        pings[key] = { tip, pushed_at: pushedAt, pinged_at: new Date(now()).toISOString(), owner: parent };
        notice(name, branch, "Fleet parent notified; 1h grace");
        log(`origin ${branch}: notified ${parent}; keep for 1h grace`); skipped++; continue;
      }
      if (!Number.isFinite(Date.parse(ping.pinged_at)) || now() - Date.parse(ping.pinged_at) < 3600_000) { log(`origin ${branch}: keep (owner ping grace)`); skipped++; continue; }
    }
    const cherry = git(main, ["cherry", base, tip]);
    if (!ancestor && !cherry.ok) throw new Error("landed evidence unavailable");
    remoteFacts.equivalent = !cherry.out.split("\n").some((l: string) => l.startsWith("+"));
    const remoteDecision = retirementVerdict(remoteFacts);
    const isLanded = !landing && remoteDecision === "retire";
    const cls = isLanded ? "landed" : laneClass({ dirty: false, equivalent: remoteDecision === "retire-equiv", issues: remoteDecision === "retire-equiv" ? [] : namedIssues(main, name, base, tip).map(issueState), age: 0, held: false });
    if (isLanded || cls === "landed-elsewhere") report.remote_landed.push(branch);
    else report.remote_stale.push({ branch, age_h: Math.floor(age), owner: owner(name) });
    log(`origin ${branch}: STALE ${cls} (${Math.floor(age)}h; ${isLanded ? "delete (landed)" : `archive to archive/${name}/${branch}/${tip.slice(0, 12)}, then delete`})`);
    if (isLanded) deletable++; else archivable++;
    if (o.dryRun) continue;
    if (!o.remote && !landing && !isLanded && cls !== "landed-elsewhere") continue;
    const archived = isLanded ? { ok: true as const, tag: "" } : archive(main, name, branch, tip, tip);
    if (!archived.ok) { log(`keep origin ${branch}: ${archived.why}`); continue; }
    const deletion = git(main, ["push", "-q", `--force-with-lease=refs/heads/${branch}:${tip}`, "origin", `:refs/heads/${branch}`], 180_000);
    if (!deletion.ok) { log(`keep origin ${branch}: delete failed: ${deletion.err.split("\n").pop()}`); continue; }
    c.deletedRemote++;
    if (stale.landing_pings) delete stale.landing_pings[key];
    report.remote_landed = report.remote_landed.filter(b => b !== branch);
    report.remote_stale = report.remote_stale.filter(row => row.branch !== branch);
    notice(name, branch, isLanded ? "deleted (landed)" : `archived (${cls})`, archived.tag);
    if (!isLanded) archiveNotes(main, name, base, branch, tip, archived.tag);
  }
  log(`remote split: ${skipped} LIVE, ${deletable + archivable} STALE (${deletable} landed, ${archivable} archive-and-delete)`);
}


function archiveNotes(main: string, name: string, base: string, branch: string, tip: string, tag: string) {
  const text = `Archived ${name}:${branch} as ${tag}. Restore: git push origin ${tag}:refs/heads/${branch}`;
  for (const item of refsOn(main, base, tip)) {
    const [issueRepo, number] = item.split("#");
    if (["life", "accounts", "travel", "ops"].includes(issueRepo)) {
      const noted = command(["threads", "note", item, text]);
      if (!noted.ok) console.log(`${name}: threads note unavailable for ${item}; restore command retained in notices`);
      continue;
    }
    const comment = command(["gh", "api", `repos/tompassarelli/${issueRepo}/issues/${number}/comments`, "-f", `body=${text}`]);
    if (!comment.ok) console.log(`${name}: archive comment failed for ${item}`);
  }
}

function sessionIn(path: string): boolean {
  const lane = real(path);
  return fleetSessions().some((s: any) => typeof s.cwd === "string" && s.status !== "exited" && (real(s.cwd) === lane || real(s.cwd).startsWith(lane + "/")));
}
const ghMemo = new Map<string, { prs: Set<string>; runs: any[] }>();
function ghFacts(repo: string): { prs: Set<string>; runs: any[] } {
  if (!ghMemo.has(repo)) {
    const prs = new Set<string>(api(`repos/tompassarelli/${repo}/pulls?state=open&per_page=100`).flat().map((p: any) => p.head.ref));
    const runs: any[] = [];
    for (const status of ["queued", "in_progress", "waiting", "pending", "requested"]) {
      for (const page of api(`repos/tompassarelli/${repo}/actions/runs?status=${status}&per_page=100`)) {
        if (!Array.isArray(page.workflow_runs)) throw new Error("Actions eligibility incomplete");
        runs.push(...page.workflow_runs);
      }
    }
    ghMemo.set(repo, { prs, runs });
  }
  return ghMemo.get(repo)!;
}

function localArchiveGuard(main: string, name: string, base: string, branch: string, tip: string, path = ""): string {
  try {
    const claims = liveClaims();
    if (namedIssues(main, name, base, tip).some(item => claims.has(item))) return "live holder session";
    if (path && sessionIn(path)) return "live session in lane";
    if (branch && git(main, ["rev-parse", "-q", "--verify", `refs/remotes/origin/${branch}`]).ok) {
      if (!peer.trees.ok) return `${peer.name} liveness unavailable`;
      if (peer.trees.branches[`${name}:${branch}`]) return `${peer.name} ${peer.trees.branches[`${name}:${branch}`]}`;
    }
    const repo = originRepo(main);
    if (!repo) return "";
    const pushes = pushedRefs(repo);
    if (pushes === null) return "push activity unavailable";
    if (branch && pushes.has(`refs/heads/${branch}`)) return "branch pushed under 24h";
    const query = `{repository(owner:"tompassarelli",name:${JSON.stringify(repo)}){object(oid:${JSON.stringify(tip)}){... on Commit{oid status{contexts{context state}}}}}}`;
    const response = command(["gh", "api", "graphql", "-f", `query=${query}`]);
    if (!response.ok) return "Autoland eligibility unavailable";
    const page = JSON.parse(response.out);
    const repository = page.data?.repository;
    if (page.errors || !repository || !("object" in repository)) return "Autoland eligibility incomplete";
    if (repository.object && (!repository.object.oid || !("status" in repository.object))) return "Autoland status incomplete";
    if (repository.object?.status?.contexts?.some((s: any) => s.context === "autoland" && s.state === "PENDING")) return "pending autoland";
    const facts = ghFacts(repo);
    if (branch && facts.prs.has(branch)) return "open PR";
    if (facts.runs.some((run: any) => (branch && run.head_branch === branch) || run.head_sha === tip)) return "active Actions";
    return "";
  } catch { return "liveness unavailable"; }
}

function unlandedRow(name: string, main: string, base: string, tip: string, where: string, branch: string, ahead: number, dirty: string): number {
  const when = Number(git(main, ["log", "-1", "--format=%ct", tip]).out || "0");
  const hours = Math.floor((now() / 1000 - when) / 3600);
  const subjects = git(main, ["log", "--reverse", "--format=%s", `${base}..${tip}`]).out.split("\n").filter(Boolean);
  const bodies = git(main, ["log", "--format=%B", `${base}..${tip}`]).out;
  const refs = [...new Set([...bodies.matchAll(/\b(?:Refs|Fixes|Closes|Part of)\s+([\w.-]*#\d+)/gi)].map((m) => m[1]))];
  reportRows.push([`${hours}h`, name, where, branch || "(detached)", `+${ahead}`, dirty || "-", subjects[0] ?? (dirty ? "uncommitted changes" : "-"), refs.join(" ") || "-"].join("\t"));
  return hours;
}

type Lane = { path: string; branch: string; tip: string; dirty: boolean; label: string };
type Retired = { retired: boolean; tag: string; why: string };
function retireLane(main: string, name: string, lane: Lane): Retired {
  const target = lane.dirty ? snapshot(lane.path, main, lane.tip, `${name}/${lane.label}`) : lane.tip;
  if (!target) return { retired: false, tag: "", why: "working state not archivable" };
  const archived = archive(main, name, lane.label, lane.tip, target, lane.path ? basename(lane.path) : lane.branch);
  if (!archived.ok) return { retired: false, tag: "", why: archived.why };
  const kept = (why: string): Retired => ({ retired: false, tag: archived.tag, why });
  if (lane.path) {
    const st = git(lane.path, ["status", "--porcelain", "--untracked-files=normal"]);
    if (!st.ok || git(lane.path, ["rev-parse", "HEAD"]).out !== lane.tip || inside(real(lane.path), liveRoots())) return kept("lane changed or became active after archive");
    if (lane.dirty ? git(main, ["rev-parse", `${snapshot(lane.path, main, lane.tip, name)}^{tree}`]).out !== git(main, ["rev-parse", `${target}^{tree}`]).out : st.out) return kept("working state changed after archive");
    const rm = git(main, ["worktree", "remove", ...(lane.dirty ? ["--force"] : []), lane.path]);
    if (!rm.ok) return kept(`worktree remove failed: ${rm.err.split("\n").pop()}`);
  }
  if (lane.branch && !git(main, ["update-ref", "-d", `refs/heads/${lane.branch}`, lane.tip]).ok) return { retired: true, tag: archived.tag, why: "branch delete failed" };
  return { retired: true, tag: archived.tag, why: deleteOrigin(main, lane.branch, target) };
}

function sweep(container: string, o: Opts, live: string[], c: Counts) {
  const name = basename(container);
  const main = join(container, "main");
  const log = (s: string) => console.log(`${name}: ${s}`);
  if (!o.dryRun && !git(main, ["fetch", "-q", "--prune", "origin"], 180_000).ok) return log("origin fetch failed; kept all lanes");
  const base = ["refs/remotes/origin/main", "refs/remotes/origin/HEAD", "refs/heads/main"].find((r) => git(main, ["rev-parse", "-q", "--verify", r]).ok);
  if (!base) return log("no main branch; skipped");
  const cutoff = now() - o.idleHours * 3600_000;
  const common = real(git(main, ["rev-parse", "--path-format=absolute", "--git-common-dir"]).out);
  if (!o.dryRun) git(main, ["worktree", "prune"]);
  const wts: Record<string, string>[] = [];
  let cur: Record<string, string> = {};
  for (const line of (git(main, ["worktree", "list", "--porcelain"]).out + "\n").split("\n")) {
    if (!line) { if (cur.worktree) wts.push(cur); cur = {}; continue; }
    const i = line.indexOf(" ");
    cur[i < 0 ? line : line.slice(0, i)] = i < 0 ? "true" : line.slice(i + 1);
  }
  const checkedOut = new Set(wts.map((w) => (w.branch ?? "").replace(/^refs\/heads\//, "")).filter(Boolean));
  const lanes = real(join(container, "worktrees"));
  const report = stale.repos[name] ||= emptyRepo();
  const previous = new Map(report.local_stale.map(row => [row.path, row]));
  report.local_stale = [];
  const owned: Owned[] = [];
  const github = Boolean(originRepo(main));
  const issuesOf = (tip: string) => { try { return namedIssues(main, name, base, tip); } catch { return []; } };
  const deleteBranch = (b: string, tip: string) => {
    if (o.dryRun) return true;
    return git(main, ["update-ref", "-d", `refs/heads/${b}`, tip]).ok;
  };
  const retired = (cls: string, where: string, label: string, tip: string, r: Retired) => {
    log(`${cls} ${where}: archived to ${r.tag} and retired${r.why ? `; ${r.why}` : ""}`);
    notice(name, label, `retired (${cls})`, r.tag);
    if (github) archiveNotes(main, name, base, label, tip, r.tag);
  };
  for (const w of wts) {
    const path = w.worktree;
    if (dirname(real(path)) !== lanes) continue;
    const branch = (w.branch ?? "").replace(/^refs\/heads\//, "");
    const tip = w.HEAD;
    const keep = (why: string) => { c.kept++; if (o.dryRun) log(`keep ${tilde(path)}: ${why}`); };
    if (w.prunable || !existsSync(path)) { keep("prunable"); continue; }
    if (real(path) === dirname(common)) { keep("holds .git"); continue; }
    const st = git(path, ["status", "--porcelain", "--untracked-files=normal"]);
    const dirty = !st.ok ? "status failed" : st.out ? "dirty" : "";
    const v = landed(main, base, tip);
    const admin = git(path, ["rev-parse", "--path-format=absolute", "--git-dir"]).out;
    const activity = Math.max(Number(git(main, ["log", "-1", "--format=%ct", tip]).out) * 1000, newestMtime([path, join(admin, "HEAD"), join(admin, "index"), join(admin, "logs/HEAD"), join(common, "logs/refs/heads", branch)]));
    const age = (now() - activity) / 3600_000;
    const modifiedSince = (hours: number): boolean => {
      const r = command(["find", path, "-type", "f", "-newermt", new Date(now() - hours * 3600_000).toISOString(), "-print", "-quit"]);
      return !r.ok || Boolean(r.out);
    };
    let flagged: LocalStale | undefined;
    if ((!v.landed || dirty) && age >= 24 && !modifiedSince(24)) {
      flagged = { path, branch, age_h: Math.floor(age), dirty: Boolean(dirty), owner: owner(name), flagged_at: previous.get(path)?.flagged_at || new Date(now()).toISOString(), retire_at: new Date(activity + 72 * 3600_000).toISOString() };
      report.local_stale.push(flagged);
    }
    if (!(v.how === "ancestor" && !dirty)) {
      const where = tilde(path), label = branch || basename(path);
      const issues = issuesOf(tip);
      const held = w.locked ? "locked" : inside(real(path), live) ? "process inside" : protectedBranch(branch) ? "protected branch" : dirty === "status failed" ? "status failed" : (() => { try { return sessionIn(path) ? "live Fleet session in lane" : ""; } catch { return "Fleet unavailable"; } })();
      const idleFor = (hours: number) => age >= hours && !modifiedSince(hours);
      const cls = laneClass({ dirty: Boolean(dirty), equivalent: v.landed, issues: dirty || v.landed ? [] : issues.map(issueState), age: dirty && idleFor(24) ? age : 0, held: Boolean(held) });
      const expired = cls === "owned" && !dirty && Boolean(flagged) && Boolean(branch) && idleFor(72);
      const unlanded = () => { const hours = unlandedRow(name, main, base, tip, where, branch, v.ahead, dirty); c.unlanded++; return hours; };
      if (cls === "owned" && !expired) {
        unlanded();
        owned.push({ where, branch: branch || "(detached)", age_h: Math.floor(age), refs: issues, owner: owner(name) });
        c.kept++;
        if (o.dryRun) log(`owned ${where}: surface to ${owner(name)}${issues.length ? ` (${issues.join(" ")})` : ""}`);
        continue;
      }
      const action = expired ? "archive and retire (idle 72h)" : `archive to archive/${name}/${label}/${dirty ? "<snapshot>" : tip.slice(0, 12)}, then retire`;
      const why = held || (cls === "landed-elsewhere" || cls === "superseded" ? (idleFor(o.idleHours) ? "" : `touched within ${o.idleHours}h`) : "") || localArchiveGuard(main, name, base, branch, tip, path);
      if (why) {
        c.kept++;
        if (!v.landed || dirty) unlanded();
        if (expired) owned.push({ where, branch, age_h: Math.floor(age), refs: issues, owner: owner(name) });
        if (o.dryRun) log(`${cls} ${where}: keep (${why})`);
        continue;
      }
      if (o.dryRun) { log(`${cls} ${where}: ${action}`); c.retiredWorktrees++; if (branch) c.deletedBranches++; continue; }
      const r = retireLane(main, name, { path, branch, tip, dirty: Boolean(dirty), label });
      if (!r.retired) {
        c.kept++;
        if (!v.landed || dirty) unlanded();
        log(`${cls} ${where}: kept (${r.why})`);
        continue;
      }
      c.retiredWorktrees++; checkedOut.delete(branch);
      if (branch && !r.why.startsWith("branch")) c.deletedBranches++;
      report.local_stale = report.local_stale.filter(row => row.path !== path);
      retired(expired ? "owned" : cls, where, label, tip, r);
      continue;
    }
    const reason = w.locked ? "locked" : protectedBranch(branch) ? "protected branch" : inside(real(path), live) ? "process inside" : "";
    const decision = retirementVerdict({ age: cutoff - activity, minimumAge: 0, merged: true, equivalent: false, evilMerge: false, archiveAge: -1, protections: reason ? 1 : 0 });
    if (decision === "keep") { keep(reason || `touched within ${o.idleHours}h`); continue; }
    const readOnly = Bun.spawnSync(["find", path, "-type", "d", "!", "-perm", "-u+w", "-print", "-quit"]).stdout.toString().trim();
    if (readOnly) { keep(`read-only directory ${tilde(readOnly)}`); continue; }
    if (o.dryRun) { log(`retire ${tilde(path)} (${branch || "detached"}, ${v.how})`); c.retiredWorktrees++; if (branch) c.deletedBranches++; continue; }
    const rm = git(main, ["worktree", "remove", path]);
    if (!rm.ok) { keep(`worktree remove failed: ${rm.err.split("\n").pop()}`); log(`kept ${tilde(path)}: ${rm.err.split("\n").pop()}`); continue; }
    c.retiredWorktrees++;
    checkedOut.delete(branch);
    if (branch && branch !== "main" && deleteBranch(branch, tip)) c.deletedBranches++;
  }

  for (const line of git(main, ["for-each-ref", "--format=%(refname:short)\t%(objectname)", "refs/heads"]).out.split("\n").filter(Boolean)) {
    const [b, tip] = line.split("\t");
    if (protectedBranch(b) || checkedOut.has(b)) continue;
    const v = landed(main, base, tip);
    const branchAge = cutoff - newestMtime([join(common, "logs/refs/heads", b)]);
    if (v.how !== "ancestor") {
      const issues = issuesOf(tip);
      const cls = laneClass({ dirty: false, equivalent: v.landed, issues: v.landed ? [] : issues.map(issueState), age: 0, held: false });
      if (cls === "owned") {
        const hours = unlandedRow(name, main, base, tip, "(branch)", b, v.ahead, ""); c.unlanded++;
        owned.push({ where: "(branch)", branch: b, age_h: hours, refs: issues, owner: owner(name) });
        c.kept++;
        if (o.dryRun) log(`owned branch ${b}: surface to ${owner(name)}${issues.length ? ` (${issues.join(" ")})` : ""}`);
        continue;
      }
      const why = branchAge < 0 ? `touched within ${o.idleHours}h` : localArchiveGuard(main, name, base, b, tip);
      if (why) {
        if (!v.landed) { unlandedRow(name, main, base, tip, "(branch)", b, v.ahead, ""); c.unlanded++; }
        c.kept++;
        if (o.dryRun) log(`${cls} branch ${b}: keep (${why})`);
        continue;
      }
      if (o.dryRun) { log(`${cls} branch ${b}: archive to archive/${name}/${b}/${tip.slice(0, 12)}, then delete`); c.deletedBranches++; continue; }
      const r = retireLane(main, name, { path: "", branch: b, tip, dirty: false, label: b });
      if (!r.retired || r.why.startsWith("branch")) {
        if (!v.landed) { unlandedRow(name, main, base, tip, "(branch)", b, v.ahead, ""); c.unlanded++; }
        c.kept++; log(`${cls} branch ${b}: kept (${r.why})`); continue;
      }
      c.deletedBranches++;
      retired(cls, `branch ${b}`, b, tip, r);
      continue;
    }
    const decision = retirementVerdict({ age: branchAge, minimumAge: 0, merged: v.landed, equivalent: false, evilMerge: false, archiveAge: -1, protections: 0 });
    if (decision === "keep") { c.kept++; continue; }
    if (o.dryRun) { log(`delete branch ${b} (${v.how})`); c.deletedBranches++; continue; }
    if (deleteBranch(b, tip)) c.deletedBranches++;
  }
  report.owned = owned.sort((a, b) => b.age_h - a.age_h);
  if (!o.dryRun) { git(main, ["worktree", "prune"]); git(main, ["remote", "prune", "origin"], 180_000); }
}

function raiseAlerts(dryRun: boolean) {
  const parents = new Map<string, Owned[]>();
  for (const [repo, r] of Object.entries(stale.repos)) for (const row of r.owned || []) parents.set(row.owner, [...(parents.get(row.owner) || []), { ...row, where: repo }]);
  const alerts = stale.alerts ||= {};
  for (const [parent, rows] of parents) {
    const oldest = Math.max(...rows.map((r) => r.age_h));
    if (rows.length <= 25 && oldest <= 72) continue;
    const text = `${parent}: ${rows.length} owned unlanded lanes, oldest ${oldest}h (${rows[0].where} ${rows.find((r) => r.age_h === oldest)!.branch}); continue, land or archive each (lane-gc --unlanded)`;
    if (dryRun) { console.log(`would alert ${text}`); continue; }
    if (alerts[parent] && now() - Date.parse(alerts[parent]) < 24 * 3600_000) continue;
    const sent = command(["supply-alert", "normal", text, "Unlanded lanes"]);
    if (!sent.ok) { console.log(`lane-gc: supply-alert failed for ${parent}`); continue; }
    alerts[parent] = new Date(now()).toISOString();
    console.log(`lane-gc: alerted ${text}`);
  }
}

export function containers(root: string, only: string[], remote = false): string[] {
  return readdirSync(root).sort().filter((n) => (!SKIP.has(n) && !n.endsWith("-data")) && (!only.length || only.includes(n)))
    .map((n) => join(root, n)).filter((c) => existsSync(join(c, "main/.git")) && (remote || existsSync(join(c, "worktrees"))));
}

function main(argv: string[]): number {
  process.chdir(HOME);
  const o: Opts = { remote: false, dryRun: false, root: join(HOME, "code"), repos: [], idleHours: 3, state: join(HOME, ".local/state/agents/lane-gc/unlanded.txt") };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--remote") o.remote = true;
    else if (a === "--dry-run") o.dryRun = true;
    else if (a === "--repo") o.repos.push(argv[++i]);
    else if (a === "--root") o.root = argv[++i];
    else if (a === "--idle-hours") o.idleHours = Number(argv[++i]);
    else if (a === "--state") o.state = argv[++i];
    else if (a === "--unlanded") {
      if (!existsSync(o.state)) { console.error(`lane-gc: no report yet at ${tilde(o.state)}; run lane-gc --dry-run`); return 1; }
      process.stdout.write(readFileSync(o.state, "utf8"));
      return 0;
    } else if (a === "-h" || a === "--help") { console.log(USAGE); return 0; }
    else { console.error(USAGE); return 2; }
  }
  stalePath = process.env.LANE_GC_STALE_FILE || join(HOME, ".local/state/agents/lane-gc/stale.json");
  try { stale = JSON.parse(readFileSync(stalePath, "utf8")); } catch { stale = { at: "", repos: {} }; }
  stale.notices = [];
  stale.at = new Date(now()).toISOString();
  {
    const local = scanTrees(o.root, false);
    const onNexus = hostname() === "nexus";
    laptopTrees = onNexus ? { ok: false, branches: {} } : local;
    nexusTrees = onNexus ? local : scanTrees(o.root, true);
    peer = onNexus ? { name: "Laptop", trees: laptopTrees } : { name: "Nexus", trees: nexusTrees };
  }
  const live = o.remote ? [] : liveRoots();
  const c: Counts = { retiredWorktrees: 0, deletedBranches: 0, deletedRemote: 0, kept: 0, unlanded: 0 };
  for (const container of containers(o.root, o.repos, o.remote)) {
    try { if (o.remote) remoteSweep(container, o, c); else { sweep(container, o, live, c); if (originRepo(join(container, "main"))) remoteSweep(container, { ...o, remote: false }, c); } } catch (e) {
      if (!o.dryRun && stale.landing_pings) for (const key of Object.keys(stale.landing_pings)) if (key.startsWith(`${basename(container)}:`)) delete stale.landing_pings[key];
      console.log(`${basename(container)}: stopped: ${e}`);
    }
  }
  if (!o.remote) raiseAlerts(o.dryRun);
  mkdirSync(dirname(stalePath), { recursive: true });
  writeFileSync(stalePath + ".tmp", JSON.stringify(stale, null, 2) + "\n");
  renameSync(stalePath + ".tmp", stalePath);
  const header = `# lane-gc ${new Date().toISOString()}: unlanded worktrees and branches (age of last commit, container, path, branch, ahead, dirty, first subject, refs)\n`;
  const body = reportRows.sort((a, b) => parseInt(b) - parseInt(a)).join("\n");
  if (!o.dryRun && !o.repos.length) {
    mkdirSync(dirname(o.state), { recursive: true });
    writeFileSync(o.state + ".tmp", header + body + (body ? "\n" : ""));
    renameSync(o.state + ".tmp", o.state);
  } else if (o.dryRun) console.log(header + body);
  console.log(`lane-gc${o.dryRun ? " (dry run)" : ""}: retired ${c.retiredWorktrees} worktrees, ${c.deletedBranches} local branches, ${c.deletedRemote} origin branches; kept ${c.kept} (${c.unlanded} unlanded)`);
  return 0;
}

if (import.meta.main) process.exit(main(Bun.argv.slice(2)));
