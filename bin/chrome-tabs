#!/usr/bin/env python3
import ctypes
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
from uuid import uuid4

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/lib"))
from chrome_tabs import call, create, locked, process_token, reap


def tools():
    process = subprocess.Popen(["claude", "--claude-in-chrome-mcp"], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        for index, method, params in [(1, "initialize", {"protocolVersion": "2024-11-05",
                "capabilities": {}, "clientInfo": {"name": "chrome-tabs", "version": "1"}}),
                (2, "tools/list", {})]:
            process.stdin.write(json.dumps({"jsonrpc": "2.0", "id": index,
                                           "method": method, "params": params}) + "\n")
            process.stdin.flush()
            while True:
                reply = json.loads(process.stdout.readline())
                if reply.get("id") == index:
                    break
        return [opened_at_url(tool) for tool in reply["result"]["tools"] if tool["name"] != "browser_batch"]
    finally:
        process.terminate()
        process.wait(timeout=5)


def opened_at_url(tool):
    if tool["name"] != "tabs_create_mcp":
        return tool
    schema = tool.get("inputSchema", {})
    url = {"type": "string", "description": "Open the new tab directly at this URL. Always pass it: "
           "actions on a blank New Tab page prompt the user."}
    return {**tool, "inputSchema": {**schema, "properties": {**schema.get("properties", {}), "url": url}}}


def mcp(path):
    available = tools()
    for line in sys.stdin:
        request = json.loads(line)
        if "id" not in request:
            continue
        method = request["method"]
        try:
            if method == "initialize":
                result = {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}},
                          "serverInfo": {"name": "Recorded Chrome session", "version": "1"}}
            elif method == "tools/list":
                result = {"tools": available}
            elif method == "tools/call":
                params = request["params"]
                result = call(path, params["name"], params.get("arguments", {}))
            elif method == "ping":
                result = {}
            else:
                raise ValueError("Unsupported MCP method")
            reply = {"jsonrpc": "2.0", "id": request["id"], "result": result}
        except (OSError, ValueError, KeyError) as error:
            reply = {"jsonrpc": "2.0", "id": request["id"],
                     "error": {"code": -32000, "message": str(error)}}
        print(json.dumps(reply), flush=True)


def parent_death_signal(parent):
    def configure():
        if ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM, 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "Cannot bind Claude lifetime to launcher")
        if os.getppid() != parent:
            os.kill(os.getpid(), signal.SIGTERM)
    return configure


def trusted(path):
    try:
        projects = json.loads((Path.home() / ".claude.json").read_text()).get("projects", {})
    except (OSError, ValueError):
        return False
    return any(projects.get(str(folder), {}).get("hasTrustDialogAccepted") for folder in [path, *path.parents])


def workspace():
    for folder in (Path.cwd(), Path.home() / "code"):
        if trusted(folder):
            return folder
    raise ValueError(f"{Path.cwd()} is not a trusted Claude workspace")


def native_hosts():
    sockets = (Path("/tmp") / f"claude-mcp-browser-bridge-{os.environ['USER']}").glob("*.sock")
    return [socket for socket in sockets if socket.is_socket()]


def start_chrome(session_id):
    chrome = shutil.which("google-chrome-stable")
    if chrome is None:
        raise ValueError("No Chrome native host and google-chrome-stable is not installed")
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect",
                    f"--unit=agent-chrome-{session_id}", "--property=Type=exec",
                    "--", chrome, "--no-startup-window"], check=True)
    deadline = time.monotonic() + 20
    while not (sockets := native_hosts()) and time.monotonic() < deadline:
        time.sleep(0.1)
    return sockets


def run(args):
    if args and args[0] == "--":
        args = args[1:]
    if not args or Path(args[0]).name != "claude" or "--chrome" not in args:
        raise ValueError("run requires claude --chrome")
    cwd = workspace()
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "agents/chrome-tabs"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    session_id = str(uuid4())
    path = state / f"{session_id}.json"
    sockets = native_hosts()
    if not sockets:
        sockets = start_chrome(session_id)
    if len(sockets) != 1:
        raise ValueError("Expected exactly one existing Chrome native host")
    native = sockets[0]
    record = {"session_id": session_id, "group_key": f"chat:{session_id}",
              "owner_pid": os.getpid(), "owner_start": process_token(os.getpid()),
              "native_socket": str(native), "native_inode": native.stat().st_ino,
              "tabs": [], "group_id": None}
    create(path, record)
    script = str(Path(__file__).resolve())
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect",
                    f"--unit=agent-chrome-tabs-{session_id}", "--property=Type=exec",
                    "--", sys.executable, script, "reap", str(path)], check=True)
    config = {"mcpServers": {"chrome-tabs": {"command": sys.executable,
              "args": [script, "mcp", str(path)]}}}
    args = [arg for arg in args if arg != "--chrome"]
    if not any(arg in args for arg in ("--session-id", "--resume", "-r", "--continue", "-c")):
        args.extend(["--session-id", session_id])
    child = subprocess.Popen([*args, "--no-chrome", "--mcp-config", json.dumps(config)],
                             cwd=cwd, preexec_fn=parent_death_signal(os.getpid()))
    with locked(path) as owned:
        owned["child_pid"] = child.pid
        owned["child_start"] = process_token(child.pid)
    def stop(signum, frame):
        child.send_signal(signum)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    return child.wait()


def main():
    try:
        command = sys.argv[1]
        if command == "run":
            return run(sys.argv[2:])
        if command == "reap":
            reap(Path(sys.argv[2]))
        elif command == "mcp":
            mcp(Path(sys.argv[2]))
        else:
            raise ValueError("usage: chrome-tabs run -- claude --chrome [args]")
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"chrome-tabs: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
