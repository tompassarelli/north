#!/usr/bin/env python3
"""Copy a working tree to Nexus, run a bounded CPU job, and retrieve its outputs."""

import argparse
import json
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/lib"))
from ssh_transport import ssh_argv


LAUNCH = r'''
import json, os, pathlib, subprocess, sys
spec = json.loads(sys.argv[1])
pathlib.Path(spec["pid"]).write_text(str(os.getpid()))
skill = pathlib.Path(subprocess.check_output(["agents", "path", "machine-capacity"], text=True).strip())
argv = ["bun", str(skill.parent / "scripts/machine-capacity.mjs"), "run", "--class", "moderate", "--owner", "nexus-run", "--timeout-seconds", str(spec["timeout"]), "--", "python3", "-c", sys.argv[2], sys.argv[3]]
os.execvp(argv[0], argv)
'''

STOP = r'''
import os, pathlib, signal, sys, time
file = pathlib.Path(sys.argv[1]) / "run.pid"
if file.exists():
    pid = int(file.read_text())
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        sys.exit(0)
    for _ in range(100):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            sys.exit(0)
        time.sleep(0.1)
    sys.exit("nexus-run: remote wrapper still stopping; preserving workspace")
'''


REMOTE = r'''
import json, os, pathlib, subprocess, sys
spec = json.loads(sys.argv[1])
root = pathlib.Path(spec["root"])
os.chdir(root / spec["cwd"])
os.environ["NEXUS_OUTPUT"] = str(root.parent / "out")
os.environ["CLASSIC_EFFECT_CACHE"] = str(pathlib.Path.home() / ".local/share/smashcraft-render-assets/stock/65794b789a867a5f745f0cfb3e6d089b197a7bf239fdb43cfd75e5e251015705")
os.environ["WC3_STORAGE"] = str(pathlib.Path.home() / ".local/share/nexus-stock-storage")
for directory in spec["install"]:
    subprocess.run(["bun", "install", "--frozen-lockfile"], cwd=root / directory, check=True)
sys.exit(subprocess.run(spec["command"]).returncode)
'''


def relative(value):
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        raise argparse.ArgumentTypeError("use a path relative to the source tree")
    return str(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path)
    parser.add_argument("--cwd", type=relative)
    parser.add_argument("--install", type=relative, action="append", default=[])
    parser.add_argument("--pull", type=relative, action="append", default=[])
    parser.add_argument("--output-dir", type=Path)
    parser.add_argument("--timeout-seconds", type=int, default=900)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or not 1 <= args.timeout_seconds <= 3600:
        parser.error("provide -- COMMAND and a timeout between 1 and 3600 seconds")
    origin = Path.cwd().resolve()
    source = (args.source or Path(subprocess.check_output(
        ["git", "rev-parse", "--show-toplevel"], text=True).strip())).resolve()
    cwd = args.cwd if args.cwd is not None else str(origin.relative_to(source))
    job = uuid.uuid4().hex
    remote_home = subprocess.check_output(ssh_argv("-o", "BatchMode=yes", "nexus", "printf %s \"$HOME\""), text=True, timeout=90)
    remote = f"{remote_home}/.cache/nexus-run/{job}"
    output = (args.output_dir or Path.home() / ".cache/nexus-run" / job).resolve()
    output.mkdir(parents=True, exist_ok=True)
    route = shlex.join(ssh_argv("-o", "BatchMode=yes"))

    def ssh(*argv, **kwargs):
        kwargs.setdefault("timeout", 90)
        return subprocess.run(ssh_argv("-o", "BatchMode=yes", "nexus", shlex.join(argv)), **kwargs)

    def copy(src, dst, **kwargs):
        return subprocess.run(["rsync", "-a", "--protect-args", "-e", route, *kwargs.pop("options", []), src, dst],
                              timeout=args.timeout_seconds + 30, **kwargs)

    files = subprocess.check_output(["git", "-C", str(source), "ls-files", "-z", "--cached", "--others", "--exclude-standard"])
    try:
        project = source.relative_to(Path.home() / "code").parts[0]
        baseline = remote_home + "/code/" + project + "/main"
    except ValueError:
        baseline = str(source)
    reuse = ["--checksum", "--copy-dest=" + baseline] if ssh("test", "-d", baseline).returncode == 0 else []
    selected = []
    for item in sorted(set(files.split(b"\0")) - {b""}):
        path = Path(os.fsdecode(item))
        if not any(part in (".git", ".ssh", ".env", "node_modules") or part.startswith(".env.") for part in path.parts) and (source / path).exists():
            selected.append(item)
    result = 1
    running = False
    try:
        ssh("mkdir", "-p", remote + "/source", remote + "/out", check=True)
        copy(str(source) + "/", "nexus:" + remote + "/source/", options=[*reuse, "--from0", "--files-from=-"], input=b"\0".join(selected) + b"\0", check=True)
        ssh("git", "-C", remote + "/source", "init", "-q", check=True)
        spec = json.dumps(dict(root=remote + "/source", cwd=cwd, install=args.install, command=command))
        launch = json.dumps(dict(pid=remote + "/run.pid", timeout=args.timeout_seconds))
        print(f"nexus-run: remote={remote} outputs={output}", file=sys.stderr, flush=True)
        running = True
        result = ssh("python3", "-c", LAUNCH, launch, REMOTE, spec, timeout=args.timeout_seconds + 30).returncode
        running = result == 255
        copy("nexus:" + remote + "/out/", str(output) + "/", check=True)
        for path in args.pull:
            target = output / "source" / path
            target.parent.mkdir(parents=True, exist_ok=True)
            copy("nexus:" + remote + "/source/" + path, str(target), check=True)
        return result
    finally:
        if running:
            ssh("python3", "-c", STOP, remote, check=True)
        ssh("python3", "-c", "import shutil,sys; shutil.rmtree(sys.argv[1])", remote, check=True)


def interrupted(*_):
    raise KeyboardInterrupt()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError, ValueError) as error:
        print(f"nexus-run: {error}", file=sys.stderr)
        sys.exit(1)
