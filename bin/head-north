#!/usr/bin/env bash
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
code=() defer=0
[ "${1:-}" != --code ] || { code=(--code "$2"); shift 2; }
[ "${1:-}" != --no-build ] || { defer=1; shift; }
live=${XDG_STATE_HOME:-$HOME/.local/state}/north/current/north
cache=${XDG_CACHE_HOME:-$HOME/.cache}/north/head-north
keep=4 hold=3600 settle=${HEAD_NORTH_SETTLE:-2}
engine=${HEAD_NORTH_ENGINE:-/etc/buildbarn/store-generation}
build() {
  printf 'head-north: building north from the tree: %s (git status: %s)\n' "${reason%%$'\n'*}" "$(git -C "$root" status --porcelain | head -3 | tr '\n' ' ')" >&2
  if [ ! -f "$engine" ] && [ "${GITHUB_ACTIONS:-}" != true ]; then
    local artifact=${XDG_STATE_HOME:-$HOME/.local/state}/north/runtime-artifacts/$tree/north
    [ -n "$tree" ] && { [ -x "$artifact" ] || artifact=$("$live" runtime build-ahead --fetch --tree "$tree"); } || { printf 'head-north: no build-ahead artifact for tree %s, so no verdict\n' "${tree:-of this unclean checkout}" >&2; exit 75; }
    printf '%s\n' "$artifact"; return
  fi
  [ -x "$live" ] || { local out=$root/buck-out/north/head-north remote=(--remote-only) wrapper=("$root/bin/land-shell" --dev --); [ "${GITHUB_ACTIONS:-}" != true ] || { remote=(); wrapper=(); }; mkdir -p "${out%/*}"; rm -f "$out"; printf 'head-north: buck2 build %s //:north --out %s\n' "${remote[*]}" "$out" >&2; "${wrapper[@]}" buck2 build "${remote[@]}" //:north --out "$out" >&2 || { [ $? != 3 ] || { printf 'head-north: north does not compile from this tree, so the check fails\n' >&2; exit 1; }; printf 'head-north: building north from the tree failed, so no older north runs in its place\n' >&2; exit 75; }; printf '%s\n' "$out"; return; }
  local built status=0; built=$("$live" runtime tree-build) || status=$?
  case $status in 0) printf '%s\n' "${built##*$'\n'}"; return ;; 1 | 75) exit "$status" ;; esac
  printf 'head-north: the live runtime %s could not build north from the tree (exit %s), so no older north runs in its place\n' "$live" "$status" >&2; exit 75
}
prune() {
  local cutoff=$(($(date +%s) - hold))
  find "$cache" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9a-f]{40}' -printf '%T@ %f\n' | sort -rn | tail -n +$((keep + 1)) | while read -r stamp old; do
    [ "${stamp%.*}" -lt "$cutoff" ] || continue
    flock -n "$cache/$old/lease" rm -f "$cache/$old/north" "$cache/$old.lock" "$cache/$old/lease" || continue
    rmdir "$cache/$old" 2>/dev/null || true
  done
}
clean_tree() {
  [[ ${HEAD_NORTH_TREE:-} =~ ^[0-9a-f]{40}$ && -x $cache/$HEAD_NORTH_TREE/north ]] && { printf '%s\n' "$HEAD_NORTH_TREE"; return; }
  [ -z "$(git -C "$root" status --porcelain --untracked-files=no)" ] && git -C "$root" rev-parse 'HEAD^{tree}'
}
store() {
  cp --reflink=auto "$1" "$cache/$tree.part"
  mkdir -p "$cache/$tree"
  mv -f "$cache/$tree.part" "$cache/$tree/north"
  prune
}
from_tree() {
  if ! tree=$(clean_tree); then
    north=$(build)
    return
  fi
  mkdir -p "$cache"
  exec 7>"$cache/$tree.lock"
  flock 7
  if [ -x "$cache/$tree/north" ]; then
    printf 'head-north: running the north this host built from tree %.12s: %s\n' "$tree" "${reason%%$'\n'*}" >&2
    touch "$cache/$tree"
  else
    built=$(build); store "$built"
  fi
  exec 7>&-
  north=$cache/$tree/north
  export NORTH_HOME=${NORTH_HOME:-$root}
}
lease() {
  local file=$(dirname "$1")/lease
  (: >>"$file") 2>/dev/null || return 1
  exec 8>>"$file" || return 1
  flock -s 8 && [ -x "$1" ] && return 0
  exec 8>&-
  return 1
}
pick() {
  north="" tree="" reason="no live runtime at $live"
  if [ ${#code[@]} = 0 ] && tree=$(clean_tree) && [ -x "$cache/$tree/north" ]; then
    printf 'head-north: running the north this host keeps for tree %.12s\n' "$tree" >&2
    touch "$cache/$tree"
    north=$cache/$tree/north
    export NORTH_HOME=${NORTH_HOME:-$root}
  elif [ "$shun" = 0 ] && [ -x "$live" ] && reason=$("$live" runtime covers --head "$covered" "${code[@]}" 2>&1); then
    north=$reason
    if [ -n "$tree" ] && [ "$(git -C "$root" rev-parse "$covered^{tree}" 2>/dev/null)" = "$tree" ]; then
      mkdir -p "$cache"
      exec 7>"$cache/$tree.lock"
      flock 7
      [ -x "$cache/$tree/north" ] || store "$north"
      exec 7>&-
    fi
  elif [ "$defer" = 1 ]; then
    printf 'head-north: refused, no live runtime covers the checker code (%s); the lander runs this check without --no-build on a build host, which builds north from the tree\n' "${reason%%$'\n'*}" >&2
    exit 1
  elif [ -n "${NORTH_OFFLOAD_SLOT:-}" ] && [ ! -x "$live" ]; then north=$live
  else from_tree
  fi
}
covered=${SAFE_PUSH_LAND_RUNTIME_HEAD:-${SAFE_PUSH_LAND_HEAD:-HEAD}} shun=0 leased=0
[ "${1:-}" != --build ] || { pick; exit 0; }
for attempt in 1 2 3 4 5; do
  pick
  if lease "$north"; then
    leased=1
    break
  fi
  printf 'head-north: %s is not a whole runtime yet (another process may be building it); trying again\n' "$(dirname "$north")" >&2
  [ "$attempt" = 5 ] || sleep "$settle"
done
if [ "$leased" = 0 ]; then
  [ "$defer" = 0 ] || { printf 'head-north: refused, the live runtime %s stayed unreadable\n' "$(dirname "$north")" >&2; exit 1; }
  [ -z "${NORTH_OFFLOAD_SLOT:-}" ] || { printf 'head-north: refused, no whole runtime at %s after waiting, and an offload slot never builds north from the tree it checks\n' "$(dirname "$north")" >&2; exit 75; }
  shun=1 reason="the live runtime stayed unreadable"
  from_tree
  lease "$north" || { printf 'head-north: the north built from the tree cannot be leased\n' >&2; exit 75; }
fi
case $north in "$cache"/* | "$root"/* | "${CARGO_TARGET_DIR:-$root/target}"/*) ! north lane exec --help 2>/dev/null | grep -q "lane exec \\[--lane" || exec north lane exec --lane "$root" -- "$north" "$@" ;; esac
exec "$north" "$@"
