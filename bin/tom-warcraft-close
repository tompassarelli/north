#!/usr/bin/env bash
# Close Tom's Steam launch of Battle.net and Warcraft III completely, so his next Play starts the game.
set -euo pipefail
compat=${TOM_WARCRAFT_COMPAT:-$HOME/.local/share/Steam/steamapps/compatdata/3516115571}
appid=${TOM_WARCRAFT_APPID:-3775098022}
proc=${TOM_WARCRAFT_PROC:-/proc}

members() {
  local dir pid stat state ppid found=" " grew=1
  local -A parent=()
  for dir in "$proc"/[0-9]*; do
    [ -O "$dir" ] || continue
    pid=${dir##*/}
    { read -r stat <"$dir/stat"; } 2>/dev/null || continue
    read -r state ppid _ <<<"${stat##*) }"
    [ "$state" != Z ] || continue
    parent[$pid]=$ppid
    if grep -qzxF "STEAM_COMPAT_DATA_PATH=$compat" "$dir/environ" 2>/dev/null \
      || grep -qzxF "AppId=$appid" "$dir/cmdline" 2>/dev/null; then
      found+="$pid "
    fi
  done
  while [ "$grew" = 1 ]; do
    grew=0
    for pid in "${!parent[@]}"; do
      case $found in *" $pid "*) continue ;; *" ${parent[$pid]} "*) found+="$pid " grew=1 ;; esac
    done
  done
  # shellcheck disable=SC2086
  echo $found
}

describe() {
  local pid
  for pid in "$@"; do
    printf '  %s %s\n' "$pid" "$({ tr '\0' ' ' <"$proc/$pid/cmdline"; } 2>/dev/null | cut -c1-160)"
  done
}

if [ "${1:-}" = "--list" ]; then members; exit 0; fi
pids=$(members)
[ -n "$pids" ] || { echo "tom-warcraft-close: nothing running"; exit 0; }
# shellcheck disable=SC2086
kill -TERM $pids 2>/dev/null || true
for _ in $(seq 1 20); do
  sleep 0.5
  [ -n "$(members)" ] || break
done
left=$(members)
# shellcheck disable=SC2086
[ -z "$left" ] || kill -KILL $left 2>/dev/null || true
sleep 1
left=$(members)
if [ -n "$left" ]; then
  echo "tom-warcraft-close: FAILED: these processes of Tom's Steam launch survived KILL, so the next Play may do nothing:" >&2
  # shellcheck disable=SC2086
  describe $left >&2
  exit 1
fi
echo "tom-warcraft-close: closed $(wc -w <<<"$pids") processes of Tom's Steam launch; a process check finds none left"
