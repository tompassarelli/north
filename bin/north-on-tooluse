#!/usr/bin/env bash
set -uo pipefail
entry_dir="$(cd "$(dirname "$0")" && pwd)"
bun="${NORTH_BUN:-$entry_dir/runtime/bun}"
[ -x "$bun" ] || bun="$(command -v bun 2>/dev/null || true)"
[ -n "$bun" ] && [ -r "$entry_dir/north-lifecycle.js" ] || exit 0
exec "$bun" "$entry_dir/north-lifecycle.js" tooluse
