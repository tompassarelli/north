import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/lib"))
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/scripts"))
from calibration import open_ledger
import durable_events
from ssh_transport import ssh_argv

DB = os.environ.get("THREADS_DB") or os.path.expanduser("~/.local/state/threads/threads.db")
CACHE_SECONDS = 60
REMOTE = os.path.expanduser("~/.config/threads/remote")
SPOOL = os.path.expanduser("~/.local/state/threads/spool")
SNAPSHOT = os.path.expanduser("~/.local/state/threads/snapshot.db")
READS = {"job-runs", "show", "ready", "list", "unowned", "run-ids", "summary", "recommend", "calibrate", "replay-staffing", "planner-band", "routing-compare"}
UNREACHABLE, RETRY = 255, 75

# Every repository under OWNER whose issues NorthThreads tracks. A ref names the
# GitHub repository (firn#3); ALIASES lets a checkout's name stand in for it.
OWNER = "tompassarelli"
REPOS = ["smashcraft", "smashcraft-client", "padbridge", "wisp", "firn", "north", "gjoa", "fram", "wake", "battlecraft"]
ALIASES = {"nixos-config": "firn"}
# Native namespaces live only in this database and never reach GitHub.
NATIVE = ["life", "accounts", "travel", "ops"]
NATIVE_REF = re.compile(r"\b(?:life|accounts|travel|ops)#\d+\b")
KINDS = "'claim','release','handoff','need','unneed','run','note','capture','close','reopen'" + ',' + ','.join(repr(kind) for kind in durable_events.KINDS)

SCHEMA = """
CREATE TABLE IF NOT EXISTS events(
  seq INTEGER PRIMARY KEY,
  ts TEXT NOT NULL,
  item TEXT,
  kind TEXT NOT NULL CHECK(kind IN (KINDS)),
  actor TEXT NOT NULL DEFAULT '',
  tier TEXT NOT NULL DEFAULT '',
  data TEXT NOT NULL DEFAULT '{}' CHECK(json_valid(data))
) STRICT;
CREATE TABLE IF NOT EXISTS claims(
  item TEXT PRIMARY KEY CHECK(item GLOB '*#[0-9]*'),
  owner TEXT NOT NULL CHECK(length(owner) > 0),
  since TEXT NOT NULL,
  eta_min INTEGER CHECK(eta_min IS NULL OR eta_min > 0)
) STRICT;
CREATE TABLE IF NOT EXISTS runs(
  agent TEXT PRIMARY KEY,
  item TEXT,
  follows TEXT,
  session TEXT,
  tier TEXT NOT NULL,
  category TEXT NOT NULL,
  started TEXT,
  ended TEXT NOT NULL,
  minutes INTEGER NOT NULL CHECK(minutes >= 0),
  eta_min INTEGER,
  tokens INTEGER,
  peak_ctx INTEGER,
  outcome TEXT NOT NULL CHECK(outcome IN ('done','not done','escalated','handoff','split','unclear','running','idle')),
  report TEXT NOT NULL DEFAULT '',
  note TEXT,
  repeats INTEGER,
  landed INTEGER,
  arm TEXT,
  spec TEXT,
  scope TEXT,
  surface TEXT,
  verify TEXT,
  lens TEXT,
  flaws INTEGER,
  expects_landing INTEGER,
  staffed TEXT,
  first_commit TEXT,
  review_requested TEXT,
  landed_at TEXT,
  landed_sha TEXT,
  turns INTEGER,
  role TEXT NOT NULL DEFAULT 'worker',
  compactions INTEGER,
  handoff_fires INTEGER,
  handoff_ignored INTEGER,
  input_tokens INTEGER,
  cache_read_tokens INTEGER,
  idle_gap_misses INTEGER,
  account TEXT,
  cost_usd REAL,
  model TEXT,
  effort TEXT,
  fast INTEGER CHECK(fast IN (0, 1)),
  brief_text TEXT,
  brief_origin TEXT
) STRICT;
CREATE TABLE IF NOT EXISTS run_usage(
  agent TEXT NOT NULL,
  request TEXT NOT NULL,
  ts TEXT NOT NULL,
  account TEXT NOT NULL,
  weight REAL NOT NULL CHECK(weight >= 0),
  PRIMARY KEY(agent, request)
) STRICT;
CREATE TABLE IF NOT EXISTS tier_choice(
  cell TEXT PRIMARY KEY,
  tier TEXT NOT NULL,
  since TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS gh_cache(
  repo TEXT PRIMARY KEY,
  fetched REAL NOT NULL,
  issues TEXT NOT NULL CHECK(json_valid(issues))
) STRICT;
CREATE TABLE IF NOT EXISTS blocks(
  item TEXT PRIMARY KEY,
  reason TEXT NOT NULL,
  since TEXT NOT NULL,
  by TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS run_events(
  agent TEXT NOT NULL,
  ts TEXT,
  kind TEXT NOT NULL CHECK(kind IN ('turn','tool_error','retry')),
  detail TEXT NOT NULL DEFAULT ''
) STRICT;
CREATE TABLE IF NOT EXISTS job_runs(
  name TEXT NOT NULL,
  host TEXT NOT NULL,
  started TEXT NOT NULL,
  finished TEXT,
  rc INTEGER,
  PRIMARY KEY(name, host, started)
) STRICT;
CREATE TABLE IF NOT EXISTS job_queue(
  id INTEGER PRIMARY KEY,
  placement TEXT NOT NULL CHECK(length(placement) > 0),
  item TEXT,
  cmd TEXT NOT NULL CHECK(json_valid(cmd)),
  state TEXT NOT NULL DEFAULT 'queued' CHECK(state IN ('queued','taken','done','failed','dropped','requeued')),
  queued TEXT NOT NULL,
  taken TEXT,
  finished TEXT,
  result TEXT
) STRICT;
CREATE TABLE IF NOT EXISTS items(
  ns TEXT NOT NULL,
  number INTEGER NOT NULL CHECK(number > 0),
  title TEXT NOT NULL CHECK(length(title) > 0),
  body TEXT NOT NULL DEFAULT '',
  state TEXT NOT NULL DEFAULT 'open' CHECK(state IN ('open','closed')),
  created TEXT NOT NULL,
  closed TEXT,
  due TEXT,
  PRIMARY KEY(ns, number)
) STRICT;
CREATE TABLE IF NOT EXISTS item_needs(
  item TEXT NOT NULL,
  needs TEXT NOT NULL,
  PRIMARY KEY(item, needs)
) STRICT;
CREATE INDEX IF NOT EXISTS events_item ON events(item, seq);
CREATE INDEX IF NOT EXISTS run_events_agent ON run_events(agent, ts);
CREATE INDEX IF NOT EXISTS runs_item ON runs(item, ended);
""".replace("KINDS", KINDS)


class Refused(Exception):
    pass


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def minutes_since(ts):
    return int((datetime.now(timezone.utc) - datetime.fromisoformat(ts.replace("Z", "+00:00"))).total_seconds() // 60)


def default_actor() -> str:
    return os.environ.get("THREADS_ACTOR") or os.environ.get("USER") or "unknown"


def table_exists(db, name):
    return db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)).fetchone()


class Tx:
    """One BEGIN IMMEDIATE transaction per command: every write lands whole or not at all."""

    def __init__(self, db: sqlite3.Connection):
        self.db = db

    def __enter__(self):
        self.db.execute("BEGIN IMMEDIATE")
        return self.db

    def __exit__(self, kind, *_):
        self.db.execute("COMMIT" if kind is None else "ROLLBACK")
        return False


def connect() -> sqlite3.Connection:
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=60, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout = 60000")
    if db.execute("PRAGMA journal_mode").fetchone()[0] != "wal":
        db.execute("PRAGMA journal_mode = WAL")
    with Tx(db):
        migrate_schema(db)
    durable_events.migrate(db, SCHEMA, Tx)
    return db


def migrate_schema(db):
    if not table_exists(db, "blocks"):
        for stmt in SCHEMA.split(";"):
            if stmt.strip():
                db.execute(stmt)
    columns = {r[1] for r in db.execute("PRAGMA table_info(runs)")}
    for column in ("repeats", "landed"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    for column in ("arm", "spec", "scope", "surface", "verify", "lens"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} TEXT")
    for column in ("flaws", "expects_landing", "turns"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    if "role" not in columns:
        db.execute("ALTER TABLE runs ADD COLUMN role TEXT NOT NULL DEFAULT 'worker'")
    for column in CONTEXT[1:]:
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    for column in (*STAGES, "first_commit", "landed_sha"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} TEXT")
    for column, kind in (("account", "TEXT"), ("cost_usd", "REAL"), ("model", "TEXT"), ("effort", "TEXT"), ("fast", "INTEGER"), ("brief_text", "TEXT"), ("brief_origin", "TEXT"), ("brief_path", "TEXT"), ("brief_sha256", "TEXT")):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} {kind}")
    db.execute("CREATE TABLE IF NOT EXISTS run_usage(agent TEXT NOT NULL, request TEXT NOT NULL, ts TEXT NOT NULL,"
               " account TEXT NOT NULL, weight REAL NOT NULL CHECK(weight >= 0), PRIMARY KEY(agent, request)) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS run_costs(account TEXT NOT NULL, started TEXT NOT NULL, ended TEXT NOT NULL,"
               " agent TEXT NOT NULL, cost_usd REAL NOT NULL, PRIMARY KEY(account, started, ended, agent)) STRICT"); db.execute("CREATE INDEX IF NOT EXISTS run_costs_agent ON run_costs(agent)")
    runs_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'runs'").fetchone()[0]
    if "'idle'" not in runs_sql:
        split_sql = (re.sub(r'^CREATE TABLE\s+"?runs"?\s*\(', "CREATE TABLE runs_split(", runs_sql, count=1)
                     .replace("'handoff','unclear'", "'handoff','split','unclear','running'")
                     .replace("'split','unclear')", "'split','unclear','running')").replace("'unclear','running')", "'unclear','running','idle')"))
        if "'idle'" not in split_sql:
            raise SystemExit("NorthThreads: runs table outcome check has an unexpected form; not migrating")
        db.execute(split_sql)
        db.execute("INSERT INTO runs_split SELECT * FROM runs")
        db.execute("DROP TABLE runs")
        db.execute("ALTER TABLE runs_split RENAME TO runs")
        db.execute("CREATE INDEX IF NOT EXISTS runs_item ON runs(item, ended)")
    db.execute("CREATE TABLE IF NOT EXISTS tier_choice(cell TEXT PRIMARY KEY, tier TEXT NOT NULL, since TEXT NOT NULL) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS run_events(agent TEXT NOT NULL, ts TEXT, kind TEXT NOT NULL"
               " CHECK(kind IN ('turn','tool_error','retry')), detail TEXT NOT NULL DEFAULT '') STRICT")
    db.execute("CREATE INDEX IF NOT EXISTS run_events_agent ON run_events(agent, ts)")
    db.execute("CREATE TABLE IF NOT EXISTS job_runs(name TEXT NOT NULL, host TEXT NOT NULL, started TEXT NOT NULL,"
               " finished TEXT, rc INTEGER, PRIMARY KEY(name, host, started)) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS job_queue(id INTEGER PRIMARY KEY, placement TEXT NOT NULL CHECK(length(placement) > 0),"
               " item TEXT, cmd TEXT NOT NULL CHECK(json_valid(cmd)), state TEXT NOT NULL DEFAULT 'queued'"
               " CHECK(state IN ('queued','taken','done','failed','dropped')), queued TEXT NOT NULL, taken TEXT, finished TEXT,"
               " result TEXT) STRICT")
    queue_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'job_queue'").fetchone()[0]
    if "'dropped'" not in queue_sql:
        dropped_sql = (re.sub(r'CREATE TABLE "?job_queue"?\(', "CREATE TABLE job_queue_dropped(", queue_sql, count=1)
                       .replace("'done','failed')", "'done','failed','dropped')"))
        if "'dropped'" not in dropped_sql:
            raise SystemExit("NorthThreads: job_queue state check has an unexpected form; not migrating")
        db.execute(dropped_sql)
        db.execute("INSERT INTO job_queue_dropped SELECT * FROM job_queue")
        db.execute("DROP TABLE job_queue")
        db.execute("ALTER TABLE job_queue_dropped RENAME TO job_queue")
        queue_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'job_queue'").fetchone()[0]
    if "'requeued'" not in queue_sql:
        requeued_sql = (re.sub(r'CREATE TABLE "?job_queue"?\(', "CREATE TABLE job_queue_requeued(", queue_sql, count=1)
                        .replace("'dropped')", "'dropped','requeued')"))
        if "job_queue_requeued(" not in requeued_sql:
            raise SystemExit("NorthThreads: job_queue has an unexpected form; not migrating")
        if "'requeued'" not in requeued_sql:
            raise SystemExit("NorthThreads: job_queue state check has an unexpected form; not migrating")
        db.execute(requeued_sql)
        db.execute("INSERT INTO job_queue_requeued SELECT * FROM job_queue")
        db.execute("DROP TABLE job_queue")
        db.execute("ALTER TABLE job_queue_requeued RENAME TO job_queue")
    db.execute("CREATE TABLE IF NOT EXISTS calibration(at TEXT NOT NULL, kind TEXT NOT NULL, cell TEXT NOT NULL,"
               " n INTEGER NOT NULL, p25 REAL, median REAL, p75 REAL, value REAL, source TEXT NOT NULL) STRICT")
    if not table_exists(db, "items"):
        events = db.execute("SELECT sql FROM sqlite_master WHERE name = 'events'").fetchone()[0]
        if "'capture'" not in events:
            db.execute("DROP INDEX IF EXISTS events_item")
            db.execute("ALTER TABLE events RENAME TO events_old")
        for stmt in SCHEMA.split(";"):
            if stmt.strip():
                db.execute(stmt)
        if "'capture'" not in events:
            db.execute("INSERT INTO events SELECT * FROM events_old")
            db.execute("DROP TABLE events_old")


# Stage times a run row carries, all derived from transcripts and git: spawned,
# first report back (review requested), and its commit's time on origin/main.
STAGES = ("staffed", "review_requested", "landed_at")
CONTEXT = ("role", "peak_ctx", "compactions", "handoff_fires", "handoff_ignored", "input_tokens", "cache_read_tokens", "idle_gap_misses")


# Issue refs and GitHub ---------------------------------------------------------

REF = re.compile(r"^([\w.-]+(?:/[\w.-]+)?)#(\d+)$")


def parse_ref(ref: str) -> tuple[str, int]:
    """'smashcraft#222', 'tompassarelli/smashcraft#222' or 'nixos-config#3' -> ('smashcraft', 222) / ('firn', 3)."""
    m = REF.match(ref.strip())
    if not m:
        raise Refused(f"{ref} is not an issue ref like smashcraft#222")
    name = m.group(1).removeprefix(f"{OWNER}/")
    repo = ALIASES.get(name, name)
    if repo in NATIVE and no_native_reason():
        raise Refused(f"native items are not readable here: {no_native_reason()}")
    if repo not in REPOS + NATIVE:
        raise Refused(f"unknown repo {m.group(1)} (known: {', '.join(REPOS + NATIVE)})")
    return repo, int(m.group(2))


def ref(repo: str, number: int) -> str:
    return f"{repo}#{number}"


def no_native_reason() -> str | None:
    """Native items are for Claude and Codex sessions on Tom's machines: bin/agy exports THREADS_NO_NATIVE, and a
    Claude Code cloud session sets CLAUDE_CODE_REMOTE."""
    if os.environ.get("THREADS_NO_NATIVE"):
        return "THREADS_NO_NATIVE is set (agy)"
    if os.environ.get("CLAUDE_CODE_REMOTE"):
        return "CLAUDE_CODE_REMOTE is set (cloud worker)"
    return None


def gitleaks_clean(text: str):
    try:
        p = subprocess.run(["gitleaks", "stdin", "--no-banner", "--redact", "-l", "error"], input=text,
                           capture_output=True, text=True, cwd="/")
    except FileNotFoundError:
        raise Refused("gitleaks is not on PATH; items are scanned for secrets before they are stored")
    if p.returncode != 0:
        raise Refused("gitleaks found a secret in the item text; credentials stay in Bitwarden, so nothing was stored")


def gh(*args: str) -> str:
    """Run gh, waiting out rate-limit refusals (retry-after unknown: 30 s doubling to 5 min, ~65 min in all)."""
    if any(NATIVE_REF.search(a) for a in args):
        raise Refused("a gh argument names a native item; native items never reach GitHub")
    delay, waited = 30.0, 0.0
    while True:
        p = subprocess.run(["gh", *args], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout
        if "rate limit" not in p.stderr.lower() or waited > 65 * 60:
            raise Refused(f"gh {args[0]} {args[1] if len(args) > 1 else ''}: {p.stderr.strip()}")
        pause = delay * random.uniform(0.8, 1.2)
        print(f"NorthThreads: GitHub rate limit, waiting {pause:.0f} s", file=sys.stderr)
        time.sleep(pause)
        waited += pause
        delay = min(delay * 2, 300)


OPEN_ISSUES = """
query($owner: String!, $name: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    issues(states: OPEN, first: 100, after: $cursor) {
      pageInfo { hasNextPage endCursor }
      nodes { number title blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } } }
    }
  }
}"""


def blockers(node) -> list:
    out = []
    for b in node["blockedBy"]["nodes"]:
        full = b["repository"]["nameWithOwner"]
        out.append({"ref": ref(full.removeprefix(f"{OWNER}/"), b["number"]), "state": b["state"]})
    return out


def local_blockers(db, item: str) -> list:
    out = []
    for (needs,) in db.execute("SELECT needs FROM item_needs WHERE item = ? ORDER BY needs", (item,)).fetchall():
        hidden = no_native_reason() and NATIVE_REF.fullmatch(needs)
        repo, number = parse_ref(needs) if not hidden else (needs.split("#")[0], int(needs.split("#")[1]))
        if repo in NATIVE:
            row = db.execute("SELECT state FROM items WHERE ns = ? AND number = ?", (repo, number)).fetchone()
            state = row["state"].upper() if row else "CLOSED"
        else:
            state = "OPEN" if str(number) in open_issues(db, repo) else "CLOSED"
        out.append({"ref": "a native item" if hidden else needs, "state": state})
    return out


def native_item(db, ns: str, number: int):
    row = db.execute("SELECT * FROM items WHERE ns = ? AND number = ?", (ns, number)).fetchone()
    if row is None:
        raise Refused(f"no item {ref(ns, number)}")
    return row


def open_issues(db, repo: str) -> dict:
    """{number: {title, blockers}} for the repo's open issues; one paged query, cached CACHE_SECONDS.
    A native namespace reads its open items from the items table; local needs add blockers to either."""
    if repo in NATIVE:
        return {str(r["number"]): {"title": r["title"], "blockers": local_blockers(db, ref(repo, r["number"]))}
                for r in db.execute("SELECT number, title FROM items WHERE ns = ? AND state = 'open'", (repo,)).fetchall()}
    row = db.execute("SELECT fetched, issues FROM gh_cache WHERE repo = ?", (repo,)).fetchone()
    if row and time.time() - row["fetched"] < CACHE_SECONDS:
        return json.loads(row["issues"])
    owner, name = OWNER, repo
    issues, cursor = {}, None
    while True:
        args = ["api", "graphql", "-f", f"query={OPEN_ISSUES}", "-F", f"owner={owner}", "-F", f"name={name}"]
        if cursor:
            args += ["-F", f"cursor={cursor}"]
        page = json.loads(gh(*args))["data"]["repository"]["issues"]
        for n in page["nodes"]:
            issues[str(n["number"])] = {"title": n["title"], "blockers": blockers(n)}
        if not page["pageInfo"]["hasNextPage"]:
            break
        cursor = page["pageInfo"]["endCursor"]
    with Tx(db):
        db.execute(
            "INSERT OR REPLACE INTO gh_cache(repo, fetched, issues) VALUES (?,?,?)",
            (repo, time.time(), json.dumps(issues)),
        )
    return issues


# Commands --------------------------------------------------------------------


# Runs (fed by north worker-ledger) ---------------------------------------------------

BRIEF_FIELD = {name: re.compile(rf"\b{name}:[ \t]*([^\s`<>]+)") for name in ("Item", "Follows", "Arm")}
CATEGORY = re.compile(r"\bCategory:[ \t]*([A-Za-z-]+)")
LENS = re.compile(r"\bLens:[ \t]*([^.;,\n`<>]+)")
# Orthogonal brief facets, each a closed vocabulary; src/guard/worker_tier.rs holds the same lists.
FACETS = {
    "spec": ["exact", "measured", "judged"],
    "scope": ["one-file", "module", "cross-module", "cross-repo"],
    "surface": ["ts", "lua", "nix", "shell", "workflow", "docs", "assets"],
    "verify": ["none", "local-test", "farm", "native", "visual"],
}
FACET_FIELD = {f: re.compile(rf"\b{f.capitalize()}:[ \t]*([A-Za-z-]+)") for f in FACETS}


def brief_fields(brief: str) -> dict:
    out = {}
    for name, pattern in BRIEF_FIELD.items():
        m = pattern.search(brief)
        if m:
            out[name.lower()] = m.group(1).rstrip(".,;:)")
    m = CATEGORY.search(brief)
    if m:
        out["category"] = m.group(1).strip().lower()
    for facet, pattern in FACET_FIELD.items():
        m = pattern.search(brief)
        if m and m.group(1).lower() in FACETS[facet]:
            out[facet] = m.group(1).lower()
    for label, key in (("Summed box ETA", "initial_eta"), ("Prior Not dones", "prior_not_done")):
        m = re.search(rf"\b{label}:[ \t]*(\d+)(?:m)?(?=[ \t,;\n.]|$)", brief)
        if m:
            out[key] = int(m.group(1))
    m = LENS.search(brief)
    if m:
        out["lens"] = m.group(1).strip().lower()
    return out


CATEGORIES = [
    "mechanical", "docs-policy", "tooling", "feature", "bug-known-cause", "debugging-unknown-cause",
    "netcode-determinism", "performance", "balance-tuning", "native-check", "research",
]


def north_ledger(*argv):
    try:
        code = subprocess.run([os.environ.get("NORTH_BIN") or "north", "ledger", *argv], env=dict(os.environ, THREADS_DB=DB)).returncode
    except OSError as e:
        raise Refused(f"cannot run north ledger {argv[0]}: {e}")
    if code:
        raise Refused(f"north ledger {argv[0]} exited {code}")


def cmd_planner_band(db, a):
    north_ledger("planner-band")


def cmd_record_priors(db, a):
    rows = []
    for spec in a.priors:
        m = re.fullmatch(r"([\w.-]+):(\d+):(\d+)(?::(-?[\d.]+))?", spec)
        if not m:
            raise Refused(f"record-priors: {spec!r} is not NAME:N:NEED[:VALUE]")
        rows.append((m[1], int(m[2]), float(m[3]), "defaults-measure --priors" + (f" value={m[4]}" if m[4] else "")))
    end = now()
    with Tx(db):
        db.executemany("INSERT INTO calibration(at, kind, cell, n, value, source) VALUES (?, 'prior', ?, ?, ?, ?)",
                       [(end, *r) for r in rows])


def cmd_agent_event(db, a):
    gitleaks_clean(a.body)
    item = ref(*parse_ref(a.item)) if a.item else None
    if item and item.split('#')[0] in NATIVE:
        native_item(db, *parse_ref(item))
    for event_id in (a.answer, a.root_event):
        if event_id is not None:
            target = durable_events.addressed(db, event_id)
            if target['item']:
                parse_ref(target['item'])
            root = json.loads(target['data']).get('root_event')
            if root is not None:
                linked = durable_events.addressed(db, root)
                if linked['item']:
                    parse_ref(linked['item'])
    data = {field: getattr(a, field) for field in ('to_node', 'repo', 'lane', 'sha', 'body', 'packet', 'key', 'root_event', 'answer')}
    print(json.dumps(durable_events.append(db, a.kind, item, a.from_node, data, now(), Tx)))


def cmd_agent_events(db, a):
    rows = durable_events.pending(db, a.id)
    if no_native_reason():
        rows = [row for row in rows if not row['item'] or not NATIVE_REF.fullmatch(row['item'])]
    print(json.dumps(rows))


def cmd_agent_event_state(db, a):
    row = durable_events.addressed(db, a.id)
    if row['item']:
        parse_ref(row['item'])
    print(json.dumps(durable_events.update_state(db, a.id, json.loads(a.update_json), Tx)))


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="threads",
        description=f"Who holds which GitHub issue, handoffs and worker runs. Items are issue refs "
                    f"({', '.join(r + '#N' for r in REPOS)}). Database: {DB}",
        epilog="A running worker whose brief has `Item: <repo#N>` holds that issue (recorded by north worker-ledger); "
               "claim/release are for humans and lanes. Brief categories: "
               + ", ".join(CATEGORIES) + "; anything else counts as unknown. Facets: "
               + "; ".join(f"{k.capitalize()}: {' | '.join(v)}" for k, v in FACETS.items())
               + "; Lens: <reviewer lens>. unowned: order is priority:now, unlabeled, "
               "priority:next, priority:later; the owner is a NorthThread claim not past 2x its ETA or held by a live org session, else an origin claude/* or "
               f"*land-* branch with a commit in the last 48 h whose name, or a commit headline or "
               "Item:/Closes/Fixes/Refs line ahead of main, names the issue; blocked:REASON comes from `threads block` "
               f"or a comment starting `Blocked:` in the last 7 days. Cloud routine runs are not a source: the "
               "CLI cannot read them.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def cmd(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        s.add_argument("--by", default=default_actor(), help="who is acting (default $THREADS_ACTOR or $USER)")
        return s

    s = cmd("agent-event", cmd_agent_event, "publish a durable addressed event")
    s.add_argument("kind", choices=durable_events.KINDS)
    s.add_argument("item", nargs="?")
    s.add_argument("--from-node", required=True)
    s.add_argument("--to-node", required=True)
    s.add_argument("--body", required=True)
    for field in ("repo", "lane", "sha", "packet", "key"):
        s.add_argument("--" + field)
    for field in ("answer", "root-event"):
        s.add_argument("--" + field, type=int)
    s = cmd("agent-events", cmd_agent_events, "read canonical pending addressed events")
    s.add_argument("--id", type=int)
    s = cmd("agent-event-state", cmd_agent_event_state, "update durable delivery state")
    s.add_argument("id", type=int)
    s.add_argument("--update-json", required=True)

    cmd("planner-band", cmd_planner_band, "read-only realized item difficulty, measured planner cut points and leave-one-out accuracy per input set")
    s = cmd("record-priors", cmd_record_priors, "append one calibration row of kind prior per default: cell NAME, n its "
            "settling count, value the count it needs, and the measured VALUE in source")
    s.add_argument("priors", nargs="+", metavar="NAME:N:NEED[:VALUE]")
    return p


def refresh_snapshot(dest, force=False, snapshot=SNAPSHOT):
    """Keep a local copy of the remote ledger for reads while the remote is unreachable."""
    try:
        subprocess.run([os.environ.get("NORTH_BIN") or "north", "threads", "snapshot-pull", *(["--force"] if force else []), "--snapshot", str(snapshot), dest],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=90)
    except subprocess.TimeoutExpired:
        return


def ssh(dest, args, **io):
    actor = os.environ.get("THREADS_ACTOR")
    remote = [f"THREADS_ACTOR={actor}"] if actor else []
    remote += ["THREADS_NO_NATIVE=1"] if no_native_reason() else []
    if args[:1] == ["show"]:
        remote += ["THREADS_ARCHIVES_LOCAL=1"]
    remote = ["env", *remote] if remote else []
    try:
        return subprocess.run(ssh_argv("-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "LogLevel=QUIET", dest,
                                      shlex.join(remote + [*(["north"] if args[:1] == ["ingest"] else []), "threads", *args])), timeout=90, **io).returncode
    except subprocess.TimeoutExpired:
        print(f"NorthThreads: {dest} timed out; remote outcome unknown", file=sys.stderr)
        return 124


def flush_spool(dest):
    """Send spooled batches in order under the spool lock: True when empty, False while the remote is unreachable, "busy" while it refuses ingest for its lock."""
    if not os.path.isdir(SPOOL):
        return True
    with open(os.path.join(SPOOL, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for path in sorted([*Path(SPOOL).glob("*.jsonl"), *Path(SPOOL).glob("*.argv")], key=lambda p: p.name):
            try:
                f = open(path, "rb")
            except FileNotFoundError:
                continue
            with f:
                if path.suffix == ".argv":
                    args = json.loads(f.read())
                    output = {"stdout": subprocess.DEVNULL} if args[:1] == ["agent-event"] else {}
                    code = ssh(dest, args, stdin=subprocess.DEVNULL, **output)
                else:
                    code = ssh(dest, ["ingest"], stdin=f)
            if code in (UNREACHABLE, RETRY):
                return "busy" if code == RETRY else False
            if code != 0:
                path.rename(path.with_suffix(".failed"))
                print(f"NorthThreads: remote ingest refused {path}; kept as .failed", file=sys.stderr)
                continue
            path.unlink(missing_ok=True)
    return True


def proxy(dest, argv) -> int:
    """The ledger lives on the remote host: run every command there; ingest spools while it is unreachable."""
    if argv[:1] == ["planner-band"] or argv[:1] == ["recommend"] and "--planner" in argv:
        code = ssh(dest, argv)
        if code != UNREACHABLE:
            return code
        if os.path.exists(SNAPSHOT):
            taken = datetime.fromtimestamp(os.path.getmtime(SNAPSHOT), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            print(f"STALE: ledger snapshot from {taken}; {dest} unreachable", file=sys.stderr)
            return None
        return code
    if argv[:1] == ["agent-event"]:
        parsed = parser().parse_args(argv)
        try:
            gitleaks_clean(parsed.body)
        except Refused as error:
            print(f"NorthThreads: {error}", file=sys.stderr)
            return 1
        if parsed.key is not None and not parsed.key.strip():
            print("NorthThreads: key must be nonempty text", file=sys.stderr)
            return 1
        if not any(arg == "--key" or arg.startswith("--key=") for arg in argv):
            argv = [*argv, "--key", str(uuid.uuid4())]
    reachable = flush_spool(dest)
    if argv[:1] == ["ingest"]:
        data = sys.stdin.buffer.read()
        if reachable is True:
            code = ssh(dest, argv, input=data)
            if code not in (UNREACHABLE, RETRY):
                if code == 0 and any(json.loads(line).get("type") == "usage" for line in data.splitlines() if line.strip()):
                    refresh_snapshot(dest, force=True)
                return code
        os.makedirs(SPOOL, exist_ok=True)
        path = Path(SPOOL) / f"{time.time_ns()}-{os.getpid()}.jsonl"
        path.with_suffix(".tmp").write_bytes(data)
        path.with_suffix(".tmp").rename(path)
        print(f"NorthThreads: {dest} unreachable; spooled ingest to {path}", file=sys.stderr)
        return 0
    if argv[:1] in (["job-run"], ["agent-event"]):
        code = ssh(dest, argv, stdin=subprocess.DEVNULL) if reachable is True else UNREACHABLE
        if code != UNREACHABLE:
            return code
        os.makedirs(SPOOL, mode=0o700, exist_ok=True)
        os.chmod(SPOOL, 0o700)
        path = Path(SPOOL) / f"{time.time_ns()}-{os.getpid()}.argv"
        with open(path.with_suffix(".tmp"), "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as packet:
            packet.write(json.dumps(argv))
        path.with_suffix(".tmp").rename(path)
        return 0
    code = ssh(dest, argv) if reachable else UNREACHABLE
    if argv[:1] in (["agent-events"], ["agent-event-state"]):
        if code == UNREACHABLE:
            print(f"NorthThreads: {dest} unreachable; canonical events unavailable", file=sys.stderr)
        return code
    if code == 124:
        return code
    if code != UNREACHABLE:
        if not (code == 0 and argv[:1] == ["calibrate"] and "--write" in argv and "--goal-row" in argv):
            refresh_snapshot(dest, force=code == 0 and (argv[:1] == ["record-priors"] or argv[:1] == ["calibrate"] and "--write" in argv))
        if code == 0 and argv[:1] == ["show"]:
            repo, number = parse_ref(next(arg for arg, before in zip(argv[1:], argv) if not arg.startswith("-") and before != "--by"))
            if repo not in NATIVE:
                print(subprocess.run([os.environ.get("NORTH_BIN") or "north", "archives", repo, str(number)], capture_output=True, text=True).stdout, end="")
        return code
    if argv[:1] and argv[0] in READS and os.path.exists(SNAPSHOT):
        taken = datetime.fromtimestamp(os.path.getmtime(SNAPSHOT), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"STALE: ledger snapshot from {taken}; {dest} unreachable", file=sys.stderr)
        return None
    print(f"NorthThreads: {dest} unreachable; the ledger lives there, so nothing was read or recorded", file=sys.stderr)
    return code


RUST_VERBS = ("claim", "list", "job-run", "job-runs", "queue", "show", "ready", "unowned", "release", "need", "unneed", "new", "note", "close", "reopen", "block", "ingest", "run-ids", "recommend", "calibrate", "replay-staffing", "summary", "routing-compare")


def delegate(argv) -> int:
    """These verbs run in Rust behind `north threads`; this file migrates the ledger first while it owns the schema."""
    if os.environ.get("THREADS_SCHEMA_READY"):
        raise Refused(f"this north predates its own {argv[0]}; run north runtime update")
    if DB != SNAPSHOT:
        connect().close()
    return subprocess.run([os.environ.get("NORTH_BIN") or "north", "threads", *argv],
                          env=dict(os.environ, THREADS_DB=DB, THREADS_SCHEMA_READY="1")).returncode


def main(argv=None) -> int:
    global DB
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] in (["claim"], ["list"], ["unowned"]) and not os.environ.get("THREADS_DB") and os.path.exists(REMOTE):
        return subprocess.run([os.environ.get("NORTH_BIN") or "north", "threads", *argv]).returncode
    if argv[:1] == ["routing-compare"] and not os.environ.get("THREADS_DB"):
        DB = SNAPSHOT
    elif not os.environ.get("THREADS_DB") and os.path.exists(REMOTE):
        code = proxy(open(REMOTE).read().strip(), argv)
        if code is not None:
            return code
        DB = SNAPSHOT
    if argv[:1] and argv[0] in RUST_VERBS:
        try:
            return delegate(argv)
        except (Refused, sqlite3.DatabaseError) as e:
            print(f"NorthThreads: {e}", file=sys.stderr)
            return 1
    a = parser().parse_args(argv)
    try:
        if DB == SNAPSHOT:
            db = sqlite3.connect(":memory:", isolation_level=None)
            with open_ledger(DB) as source:
                source.backup(db)
            db.row_factory = sqlite3.Row
        elif a.cmd in ("planner-band",):
            db = open_ledger(DB)
            db.row_factory = sqlite3.Row
        else:
            db = connect()
    except sqlite3.DatabaseError as e:
        if "snapshot still unreadable after one refresh" not in str(e):
            print(f"NorthThreads: {e}", file=sys.stderr)
        return 1
    try:
        a.fn(db, a)
    except (Refused, ValueError) as e:
        print(f"NorthThreads: {e}", file=sys.stderr)
        return 1
    finally:
        db.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
