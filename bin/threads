#!/usr/bin/env python3
"""NorthThreads: who holds which GitHub issue, handoffs, and the worker runs spent
on each. GitHub owns the issue itself (title, boxes, state, blocked-by); this
SQLite file holds only what GitHub can't."""

from __future__ import annotations

