    s.add_argument("reason", nargs="*")
    s.add_argument("--clear", action="store_true")
    s = cmd("summary", cmd_summary, "runs by category (or --group facets) and tier: success, minutes against ETA, "
            "working (staffed to first report) and waiting (first report to its commit on origin/main) medians, "
            "and accepted flaws per reviewer Lens")
    s.add_argument("--since", help="only runs that ended on or after DATE")
    s.add_argument("--group", default="category", help=f"comma list of {', '.join(GROUPS)} (default category)")
    s = cmd("recommend", cmd_recommend,
            f"tier (an orchestration.toml key, every provider) whose first-assignment runs reported Done with no later "
            "Follows: run (and landed when it committed) at an 80%% measured success threshold in the finest "
            f"cell holding a tier with >= {MIN_RUNS} runs, backing off {', '.join(BACKOFF)}; among passing tiers the cheapest "
            f"by measured $ per success, by tier order when one has under {USD_MIN} priced runs; a dearer tier replaces the "
            f"cell's last recommendation only when it beats it by {MARGIN} points on >= {MIN_RUNS} runs each")
    s.add_argument("--planner", action="store_true", help="measured planner effort band from nearest past items")
    s.add_argument("facets", help="brief facet lines, e.g. 'Item: firn#12, Category: tooling, Spec: measured, Scope: one-file'")
    s.add_argument("--since", help="only runs that ended on or after DATE")
    cmd("planner-band", cmd_planner_band, "read-only realized item difficulty, measured planner cut points and fixed-seed held-out check")
    cmd("routing-compare", cmd_routing_compare, "read-only campaign arms by category: landed items, speed, quality, review minutes and account points")
    s = cmd("calibrate", cmd_calibrate,
            f"predicted against actual per provider: eta (minutes / brief ETA), eta_pred (minutes / recommend's p75 "
