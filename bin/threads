            f"n < {CAL_FLOOR} or older than {CAL_MAX_DAYS} days")
    s.add_argument("--since", default="7d", help="window: Nd, Nh or a DATE (default 7d)")
    s.add_argument("--json", action="store_true")
    s.add_argument("--write", action="store_true", help="append the rows to the calibration table")
    s.add_argument("--goal-row", help="with --write, append one goal_eta or goal_actual row (JSON: kind, cell, n, value, source)"
                   " instead of measuring")
    s = cmd("record-priors", cmd_record_priors, "append one calibration row of kind prior per default: cell NAME, n its "
            "settling count, value the count it needs, and the measured VALUE in source")
    s.add_argument("priors", nargs="+", metavar="NAME:N:NEED[:VALUE]")
    s = cmd("replay-staffing", cmd_replay_staffing, "walk forward over first-assignment worker runs in the window: the old "
            "pick (Claude tiers by rank) and the new pick (every provider, $ per success) from strictly earlier runs, the "
            "cells where they differ with their history, and whether each run's actual tier and outcome agree")
    s.add_argument("--since", default="7d", help="window: Nd, Nh or a DATE (default 7d)")
    s = cmd("job-run", cmd_job_run, "record a scheduled job's start (no --finished) or finish, keyed by name, host and "
            "started; written by job-run, spooled while the remote is unreachable")
    s.add_argument("name")
    s.add_argument("--host", required=True)
    s.add_argument("--started", required=True)
    s.add_argument("--finished")
    s.add_argument("--rc", type=int)
    s = cmd("job-runs", cmd_job_runs, "scheduled job runs per name and host: count, failures, unfinished, last start and rc")
    s.add_argument("--json", action="store_true", help="one object per name and host with first_started, last_ok "
                   "(finish of the latest successful run), last_started, last_rc and open_since (latest unfinished start)")
    s = cmd("queue", cmd_queue, "jobs for a placement (laptop, or pool for any runner) that may be asleep: add PLACEMENT "
            "REF|- -- CMD...; take PLACEMENT[,PLACEMENT...] claims the oldest queued job of those placements and prints it "
            "as JSON, or nothing; msg ID done|failed TEXT records the result and comments it on the job's issue, and msg ID requeued TEXT "
            "puts a taken job back at its original position as requeued; drop ID REASON drops a queued or requeued job, recording REASON as its result; no action lists jobs with their wait from queued to taken and their job_runs row (name queue-ID). "
            "Follows boxes (placement follows): follow REF --tier T --parent NAME queues the brief on stdin, whose `Follows:` "
            "line names a commit subject, SHA or issue ref; follow-list prints the open ones as JSON; follow-release, "
            "follow-started and follow-alert ID TEXT (once per box) are follows-release's steps")
    s.add_argument("--json", action="store_true", help="with no action, one object per job with its latest run's host")
    q = s.add_subparsers(dest="action")
    qa = q.add_parser("add")
    qa.add_argument("placement")
    qa.add_argument("item", help="issue ref, or - for none")
    qa.add_argument("cmd", nargs=argparse.REMAINDER)
    qt = q.add_parser("take")
    qt.add_argument("placement")
    qm = q.add_parser("msg")
    qm.add_argument("id", type=int)
    qm.add_argument("status", choices=["done", "failed", "requeued"])
    qm.add_argument("text", nargs="+")
    qd = q.add_parser("drop")
    qd.add_argument("id", type=int)
    qd.add_argument("reason", nargs="+")
    qf = q.add_parser("follow")
    qf.add_argument("item")
    qf.add_argument("--tier", required=True)
    qf.add_argument("--parent", required=True)
    qf.add_argument("--repo", help="repository whose origin main the predecessor lands on (default: the item's)")
    q.add_parser("follow-list")
    for name in ("follow-release", "follow-started", "follow-alert"):
        qs = q.add_parser(name)
        qs.add_argument("id", type=int)
        if name == "follow-alert":
            qs.add_argument("text", nargs="+")
    return p


def refresh_snapshot(dest, force=False, snapshot=SNAPSHOT):
    """Keep a local copy of the remote ledger for reads while the remote is unreachable."""
    if not force and os.path.exists(snapshot) and time.time() - os.path.getmtime(snapshot) < SNAPSHOT_SECONDS:
        return
    try:
        r = subprocess.run(ssh_argv("-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "LogLevel=QUIET", dest,
                                   "threads snapshot"), capture_output=True, timeout=90)
    except subprocess.TimeoutExpired:
        return
    if r.returncode != 0 or not r.stdout.startswith(b"SQLite format 3"):
        return
    tmp = f"{snapshot}.{os.getpid()}.tmp"
    try:
        Path(tmp).write_bytes(r.stdout)
        with sqlite3.connect(Path(tmp).resolve().as_uri() + "?mode=ro&immutable=1", uri=True) as db:
            if db.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
                return
        os.replace(tmp, snapshot)
    except sqlite3.DatabaseError:
        return
    finally:
        Path(tmp).unlink(missing_ok=True)


def ssh(dest, args, **io):
    actor = os.environ.get("THREADS_ACTOR")
    remote = [f"THREADS_ACTOR={actor}"] if actor else []
    remote += ["THREADS_NO_NATIVE=1"] if no_native_reason() else []
    if args[:1] == ["unowned"]:
        remote += [f"THREADS_ALIVE_OWNERS={json.dumps(sorted(local_alive_owners()))}"]
    if args[:1] == ["show"]:
        remote += ["THREADS_ARCHIVES_LOCAL=1"]
    remote = ["env", *remote] if remote else []
    try:
        return subprocess.run(ssh_argv("-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "LogLevel=QUIET", dest,
                                      shlex.join(remote + ["threads", *args])), timeout=90, **io).returncode
    except subprocess.TimeoutExpired:
        print(f"NorthThreads: {dest} timed out; remote outcome unknown", file=sys.stderr)
        return 124


def flush_spool(dest) -> bool:
    """Send spooled ingest batches in order under the spool lock; False while the remote is unreachable."""
    if not os.path.isdir(SPOOL):
        return True
    with open(os.path.join(SPOOL, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for path in sorted([*Path(SPOOL).glob("*.jsonl"), *Path(SPOOL).glob("*.argv")], key=lambda p: p.name):
            try:
                f = open(path, "rb")
            except FileNotFoundError:
                continue
            with f:
                if path.suffix == ".argv":
                    args = json.loads(f.read())
                    output = {"stdout": subprocess.DEVNULL} if args[:1] == ["agent-event"] else {}
                    code = ssh(dest, args, stdin=subprocess.DEVNULL, **output)
                else:
                    code = ssh(dest, ["ingest"], stdin=f)
            if code == UNREACHABLE:
                return False
            if code != 0:
                path.rename(path.with_suffix(".failed"))
                print(f"NorthThreads: remote ingest refused {path}; kept as .failed", file=sys.stderr)
                continue
            path.unlink(missing_ok=True)
    return True


def proxy(dest, argv) -> int:
    """The ledger lives on the remote host: run every command there; ingest spools while it is unreachable."""
    if argv[:1] == ["planner-band"] or argv[:1] == ["recommend"] and "--planner" in argv:
        code = ssh(dest, argv)
        if code != UNREACHABLE:
            return code
        if os.path.exists(SNAPSHOT):
            taken = datetime.fromtimestamp(os.path.getmtime(SNAPSHOT), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            print(f"STALE: ledger snapshot from {taken}; {dest} unreachable", file=sys.stderr)
            return None
        return code
    if argv[:1] == ["agent-event"]:
        parsed = parser().parse_args(argv)
        try:
            gitleaks_clean(parsed.body)
        except Refused as error:
            print(f"NorthThreads: {error}", file=sys.stderr)
            return 1
        if parsed.key is not None and not parsed.key.strip():
            print("NorthThreads: key must be nonempty text", file=sys.stderr)
            return 1
        if not any(arg == "--key" or arg.startswith("--key=") for arg in argv):
            argv = [*argv, "--key", str(uuid.uuid4())]
    reachable = flush_spool(dest)
    if argv[:1] == ["ingest"]:
        data = sys.stdin.buffer.read()
        if reachable:
            code = ssh(dest, argv, input=data)
            if code != UNREACHABLE:
                if code == 0 and any(json.loads(line).get("type") == "usage" for line in data.splitlines() if line.strip()):
                    refresh_snapshot(dest, force=True)
                return code
        os.makedirs(SPOOL, exist_ok=True)
        path = Path(SPOOL) / f"{time.time_ns()}-{os.getpid()}.jsonl"
        path.with_suffix(".tmp").write_bytes(data)
        path.with_suffix(".tmp").rename(path)
        print(f"NorthThreads: {dest} unreachable; spooled ingest to {path}", file=sys.stderr)
        return 0
    if argv[:1] in (["job-run"], ["agent-event"]):
        code = ssh(dest, argv, stdin=subprocess.DEVNULL) if reachable else UNREACHABLE
        if code != UNREACHABLE:
            return code
        os.makedirs(SPOOL, mode=0o700, exist_ok=True)
        os.chmod(SPOOL, 0o700)
        path = Path(SPOOL) / f"{time.time_ns()}-{os.getpid()}.argv"
        with open(path.with_suffix(".tmp"), "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as packet:
            packet.write(json.dumps(argv))
        path.with_suffix(".tmp").rename(path)
        return 0
    code = ssh(dest, argv) if reachable else UNREACHABLE
    if argv[:1] in (["agent-events"], ["agent-event-state"]):
        if code == UNREACHABLE:
            print(f"NorthThreads: {dest} unreachable; canonical events unavailable", file=sys.stderr)
        return code
    if code == 124:
        return code
    if code != UNREACHABLE:
        if not (code == 0 and argv[:1] == ["calibrate"] and "--write" in argv and "--goal-row" in argv):
            refresh_snapshot(dest, force=code == 0 and (argv[:1] == ["record-priors"] or argv[:1] == ["calibrate"] and "--write" in argv))
        if code == 0 and argv[:1] == ["show"]:
            repo, number = parse_ref(parser().parse_args(argv).id)
            if repo not in NATIVE:
                print_archives(repo, number)
        return code
    if argv[:1] and argv[0] in READS and os.path.exists(SNAPSHOT):
        taken = datetime.fromtimestamp(os.path.getmtime(SNAPSHOT), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"STALE: ledger snapshot from {taken}; {dest} unreachable", file=sys.stderr)
        return None
    print(f"NorthThreads: {dest} unreachable; the ledger lives there, so nothing was read or recorded", file=sys.stderr)
    return code


def cmd_job_run(db, a):
    if (a.finished is None) != (a.rc is None):
        raise Refused("job-run: --finished and --rc go together")
    with Tx(db):
        db.execute("INSERT INTO job_runs(name, host, started, finished, rc) VALUES (?,?,?,?,?) ON CONFLICT(name, host,"
                   " started) DO UPDATE SET finished = excluded.finished, rc = excluded.rc"
                   " WHERE excluded.finished IS NOT NULL", (a.name, a.host, a.started, a.finished, a.rc))


def cmd_job_runs(db, a):
    if a.json:
        rows = db.execute("SELECT name, host, min(started) first_started, max(started) last_started,"
                          " (SELECT max(finished) FROM job_runs j WHERE j.name = r.name AND j.host = r.host AND j.rc = 0) last_ok,"
                          " (SELECT rc FROM job_runs j WHERE j.name = r.name AND j.host = r.host ORDER BY started DESC LIMIT 1) last_rc,"
                          " (SELECT max(started) FROM job_runs j WHERE j.name = r.name AND j.host = r.host AND j.finished IS NULL)"
                          " open_since FROM job_runs r GROUP BY name, host ORDER BY host, name").fetchall()
        print(json.dumps([dict(r) for r in rows]))
        return
    rows = db.execute("SELECT name, host, count(*) n, sum(rc != 0) failed, sum(finished IS NULL) open, max(started) last,"
                      " (SELECT rc FROM job_runs j WHERE j.name = r.name AND j.host = r.host ORDER BY started DESC LIMIT 1)"
                      " last_rc FROM job_runs r GROUP BY name, host ORDER BY host, name").fetchall()
    if rows:
        table([("name", "host", "runs", "failed", "open", "last_started", "last_rc")]
              + [(r["name"], r["host"], str(r["n"]), str(r["failed"] or 0), str(r["open"]), r["last"],
                  "-" if r["last_rc"] is None else str(r["last_rc"])) for r in rows])


FOLLOWS_LINE = re.compile(r"(?m)^\W*Follows:[ \t]*`?(.+?)`?[ \t]*$")
FOLLOW_STEPS = {"follow-release": ("queued", "state = 'taken', taken = ?"),
                "follow-started": ("taken", "state = 'done', finished = ?"),
                "follow-alert": ("taken", "result = ?")}


def follow_step(db, a):
    """Move one follows box a step; refused when another releaser got there first, so each step happens once."""
    state, change = FOLLOW_STEPS[a.action]
    value = " ".join(a.text) if a.action == "follow-alert" else now()
    with Tx(db):
        cur = db.execute(f"UPDATE job_queue SET {change} WHERE id = ? AND placement = 'follows' AND state = ?"
                         + (" AND result IS NULL" if a.action == "follow-alert" else ""), (value, a.id, state))
    if cur.rowcount != 1:
        raise Refused(f"queue {a.action}: box {a.id} is not an open follows box in state {state}")


def drop_job(db, job, reason, by):
    cur = db.execute("UPDATE job_queue SET state = 'dropped', finished = ?, result = ? WHERE id = ? AND state IN ('queued','requeued')",
                     (now(), reason, job))
    if cur.rowcount == 1:
        item = db.execute("SELECT item FROM job_queue WHERE id = ?", (job,)).fetchone()["item"]
        event(db, item, "note", by, job=job, text=f"job {job} dropped: {reason}")
    return cur.rowcount == 1


def queue_wait(r):
    end = r["taken"] or (r["finished"] if r["state"] == "dropped" else None)
    if end is None:
        return f"{minutes_since(r['queued'])}m"
    span = datetime.fromisoformat(end.replace("Z", "+00:00")) - datetime.fromisoformat(r["queued"].replace("Z", "+00:00"))
    return f"{int(span.total_seconds() // 60)}m"


def cmd_queue(db, a):
    """Work for a machine that may be asleep: add queues it, take claims the oldest for a placement, msg records
    the result and posts it on the job's issue."""
    if a.action == "follow":
        brief = sys.stdin.read()
        m = FOLLOWS_LINE.search(brief)
        if not m:
            raise Refused("queue follow: the brief on stdin has no Follows: line")
        item = ref(*parse_ref(a.item))
        repo = a.repo or parse_ref(item)[0]
        box = {"repo": repo, "tier": a.tier, "parent": a.parent, "follows": m.group(1).strip(), "brief": brief}
        with Tx(db):
            cur = db.execute("INSERT INTO job_queue(placement, item, cmd, queued) VALUES ('follows',?,?,?)",
                             (item, json.dumps(box), now()))
        print(cur.lastrowid)
    elif a.action == "follow-list":
        rows = db.execute("SELECT * FROM job_queue WHERE placement = 'follows' AND state IN ('queued','taken')"
                          " ORDER BY id").fetchall()
        print(json.dumps([{"id": r["id"], "item": r["item"], "state": r["state"], "queued": r["queued"],
                           "taken": r["taken"], "alerted": r["result"], **json.loads(r["cmd"])} for r in rows]))
    elif a.action in FOLLOW_STEPS:
        follow_step(db, a)
    elif a.action == "add":
        cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
        if not cmd:
            raise Refused("queue add: no command after --")
        item = None if a.item == "-" else ref(*parse_ref(a.item))
        with Tx(db):
            cur = db.execute("INSERT INTO job_queue(placement, item, cmd, queued) VALUES (?,?,?,?)",
                             (a.placement, item, json.dumps(cmd), now()))
        print(cur.lastrowid)
    elif a.action == "take":
        placements = a.placement.split(",")
        with Tx(db):
            row = db.execute(f"SELECT * FROM job_queue WHERE placement IN ({','.join('?' * len(placements))})"
                             " AND state IN ('queued','requeued') ORDER BY id LIMIT 1", placements).fetchone()
            if row:
                db.execute("UPDATE job_queue SET state = 'taken', taken = ? WHERE id = ?", (now(), row["id"]))
        if row:
            print(json.dumps({"id": row["id"], "placement": row["placement"], "item": row["item"],
                              "cmd": json.loads(row["cmd"])}))
    elif a.action == "msg":
        text = " ".join(a.text)
        with Tx(db):
            row = db.execute("SELECT * FROM job_queue WHERE id = ?", (a.id,)).fetchone()
            if row is None or row["state"] != "taken":
                raise Refused(f"queue msg: job {a.id} is not taken")
            if a.status == "requeued":
                db.execute("UPDATE job_queue SET state = 'requeued', taken = NULL, result = ? WHERE id = ?", (text, a.id))
            else:
                db.execute("UPDATE job_queue SET state = ?, finished = ?, result = ? WHERE id = ?",
                           (a.status, now(), text, a.id))
            if row["item"] and NATIVE_REF.fullmatch(row["item"]):
                event(db, row["item"], "note", a.by, text=f"job {a.id} {a.status}: {text}")
        if row["item"] and not NATIVE_REF.fullmatch(row["item"]):
            gitleaks_clean(text)
            repo, number = parse_ref(row["item"])
            gh("issue", "comment", str(number), "-R", f"{OWNER}/{repo}", "--body", f"Job {a.id} {a.status}:\n\n{text}")
        print(f"job {a.id} {a.status}")
    elif a.action == "drop":
        with Tx(db):
            row = db.execute("SELECT state FROM job_queue WHERE id = ?", (a.id,)).fetchone()
            if row is None or not drop_job(db, a.id, " ".join(a.reason), a.by):
                raise Refused(f"queue drop: job {a.id} is {row['state'] if row else 'unknown'}, not queued")
        print(f"job {a.id} dropped")
    elif a.json:
        rows = db.execute("SELECT q.*, (SELECT host FROM job_runs j WHERE j.name = 'queue-' || q.id ORDER BY started DESC"
                          " LIMIT 1) host FROM job_queue q ORDER BY id").fetchall()
        print(json.dumps([{k: r[k] for k in ("id", "placement", "state", "queued", "taken", "finished", "host")} for r in rows]))
    else:
        rows = db.execute("SELECT q.*, (SELECT host || ' ' || started || ' rc=' || ifnull(rc, '-') FROM job_runs j WHERE j.name ="
                          " 'queue-' || q.id ORDER BY started DESC LIMIT 1) run FROM job_queue q ORDER BY id").fetchall()
        hide = no_native_reason()
        table([("id", "placement", "item", "state", "queued", "wait", "finished", "job_run", "cmd")]
              + [(str(r["id"]), r["placement"], "native" if hide and r["item"] and NATIVE_REF.fullmatch(r["item"])
                  else r["item"] or "-", r["state"], r["queued"], queue_wait(r), r["finished"] or "-", r["run"] or "-",
                  follows_text(json.loads(r["cmd"]))) for r in rows])


def follows_text(cmd):
    return f"follows {cmd['follows']} on {cmd['tier']}" if isinstance(cmd, dict) else shlex.join(cmd)


def cmd_snapshot(db, a):
    if no_native_reason():
        raise Refused(f"the snapshot holds native items: {no_native_reason()}")
    tmp = f"{DB}.snapshot.{os.getpid()}"
    try:
        db.execute("VACUUM INTO ?", (tmp,))
        sys.stdout.buffer.write(Path(tmp).read_bytes())
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main(argv=None) -> int:
    global DB
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["routing-compare"] and not os.environ.get("THREADS_DB"):
        DB = SNAPSHOT
    elif not os.environ.get("THREADS_DB") and os.path.exists(REMOTE):
        code = proxy(open(REMOTE).read().strip(), argv)
        if code is not None:
            return code
        DB = SNAPSHOT
    a = parser().parse_args(argv)
    try:
        if DB == SNAPSHOT:
            db = sqlite3.connect(":memory:", isolation_level=None)
            with open_ledger(DB) as source:
                source.backup(db)
            db.row_factory = sqlite3.Row
        elif a.cmd in ("planner-band", "routing-compare"):
            db = open_ledger(DB)
            db.row_factory = sqlite3.Row
        else:
            db = connect()
    except sqlite3.DatabaseError as e:
        if "snapshot still unreadable after one refresh" not in str(e):
            print(f"NorthThreads: {e}", file=sys.stderr)
        return 1
    try:
        a.fn(db, a)
    except (Refused, ValueError) as e:
        print(f"NorthThreads: {e}", file=sys.stderr)
        return 1
    finally:
        db.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
