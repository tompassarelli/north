# Every repository under OWNER whose issues NorthThreads tracks. A ref names the
# GitHub repository (firn#3); ALIASES lets a checkout's name stand in for it.
OWNER = "tompassarelli"
REPOS = ["smashcraft", "wisp", "firn", "north", "gjoa", "fram", "wake"]
ALIASES = {"nixos-config": "firn"}
# Native namespaces live only in this database and never reach GitHub.
NATIVE = ["life", "accounts", "travel", "ops"]
NATIVE_REF = re.compile(r"\b(?:life|accounts|travel|ops)#\d+\b")
KINDS = "'claim','release','handoff','need','unneed','run','note','capture','close','reopen'" + ',' + ','.join(repr(kind) for kind in durable_events.KINDS)

SCHEMA = """
CREATE TABLE IF NOT EXISTS events(
  seq INTEGER PRIMARY KEY,
  ts TEXT NOT NULL,
  item TEXT,
  kind TEXT NOT NULL CHECK(kind IN (KINDS)),
  actor TEXT NOT NULL DEFAULT '',
  tier TEXT NOT NULL DEFAULT '',
  data TEXT NOT NULL DEFAULT '{}' CHECK(json_valid(data))
) STRICT;
CREATE TABLE IF NOT EXISTS claims(
  item TEXT PRIMARY KEY CHECK(item GLOB '*#[0-9]*'),
  owner TEXT NOT NULL CHECK(length(owner) > 0),
  since TEXT NOT NULL,
  eta_min INTEGER CHECK(eta_min IS NULL OR eta_min > 0)
) STRICT;
CREATE TABLE IF NOT EXISTS runs(
  agent TEXT PRIMARY KEY,
  item TEXT,
  follows TEXT,
  session TEXT,
  tier TEXT NOT NULL,
  category TEXT NOT NULL,
  started TEXT,
  ended TEXT NOT NULL,
  minutes INTEGER NOT NULL CHECK(minutes >= 0),
  eta_min INTEGER,
  tokens INTEGER,
  peak_ctx INTEGER,
  outcome TEXT NOT NULL CHECK(outcome IN ('done','not done','escalated','handoff','split','unclear','running')),
  report TEXT NOT NULL DEFAULT '',
  note TEXT,
  repeats INTEGER,
  landed INTEGER,
  arm TEXT,
  spec TEXT,
  scope TEXT,
  surface TEXT,
  verify TEXT,
  lens TEXT,
  flaws INTEGER,
  expects_landing INTEGER,
  staffed TEXT,
  first_commit TEXT,
  review_requested TEXT,
  landed_at TEXT,
  landed_sha TEXT,
  turns INTEGER,
  role TEXT NOT NULL DEFAULT 'worker',
  compactions INTEGER,
  handoff_fires INTEGER,
  handoff_ignored INTEGER,
  input_tokens INTEGER,
  cache_read_tokens INTEGER,
  idle_gap_misses INTEGER,
  account TEXT,
  cost_usd REAL,
  model TEXT,
  effort TEXT,
  fast INTEGER CHECK(fast IN (0, 1)),
  brief_text TEXT,
  brief_origin TEXT
) STRICT;
CREATE TABLE IF NOT EXISTS run_usage(
  agent TEXT NOT NULL,
  request TEXT NOT NULL,
  ts TEXT NOT NULL,
  account TEXT NOT NULL,
  weight REAL NOT NULL CHECK(weight >= 0),
  PRIMARY KEY(agent, request)
) STRICT;
CREATE TABLE IF NOT EXISTS tier_choice(
  cell TEXT PRIMARY KEY,
  tier TEXT NOT NULL,
  since TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS gh_cache(
  repo TEXT PRIMARY KEY,
  fetched REAL NOT NULL,
  issues TEXT NOT NULL CHECK(json_valid(issues))
) STRICT;
CREATE TABLE IF NOT EXISTS blocks(
  item TEXT PRIMARY KEY,
  reason TEXT NOT NULL,
  since TEXT NOT NULL,
  by TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS run_events(
  agent TEXT NOT NULL,
  ts TEXT,
  kind TEXT NOT NULL CHECK(kind IN ('turn','tool_error','retry')),
  detail TEXT NOT NULL DEFAULT ''
) STRICT;
CREATE TABLE IF NOT EXISTS job_runs(
  name TEXT NOT NULL,
  host TEXT NOT NULL,
  started TEXT NOT NULL,
  finished TEXT,
  rc INTEGER,
  PRIMARY KEY(name, host, started)
) STRICT;
CREATE TABLE IF NOT EXISTS job_queue(
  id INTEGER PRIMARY KEY,
  placement TEXT NOT NULL CHECK(length(placement) > 0),
  item TEXT,
  cmd TEXT NOT NULL CHECK(json_valid(cmd)),
  state TEXT NOT NULL DEFAULT 'queued' CHECK(state IN ('queued','taken','done','failed','dropped','requeued')),
  queued TEXT NOT NULL,
  taken TEXT,
  finished TEXT,
  result TEXT
) STRICT;
CREATE TABLE IF NOT EXISTS items(
  ns TEXT NOT NULL,
  number INTEGER NOT NULL CHECK(number > 0),
  title TEXT NOT NULL CHECK(length(title) > 0),
  body TEXT NOT NULL DEFAULT '',
  state TEXT NOT NULL DEFAULT 'open' CHECK(state IN ('open','closed')),
  created TEXT NOT NULL,
  closed TEXT,
  due TEXT,
  PRIMARY KEY(ns, number)
) STRICT;
CREATE TABLE IF NOT EXISTS item_needs(
  item TEXT NOT NULL,
  needs TEXT NOT NULL,
  PRIMARY KEY(item, needs)
) STRICT;
CREATE INDEX IF NOT EXISTS events_item ON events(item, seq);
CREATE INDEX IF NOT EXISTS run_events_agent ON run_events(agent, ts);
CREATE INDEX IF NOT EXISTS runs_item ON runs(item, ended);
""".replace("KINDS", KINDS)


class Refused(Exception):
    pass


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def minutes_since(ts):
    return int((datetime.now(timezone.utc) - datetime.fromisoformat(ts.replace("Z", "+00:00"))).total_seconds() // 60)


def default_actor() -> str:
    return os.environ.get("THREADS_ACTOR") or os.environ.get("USER") or "unknown"


def table_exists(db, name):
    return db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)).fetchone()


class Tx:
    """One BEGIN IMMEDIATE transaction per command: every write lands whole or not at all."""

    def __init__(self, db: sqlite3.Connection):
        self.db = db

    def __enter__(self):
        self.db.execute("BEGIN IMMEDIATE")
        return self.db

    def __exit__(self, kind, *_):
        self.db.execute("COMMIT" if kind is None else "ROLLBACK")
        return False


def connect() -> sqlite3.Connection:
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=10, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout = 10000")
    if db.execute("PRAGMA journal_mode").fetchone()[0] != "wal":
        db.execute("PRAGMA journal_mode = WAL")
    with Tx(db):
        migrate_schema(db)
    durable_events.migrate(db, SCHEMA, Tx)
    return db


def migrate_schema(db):
    if not table_exists(db, "blocks"):
        for stmt in SCHEMA.split(";"):
            if stmt.strip():
                db.execute(stmt)
    columns = {r[1] for r in db.execute("PRAGMA table_info(runs)")}
    for column in ("repeats", "landed"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    for column in ("arm", "spec", "scope", "surface", "verify", "lens"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} TEXT")
    for column in ("flaws", "expects_landing", "turns"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    if "role" not in columns:
        db.execute("ALTER TABLE runs ADD COLUMN role TEXT NOT NULL DEFAULT 'worker'")
    for column in CONTEXT[1:]:
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    for column in (*STAGES, "first_commit", "landed_sha"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} TEXT")
    for column, kind in (("account", "TEXT"), ("cost_usd", "REAL"), ("model", "TEXT"), ("effort", "TEXT"), ("fast", "INTEGER"), ("brief_text", "TEXT"), ("brief_origin", "TEXT"), ("brief_path", "TEXT"), ("brief_sha256", "TEXT")):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} {kind}")
    db.execute("CREATE TABLE IF NOT EXISTS run_usage(agent TEXT NOT NULL, request TEXT NOT NULL, ts TEXT NOT NULL,"
               " account TEXT NOT NULL, weight REAL NOT NULL CHECK(weight >= 0), PRIMARY KEY(agent, request)) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS run_costs(account TEXT NOT NULL, started TEXT NOT NULL, ended TEXT NOT NULL,"
               " agent TEXT NOT NULL, cost_usd REAL NOT NULL, PRIMARY KEY(account, started, ended, agent)) STRICT")
    runs_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'runs'").fetchone()[0]
    if "'running'" not in runs_sql:
        split_sql = (re.sub(r'^CREATE TABLE\s+"?runs"?\s*\(', "CREATE TABLE runs_split(", runs_sql, count=1)
                     .replace("'handoff','unclear'", "'handoff','split','unclear','running'")
                     .replace("'split','unclear')", "'split','unclear','running')"))
        if "'running'" not in split_sql:
            raise SystemExit("NorthThreads: runs table outcome check has an unexpected form; not migrating")
        db.execute(split_sql)
        db.execute("INSERT INTO runs_split SELECT * FROM runs")
        db.execute("DROP TABLE runs")
        db.execute("ALTER TABLE runs_split RENAME TO runs")
        db.execute("CREATE INDEX IF NOT EXISTS runs_item ON runs(item, ended)")
    db.execute("CREATE TABLE IF NOT EXISTS tier_choice(cell TEXT PRIMARY KEY, tier TEXT NOT NULL, since TEXT NOT NULL) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS run_events(agent TEXT NOT NULL, ts TEXT, kind TEXT NOT NULL"
               " CHECK(kind IN ('turn','tool_error','retry')), detail TEXT NOT NULL DEFAULT '') STRICT")
    db.execute("CREATE INDEX IF NOT EXISTS run_events_agent ON run_events(agent, ts)")
    db.execute("CREATE TABLE IF NOT EXISTS job_runs(name TEXT NOT NULL, host TEXT NOT NULL, started TEXT NOT NULL,"
               " finished TEXT, rc INTEGER, PRIMARY KEY(name, host, started)) STRICT")
    db.execute("CREATE TABLE IF NOT EXISTS job_queue(id INTEGER PRIMARY KEY, placement TEXT NOT NULL CHECK(length(placement) > 0),"
               " item TEXT, cmd TEXT NOT NULL CHECK(json_valid(cmd)), state TEXT NOT NULL DEFAULT 'queued'"
               " CHECK(state IN ('queued','taken','done','failed','dropped')), queued TEXT NOT NULL, taken TEXT, finished TEXT,"
               " result TEXT) STRICT")
    queue_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'job_queue'").fetchone()[0]
    if "'dropped'" not in queue_sql:
        dropped_sql = (re.sub(r'CREATE TABLE "?job_queue"?\(', "CREATE TABLE job_queue_dropped(", queue_sql, count=1)
                       .replace("'done','failed')", "'done','failed','dropped')"))
        if "'dropped'" not in dropped_sql:
            raise SystemExit("NorthThreads: job_queue state check has an unexpected form; not migrating")
        db.execute(dropped_sql)
        db.execute("INSERT INTO job_queue_dropped SELECT * FROM job_queue")
        db.execute("DROP TABLE job_queue")
        db.execute("ALTER TABLE job_queue_dropped RENAME TO job_queue")
        queue_sql = db.execute("SELECT sql FROM sqlite_master WHERE name = 'job_queue'").fetchone()[0]
    if "'requeued'" not in queue_sql:
        requeued_sql = (re.sub(r'CREATE TABLE "?job_queue"?\(', "CREATE TABLE job_queue_requeued(", queue_sql, count=1)
                        .replace("'dropped')", "'dropped','requeued')"))
        if "job_queue_requeued(" not in requeued_sql:
            raise SystemExit("NorthThreads: job_queue has an unexpected form; not migrating")
        if "'requeued'" not in requeued_sql:
            raise SystemExit("NorthThreads: job_queue state check has an unexpected form; not migrating")
        db.execute(requeued_sql)
        db.execute("INSERT INTO job_queue_requeued SELECT * FROM job_queue")
        db.execute("DROP TABLE job_queue")
        db.execute("ALTER TABLE job_queue_requeued RENAME TO job_queue")
    db.execute("CREATE TABLE IF NOT EXISTS calibration(at TEXT NOT NULL, kind TEXT NOT NULL, cell TEXT NOT NULL,"
               " n INTEGER NOT NULL, p25 REAL, median REAL, p75 REAL, value REAL, source TEXT NOT NULL) STRICT")
    if not table_exists(db, "items"):
        events = db.execute("SELECT sql FROM sqlite_master WHERE name = 'events'").fetchone()[0]
        if "'capture'" not in events:
            db.execute("DROP INDEX IF EXISTS events_item")
            db.execute("ALTER TABLE events RENAME TO events_old")
        for stmt in SCHEMA.split(";"):
            if stmt.strip():
                db.execute(stmt)
        if "'capture'" not in events:
            db.execute("INSERT INTO events SELECT * FROM events_old")
            db.execute("DROP TABLE events_old")


# Stage times a run row carries, all derived from transcripts and git: spawned,
# first report back (review requested), and its commit's time on origin/main.
STAGES = ("staffed", "review_requested", "landed_at")
CONTEXT = ("role", "peak_ctx", "compactions", "handoff_fires", "handoff_ignored", "input_tokens", "cache_read_tokens", "idle_gap_misses")


def event(db, item, kind, actor="", tier="", **data):
    db.execute(
        "INSERT INTO events(ts, item, kind, actor, tier, data) VALUES (?,?,?,?,?,?)",
        (now(), item, kind, actor, tier, json.dumps(data)),
    )


# Issue refs and GitHub ---------------------------------------------------------

REF = re.compile(r"^([\w.-]+(?:/[\w.-]+)?)#(\d+)$")


def parse_ref(ref: str) -> tuple[str, int]:
    """'smashcraft#222', 'tompassarelli/smashcraft#222' or 'nixos-config#3' -> ('smashcraft', 222) / ('firn', 3)."""
    m = REF.match(ref.strip())
    if not m:
        raise Refused(f"{ref} is not an issue ref like smashcraft#222")
    name = m.group(1).removeprefix(f"{OWNER}/")
    repo = ALIASES.get(name, name)
    if repo in NATIVE and no_native_reason():
        raise Refused(f"native items are not readable here: {no_native_reason()}")
    if repo not in REPOS + NATIVE:
        raise Refused(f"unknown repo {m.group(1)} (known: {', '.join(REPOS + NATIVE)})")
    return repo, int(m.group(2))


def ref(repo: str, number: int) -> str:
    return f"{repo}#{number}"


def no_native_reason() -> str | None:
    """Native items are for Claude and Codex sessions on Tom's machines: bin/agy exports THREADS_NO_NATIVE, and a
    Claude Code cloud session sets CLAUDE_CODE_REMOTE."""
    if os.environ.get("THREADS_NO_NATIVE"):
        return "THREADS_NO_NATIVE is set (agy)"
    if os.environ.get("CLAUDE_CODE_REMOTE"):
        return "CLAUDE_CODE_REMOTE is set (cloud worker)"
    return None


def visible_native() -> list:
    return [] if no_native_reason() else NATIVE


def gitleaks_clean(text: str):
    try:
        p = subprocess.run(["gitleaks", "stdin", "--no-banner", "--redact", "-l", "error"], input=text,
                           capture_output=True, text=True, cwd="/")
    except FileNotFoundError:
        raise Refused("gitleaks is not on PATH; items are scanned for secrets before they are stored")
    if p.returncode != 0:
        raise Refused("gitleaks found a secret in the item text; credentials stay in Bitwarden, so nothing was stored")


def gh(*args: str) -> str:
    """Run gh, waiting out rate-limit refusals (retry-after unknown: 30 s doubling to 5 min, ~65 min in all)."""
    if any(NATIVE_REF.search(a) for a in args):
        raise Refused("a gh argument names a native item; native items never reach GitHub")
    delay, waited = 30.0, 0.0
    while True:
        p = subprocess.run(["gh", *args], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout
        if "rate limit" not in p.stderr.lower() or waited > 65 * 60:
            raise Refused(f"gh {args[0]} {args[1] if len(args) > 1 else ''}: {p.stderr.strip()}")
        pause = delay * random.uniform(0.8, 1.2)
        print(f"NorthThreads: GitHub rate limit, waiting {pause:.0f} s", file=sys.stderr)
        time.sleep(pause)
        waited += pause
        delay = min(delay * 2, 300)


OPEN_ISSUES = """
query($owner: String!, $name: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    issues(states: OPEN, first: 100, after: $cursor) {
      pageInfo { hasNextPage endCursor }
      nodes { number title blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } } }
    }
  }
}"""

ONE_ISSUE = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number title state blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } }
    }
  }
}"""


def blockers(node) -> list:
    out = []
    for b in node["blockedBy"]["nodes"]:
        full = b["repository"]["nameWithOwner"]
        out.append({"ref": ref(full.removeprefix(f"{OWNER}/"), b["number"]), "state": b["state"]})
    return out


def local_blockers(db, item: str) -> list:
    out = []
    for (needs,) in db.execute("SELECT needs FROM item_needs WHERE item = ? ORDER BY needs", (item,)).fetchall():
        hidden = no_native_reason() and NATIVE_REF.fullmatch(needs)
        repo, number = parse_ref(needs) if not hidden else (needs.split("#")[0], int(needs.split("#")[1]))
        if repo in NATIVE:
            row = db.execute("SELECT state FROM items WHERE ns = ? AND number = ?", (repo, number)).fetchone()
            state = row["state"].upper() if row else "CLOSED"
        else:
            state = "OPEN" if str(number) in open_issues(db, repo) else "CLOSED"
        out.append({"ref": "a native item" if hidden else needs, "state": state})
    return out


def native_item(db, ns: str, number: int):
    row = db.execute("SELECT * FROM items WHERE ns = ? AND number = ?", (ns, number)).fetchone()
    if row is None:
        raise Refused(f"no item {ref(ns, number)}")
    return row


def open_issues(db, repo: str) -> dict:
    """{number: {title, blockers}} for the repo's open issues; one paged query, cached CACHE_SECONDS.
    A native namespace reads its open items from the items table; local needs add blockers to either."""
    if repo in NATIVE:
        return {str(r["number"]): {"title": r["title"], "blockers": local_blockers(db, ref(repo, r["number"]))}
                for r in db.execute("SELECT number, title FROM items WHERE ns = ? AND state = 'open'", (repo,)).fetchall()}
    row = db.execute("SELECT fetched, issues FROM gh_cache WHERE repo = ?", (repo,)).fetchone()
    if row and time.time() - row["fetched"] < CACHE_SECONDS:
        return json.loads(row["issues"])
    owner, name = OWNER, repo
    issues, cursor = {}, None
    while True:
        args = ["api", "graphql", "-f", f"query={OPEN_ISSUES}", "-F", f"owner={owner}", "-F", f"name={name}"]
        if cursor:
            args += ["-F", f"cursor={cursor}"]
        page = json.loads(gh(*args))["data"]["repository"]["issues"]
        for n in page["nodes"]:
            issues[str(n["number"])] = {"title": n["title"], "blockers": blockers(n)}
        if not page["pageInfo"]["hasNextPage"]:
            break
        cursor = page["pageInfo"]["endCursor"]
    with Tx(db):
        db.execute(
            "INSERT OR REPLACE INTO gh_cache(repo, fetched, issues) VALUES (?,?,?)",
            (repo, time.time(), json.dumps(issues)),
        )
    return issues


def one_issue(db, repo: str, number: int) -> dict:
    if repo in NATIVE:
        row = native_item(db, repo, number)
        return {"title": row["title"], "state": row["state"].upper(), "blockers": local_blockers(db, ref(repo, number))}
    row = db.execute("SELECT fetched, issues FROM gh_cache WHERE repo = ?", (repo,)).fetchone()
    if row and time.time() - row["fetched"] < CACHE_SECONDS and str(number) in json.loads(row["issues"]):
        cached = json.loads(row["issues"])[str(number)]
        return dict(cached, state="OPEN", blockers=cached["blockers"] + local_blockers(db, ref(repo, number)))
    owner, name = OWNER, repo
    out = json.loads(gh("api", "graphql", "-f", f"query={ONE_ISSUE}", "-F", f"owner={owner}",
                        "-F", f"name={name}", "-F", f"number={number}"))
    issue = out["data"]["repository"]["issue"]
    if issue is None:
        raise Refused(f"no issue {ref(repo, number)}")
    return {"title": issue["title"], "state": issue["state"], "blockers": blockers(issue) + local_blockers(db, ref(repo, number))}


def forget(db, repo):
    with Tx(db):
        db.execute("DELETE FROM gh_cache WHERE repo = ?", (repo,))


# Commands --------------------------------------------------------------------


def cmd_claim(db, a):
    item = ref(*parse_ref(a.id))
    with Tx(db):
        row = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone()
        if row and row["owner"] != a.by:
            raise Refused(f"{item} is already owned by {row['owner']}")
        if row:
            db.execute("UPDATE claims SET since = ?, eta_min = COALESCE(?, eta_min) WHERE item = ?", (now(), a.eta, item))
        else:
            db.execute("INSERT INTO claims(item, owner, since, eta_min) VALUES (?,?,?,?)", (item, a.by, now(), a.eta))
        event(db, item, "claim", a.by, eta_min=a.eta)
    print(f"{a.by} owns {item}")


def cmd_release(db, a):
    item = ref(*parse_ref(a.id))
    with Tx(db):
        row = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone()
        if not row:
            raise Refused(f"{item} has no owner")
        if a.to:
            db.execute("UPDATE claims SET owner = ?, since = ? WHERE item = ?", (a.to, now(), item))
            event(db, item, "handoff", a.by, **{"from": row["owner"], "to": a.to})
        else:
            db.execute("DELETE FROM claims WHERE item = ?", (item,))
            event(db, item, "release", a.by, owner=row["owner"])
    print(f"{item} handed from {row['owner']} to {a.to}" if a.to else f"{item} released by {row['owner']}")


def dependency(db, a, method):
    repo, number = parse_ref(a.id)
    brepo, bnumber = parse_ref(a.other)
    if repo in NATIVE or brepo in NATIVE:
        item, needs = ref(repo, number), ref(brepo, bnumber)
        with Tx(db):
            if method == "POST":
                db.execute("INSERT OR IGNORE INTO item_needs(item, needs) VALUES (?,?)", (item, needs))
            else:
                db.execute("DELETE FROM item_needs WHERE item = ? AND needs = ?", (item, needs))
            event(db, item, "need" if method == "POST" else "unneed", a.by, needs=needs)
        return "locally"
    blocker_id = gh("api", f"repos/{OWNER}/{brepo}/issues/{bnumber}", "--jq", ".id").strip()
    path = f"repos/{OWNER}/{repo}/issues/{number}/dependencies/blocked_by"
    if method == "POST":
        gh("api", "-X", "POST", path, "-F", f"issue_id={blocker_id}")
    else:
        gh("api", "-X", "DELETE", f"{path}/{blocker_id}")
    forget(db, repo)
    with Tx(db):
        event(db, ref(repo, number), "need" if method == "POST" else "unneed", a.by, needs=ref(brepo, bnumber))
    return "on GitHub"


def cmd_need(db, a):
    where = dependency(db, a, "POST")
    print(f"{a.id} is blocked by {a.other} {where}")


def cmd_unneed(db, a):
    dependency(db, a, "DELETE")
    print(f"{a.id} is no longer blocked by {a.other}")


def cmd_show(db, a):
    repo, number = parse_ref(a.id)
    item = ref(repo, number)
    issue = one_issue(db, repo, number)
    print(f"{item}  {issue['title']}")
    print(f"  state: {issue['state'].lower()}")
    if issue["blockers"]:
        print("  blocked by: " + ", ".join(f"{b['ref']} ({b['state'].lower()})" for b in issue["blockers"]))
    if repo in NATIVE:
        row = native_item(db, repo, number)
        if row["due"]:
            print(f"  due: {row['due']}")
        if row["body"]:
            print("  " + row["body"].replace("\n", "\n  "))
        for e in db.execute("SELECT ts, data FROM events WHERE item = ? AND kind = 'note' AND json_extract(data, '$.text')"
                            " IS NOT NULL ORDER BY seq", (item,)):
            print(f"  note {e['ts']}  {json.loads(e['data'])['text']}")
    c = db.execute("SELECT * FROM claims WHERE item = ?", (item,)).fetchone()
    if c:
        print(f"  owner: {c['owner']} for {minutes_since(c['since'])}m" + (f" of {c['eta_min']}m ETA" if c["eta_min"] else ""))
    hands = db.execute(
        "SELECT ts, kind, actor, data FROM events WHERE item = ? AND kind IN ('claim','release','handoff') ORDER BY seq",
        (item,),
    ).fetchall()
    if hands:
        print("  owners:")
        for e in hands:
            d = json.loads(e["data"])
            what = f"{d['from']} -> {d['to']}" if e["kind"] == "handoff" else e["actor"]
            print(f"    {e['ts']}  {e['kind']:<8} {what}")
    runs = db.execute("SELECT * FROM runs WHERE item = ? ORDER BY ended", (item,)).fetchall()
    if runs:
        print(f"  runs: {len(runs)}, {sum(r['minutes'] for r in runs)}m in all")
        for r in runs:
            eta = f"/{r['eta_min']}m ETA" if r["eta_min"] else ""
            follows = f" follows {r['follows']}" if r["follows"] else ""
            note = f"  note {r['note']}" if r["note"] else ""
            print(f"    {r['ended'][:16]}  {r['agent']} {r['tier']}{follows}  {r['minutes']}m{eta}  {r['outcome']}: {r['report'][:80]}{note}")
    if repo not in NATIVE and not os.environ.get("THREADS_ARCHIVES_LOCAL"):
        print_archives(repo, number)


def cmd_ready(db, a):
    claimed = {r["item"] for r in db.execute("SELECT item FROM claims")}
    for repo in REPOS + visible_native():
        try:
            issues = open_issues(db, repo)
        except Refused as e:
            print(f"NorthThreads: skipped {repo}: {e}", file=sys.stderr)
            continue
        for number in sorted(issues, key=int):
            i = issues[number]
            item = ref(repo, int(number))
            local = local_blockers(db, item) if repo in REPOS else []
            if item in claimed or any(b["state"] == "OPEN" for b in i["blockers"] + local):
                continue
            print(f"{item}\t{i['title']}")


def cmd_list(db, a):
    cached = {r["repo"]: json.loads(r["issues"]) for r in db.execute("SELECT repo, issues FROM gh_cache")}
    cached.update({ns: open_issues(db, ns) for ns in visible_native()})
    out = [("item", "owner", "clock", "eta", "flag")]
    for c in db.execute("SELECT * FROM claims ORDER BY since"):
        if no_native_reason() and NATIVE_REF.fullmatch(c["item"]):
            continue
        repo, number = parse_ref(c["item"])
        clock = minutes_since(c["since"])
        flag = "-"
        if repo in cached and str(number) not in cached[repo]:
            flag = "CLOSED"
        elif c["eta_min"] and clock > DEFAULTS["overdue_ratio"] * c["eta_min"]:
            flag = "OVERDUE"
        out.append((c["item"], c["owner"], f"{clock}m", f"{c['eta_min']}m" if c["eta_min"] else "-", flag))
    widths = [max(len(row[i]) for row in out) for i in range(len(out[0]))]
    for row in out:
        print("  ".join(v.ljust(w) for v, w in zip(row, widths)).rstrip())


# Staffing: unowned and blocked issues -------------------------------------------

STAFFED = ["smashcraft", "wisp"]
PRIORITIES = ["priority:now", "-", "priority:next", "priority:later"]
BOX = re.compile(r"^\s*[-*] \[ \]", re.M)
BLOCK_DAYS = 7


def native_ref(text):
    ns, number = parse_ref(text)
    if ns not in NATIVE:
        raise Refused(f"{text} is a GitHub issue; only {', '.join(NATIVE)} items are native")
    return ns, number


def cmd_new(db, a):
    if a.ns not in NATIVE:
        raise Refused(f"{a.ns} is not a native namespace ({', '.join(NATIVE)})")
    body = sys.stdin.read().strip() if a.body == "-" else (a.body or "")
    gitleaks_clean(f"{a.title}\n{body}")
    with Tx(db):
        number = db.execute("SELECT coalesce(max(number), 0) + 1 FROM items WHERE ns = ?", (a.ns,)).fetchone()[0]
        db.execute("INSERT INTO items(ns, number, title, body, created, due) VALUES (?,?,?,?,?,?)",
                   (a.ns, number, a.title, body, now(), a.due))
        event(db, ref(a.ns, number), "capture", a.by)
    print(ref(a.ns, number))


def cmd_note(db, a):
    ns, number = native_ref(a.id)
    native_item(db, ns, number)
    gitleaks_clean(" ".join(a.text))
    with Tx(db):
        event(db, ref(ns, number), "note", a.by, text=" ".join(a.text))
    print(f"noted on {ref(ns, number)}")


def set_state(db, a, state):
    ns, number = native_ref(a.id)
    native_item(db, ns, number)
    with Tx(db):
        db.execute("UPDATE items SET state = ?, closed = ? WHERE ns = ? AND number = ?",
                   (state, now() if state == "closed" else None, ns, number))
        event(db, ref(ns, number), "close" if state == "closed" else "reopen", a.by)
    print(f"{ref(ns, number)} {state}")


def cmd_close(db, a):
    set_state(db, a, "closed")


def cmd_reopen(db, a):
    set_state(db, a, "open")


def cmd_block(db, a):
    item = ref(*parse_ref(a.id))
    reason = " ".join(a.reason).strip()
    with Tx(db):
        if a.clear:
            db.execute("DELETE FROM blocks WHERE item = ?", (item,))
            event(db, item, "note", a.by, unblock=True)
        else:
            if not reason:
                raise Refused("block needs a reason")
            db.execute("INSERT OR REPLACE INTO blocks(item, reason, since, by) VALUES (?,?,?,?)", (item, reason, now(), a.by))
            event(db, item, "note", a.by, block=reason)
    print(f"{item} unblocked" if a.clear else f"{item} blocked: {reason}")


COMMIT_REF = re.compile(r"^(?:item|closes|close|fixes|fix|refs|ref|part of|issue|for)\b", re.I)
BRANCH_HOURS = 48


def commit_refs(message: str, repo: str, number: int) -> bool:
    """The headline, or an Item:/Closes/Fixes/Refs line, names the issue; a passing mention in the body does not."""
    lines = message.splitlines()
    picked = lines[:1] + [l for l in lines[1:] if COMMIT_REF.match(l.strip())]
    return any(mentions(l, repo, number) for l in picked)


def mentions(text: str, repo: str, number: int) -> bool:
    return re.search(rf"(?:(?<![\w/-])|(?<={re.escape(repo)}))#{number}(?!\d)", text) is not None


def branch_names_issue(name: str, number: int) -> bool:
    return re.search(rf"(?:^|[-_/#]){number}(?:$|[-_/])", name) is not None


def open_branches(repo: str) -> tuple[dict, dict]:
    """({branch: [commit messages ahead of the default branch]}, {branch: (reason, failed at)}) for claude/* and *land-*
    branches on origin; a branch whose tip Autoland failed goes only in the second."""
    nodes = json.loads(gh("api", "graphql", "-f", "query=query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) "
                          "{ refs(refPrefix: \"refs/heads/\", first: 100) { nodes { name target { ... on Commit { committedDate "
                          "status { context(name: \"autoland\") { state description createdAt } } } } } } } }",
                          "-F", f"owner={OWNER}", "-F", f"name={repo}"))["data"]["repository"]["refs"]["nodes"]
    cutoff = time.time() - BRANCH_HOURS * 3600
    nodes = [n for n in nodes if (n["name"].startswith("claude/") or "land-" in n["name"])
             and datetime.fromisoformat(((n.get("target") or {}).get("committedDate") or "1970-01-01T00:00:00Z")
                                        .replace("Z", "+00:00")).timestamp() >= cutoff]
    lanes = {n["name"]: (((n.get("target") or {}).get("status") or {}).get("context") or {}) for n in nodes}
    failed = {b: (c.get("description") or "no reason given", c.get("createdAt") or "") for b, c in lanes.items() if c.get("state") == "FAILURE"}
    names = list(lanes)
    while True:
        if not names:
            return {}, {}
        fields = " ".join(f'b{i}: compare(headRef: {json.dumps(n)}) {{ commits(first: 100) {{ nodes {{ message }} }} }}' for i, n in enumerate(names))
        try:
            out = json.loads(gh("api", "graphql", "-f", f"query=query($owner: String!, $name: String!) {{ repository(owner: $owner, name: $name) "
                                f"{{ defaultBranchRef {{ {fields} }} }} }}", "-F", f"owner={OWNER}", "-F", f"name={repo}"))
            break
        except Refused as e:
            gone = set(re.findall(r"Could not resolve head ref '([^']+)'", str(e))) & set(names)
            if not gone:
                raise
            print(f"NorthThreads: skipped deleted {repo} branches {', '.join(sorted(gone))}", file=sys.stderr)
            names = [n for n in names if n not in gone]
    base = out["data"]["repository"]["defaultBranchRef"]
    msgs = {n: [c["message"] for c in ((base.get(f"b{i}") or {}).get("commits") or {}).get("nodes", [])] for i, n in enumerate(names)}
    return ({n: m for n, m in msgs.items() if n not in failed},
            {n: (*failed[n], m) for n, m in msgs.items() if n in failed})


def comment_block(comments) -> str | None:
    cutoff = time.time() - BLOCK_DAYS * 86400
    for c in sorted(comments, key=lambda c: c["createdAt"], reverse=True):
        body = c.get("body", "").strip()
        if datetime.fromisoformat(c["createdAt"].replace("Z", "+00:00")).timestamp() < cutoff:
            return None
        if body.startswith("Blocked:"):
            return body[len("Blocked:"):].strip().splitlines()[0] if body[len("Blocked:"):].strip() else "comment"
    return None


def cmd_unowned(db, a):
    claims = {}
    live = alive_owners()
    for c in db.execute("SELECT * FROM claims"):
        if held_claim(c, live, minutes_since(c["since"])):
            claims[c["item"]] = (c["owner"], c["since"])
    blocks = {r["item"]: r["reason"] for r in db.execute("SELECT item, reason FROM blocks")}
    rows, stale = [], []
    for repo in STAFFED:
        issues = json.loads(gh("issue", "list", "-R", f"{OWNER}/{repo}", "--state", "open", "--limit", "500",
                               "--json", "number,title,labels,body,comments"))
        branches, failed = open_branches(repo)
        for i in issues:
            boxes = len(BOX.findall(i.get("body") or ""))
            if not boxes:
                continue
            number, item = i["number"], ref(repo, i["number"])
            labels = {l["name"] for l in i.get("labels", [])}
            prio = next((p for p in PRIORITIES if p in labels), "-")
            names = lambda b, msgs: branch_names_issue(b, number) or any(commit_refs(m, repo, number) for m in msgs)
            lane = next(((b, why, at) for b, (why, at, msgs) in sorted(failed.items()) if names(b, msgs)), None)
            claim = claims.get(item)
            if claim and lane and claim[1] < lane[2]:
                stale.append((item, claim[0], lane))
                claim = None
            owner = (claim[0] if claim else None) or next(
                (f"branch:{b}" for b, msgs in sorted(branches.items()) if names(b, msgs)), None)
            block = blocks.get(item) or comment_block(i.get("comments") or [])
            state = owner or (f"blocked:{block}" if block else "UNOWNED")
            note = f"\tlane failed: {lane[1]} ({lane[0]})" if lane and state == "UNOWNED" else ""
            rows.append((PRIORITIES.index(prio), repo, number, prio, state, boxes, i["title"] + note))
    with Tx(db):
        for item, owner, (branch, why, at) in stale:
            db.execute("DELETE FROM claims WHERE item = ? AND owner = ?", (item, owner))
            event(db, item, "release", "threads", owner=owner, lane_failed=branch, reason=why, failed_at=at)
    rows.sort(key=lambda r: (r[0], STAFFED.index(r[1]), r[2]))
    for _, repo, number, prio, state, boxes, title in rows:
        print(f"{ref(repo, number)}\t{prio}\t{state}\t{boxes}\t{title}")
    now_rows = [r for r in rows if r[3] == "priority:now"]
    print(f"priority:now unowned={sum(r[4] == 'UNOWNED' for r in now_rows)} "
          f"blocked={sum(r[4].startswith('blocked:') for r in now_rows)} "
          f"owned={sum(r[4] != 'UNOWNED' and not r[4].startswith('blocked:') for r in now_rows)}")


# Runs (fed by worker-ledger) ---------------------------------------------------

BRIEF_FIELD = {name: re.compile(rf"\b{name}:[ \t]*([^\s`<>]+)") for name in ("Item", "Follows", "Arm")}
CATEGORY = re.compile(r"\bCategory:[ \t]*([A-Za-z-]+)")
LENS = re.compile(r"\bLens:[ \t]*([^.;,\n`<>]+)")
# Orthogonal brief facets, each a closed vocabulary; worker-tier-guard holds the same lists.
FACETS = {
    "spec": ["exact", "measured", "judged"],
    "scope": ["one-file", "module", "cross-module", "cross-repo"],
    "surface": ["ts", "lua", "nix", "shell", "workflow", "docs", "assets"],
    "verify": ["none", "local-test", "farm", "native", "visual"],
}
FACET_FIELD = {f: re.compile(rf"\b{f.capitalize()}:[ \t]*([A-Za-z-]+)") for f in FACETS}


def brief_fields(brief: str) -> dict:
    out = {}
    for name, pattern in BRIEF_FIELD.items():
        m = pattern.search(brief)
        if m:
            out[name.lower()] = m.group(1).rstrip(".,;:)")
    m = CATEGORY.search(brief)
    if m:
        out["category"] = m.group(1).strip().lower()
    for facet, pattern in FACET_FIELD.items():
        m = pattern.search(brief)
        if m and m.group(1).lower() in FACETS[facet]:
            out[facet] = m.group(1).lower()
    for label, key in (("Summed box ETA", "initial_eta"), ("Prior Not dones", "prior_not_done")):
        m = re.search(rf"\b{label}:[ \t]*(\d+)(?:m)?(?=[ \t,;\n.]|$)", brief)
        if m:
            out[key] = int(m.group(1))
    m = LENS.search(brief)
    if m:
        out["lens"] = m.group(1).strip().lower()
    return out


CATEGORIES = [
    "mechanical", "docs-policy", "tooling", "feature", "bug-known-cause", "debugging-unknown-cause",
    "netcode-determinism", "performance", "balance-tuning", "native-check", "research",
]


def issue_ref(item):
    """Canonical repo#N, or None when the brief's Item is not an issue ref."""
    try:
        return ref(*parse_ref(item)) if item else None
    except Refused:
        return None


# Issue labels that name a category, first match wins, for runs whose brief is unreadable (Codex encrypts it).
LABEL_CATEGORY = [("theme:balance", "balance-tuning"), ("theme:netplay", "netcode-determinism"),
                  ("needs:native-pair", "native-check"), ("needs:native-single", "native-check"),
                  ("native:running", "native-check"), ("documentation", "docs-policy"),
                  ("bug", "bug-known-cause"), ("enhancement", "feature")]


def label_category(db, item, cache={}):
    """Category from the item's GitHub labels by LABEL_CATEGORY, one label listing per repo per ingest."""
    repo, number = parse_ref(item)
    if repo in NATIVE:
        return None
    if repo not in cache:
        try:
            cache[repo] = {i["number"]: {l["name"] for l in i["labels"]} for i in json.loads(gh(
                "issue", "list", "-R", f"{OWNER}/{repo}", "--state", "all", "--limit", "1000", "--json", "number,labels"))}
        except (Refused, ValueError, TypeError, KeyError):
            cache[repo] = {}
    labels = cache[repo].get(number, set())
    return next((c for label, c in LABEL_CATEGORY if label in labels), None)


def derived_item(f, r):
    """The brief's Item, else the issue its commits and issue commands name most (encrypted Codex briefs)."""
    return issue_ref(f.get("item") or r.get("item")) or next(filter(None, map(issue_ref, r.get("refs") or [])), None)


def hold(db, item, r, claim, follows):
    """A running worker holds its brief's issue; taking it from someone else is a handoff."""
    prev = claim["owner"] if claim else follows
    if claim:
        db.execute("UPDATE claims SET owner = ?, since = ?, eta_min = ? WHERE item = ?",
                   (r["id"], r.get("started") or now(), r.get("eta_min") and round(r["eta_min"]), item))
    else:
        db.execute("INSERT INTO claims(item, owner, since, eta_min) VALUES (?,?,?,?)",
                   (item, r["id"], r.get("started") or now(), r.get("eta_min") and round(r["eta_min"])))
        event(db, item, "claim", r["id"], r["tier"], eta_min=r.get("eta_min"))
    if prev and prev != r["id"]:
        event(db, item, "handoff", r["id"], r["tier"], **{"from": prev, "to": r["id"]})


def cmd_ingest(db, a):
    """Read worker-ledger's JSON rows on stdin. A running worker holds its Item; a finished one
    releases it and becomes a run; a stale one (idle 2 h) releases it. Recorded runs are skipped."""
    added = backfilled = 0
    unlabeled, readouts, unpriced = [], [], set()
    with Tx(db):
        for line in sys.stdin:
            if not line.strip():
                continue
            r = json.loads(line)
            if r.get("type") == "usage":
                readouts.append(r)
                continue
            unpriced.update(r.get("unpriced_models") or [])
            if r.get("account"):
                db.executemany("INSERT INTO run_usage(agent, request, ts, account, weight) VALUES (?,?,?,?,?)"
                               " ON CONFLICT(agent, request) DO UPDATE SET ts=excluded.ts, account=excluded.account, weight=excluded.weight",
                               [(r["id"], sample["request"], sample["ts"], r["account"], sample["weight"])
                                for sample in r.get("usage_samples") or []])
                db.execute("UPDATE runs SET account=?, model=coalesce(?, model), effort=coalesce(?, effort), fast=? WHERE agent=?",
                           (r["account"], r.get("model"), r.get("effort"), r.get("fast", 0), r["id"]))
            if r.get("telemetry_only"):
                continue
            status = r.get("status", "finished")
            role = r.get("role") or "worker"
            if role not in ("worker", "parent", "proxy", "routine", "probe"):
                raise Refused(f"unknown run role {role!r}")
            worker = role == "worker"
            f = brief_fields(r.get("brief") or "")
            existing = db.execute("SELECT category, outcome, model, effort, brief_text, brief_origin, brief_path, brief_sha256, started FROM runs WHERE agent = ?", (r["id"],)).fetchone()
            if existing:
                r = dict(r, model=r.get("model") if r.get("model") is not None else existing["model"],
                         effort=r.get("effort") if r.get("effort") is not None else existing["effort"])
            original = existing["brief_text"] if existing else None
            if original is not None:
                f = brief_fields(original)
                r = dict(r, brief_text=original, brief_origin=existing["brief_origin"], brief_path=existing["brief_path"], brief_sha256=existing["brief_sha256"], category=f.get("category"))
                if existing["brief_origin"] == "codex.PostToolUse.spawn_agent" and existing["started"] is not None:
                    r = dict(r, started=existing["started"])
            if existing and existing["outcome"] == "running" and status == "finished":
                db.execute("DELETE FROM runs WHERE agent = ?", (r["id"],))
                existing = None
            if existing:
                if r.get("backfill") or not worker:
                    db.execute("UPDATE runs SET model=coalesce(?, model), effort=coalesce(?, effort) WHERE agent=?",
                               (r.get("model"), r.get("effort"), r["id"]))
                    if not worker:
                        category = f.get("category") or r.get("category")
                        db.execute("UPDATE runs SET ended = ?, category = coalesce(?, category),"
                                   " report = coalesce(?, report), outcome = coalesce(?, outcome) WHERE agent = ?",
                                   (r["ended"], category if category in CATEGORIES else None,
                                    r.get("report"), r.get("outcome"), r["id"]))
                    db.execute("UPDATE runs SET " + ", ".join(f"{k} = ?" if k == "handoff_ignored" and k in r else f"{k} = coalesce(?, {k})" for k in CONTEXT) + " WHERE agent = ?",
                               (role, *(r.get(k) for k in CONTEXT[1:]), r["id"]))
                    item = derived_item(f, r) if worker else None
                    raw = f.get("category") or r.get("category")
                    if worker and original is None and raw not in CATEGORIES and item and existing["category"] == "unknown":
                        unlabeled.append((r["id"], item))
                    if original is not None:
                        db.execute("UPDATE runs SET category=?,spec=?,scope=?,surface=?,verify=? WHERE agent=?",
                                   (f.get("category") if f.get("category") in CATEGORIES else "unknown", *(f.get(k) for k in FACETS), r["id"]))
                    backfilled += db.execute(
                        "UPDATE runs SET spec = coalesce(spec, ?), scope = coalesce(scope, ?), surface = coalesce(surface, ?),"
                        " verify = coalesce(verify, ?), lens = coalesce(lens, ?), flaws = coalesce(flaws, ?),"
                        " expects_landing = coalesce(?, expects_landing),"
                        " landed = CASE WHEN coalesce(?, landed_sha) IS NOT NULL THEN 1 ELSE coalesce(?, landed) END,"
                        " landed_sha = coalesce(?, landed_sha),"
                        " staffed = coalesce(?, staffed),"
                        " review_requested = coalesce(?, review_requested), landed_at = coalesce(?, landed_at),"
                        " item = coalesce(?, item, ?), eta_min = coalesce(eta_min, ?),"
                        " category = CASE category WHEN 'unknown' THEN coalesce(?, category) ELSE category END WHERE agent = ?",
                        (f.get("spec"), f.get("scope"), f.get("surface"), f.get("verify"), f.get("lens"),
                         r.get("flaws"), r.get("expects_landing"), r.get("landed_sha"), r.get("landed"), r.get("landed_sha"),
                         *(r.get(k) for k in STAGES), issue_ref(f.get("item") or r.get("item")) if worker else None, item,
                         r.get("eta_min") and round(r["eta_min"]),
                         raw if raw in CATEGORIES else None, r["id"])).rowcount
                continue
            item = derived_item(f, r) if worker else None
            follows = f.get("follows") or r.get("follows")
            claim = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone() if item else None
            mine = claim is not None and claim["owner"] == r["id"]
            if status == "running" and worker:
                if item and not mine:
                    hold(db, item, r, claim, follows)
                if r.get("brief_origin") in ("codex.PostToolUse.spawn_agent", "claude.PostToolUse.Agent") and isinstance(r.get("brief_text"), str):
                    db.execute("INSERT INTO runs(agent,item,follows,session,tier,category,started,ended,minutes,eta_min,outcome,"
                               "spec,scope,surface,verify,staffed,role,model,effort,brief_text,brief_origin,brief_path,brief_sha256)"
                               " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                               (r["id"], item, follows, r.get("session"), r["tier"], f.get("category", "unknown"),
                                r.get("started"), "", 0, r.get("eta_min"), "running", *(f.get(k) for k in FACETS),
                                r.get("staffed"), role, r.get("model"), r.get("effort"), r["brief_text"], r["brief_origin"], r.get("brief_path"), r.get("brief_sha256")))
                    added += 1
                continue
            if mine:
                db.execute("DELETE FROM claims WHERE item = ?", (item,))
                event(db, item, "release", r["id"], r["tier"], why=status)
            if status != "finished" and worker:
                continue
            raw = f.get("category") or r.get("category") or "unknown"
            if raw == "unknown" and item and original is None:
                unlabeled.append((r["id"], item))
            category = raw if raw in CATEGORIES else "unknown"
            prev = None
            if item and not db.execute(
                "SELECT 1 FROM events WHERE item = ? AND kind = 'handoff' AND json_extract(data, '$.to') = ?",
                (item, r["id"]),
            ).fetchone():
                p = db.execute("SELECT agent FROM runs WHERE item = ? ORDER BY ended DESC LIMIT 1", (item,)).fetchone()
                prev = follows or (p["agent"] if p else None)
            eta = r.get("eta_min")
            db.execute(
                """INSERT INTO runs(agent, item, follows, session, tier, category, started, ended, minutes,
                                    eta_min, tokens, peak_ctx, outcome, report, note, landed, arm,
                                    spec, scope, surface, verify, lens, flaws, expects_landing,
                                    staffed, review_requested, landed_at,
                                    role, compactions, handoff_fires, handoff_ignored, input_tokens, cache_read_tokens, idle_gap_misses)
                   VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (r["id"], item, follows, r.get("session"), r["tier"], category, r.get("started"), r["ended"],
                 r["actual_min"], None if eta is None else round(eta), r.get("tokens"), r.get("peak_ctx"),
                 r["outcome"], r.get("report") or "", r.get("note"), r.get("landed"),
                 (f.get("arm") or "").lower() or None, f.get("spec"), f.get("scope"), f.get("surface"),
                 f.get("verify"), f.get("lens"), r.get("flaws"), r.get("expects_landing"),
                 *(r.get(k) for k in STAGES), role,
                 *(r.get(k) for k in CONTEXT[2:])),
            )
            db.execute("UPDATE runs SET account=?, model=?, effort=?, fast=?, landed_sha=? WHERE agent=?",
                       (r.get("account"), r.get("model"), r.get("effort"), r.get("fast", 0), r.get("landed_sha"), r["id"]))
            db.execute("UPDATE runs SET brief_text=?, brief_origin=?, brief_path=?, brief_sha256=? WHERE agent=?",
                       (r.get("brief_text"), r.get("brief_origin"), r.get("brief_path"), r.get("brief_sha256"), r["id"]))
            if prev and prev != r["id"]:
                event(db, item, "handoff", r["id"], r["tier"], **{"from": prev, "to": r["id"]})
            added += 1
    if readouts:
        from usage import record
        record(db, readouts)
    if table_exists(db, "usage"):
        operator = Path(os.environ.get("AGENTS_OPERATOR_DIR") or Path.home() / "code/south/main/agents")
        prices = {r["id"]: r["usd_per_week"] for r in tomllib.load(open(operator / "costs.toml", "rb")).get("service", [])}
        with Tx(db):
            allocations = allocation_intervals([dict(r) for r in db.execute("SELECT * FROM usage")],
                                              [dict(r) for r in db.execute("SELECT * FROM run_usage")], prices)
            db.execute("DELETE FROM run_costs")
            db.executemany("INSERT INTO run_costs(account, started, ended, agent, cost_usd) VALUES (?,?,?,?,?)",
                           [(r["account"], r["started"], r["ended"], r["agent"], r["cost_usd"]) for r in allocations])
            db.execute("UPDATE runs SET cost_usd=(SELECT SUM(cost_usd) FROM run_costs WHERE agent=runs.agent)")
    labeled = [(c, agent) for agent, item in unlabeled if (c := label_category(db, item))]
    with Tx(db):
        db.executemany("UPDATE runs SET category = ? WHERE agent = ?", labeled)
    print(f"NorthThreads: {added} runs recorded" + (f", {backfilled} backfilled" if backfilled else "") + f" in {DB}"
          + (f"; token weight for models without a list price: {', '.join(sorted(unpriced))}" if unpriced else ""),
          file=sys.stderr)


LANDING_DAYS = 3


def cmd_run_ids(db, a):
    since = datetime.fromtimestamp(time.time() - LANDING_DAYS * 86400, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for (agent,) in db.execute('SELECT agent FROM runs' + (' WHERE role = "worker" AND outcome != "running" AND NOT (expects_landing = 1 AND landed_at IS NULL AND'
                                                           " ended >= ?)" if a.settled else ""), (since,) if a.settled else ()):
        print(agent)


def span(start, end):
    """Whole minutes from start to end, 0 when end came first (a worker that landed before reporting), None unless both are known."""
    if not (start and end):
        return None
    return max(0, int((datetime.fromisoformat(end.replace("Z", "+00:00")) - datetime.fromisoformat(start.replace("Z", "+00:00"))).total_seconds() // 60))


def median(xs):
    xs = sorted(x for x in xs if x is not None)
    return xs[(len(xs) - 1) // 2] if xs else None


TIER_ORDER = ["claude:haiku", "codex:luna-low", "claude:sonnet-high", "codex:sol-medium", "codex:sol-high", "codex:sol-xhigh", "claude:opus-medium",
              "claude:opus-high", "claude:opus-xhigh", "codex:astra"]
TIER_KEYS = {run: key for key, run in RUN_TIERS.items()}


def tier_key(tier):
    t = (tier or "").strip() or "-"
    return t if t in RUN_TIERS else TIER_KEYS.get(t, t)


def tier_rank(tier):
    key = tier_key(tier)
    return TIER_ORDER.index(key) if key in TIER_ORDER else len(TIER_ORDER)


GROUPS = ["category", *FACETS]


def group_list(text):
    keys = [k.strip().lower() for k in text.split(",") if k.strip()]
    bad = [k for k in keys if k not in GROUPS]
    if bad or not keys:
        raise Refused(f"--group takes a comma list of {', '.join(GROUPS)}; got {text!r}")
    return keys


def cell_value(r, key):
    if key == "category":
        return r["category"] if r["category"] in CATEGORIES else "unknown"
    return r[key] or "-"


def percentile(xs, fraction):
    import math
    xs = sorted(x for x in xs if x is not None)
    return str(xs[max(0, math.ceil(len(xs) * fraction) - 1)]) if xs else "-"


def context_summary(rows):
    groups = {}
    for r in rows:
        groups.setdefault((r["role"], r["category"], r["tier"]), []).append(r)
    out = [("role", "category", "tier", "n", "peak_ctx_p50", "peak_ctx_p90", "compactions/run",
            "handoff_fires", "cache_read_share", "idle_gap_misses")]
    for key, rs in sorted(groups.items()):
        measured = [r for r in rs if r["compactions"] is not None]
        inputs = sum(r["input_tokens"] or 0 for r in measured)
        cache = sum(r["cache_read_tokens"] or 0 for r in measured)
        out.append((*key, str(len(rs)), percentile([r["peak_ctx"] for r in measured], .5),
                    percentile([r["peak_ctx"] for r in measured], .9),
                    f"{sum(r['compactions'] for r in measured) / len(measured):.2f}" if measured else "-",
                    str(sum(r["handoff_fires"] or 0 for r in measured)) if measured else "-",
                    f"{cache / inputs:.1%}" if inputs else "-",
                    str(sum(r["idle_gap_misses"] or 0 for r in measured)) if measured else "-"))
    table(out)


def cmd_summary(db, a):
    rows = db.execute("SELECT * FROM runs WHERE outcome != 'running' AND ended >= ?", (a.since or "",)).fetchall()
    if not rows:
        raise Refused(f"no runs in {DB}")
    keys = group_list(a.group)
    telemetry_rows = rows
    rows = [r for r in rows if r["role"] == "worker" and not unjudged(r)]
    splits = {r["agent"]: r for r in rows if r["outcome"] == "split"}
    groups: dict = {}
    for r in rows:
        if r["agent"] in splits:
            continue
        arm = r["arm"] or (splits[r["follows"]]["arm"] if r["follows"] in splits else None)
        groups.setdefault((*(cell_value(r, k) for k in keys), r["tier"], arm or "-"), []).append(r)
    ok = run_ok(db)
    out = [(*keys, "tier", "arm", "n", "done", "success", "ok", "eta_med", "actual_med", "work_med", "wait_med", "x_eta_med",
            "over_2x_eta", "tokens_med", "no_landing")]
    for key, rs in sorted(groups.items(), key=lambda kv: (kv[0][:-2], tier_rank(kv[0][-2]), kv[0][-1])):
        done = sum(r["outcome"] == "done" for r in rs)
        timed = [r for r in rs if r["eta_min"]]
        ratio = median([r["minutes"] / r["eta_min"] for r in timed])
        tok = median([r["tokens"] for r in rs])
        out.append((*key, str(len(rs)), str(done), f"{done * 100 // len(rs)}%", f"{sum(map(ok, rs)) * 100 // len(rs)}%",
                    str(median([r["eta_min"] for r in rs]) or "-"), str(median([r["minutes"] for r in rs])),
                    *(str(median([span(r[a], r[b]) for r in rs])).replace("None", "-")
                      for a, b in (("staffed", "review_requested"), ("review_requested", "landed_at"))),
                    f"{ratio:.1f}" if ratio is not None else "-",
                    f"{sum(r['minutes'] > 2 * r['eta_min'] for r in timed)}/{len(timed)}",
                    f"{tok // 1000}k" if tok is not None else "-",
                    f"{sum(r['expects_landing'] == 1 and r['landed'] == 0 for r in rs)}/{sum(r['expects_landing'] == 1 for r in rs)}"))
    table(out)
    print()
    context_summary(telemetry_rows)
    print()
    delivery_summary(rows)
    if table_exists(db, "run_costs"):
        for account, usd in db.execute("SELECT account, SUM(cost_usd) FROM run_costs WHERE agent = ? AND ended >= ? GROUP BY account"
                                       " ORDER BY account", (UNTRACKED, a.since or "")):
            print(f"untracked sessions on {account}: ${usd:.2f} unallocated")
    lenses: dict = {}
    for r in rows:
        if r["lens"]:
            lenses.setdefault(r["lens"], []).append(r)
    if lenses:
        print()
        table([("lens", "reviews", "accepted_flaws", "reviews_with_flaws")] + [
            (lens, str(len(rs)), str(sum(r["flaws"] or 0 for r in rs)), str(sum((r["flaws"] or 0) > 0 for r in rs)))
            for lens, rs in sorted(lenses.items())])
    if splits:
        print()
        split_summary(splits.values(), rows)
    print()
    try:
        closure(db, rows)
    except Refused as e:
        print(f"NorthThreads: closure table needs GitHub: {e}", file=sys.stderr)



def delivery_summary(rows):
    groups = {}
    for r in rows:
        groups.setdefault((r["model"] or "-", r["effort"] or "-", str(r["fast"]) if r["fast"] is not None else "-"), []).append(r)
    out = [("model", "effort", "fast", "done_boxes", "brief_to_landed_min_med", "usd_per_done_med", "concurrency")]
    for key, rs in sorted(groups.items()):
        metrics = delivery_metrics(rs)
        out.append((*key, str(metrics["done_boxes"]), *(f"{metrics[k]:.3f}" if metrics[k] is not None else "-"
                    for k in ("median_brief_to_landed_min", "median_cost_per_done_usd")), str(metrics["concurrency"])))
    table(out)
    projects = sorted({(r["item"] or "").split("#")[0] for r in rows if r["item"]})
    out = [("project", "done_boxes", "brief_to_landed_min_med", "usd_per_done_med", "concurrency")]
    for project in projects:
        metrics = delivery_metrics(rows, project)
        out.append((project, str(metrics["done_boxes"]), *(f"{metrics[k]:.3f}" if metrics[k] is not None else "-"
                    for k in ("median_brief_to_landed_min", "median_cost_per_done_usd")), str(metrics["concurrency"])))
    table(out)

def split_summary(splits, rows):
    """Per category: split runs, their parts (runs whose Follows: names a split run), the parts' closure rate,
    summed minutes, and minutes from the split's end to the last part's end."""
    groups: dict = {}
    for s in splits:
        parts = [r for r in rows if r["follows"] == s["agent"]]
        g = groups.setdefault(cell_value(s, "category"), {"splits": 0, "parts": 0, "closed": 0, "minutes": 0, "spans": []})
        g["splits"] += 1
        g["parts"] += len(parts)
        g["closed"] += sum(r["outcome"] == "done" for r in parts)
        g["minutes"] += sum(r["minutes"] for r in parts)
        if parts:
            g["spans"].append(span(s["ended"], max(r["ended"] for r in parts)))
    table([("category", "splits", "parts", "parts_closed", "parts_min", "split_to_last_min")] + [
        (cat, str(g["splits"]), str(g["parts"]), f"{round(g['closed'] * 100 / g['parts'])}%" if g["parts"] else "-",
         str(g["minutes"]), str(sum(x for x in g["spans"] if x is not None)) if g["spans"] else "-")
        for cat, g in sorted(groups.items())])


SUCCESS_THRESHOLD = DEFAULTS["success_threshold"]
MIN_RUNS, MARGIN = DEFAULTS["min_runs"], DEFAULTS["incumbent_margin"]
BACKOFF = ["surface", "verify", "scope", "spec"]


USD_MIN = MIN_RUNS
DEFAULT_TIER = DEFAULTS["default_tier"]
OLD_TIERS = ("haiku", "low", "medium", "high", "xhigh", "max")


def tier_stats(rs):
    by: dict = {}
    for r in rs:
        by.setdefault(tier_key(r["tier"]), []).append(r)
    out = {}
    for t, xs in by.items():
        priced = [r for r in xs if r.get("cost_usd") is not None]
        wins = sum(r["ok"] for r in priced)
        out[t] = {"rate": sum(r["ok"] for r in xs) * 100 // len(xs), "n": len(xs), "ok": sum(r["ok"] for r in xs), "usd_n": len(priced),
                  "usd": sum(r["cost_usd"] for r in priced) / wins if len(priced) >= USD_MIN and wins else None}
    return out


def recommend(runs, asked, incumbent, priced=True, default_tier=DEFAULT_TIER):
    """Pure core. runs: dicts with category, the facets, tier, ok (run_ok) and cost_usd (or None).
    asked: facet -> value, category required. incumbent: cell -> tier. Returns (cell, n, tier, stats, rule) where
    cell is the finest one with a tier holding MIN_RUNS runs, backing off along BACKOFF; tier is the cheapest by
    measured $ per success among tiers reaching the success threshold, by TIER_ORDER when any of them has under
    USD_MIN priced runs or priced is False, kept at the incumbent unless a dearer challenger beats it by MARGIN points.
    With no passing tier, returns the lowest measured cost among sampled tiers, or None for insufficient evidence."""
    keys = ["category", *(k for k in reversed(BACKOFF) if k in asked)]
    while True:
        cell = {k: asked[k] for k in keys}
        rs = [r for r in runs if all(r.get(k) == v for k, v in cell.items())]
        stats = tier_stats(rs)
        if any(st["n"] >= MIN_RUNS for st in stats.values()) or len(keys) == 1:
            break
        keys.pop()
    name = ", ".join(f"{k.capitalize()}: {v}" for k, v in cell.items())
    sampled = {t: st for t, st in stats.items() if st["n"] >= MIN_RUNS}
    passing = [t for t, st in sampled.items() if st["rate"] >= SUCCESS_THRESHOLD]
    thin = sorted((t for t in passing if sampled[t]["usd"] is None), key=tier_rank)
    if not passing:
        measured = {t: st for t, st in sampled.items() if st["usd"] is not None}
        best = min(measured, key=lambda t: (measured[t]["usd"], tier_rank(t))) if measured else None
        rule = ("$ per success (no tier passes; lowest measured cost among sampled tiers)" if measured
                else "insufficient evidence (no tier passes; no sampled tier has measured $ per success)")
        return name, len(rs), best, stats, rule
    elif len(passing) == 1:
        rule = "rank (one tier passes)"
    elif not priced:
        rule = "rank"
    elif thin:
        rule = "rank (uncalibrated: thin $ " + ", ".join(f"{t} n={sampled[t]['usd_n']}" for t in thin) + f" < {USD_MIN})"
    else:
        rule = "$ per success"
    by_usd = rule == "$ per success"

    def dearer(x, y):
        if by_usd and x in passing and y in passing:
            return sampled[x]["usd"] > sampled[y]["usd"]
        return tier_rank(x) > tier_rank(y)

    best = min(passing, key=lambda t: (sampled[t]["usd"], tier_rank(t)) if by_usd else tier_rank(t))
    held = tier_key(incumbent.get(name)) if incumbent.get(name) else None
    if held and held != best and held in sampled and best in sampled:
        if dearer(best, held) and sampled[best]["rate"] < sampled[held]["rate"] + MARGIN:
            best = held
    return name, len(rs), best, stats, rule


def stat_text(t, st):
    usd = f"${st['usd']:.2f}/success" if st["usd"] is not None else "$ n/a"
    return f"{t} {st['rate']}% of {st['n']}, {usd} (priced n={st['usd_n']})"


def recommend_eta(runs, cell, tier):
    fields = brief_fields(cell)
    keys = ["category", *(k for k in reversed(BACKOFF) if k in fields)]
    while True:
        samples = [r["minutes"] for r in runs if tier_key(r["tier"]) == tier_key(tier) and r["minutes"] is not None
                   and all(r.get(k) == fields[k] for k in keys)]
        if len(samples) >= DEFAULTS["eta_min_samples"] or len(keys) == 1:
            name = ", ".join(f"{k.capitalize()}: {fields[k]}" for k in keys)
            return quantile(samples, .75), len(samples), name
        keys.pop()


def recommend_usd(runs, category, tier):
    """Median $ per done run in the (category, tier) cell, backing off to the tier; None below 3 samples."""
    for keep in (lambda r: r["category"] == category and r["tier"] == tier, lambda r: r["tier"] == tier):
        costs = [r["cost_usd"] for r in runs if keep(r) and r["outcome"] == "done" and r["cost_usd"] is not None]
        if len(costs) >= 3:
            return quantile(costs, .5), len(costs)
    return None, 0


BOX_GAP, BOX_N = DEFAULTS["box_chain_gap_min"], DEFAULTS["box_calibration_n"]


def moment(text):
    value = datetime.fromisoformat(text.replace("Z", "+00:00"))
    return value if value.tzinfo else value.replace(tzinfo=timezone.utc)


def box_chains(rows):
    """Box durations: worker runs on one Item: in staffed order, chained while each is staffed within BOX_GAP minutes of
    the chain's latest end; a chain with a landed run lasts from its first staffed to its last landed. Runs carry no box
    and Follows: is free text, so chains are by item; parallel boxes of one item share a chain."""
    chains = []
    for g in box_groups(rows, BOX_GAP):
        landed = [moment(r.get("landed_at") or r["ended"]) for r in g if r.get("landed")]
        start, finish = g[0]["begin"], max(landed)
        category = g[0]["category"] if g[0]["category"] in CATEGORIES else None
        chains.append({"item": g[0]["item"], "category": category, "start": start, "end": finish, "runs": len(g),
                       "minutes": max(0.0, (finish - start).total_seconds() / 60)})
    return sorted(chains, key=lambda c: c["end"])


def box_duration(chains, category):
    """(p75 minutes, n, label): the category's box chains with at least eta_min_samples, else every category's."""
    if category in CATEGORIES:
        xs = [c["minutes"] for c in chains if c["category"] == category]
        if len(xs) >= DEFAULTS["eta_min_samples"]:
            return quantile(xs, .75), len(xs), f"box p75 Category: {category}"
    xs = [c["minutes"] for c in chains]
    return quantile(xs, .75), len(xs), "box p75 all categories"


def calibrate_box(chains, start, end):
    """Walk-forward actual/predicted for each chain that landed in [start, end), predicted from chains landed before it
    was staffed; one row, cell all, since a chain mixes providers."""
    lo, hi = moment(start), moment(end)
    pairs = []
    for c in chains:
        if lo <= c["end"] < hi:
            pred, n, _ = box_duration([e for e in chains if e["end"] < c["start"]], c["category"])
            if n and pred:
                pairs.append(("all", c["minutes"] / pred))
    return [r for r in ratio_rows(pairs) if r["cell"] == "all"]


def box_rows(db):
    return [dict(r) for r in db.execute("SELECT item, role, category, outcome, staffed, started, ended, landed, landed_at"
                                        " FROM runs WHERE role = 'worker' AND outcome != 'running' AND item IS NOT NULL")]


CAL_FLOOR, CAL_MAX_DAYS, CAL_TARGET = THIN_N, STALE_DAYS, DEFAULTS["eta_coverage"]
PROVIDERS = ("claude", "codex", "gemini", "all")


def quantile(xs, fraction):
    xs = sorted(x for x in xs if x is not None)
    return xs[max(0, math.ceil(len(xs) * fraction) - 1)] if xs else None


def provider(tier):
    key = tier_key(tier)
    if ":" in key:
        return key.split(":")[0]
    return "codex" if key.startswith("gpt-") else "gemini" if key.startswith("gemini") else "claude"


def scaled(raw, scale, whole=True):
    value = raw if raw is None or not scale else raw * scale
    return math.ceil(value) if whole and value is not None else value


def ratio_rows(pairs):
    """pairs: (tier, actual/predicted). One row per provider and all, value the scale that covers CAL_TARGET."""
    rows = []
    for cell in PROVIDERS:
        rs = [x for t, x in pairs if cell == "all" or provider(t) == cell]
        rows.append({"cell": cell, "n": len(rs), "p25": quantile(rs, .25), "median": quantile(rs, .5),
                     "p75": quantile(rs, .75), "value": quantile(rs, CAL_TARGET)})
    return rows


def run_cell(r):
    return ", ".join(f"{k.capitalize()}: {r[k]}" for k in GROUPS if r[k] != "-")


def earlier_by_tier(runs):
    by_tier: dict = {}
    for r in sorted(runs, key=lambda r: r["ended"]):
        by_tier.setdefault(r["tier"], []).append(r)
    keys = {t: [r["ended"] for r in rs] for t, rs in by_tier.items()}
    return lambda r: by_tier.get(r["tier"], [])[:bisect.bisect_left(keys.get(r["tier"], []), r["ended"])]


def walk_forward_eta(runs, start, end):
    """(run, uncalibrated recommend_eta from strictly earlier runs) for each run that ended in [start, end)."""
    earlier = earlier_by_tier([r for r in runs if r["first"]])
    out = []
    for r in runs:
        if r["first"] and r["minutes"] is not None and start <= r["ended"] < end:
            eta, n, _ = recommend_eta(earlier(r), run_cell(r), r["tier"])
            if n and eta:
                out.append((r, eta))
    return out


def calibrate_eta(runs, start, end):
    return ratio_rows([(r["tier"], r["minutes"] / r["eta_min"]) for r in runs
                       if r["eta_min"] and r["minutes"] is not None and start <= r["ended"] < end])


def calibrate_eta_pred(runs, start, end):
    return ratio_rows([(r["tier"], r["minutes"] / eta) for r, eta in walk_forward_eta(runs, start, end)])


def calibrate_usd(runs, start, end):
    pairs = []
    for r in runs:
        if r["cost_usd"] is not None and start <= r["ended"] < end:
            usd, _ = recommend_usd([e for e in runs if e["ended"] < r["ended"]], r["category"], r["tier"])
            if usd:
                pairs.append((r["tier"], r["cost_usd"] / usd))
    return ratio_rows(pairs)


def calibrate_tier(runs, start, end):
    by_cat: dict = {}
    for r in runs:
        if r["first"] and not r["unjudged"] and start <= r["ended"] < end:
            by_cat.setdefault(r["category"], []).append(r)
    out = []
    for cat, rs in sorted(by_cat.items()):
        for t, st in sorted(tier_stats(rs).items(), key=lambda kv: tier_rank(kv[0])):
            out.append({"cell": f"{cat} {t} success", "n": st["n"], "p25": None, "median": None, "p75": None, "value": st["rate"]})
            out.append({"cell": f"{cat} {t} usd_per_success", "n": st["usd_n"], "p25": None, "median": None, "p75": None,
                        "value": st["usd"]})
    return out


CALIBRATORS = {"eta": calibrate_eta, "eta_pred": calibrate_eta_pred, "usd": calibrate_usd, "tier": calibrate_tier}


def since_start(text, end):
    m = re.fullmatch(r"(\d+)([dh])", text)
    if not m:
        return text
    delta = timedelta(days=int(m[1])) if m[2] == "d" else timedelta(hours=int(m[1]))
    return (datetime.fromisoformat(end.replace("Z", "+00:00")) - delta).strftime("%Y-%m-%dT%H:%M:%SZ")


def calibration_runs(db):
    ok = run_ok(db)
    return [{**{k: cell_value(r, k) for k in GROUPS}, **{k: r[k] for k in ("tier", "minutes", "eta_min", "cost_usd", "outcome", "ended")},
             "first": r["follows"] is None, "ok": ok(r), "unjudged": unjudged(r)}
            for r in db.execute("SELECT * FROM runs WHERE role = 'worker' AND outcome NOT IN ('split','running') AND ended IS NOT NULL")]


def planner_items(db):
    groups = {}
    runs = [dict(r) for r in db.execute("SELECT * FROM runs ORDER BY coalesce(staffed, started, ended), ended, agent")]
    by_agent = {r["agent"]: r for r in runs}
    for r in runs:
        if r["item"] is not None:
            groups.setdefault(r["item"], []).append(r)
    items = []
    for item, rs in groups.items():
        first = rs[0]
        begins = [moment(r.get("staffed") or r.get("started") or r["ended"]) -
                  (timedelta(minutes=r["minutes"]) if not (r.get("staffed") or r.get("started")) else timedelta()) for r in rs]
        wall = max(0.0, (max(moment(r["ended"]) for r in rs) - min(begins)).total_seconds() / 60)
        eta = sum(r["eta_min"] or 0 for r in rs)
        missing_eta = sum(not r["eta_min"] or r["eta_min"] <= 0 for r in rs)
        ratio = wall / eta if eta > 0 and not missing_eta else None
        not_done = sum(r["outcome"] == "not done" for r in rs)
        stops = sum(bool(re.search(r"\bStop:[ \t]*(?:reasoning|decision)\b", r["report"], re.I)) for r in rs)
        restaffs = sum(bool(r["follows"] and r["follows"] in by_agent) for r in rs)
        escalations = sum(r["outcome"] == "escalated" or r.get("arm") == "escalate" or
                          (r["follows"] in by_agent and tier_key(r["tier"]) in TIER_ORDER and
                           tier_key(by_agent[r["follows"]]["tier"]) in TIER_ORDER and
                           tier_rank(r["tier"]) > tier_rank(by_agent[r["follows"]]["tier"])) for r in rs)
        compactions = sum(r["compactions"] or 0 for r in rs)
        difficulty = sum(math.log1p(v) for v in (ratio or 0, not_done, restaffs, escalations, compactions))
        signals = sum((stops >= 2, escalations > 0, ratio is not None and ratio > 2))
        first_outcome = min(moment(r["ended"]) for r in rs)
        initial_boxes = [r for r in rs if r.get("staffed") or r.get("started")
                         if moment(r.get("staffed") or r["started"]) < first_outcome]
        initial_eta = sum(r["eta_min"] or 0 for r in initial_boxes) if initial_boxes else first["eta_min"]
        prior_not_done, ancestor, seen = None, first["follows"], set()
        if ancestor:
            prior_not_done = 0
            while ancestor:
                if ancestor in seen or ancestor not in by_agent or moment(by_agent[ancestor]["ended"]) > min(begins):
                    prior_not_done = None
                    break
                seen.add(ancestor)
                previous = by_agent[ancestor]
                prior_not_done += previous["outcome"] == "not done"
                ancestor = previous["follows"]
        items.append(dict(item=item, runs=len(rs), wall_min=wall, eta_min=eta, missing_eta=missing_eta, ratio=ratio,
                          not_done=not_done, stops=stops, restaffs=restaffs, escalations=escalations,
                          compactions=compactions, difficulty=difficulty, benefit=min(2, signals),
                          off_rails=not_done >= 2 or escalations > 0 or (ratio is not None and ratio > 2),
                          category=first["category"], scope=first["scope"], surface=first["surface"], initial_eta=initial_eta, prior_not_done=prior_not_done))
    return items, len(runs), sum(r["item"] is None for r in runs)


def planner_cuts(items):
    rows = sorted(items, key=lambda r: (r["difficulty"], r["item"]))
    prefix = [[0, 0, 0]]
    for r in rows:
        counts = prefix[-1].copy()
        counts[r["benefit"]] += 1
        prefix.append(counts)
    boundaries = [0] + [i for i in range(1, len(rows)) if rows[i - 1]["difficulty"] < rows[i]["difficulty"]] + [len(rows)]
    best = None
    for high in boundaries:
        for maximum in boundaries:
            if maximum < high:
                continue
            correct = prefix[high][0] + prefix[maximum][1] - prefix[high][1] + prefix[-1][2] - prefix[maximum][2]
            candidate = (correct, high, maximum)
            if best is None or candidate > best:
                best = candidate
    _, high, maximum = best
    cut = lambda i: rows[i]["difficulty"] if i < len(rows) else math.inf
    return cut(high), cut(maximum)


def planner_prediction(item, training):
    def distance(other):
        value = sum(0 if item[k] is not None and item[k] != "unknown" and item[k] == other[k] else 1
                    for k in ("category", "scope", "surface"))
        a, b = item["initial_eta"], other["initial_eta"]
        gap = abs(math.log(a / b)) if a and b and a > 0 and b > 0 else None
        prior = 0
        if item.get("prior_not_done") is not None and other.get("prior_not_done") is not None:
            prior = abs(item["prior_not_done"] - other["prior_not_done"])
            prior = prior / (1 + prior)
        return value + (gap / (1 + gap) if gap is not None else 1) + prior
    near = sorted(training, key=lambda r: (distance(r), r["item"]))[:max(1, math.ceil(math.sqrt(len(training))))]
    return sum(r["difficulty"] for r in near) / len(near) if near else 0.0


def planner_holdout(items):
    shuffled = sorted(items, key=lambda r: r["item"])
    random.Random(54).shuffle(shuffled)
    n = math.ceil(len(shuffled) / 5)
    withheld, training = shuffled[:n], shuffled[n:]
    ranked = sorted(withheld, key=lambda r: (-planner_prediction(r, training), r["item"]))
    top = ranked[:len(withheld) // 10]
    trials = sum(r["off_rails"] for r in withheld)
    hits = sum(r["off_rails"] for r in top)
    p = sum(math.comb(trials, k) * .1 ** k * .9 ** (trials - k) for k in range(hits, trials + 1))
    return dict(seed=54, training=len(training), withheld=n, top_decile=len(top), off_rails=trials, hits=hits,
                rate=hits / trials if trials else 0, p=p,
                passed=trials > 0 and hits / trials > .1 and p < .05)


def planner_band(difficulty, high, maximum):
    return "high" if difficulty < high else "xhigh" if difficulty < maximum else "max"


def cmd_planner_recommend(db, a, asked):
    for key in ("scope", "surface", "initial_eta", "prior_not_done"):
        if key not in asked:
            raise Refused("planner needs Scope, Surface, Summed box ETA and Prior Not dones")
    if asked["initial_eta"] <= 0:
        raise Refused("Summed box ETA must be positive")
    items, _, _ = planner_items(db)
    if not items:
        raise Refused("planner needs past items")
    high, maximum = planner_cuts(items)
    prediction = planner_prediction(asked, items)
    print(f"planner {planner_band(prediction, high, maximum)}  nearest items n={max(1, math.ceil(math.sqrt(len(items))))}  difficulty={prediction:.6f}")
    print(f"cut points high=[0,{high:.6f}) xhigh=[{high:.6f},{maximum:.6f}) max=[{maximum:.6f},inf)")
    missing = sum(r["prior_not_done"] is None for r in items)
    if asked["prior_not_done"]:
        print(f"prior Not dones: {asked['prior_not_done']} given; history has no planning-time prior Not dones for {missing} of {len(items)} items, so matching ignores it for those")
    h = planner_holdout(items)
    print(f"held-out: {h['hits']} of {h['off_rails']} off-rails items in the top decile ({100 * h['rate']:.2f}%), p={h['p']:.8g}; {'PASS' if h['passed'] else 'FAIL'} at alpha 0.05")


def cmd_planner_band(db, a):
    items, runs, no_item = planner_items(db)
    high, maximum = planner_cuts(items)
    band = lambda r: planner_band(r["difficulty"], high, maximum)
    counts = [sum(band(r) == b for r in items) for b in ("high", "xhigh", "max")]
    print(f"backfill runs={runs} items={len(items)} assigned_runs={runs - no_item}")
    print(f"no Item runs={no_item}")
    print("difficulty=sum(log1p(wall/ETA, Not done, restaffs, escalations, compactions)); "
          "wall=first start to last end; ratio omitted unless all runs have positive ETA")
    out = [("item", "runs", "wall_min", "ETA", "missing_ETA", "ratio", "Not_done", "Stop", "restaffs", "escalations",
            "compactions", "difficulty", "band")]
    for r in sorted(items, key=lambda r: (r["difficulty"], r["item"])):
        out.append((r["item"], r["runs"], f"{r['wall_min']:.1f}", r["eta_min"], r["missing_eta"],
                    f"{r['ratio']:.3f}" if r["ratio"] is not None else "-", r["not_done"], r["stops"], r["restaffs"],
                    r["escalations"], r["compactions"], f"{r['difficulty']:.6f}", band(r)))
    table([tuple(map(str, row)) for row in out])
    print("cut rule=minimum item classification errors; benefit classes=0/1/2+ signals "
          "(2+ reasoning/decision Stops, escalation, wall/ETA>2); ties prefer lower effort")
    print(f"cut points high=[0,{high:.6f}) xhigh=[{high:.6f},{maximum:.6f}) max=[{maximum:.6f},inf)")
    shares = [100 * n / len(items) if items else 0 for n in counts]
    print(f"measured high/xhigh/max={shares[0]:.2f}/{shares[1]:.2f}/{shares[2]:.2f}% "
          f"items={counts[0]}/{counts[1]}/{counts[2]} prior=90/8/2%")
    h = planner_holdout(items)
    print("held-out ranking=nearest sqrt(training n) items by initial category/scope/surface/ETA and observed prior Not dones; training outcomes only")
    print(f"held-out seed={h['seed']} training={h['training']} items={h['withheld']} top_decile={h['top_decile']} "
          f"off_rails={h['off_rails']} hits={h['hits']} rate={h['rate']:.2%} chance=10% "
          f"binomial_p={h['p']:.8g} alpha=0.05 {'PASS' if h['passed'] else 'FAIL'}")


ROUTING_CAMPAIGN_START = "2026-10-12T12:27:27Z"
ROUTING_BASELINE_START = "2026-10-05T12:27:27Z"
ROUTING_SPLIT_START = "2026-10-15T02:00Z"
ROUTING_SPLIT_END = "2026-10-15T16:00Z"
ROUTING_ARMS = (("baseline", ROUTING_BASELINE_START, ROUTING_CAMPAIGN_START),
                ("codex-only", ROUTING_CAMPAIGN_START, ROUTING_SPLIT_START),
                ("split-after", ROUTING_SPLIT_START, ROUTING_SPLIT_END))


def routing_bootstrap(values, statistic):
    if len(values) < 5:
        return f"n/a (n={len(values)})"
    rng = random.Random(0)
    samples = sorted(statistic(rng.choices(values, k=len(values))) for _ in range(2000))
    return f"{statistic(values):.2f} [{quantile(samples, .025):.2f},{quantile(samples, .975):.2f}] (n={len(values)})"


def routing_rate(count, n):
    if n < 5:
        return f"n/a (n={n})"
    low, high = wilson(count / n, n)
    return f"{100 * count / n:.2f}% [{100 * low:.2f},{100 * high:.2f}] ({count}/{n})"


def routing_boxes(rows, start, end):
    workers = [r for r in rows if r["role"] == "worker" and r["outcome"] != "running"]
    by_item = {}
    for r in workers:
        if r["item"]:
            by_item.setdefault(r["item"], []).append(r)
    boxes = []
    for item, history in sorted(by_item.items()):
        landed = [r for r in history if r["landed"] == 1 and
                  start <= moment(r["landed_at"] or r["ended"]) < end]
        if not landed:
            continue
        finish = max(moment(r["landed_at"] or r["ended"]) for r in landed)
        rs = [r for r in history if r in landed or moment(r["ended"]) <= finish]
        rs.sort(key=lambda r: (moment(r["staffed"] or r["started"] or r["ended"]), r["agent"]))
        by_agent = {r["agent"]: r for r in rs}
        rework = any((r["repeats"] or 0) > 0 or r["follows"] in by_agent or
                     re.search(r"(?:^|\n)\s*(?:Rework(?:ed)?|Revert(?:ed)?):", r["report"], re.I) for r in rs)
        escalated = any(r["outcome"] == "escalated" or r["arm"] == "escalate" or
                        (r["follows"] in by_agent and tier_rank(r["tier"]) > tier_rank(by_agent[r["follows"]]["tier"]))
                        for r in rs)
        not_done = any(r["outcome"] == "not done" for r in rs)
        unknown = any(r.get("outcome") != "done" for r in rs)
        staffed = [moment(r["staffed"]) for r in rs if r["staffed"]]
        wall = (finish - min(staffed)).total_seconds() / 60 if len(staffed) == len(rs) and all(r["landed_at"] for r in landed) else None
        boxes.append(dict(item=item, category=cell_value(rs[0], "category"), runs=rs, landed=landed,
                          wall=wall, first_try=False if rework or escalated or not_done else None if unknown else True,
                          adverse=True if rework or not_done else None if unknown else False))
    no_item = [r for r in workers if not r["item"] and start <= moment(r["landed_at"] or r["ended"]) < end]
    return boxes, no_item


def cmd_routing_compare(db, a):
    from usage import operator_dir
    rows = [dict(r) for r in db.execute("SELECT * FROM runs")]
    costs_path = operator_dir() / "costs.toml"
    try:
        prices = costs_by_id(tomllib.loads(costs_path.read_text()))
    except (OSError, ValueError) as e:
        raise Refused(f"cannot read account costs {costs_path}: {e}") from e
    costs = {}
    if table_exists(db, "run_costs"):
        for r in db.execute("SELECT agent,account,SUM(cost_usd) AS usd FROM run_costs GROUP BY agent,account"):
            costs.setdefault(r["agent"], {})[r["account"]] = r["usd"]
    reviews = set()
    arms = [(name, start, end, *routing_boxes(rows, moment(start), moment(end))) for name, start, end in ROUTING_ARMS]
    item_arms = {}
    for name, _, _, boxes, _ in arms:
        for box in boxes:
            item_arms.setdefault(box["item"], set()).add(name)
    print(f"source ledger={Path(DB).resolve()} (read-only); campaign=south c2edcdf")
    print(f"source account prices={costs_path}; plan_usage.costs_by_id; points=run_costs USD*100/account usd_per_week")
    print("source reviews=unavailable from retired peer files; multi-arm items require landing SHA prefix")
    print("boxes=distinct worker items with landed=1 in [start,end); landing time=landed_at, else ended; category=first worker run")
    print("history=landed runs and worker runs ended by last landing; wall requires every staffed and landing timestamp")
    print("first_try=no Not done/rework/escalation before landing; adverse=Not done or repeats/Follows/rework/revert report marker; escalation=outcome/arm/tier increase")
    print("quality=independent metrics; decisive failure/adverse evidence wins; otherwise any outcome other than done is unknown; rates use known observations")
    print("mix=worker run counts by provider(tier)/tier; review minutes=observed total; points require known accounts and every run's allocation, never imputed")
    print("CI=95%; bootstrap=2000 resamples, seed=0, percentile; rates=Wilson; statistics require n>=5")
    if moment(now()) < moment(ROUTING_SPLIT_END):
        print(f"window open until {ROUTING_SPLIT_END}")
    out = [("arm", "category", "landed_boxes", "provider/tier_runs", "wall_min_median_CI", "first_try_CI", "adverse_CI", "review_min", "review_coverage")]
    point_out = [("arm", "category", "account", "landed_boxes", "allocated_boxes", "points_per_box_CI")]
    for name, start, end, boxes, no_item in arms:
        print(f"window {name} [{start},{end})")
        print(f"no Item runs {name} n={len(no_item)} landed={sum(r['landed'] == 1 for r in no_item)}")
        print(f"coverage {name} category={sum(b['category'] != 'unknown' for b in boxes)}/{len(boxes)} "
              f"landing_timestamp={sum(all(r['landed_at'] for r in b['landed']) for b in boxes)}/{len(boxes)}")
        for box in boxes:
            candidates = sorted((sha, minutes) for item, sha, minutes in reviews if item == box["item"])
            shas = [r["landed_sha"] for r in box["landed"] if r["landed_sha"]]
            matched = [r for r in candidates if len(item_arms[box["item"]]) == 1 or
                       any(sha.startswith(r[0]) or r[0].startswith(sha) for sha in shas)]
            all_shas = [r["landed_sha"] for _, _, _, arm_boxes, _ in arms for b in arm_boxes
                        if b["item"] == box["item"] for r in b["landed"] if r["landed_sha"]]
            box["ambiguous"] = len(item_arms[box["item"]]) > 1 and any(
                not any(sha.startswith(r[0]) or r[0].startswith(sha) for sha in all_shas) for r in candidates)
            box["review"] = sum(minutes for _, minutes in matched) if matched and not box["ambiguous"] else None
            if matched:
                print(f"review match {name} {box['item']} observed_minutes={sum(minutes for _, minutes in matched):g} " +
                      ";".join(f"{sha}:{minutes:g}" for sha, minutes in matched))
        print(f"review ambiguity {name} boxes={sum(b['ambiguous'] for b in boxes)}/{len(boxes)}")
        categories = sorted({b["category"] for b in boxes})
        for category in [*categories, "overall"]:
            bs = boxes if category == "overall" else [b for b in boxes if b["category"] == category]
            mix = {}
            for b in bs:
                for r in b["runs"]:
                    key = f"{provider(r['tier'])}/{r['tier']}"
                    mix[key] = mix.get(key, 0) + 1
            reviewed = [b["review"] for b in bs if b["review"] is not None]
            first_try = [b["first_try"] for b in bs if b["first_try"] is not None]
            adverse = [b["adverse"] for b in bs if b["adverse"] is not None]
            print(f"quality coverage {name} {category} first_try known={len(first_try)}/{len(bs)} unknown={len(bs) - len(first_try)}/{len(bs)} "
                  f"adverse known={len(adverse)}/{len(bs)} unknown={len(bs) - len(adverse)}/{len(bs)}")
            out.append((name, category, str(len(bs)), ";".join(f"{k}:{v}" for k, v in sorted(mix.items())) or "-",
                        routing_bootstrap([b["wall"] for b in bs if b["wall"] is not None], median),
                        routing_rate(sum(first_try), len(first_try)), routing_rate(sum(adverse), len(adverse)),
                        f"{sum(reviewed):.2f}" if len(reviewed) >= 5 else f"n/a (n={len(reviewed)})", f"{len(reviewed)}/{len(bs)}"))
            accounts = sorted({account for b in bs for r in b["runs"] for account in [r["account"], *costs.get(r["agent"], {})] if account})
            for account in accounts:
                usd = [sum(costs.get(r["agent"], {}).get(account, 0) for r in b["runs"]) for b in bs]
                covered = sum(any(account in costs.get(r["agent"], {}) for r in b["runs"]) for b in bs)
                complete = sum(all(r["account"] and r["account"] in costs.get(r["agent"], {}) for r in b["runs"]) for b in bs)
                points = [v * 100 / prices[account] for v in usd] if complete == len(bs) and prices.get(account, 0) > 0 else []
                point_out.append((name, category, account, str(len(bs)), str(covered),
                                  routing_bootstrap(points, lambda xs: sum(xs) / len(xs)) if points else
                                  f"n/a (n={complete if prices.get(account, 0) > 0 else 0})"))
    landed_items = {b["item"] for _, _, _, boxes, _ in arms for b in boxes}
    for item in sorted({r[0] for r in reviews} - landed_items):
        matched = sorted((sha, minutes) for reviewed_item, sha, minutes in reviews if reviewed_item == item)
        print(f"review unmatched {item} minutes={sum(minutes for _, minutes in matched):g} no landed item in windows " +
              ";".join(f"{sha}:{minutes:g}" for sha, minutes in matched))
    table(out)
    print()
    table(point_out)


def cmd_calibrate(db, a):
    if a.write and DB == SNAPSHOT:
        raise Refused("calibrate --write needs the live ledger; this is the read-only snapshot")
    end = now()
    if a.goal_row:
        if not a.write:
            raise Refused("calibrate --goal-row needs --write")
        try:
            row = json.loads(a.goal_row)
            values = (end, row["kind"], row["cell"], int(row["n"]), None, None, None, row["value"], row["source"])
        except (ValueError, KeyError, TypeError) as e:
            raise Refused(f"calibrate --goal-row takes a JSON object with kind, cell, n, value and source: {e}")
        if row["kind"] not in GOAL_KINDS or not isinstance(row["value"], (int, float, type(None))):
            raise Refused(f"calibrate --goal-row kind must be one of {', '.join(GOAL_KINDS)} with a numeric value")
        with Tx(db):
            db.execute("INSERT INTO calibration(at, kind, cell, n, p25, median, p75, value, source) VALUES (?,?,?,?,?,?,?,?,?)", values)
        print(f"{row['kind']} {row['cell']} recorded at {end}")
        return
    start = since_start(a.since, end)
    runs = calibration_runs(db)
    window = a.since if re.fullmatch(r"\d+[dh]", a.since) else f"since {a.since}"
    rows = [{"kind": kind, **row, "source": f"measured n={row['n']} {window}"}
            for kind, fn in CALIBRATORS.items() for row in fn(runs, start, end)]
    rows += [{"kind": "box", **row, "source": f"measured n={row['n']} chains {window}"}
             for row in calibrate_box(box_chains(box_rows(db)), start, end)]
    if a.write:
        with Tx(db):
            db.executemany("INSERT INTO calibration(at, kind, cell, n, p25, median, p75, value, source) VALUES (?,?,?,?,?,?,?,?,?)",
                           [(end, r["kind"], r["cell"], r["n"], r["p25"], r["median"], r["p75"], r["value"], r["source"]) for r in rows])
    if a.json:
        print(json.dumps({"at": end, "since": start, "rows": rows}))
        return
    fmt = lambda x: "-" if x is None else f"{x:.2f}"
    table([("kind", "cell", "n", "p25", "median", "p75", "value")]
          + [(r["kind"], r["cell"], str(r["n"]), fmt(r["p25"]), fmt(r["median"]), fmt(r["p75"]), fmt(r["value"])) for r in rows])


def cmd_record_priors(db, a):
    rows = []
    for spec in a.priors:
        m = re.fullmatch(r"([\w.-]+):(\d+):(\d+)(?::(-?[\d.]+))?", spec)
        if not m:
            raise Refused(f"record-priors: {spec!r} is not NAME:N:NEED[:VALUE]")
        rows.append((m[1], int(m[2]), float(m[3]), "defaults-measure --priors" + (f" value={m[4]}" if m[4] else "")))
    end = now()
    with Tx(db):
        db.executemany("INSERT INTO calibration(at, kind, cell, n, value, source) VALUES (?, 'prior', ?, ?, ?, ?)",
                       [(end, *r) for r in rows])


def latest_calibration(db, kind, tier, column="value"):
    """(scale, label): the newest row's column for the tier's provider, else all; scale None with the fallback reason."""
    reason = f"no {kind} calibration"
    for cell in (provider(tier), "all"):
        row = db.execute("SELECT * FROM calibration WHERE kind = ? AND cell = ? ORDER BY rowid DESC LIMIT 1", (kind, cell)).fetchone()
        if not row:
            continue
        age = minutes_since(row["at"]) / 1440
        floor = BOX_N if kind == "box" else CAL_FLOOR
        if row["n"] < floor or row[column] is None:
            reason = f"{kind} {cell} n={row['n']} < {floor}"
        elif age > CAL_MAX_DAYS:
            reason = f"{kind} {cell} {age:.0f}d old"
        else:
            return row[column], f"x{row[column]:.2f} {kind} {cell} n={row['n']} " + (f"median {row['median']:.2f}" if column == "value" else f"{column} of actual/predicted")
    return None, f"uncalibrated: {reason}"


def run_ok(db):
    """Reported Done (ruled out included) with no later Follows: run on it, and landed when the run made a commit."""
    escalated = {r["follows"] for r in db.execute("SELECT follows FROM runs WHERE role = 'worker' AND follows IS NOT NULL")}
    return lambda r: succeeded(r, r["agent"] in escalated)


def recommend_runs(rows, ok):
    return [{**{k: cell_value(r, k) for k in GROUPS}, "tier": tier_key(r["tier"]), "ok": ok(r), "minutes": r["minutes"],
             "cost_usd": r["cost_usd"], "outcome": r["outcome"]} for r in rows if not unjudged(r)]


def cmd_recommend(db, a):
    asked = brief_fields(a.facets)
    if "category" not in asked or asked["category"] not in CATEGORIES:
        raise Refused(f"recommend needs `Category: <one of {', '.join(CATEGORIES)}>` in {a.facets!r}")
    if a.planner:
        return cmd_planner_recommend(db, a, asked)
    asked = {k: v for k, v in asked.items() if k in GROUPS}
    operator = Path(os.environ.get("AGENTS_OPERATOR_DIR") or Path.home() / "code/south/main/agents")
    config = Path(os.environ.get("AGENTS_ORCHESTRATION") or operator / "orchestration.toml")
    try:
        with config.open("rb") as f:
            cfg = tomllib.load(f)
        mode, _, wanted = resolve_mode(cfg)
    except (OSError, ValueError) as e:
        raise Refused(f"cannot resolve recommendation mode from {config}: {e}")
    runs = recommend_runs(db.execute("SELECT * FROM runs WHERE role = 'worker' AND follows IS NULL AND outcome != 'split'"
                                     " AND ended >= ?", (a.since or "",)), run_ok(db))
    incumbent = dict(db.execute("SELECT cell, tier FROM tier_choice").fetchall())
    default_tier = DEFAULT_TIER
    if mode == "codex-only":
        allowed = [key for key in cfg.get("tiers", {}) if key.split(":")[0] in wanted]
        runs = [r for r in runs if r["tier"] in allowed]
        full = bands_of(cfg.get("tiers", {}))
        default_start = next((lo for lo, _, tier in full if tier == DEFAULT_TIER), None)
        default_tier = next((tier for lo, hi, tier in resolve_bands(full, allowed)
                             if default_start is not None and lo <= default_start < hi), None)
        if default_tier is None:
            raise Refused(f"no mode-allowed band for default tier {DEFAULT_TIER}")
    cell, n, tier, stats, rule = recommend(runs, asked, incumbent, default_tier=default_tier)
    if tier is not None and incumbent.get(cell) != tier:
        with Tx(db):
            db.execute("INSERT INTO tier_choice(cell, tier, since) VALUES (?,?,?) ON CONFLICT(cell) DO UPDATE SET"
                       " tier = excluded.tier, since = excluded.since", (cell, tier, now()))
    print(f"tier {tier}  cell [{cell}]  n {n}" if tier is not None else f"insufficient evidence  cell [{cell}]  n {n}")
    print(f"success threshold {SUCCESS_THRESHOLD}%  rule {rule}")
    for t, st in sorted(stats.items(), key=lambda kv: tier_rank(kv[0])):
        usd = f"${st['usd']:.2f}/success" if st["usd"] is not None else "$ n/a"
        print(f"  {t:<18} {st['rate']}% of {st['n']}  {usd} (priced n={st['usd_n']})")
    if tier is None:
        return
    eta, eta_n, eta_cell = recommend_eta(runs, cell, tier)
    scale, label = latest_calibration(db, "eta_pred", tier)
    usd, usd_n = recommend_usd(runs, asked["category"], tier)
    usd_scale, usd_label = latest_calibration(db, "usd", tier)
    cost = f"  ${scaled(usd, usd_scale, whole=False):.2f} (median of n={usd_n}, {usd_label})" if usd else f"  $ n/a ({usd_label})"
    if mode == "codex-only":
        fields = brief_fields(cell)
        samples = [r["minutes"] for r in runs if r["tier"] == tier and r["minutes"] is not None
                   and all(r.get(k) == v for k, v in fields.items())]
        print((f"eta {median(samples)}m (actual_med of n={len(samples)}, cell {cell}, tier {tier})" if len(samples) >= MIN_RUNS
               else f"eta n/a (n={len(samples)})") + cost)
        return
    print((f"eta {scaled(eta, scale)}m (p75 of n={eta_n}, cell {eta_cell}, tier {tier}, {label})" if eta_n
           else "eta n/a (n=0)") + cost)


def cmd_replay_staffing(db, a):
    since = since_start(a.since, now())
    rows = [dict(r) for r in db.execute("SELECT * FROM runs WHERE role = 'worker' AND follows IS NULL AND outcome != 'split'"
                                        " ORDER BY ended") if not unjudged(r)]
    followed: dict = {}
    for f, ended in db.execute("SELECT follows, ended FROM runs WHERE role = 'worker' AND follows IS NOT NULL"):
        followed[f] = min(ended, followed.get(f, ended))
    final = run_ok(db)
    by_cat: dict = {}
    for r in rows:
        by_cat.setdefault(cell_value(r, "category"), []).append(r)
    old_held: dict = {}
    new_held: dict = {}
    decisions, changes = 0, {}
    for x in (r for r in rows if r["ended"] >= since and cell_value(r, "category") != "unknown"):
        at = x["started"] or x["ended"]
        asked = {k: cell_value(x, k) for k in GROUPS if cell_value(x, k) != "-"}

        def ok_then(r):
            return succeeded(r, r["agent"] in followed and followed[r["agent"]] < at)

        hist = [r for r in by_cat[asked["category"]] if r["ended"] < at]
        new_runs = recommend_runs(hist, ok_then)
        old_runs = [r for r in recommend_runs([r for r in hist if r["tier"] in OLD_TIERS], ok_then)]
        cell, _, old, _, _ = recommend(old_runs, asked, old_held, priced=False)
        old_held[cell] = old
        cell, _, new, stats, rule = recommend(new_runs, asked, new_held)
        new_held[cell] = new
        decisions += 1
        if old == new:
            continue
        c = changes.setdefault((cell, old, new), {"runs": 0, "new": 0, "new_ok": 0, "old": 0, "old_ok": 0, "other": 0})
        c["runs"] += 1
        c["stats"], c["rule"] = stats, rule
        actual = tier_key(x["tier"])
        side = "new" if actual == new else "old" if actual == old else "other"
        c[side] += 1
        if side != "other":
            c[side + "_ok"] += final(x)
    print(f"replay-staffing since {since or 'all'}: {decisions} first-assignment runs, picks from strictly earlier runs")
    for (cell, old, new), c in sorted(changes.items(), key=lambda kv: (-kv[1]["runs"], tuple(str(x) for x in kv[0]))):
        print(f"[{cell}]  {old} -> {new}  runs {c['runs']}  rule {c['rule']}")
        for t in (new, old):
            if t in c["stats"]:
                print(f"  {stat_text(t, c['stats'][t])}")
        print(f"  actual: new pick {c['new']} ({c['new_ok']} ok), old pick {c['old']} ({c['old_ok']} ok), other {c['other']}")
    total = {k: sum(c[k] for c in changes.values()) for k in ("runs", "new", "new_ok", "old", "old_ok", "other")}
    print(f"changed {total['runs']} of {decisions} decisions in {len({k[0] for k in changes})} cells; actual tier was the new pick "
          f"{total['new']} ({total['new_ok']} ok), the old pick {total['old']} ({total['old_ok']} ok), another {total['other']}")


def table(out):
    widths = [max(len(row[i]) for row in out) for i in range(len(out[0]))]
    for row in out:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())


def closure(db, rows):
    """Per issue: category and tier of its first run; closed from GitHub's open set; escalated when a
    later run used a higher tier."""
    by_item: dict = {}
    for r in rows:
        if issue_ref(r["item"]):
            by_item.setdefault(r["item"], []).append(r)
    opened: dict = {}
    groups: dict = {}
    for item, rs in by_item.items():
        rs.sort(key=lambda r: r["started"] or r["ended"])
        first = rs[0]
        repo, number = parse_ref(item)
        if repo not in opened:
            opened[repo] = open_issues(db, repo)
        g = groups.setdefault((first["category"], first["tier"]), {"issues": 0, "closed": 0, "runs": 0, "tokens": 0, "escalated": 0})
        g["issues"] += 1
        g["escalated"] += any(tier_rank(r["tier"]) > tier_rank(first["tier"]) for r in rs[1:])
        if str(number) not in opened[repo]:
            g["closed"] += 1
            g["runs"] += len(rs)
            g["tokens"] += sum(r["tokens"] or 0 for r in rs)
    out = [("category", "first_tier", "issues", "closed", "runs_per_closed", "tokens_per_closed", "escalated")]
    for (cat, tier), g in sorted(groups.items(), key=lambda kv: (kv[0][0], tier_rank(kv[0][1]))):
        c = g["closed"]
        out.append((cat, tier, str(g["issues"]), str(c), f"{g['runs'] / c:.1f}" if c else "-",
                    f"{g['tokens'] // c // 1000}k" if c else "-", f"{g['escalated'] * 100 // g['issues']}%"))
    table(out)


def cmd_agent_event(db, a):
    gitleaks_clean(a.body)
    item = ref(*parse_ref(a.item)) if a.item else None
    if item and item.split('#')[0] in NATIVE:
        native_item(db, *parse_ref(item))
    for event_id in (a.answer, a.root_event):
        if event_id is not None:
            target = durable_events.addressed(db, event_id)
            if target['item']:
                parse_ref(target['item'])
            root = json.loads(target['data']).get('root_event')
            if root is not None:
                linked = durable_events.addressed(db, root)
                if linked['item']:
                    parse_ref(linked['item'])
    data = {field: getattr(a, field) for field in ('to_node', 'repo', 'lane', 'sha', 'body', 'packet', 'key', 'root_event', 'answer')}
    print(json.dumps(durable_events.append(db, a.kind, item, a.from_node, data, now(), Tx)))


def cmd_agent_events(db, a):
    rows = durable_events.pending(db, a.id)
    if no_native_reason():
        rows = [row for row in rows if not row['item'] or not NATIVE_REF.fullmatch(row['item'])]
    print(json.dumps(rows))


def cmd_agent_event_state(db, a):
    row = durable_events.addressed(db, a.id)
    if row['item']:
        parse_ref(row['item'])
    print(json.dumps(durable_events.update_state(db, a.id, json.loads(a.update_json), Tx)))


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="threads",
        description=f"Who holds which GitHub issue, handoffs and worker runs. Items are issue refs "
                    f"({', '.join(r + '#N' for r in REPOS)}). Database: {DB}",
        epilog="A running worker whose brief has `Item: <repo#N>` holds that issue (recorded by worker-ledger); "
               "claim/release are for humans and lanes. Brief categories: "
               + ", ".join(CATEGORIES) + "; anything else counts as unknown. Facets: "
               + "; ".join(f"{k.capitalize()}: {' | '.join(v)}" for k, v in FACETS.items())
               + "; Lens: <reviewer lens>. unowned: order is priority:now, unlabeled, "
               "priority:next, priority:later; the owner is a NorthThread claim not past 2x its ETA or held by a live org session, else an origin claude/* or "
               f"*land-* branch with a commit in the last {BRANCH_HOURS} h whose name, or a commit headline or "
               "Item:/Closes/Fixes/Refs line ahead of main, names the issue; blocked:REASON comes from `threads block` "
               f"or a comment starting `Blocked:` in the last {BLOCK_DAYS} days. Cloud routine runs are not a source: the "
               "CLI cannot read them.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def cmd(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        s.add_argument("--by", default=default_actor(), help="who is acting (default $THREADS_ACTOR or $USER)")
        return s

    s = cmd("agent-event", cmd_agent_event, "publish a durable addressed event")
    s.add_argument("kind", choices=durable_events.KINDS)
    s.add_argument("item", nargs="?")
    s.add_argument("--from-node", required=True)
    s.add_argument("--to-node", required=True)
    s.add_argument("--body", required=True)
    for field in ("repo", "lane", "sha", "packet", "key"):
        s.add_argument("--" + field)
    for field in ("answer", "root-event"):
        s.add_argument("--" + field, type=int)
    s = cmd("agent-events", cmd_agent_events, "read canonical pending addressed events")
    s.add_argument("--id", type=int)
    s = cmd("agent-event-state", cmd_agent_event_state, "update durable delivery state")
    s.add_argument("id", type=int)
    s.add_argument("--update-json", required=True)

    s = cmd("claim", cmd_claim, "hold an issue; refused when someone else holds it")
    s.add_argument("id")
    s.add_argument("--eta", type=int, help="minutes")
    s = cmd("release", cmd_release, "let go of an issue, or hand it --to someone")
    s.add_argument("id")
    s.add_argument("--to")
    s = cmd("new", cmd_new, f"capture a native item in NS ({', '.join(NATIVE)}); prints its ref")
    s.add_argument("ns")
    s.add_argument("title")
    s.add_argument("--due")
    s.add_argument("--body", help="item text, or - to read it from stdin")
    s = cmd("note", cmd_note, "add a note to a native item")
    s.add_argument("id")
    s.add_argument("text", nargs="+")
    s = cmd("close", cmd_close, "close a native item")
    s.add_argument("id")
    s = cmd("reopen", cmd_reopen, "reopen a native item")
    s.add_argument("id")
    s = cmd("need", cmd_need, "ID is blocked by OTHER: on GitHub, or locally when either is a native item")
    s.add_argument("id")
    s.add_argument("other")
    s = cmd("unneed", cmd_unneed, "remove ID's blocked-by OTHER (GitHub, or locally for native items)")
    s.add_argument("id")
    s.add_argument("other")
    s = cmd("show", cmd_show, "issue title, state and blockers, with its owners, handoffs, runs and origin archive restore commands")
    s.add_argument("id")
    cmd("ready", cmd_ready, "open issues with no open blocker and no owner")
    cmd("list", cmd_list, "held issues with owner, time on the clock, ETA and overdue flag")
    cmd("snapshot", cmd_snapshot, "write a consistent copy of the database to stdout (a proxying laptop's read fallback)")
    cmd("ingest", cmd_ingest, "record worker runs or type=usage readouts from JSON rows on stdin")
    s = cmd("run-ids", cmd_run_ids, "agent ids already recorded (for worker-ledger)")
    s.add_argument("--settled", action="store_true", help=f"leave out runs that committed in the last {LANDING_DAYS} days "
                   "and whose commit is not yet on origin/main, so worker-ledger rereads them")
    s = cmd("unowned", cmd_unowned, "open smashcraft and wisp issues with an unchecked box: owner, block or UNOWNED, "
            "priority:now first")
    s = cmd("block", cmd_block, "record why an issue cannot be staffed now (shown by unowned); --clear removes it")
