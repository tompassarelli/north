#!/usr/bin/env bb
;; north pinned — the big-fish board.
;;
;; 700+ open threads is sediment, not a queue. Almost all of them are LEAVES;
;; only a handful are workstream parents that actually carry other work. This
;; renders exactly the threads you pinned (`north tell <id> pinned true`),
;; ranked by priority then by how much work hangs off them, with enough state
;; to answer "where is this one" without opening it.
;;
;; Columns: priority · children (threads with part_of -> this) · progress facts
;; · last progress date · lifecycle. A pinned thread that reached a terminal
;; shows TERMINAL so a stale pin is visible rather than silently misleading.

(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def log (or (System/getenv "FRAM_LOG")
             (str (System/getenv "HOME") "/.local/state/north/coordination.log")))

;; Run facts live in a SEPARATE log: the coordinator routes run-scoped subjects
;; (`@run:…`) to telemetry.log by subject token. Folding only coordination.log
;; showed every pinned fish as "no attributed" runs even when its lanes had
;; recorded effort correctly.
(def telemetry-log (or (System/getenv "NORTH_TELEMETRY_LOG")
                       (str (System/getenv "HOME") "/.local/state/north/telemetry.log")))

(when-not (.exists (io/file log))
  (binding [*out* *err*] (println "north pinned: no coordination log at" log))
  (System/exit 2))

(def prio-order {"high" 0 "mid" 1 "low" 2})

;; Fold the log once. Single-valued predicates take the LAST write (supersession);
;; progress accumulates. Reading the log directly keeps this honest even when the
;; projection is stale — the log is the source of truth.
(defn- run-subject? [l]
  (or (str/starts-with? l "run:") (str/starts-with? l "run-")))

(defn- fold-file [init path]
  (if-not (.exists (io/file path))
    init
    (with-open [r (io/reader path)]
      (reduce
     (fn [acc line]
       (let [f (try (edn/read-string line) (catch Exception _ nil))
             retract? (= "retract" (str (:op f)))]
         (if-not (map? f)
           acc
           ;; A retract record carries the RETRACTED value in :r, so folding it as
           ;; an assert re-adopts the value being removed (a retracted priority
           ;; came back as live). But it must still REMOVE — skipping retracts
           ;; outright made `north retract <id> pinned true` a no-op, leaving
           ;; unpinned fish on the board. Retract = removal, never adoption.
           (if retract?
             ;; A retract removes ONE (subject, predicate, value). It must not
             ;; clear a value it does not name — an old retract of a superseded
             ;; priority was wiping the current one.
             (let [l (str/replace (str (:l f)) #"^@" "")
                   v (str (:r f))]
               (case (str (:p f))
                 "pinned"   (if (= v "true") (update acc :pinned disj l) acc)
                 "priority" (if (= v (get (:prio acc) l))
                              (update acc :prio dissoc l) acc)
                 acc))
           (let [l (str/replace (str (:l f)) #"^@" "")
                 p (str (:p f))
                 v (str (:r f))]
             ;; A run's `thread` is written both bare and `@`-prefixed depending
             ;; on the writer; normalise so it joins to the pinned thread key.
             (if (run-subject? l)
               (assoc-in acc [:run l p] (if (= p "thread") (str/replace v #"^@" "") v))
               (case p
               ;; :ever records that this thread was pinned AT SOME POINT. A retract
               ;; removes it from :pinned but never from :ever — closing a fish is
               ;; how the board is supposed to shrink, and losing the fact that it
               ;; was ever a fish would make the closed work unfindable.
               "pinned"   (if (= v "true")
                            (-> acc (update :pinned conj l) (update :ever conj l))
                            (update acc :pinned disj l))
               "priority" (assoc-in acc [:prio l] v)
               "title"    (assoc-in acc [:title l] v)
               "progress" (-> acc (update-in [:prog l] (fnil inc 0)) (assoc-in [:last l] (subs (str (:ts f)) 0 10)))
               ("outcome" "abandoned" "superseded_by")
               (-> acc (assoc-in [:term l] p) (assoc-in [:termtext l] v))
               "part_of"  (update-in acc [:kids (str/replace v #"^@" "")] (fnil inc 0))
               acc)))))))
       init
       (line-seq r)))))

(defn fold []
  (-> {:pinned #{} :ever #{} :prio {} :title {} :prog {} :last {} :term {} :termtext {} :kids {} :run {}}
      (fold-file log)
      (fold-file telemetry-log)))

(defn- num* [v] (or (try (Long/parseLong (str v)) (catch Exception _ nil)) 0))

(defn- human-ms [ms]
  (let [sec (quot ms 1000) h (quot sec 3600) m (quot (rem sec 3600) 60)]
    (cond (>= h 1) (format "%dh%02dm" h m)
          (>= m 1) (format "%dm" m)
          (pos? sec) (format "%ds" sec)
          :else "—")))

(defn- human-n [n]
  (cond (>= n 1000000) (format "%.1fM" (/ n 1e6))
        (>= n 1000)    (format "%.1fk" (/ n 1e3))
        (pos? n)       (str n)
        :else          "—"))

(let [{:keys [pinned ever prio title prog last term termtext kids run]} (fold)
      ;; Effort per fish, from the run ledger. A fish with no attributed runs
      ;; shows a dash rather than a zero — "never measured" and "measured as
      ;; nothing" are different claims and must not look identical.
      effort (reduce (fn [m r]
                       (let [t (get r "thread")]
                         (if (or (nil? t) (= t "(ad-hoc)"))
                           m
                           (-> m
                               (update-in [t :runs] (fnil inc 0))
                               (update-in [t :ms] (fnil + 0) (num* (get r "duration_ms")))
                               (update-in [t :tok] (fnil + 0)
                                          (+ (num* (get r "input_tokens"))
                                             (num* (get r "output_tokens"))))))))
                     {} (vals run))
      ;; --all also shows fish that were pinned and have since CLOSED. Closing is
      ;; how this board is meant to shrink, so the default view showing fewer fish
      ;; is the system working — but "what did we close, and why" had no view at
      ;; all, which made a shrinking board look like lost work rather than
      ;; finished work. Closed fish are rendered with their recorded outcome, never
      ;; re-pinned: a terminal thread on the open board would misreport what is
      ;; open, and this board's whole job is to answer that question honestly.
      show-all? (= "--all" (first *command-line-args*))
      closed (sort-by (fn [t] [(get prio-order (get prio t) 9) t])
                      (filter #(and (get term %) (not (contains? pinned %))) ever))
      rows (sort-by (fn [t] [(get prio-order (get prio t) 9) (- (get kids t 0))]) pinned)]
  (if (empty? rows)
    (println "No pinned threads. Pin one:  north tell <id> pinned true")
    (do
      (printf "PINNED — %d big fish%n%n" (count rows))
      (doseq [t rows]
        (let [state (if-let [x (get term t)] (str/upper-case x) "open")
              flag  (if (get term t) " ← stale pin?" "")]
          (printf "  [%-4s] %-52s%n" (or (get prio t) "-") (subs (str (get title t "?")) 0 (min 52 (count (str (get title t "?"))))))
          (printf "         %s  ·  %d children  ·  %d progress  ·  last %s  ·  %s%s%n"
                  t (get kids t 0) (get prog t 0) (or (get last t) "—") state flag)
          (let [e (get effort t)]
            (printf "         effort: %s agent time · %s tokens · %s runs%n%n"
                    (human-ms (:ms e 0)) (human-n (:tok e 0))
                    (if (:runs e) (str (:runs e)) "no attributed")))))
      (when (and show-all? (seq closed))
        (printf "CLOSED — %d fish resolved and unpinned%n%n" (count closed))
        (doseq [t closed]
          (let [txt (str (get termtext t ""))]
            (printf "  [%-4s] %-52s%n" (or (get prio t) "-")
                    (subs (str (get title t "?")) 0 (min 52 (count (str (get title t "?"))))))
            (printf "         %s  ·  %d children  ·  %s%n" t (get kids t 0)
                    (str/upper-case (str (get term t))))
            (printf "         %s%n%n" (subs txt 0 (min 72 (count txt))))))
        (printf "%d open · %d closed · %d ever pinned%n%n"
                (count rows) (count closed) (count ever)))
      (printf "Pin:    north tell <id> pinned true   ·   north tell <id> priority high|mid|low%n")
      (printf "Unpin:  north retract <id> pinned true%n")
      (when-not show-all?
        (printf "Closed: north-pinned --all   (adds every fish that was pinned and has since resolved)%n")))))
