#!/usr/bin/env bash
set -euo pipefail
class=
if [ -z "${DEPBOX_ADMITTED:-}" ]; then class=$(north capacity gate --class depbox "$@" 2>/dev/null) || class=; fi
if [ -n "$class" ]; then
  DEPBOX_ADMITTED=1 exec north capacity host run --class "$class" --owner "gate:${NORTH_FLEET_SESSION:-${PWD##*/}}" --timeout-seconds 3600 -- "$0" "$@"
fi
read -r host_pid _ </proc/self/stat
if [ "$host_pid" != "$$" ]; then
  exec /run/current-system/sw/bin/unshare --user --map-current-user --pid --fork --kill-child=KILL --mount-proc "$0" "$@"
fi

usage() {
  printf 'usage: depbox fetch|run -- <command> [args...]\n' >&2
  printf '  fetch  network shared, for installs and fetches\n' >&2
  printf '  run    no network, for builds and tests\n' >&2
  exit 2
}

[ "$#" -ge 3 ] || usage
mode=$1
shift
case "$mode" in
  fetch) net=() ;;
  run) net=(--unshare-net) ;;
  *) usage ;;
esac
[ "$1" = "--" ] || usage
shift

bwrap=$(command -v bwrap) || { printf 'depbox: bwrap not found on PATH\n' >&2; exit 1; }
top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf 'depbox: run inside a git checkout\n' >&2; exit 2; }
top=$(realpath "$top")
home=$(realpath "$HOME")
case "$top" in
  / | "$home") printf 'depbox: refusing to expose %s\n' "$top" >&2; exit 2 ;;
esac
common=$(realpath "$(git rev-parse --git-common-dir)")
uid=$(id -u)

root_shell() {
  local roots=$home/.local/state/depbox/shell-roots key
  [ -f "$top/flake.nix" ] && [ -f "$top/flake.lock" ] && command -v nix >/dev/null || return 0
  key=$(git -C "$top" ls-files -z -- '*.nix' flake.lock 'rust-toolchain*' | (cd "$top" && xargs -0 cat 2>/dev/null) | sha256sum | cut -c1-16)
  mkdir -p "$roots"
  find "$roots" -maxdepth 1 \( -type l -o -name '*.lock' \) -mtime +7 -delete
  find "$roots" -maxdepth 1 -type l -lname /dev/null -mtime +0 -delete
  if [ ! -e "$roots/$key" ]; then
    rm -f "$roots/$key" "$roots/$key"-*-link
    nix print-dev-env "$top" --no-update-lock-file --profile "$roots/$key" >/dev/null || { printf 'depbox: no dev shell to root\n' >&2; ln -sn /dev/null "$roots/$key"; }
  fi
  [ "$(readlink "$roots/$key")" = /dev/null ] || touch -h "$roots/$key"*
}
root_shell || true

args=(
  --ro-bind / /
  --dev /dev
  --proc /proc
  --tmpfs /tmp
  --tmpfs "/run/user/$uid"
  --tmpfs "$home"
)
if [ -d /run/secrets.d ]; then args+=(--tmpfs /run/secrets.d); fi
if [ "$HOME" != "$home" ]; then args+=(--tmpfs "$HOME"); fi

for dir in .bun/install/cache .cargo/registry .cargo/git .cache/nix; do
  mkdir -p "$home/$dir"
  args+=(--bind "$home/$dir" "$home/$dir")
done
for path in .cargo/bin .rustup .gitconfig .config/git .nix-profile .local/bin .local/state/nix/profile .local/state/nix/profiles .local/lib/firn/cli code/nixos-config/pins code/north/pins; do
  if [ -e "$home/$path" ]; then args+=(--ro-bind "$home/$path" "$home/$path"); fi
done

target=$top/target
if [ -n "${CARGO_TARGET_DIR:-}" ] && [ "$(realpath -m "$CARGO_TARGET_DIR")" != "$target" ]; then
  printf 'depbox: ignoring CARGO_TARGET_DIR %s; building in %s\n' "$CARGO_TARGET_DIR" "$target" >&2
fi

args+=(--bind "$top" "$top" --ro-bind "$common" "$common")
args+=(--unshare-pid --unshare-ipc "${net[@]}" --die-with-parent --new-session --clearenv)
for var in PATH HOME USER LANG TERM CARGO_BUILD_JOBS RUST_TEST_THREADS AGENT_CAPACITY_LEASE NIX_PATH SSL_CERT_FILE SSL_CERT_DIR NIX_SSL_CERT_FILE CURL_CA_BUNDLE GIT_SSL_CAINFO; do
  if [ -n "${!var:-}" ]; then args+=(--setenv "$var" "${!var}"); fi
done
args+=(--setenv CARGO_TARGET_DIR "$target")
args+=(--chdir "$PWD")

exec "$bwrap" "${args[@]}" -- "$@"
