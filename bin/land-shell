#!/usr/bin/env bash
set -euo pipefail
dev=0
[ "${1:-}" != --dev ] || { dev=1; shift; }
[ "${1:-}" = -- ] || { printf 'usage: land-shell [--dev] -- COMMAND...\n' >&2; exit 2; }
shift
if [ "${GITHUB_ACTIONS:-}" = true ]; then exec "$@"; fi
depbox=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/depbox
[ "$dev" -eq 1 ] || exec "$depbox" run -- "$@"
north=$(command -v north) || north=
[ -z "$north" ] || [ -z "${DEPBOX:-}" ] || exec "$north" dev-shell run -- "$@"
if [ -n "$north" ] && "$north" dev-shell run --prepare; then exec "$depbox" run -- "$north" dev-shell run -- "$@"; fi
exec "$depbox" run -- nix develop --offline --no-update-lock-file -c "$@"
