#!/usr/bin/env python3
"""laptop open|close|drain|toggle|status|tick: the laptop's placement availability, one state on the ledger host.

open [until HH:MM] [REASON...]   available: laptop-runner takes laptop and pool jobs
close [until HH:MM] [REASON...]  draining with a 2-minute grace, then unavailable
drain [until HH:MM] [REASON...]  draining with a 15-minute grace, then unavailable
toggle                           close when available, else open
status [--json]                  one line: state, since, until, reason, by, running and queued laptop jobs
tick                             the window timer: apply window edges and expired words, settle draining
observe JSON                     apply gaming, GPU, seat-idle, sleep and low-battery observations from laptop-auto

A word holds until its `until`, else until the next window edge. Draining becomes unavailable once no laptop job
is running. Where ~/.config/threads/remote names the ledger host, every command runs there over ssh."""

import fcntl
import json
import os
import shlex
import socket
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/lib"))
from ssh_transport import ssh_argv
from defaults import DEFAULTS

GRACE = {"close": 120, "drain": 900}
STATE = Path(os.environ.get("LAPTOP_STATE") or Path.home() / ".local/state/placement/laptop.json")
WINDOW = Path(os.environ.get("LAPTOP_WINDOW_FILE") or "/etc/placement/laptop-window.json")
REMOTE = Path.home() / ".config/threads/remote"
FORWARD_ENV = ("LAPTOP_GRACE", "LAPTOP_BY")


def die(msg, code=2):
    print(f"laptop: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    at = os.environ.get("LAPTOP_NOW")
    return datetime.fromisoformat(at).astimezone(timezone.utc) if at else datetime.now(timezone.utc)


def iso(t):
    return t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse(t):
    return datetime.fromisoformat(t.replace("Z", "+00:00"))


def window():
    try:
        w = json.loads(WINDOW.read_text())
    except (OSError, ValueError):
        w = {}
    tz = ZoneInfo(w["tz"]) if w.get("tz") else datetime.now().astimezone().tzinfo
    return tz, w.get("open"), w.get("close")


def at_today(t, hhmm, tz):
    h, m = map(int, hhmm.split(":"))
    local = t.astimezone(tz)
    return local.replace(hour=h, minute=m, second=0, microsecond=0)


def last_edge(t):
    tz, opens, closes = window()
    if not (opens and closes):
        return None, None
    edges = []
    for hhmm, target in ((opens, "available"), (closes, "unavailable")):
        e = at_today(t, hhmm, tz)
        if e > t:
            e -= timedelta(days=1)
        edges.append((e, target))
    return max(edges)


def until_at(hhmm, t):
    tz = window()[0]
    try:
        u = at_today(t, hhmm, tz)
    except ValueError:
        die(f"until wants HH:MM, got {hhmm}")
    return u if u > t else u + timedelta(days=1)


def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return None


def threads(*args, check=False):
    cmd = shlex.split(os.environ.get("LAPTOP_THREADS", "threads")) + list(args)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None if not check else die(f"threads {args[0]} failed: {e}", 1)
    return r.stdout if r.returncode == 0 else None


def note_item():
    if os.environ.get("LAPTOP_NOTE_ITEM"):
        return os.environ["LAPTOP_NOTE_ITEM"]
    path = STATE.with_name("ledger-item")
    try:
        return path.read_text().strip()
    except OSError:
        pass
    out = threads("new", "ops", "Laptop availability")
    if not out:
        return None
    path.write_text(out.strip() + "\n")
    return out.strip()


def write(state, t, reason, by, until=None, grace=None):
    s = {"state": state, "since": iso(t), "reason": reason, "by": by}
    if until:
        s["until"] = iso(until)
    if grace is not None:
        s["grace"] = grace
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(s) + "\n")
    os.replace(tmp, STATE)
    item = note_item()
    if item is None or threads("note", item, f"laptop: {describe(s)}") is None:
        print("laptop: ledger note failed; the state is written", file=sys.stderr)
    return s


def hhmm(t):
    return parse(t).astimezone(window()[0]).strftime("%H:%M")


def describe(s):
    out = f"{s['state']} since {hhmm(s['since'])}"
    if s.get("until"):
        out += f" until {hhmm(s['until'])}"
    return out + f", {s['reason']} by {s['by']}"


def jobs():
    out = threads("queue", "--json")
    try:
        rows = json.loads(out) if out else None
    except ValueError:
        rows = None
    if rows is None:
        return None, None
    me = socket.gethostname()
    running = sum(1 for r in rows if r["state"] == "taken"
                  and (r["placement"] == "laptop" or (r.get("host") and r["host"] != me)))
    queued = sum(1 for r in rows if r["state"] in ("queued", "requeued") and r["placement"] == "laptop")
    return running, queued


def deadline(s):
    if s["state"] == "draining":
        return parse(s["since"]) + timedelta(seconds=s.get("grace", GRACE["drain"]))
    if s["state"] == "unavailable":
        return parse(s["since"]) + timedelta(seconds=s.get("grace", 0))
    return None


def word(verb, args):
    t = now()
    until = None
    if args[:1] == ["until"]:
        if len(args) < 2:
            die("until wants HH:MM")
        until = until_at(args[1], t)
        args = args[2:]
    s = load()
    if verb == "toggle":
        verb = "close" if s and s["state"] == "available" else "open"
    reason = " ".join(args) or verb
    by = os.environ.get("LAPTOP_BY") or f"{os.environ.get('USER', 'unknown')}@{socket.gethostname()}"
    if verb == "open":
        s = write("available", t, reason, by, until)
    else:
        grace = int(os.environ.get("LAPTOP_GRACE") or GRACE[verb])
        if s and s["state"] == "unavailable":
            s = write("unavailable", t, reason, by, until)
        else:
            s = write("draining", t, reason, by, until, grace)
    print(f"laptop: {describe(s)}")


def tick():
    t = now()
    s = load()
    edge, target = last_edge(t)
    expired = s and s.get("until") and parse(s["until"]) <= t
    stale = s is None or (not s.get("until") and edge is not None and parse(s["since"]) < edge)
    if (expired or stale) and not (s and s["by"] in ("laptop-auto", "laptop tick") and s["reason"] in ("gaming", "sleep", "battery", "drained (battery)")):
        if target is None:
            target = "unavailable"
        if target == "available":
            if not s or s["state"] != "available" or s.get("until"):
                s = write("available", t, "window", "window")
        elif s and s["state"] == "available":
            s = write("draining", t, "window", "window", grace=int(os.environ.get("LAPTOP_GRACE") or GRACE["drain"]))
        elif not s or s.get("until"):
            s = write(s["state"] if s else "unavailable", t, "window", "window", grace=s.get("grace") if s else None)
    if s["state"] == "draining":
        running, _ = jobs()
        if running == 0:
            u = parse(s["until"]) if s.get("until") else None
            s = write("unavailable", t, f"drained ({s['reason']})", "laptop tick", u)
    print(f"laptop: {describe(s)}")


def status(args):
    s = load()
    if args == ["--json"]:
        if s is None:
            s = {"state": "unavailable", "since": iso(now()), "reason": "no state", "by": "-"}
        d = deadline(s)
        print(json.dumps({**s, **({"deadline": int(d.timestamp())} if d else {})}))
        return
    if args:
        die("status takes only --json")
    if s is None:
        print("laptop: no state yet (unavailable)")
        return
    running, queued = jobs()
    counts = "ledger unreachable" if running is None else f"{running} running, {queued} queued"
    print(f"laptop: {describe(s)} ({counts})")


def observe(args):
    try:
        sample = json.loads(args[0]) if len(args) == 1 else None
        if not isinstance(sample, dict) or any(type(sample.get(k)) is not bool for k in ("gaming", "agent_gpu", "sleeping", "battery_low")):
            raise ValueError()
        if sample.get("idle") is not None and type(sample["idle"]) is not bool:
            raise ValueError()
        gpu = sample.get("gpu_busy")
        if gpu is not None and (type(gpu) is not int or not 0 <= gpu <= 100):
            raise ValueError()
    except (ValueError, TypeError):
        die("observe wants gaming/agent_gpu/sleeping/battery_low booleans, idle boolean or null, gpu_busy integer 0..100 or null")
    t = now()
    path = STATE.with_name(STATE.stem + "-observations.json")
    try:
        previous = json.loads(path.read_text())
        if not 0 <= (t - parse(previous["at"])).total_seconds() <= 120:
            previous = {}
    except (OSError, ValueError, KeyError):
        previous = {}
    observations = {"at": iso(t)}
    for key, active in (("gpu", gpu is not None and gpu >= 40 and not sample["agent_gpu"]),
                        ("active", sample.get("idle") is False), ("idle", sample.get("idle") is True)):
        if active:
            observations[key] = previous.get(key, iso(t))
    gaming = sample["gaming"] or ("gpu" in observations and (t - parse(observations["gpu"])).total_seconds() >= 180)
    if not gaming:
        observations["clear"] = previous.get("clear", iso(t))
    s = load()
    hold = "gaming" if gaming else "sleep" if sample["sleeping"] and s and (s["state"] == "available" or s["reason"] == "sleep") else "battery" if sample["battery_low"] else None
    auto = s and (s["by"] in ("laptop-auto", "window") or (s["by"] == "laptop tick" and s["reason"] in ("drained (active)", "drained (battery)", "drained (window)")))
    edge, target = last_edge(t)
    in_window = target == "available"
    if s and (s["state"] == "available" or auto):
        if hold:
            if s["reason"] not in (hold, f"drained ({hold})") or not auto:
                s = write("draining" if hold == "battery" else "unavailable", t, hold, "laptop-auto", parse(s["until"]) if s.get("until") else None, GRACE["drain" if hold == "battery" else "close"])
        elif auto and s["reason"] in ("gaming", "sleep", "battery", "drained (battery)"):
            if ((t - parse(observations["clear"])).total_seconds() >= 600) if s["reason"] == "gaming" else s["reason"] == "sleep" or sample.get("battery") is None:
                s = write("available" if in_window or s.get("until", "") > iso(t) else "unavailable", t, "window", "laptop-auto", parse(s["until"]) if s.get("until", "") > iso(t) else None)
        elif (in_window or auto) and "active" in observations and (t - max(parse(observations["active"]), edge or t - timedelta(days=1))).total_seconds() >= 300:
            if s["state"] == "available":
                s = write("draining", t, "active", "laptop-auto", grace=GRACE["drain"])
        elif auto and sample.get("battery") is None and "idle" in observations and (t - parse(observations["idle"])).total_seconds() >= DEFAULTS["laptop_idle_reopen_sec"]:
            if s["state"] != "available":
                s = write("available", t, "idle", "laptop-auto")
    tmp = path.with_suffix(f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(observations) + "\n")
    os.replace(tmp, path)
    if s:
        print(f"laptop: {describe(s)}")


def forward(argv):
    dest = REMOTE.read_text().strip()
    env = [f"{k}={os.environ[k]}" for k in FORWARD_ENV if os.environ.get(k)]
    if not any(e.startswith("LAPTOP_BY=") for e in env):
        env.append(f"LAPTOP_BY={os.environ.get('USER', 'unknown')}@{socket.gethostname()}")
    try:
        r = subprocess.run(ssh_argv("-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "LogLevel=QUIET", dest,
                                    shlex.join(["env", *env, "laptop", *argv])), timeout=90)
    except subprocess.TimeoutExpired:
        die(f"{dest} timed out; remote outcome unknown", code=124)
    sys.exit(r.returncode)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if REMOTE.exists() and not os.environ.get("THREADS_DB"):
        forward(argv)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    lock = STATE.with_suffix(".lock").open("a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    verb, args = argv[0], argv[1:]
    if verb in ("open", "close", "drain", "toggle"):
        if verb == "toggle" and args:
            die("toggle takes no arguments")
        word(verb, args)
    elif verb == "status":
        status(args)
    elif verb == "tick" and not args:
        tick()
    elif verb == "observe":
        observe(args)
    else:
        die(f"unknown command {verb}; see laptop --help")


if __name__ == "__main__":
    main(sys.argv[1:])
