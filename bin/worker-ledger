#!/usr/bin/env bash
# worker-ledger: a running Claude Code or Codex worker holds its brief's issue in
# NorthThreads; a finished one releases it and is recorded as a run
# (issue ref, follows and category from its brief; tier, ETA vs actual
# minutes, output tokens, peak context, outcome), and a
# category x tier summary of runs.
set -uo pipefail

operator_dir() {
  if [ -n "${AGENTS_OPERATOR_DIR:-}" ]; then printf '%s\n' "$AGENTS_OPERATOR_DIR"
  else printf '%s\n' "$HOME/code/south/main/agents"
  fi
}

usage() {
  cat >&2 <<'EOF'
usage: worker-ledger [--session ID] [--since DATE] [--backfill]   record finished workers as runs in NorthThreads
       worker-ledger --summary [--since DATE] [--by LIST]         per cell x tier: runs against ETA, issues closed, flaws per Lens
       worker-ledger --recommend [--planner] 'FACETS' [--since DATE]          tier for a brief's facets, with the cell used and n
  --session ID  only that session's workers (default: every provider, active in the last day)
  --since DATE  only workers active on or after DATE (e.g. 2026-10-08)
  --backfill    also reread recorded runs and fill facets and context telemetry
  --by LIST     group by a comma list of category, spec, scope, surface, verify, arm (default category)
Summary measures workers, Fleet parents and proxy by category: peak_ctx_p50/p90,
compactions/run, handoff_fires, cache_read_share and idle_gap_misses. Leadership has no worker success/ETA cells.
Claude workers count transcript hook attachments. handoff_ignored counts fires without a HANDOFF message or Done:/Not done: report in the next three assistant turns.
A running worker whose brief names `Item:` holds that issue until it finishes.
Each recording run ends with harness/lib/recalibrate.py: `threads calibrate --write` on the ledger host (no
~/.config/threads/remote) when the newest calibration row is over calibrate_after_min old, and, on the host with the
Codex rollouts, `defaults-measure.py --priors` recorded as kind prior rows once a week from Monday 00:00Z.
One adapter per provider reads its local session store into the same rows: Claude Code transcripts, Codex
rollouts (${CODEX_CONFIG_DIR}) and Gemini print-mode runs of agy (${AGY_CONFIG_DIR:-~/.gemini/antigravity-cli}:
model from its run log, parent Claude session from its workspace). A Grok adapter is one more block.
Codex runs take Item, ETA and Category from their launch prompt in the Fleet transcript, then fall back to issue evidence in commits and commands.
A brief read by the worker in a plaintext tool call also supplies Item, Category and explicit facets; conflicting briefs require a declared Lane matching the working directory or Item matching its recorded Item.
Category then falls back to the issue labels; its tier comes from the Codex thread store, and a Fleet parent
(a thread that spawned agents) is measured separately from worker success/ETA cells.
Each run also records stage times from its transcript and git: staffed (spawned), review requested (first
report back) and landed (its commit's time on origin/main after its first commit; runs that committed are reread
for 3 days until it lands).
The worker-ledger timer runs it every 15 minutes for every provider.
Briefs carry `Item: <repo#N>`, `Follows: <agent id>`, `Category: <name>`, optional `Arm: escalate|cheap-fix|split`, the facets
`Spec: exact|measured|judged`, `Scope: one-file|module|cross-module|cross-repo`,
`Surface: ts|lua|nix|shell|workflow|docs|assets`, `Verify: none|local-test|farm|native|visual`, and for adversarial
reviewers `Lens: <lens>`; a reviewer report stating `Accepted flaws: N` counts N for its lens.
A run reporting `Split:` counts in no tier rate; the runs whose `Follows:` names it are its parts.
A run succeeds when it reports Done (ruled out included) with no later Follows: run, and landed when it made
a commit (a git commit or push in its transcript), where a commit counts as landed when it, or one with
its subject (from -m, a -F - heredoc, or its lane's origin/main.. listing), is on origin/main of a repo in
${LEDGER_REPOS:-~/code/*/main}, whoever pushed it; no_landing counts committed runs that did not land.
A `[routine:<name>]` brief records role routine and a session run from a /tmp cwd role probe, outside worker cells.
--recommend uses an 80% measured success threshold over every provider's tiers (orchestration.toml keys); in the finest cell with >= 5 runs,
backing off Surface, Verify, Scope, then Spec, it picks the passing tier with the lowest measured $ per success, or the cheapest by
tier order when a passing tier has under 5 priced runs, and prints the rule; a dearer passing tier replaces a cell's last pick only when 15 points better.
When no tier passes, it picks the sampled tier with the lowest measured $ per success, or prints insufficient evidence when none has measured costs.
Runs live on Nexus through NorthThreads; the local read-only mirror is ~/.local/state/threads/snapshot.db.
Summary includes delivery medians by model/effort/fast and project. Costs allocate included weekly
account spend over readout intervals by each request's list price (model-catalog.toml); a model without
a price falls back to token weight and is named in threads ingest's output.
EOF
  exit 2
}

session="" since="" summary=0 by="category" facets="" backfill=0 planner=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session) [ $# -ge 2 ] || usage; session=$2; shift 2 ;;
    --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
    --summary) summary=1; shift ;;
    --by) [ $# -ge 2 ] || usage; by=$2; shift 2 ;;
    --recommend)
      if [ "${2:-}" = --planner ]; then planner=1; shift; fi
      [ $# -ge 2 ] || usage; facets=$2; shift 2 ;;
    --planner) planner=1; shift ;;
    --backfill) backfill=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done
[ "$planner" -eq 0 ] || [ -n "$facets" ] || usage

threads="$(dirname "$(readlink -f "$0")")/threads"
LEDGER_CONTEXT_PY="$(dirname "$(readlink -f "$0")")/../harness/lib/ledger_context.py"
export LEDGER_CONTEXT_PY

# Per transcript: whether it made a commit (expects_landing), and whether a push succeeded or a commit of its (by hash or subject)
# is on a repo's origin/main in $LEDGER_MAIN (landed). Shared by the Codex and agy readers.
export LEDGER_CHECKS_PY='
import json, os, re
LAND = re.compile(r"\b(safe-push|git push)\b")
COMMIT = re.compile(r"\bgit\b[^|;&\n]*?\scommit\b|(?:^|[;&|(\n])\s*\$\{?\w+\}?\s+commit\b")
SUBJECT = re.compile(r"\s-[a-zA-Z]*m[ =]?\s*(?:\"\$\(cat <<-?[\x27\"]?\w+[\x27\"]?\s*\n)?[\"\x27]?([^\"\x27\n]+)")
HEREDOC = re.compile(r"\s-F\s*-\s*<<-?[\x27\"]?\w+[\x27\"]?[^\n]*\n([^\n]+)")
LANE = re.compile(r"^([0-9a-f]{7,40}) (.+)$", re.M)
MADE = re.compile(r"^\[[^\]\s]+(?: \([^)]*\))? ([0-9a-f]{7,40})\] (.+)$", re.M)
ISSUE = re.compile(r"\b(?:tompassarelli/)?([a-z][\w.-]*#\d+)\b")
GH_ISSUE = re.compile(r"\bgh issue (?:view|close|comment|edit|reopen) (\d+)\b.*?(?:-R|--repo)[ =](?:[\w-]+/)?([\w.-]+)")
def main_index():
    """{sha: commit date} and {subject: [(sha, date)]} on origin/main of every repo."""
    shas, subjects = {}, {}
    try:
        for line in open(os.environ.get("LEDGER_MAIN") or os.devnull):
            sha, date, subject = (line.rstrip("\n").split(" ", 2) + ["", ""])[:3]
            shas[sha] = date
            subjects.setdefault(subject.strip(), []).append((sha, date))
    except OSError:
        pass
    return shas, subjects
def utc(ts):
    from datetime import datetime, timezone
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if ts else None
def tally(steps):
    """steps: (command, exit code or None, is_edit[, output[, finished at]]) in order. Returns
    landing, when its commit reached origin/main, and issue refs its commits and issue commands name."""
    landed, committed, first_commit = 0, 0, None
    made_shas, made_subjects, refs = set(), set(), []
    for cmd, code, edit, *rest in steps:
        if not cmd:
            continue
        if LAND.search(cmd) and code == 0:
            landed = 1
        m = COMMIT.search(cmd)
        if m and not code:
            committed = 1
            first_commit = first_commit or (rest[1] if len(rest) > 1 else None)
            refs += ISSUE.findall(cmd[m.end():])
            s = SUBJECT.search(cmd, m.end()) or HEREDOC.search(cmd, m.end())
            if s:
                made_subjects.add(s.group(1).strip())
            for sha, subject in MADE.findall(str(rest[0]) if rest else ""):
                made_shas.add(sha)
                made_subjects.add(subject.strip())
        elif committed and code == 0 and "origin/main.." in cmd and rest:
            made_subjects.update(subject.strip() for _, subject in LANE.findall(str(rest[0])))
        elif code == 0 and re.match(r"\s*(?:\S+/)?threads (?:show|claim|release) ", cmd):
            refs += ISSUE.findall(cmd)
        if code == 0:
            refs += [f"{repo}#{n}" for n, repo in GH_ISSUE.findall(cmd)]
    shas, subjects = main_index()
    on_main = [(s, utc(d)) for s, d in shas.items() if any(s.startswith(p) for p in made_shas)] + [(sha, utc(d)) for s in made_subjects for sha, d in subjects.get(s, [])]
    if first_commit:
        on_main = [(sha, d) for sha, d in on_main if d >= utc(first_commit)[:11]]
    expects_landing = committed | landed
    landed = int(bool(on_main))
    landing = min(on_main, key=lambda pair: (pair[1], pair[0])) if on_main else (None, None)
    ranked = sorted(set(refs), key=lambda r: (-refs.count(r), refs.index(r)))
    return {"landed": landed, "expects_landing": expects_landing,
            "landed_sha": landing[0], "landed_at": landing[1], "refs": ranked}
'

if [ "$summary" -eq 1 ]; then
  exec "$threads" summary --group "$by" ${since:+--since "$since"}
fi
if [ -n "$facets" ]; then
  planner_args=()
  [ "$planner" -eq 0 ] || planner_args+=(--planner)
  exec "$threads" recommend "$facets" "${planner_args[@]}" ${since:+--since "$since"}
fi

# Exit 255: the remote ledger is unreachable; ingest skips recorded runs, so send every row to its spool.
recorded=$("$threads" run-ids) || { [ $? -eq 255 ] || exit 1; }
known=$("$threads" run-ids --settled --ended) || { [ $? -eq 255 ] || exit 1; }
LEDGER_MAIN=$(mktemp "${TMPDIR:-/tmp}/worker-ledger-main.XXXXXX") || exit 1
export LEDGER_MAIN
trap 'rm -f "$LEDGER_MAIN"' EXIT
since_git=${since:-30 days ago}
[[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && since_git="${since}T00:00:00Z"
for repo in ${LEDGER_REPOS:-"$HOME"/code/*/main}; do
  git -C "$repo" -c maintenance.auto=false -c gc.auto=0 log origin/main --since="$since_git" --format='%H %cI %s' 2>/dev/null
done >"$LEDGER_MAIN"
[ "$backfill" -eq 0 ] || known=""
rows=$(north ledger claude-runs --settled <(printf '%s\n' "$known") --recorded <(printf '%s\n' "$recorded") ${session:+--session "$session"} ${since:+--since "$since"}) || exit 1
{
[ -z "$rows" ] || printf '%s\n' "$rows"

# Join plaintext spawn briefs by parent thread and task path; an encrypted
# brief leaves Item to the issue refs its commands name.
python3 - "$session" "$since" <(printf '%s\n' "$known") <(printf '%s\n' "$recorded") <<'PY'
import json, os, re, sqlite3, sys, time
exec(os.environ["LEDGER_CHECKS_PY"])
from datetime import datetime, timezone
from pathlib import Path
exec(Path(os.environ["LEDGER_CONTEXT_PY"]).read_text())

session, since, known, recorded = sys.argv[1:]
known, recorded = ({line.split("\t")[0] for line in Path(p).read_text().splitlines()} for p in (known, recorded))
root = Path(os.environ.get("CODEX_CONFIG_DIR", os.path.expanduser("~/code/north-data/codex-pooled")))
cutoff = datetime.fromisoformat(since.replace("Z", "+00:00")).replace(tzinfo=timezone.utc).timestamp() if since else time.time() - 86400

def records(path):
    try:
        with open(path) as f:
            for line in f:
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue
    except OSError:
        return

def stamp(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()

# Fleet parent messages contain the staffing tier, assignment and ETA needed to reconstruct each run.
def texts(p):
    c = p.get("content", [])
    return c if isinstance(c, str) else "\n".join(v.get("text", "") for v in c if isinstance(v, dict))

paths, models = {}, {}
state = root / "sqlite/state_5.sqlite"
if state.exists():
    db = sqlite3.connect(f"file:{state}?mode=ro", uri=True)
    paths = dict(db.execute("SELECT id, rollout_path FROM threads"))
    models = {i: (m, e) for i, m, e in db.execute("SELECT id, model, reasoning_effort FROM threads")}
    candidates = [p for (p,) in db.execute("SELECT rollout_path FROM threads WHERE updated_at >= ?", (cutoff,))]
    db.close()
else:
    candidates = [p for p in sorted((root / "sessions").glob("*/*/*/rollout-*.jsonl")) if p.stat().st_mtime >= cutoff]
    for path in candidates:
        for r in records(path):
            if r.get("type") == "session_meta":
                paths[r["payload"]["id"]] = str(path)
                break

import runpy
from calibration import ledger_path, open_ledger
brief_contract = runpy.run_path(str(Path(os.environ["LEDGER_CONTEXT_PY"]).resolve().parents[2] / "bin/threads"))
categories_allowed = brief_contract["CATEGORIES"]
facet_fields = {**brief_contract["FACET_FIELD"], "lens": brief_contract["LENS"]}
recorded_items = {}
try:
    with open_ledger(ledger_path()) as db:
        recorded_items = dict(db.execute("SELECT agent, item FROM runs"))
except sqlite3.Error:
    pass

parent_briefs = {}
def briefs(parent):
    if parent in parent_briefs:
        return parent_briefs[parent]
    calls, out = {}, {}
    for r in records(paths.get(parent, "")):
        p = r.get("payload", {})
        if p.get("type") == "function_call" and p.get("name", "").endswith("spawn_agent"):
            try:
                calls[p["call_id"]] = dict(json.loads(p["arguments"]), staffed=r.get("timestamp"))
            except (KeyError, json.JSONDecodeError):
                continue
        if p.get("type") == "function_call_output" and p.get("call_id") in calls:
            try:
                name = json.loads(p["output"])["task_name"]
                out[name] = calls[p["call_id"]]
            except (KeyError, TypeError, json.JSONDecodeError):
                continue
    parent_briefs[parent] = out
    return out

for path in candidates:
    meta, model, effort, brief, report = None, None, None, "", ""
    ended, final, tokens, peak = None, False, 0, 0
    steps, cells, review, lead, staffed, repos = [], {}, None, False, None, set()
    workdirs = set()
    transcript = list(records(path))
    for r in transcript:
        p, kind = r.get("payload", {}), r.get("type")
        if kind == "session_meta" and meta is None:
            meta = p
            workdirs.add(p.get("cwd"))
            source = p.get("source", {})
            spawn = source.get("subagent", {}).get("thread_spawn", {}) if isinstance(source, dict) else {}
            parent = spawn.get("parent_thread_id") or p.get("parent_thread_id")
            if p.get("id") in known or (session and parent != session and p.get("id") != session):
                break
            assignment = (briefs(parent) if parent else {}).get(spawn.get("agent_path") or p.get("agent_path"), {})
            brief = assignment.get("message", "")
            model, effort = assignment.get("model") or models.get(p.get("id"), (None, None))[0], assignment.get("reasoning_effort") or models.get(p.get("id"), (None, None))[1]
            staffed = assignment.get("staffed") or p.get("timestamp")
        if meta is None or r.get("timestamp", "") < meta["timestamp"]:
            continue
        ended = r.get("timestamp") or ended
        if kind == "turn_context":
            model, effort = p.get("model") or model, p.get("effort") or effort
        elif kind == "response_item":
            if p.get("type") == "message" and p.get("role") == "user":
                t = texts(p)
                if re.search(r"\bItem:\s*(?:[\w-]+/)?[\w-]+#\d+", t):
                    brief = t
                final = False
            elif p.get("type") == "message" and p.get("role") == "assistant":
                t = texts(p)
                if re.search(r"\bItem:\s*(?:[\w-]+/)?[\w-]+#\d+", t):
                    brief = t
                final = p.get("phase") == "final"
                if final:
                    report = texts(p)
                    review = review or r.get("timestamp")
            elif p.get("type") in ("function_call", "custom_tool_call"):
                final = False
                lead = lead or p.get("name", "").endswith("spawn_agent")
                args = str(p.get("arguments") or p.get("input") or "")
                for directory in re.findall(r'\bworkdir"?\s*:\s*("(?:[^"\\]|\\.)*")', args):
                    workdirs.add(json.loads(directory))
                if p.get("name") == "apply_patch" or "*** Begin Patch" in args:
                    steps.append(("", None, True))
                repos.update(re.findall(r"/code/([\w.-]+)/(?:main|worktrees)\b", args))
                cmds = []
                for m in re.finditer(r'\bcmd"?\s*:\s*("(?:[^"\\]|\\.)*")', args):
                    try:
                        cmds.append(json.loads(m.group(1)))
                    except ValueError:
                        continue
                cells[p.get("call_id")] = [len(steps) + i for i in range(len(cmds))]
                steps.extend([c, None, False] for c in cmds)
            elif p.get("type") in ("function_call_output", "custom_tool_call_output") and p.get("call_id") in cells:
                codes = [int(c) for c in re.findall(r'exit_code\W+(-?\d+)', json.dumps(p.get("output")))]
                for index, code in zip(cells.pop(p["call_id"]), codes):
                    steps[index][1] = code
                    out = p.get("output")
                    decoded = []
                    for value in out if isinstance(out, list) else [out]:
                        value = value.get("text", value) if isinstance(value, dict) else value
                        try:
                            value = json.loads(value)
                        except (TypeError, ValueError):
                            pass
                        decoded.append(str(value.get("output", "") if isinstance(value, dict) else value))
                    steps[index] += ["\n".join(decoded), r.get("timestamp")]
        elif kind == "event_msg":
            if p.get("type") in ("task_started", "user_message"):
                final = False
            elif p.get("type") == "task_complete":
                final = True
                review = review or r.get("timestamp")
                report = p.get("last_agent_message") or report
            elif p.get("type") == "token_count" and p.get("info"):
                info = p["info"]
                tokens = info.get("total_token_usage", {}).get("output_tokens", tokens)
                peak = max(peak, info.get("last_token_usage", {}).get("input_tokens", 0))
    if not meta or meta["id"] in known or not ended or stamp(ended) < cutoff or not model or not effort:
        continue
    if session and parent != session and meta["id"] != session:
        continue
    role = session_role(meta["id"])
    if not role and meta["id"] not in recorded:
        continue
    eta = re.search(r"(?i)\bETA\b[^0-9\n]{0,12}([0-9]+(?:\.[0-9]+)?)\s*(hours?|hrs?|h|minutes?|mins?|m)\b", brief)
    eta = float(eta[1]) * (60 if eta[2].lower().startswith("h") else 1) if eta else None
    fields = re.findall(r"\b(?:Item|Follows|Category|Arm|Spec|Scope|Surface|Verify|Lens):[^\n]+", brief)
    flaws = re.search(r"(?i)\baccepted flaws?:\s*([0-9]+)", report)
    head = report[:400]
    outcome = "handoff" if "HANDOFF" in head else "split" if re.match(r"\W*split:", head, re.I) else "not done" if re.match(r"\W*(not|partly|mostly|half) done", head, re.I) else "escalated" if re.match(r"\W*blocked", head, re.I) else "done" if re.match(r"\W*done\b", head, re.I) else "unclear"
    name = (spawn.get("agent_path") or meta.get("agent_path") or "").rsplit("/", 1)[-1]
    declared = brief_contract["brief_fields"](brief)
    counts = tally(steps)
    numbers = set(re.findall(r"(?<![0-9])([0-9]{2,5})(?![0-9])", name))
    if len(repos) == 1 and len(numbers) == 1:
        counts["refs"].append(f"{repos.pop()}#{numbers.pop()}")
    row = dict(id=meta["id"], session=parent, brief="\n".join(fields), started=meta["timestamp"],
               ended=ended, tier=f"{model} {effort}", eta_min=eta,
               item=declared.get("item"), category=declared.get("category"),
               status="finished" if final else "running" if time.time() - stamp(ended) < 7200 else "stale",
               actual_min=max(0, int((stamp(ended) - stamp(meta["timestamp"])) / 60)),
               tokens=tokens, role=role, telemetry_only=not role, outcome=outcome, note=None,
               report=re.sub(r"\s+", " ", report[:600]), flaws=int(flaws[1]) if flaws else None,
               backfill=meta["id"] in recorded, staffed=utc(staffed), review_requested=utc(review),
               **counts, **context_metrics(transcript), **run_usage(transcript))
    print(json.dumps(row))
PY

python3 - "$session" "$since" <(printf '%s\n' "$known") <(printf '%s\n' "$recorded") <<'PY'
import json, os, re, sqlite3, sys, time
exec(os.environ["LEDGER_CHECKS_PY"])
from datetime import datetime, timezone
from pathlib import Path
import tomllib
exec(Path(os.environ["LEDGER_CONTEXT_PY"]).read_text())
prices = list_prices(tomllib.load(open(Path(os.environ["LEDGER_CONTEXT_PY"]).resolve().parent.parent / "model-catalog.toml", "rb")))

session, since, known, recorded = sys.argv[1:]
known, recorded = ({line.split("\t")[0] for line in Path(p).read_text().splitlines()} for p in (known, recorded))
root = Path(os.environ.get("AGY_CONFIG_DIR", os.path.expanduser("~/.gemini/antigravity-cli")))
cutoff = datetime.fromisoformat(since.replace("Z", "+00:00")).replace(tzinfo=timezone.utc).timestamp() if since else time.time() - 86400
EFFORTS = ("low", "medium", "high", "xhigh", "max")

def stamp(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()

models = {}
for log in sorted((root / "log").glob("cli-*.log")):
    if log.stat().st_mtime < cutoff:
        continue
    text = log.read_text(errors="replace")
    slug = re.search(r"Print mode: starting \([^)]*model=\"([^\"]+)\"", text)
    for cid in re.findall(r"Created conversation ([0-9a-f-]{36})", text) if slug else []:
        models[cid] = slug[1]
workspaces, finished_at = {}, {}
summaries = root / "conversation_summaries.db"
if summaries.exists():
    db = sqlite3.connect(f"file:{summaries}?mode=ro", uri=True)
    for cid, uris, modified in db.execute("SELECT conversation_id, workspace_uris, last_modified_time FROM conversation_summaries"):
        workspaces[cid] = uris
        finished_at[cid] = utc(re.sub(r"(\.\d{6})\d*", r"\1", modified.replace(" ", "T", 1)).replace(" ", ""))
    db.close()

for cid, slug in models.items():
    path = root / "brain" / cid / ".system_generated/logs/transcript_full.jsonl"
    if cid in known or not path.exists():
        continue
    steps_in = [r for r in (json.loads(l) for l in path.read_text().splitlines() if l.strip()) if isinstance(r, dict)]
    if not steps_in:
        continue
    parent = re.search(r"/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/", workspaces.get(cid, ""))
    parent = parent[1] if parent else None
    if session and parent != session:
        continue
    times = [r["created_at"] for r in steps_in if r.get("created_at")]
    times.append(max(times[-1], finished_at.get(cid) or times[-1]))
    if stamp(times[-1]) < cutoff:
        continue
    inputs = [r for r in steps_in if r.get("type") == "USER_INPUT"]
    answers = [r for r in steps_in if r.get("type") == "PLANNER_RESPONSE"]
    tools = [(None, 1 if r.get("status") == "ERROR" else 0, False, "", r.get("created_at"))
             for r in steps_in if r.get("type") not in ("USER_INPUT", "PLANNER_RESPONSE")]
    brief = re.sub(r"</?USER_REQUEST>", "", str(inputs[0].get("content") or "")) if inputs else ""
    report = str((answers[-1].get("content") if answers else "") or "")
    final = bool(answers) and steps_in[-1] is answers[-1] and answers[-1].get("status") == "DONE"
    model, _, effort = slug.rpartition("-")
    model, effort = (model, effort) if effort in EFFORTS else (slug, "default")
    eta = re.search(r"(?i)\bETA\b[^0-9\n]{0,12}([0-9]+(?:\.[0-9]+)?)\s*(hours?|hrs?|h|minutes?|mins?|m)\b", brief)
    flaws = re.search(r"(?i)\baccepted flaws?:\s*([0-9]+)", report)
    head = report[:400]
    outcome = "handoff" if "HANDOFF" in head else "split" if re.match(r"\W*split:", head, re.I) else "not done" if re.match(r"\W*(not|partly|mostly|half) done", head, re.I) else "escalated" if re.match(r"\W*blocked", head, re.I) else "done" if re.match(r"\W*done\b", head, re.I) else "unclear"
    print(json.dumps(dict(
        id=cid, session=parent, brief="\n".join(re.findall(r"\b(?:Item|Follows|Category|Arm|Spec|Scope|Surface|Verify|Lens):[^\n]+", brief)),
        started=utc(times[0]), ended=utc(times[-1]), tier=f"{model} {effort}",
        account="gemini", model=model, effort=effort, fast=0,
        usage_samples=[dict(request=str(n), ts=r["created_at"], weight=usage_weight(model, r.get("input_tokens") or 0, r.get("cache_write_tokens") or 0,
                                                                    r.get("cache_read_tokens") or 0, r.get("output_tokens") or 0, prices)[0])
                       for n, r in enumerate(answers) if r.get("created_at")],
        unpriced_models=[model] if DEFAULTS["plan_meter_weighting"] == "price" and model not in prices else [],
        eta_min=float(eta[1]) * (60 if eta[2].lower().startswith("h") else 1) if eta else None,
        status="finished" if final else "running" if time.time() - stamp(times[-1]) < 7200 else "stale",
        actual_min=max(0, int((stamp(times[-1]) - stamp(times[0])) / 60)),
        tokens=sum(r.get("output_tokens") or 0 for r in answers),
        peak_ctx=max([(r.get("input_tokens") or 0) + (r.get("cache_read_tokens") or 0) for r in answers] or [0]),
        outcome=outcome, report=re.sub(r"\s+", " ", report[:600]), flaws=int(flaws[1]) if flaws else None,
        backfill=cid in recorded, staffed=utc(times[0]), review_requested=utc(times[-1]) if final else None,
        **tally(tools))))
PY
} | north threads ingest
rc=$?
python3 "$(dirname "$(readlink -f "$0")")/../harness/lib/recalibrate.py"
exit "$rc"
