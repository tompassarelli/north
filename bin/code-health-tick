#!/usr/bin/env bash
set -euo pipefail
command -v bun >/dev/null 2>&1 || [ -z "${HOME:-}" ] || PATH="$HOME/.nix-profile/bin:$PATH"
command -v bun >/dev/null 2>&1 || { echo "code-health-tick: bun not found" >&2; exit 2; }
exec bun --no-install "$(dirname "$(readlink -f "$0")")/../harness/code-health/tick.ts" "$@"
