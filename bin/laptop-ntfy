#!/usr/bin/env python3
"""laptop-ntfy serve|notify|press: phone signals for the laptop availability state.

serve         HTTP endpoint the ntfy Open/Close buttons call: POST /laptop/open or /laptop/close with the action bearer token
notify        publish the state with Open/Close buttons when it changed, and once a day at the window's open edge
press VERB    run laptop VERB as the phone would, then notify

Environment: LAPTOP_NTFY_URL, LAPTOP_NTFY_TOPIC, LAPTOP_NTFY_TOKEN_FILE (publisher), LAPTOP_NTFY_ACTION_TOKEN_FILE,
LAPTOP_NTFY_ACTION_URL (what the buttons call), LAPTOP_NTFY_LISTEN (host:port), LAPTOP_NTFY_STATE (directory),
LAPTOP_WINDOW_FILE, LAPTOP_NOW. The laptop command is found on PATH."""

import hmac
import json
import os
import subprocess
import sys
import urllib.request
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from zoneinfo import ZoneInfo

NTFY_URL = os.environ.get("LAPTOP_NTFY_URL", "http://10.77.0.1:2586")
TOPIC = os.environ.get("LAPTOP_NTFY_TOPIC", "socrates-laptop")
TOKEN_FILE = os.environ.get("LAPTOP_NTFY_TOKEN_FILE", "")
ACTION_TOKEN_FILE = os.environ.get("LAPTOP_NTFY_ACTION_TOKEN_FILE", "")
ACTION_URL = os.environ.get("LAPTOP_NTFY_ACTION_URL", "http://10.77.0.1:2588")
LISTEN = os.environ.get("LAPTOP_NTFY_LISTEN", "10.77.0.1:2588")
STATE_DIR = Path(os.environ.get("LAPTOP_NTFY_STATE") or Path.home() / ".local/state/laptop-ntfy")
WINDOW = Path(os.environ.get("LAPTOP_WINDOW_FILE") or "/etc/placement/laptop-window.json")
REMINDER_SPAN = timedelta(minutes=30)
DEDUP_SPAN = timedelta(minutes=10)
TAGS = {"available": "green_circle", "draining": "orange_circle", "unavailable": "red_circle"}


def die(msg, code=1):
    print(f"laptop-ntfy: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    at = os.environ.get("LAPTOP_NOW")
    return datetime.fromisoformat(at).astimezone(timezone.utc) if at else datetime.now(timezone.utc)


def secret(path):
    try:
        return Path(path).read_text().strip()
    except OSError as e:
        die(f"cannot read {path}: {e}")


def laptop(*args, by=None):
    env = {**os.environ, **({"LAPTOP_BY": by} if by else {})}
    r = subprocess.run(["laptop", *args], capture_output=True, text=True, timeout=60, env=env)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip() or f"laptop {args[0]} exited {r.returncode}")
    return r.stdout.strip()


def window():
    try:
        w = json.loads(WINDOW.read_text())
    except (OSError, ValueError):
        return None, None
    return ZoneInfo(w["tz"]) if w.get("tz") else None, w.get("open")


def local_hhmm(iso, tz):
    t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    return (t.astimezone(tz) if tz else t.astimezone()).strftime("%H:%M")


def load_last():
    try:
        return json.loads((STATE_DIR / "last.json").read_text())
    except (OSError, ValueError):
        return {}


def save_last(last):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_DIR / "last.tmp"
    tmp.write_text(json.dumps(last) + "\n")
    os.replace(tmp, STATE_DIR / "last.json")


def publish(title, message, state):
    token = secret(ACTION_TOKEN_FILE)
    headers = {"Authorization": f"Bearer {token}"}
    actions = [{"action": "http", "label": label, "url": f"{ACTION_URL}/laptop/{verb}", "method": "POST",
                "headers": headers, "clear": True} for label, verb in (("Open", "open"), ("Close", "close"))]
    body = {"topic": TOPIC, "title": title, "message": message, "priority": 3, "tags": [TAGS.get(state, "laptop")],
            "actions": actions}
    req = urllib.request.Request(NTFY_URL, data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": f"Bearer {secret(TOKEN_FILE)}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        r.read()


def describe(s, tz):
    out = f"since {local_hhmm(s['since'], tz)}"
    if s.get("until"):
        out += f" until {local_hhmm(s['until'], tz)}"
    return f"{out}, {s['reason']} by {s['by']}"


def notify():
    t = now()
    s = json.loads(laptop("status", "--json"))
    tz, opens = window()
    last = load_last()
    key = f"{s['state']}|{s['since']}"
    changed = last.get("key") != key
    if changed:
        publish(f"Laptop: {s['state']}", describe(s, tz), s["state"])
        last = {**last, "key": key, "sent": t.isoformat()}
        print(f"laptop-ntfy: sent {s['state']}")
    if tz and opens:
        h, m = map(int, opens.split(":"))
        edge = t.astimezone(tz).replace(hour=h, minute=m, second=0, microsecond=0)
        today = edge.strftime("%Y-%m-%d")
        if edge <= t < edge + REMINDER_SPAN and last.get("reminded") != today:
            sent = datetime.fromisoformat(last["sent"]) if last.get("sent") else None
            if not (sent and t - sent < DEDUP_SPAN):
                publish(f"Laptop window opens {opens}", f"The laptop is {s['state']} {describe(s, tz)}", s["state"])
                print("laptop-ntfy: sent window reminder")
            last["reminded"] = today
    save_last(last)


def press(verb):
    out = laptop(verb, by="ntfy")
    try:
        notify()
    except Exception as e:
        print(f"laptop-ntfy: notify failed: {e}", file=sys.stderr)
    return out


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, text):
        data = (text + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        want = f"Bearer {secret(ACTION_TOKEN_FILE)}"
        if not hmac.compare_digest(self.headers.get("Authorization", "").encode(), want.encode()):
            return self.reply(401, "unauthorized")
        verb = self.path.removeprefix("/laptop/") if self.path.startswith("/laptop/") else ""
        if verb not in ("open", "close"):
            return self.reply(404, "unknown action")
        try:
            self.reply(200, press(verb))
        except Exception as e:
            self.reply(500, f"laptop {verb} failed: {e}")

    def do_GET(self):
        self.reply(405, "POST only")

    def log_message(self, fmt, *args):
        print(f"laptop-ntfy: {self.command} {self.path.split('?')[0]} {args[1] if len(args) > 1 else ''}", flush=True)


def serve():
    host, _, port = LISTEN.rpartition(":")
    ThreadingHTTPServer((host, int(port)), Handler).serve_forever()


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
    elif argv == ["serve"]:
        serve()
    elif argv == ["notify"]:
        notify()
    elif len(argv) == 2 and argv[0] == "press" and argv[1] in ("open", "close"):
        print(press(argv[1]))
    else:
        die("usage: laptop-ntfy serve|notify|press open|close", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
