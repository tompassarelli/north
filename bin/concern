#!/usr/bin/env bash
# concern — concern-level coordination for parallel agents (NOT locks).
# Declare a feature + its footprint; concerns coexist; overlap and likely-to-land
# work are surfaced so agents shape around each other. See cli/concern-cli.clj.
#
# Footprints stay path-based. Configured code stores remain durable-local until
# they have their own explicit FRAMRPC endpoint.
set -euo pipefail
ROOT="${NORTH_HOME:-$(cd "$(dirname "$0")/.." && pwd -P)}"
BOARD="${NORTH_PORT:?concern requires the canonical FRAMRPC port}"
FRAMRPC_OUT="${BEAGLE_STORE_OUT:?concern requires the canonical Beagle Store classpath}"
NORTH_RUNTIME_CLASSPATH="$ROOT/out:$FRAMRPC_OUT"
export NORTH_RUNTIME_CLASSPATH
# See bin/north for the resolution-chain rationale: a promoted deployment's
# exec unit may carry neither bb nor NORTH_BB on PATH.
if [ -n "${NORTH_BB:-}" ]; then
  BB="$NORTH_BB"
elif command -v bb >/dev/null 2>&1; then
  BB="bb"
elif [ -x /run/current-system/sw/bin/bb ]; then
  BB="/run/current-system/sw/bin/bb"
else
  echo "concern: cannot find babashka — tried \$NORTH_BB, PATH, /run/current-system/sw/bin/bb" >&2
  exit 127
fi
args=("$@")
if [ "${1:-}" = "declare" ] &&
   [[ "${NORTH_THREAD_ID:-}" =~ [^[:space:]] ]]; then
  explicit_about=0
  for arg in "${args[@]}"; do
    if [ "$arg" = "--about" ]; then
      explicit_about=1
      break
    fi
  done
  if [ "$explicit_about" -eq 0 ]; then
    thread_id="${NORTH_THREAD_ID#@}"
    args+=(--about "@$thread_id")
  fi
fi

exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$ROOT/cli/concern-cli.clj" "$BOARD" "${args[@]}"
