#!/usr/bin/env bb
;; north effort — where agent time and tokens actually went, per thread.
;;
;; Answers "how much has this workstream cost me" from the run ledger: agent wall
;; time, tokens in/out/cache, run count, and the delivery mix. Folds the
;; coordination and telemetry logs directly, so it stays truthful when the .md
;; projection lags.
;;
;;   north-effort                 all threads, ranked by agent wall time
;;   north-effort <thread-id>     one thread, with its runs itemised
;;   north-effort --live          lanes running RIGHT NOW, and what they are on
;;
;; TWO THINGS THIS DELIBERATELY DOES NOT DO.
;;
;; It never prints money. North runs on subscription entitlements, and
;; cli/routing-report.clj states the standing unit as "observed work, never
;; dollars or API credits". Tokens and wall time are the honest units.
;;
;; It never hides the gap. Runs whose thread is "(ad-hoc)" are reported as an
;; explicit `unattributed` row rather than dropped. Historically that is most of
;; them — `north spawn` had no --thread flag at all, so the effort was spent but
;; unaccountable. A report that quietly omitted them would be the same class of
;; lie as a read that returns empty instead of refusing.

(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

;; TWO LOGS, and reading one is how this tool lied. The coordinator SPLITS its
;; write stream by subject token: run-scoped subjects (`@run:…`, like `@session:`
;; and `@mine:`) route to telemetry.log, while threads and their titles stay in
;; coordination.log. Folding only coordination.log made `north-effort <thread>`
;; answer "no runs attributed" about a thread whose run was recorded correctly —
;; the same class of failure as a read that returns empty instead of refusing.
;; Both are folded; a missing telemetry.log is tolerated, a missing coordination
;; log is not.
(def log (or (System/getenv "FRAM_LOG")
             (str (System/getenv "HOME") "/.local/state/north/coordination.log")))

(def telemetry-log (or (System/getenv "NORTH_TELEMETRY_LOG")
                       (str (System/getenv "HOME") "/.local/state/north/telemetry.log")))

(def AD-HOC "(ad-hoc)")

;; Subjects and thread references are written both bare and `@`-prefixed
;; depending on the writer, so a run can carry `thread @019f…` while the thread
;; itself is keyed `019f…`. Normalise once, at the edge.
(defn- bare [s] (str/replace (str s) #"^@" ""))

(defn- num* [v] (or (try (Long/parseLong (str v)) (catch Exception _ nil)) 0))

(defn- human-ms [ms]
  (let [s (quot ms 1000) h (quot s 3600) m (quot (rem s 3600) 60)]
    (cond (>= h 1) (format "%dh%02dm" h m)
          (>= m 1) (format "%dm%02ds" m (rem s 60))
          :else    (format "%ds" s))))

(defn- human-n [n]
  (cond (>= n 1000000) (format "%.1fM" (/ n 1e6))
        (>= n 1000)    (format "%.1fk" (/ n 1e3))
        :else          (str n)))

;; Fold once. Retract records carry the RETRACTED value in :r — folding them as
;; asserts re-adopts the value being removed, so they are skipped outright.
;; `run:` (colon) is the current id shape — telemetry.ts/newRunId explains why the
;; colon is load-bearing for routing. `run-` (dash) is the pre-2026-07-17 shape
;; whose facts misrouted into coordination.log; those runs are real work and are
;; still folded, so history does not silently vanish at the rename.
(defn- run-subject? [l]
  (or (str/starts-with? l "run:") (str/starts-with? l "run-")))

(defn- fold-file [acc path]
  (if-not (.exists (io/file path))
    acc
    (with-open [r (io/reader path)]
      (reduce
       (fn [acc line]
         (let [f (try (edn/read-string line) (catch Exception _ nil))]
           (if-not (and (map? f) (not= "retract" (str (:op f))))
             acc
             (let [l (bare (:l f))
                   p (str (:p f)) v (str (:r f))]
               (cond
                 (run-subject? l)  (assoc-in acc [:run l p] (if (= p "thread") (bare v) v))
                 ;; The resolved model is NOT in the lane's environment — only
                 ;; AGENT_PROVIDER=auto is, because resolution happens after the
                 ;; process starts. It lands on @agent:<id> instead, so --live
                 ;; joins to it rather than showing a permanent dash.
                 (and (str/starts-with? l "agent:") (= p "model"))
                 (assoc-in acc [:agent-model (subs l 6)] v)
                 (= p "title")     (assoc-in acc [:title l] v)
                 (= p "pinned")    (if (= v "true")
                                     (update acc :pinned conj l)
                                     (update acc :pinned disj l))
                 :else acc)))))
       acc
       (line-seq r)))))

(defn fold []
  (-> {:run {} :title {} :pinned #{} :agent-model {}}
      (fold-file log)
      (fold-file telemetry-log)))

;; A run whose writer was killed mid-publication leaves a REAL subject carrying
;; its thread but no duration or tokens — the terminal write is ~200 sequential
;; coordinator round-trips and the budget could expire partway. Counting those as
;; ordinary runs understates effort per run and hides the outage; counting them
;; as nothing hides the work. They are counted separately and named.
(defn- complete? [r] (pos? (num* (get r "duration_ms"))))

(defn- roll [runs]
  {:runs      (count (filter complete? runs))
   :partial   (count (remove complete? runs))
   :ms        (reduce + (map #(num* (get % "duration_ms")) runs))
   :in        (reduce + (map #(num* (get % "input_tokens")) runs))
   :out       (reduce + (map #(num* (get % "output_tokens")) runs))
   :cache     (reduce + (map #(+ (num* (get % "cache_read_tokens"))
                                 (num* (get % "cache_create_tokens"))) runs))
   :models    (into (sorted-set) (keep #(get % "model") runs))
   :delivered (count (filter #(#{"reported" "verified"} (get % "delivery_outcome")) runs))
   :blocked   (count (filter #(= "blocked" (get % "delivery_outcome")) runs))})

;; LIVE. A run's facts land at terminal, so a lane in flight has nothing in the
;; graph yet — which is exactly when you most want to know what is running. The
;; binding is already on the process: --thread is passed through as AGENT_THREAD,
;; so read it from /proc and join to the thread title. Host-only by nature.
(defn- live-lanes []
  (->> (or (.listFiles (io/file "/proc")) [])
       (filter #(re-matches #"\d+" (.getName %)))
       (keep (fn [d]
               (let [env (try (slurp (io/file d "environ")) (catch Exception _ ""))
                     kv (into {} (keep (fn [e] (let [[k v] (str/split e #"=" 2)]
                                                 (when v [k v])))
                                       (str/split env (re-pattern "\u0000"))))]
                 (when-let [id (get kv "AGENT_ID")]
                   (when (str/starts-with? id "lane-")
                     {:agent id
                      :thread (get kv "AGENT_THREAD")
                      :prov (get kv "AGENT_THREAD_PROVENANCE")
                      :model (get kv "AGENT_MODEL")})))))
       ;; One lane is SEVERAL processes, and they do not all carry the binding: a
       ;; child can inherit AGENT_ID while its routing keys were scrubbed, so a
       ;; last-write-wins merge let a thread-less child erase its own lane's
       ;; thread and every live lane rendered as UNATTRIBUTED. Prefer the richest
       ;; record per agent — a process that knows the thread outranks one that
       ;; does not, and absence never overwrites knowledge.
       (reduce (fn [m l]
                 (let [prior (get m (:agent l))]
                   (if (and prior (:thread prior) (not (:thread l)))
                     m
                     (assoc m (:agent l) (merge prior (into {} (remove (comp nil? val) l)))))))
               {})
       vals))

(let [{:keys [run title pinned agent-model]} (fold)
      [want] *command-line-args*
      by-thread (group-by #(or (get % "thread") AD-HOC) (vals run))
      total-runs (count run)]
  (if (= want "--live")
    (let [lanes (live-lanes)]
      (if (empty? lanes)
        (println "No managed lanes running.")
        (do
          (printf "LIVE — %d lane(s) in flight%n%n" (count lanes))
          (doseq [{:keys [agent thread prov model]} (sort-by :thread lanes)]
            (printf "  %s%n" (if (and thread (not= thread "(ad-hoc)"))
                               (get title thread thread)
                               "UNATTRIBUTED lane"))
            (printf "    %s  ·  %s  ·  thread %s (%s)%n%n"
                    (subs agent 0 (min 34 (count agent)))
                    (or model (get agent-model agent) "resolving")
                    (or thread "—") (or prov "—"))))))
    (if want
    ;; ---- one thread, itemised ------------------------------------------------
    (let [key (first (filter #(str/starts-with? (str %) (str want)) (keys by-thread)))
          runs (get by-thread key)]
      (if-not (seq runs)
        (println (format "no runs attributed to %s%n(if work was done here, it predates --thread binding — see the unattributed row in `north-effort`)" want))
        (let [r (roll runs)]
          (printf "%s%n%s%n%n" (get title key (str key)) key)
          (printf "  %d runs · %s agent wall time%s%n" (:runs r) (human-ms (:ms r))
                  (if (pos? (:partial r))
                    (format "  (+%d partial — terminal write killed, effort unrecorded)" (:partial r))
                    ""))
          (printf "  tokens  in %s · out %s · cache %s%n"
                  (human-n (:in r)) (human-n (:out r)) (human-n (:cache r)))
          (printf "  models  %s%n" (str/join ", " (:models r)))
          (printf "  delivery %d delivered · %d blocked%n%n" (:delivered r) (:blocked r))
          (doseq [x (sort-by #(- (num* (get % "duration_ms"))) runs)]
            (printf "    %-9s %-22s %s%n"
                    (if (complete? x) (human-ms (num* (get x "duration_ms"))) "partial")
                    (or (get x "model") "—")
                    (or (get x "delivery_outcome") (get x "process_outcome")
                        (if (complete? x) "—" "terminal write killed")))))))
    ;; ---- all threads ---------------------------------------------------------
    (let [rows (->> by-thread
                    (map (fn [[k runs]] (assoc (roll runs) :thread k)))
                    (sort-by #(- (:ms %))))]
      (printf "EFFORT — %d runs across %d threads%n%n" total-runs (count rows))
      (printf "  %-9s %-6s %-5s %-9s %-9s  %s%n" "walltime" "runs" "part" "tok-in" "tok-out" "thread")
      (println "  " (apply str (repeat 78 \-)))
      (doseq [{:keys [thread runs partial ms in out]} rows]
        (let [adhoc? (= thread AD-HOC)
              label (if adhoc?
                      "UNATTRIBUTED — ran before/without --thread binding"
                      (subs (str (get title thread thread)) 0
                            (min 46 (count (str (get title thread thread))))))
              pin (if (contains? pinned thread) "*" " ")]
          (printf "  %-9s %-6d %-5s %-9s %-9s %s%s%n"
                  (human-ms ms) runs (if (pos? partial) (str partial) "·")
                  (human-n in) (human-n out) pin label)))
      (let [lost (reduce + (map :partial rows))]
        (println)
        (when (pos? lost)
          (printf "  part = runs whose terminal write was killed mid-publication: %d of %d (%.0f%%)%n"
                  lost total-runs (* 100.0 (/ lost (max 1 total-runs))))
          (println "        their effort was spent and is unrecoverable — the record, not the work, was lost")))
      (println "  * pinned · one thread: north-effort <thread-id> · in flight: north-effort --live")
      (println "  units are observed work — tokens and wall time, never dollars")))))
