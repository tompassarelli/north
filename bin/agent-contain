#!/usr/bin/env python3
"""agent-contain: keep agent-started processes inside agent.slice.

  agent-contain sweep [--dry-run]

A process descended from a claude or codex CLI, or running in a libpod container scope, must sit under
agent.slice. The CLI processes themselves are allowed anywhere. Each other process outside agent.slice is moved
into a transient scope in agent-capacity.slice; a container scope outside agent.slice is frozen, since a cgroup
cannot be re-parented. Every freeze, and the first move out of each cgroup per hour, appends an INCIDENT line to the proxy inbox.

Inputs for tests: AGENT_CONTAIN_PROC (default /proc), AGENT_CONTAIN_CGROUP (default /sys/fs/cgroup),
AGENT_CONTAIN_INBOX (default ~/.local/state/agents/handoffs/proxy-inbox.md), AGENT_CONTAIN_UID (default the
caller's uid), AGENT_CONTAIN_HOST, AGENT_CONTAIN_BUSCTL (default busctl),
AGENT_CONTAIN_STATE (default ~/.local/state/agent-contain/reported.json), and --dry-run, which prints each action without moving or freezing.
"""

import datetime
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

AGENT_COMMS = {"claude", "codex"}
SLICE = "agent-capacity.slice"
REPEAT_SECONDS = 3600


def env_path(name, default):
    return Path(os.environ.get(name) or default)


def read(path):
    try:
        return path.read_text()
    except OSError:
        return None


def processes(proc):
    table = {}
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        stat = read(entry / "stat")
        cgroup = read(entry / "cgroup")
        cmdline = read(entry / "cmdline")
        if stat is None or cgroup is None:
            continue
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        ppid = int(stat[stat.rindex(")") + 2:].split()[1])
        path = next((line.split(":", 2)[2] for line in cgroup.splitlines() if line.startswith("0::")), "")
        argv = (cmdline or "").split("\0")
        table[int(entry.name)] = {"comm": comm, "ppid": ppid, "cgroup": path,
                                  "cmd": " ".join(a for a in argv if a)[:160] or comm}
    return table


def agent_started(pid, table):
    seen = set()
    pid = table[pid]["ppid"]
    while pid in table and pid not in seen:
        if table[pid]["comm"] in AGENT_COMMS:
            return True
        seen.add(pid)
        pid = table[pid]["ppid"]
    return False


def plan(table, uid):
    user = f"/user.slice/user-{uid}.slice/user@{uid}.service/"
    moves, scopes = [], {}
    for pid, info in sorted(table.items()):
        cg = info["cgroup"]
        if not cg.startswith(user):
            continue
        rel = cg[len(user):]
        if rel == "agent.slice" or rel.startswith("agent.slice/"):
            continue
        parts = rel.split("/")
        pod = next((i for i, p in enumerate(parts) if p.startswith("libpod-") and p.endswith(".scope")), None)
        if pod is not None:
            scopes.setdefault(user + "/".join(parts[:pod + 1]), (pid, info))
        elif info["comm"] not in AGENT_COMMS and agent_started(pid, table):
            moves.append((pid, info))
    return moves, scopes


def incident(inbox, host, action, pid, info, count=1):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
    more = f" processes={count}" if count > 1 else ""
    line = f"INCIDENT {stamp} agent-contain host={host} action={action} pid={pid} cmd={info['cmd']!r} cgroup={info['cgroup']}{more}\n"
    inbox.parent.mkdir(parents=True, exist_ok=True)
    with inbox.open("a") as f:
        f.write(line)
    return line


def move(pids, proc):
    pids = [pid for pid in pids if (proc / str(pid)).exists()]
    if not pids:
        return True, []
    unit = f"agent-contain-{pids[0]}-{int(datetime.datetime.now().timestamp())}.scope"
    args = [os.environ.get("AGENT_CONTAIN_BUSCTL") or "busctl", "--user", "call", "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
            "org.freedesktop.systemd1.Manager", "StartTransientUnit", "ssa(sv)a(sa(sv))", unit, "fail",
            "2", "PIDs", "au", str(len(pids)), *map(str, pids), "Slice", "s", SLICE, "0"]
    return subprocess.run(args, capture_output=True, text=True).returncode == 0, pids


def sweep(dry):
    proc = env_path("AGENT_CONTAIN_PROC", "/proc")
    cgroot = env_path("AGENT_CONTAIN_CGROUP", "/sys/fs/cgroup")
    inbox = env_path("AGENT_CONTAIN_INBOX", Path.home() / ".local/state/agents/handoffs/proxy-inbox.md")
    uid = int(os.environ.get("AGENT_CONTAIN_UID") or os.getuid())
    host = os.environ.get("AGENT_CONTAIN_HOST") or socket.gethostname()
    table = processes(proc)
    moves, scopes = plan(table, uid)
    for cg, (pid, info) in scopes.items():
        freeze = cgroot / cg.lstrip("/") / "cgroup.freeze"
        if (read(freeze) or "").strip() == "1":
            continue
        if dry:
            print(f"freeze {pid} {cg}")
            continue
        try:
            freeze.write_text("1")
        except OSError as error:
            print(f"agent-contain: cannot freeze {cg}: {error}", file=sys.stderr)
            continue
        print(incident(inbox, host, "frozen", pid, info), end="")
    if not moves:
        return 0
    if dry:
        for pid, info in moves:
            print(f"move {pid} {info['cgroup']} {info['cmd']}")
        return 0
    moved, pids = move([pid for pid, _ in moves], proc)
    if not moved:
        moved, pids = move(pids, proc)
    if not moved:
        pids = [pid for pid in pids if (proc / str(pid)).exists()]
    remaining = set(pids)
    reported = env_path("AGENT_CONTAIN_STATE", Path.home() / ".local/state/agent-contain/reported.json")
    try:
        last = json.loads(reported.read_text())
    except (OSError, ValueError):
        last = {}
    now = time.time()
    groups = {}
    for pid, info in moves:
        if pid not in remaining:
            continue
        groups.setdefault(info["cgroup"].split("/agent-contain-")[0], []).append((pid, info))
    for cg, members in groups.items():
        if now - last.get(cg, 0) < REPEAT_SECONDS:
            continue
        pid, info = members[0]
        print(incident(inbox, host, "moved" if moved else "move-failed", pid, info, len(members)), end="")
        last[cg] = now
    reported.parent.mkdir(parents=True, exist_ok=True)
    reported.write_text(json.dumps({k: v for k, v in last.items() if now - v < REPEAT_SECONDS}))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] != "sweep":
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    return sweep("--dry-run" in argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
