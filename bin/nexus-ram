#!/usr/bin/env python3
"""nexus-ram: record and judge Nexus memory headroom for resident agent CLIs.

  nexus-ram record
  nexus-ram report [--days N]

record appends one JSON row to $NEXUS_RAM_DIR/YYYY-MM-DD.jsonl (UTC date; default
~/.local/state/nexus-ram): ts, MemAvailable, swap used, zram used and compressed size,
PSI memory some/full avg60, the count of resident agent CLIs (top-level interactive claude
and codex processes; -p/--print, codex exec/app-server/mcp-server/cloud and --cloud launches
are excluded) and their summed PSS over each process tree (smaps_rollup).

report summarizes the last N days (default 7) of rows: p50/p95/max agent CLIs and agent PSS,
min MemAvailable, minutes with PSI full avg60 over 1%, OOM kills from the journal, rows and
days covered, and one verdict line. UPGRADE when on 3 or more days MemAvailable stayed under
600 MiB for over 10 minutes or PSI full avg60 stayed over 1% for over 10 minutes, or any OOM
kill hit an agent; otherwise STAY.

Inputs for tests: NEXUS_RAM_DIR, NEXUS_RAM_PROC (default /proc), NEXUS_RAM_ZRAM (default
/sys/block/zram0/mm_stat), NEXUS_RAM_NOW (epoch seconds), NEXUS_RAM_JOURNAL (a journalctl
-o short-iso text file replacing the live journal query).
"""
import argparse
import json
import math
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

MIB_KIB = 1024
LOW_AVAILABLE_MIB = 600
PSI_FULL_LIMIT = 1.0
SUSTAINED_SECONDS = 600
UPGRADE_DAYS = 3
ROW_SECONDS = 60
GAP_SECONDS = 150
AGENTS = ("claude", "codex")
NON_RESIDENT_ARGS = {"-p", "--print", "--cloud", "exec", "app-server", "mcp-server", "cloud"}
KILL_PATTERNS = (
    re.compile(r"Out of memory: Killed process \d+ \((?P<name>[^)]*)\)"),
    re.compile(r'sending SIG(?:TERM|KILL) to process \d+ uid \d+ "(?P<name>[^"]*)"'),
)
AGENT_NAME = re.compile(r"claude|codex")


def data_dir():
    return Path(os.environ.get("NEXUS_RAM_DIR") or Path.home() / ".local/state/nexus-ram")


def now():
    return float(os.environ.get("NEXUS_RAM_NOW") or time.time())


def read(path):
    try:
        return Path(path).read_text()
    except OSError:
        return ""


def meminfo_kib(proc):
    out = {}
    for line in read(f"{proc}/meminfo").splitlines():
        key, _, rest = line.partition(":")
        if rest.split():
            out[key] = int(rest.split()[0])
    return out


def psi(proc):
    out = {}
    for line in read(f"{proc}/pressure/memory").splitlines():
        kind, *fields = line.split()
        out[kind] = float(dict(f.split("=") for f in fields)["avg60"])
    return out


def zram(path):
    fields = read(path).split()
    if len(fields) < 3:
        return 0, 0
    return int(fields[0]), int(fields[1])


def process_table(proc):
    table = {}
    for entry in Path(proc).iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text()
            argv = (entry / "cmdline").read_bytes().split(b"\0")[:-1]
        except OSError:
            continue
        head, _, tail = stat.rpartition(")")
        comm = head.partition("(")[2]
        table[int(entry.name)] = {"comm": comm, "ppid": int(tail.split()[1]), "argv": [a.decode("utf-8", "replace") for a in argv]}
    return table


def agent_kind(info):
    if not info["argv"]:
        return None
    name = os.path.basename(info["argv"][0])
    if name in AGENTS and info["comm"] == name and not NON_RESIDENT_ARGS.intersection(info["argv"][1:]):
        return name
    return None


def resident_agents(table):
    kinds = {pid: agent_kind(info) for pid, info in table.items()}
    resident = []
    for pid, kind in kinds.items():
        if not kind:
            continue
        parent, seen = table[pid]["ppid"], set()
        while parent in table and parent not in seen:
            if kinds.get(parent):
                break
            seen.add(parent)
            parent = table[parent]["ppid"]
        else:
            resident.append(pid)
    return resident


def descendants(table, root):
    children = {}
    for pid, info in table.items():
        children.setdefault(info["ppid"], []).append(pid)
    tree, stack = [], [root]
    while stack:
        pid = stack.pop()
        tree.append(pid)
        stack.extend(children.get(pid, []))
    return tree


def pss_kib(proc, pid):
    for line in read(f"{proc}/{pid}/smaps_rollup").splitlines():
        if line.startswith("Pss:"):
            return int(line.split()[1])
    return 0


def sample(proc, zram_path, at):
    mem = meminfo_kib(proc)
    pressure = psi(proc)
    orig, compr = zram(zram_path)
    table = process_table(proc)
    agents = resident_agents(table)
    total_kib = sum(pss_kib(proc, pid) for root in agents for pid in descendants(table, root))
    return {
        "ts": datetime.fromtimestamp(at, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "mem_available_mib": mem.get("MemAvailable", 0) // MIB_KIB,
        "swap_used_mib": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) // MIB_KIB,
        "zram_used_mib": orig // MIB_KIB // MIB_KIB,
        "zram_compressed_mib": compr // MIB_KIB // MIB_KIB,
        "psi_some_avg60": pressure.get("some", 0.0),
        "psi_full_avg60": pressure.get("full", 0.0),
        "agents": len(agents),
        "agent_pss_mib": total_kib // MIB_KIB,
    }


def record():
    at = now()
    row = sample(os.environ.get("NEXUS_RAM_PROC", "/proc"), os.environ.get("NEXUS_RAM_ZRAM", "/sys/block/zram0/mm_stat"), at)
    directory = data_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / f"{row['ts'][:10]}.jsonl", "a") as out:
        out.write(json.dumps(row, separators=(",", ":")) + "\n")


def load_rows(since, until):
    rows = []
    first = datetime.fromtimestamp(since, timezone.utc).date()
    last = datetime.fromtimestamp(until, timezone.utc).date()
    day = first
    while day <= last:
        for line in read(data_dir() / f"{day.isoformat()}.jsonl").splitlines():
            try:
                row = json.loads(line)
                row["epoch"] = datetime.strptime(row["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
            except (ValueError, KeyError):
                continue
            if since <= row["epoch"] <= until:
                rows.append(row)
        day += timedelta(days=1)
    return sorted(rows, key=lambda r: r["epoch"])


def percentile(values, p):
    ordered = sorted(values)
    return ordered[max(0, math.ceil(p / 100 * len(ordered)) - 1)]


def longest_run(rows, hot):
    best = start = last = None
    for row in rows:
        if hot(row):
            if start is None or row["epoch"] - last > GAP_SECONDS:
                start = row["epoch"]
            last = row["epoch"]
            span = last - start + ROW_SECONDS
            best = span if best is None else max(best, span)
        else:
            start = None
    return best or 0


def sustained_days(rows):
    by_day = {}
    for row in rows:
        by_day.setdefault(row["ts"][:10], []).append(row)
    days = []
    for day, day_rows in sorted(by_day.items()):
        low = longest_run(day_rows, lambda r: r["mem_available_mib"] < LOW_AVAILABLE_MIB)
        full = longest_run(day_rows, lambda r: r["psi_full_avg60"] > PSI_FULL_LIMIT)
        if low > SUSTAINED_SECONDS or full > SUSTAINED_SECONDS:
            days.append((day, low, full))
    return days


def journal_lines(since, until):
    source = os.environ.get("NEXUS_RAM_JOURNAL")
    if source:
        return read(source).splitlines()
    cmd = ["journalctl", "--no-pager", "-q", "-o", "short-iso", "--since", f"@{int(since)}", "--until", f"@{int(until) + 1}",
           "-g", "Out of memory: Killed process|sending SIG(TERM|KILL) to process"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result.stdout.splitlines()


def line_epoch(line):
    try:
        return datetime.fromisoformat(line.split()[0]).timestamp()
    except (ValueError, IndexError):
        return None


def oom_kills(since, until):
    kills = []
    for line in journal_lines(since, until):
        at = line_epoch(line)
        if at is not None and not since <= at <= until:
            continue
        for pattern in KILL_PATTERNS:
            match = pattern.search(line)
            if match:
                kills.append((line.split()[0], match["name"], bool(AGENT_NAME.search(line[match.start():]))))
                break
    return kills


def report(days):
    until = now()
    since = until - days * 86400
    rows = load_rows(since, until)
    kills = oom_kills(since, until)
    if not rows:
        print(f"nexus-ram: no rows in the last {days:g} days in {data_dir()}")
        print("verdict: STAY (no data)")
        return 1
    agents = [r["agent_pss_mib"] for r in rows]
    counts = [r["agents"] for r in rows]
    span_days = (rows[-1]["epoch"] - rows[0]["epoch"] + ROW_SECONDS) / 86400
    full_minutes = sum(1 for r in rows if r["psi_full_avg60"] > PSI_FULL_LIMIT)
    some_minutes = sum(1 for r in rows if r["psi_some_avg60"] > PSI_FULL_LIMIT)
    pressure_days = sustained_days(rows)
    agent_kills = [k for k in kills if k[2]]
    print(f"window: last {days:g} days, {len(rows)} rows covering {span_days:.2f} days ({rows[0]['ts']} .. {rows[-1]['ts']})")
    print(f"agent CLIs: p50 {percentile(counts, 50)} p95 {percentile(counts, 95)} max {max(counts)}")
    print(f"agent PSS MiB: p50 {percentile(agents, 50)} p95 {percentile(agents, 95)} max {max(agents)}")
    print(f"min MemAvailable MiB: {min(r['mem_available_mib'] for r in rows)}")
    print(f"max swap used MiB: {max(r['swap_used_mib'] for r in rows)}; max zram used MiB: {max(r['zram_used_mib'] for r in rows)}; max zram compressed MiB: {max(r['zram_compressed_mib'] for r in rows)}")
    print(f"minutes with PSI full avg60 > 1%: {full_minutes} (some: {some_minutes})")
    print(f"OOM kills: {len(kills)} ({len(agent_kills)} hit an agent)")
    for stamp, name, hit in kills:
        print(f"  {stamp} {name}{' [agent]' if hit else ''}")
    for day, low, full in pressure_days:
        print(f"sustained pressure {day}: MemAvailable < {LOW_AVAILABLE_MIB} MiB for {int(low // 60)} min, PSI full > 1% for {int(full // 60)} min")
    reasons = []
    if len(pressure_days) >= UPGRADE_DAYS:
        reasons.append(f"{len(pressure_days)} days with sustained pressure")
    if agent_kills:
        reasons.append(f"{len(agent_kills)} OOM kills hit an agent")
    if reasons:
        print(f"verdict: UPGRADE ({'; '.join(reasons)})")
    else:
        print(f"verdict: STAY ({len(pressure_days)} days with sustained pressure, {len(agent_kills)} agent OOM kills)")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="nexus-ram", description="Record and judge Nexus memory headroom.")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("record")
    rep = sub.add_parser("report")
    rep.add_argument("--days", type=float, default=7)
    args = parser.parse_args()
    if args.cmd == "record":
        record()
        return 0
    return report(args.days)


if __name__ == "__main__":
    sys.exit(main())
