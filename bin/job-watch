#!/usr/bin/env python3
"""job-watch: alert when a registered scheduled job is overdue.

  job-watch run [--registry DIR] [--peers FILE] [--state FILE] [--dry-run]
  job-watch self-test [--post]

run reads every routine in the registry with a placement (laptop or nexus) and a deadline, the
ledger's `threads job-runs --json`, and WireGuard presence from peers.json. A laptop job is overdue
when the laptop has been online longer than period + 30 min with no success, or when its deadline
since the last success has passed even while the laptop is off; a nexus job when its last success
is older than its deadline. It alerts once per transition into overdue, again at most every 24 h,
and sends a recovered note on the next success.

Alerts go through `nexus-alert TOPIC TEXT TITLE`: urgent for overdue, normal for recovered;
JOB_WATCH_TOPIC overrides both. JOB_WATCH_HOSTS maps placements to ledger hosts
(default "laptop=whiterabbit nexus=nexus").

self-test runs the scenario fixtures through the same core and checks the alert set; --post also
sends each alert to the socrates-test topic.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

GRACE = 30 * 60
REPEAT = 24 * 3600
OPEN_LIMIT = 6 * 3600
ONLINE_WITHIN = 5 * 60
UNITS = {"s": 1, "min": 60, "m": 60, "h": 3600, "d": 86400, "w": 7 * 86400}


def duration(text):
    m = re.fullmatch(r"\s*(\d+)\s*(s|min|m|h|d|w)\s*", text or "")
    return int(m.group(1)) * UNITS[m.group(2)] if m else None


def period_of(schedule):
    s = schedule or ""
    m = re.search(r"every (\d+) ?(min|h)", s)
    if m:
        return int(m.group(1)) * UNITS[m.group(2)]
    for word, secs in (("hourly", 3600), ("weekly", 7 * 86400), ("daily", 86400)):
        if word in s:
            return secs
    return None


def epoch(ts):
    if not ts:
        return None
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def fmt(t):
    return "never" if t is None else datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def span(secs):
    return f"{secs // 86400}d" if secs % 86400 == 0 else f"{secs // 3600}h" if secs % 3600 == 0 else f"{secs // 60}min"


def overdue(last_ok, period, deadline, laptop_online_since, now):
    """Reason the job is overdue ("deadline" or "online"), or None. period is None for nexus jobs."""
    if now - last_ok > deadline:
        return "deadline"
    if period is not None and laptop_online_since is not None:
        grace = period + GRACE
        if now - laptop_online_since > grace and now - last_ok > grace:
            return "online"
    return None


def message(entry, reason, row, last_ok, laptop, now):
    job = entry["job"]
    if entry["placement"] == "nexus":
        text = f"{job} on nexus missed its deadline ({span(entry['deadline'])}); last success {fmt(last_ok)}"
    elif laptop["online_since"] is None:
        text = f"{job} missed its deadline; laptop offline since {fmt(laptop['handshake'])}; it runs on wake"
    elif reason == "online":
        text = (f"{job} has had no successful run for {span(entry['period'] + GRACE)} while the laptop has been "
                f"online since {fmt(laptop['online_since'])}; last success {fmt(last_ok)}")
    else:
        text = (f"{job} missed its deadline ({span(entry['deadline'])}); laptop online since "
                f"{fmt(laptop['online_since'])}; last success {fmt(last_ok)}")
    open_since = epoch(row.get("open_since"))
    if open_since is not None and now - open_since > OPEN_LIMIT and (row.get("last_ok") is None or open_since > epoch(row["last_ok"])):
        text += f"; its run started {fmt(open_since)} never finished"
    return text


def step(entries, rows, hosts, laptop, state, now):
    """Pure core: (alerts, new_state). alerts are (job name, topic, text, title)."""
    alerts, new = [], {}
    for e in entries:
        row = rows.get((e["job"], hosts.get(e["placement"])))
        prev = state.get(e["name"])
        if row is None:
            if prev:
                new[e["name"]] = prev
            continue
        last_ok = epoch(row.get("last_ok"))
        ref = last_ok if last_ok is not None else epoch(row["first_started"])
        if e["placement"] == "laptop":
            reason = overdue(ref, e["period"], e["deadline"], laptop["online_since"], now)
        else:
            reason = overdue(ref, None, e["deadline"], None, now)
        if reason:
            if not prev or now - prev["alerted"] >= REPEAT:
                alerts.append((e["name"], "urgent", message(e, reason, row, last_ok, laptop, now), f"Nexus: {e['job']} overdue"))
                new[e["name"]] = {"overdue": True, "alerted": now}
            else:
                new[e["name"]] = prev
        elif prev:
            alerts.append((e["name"], "normal", f"{e['job']} recovered; last success {fmt(last_ok)}",
                           f"Nexus: {e['job']} recovered"))
    return alerts, new


def presence(peers, name, now):
    p = (peers.get("peers") or {}).get(name) or {}
    hs = p.get("handshake") or None
    online = hs is not None and now - hs < ONLINE_WITHIN
    return {"handshake": hs, "online_since": (p.get("online_since") or hs) if online else None}


def read_registry(directory):
    entries = []
    for f in sorted(Path(directory).glob("*.md")):
        text = f.read_text()
        if not text.startswith("---\n"):
            continue
        meta = {}
        for line in text.split("\n---", 1)[0].splitlines()[1:]:
            k, sep, v = line.partition(":")
            if sep:
                meta[k.strip()] = v.strip()
        deadline = duration(meta.get("deadline"))
        if meta.get("placement") in ("laptop", "nexus") and deadline:
            name = meta.get("name", f.stem)
            entries.append({"name": name, "job": name.split("@")[0], "placement": meta["placement"],
                            "deadline": deadline, "period": period_of(meta.get("schedule"))})
    return entries


def send(topic, text, title):
    r = subprocess.run(["nexus-alert", topic, text, title], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"job-watch: nexus-alert {topic} failed: {r.stderr.strip()}", file=sys.stderr)
        return False
    print(f"      posted to {topic}: ntfy id {r.stdout.strip()}")
    return True


def cmd_run(a):
    now = time.time()
    hosts = dict(p.split("=", 1) for p in os.environ.get("JOB_WATCH_HOSTS", "laptop=whiterabbit nexus=nexus").split())
    entries = read_registry(a.registry)
    out = subprocess.run([sys.executable, str(Path(__file__).resolve().parent / "threads"), "job-runs", "--json"], capture_output=True, text=True, check=True).stdout
    rows = {(r["name"], r["host"]): r for r in json.loads(out or "[]")}
    try:
        peers = json.loads(Path(a.peers).read_text())
    except (OSError, ValueError):
        peers = {}
    state_file = Path(a.state)
    try:
        state = json.loads(state_file.read_text())
    except (OSError, ValueError):
        state = {}
    alerts, new = step(entries, rows, hosts, presence(peers, "laptop", now), state, now)
    topic_override = os.environ.get("JOB_WATCH_TOPIC")
    failed = 0
    for name, topic, text, title in alerts:
        print(f"{topic_override or topic}: {title}: {text}")
        if not a.dry_run and not send(topic_override or topic, text, title):
            failed += 1
            if name in state:
                new[name] = state[name]
            else:
                new.pop(name, None)
    if not a.dry_run:
        state_file.parent.mkdir(parents=True, exist_ok=True)
        tmp = state_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(new, indent=1, sort_keys=True))
        tmp.replace(state_file)
    watched = sum(1 for e in entries if (e["job"], hosts.get(e["placement"])) in rows)
    print(f"job-watch: {len(entries)} jobs with deadlines, {watched} with runs, {len(alerts)} alerts, {failed} unsent")
    return 1 if failed else 0


def iso(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fixtures():
    """Scenario runs 15 min to a day apart: (label, now, ledger rows, laptop peer, expected alerts)."""
    T = 1_800_000_000
    entries = [
        {"name": "nightly-backup", "job": "nightly-backup", "placement": "laptop", "deadline": 1800, "period": 86400},
        {"name": "sync@laptop", "job": "sync", "placement": "laptop", "deadline": 7200, "period": 900},
        {"name": "checks", "job": "checks", "placement": "nexus", "deadline": 3600, "period": 900},
    ]

    def rows(now, backup_ok):
        return {
            ("nightly-backup", "laptop"): {"first_started": iso(T - 86400), "last_ok": iso(backup_ok), "open_since": None},
            ("sync", "laptop"): {"first_started": iso(T - 86400), "last_ok": iso(T - 3600), "open_since": iso(T - 3600 + 60)},
            ("checks", "nexus"): {"first_started": iso(T - 86400), "last_ok": iso(now - 600), "open_since": None},
        }

    off = {"peers": {"laptop": {"handshake": T - 3600, "online_since": None}}}

    def on(now):
        return {"peers": {"laptop": {"handshake": now - 60, "online_since": T + 600}}}

    return entries, [
        ("laptop off past a deadline", T, rows(T, T - 7200), off, [("nightly-backup", "urgent")]),
        ("laptop online, job failing", T + 3600, rows(T + 3600, T - 7200), on(T + 3600), [("sync@laptop", "urgent")]),
        ("recovered", T + 4500, rows(T + 4500, T + 3900), on(T + 4500), [("nightly-backup", "normal")]),
        ("still overdue next run", T + 5400, rows(T + 5400, T + 3900), on(T + 5400), []),
        ("still overdue a day later", T + 5400 + REPEAT, rows(T + 5400 + REPEAT, T + 3900 + REPEAT), on(T + 5400 + REPEAT),
         [("sync@laptop", "urgent")]),
    ]


def cmd_self_test(a):
    entries, runs = fixtures()
    hosts = {"laptop": "laptop", "nexus": "nexus"}
    state, ok, sent = {}, True, []
    for label, now, rows, peers, expected in runs:
        alerts, state = step(entries, rows, hosts, presence(peers, "laptop", now), state, now)
        got = [(name, topic) for name, topic, _, _ in alerts]
        mark = "PASS" if got == expected else "FAIL"
        ok &= got == expected
        print(f"{mark}  {label}: {len(alerts)} alert(s)")
        for name, topic, text, title in alerts:
            print(f"      {topic}: {title}: {text}")
            sent.append((text, title))
    if a.post:
        for text, title in sent:
            if not send("socrates-test", f"[job-watch self-test] {text}", title):
                ok = False
    print(f"job-watch self-test: {len(sent)} alerts{' posted to socrates-test' if a.post else ''}; {'ok' if ok else 'FAILED'}")
    return 0 if ok else 1


def main():
    p = argparse.ArgumentParser(prog="job-watch", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="check every registered job with a deadline and alert on transitions")
    home = Path.home()
    r.add_argument("--registry", default=str(home / "code/nixos-config/main/dotfiles/agents/routines"))
    r.add_argument("--peers", default="/run/nexus/peers.json")
    r.add_argument("--state", default=os.path.join(os.environ.get("STATE_DIRECTORY", str(home / ".local/state/job-watch")), "state.json"))
    r.add_argument("--dry-run", action="store_true", help="print the alerts without sending them or saving state")
    s = sub.add_parser("self-test", help="run the scenario fixtures through the core")
    s.add_argument("--post", action="store_true", help="also send each fixture alert to the socrates-test topic")
    a = p.parse_args()
    return cmd_run(a) if a.cmd == "run" else cmd_self_test(a)


if __name__ == "__main__":
    sys.exit(main())
