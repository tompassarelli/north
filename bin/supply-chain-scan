#!/usr/bin/env bash
# supply-chain-scan: scan origin/main lockfiles of Tom's repos with osv-scanner and alert on new advisories.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/supply-chain"
seen="$state/seen.json"
projects=(smashcraft wisp north nixos-config galileo)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/supply-chain-scan.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT

die() {
  echo "supply-chain-scan: $1" >&2
  supply-alert normal "$1"
  exit 1
}

mkdir -p "$state"
[[ -f $seen ]] || printf '[]\n' > "$seen"

lockfiles=()
for p in "${projects[@]}"; do
  repo="$HOME/code/$p/main"
  if [[ ! -d $repo ]]; then
    echo "supply-chain-scan: skipping $p: $repo is missing" >&2
    continue
  fi
  git -C "$repo" fetch -q origin main || die "git fetch failed in $p"
  while IFS= read -r -d '' f; do
    dest="$tmp/$p/$f"
    mkdir -p "$(dirname "$dest")"
    git -C "$repo" show "origin/main:$f" > "$dest" || die "git show failed for $p:$f"
    lockfiles+=("$dest")
  done < <(git -C "$repo" ls-tree -r -z --name-only origin/main \
    | grep -zE '(^|/)(bun\.lock|Cargo\.lock|uv\.lock|requirements[^/]*\.txt|package-lock\.json)$' \
    | grep -zvE '(^|/)repos/')
done

global="$HOME/.bun/install/global/bun.lock"
if [[ -f $global ]]; then
  mkdir -p "$tmp/bun-global"
  cp "$global" "$tmp/bun-global/bun.lock"
  lockfiles+=("$tmp/bun-global/bun.lock")
fi

args=()
for f in "${lockfiles[@]}"; do args+=(-L "$f"); done

set +e
osv-scanner scan source --format json "${args[@]}" > "$tmp/osv.json" 2> "$tmp/osv.err"
rc=$?
set -e
(( rc <= 1 )) || die "osv-scanner: $(head -n 1 "$tmp/osv.err")"

jq -c --arg t "$tmp/" '
  [ .results[]? as $r
    | ($r.source.path | ltrimstr($t) | split("/")[0]) as $repo
    | $r.packages[]? as $pk
    | $pk.package as $p
    | $pk.vulnerabilities[]? as $v
    | {
        key: ($v.id + " " + $repo + " " + $p.name),
        id: $v.id,
        repo: $repo,
        pkg: ($p.name + "@" + $p.version),
        fixed: ([$v.affected[]? | select(.package.name == $p.name) | .ranges[]?.events[]?.fixed | select(. != null)] | first)
      }
  ] | unique_by(.key)' "$tmp/osv.json" > "$tmp/cur.json"

jq -c --slurpfile seen "$seen" '
  $seen[0] as $old
  | [ .[] | select(.key as $k | $old | any(. == $k) | not) ]' "$tmp/cur.json" > "$tmp/new.json"

mal=$(jq -r '[.[] | select(.id | startswith("MAL-"))] | map("\(.id) \(.pkg) (\(.repo))") | join("; ")' "$tmp/new.json")
fix=$(jq -r '[.[] | select((.id | startswith("MAL-") | not) and .fixed != null)] | map("\(.id) \(.pkg) (\(.repo)) fixed \(.fixed)") | join("; ")' "$tmp/new.json")

[[ -z $mal ]] || supply-alert urgent "malware flagged: $mal"
[[ -z $fix ]] || supply-alert normal "fixable advisories: $fix"

jq -c --slurpfile cur "$tmp/cur.json" '(. + ($cur[0] | map(.key))) | unique' "$seen" > "$seen.tmp"
mv "$seen.tmp" "$seen"
echo "supply-chain-scan: $(jq length "$tmp/cur.json") findings, $(jq length "$tmp/new.json") new, urgent=$([[ -n $mal ]] && echo yes || echo no), normal=$([[ -n $fix ]] && echo yes || echo no)"
