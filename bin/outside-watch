#!/usr/bin/env python3
"""outside-watch: hear about people outside the agents on Tom's GitHub repos before Tom does.

Each run finds the issues, pull requests, comments, reviews and discussions posted since the last
run by anyone other than our own actors. Promotional spam (a link to the poster's own product, or
any outside link from an account under 30 days old, from someone with no standing in the repo and
no mention of that link in the thread) is minimized as SPAM and its account blocked. Everything
else is a real person and becomes an `OPS EXTERNAL` line in the proxy inbox; when unsure it is a
real person. Notification threads whose every new actor is ours are marked read. It never replies,
closes or posts.

  outside-watch run [--dry-run] [--days N]
  outside-watch status
"""

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, urlparse

OWNER = os.environ.get("OUTSIDE_WATCH_OWNER", "tompassarelli")
OWN = set(os.environ.get("OUTSIDE_WATCH_OWN", "tompassarelli,github-actions[bot],dependabot[bot]").split(","))
STATE_DIR = Path(os.environ.get("OUTSIDE_WATCH_STATE", Path.home() / ".local/state/outside-watch"))
INBOX = Path(os.environ.get("OUTSIDE_WATCH_INBOX", Path.home() / ".local/state/agents/handoffs/proxy-inbox.md"))
OVERLAP = dt.timedelta(minutes=15)
YOUNG = dt.timedelta(days=30)
NO_STANDING = {"NONE", "FIRST_TIMER", "FIRST_TIME_CONTRIBUTOR"}
TLDS = "com|net|org|io|ai|dev|app|co|xyz|me|so|gg|tech|info|site|online|pro|cc|us|uk|de|fr|ru|cn|in|biz|shop|store|tv|ly|to"
DOMAIN = re.compile(r"(?:https?://)?((?:[a-z0-9-]+\.)+(?:" + TLDS + r"))(?![a-z0-9-])", re.I)
OURS_DOMAINS = ("github.com", "githubusercontent.com", "github.io", "githubassets.com")

DISCUSSIONS = """query($q: String!) { search(type: DISCUSSION, query: $q, first: 50) { nodes { ... on Discussion {
  id number url title body createdAt authorAssociation author { login __typename } repository { name }
  comments(last: 50) { nodes { id url body createdAt authorAssociation author { login __typename }
    replies(last: 50) { nodes { id url body createdAt authorAssociation author { login __typename } } } } } } } } }"""
MINIMIZE = "mutation($id: ID!) { minimizeComment(input: {subjectId: $id, classifier: SPAM}) { minimizedComment { isMinimized } } }"


def now():
    fixed = os.environ.get("OUTSIDE_WATCH_NOW")
    return dt.datetime.fromisoformat(fixed.replace("Z", "+00:00")) if fixed else dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def gh(*args, ok_missing=False):
    out = subprocess.run(["gh", *args], capture_output=True, text=True)
    if out.returncode:
        if ok_missing:
            return None
        raise SystemExit(f"outside-watch: gh {' '.join(args[:3])} failed: {out.stderr.strip()[:300]}")
    return json.loads(out.stdout) if out.stdout.strip() else None


def pages(endpoint, key=None):
    rows = []
    for page in gh("api", "--paginate", "--slurp", endpoint) or []:
        rows.extend(page[key] if key else page)
    return rows


def domains(text):
    found = set()
    for m in DOMAIN.finditer(text or ""):
        d = m.group(1).lower().removeprefix("www.")
        if not any(d == o or d.endswith("." + o) for o in OURS_DOMAINS):
            found.add(d)
    return found


def profile_domains(profile):
    text = " ".join(str(profile.get(k) or "") for k in ("blog", "bio", "company"))
    blog = profile.get("blog") or ""
    host = urlparse(blog if "://" in blog else "https://" + blog).hostname or ""
    return domains(text) | ({host.lower().removeprefix("www.")} if host else set())


def is_spam(item, profile, context, at):
    if item["kind"] == "pr" or item["actor_type"] != "User" or item["association"] not in NO_STANDING:
        return False
    outside = domains(item["body"]) - domains(context)
    if not outside:
        return False
    young = at - parse(profile["created_at"]) < YOUNG
    return young or bool(outside & profile_domains(profile))


def item(kind, repo, number, node, actor, body, association, created, url):
    return {"kind": kind, "repo": repo, "number": number, "id": node["node_id"] if "node_id" in node else node["id"],
            "actor": actor["login"], "actor_type": "User" if actor.get("type", actor.get("__typename")) == "User" else "Bot",
            "body": body or "", "association": association, "created": created, "url": url}


def scan(since):
    found = []
    repos, prs = set(), set()
    for h in pages(f"search/issues?q={quote(f'user:{OWNER} updated:>={since}')}&per_page=100", "items"):
        repo = h["repository_url"].rsplit("/", 1)[1]
        repos.add(repo)
        is_pr = "pull_request" in h
        if is_pr:
            prs.add((repo, h["number"]))
        if h["created_at"] >= since:
            found.append(item("pr" if is_pr else "issue", repo, h["number"], h, h["user"], h["title"] + "\n" + (h.get("body") or ""),
                              h["author_association"], h["created_at"], h["html_url"]))
    for repo in sorted(repos):
        for c in pages(f"repos/{OWNER}/{repo}/issues/comments?since={since}&per_page=100"):
            if c["created_at"] >= since:
                found.append(item("comment", repo, int(c["issue_url"].rsplit("/", 1)[1]), c, c["user"], c["body"],
                                  c["author_association"], c["created_at"], c["html_url"]))
        for c in pages(f"repos/{OWNER}/{repo}/pulls/comments?since={since}&per_page=100"):
            if c["created_at"] >= since:
                found.append(item("review comment", repo, int(c["pull_request_url"].rsplit("/", 1)[1]), c, c["user"], c["body"],
                                  c["author_association"], c["created_at"], c["html_url"]))
    for repo, number in sorted(prs):
        for r in pages(f"repos/{OWNER}/{repo}/pulls/{number}/reviews?per_page=100"):
            if (r.get("submitted_at") or "") >= since and r.get("user"):
                found.append(item("review", repo, number, r, r["user"], r.get("body"), r["author_association"],
                                  r["submitted_at"], r["html_url"]))
    data = gh("api", "graphql", "-f", f"query={DISCUSSIONS}", "-f", f"q=user:{OWNER} updated:>={since}") or {}
    for d in (data.get("data", {}).get("search", {}).get("nodes") or []):
        if not d:
            continue
        repo = d["repository"]["name"]
        posts = [("discussion", d, d["title"] + "\n" + d["body"])]
        for c in d["comments"]["nodes"]:
            posts.append(("discussion comment", c, c["body"]))
            posts.extend(("discussion reply", r, r["body"]) for r in c["replies"]["nodes"])
        for kind, p, body in posts:
            if p["createdAt"] >= since and p.get("author"):
                found.append(item(kind, repo, d["number"], p, p["author"], body, p["authorAssociation"], p["createdAt"], p["url"]))
    return [f for f in found if f["actor"] not in OWN]


def thread_context(f):
    if f["kind"] in ("issue", "pr") or f["kind"].startswith("discussion"):
        return ""
    issue = gh("api", f"repos/{OWNER}/{f['repo']}/issues/{f['number']}") or {}
    comments = pages(f"repos/{OWNER}/{f['repo']}/issues/{f['number']}/comments?per_page=100")
    texts = [issue.get("title") or "", issue.get("body") or ""]
    texts += [c["body"] or "" for c in comments if c["user"]["login"] != f["actor"]]
    return "\n".join(texts)


def classify(f, at, profiles):
    if f["kind"] == "pr" or f["association"] not in NO_STANDING or not domains(f["body"]):
        return "real"
    if f["actor"] not in profiles:
        profiles[f["actor"]] = gh("api", f"users/{f['actor']}") or {}
    return "spam" if is_spam(f, profiles[f["actor"]], thread_context(f), at) else "real"


def summary(f):
    text = " ".join(f["body"].split())
    text = text[:140] + ("…" if len(text) > 140 else "")
    return text.replace('"', "'")


def ours(thread):
    kind = thread["subject"]["type"]
    if kind in ("CheckSuite", "WorkflowRun"):
        return True
    url = thread["subject"].get("url") or ""
    if kind == "Release" and url:
        release = gh("api", url, ok_missing=True) or {}
        return (release.get("author") or {}).get("login") in OWN
    if kind not in ("Issue", "PullRequest") or not url:
        return False
    since = thread.get("last_read_at") or ""
    issue_url = url.replace("/pulls/", "/issues/")
    issue = gh("api", issue_url, ok_missing=True)
    if issue is None:
        return False
    actors = set()
    if issue["created_at"] > since:
        actors.add(issue["user"]["login"])
    if issue.get("closed_by") and (issue.get("closed_at") or "") > since:
        actors.add(issue["closed_by"]["login"])
    query = f"?since={since}&per_page=100" if since else "?per_page=100"
    actors |= {c["user"]["login"] for c in pages(issue_url + "/comments" + query) if c["created_at"] > since}
    if kind == "PullRequest":
        actors |= {r["user"]["login"] for r in pages(url + "/reviews?per_page=100")
                   if r.get("user") and (r.get("submitted_at") or "") > since}
        actors |= {c["user"]["login"] for c in pages(url + "/comments" + query) if c["created_at"] > since}
    return actors <= OWN


def load_state():
    try:
        return json.loads((STATE_DIR / "state.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def log(line):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_DIR / "log", "a") as fh:
        fh.write(f"{iso(now())} {line}\n")


def run(args):
    at = now()
    state = load_state()
    if args.days:
        since = iso(at - dt.timedelta(days=args.days))
    elif state.get("last_run"):
        since = iso(parse(state["last_run"]) - OVERLAP)
    else:
        since = iso(at - OVERLAP)
    seen = state.get("seen", {})
    profiles = {}
    spam = external = 0
    lines = []
    for f in scan(since):
        if f["id"] in seen and not args.dry_run:
            continue
        seen[f["id"]] = f["created"]
        where = f"{f['repo']}#{f['number']} {f['actor']}"
        if classify(f, at, profiles) == "spam":
            spam += 1
            if args.dry_run:
                print(f"SPAM {where}: {f['kind']} \"{summary(f)}\" {f['url']}")
                continue
            minimizable = f["kind"] in ("comment", "review comment", "discussion comment", "discussion reply")
            if minimizable:
                gh("api", "graphql", "-f", f"query={MINIMIZE}", "-f", f"id={f['id']}")
            if gh("api", f"user/blocks/{f['actor']}", ok_missing=True) is None:
                gh("api", "-X", "PUT", f"user/blocks/{f['actor']}")
            done = "minimized and blocked" if minimizable else "blocked, post left up"
            lines.append(f"OPS SPAM {where}: {done}: {f['kind']} \"{summary(f)}\" {f['url']}")
        else:
            external += 1
            line = f"OPS EXTERNAL {where}: {f['kind']} \"{summary(f)}\" {f['url']}"
            if args.dry_run:
                print(line.removeprefix("OPS "))
            else:
                lines.append(line)
    marked = 0
    for t in gh("api", "--paginate", "--slurp", "notifications?per_page=50") or []:
        for thread in t:
            if ours(thread):
                marked += 1
                if not args.dry_run:
                    gh("api", "-X", "PATCH", f"notifications/threads/{thread['id']}")
    verb = "would mark" if args.dry_run else "marked"
    result = f"since={since} spam={spam} external={external} {verb}-read={marked}"
    print(result)
    if args.dry_run:
        return
    if lines:
        with open(INBOX, "a") as fh:
            fh.write("".join(f"{line}\n" for line in lines))
    for line in lines:
        log(line)
    log(f"clean run {result}")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "state.json").write_text(json.dumps({"last_run": iso(at), "seen": {k: v for k, v in seen.items() if v >= iso(parse(since) - dt.timedelta(days=1))}}))


def status(_):
    state = load_state()
    print(f"last run: {state.get('last_run', 'never')}")
    try:
        print((STATE_DIR / "log").read_text().splitlines()[-1])
    except (FileNotFoundError, IndexError):
        pass


def main():
    p = argparse.ArgumentParser(prog="outside-watch")
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--days", type=float)
    r.set_defaults(fn=run)
    sub.add_parser("status").set_defaults(fn=status)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
