#!/usr/bin/env python3
import argparse
from datetime import datetime, timedelta, timezone
import json
import sys


def ticks_of(path, cut):
    ticks, cur, seen = [], None, set()
    with open(path) as f:
        for line in f:
            try:
                o = json.loads(line)
            except ValueError:
                continue
            ts = o.get("timestamp")
            if not ts:
                continue
            t = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            if o.get("type") == "user" and not o.get("isSidechain"):
                c = o["message"].get("content")
                text = c if isinstance(c, str) else " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                if text.strip():
                    if cur:
                        ticks.append(cur)
                    cur = {"tokens": 0, "out": 0, "turns": 0} if "[routine:tick]" in text and t >= cut else None
            elif o.get("type") == "assistant" and cur is not None and not o.get("isSidechain"):
                m = o["message"]
                if m.get("id") in seen or "opus" not in m.get("model", ""):
                    continue
                seen.add(m.get("id"))
                u = m.get("usage") or {}
                cur["tokens"] += sum(u.get(k, 0) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens"))
                cur["out"] += u.get("output_tokens", 0) or 0
                cur["turns"] += 1
    if cur:
        ticks.append(cur)
    return ticks


def main(argv):
    parser = argparse.ArgumentParser(prog="tick-tokens", description="Opus tokens and model calls per [routine:tick] turn in Claude transcripts.")
    parser.add_argument("--hours", type=float, default=24)
    parser.add_argument("transcripts", nargs="+")
    args = parser.parse_args(argv)
    cut = datetime.now(timezone.utc) - timedelta(hours=args.hours)
    for path in args.transcripts:
        ticks = ticks_of(path, cut)
        name = path.split("/")[-1][:8]
        if not ticks:
            print(name, "no ticks")
            continue
        tok = sorted(x["tokens"] for x in ticks)
        print(f"{name} ticks={len(ticks)} mean={sum(tok) // len(tok)} median={tok[len(tok) // 2]} "
              f"out_mean={sum(x['out'] for x in ticks) // len(ticks)} calls_mean={sum(x['turns'] for x in ticks) / len(ticks):.1f} total={sum(tok)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
