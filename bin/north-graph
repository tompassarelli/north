#!/usr/bin/env bb
;; north graph — the thread graph as a traversable page.
;;
;; `north-pinned` answers "what are the big fish" and `north-effort` answers
;; "where did the time go". Neither answers "how is this work actually
;; connected" — which parent a thread hangs off, what blocks it, and where the
;; effort concentrates in a subtree rather than on one node. With 700+ threads a
;; flat list is sediment; the structure is the only thing that makes it legible.
;;
;;   north-graph            write the page to ~/.local/state/north/graph.html
;;   north-graph <path>     write it somewhere else
;;
;; LOCAL ONLY — DO NOT PUBLISH THE OUTPUT. The graph contains every thread
;; title, and those include client Linear ticket identifiers (MSA-244, MSA-268,
;; … — 40+ in the current corpus). Client work is confidential and must never
;; reach an external service, so this writes a file to local state and stops
;; there. Open it with a browser. Do not upload it, host it, or paste it into
;; anything. If a shareable view is ever wanted, it needs a redaction pass
;; first, and that is a deliberate feature, not a default.
;;
;; Self-contained output: one HTML file, no network, no build step. It folds the
;; same two logs as north-effort, for the same reason — run facts live in
;; telemetry.log and threads live in coordination.log, and reading one is how
;; the earlier reports came to describe 12% of the ledger as if it were all of it.
;;
;; ROLLUP IS THE POINT. A parent's own runs are usually a rounding error next to
;; the work done by its children, so every node carries both its OWN effort and
;; its SUBTREE total. Judging a workstream by its own row alone understates it by
;; however much was delegated, which is most of it.

(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def log (or (System/getenv "FRAM_LOG")
             (str (System/getenv "HOME") "/.local/state/north/coordination.log")))
(def telemetry-log (or (System/getenv "NORTH_TELEMETRY_LOG")
                       (str (System/getenv "HOME") "/.local/state/north/telemetry.log")))

(defn- bare [s] (str/replace (str s) #"^@" ""))
(defn- num* [v] (or (try (Long/parseLong (str v)) (catch Exception _ nil)) 0))
(defn- run-subject? [l] (or (str/starts-with? l "run:") (str/starts-with? l "run-")))

(defn- fold-file [acc path]
  (if-not (.exists (io/file path))
    acc
    (with-open [r (io/reader path)]
      (reduce
       (fn [acc line]
         (let [f (try (edn/read-string line) (catch Exception _ nil))]
           (if-not (map? f)
             acc
             (let [l (bare (:l f)) p (str (:p f)) v (str (:r f))
                   retract? (= "retract" (str (:op f)))]
               (cond
                 retract?
                 (case p
                   "pinned"   (if (= v "true") (update acc :pinned disj l) acc)
                   "priority" (if (= v (get (:prio acc) l)) (update acc :prio dissoc l) acc)
                   acc)
                 (run-subject? l) (assoc-in acc [:run l p] (if (= p "thread") (bare v) v))
                 :else
                 (case p
                   "title"    (assoc-in acc [:title l] v)
                   "kind"     (assoc-in acc [:kind l] v)
                   "pinned"   (if (= v "true") (update acc :pinned conj l) (update acc :pinned disj l))
                   "priority" (assoc-in acc [:prio l] v)
                   "progress" (-> acc (update-in [:prog l] (fnil inc 0))
                                  (assoc-in [:last l] (subs (str (:ts f)) 0 10)))
                   "part_of"  (assoc-in acc [:parent l] (bare v))
                   "depends_on" (update-in acc [:deps l] (fnil conj #{}) (bare v))
                   "done_when"  (update-in acc [:bars l] (fnil inc 0))
                   "bar_evidence" (update-in acc [:eviden l] (fnil inc 0))
                   ("outcome" "abandoned" "superseded_by") (assoc-in acc [:term l] p)
                   acc))))))
       acc (line-seq r)))))

(defn- fold []
  (-> {:title {} :pinned #{} :prio {} :prog {} :last {} :parent {} :deps {}
       :term {} :run {} :bars {} :eviden {} :kind {}}
      (fold-file log)
      (fold-file telemetry-log)))

(defn- esc [s]
  (-> (str s) (str/replace "&" "&amp;") (str/replace "<" "&lt;")
      (str/replace ">" "&gt;") (str/replace "\"" "&quot;")))

(defn- human-ms [ms]
  (let [sec (quot ms 1000) h (quot sec 3600) m (quot (rem sec 3600) 60)]
    (cond (>= h 1) (format "%dh%02dm" h m)
          (>= m 1) (format "%dm" m)
          (pos? sec) (format "%ds" sec)
          :else "")))

(defn- human-n [n]
  (cond (>= n 1000000) (format "%.1fM" (/ n 1e6))
        (>= n 1000)    (format "%.1fk" (/ n 1e3))
        (pos? n)       (str n)
        :else          ""))

(let [{:keys [title pinned prio prog last parent deps term run bars eviden kind]} (fold)
      out (or (first *command-line-args*)
              (str (System/getenv "HOME") "/.local/state/north/graph.html"))
      ;; Own effort, per thread, from the run ledger.
      own (reduce (fn [m r]
                    (let [t (get r "thread")]
                      (if (or (nil? t) (= t "(ad-hoc)")) m
                          (-> m (update-in [t :runs] (fnil inc 0))
                              (update-in [t :ms] (fnil + 0) (num* (get r "duration_ms")))
                              (update-in [t :tok] (fnil + 0)
                                         (+ (num* (get r "input_tokens"))
                                            (num* (get r "output_tokens"))))))))
                  {} (vals run))
      ;; WHAT COUNTS AS A THREAD, stated rather than assumed — neither obvious
      ;; test is correct on its own. `kind thread` covers only 989 subjects and
      ;; misses real threads that predate the kind fact; "has a title" covers
      ;; 3114 and sweeps in 1410 concerns and 232 topics, which are coordination
      ;; artifacts, not work. So: titled, and not something that declares itself
      ;; to be another kind, and not a namespaced subject (`agent:`, `run:`,
      ;; `msg:`, `lease:`, `scratch:`) or a known collection prefix.
      thread? (fn [l]
                (and (get title l)
                     (let [k (get kind l)] (or (nil? k) (= k "thread")))
                     (not (str/includes? l ":"))
                     (not (re-find #"^(concern|topic)-" l))))
      nodes (set (filter thread? (keys title)))
      kids (reduce (fn [m [c p]] (if (and (nodes c) (nodes p)) (update m p (fnil conj []) c) m))
                   {} parent)
      roots (sort-by #(vector (get {"high" 0 "mid" 1 "low" 2} (get prio %) 9)
                              (- (count (get kids % []))))
                     (filter #(and (nodes %)
                                   (not (nodes (get parent %)))) nodes))
      ;; Subtree rollup. A parent's own runs are usually a rounding error next to
      ;; its children's, so both numbers are carried and neither is inferred.
      roll (memoize
            (fn roll [t seen]
              (if (contains? seen t)
                {:ms 0 :tok 0 :runs 0 :n 0}          ; cycle guard: part_of should be acyclic, but never hang
                (let [seen (conj seen t)
                      o (get own t)
                      base {:ms (:ms o 0) :tok (:tok o 0) :runs (:runs o 0) :n 1}]
                  (reduce (fn [a c] (let [r (roll c seen)]
                                      {:ms (+ (:ms a) (:ms r)) :tok (+ (:tok a) (:tok r))
                                       :runs (+ (:runs a) (:runs r)) :n (+ (:n a) (:n r))}))
                          base (get kids t []))))))
      node-json
      (fn node-json [t]
        (let [o (get own t) r (roll t #{})
              st (cond (get term t) "done" (contains? pinned t) "pinned" :else "open")]
          (str "{"
               "\"id\":\"" (esc t) "\","
               "\"t\":\"" (esc (get title t "?")) "\","
               "\"p\":\"" (esc (or (get prio t) "")) "\","
               "\"s\":\"" st "\","
               "\"pr\":" (get prog t 0) ","
               "\"bar\":" (get bars t 0) ","
               "\"ev\":" (get eviden t 0) ","
               "\"last\":\"" (esc (or (get last t) "")) "\","
               "\"dep\":" (count (get deps t #{})) ","
               "\"oms\":" (:ms o 0) ",\"otok\":" (:tok o 0) ",\"orun\":" (:runs o 0) ","
               "\"ms\":" (:ms r) ",\"tok\":" (:tok r) ",\"run\":" (:runs r) ",\"n\":" (:n r) ","
               "\"k\":[" (str/join "," (map node-json (sort-by #(- (:ms (roll % #{}))) (get kids t []))))
               "]}")))
      data (str "[" (str/join "," (map node-json roots)) "]")
      total-threads (count nodes)
      total-ms (reduce + (map #(:ms % 0) (vals own)))
      adhoc (reduce + (map #(num* (get % "duration_ms"))
                           (filter #(let [t (get % "thread")] (or (nil? t) (= t "(ad-hoc)"))) (vals run))))
      html (str "<!doctype html><html><head><meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">
<title>north — thread graph</title><style>
:root{--bg:#f4f5f7;--fg:#14171c;--dim:#5f6873;--line:#dbdfe6;--card:#fff;
--hi:#1f5f8b;--pin:#8b1f4d;--done:#2f6b4f;--bar:#c4cad3}
@media(prefers-color-scheme:dark){:root{--bg:#101318;--fg:#e3e7ec;--dim:#8a94a1;
--line:#242a33;--card:#171b22;--hi:#5fb3e8;--pin:#f08ab0;--done:#6fc296;--bar:#2e3540}}
:root[data-theme=dark]{--bg:#101318;--fg:#e3e7ec;--dim:#8a94a1;--line:#242a33;
--card:#171b22;--hi:#5fb3e8;--pin:#f08ab0;--done:#6fc296;--bar:#2e3540}
:root[data-theme=light]{--bg:#f4f5f7;--fg:#14171c;--dim:#5f6873;--line:#dbdfe6;
--card:#fff;--hi:#1f5f8b;--pin:#8b1f4d;--done:#2f6b4f;--bar:#c4cad3}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);
font:14px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;padding:1.5rem 1rem 4rem}
.wrap{max-width:1100px;margin:0 auto}
h1{font-size:1.1rem;margin:0 0 .25rem;letter-spacing:.04em;text-transform:uppercase}
.sub{color:var(--dim);margin:0 0 1.25rem;font-size:.85rem}
.stats{display:flex;flex-wrap:wrap;gap:1.5rem;padding:.85rem 1rem;background:var(--card);
border:1px solid var(--line);border-radius:6px;margin-bottom:1rem}
.stat b{display:block;font-size:1.15rem;font-variant-numeric:tabular-nums}
.stat span{color:var(--dim);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}
#q{width:100%;padding:.6rem .8rem;font:inherit;background:var(--card);color:var(--fg);
border:1px solid var(--line);border-radius:6px;margin-bottom:1rem}
#q:focus{outline:2px solid var(--hi);outline-offset:-1px}
ul{list-style:none;margin:0;padding:0}li>ul{margin-left:1.1rem;border-left:1px solid var(--line);padding-left:.9rem}
.n{display:flex;gap:.6rem;align-items:baseline;padding:.32rem .5rem;border-radius:4px;flex-wrap:wrap}
.n:hover{background:var(--card)}
.tw{cursor:pointer;user-select:none;color:var(--dim);width:1.1em;flex:none;text-align:center}
.tw.leaf{cursor:default;opacity:.28}
.ti{flex:1;min-width:14rem}
.ti.pinned{color:var(--pin);font-weight:600}.ti.done{color:var(--done)}
.m{color:var(--dim);font-size:.78rem;font-variant-numeric:tabular-nums;white-space:nowrap}
.m b{color:var(--fg);font-weight:600}
.pill{font-size:.68rem;padding:.05rem .4rem;border-radius:3px;border:1px solid var(--line);
color:var(--dim);text-transform:uppercase;letter-spacing:.04em}
.pill.high{color:var(--pin);border-color:var(--pin)}
.id{color:var(--dim);font-size:.7rem;opacity:.65}
.hidden{display:none}
.note{color:var(--dim);font-size:.78rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--line)}
</style></head><body><div class=\"wrap\">
<h1>north — thread graph</h1>
<p class=\"sub\">every thread with a title, nested by <code>part_of</code>, ranked by subtree agent time</p>
<div class=\"stats\">
<div class=\"stat\"><b>" total-threads "</b><span>threads</span></div>
<div class=\"stat\"><b>" (human-ms total-ms) "</b><span>attributed agent time</span></div>
<div class=\"stat\"><b>" (human-ms adhoc) "</b><span>unattributed</span></div>
<div class=\"stat\"><b>" (count pinned) "</b><span>pinned</span></div>
</div>
<input id=\"q\" placeholder=\"filter by title or id — matching nodes keep their ancestors\" autocomplete=off>
<ul id=\"tree\"></ul>
<p class=\"note\">Each row shows SUBTREE totals; a node's own effort is in parentheses when it
differs. Unattributed time is work that ran before <code>--thread</code> binding existed and can
never be assigned — it is shown rather than dropped. Units are observed work: tokens and wall
time, never dollars.</p>
</div><script>
const DATA=" data ";
const ms=v=>{if(!v)return'';const s=v/1000|0,h=s/3600|0,m=(s%3600)/60|0;
return h?h+'h'+String(m).padStart(2,'0')+'m':m?m+'m':s+'s'};
const n=v=>!v?'':v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(1)+'k':''+v;
function row(d){
 const li=document.createElement('li');
 const kids=d.k&&d.k.length;
 const div=document.createElement('div');div.className='n';
 const tw=document.createElement('span');tw.className='tw'+(kids?'':' leaf');
 tw.textContent=kids?'▸':'·';div.appendChild(tw);
 const ti=document.createElement('span');ti.className='ti'+(d.s==='pinned'?' pinned':d.s==='done'?' done':'');
 ti.textContent=d.t;div.appendChild(ti);
 if(d.p){const p=document.createElement('span');p.className='pill '+d.p;p.textContent=d.p;div.appendChild(p)}
 const meta=[];
 if(d.ms)meta.push('<b>'+ms(d.ms)+'</b>'+(d.oms&&d.oms!==d.ms?' ('+ms(d.oms)+')':''));
 if(d.tok)meta.push(n(d.tok)+' tok');
 if(d.run)meta.push(d.run+' run'+(d.run>1?'s':''));
 if(d.n>1)meta.push(d.n+' nodes');
 if(d.bar)meta.push(d.ev?d.ev+'/'+d.bar+' bars':d.bar+' bars');
 if(d.dep)meta.push(d.dep+' dep'+(d.dep>1?'s':''));
 if(d.last)meta.push(d.last);
 const m=document.createElement('span');m.className='m';m.innerHTML=meta.join(' · ');div.appendChild(m);
 const id=document.createElement('span');id.className='id';id.textContent=d.id.slice(0,8);div.appendChild(id);
 li.appendChild(div);
 if(kids){
  const ul=document.createElement('ul');ul.className='hidden';
  d.k.forEach(c=>ul.appendChild(row(c)));li.appendChild(ul);
  const flip=()=>{const h=ul.classList.toggle('hidden');tw.textContent=h?'▸':'▾'};
  tw.onclick=flip;ti.onclick=flip;
 }
 li.dataset.hay=(d.t+' '+d.id).toLowerCase();
 return li;
}
const tree=document.getElementById('tree');
DATA.forEach(d=>tree.appendChild(row(d)));
document.getElementById('q').addEventListener('input',e=>{
 const q=e.target.value.trim().toLowerCase();
 const walk=li=>{
  const kidUl=li.querySelector(':scope>ul');
  let hit=!q||li.dataset.hay.includes(q);
  let kidHit=false;
  if(kidUl)[...kidUl.children].forEach(c=>{if(walk(c))kidHit=true});
  const show=hit||kidHit;
  li.classList.toggle('hidden',!show);
  // A match deep in a subtree is useless if its ancestors stay collapsed.
  if(kidUl&&q&&kidHit){kidUl.classList.remove('hidden');
   const tw=li.querySelector(':scope>.n>.tw');if(tw)tw.textContent='▾'}
  return show;
 };
 [...tree.children].forEach(walk);
});
</script></body></html>")]
  (io/make-parents out)
  (spit out html)
  (println (str "north graph -> " out))
  (println (format "  %d threads · %s attributed · %s unattributed · %d pinned"
                   total-threads (human-ms total-ms) (human-ms adhoc) (count pinned))))
