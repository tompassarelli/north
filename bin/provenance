#!/usr/bin/env python3
"""provenance: refuse new gating bars without a Provenance record and list Target-debt due for revisit.

A bar gates only with `Provenance: <claim>; origin <tom|experiment|prior-art|incident>; pointer <...>;
rationale <path#anchor | not recorded>; revisit <...>` naming its number and unit. Ending `; soft` it does not
gate (origin none only then), and a miss lands with `Target-debt: <bar>; measured <value>; owner <owner>;
revisit <trigger>`, retired by `Target-paid: <commit>`."""
import argparse
from datetime import date
import json
from pathlib import Path
import re
import subprocess
import sys

OWNER = "tompassarelli"
UNIT = (r"(seconds|minutes|instructions|allocations|launches|frames|tokens|bytes|lines|units|sec|min|fps"
        r"|MiB|GiB|KiB|MB|KB|GB|ns|µs|us|ms|s|h|%)(?![\w])")
NUMBER = r"(\d[\d,]*(?:\.\d+)?)"
BAR = re.compile(
    r"(?:(?<![\w])(?i:(at least))\s+" + NUMBER + r"\s*[×x]\s+(?i:fewer)\s+" + UNIT + r")"
    r"|(?:(?<![\w])(?i:(at or under|at most|no more than|less than|faster than|under|below|within))\s+"
    r"|(<=|≤|<)\s*)" + NUMBER + r"\s*" + UNIT)
QUANTITY = re.compile(r"(?<![\w.])" + NUMBER + r"\s*(?:[×x]\s+(?i:fewer)\s+)?" + UNIT)
COMPARATOR = {"<=": "at most", "≤": "at most", "at or under": "at most", "no more than": "at most",
              "<": "under", "less than": "under", "below": "under", "at least": "at least x fewer"}
UNITS = {"sec": "s", "seconds": "s", "minutes": "min", "µs": "us"}
PLAN = re.compile(r"(^|/)PLAN[^/]*\.md$")
BOX = re.compile(r"^\s*[-*] \[ \]")
RECORD = re.compile(r"^Provenance:\s*(.+)$", re.M)
ORIGINS = {"tom", "experiment", "prior-art", "incident"}
DEBT = re.compile(r"^Target-debt:\s*(.+)$", re.M)
PAID = re.compile(r"^Target-paid:\s*([0-9a-f]{7,40})", re.M)
FORMS = ("Provenance: <claim with the bar>; origin <tom|experiment|prior-art|incident|none>; "
         "pointer <quote with date | run file plus rerun command | link | issue>; "
         "rationale <repo path#anchor | not recorded>; "
         "revisit <YYYY-MM-DD | closed REPO#N | event text>, ending ; soft for a bar that does not gate "
         "(origin none only then)")


def fields(value):
    parts = [f.strip() for f in value.split(";")]
    named = dict(f.split(None, 1) for f in parts[1:] if len(f.split(None, 1)) == 2)
    return parts[0], named, parts[-1] == "soft"


def quantity(number, unit):
    return f"{float(number.replace(',', '')):g}", UNITS.get(unit, unit)


def bars(text):
    found = []
    for m in BAR.finditer(text):
        if m.group(1):
            comparator, number, unit = m.group(1), m.group(2), m.group(3)
        else:
            comparator, number, unit = m.group(4) or m.group(5), m.group(6), m.group(7)
        comparator = comparator.lower()
        found.append((COMPARATOR.get(comparator, comparator), *quantity(number, unit), m.group(0)))
    return found


def gating(path, line):
    return (PLAN.search(path) and line.lstrip().startswith("|")) or "Done when" in line or BOX.match(line)


def git(*args, cwd=None):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def new_bars(base, head):
    try:
        base = git("merge-base", base, head).strip()
    except subprocess.CalledProcessError:
        pass
    added, removed, path, header = [], set(), "", False
    for line in git("diff", "--unified=0", "--no-color", "--no-ext-diff", "--no-renames", base, head).splitlines():
        if line.startswith("diff --git "):
            header = True
        elif header and line.startswith("--- "):
            path = line[6:] if line.startswith("--- a/") else path
        elif header and line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else path
            header = False
        elif not header and line.startswith("-"):
            removed.update((path, *bar[:3]) for bar in bars(line[1:]))
        elif not header and line.startswith("+") and gating(path, line[1:]):
            added.extend((path, bar, line[1:].strip()) for bar in bars(line[1:]))
    covered = set()
    for value in RECORD.findall(git("log", "--format=%B", f"{base}..{head}")):
        claim, named, soft = fields(value)
        if "rationale" in named and (named.get("origin") in ORIGINS or soft and named.get("origin") == "none"):
            covered.update(quantity(*q) for q in QUANTITY.findall(claim))
    return list(dict.fromkeys((path, bar, line) for path, bar, line in added
                              if (path, *bar[:3]) not in removed and bar[1:3] not in covered))


def check(a):
    missing = new_bars(a.base, a.head)
    for path, bar, line in missing:
        print(f"{path}\t{bar[3]}\t{line}")
    if missing:
        print(f"provenance: {len(missing)} new gating bars have no Provenance record; add {FORMS}", file=sys.stderr)
    return 1 if missing else 0


def due(revisit):
    m = re.fullmatch(r"closed\s+([\w.-]+)#(\d+)", revisit)
    if m:
        state = subprocess.run(["gh", "issue", "view", m.group(2), "-R", f"{OWNER}/{m.group(1)}", "--json", "state"],
                               capture_output=True, text=True)
        return state.returncode == 0 and json.loads(state.stdout)["state"] == "CLOSED"
    try:
        return date.fromisoformat(revisit) <= date.today()
    except ValueError:
        return True


def debts(repo):
    try:
        log = git("log", "origin/main", "-z", "--format=%H%x00%B", cwd=repo).split("\0")
    except subprocess.CalledProcessError:
        return
    commits = list(zip(log[0::2], log[1::2]))
    paid = [sha for _, body in commits for sha in PAID.findall(body)]
    for sha, body in commits:
        if any(sha.startswith(p) for p in paid):
            continue
        for value in DEBT.findall(body):
            bar, named, _ = fields(value)
            yield sha, bar, named.get("measured", ""), named.get("owner", ""), named.get("revisit", "")


def debt(a):
    repos = [Path(r) for r in a.repo] or sorted((Path.home() / "code").glob("*/main"))
    for repo in repos:
        name = repo.resolve().parent.name if repo.resolve().name == "main" else repo.resolve().name
        for sha, bar, measured, owner, revisit in debts(repo):
            if not a.due or due(revisit):
                print("\t".join((name, sha[:12], bar, measured, owner, revisit)))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="command", required=True)
    c = sub.add_parser("check", help="list new bars in gating places of BASE..HEAD without a Provenance record")
    c.add_argument("base")
    c.add_argument("head")
    c.set_defaults(run=check)
    d = sub.add_parser("debt", help="list Target-debt trailers on origin/main not named by a Target-paid")
    d.add_argument("--due", action="store_true", help="only rows whose revisit date passed or issue closed, and every event text")
    d.add_argument("--repo", action="append", default=[], help="repository path (default ~/code/*/main)")
    d.set_defaults(run=debt)
    a = p.parse_args(argv)
    return a.run(a)


if __name__ == "__main__":
    sys.exit(main())
