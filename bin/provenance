#!/usr/bin/env python3
"""provenance: audit recorded grounding, refuse new steering without provenance, and list Target-debt.

A bar gates only with `Provenance: <claim>; origin <tom|experiment|prior-art|incident>; pointer <...>;
rationale <path#anchor | not recorded>; revisit <...>` naming its number and unit. Ending `; soft` it does not
gate (origin none only then), and a miss lands with `Target-debt: <bar>; measured <value>; owner <owner>;
revisit <trigger>`, retired by `Target-paid: <commit>`."""
import argparse
from datetime import date, datetime, timezone
import json
import os
from pathlib import Path
import re
import shlex
import sqlite3
import subprocess
import sys
import tomllib

OWNER = "tompassarelli"
UNIT = (r"(seconds|minutes|instructions|allocations|launches|frames|tokens|bytes|lines|units|sec|min|fps"
        r"|MiB|GiB|KiB|MB|KB|GB|ns|µs|us|ms|s|h|%)(?![\w])")
NUMBER = r"(\d[\d,]*(?:\.\d+)?)"
BAR = re.compile(
    r"(?:(?<![\w])(?i:(at least))\s+" + NUMBER + r"\s*[×x]\s+(?i:fewer)\s+" + UNIT + r")"
    r"|(?:(?<![\w])(?i:(at or under|at most|no more than|less than|faster than|under|below|within))\s+"
    r"|(<=|≤|<)\s*)" + NUMBER + r"\s*" + UNIT)
QUANTITY = re.compile(r"(?<![\w.])" + NUMBER + r"\s*(?:[×x]\s+(?i:fewer)\s+)?" + UNIT)
COMPARATOR = {"<=": "at most", "≤": "at most", "at or under": "at most", "no more than": "at most",
              "<": "under", "less than": "under", "below": "under", "at least": "at least x fewer"}
UNITS = {"sec": "s", "seconds": "s", "minutes": "min", "µs": "us"}
PLAN = re.compile(r"(^|/)PLAN[^/]*\.md$")
BOX = re.compile(r"^\s*[-*] \[ \]")
RECORD = re.compile(r"^Provenance:\s*(.+)$", re.M)
ORIGINS = {"tom", "experiment", "prior-art", "incident"}
DEBT = re.compile(r"^Target-debt:\s*(.+)$", re.M)
PAID = re.compile(r"^Target-paid:\s*([0-9a-f]{7,40})", re.M)
FORMS = ("Provenance: <claim with the bar>; origin <tom|experiment|prior-art|incident|none>; "
         "pointer <quote with date | run file plus rerun command | link | issue>; "
         "rationale <repo path#anchor | not recorded>; "
         "revisit <YYYY-MM-DD | closed REPO#N | event text>, ending ; soft for a bar that does not gate "
         "(origin none only then)")


def fields(value):
    parts = [f.strip() for f in value.split(";")]
    named = dict(f.split(None, 1) for f in parts[1:] if len(f.split(None, 1)) == 2)
    return parts[0], named, parts[-1] == "soft"


def quantity(number, unit):
    return f"{float(number.replace(',', '')):g}", UNITS.get(unit, unit)


def bars(text):
    found = []
    for m in BAR.finditer(text):
        if m.group(1):
            comparator, number, unit = m.group(1), m.group(2), m.group(3)
        else:
            comparator, number, unit = m.group(4) or m.group(5), m.group(6), m.group(7)
        comparator = comparator.lower()
        found.append((COMPARATOR.get(comparator, comparator), *quantity(number, unit), m.group(0)))
    return found


def gating(path, line):
    return (PLAN.search(path) and line.lstrip().startswith("|")) or "Done when" in line or BOX.match(line)


def git(*args, cwd=None):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def new_bars(base, head):
    try:
        base = git("merge-base", base, head).strip()
    except subprocess.CalledProcessError:
        pass
    added, removed, path, header = [], set(), "", False
    for line in git("diff", "--unified=0", "--no-color", "--no-ext-diff", "--no-renames", base, head).splitlines():
        if line.startswith("diff --git "):
            header = True
        elif header and line.startswith("--- "):
            path = line[6:] if line.startswith("--- a/") else path
        elif header and line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else path
            header = False
        elif not header and line.startswith("-"):
            removed.update((path, *bar[:3]) for bar in bars(line[1:]))
        elif not header and line.startswith("+") and gating(path, line[1:]):
            added.extend((path, bar, line[1:].strip()) for bar in bars(line[1:]))
    covered = set()
    for value in RECORD.findall(git("log", "--format=%B", f"{base}..{head}")):
        claim, named, soft = fields(value)
        if "rationale" in named and (named.get("origin") in ORIGINS or soft and named.get("origin") == "none"):
            covered.update(quantity(*q) for q in QUANTITY.findall(claim))
    return list(dict.fromkeys((path, bar, line) for path, bar, line in added
                              if (path, *bar[:3]) not in removed and bar[1:3] not in covered))


def valid_record(value):
    claim, named, soft = fields(value)
    rationale = named.get("rationale", "")
    return bool(claim and all(named.get(k) for k in ("pointer", "rationale", "revisit"))
                and (rationale == "not recorded" or re.fullmatch(r"[^\s#]+#[^\s#]+", rationale))
                and (named.get("origin") in ORIGINS or soft and named.get("origin") == "none"))


def rule_text(line):
    return " ".join(re.sub(r"^\s*(?:[-*] |\d+[.)] )", "", line).replace("`", "").split())


def policy_line(path, line):
    name = Path(path).name
    return ((name in ("AGENTS.md", "SKILL.md", "doctrine.md")
             and line.strip() and not line.lstrip().startswith(("#", "```", "---"))
             and not re.match(r"^[\w-]+:", line))
            or path == "harness/policy-owners.toml" and "unit =" in line
            or name == "catalog-config.json" and re.search(r'"kind"\s*:\s*"hook"', line))


def new_rules(base, head):
    base = git("merge-base", base, head).strip()
    records = [fields(v)[0] for v in RECORD.findall(git("log", "--format=%B", f"{base}..{head}"))
               if valid_record(v)]
    claims = [rule_text(c) for c in records]
    added, removed, path, fresh, header = [], set(), "", False, False
    for line in git("diff", "--unified=0", "--no-color", "--no-ext-diff", "--no-renames", base, head).splitlines():
        if line.startswith("diff --git "):
            header, fresh = True, False
        elif header and line.startswith("--- "):
            fresh = line == "--- /dev/null"
        elif header and line.startswith("+++ "):
            path, header = line[6:], False
            hook = (fresh and "/hooks/" in "/" + path and "/lib/" not in path
                    and "/fixtures/" not in path and ".test." not in path)
            if hook:
                added.append((path, "new hook", path))
        elif not header and line.startswith("-") and policy_line(path, line[1:]):
            removed.add((path, rule_text(line[1:])))
        elif not header and line.startswith("+") and policy_line(path, line[1:]):
            added.append((path, "new policy line", line[1:].strip()))
    return list(dict.fromkeys((path, kind, text) for path, kind, text in added
                             if (path, rule_text(text)) not in removed
                             and not any(path in c or rule_text(text) in c for c in claims)))


def check(a):
    missing = new_bars(a.base, a.head)
    rules = new_rules(a.base, a.head)
    for path, bar, line in missing:
        print(f"{path}\t{bar[3]}\t{line}")
    for path, kind, line in rules:
        print(f"{path}\t{kind}\t{line}")
    if missing:
        print(f"provenance: {len(missing)} new gating bars have no Provenance record; add {FORMS}", file=sys.stderr)
    if rules:
        print(f"provenance: {len(rules)} new hooks or policy lines have no valid Provenance record; "
              f"name the rule or its source path in the claim; add {FORMS}", file=sys.stderr)
    return 1 if missing or rules else 0


def due(revisit):
    m = re.fullmatch(r"closed\s+([\w.-]+)#(\d+)", revisit)
    if m:
        state = subprocess.run(["gh", "issue", "view", m.group(2), "-R", f"{OWNER}/{m.group(1)}", "--json", "state"],
                               capture_output=True, text=True)
        return state.returncode == 0 and json.loads(state.stdout)["state"] == "CLOSED"
    try:
        return date.fromisoformat(revisit) <= date.today()
    except ValueError:
        return True


def debts(repo):
    try:
        log = git("log", "origin/main", "-z", "--format=%H%x00%B", cwd=repo).split("\0")
    except subprocess.CalledProcessError:
        return
    commits = list(zip(log[0::2], log[1::2]))
    paid = [sha for _, body in commits for sha in PAID.findall(body)]
    for sha, body in commits:
        if any(sha.startswith(p) for p in paid):
            continue
        for value in DEBT.findall(body):
            bar, named, _ = fields(value)
            yield sha, bar, named.get("measured", ""), named.get("owner", ""), named.get("revisit", "")


def debt(a):
    repos = [Path(r) for r in a.repo] or sorted((Path.home() / "code").glob("*/main"))
    for repo in repos:
        name = repo.resolve().parent.name if repo.resolve().name == "main" else repo.resolve().name
        for sha, bar, measured, owner, revisit in debts(repo):
            if not a.due or due(revisit):
                print("\t".join((name, sha[:12], bar, measured, owner, revisit)))
    return 0


def stamp(value):
    try:
        d = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return d if d.tzinfo else d.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def releases(path):
    result = {}
    if not path.is_file():
        return result
    try:
        with sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True) as db:
            for model, at in db.execute("SELECT model,at FROM model_events WHERE kind='released' AND at IS NOT NULL"):
                model = model.split(":", 1)[-1]
                if stamp(at) and (model not in result or stamp(at) < stamp(result[model])):
                    result[model] = at
    except sqlite3.Error:
        pass
    return result


def evidence(repo, pointer):
    try:
        parts = shlex.split(pointer)
        if not parts:
            return {}
        path = Path(parts[0]).expanduser()
        path = path if path.is_absolute() else repo / path
        if path.suffix == ".toml":
            value = tomllib.loads(path.read_text())
        elif path.suffix == ".json":
            value = json.loads(path.read_text())
        elif path.suffix == ".jsonl":
            rows = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
            scored = [r for r in rows if isinstance(r, dict) and r.get("pass") is not None and "trial" in r]
            models = {r.get("model_resolved") or r.get("model") for r in scored}
            return {"n": len(scored), "model": next(iter(models)) if len(models) == 1 else ""} if scored else {}
        else:
            return {}
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def fired(revisit, events):
    if revisit in events:
        return True
    if re.fullmatch(r"closed\s+([\w.-]+)#(\d+)", revisit):
        return due(revisit)
    try:
        return date.fromisoformat(revisit) <= date.today()
    except ValueError:
        return False


def audit(a):
    release = releases(Path(a.db).expanduser())
    rows, triggers = [], {}
    repos = [Path(r) for r in a.repo] or sorted((Path.home() / "code").glob("*/main"))
    for repo in repos:
        name = repo.resolve().parent.name if repo.resolve().name == "main" else repo.resolve().name
        try:
            log = git("log", "origin/main", "-z", "--format=%H%x00%B", cwd=repo).split("\0")
        except subprocess.CalledProcessError:
            continue
        for sha, body in zip(log[0::2], log[1::2]):
            for value in RECORD.findall(body):
                claim, named, _ = fields(value)
                origin = named.get("origin", "none recorded")
                if origin not in ORIGINS | {"none"}:
                    origin = "none recorded"
                rationale = named.get("rationale") or "rationale not recorded"
                pointer, revisit = named.get("pointer", ""), named.get("revisit", "")
                info = evidence(repo, pointer) if origin == "experiment" else {}
                runs, at, model = info.get("n", ""), info.get("date") or "", info.get("model", "")
                model = model if isinstance(model, str) else ""
                released = release.get(model.split(":", 1)[-1], "")
                reasons, ranks = [], []
                if rationale in ("not recorded", "rationale not recorded"):
                    reasons.append("rationale not recorded")
                    ranks.append(1)
                if origin in ("none", "none recorded"):
                    reasons.append("none recorded")
                    ranks.append(1)
                if revisit and revisit not in triggers:
                    triggers[revisit] = fired(revisit, a.event)
                if triggers.get(revisit):
                    reasons.append("fired trigger")
                    ranks.append(2)
                if origin == "experiment" and (runs == 1 or re.search(r"\b(?:single[ -]run|1 run)\b", pointer, re.I)):
                    reasons.append("single-run evidence")
                    ranks.append(3)
                if stamp(at) and stamp(released) and stamp(at) < stamp(released):
                    reasons.append("evidence older than model")
                    ranks.append(4)
                priority = min(ranks, default=5)
                rows.append((priority, name, sha, claim, origin, pointer, rationale, revisit,
                             str(runs), str(at), model, released, "; ".join(reasons)))
    print("\t".join(("repo", "commit", "priority", "reasons", "claim", "origin", "pointer", "rationale",
                      "revisit", "runs", "evidence_date", "model", "release_date")))
    for priority, name, sha, claim, origin, pointer, rationale, revisit, runs, at, model, released, reasons in sorted(rows):
        print("\t".join((name, sha[:12], str(priority), reasons, claim, origin, pointer, rationale,
                          revisit, runs, at, model, released)))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="command", required=True)
    c = sub.add_parser("check", help="list new gating bars, hooks and policy lines without a Provenance record")
    c.add_argument("base")
    c.add_argument("head")
    c.set_defaults(run=check)
    d = sub.add_parser("debt", help="list Target-debt trailers on origin/main not named by a Target-paid")
    d.add_argument("--due", action="store_true", help="only rows whose revisit date passed or issue closed, and every event text")
    d.add_argument("--repo", action="append", default=[], help="repository path (default ~/code/*/main)")
    d.set_defaults(run=debt)
    u = sub.add_parser("audit", help="rank recorded claims for re-grounding using their evidence and model release dates")
    u.add_argument("--repo", action="append", default=[], help="repository path (default ~/code/*/main)")
    u.add_argument("--db", default=os.environ.get("THREADS_DB") or str(Path.home() / ".local/state/threads/threads.db"),
                   help="read-only model_events store")
    u.add_argument("--event", action="append", default=[], help="exact recorded event trigger that fired")
    u.set_defaults(run=audit)
    a = p.parse_args(argv)
    return a.run(a)


if __name__ == "__main__":
    sys.exit(main())
