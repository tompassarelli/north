#!/usr/bin/env python3
"""issue-box-lint: flag unchecked Done when boxes that hand Tom a mechanical check or a bar without provenance.

Tom verifies only direction choices and feel or taste judgments; agents check the rest
on VM pairs and native capture. A bar names its origin or is marked soft."""
import argparse
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import re
import subprocess
import sys

OWNER = "tompassarelli"
BOX = re.compile(r"^\s*[-*] \[ \]\s*(.+)$", re.M)
VERIFIER = re.compile(
    r"\bTom(?:'s)?\s+(?:tries|tests?|checks?|confirms?|verifies|plays|playtests?|launches|(?:next\s+)?(?:launch|playtest|play session))\b"
    r"|\b(?:proof|check|checked|verified|tested|confirmed)\s*\([^)]*\bTom\b(?!'s (?:machine|laptop))"
    r"|\bon (?:his|Tom's) (?:pad|controller)\b"
    r"|\bin (?:his|Tom's) (?:next )?playtest\b", re.I)
MECHANICAL = re.compile(
    r"\b(?:pad|input|controller|button|keys?|cursor|binds?|hitbox(?:es)?|sizes?|scale|frames?|timing|fps|sounds?|audio|"
    r"menus?|lists?|appears?|loads?|launch(?:es)?|starts?|prints|builds on|installs?|works?|crash(?:es)?)\b", re.I)
JUDGMENT = re.compile(r"\b(?:feel|taste|fun|looks?|reads? well|direction|prefers?|likes?)\b", re.I)
SOURCED = re.compile(r"\borigin (?:tom|experiment|prior-art|incident)\b|\bsoft\b")
provenance = SourceFileLoader("provenance", str(Path(__file__).resolve().with_name("provenance"))).load_module()


def flagged(body):
    return [box for box in BOX.findall(body or "")
            if VERIFIER.search(box) and MECHANICAL.search(JUDGMENT.sub("", box))
            or provenance.bars(box) and not SOURCED.search(box)]


def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=True).stdout


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("issues", nargs="*", help="REPO#N")
    p.add_argument("--repo", action="append", default=[], help="lint every open issue in REPO")
    a = p.parse_args(argv)
    issues = []
    for item in a.issues:
        repo, number = item.split("#")
        body = json.loads(gh("issue", "view", number, "-R", f"{OWNER}/{repo}", "--json", "body"))["body"]
        issues.append((item, body))
    for repo in a.repo:
        for i in json.loads(gh("issue", "list", "-R", f"{OWNER}/{repo}", "--state", "open", "--limit", "500",
                               "--json", "number,body")):
            issues.append((f"{repo}#{i['number']}", i["body"]))
    count = 0
    for item, body in issues:
        for box in flagged(body):
            count += 1
            print(f"{item}\t{box}")
    print(f"issue-box-lint: {count} boxes hand Tom a mechanical check (agents verify them on VM pairs and native capture)"
          " or name a bar without an origin or soft", file=sys.stderr)
    return 1 if count else 0


if __name__ == "__main__":
    sys.exit(main())
