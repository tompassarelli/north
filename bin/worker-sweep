#!/usr/bin/env bash
# worker-sweep: Claude Code and Codex workers of one session with their tier,
# context, minutes running and minutes idle. Flags STALLED (idle 10+ minutes
# while running), OVERTIME (running 45+ minutes or twice ETA), HANDOFF (context 350k+) and PARKED (a pending safe-push, watch,
# sleep or farm wait over parked_wait_s in harness/defaults.toml). Each pass records the session's
# finished workers as runs in NorthThreads (worker-ledger) while it sweeps, then appends one WAIT
# line per serialized long wait: landing queue, GitHub Actions queue, serial
# debugging and GPU serialization, and one PARKED line per parked worker.
# Stall recovery: a STALLED, OVERTIME or HANDOFF worker gets one nudge; still flagged 10+ minutes later, a
# Follows: handoff brief sent to the Fleet parent; if that successor is flagged too, the same one tier up.
# Each closed stall is logged to agents/worker-sweep/stalls.jsonl.
# CAPACITY: a Codex session whose last turn failed with "Selected model is at capacity" gets "continue"
# resent after 1, 2 and 4 minutes, on gpt-6-astra medium while `agents plan` allows that fallback (Sol is probed
# again on the next turn and kept once it answers); after 3 failures it reports `CAPACITY <worker>: fall back` to
# the next tier in the plan's escalation. Retries, fallbacks, switch-backs and restaffs go to
# agents/worker-sweep/capacity.jsonl with their model and effort, and worker-ledger --summary counts them.
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
usage: worker-sweep [--session ID] [--wait]
  --session ID  sweep that session's workers (default: the newest session)
  --wait        sweep every 15 minutes; print the table and exit once a worker or wait is flagged
EOF
  exit 2
}

session="" wait=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session) [ $# -ge 2 ] || usage; session=$2; shift 2 ;;
    --wait) wait=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
if [ -n "$session" ]; then
  dir=$(find "$projects" -mindepth 3 -maxdepth 3 -type d -path "*/$session/subagents" -print -quit 2>/dev/null)
else
  dir=$(find "$projects" -mindepth 3 -maxdepth 3 -type d -name subagents -printf '%T@ %p\n' 2>/dev/null |
    sort -rn | head -n 1 | cut -d' ' -f2-)
fi
ledger="$(dirname "$(readlink -f "$0")")/worker-ledger"
LEDGER_CONTEXT_PY="$(dirname "$(readlink -f "$0")")/../harness/lib/ledger_context.py"
export LEDGER_CONTEXT_PY
DEFAULTS=$(python3 -I -c 'import json, sys; sys.path.insert(0, sys.argv[1]); from defaults import DEFAULTS; print(json.dumps(DEFAULTS))' "$(dirname "$(readlink -f "$0")")/../harness/lib") || exit 1
session_id=${session:-$(basename "$(dirname "$dir")")}

codex() {
  python3 - "$ledger" "$session_id" "$1" "${2:-}" <<'PYCODEX'
import json, os, re, sqlite3, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

ledger, session, mode, table = sys.argv[1:]
os.environ["LEDGER_CONTEXT_PY"] = str(Path(ledger).resolve().parent.parent / "harness/lib/ledger_context.py")
sys.path.insert(0, str(Path(ledger).resolve().parent.parent / "harness/lib"))
import provider_capacity
from defaults import DEFAULTS
since = "1970-01-01T00:00:00Z"
source = Path(ledger).read_text()
start = source.index('root = Path(os.environ.get("CODEX_CONFIG_DIR",')
end = source.index('\nfor path in candidates:\n    meta,', start)
exec(source[start:end])

selected = {session} if session in paths else set()
try:
    fleet = json.loads(subprocess.check_output(["north", "fleet", "list", "--json"], text=True))
    nodes = [dict(id=n["name"], session=n["conversation"], parent=n.get("parent"),
                  provider=n["provider"], state=n["status"], cwd=n["cwd"]) for n in fleet]
except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, KeyError):
    nodes = []
fleet_names = {n["session"]: n["id"] for n in nodes}
fleet_by_id = {n["session"]: n for n in nodes}
supervisors = {n["parent"] for n in nodes if n.get("parent")} | {n["id"] for n in nodes if n.get("session") == session}
parents = {n["id"] for n in nodes if n.get("session") == session}
while parents:
    children = [n for n in nodes if n.get("parent") in parents]
    selected.update(n["session"] for n in children if n.get("provider") == "codex"
                    and n.get("state") != "exited" and n.get("session") in paths)
    parents = {n["id"] for n in children} - parents
if mode == "sessions":
    print("\n".join(sorted(selected)))
    sys.exit(0)
if not selected:
    sys.exit(0)

if state.exists():
    db = sqlite3.connect(f"file:{state}?mode=ro", uri=True)
    candidates = [path for source, path in db.execute("SELECT source, rollout_path FROM threads WHERE archived = 0")
                  if any(parent in source for parent in selected)]
    db.close()
candidates = list(dict.fromkeys([*candidates, *(paths[lead] for lead in selected)]))
now = time.time()
threads = []
metadata_flags = []
for lead in sorted(selected):
    turns = list(provider_capacity.turns(records(paths[lead])))
    if turns:
        name = next((n["id"] for n in nodes if n.get("session") == lead), lead)
        threads.append(dict(id=lead, name=name, at=turns[-1][0], model=turns[-1][1], effort=turns[-1][2], outcome=turns[-1][3],
                            running=any(r.get("type") == "event_msg" and r.get("payload", {}).get("type") == "task_started"
                                        and r.get("timestamp", "") > turns[-1][0] for r in records(paths[lead]))))
for path in candidates:
    meta = next((r["payload"] for r in records(path) if r.get("type") == "session_meta"), None)
    if not meta:
        continue
    source = meta.get("source", {})
    spawn = source.get("subagent", {}).get("thread_spawn", {}) if isinstance(source, dict) else {}
    parent = spawn.get("parent_thread_id") or meta.get("parent_thread_id")
    if parent not in selected and meta["id"] not in selected:
        continue
    name = spawn.get("agent_path") or meta.get("agent_path") or meta["id"]
    assignment = briefs(parent).get(name, {}) if parent else {}
    brief = assignment.get("message", "")
    model, effort = models.get(meta["id"], (None, None))
    model, effort = assignment.get("model") or model, assignment.get("reasoning_effort") or effort
    staffed = assignment.get("staffed") or meta["timestamp"]
    ended, final, context, pending, capacity, turn = meta["timestamp"], False, 0, None, None, None
    for r in records(path):
        p, kind = r.get("payload", {}), r.get("type")
        ended = r.get("timestamp") or ended
        if kind == "turn_context":
            model, effort = p.get("model") or model, p.get("effort") or effort
        elif kind == "response_item":
            if p.get("type") == "message" and p.get("role") == "user":
                final = False
                if "ETA" in texts(p):
                    brief = texts(p)
            elif p.get("type") == "message" and p.get("role") == "assistant":
                final = p.get("phase") == "final"
            elif p.get("type") in ("function_call", "custom_tool_call"):
                final = False
                pending = (p.get("call_id"), r.get("timestamp"), str(p.get("arguments") or p.get("input") or ""))
            elif p.get("type") in ("function_call_output", "custom_tool_call_output"):
                if pending and p.get("call_id") == pending[0]:
                    pending = None
        elif kind == "event_msg":
            if p.get("type") in ("task_started", "user_message"):
                final = False
                pending = None
                capacity = None
            elif p.get("type") == "task_complete":
                final = not provider_capacity.at_capacity(p)
                capacity = None if final else r.get("timestamp")
                turn = dict(at=r.get("timestamp"), model=model, effort=effort, outcome="capacity" if capacity else "error" if p.get("error") else "ok")
            elif p.get("type") == "token_count" and p.get("info"):
                context = p["info"].get("last_token_usage", {}).get("input_tokens", context)
    name = name.rsplit("/", 1)[-1]
    supervisor = fleet_names.get(meta["id"]) in supervisors
    sys.path.insert(0, str(Path(ledger).resolve().parent.parent / "harness/hooks/lib"))
    from codex_behavior import registered_spawn_brief
    original = registered_spawn_brief(parent, name, meta["id"], spawn.get("agent_path") or meta.get("agent_path")) if parent else None
    spawn_fields = brief_contract["brief_fields"](original if original is not None else assignment.get("message", ""))
    missing = [key for key in ("category", *brief_contract["FACETS"]) if key not in spawn_fields]
    if parent and missing:
        responsible = next((n["id"] for n in nodes if n.get("session") == parent), parent)
        metadata_flags.append(f"spawn metadata missing {','.join(missing)}: lead {responsible} worker {meta['id']} ({name}); declare full facets before the next spawn")
    if turn or not final:
        threads.append(dict(turn or {"at": ended, "model": model, "effort": effort, "outcome": "running"},
                            id=meta["id"], name=name, running=not final and not capacity,
                            worker=(not supervisor and meta["id"] not in selected | {session}),
                            brief=brief, elapsed=max(0, now - stamp(staffed))))
    idle = max(0, int((now - stamp(ended)) / 60))
    ran = max(0, int(((stamp(ended) if final else now) - stamp(meta["timestamp"])) / 60))
    eta = re.search(r"(?i)\bETA\b[^0-9\n]{0,12}([0-9]+(?:\.[0-9]+)?)\s*(hours?|hrs?|h|minutes?|mins?|m)\b", brief)
    eta = float(eta[1]) * (60 if eta[2].lower().startswith("h") else 1) if eta else None
    parked = not final and pending and re.search(r"safe-push|gh run watch|sleep|until .*; do|farm test .*--wait", pending[2]) and now - stamp(pending[1]) > DEFAULTS["parked_wait_s"]
    if capacity:
        flags = ["CAPACITY"]
    elif supervisor:
        flags = ["HANDOFF"] if context >= DEFAULTS["parent_handoff_ctx"] else []
    else:
        flags = [] if final else (["STALLED"] if idle >= DEFAULTS["stall_idle_min"] else []) + (["OVERTIME"] if ran >= DEFAULTS["overtime_min"] or (eta is not None and ran >= DEFAULTS["overdue_ratio"] * eta) else []) + (["HANDOFF"] if context >= DEFAULTS["handoff_ctx"] else []) + (["PARKED"] if parked else [])
    if mode == "capacity":
        continue
    if mode == "parked":
        if parked and name in {line.split("\t")[0] for line in table.splitlines() if "PARKED" in line}:
            print(f"PARKED {name}: pending wait for {int((now - stamp(pending[1])) / 60)}m; land it from the parent in the background")
    else:
        fields = [name, f"{model or '?'} {effort or '?'}", f"ctx={context // 1000}k", f"ran={ran}m", f"idle={idle}m"]
        if eta is not None:
            fields.append(f"eta={eta:g}m")
        fields.append("finished" if final and not flags else ",".join(flags))
        print("\t".join(fields))

if mode == "rows":
    base = Path(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))) / "agents/worker-sweep"
    base.mkdir(parents=True, exist_ok=True)
    target = base / f"metadata-{session}.json"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(metadata_flags))
    temporary.replace(target)

BACKOFF = (1, 2, 4)
ASTRA = ("gpt-6-astra", "medium")


def fallback_tier(plan, tier):
    """The first usable escalation tier at or above the failed Codex tier's rank, on another model; a tier the plan
    doesn't list (on-request, unknown effort) ranks as its model's highest tier, else the highest Codex tier."""
    full, model = list(plan["tiers"]), tier.split(" ", 1)[0]
    rank = lambda pick: max((i for i, k in enumerate(full) if pick(k)), default=None)
    here = rank(lambda k: plan["tiers"][k] == tier)
    here = rank(lambda k: plan["tiers"][k].split(" ", 1)[0] == model) if here is None else here
    here = rank(lambda k: k.startswith("codex:")) if here is None else here
    return next((k for k in full[here or 0:] if k in plan["escalation"] and plan["tiers"][k].split(" ", 1)[0] != model), None)


def assumed_effort(plan, model):
    """The effort of the model's highest plan tier, else xhigh, so an unrecorded effort never retries below the failed turn."""
    efforts = [v.split(" ", 1)[1] for v in plan["tiers"].values() if v.split(" ", 1)[0] == model and " " in v]
    return efforts[-1] if efforts else "xhigh"


def capacity_step(state, threads, plan, now):
    """Pure capacity recovery: (state, lines, events, actions) for threads whose last turn hit a capacity error."""
    new, lines, events, actions = {}, [], [], []
    clock = lambda t: time.strftime("%H:%M", time.localtime(t))
    for t in threads:
        e = dict(state.get(t["id"], {}))
        name = t["name"]
        if t["outcome"] == "capacity" and not t["effort"]:
            t = dict(t, effort=assumed_effort(plan, t["model"]))
            lines.append(f"CAPACITY {name}: effort unknown; assumed {t['effort']}")
        if t["outcome"] == "capacity" and not t["running"]:
            e.setdefault("tries", 0), e.setdefault("at", 0), e.setdefault("tier", f"{t['model']} {t['effort']}")
            failed = provider_capacity.stamp(t["at"])
            new[t["id"]] = e
            if failed <= e["at"]:
                lines.append(f"CAPACITY {name}: retry {e['tries']}/3 sent at {clock(e['at'])}; waiting for its turn")
            elif e["tries"] >= len(BACKOFF):
                nxt = fallback_tier(plan, e["tier"])
                to = f"restaff on {nxt} ({plan['tiers'][nxt]})" if nxt else "no higher tier is available: recommend to Tom"
                lines.append(f"CAPACITY {name}: fall back: {to} with a brief starting\nFollows: {name} {e['tier']}")
                if not e.get("fell"):
                    e["fell"] = True
                    actions.append(("restaff", t["id"], *(plan["tiers"][nxt].split(" ", 1) if nxt else (None, None))))
                    events.append(dict(worker=name, run=t["id"], step="restaff",
                                       **dict(zip(("model", "effort"), plan["tiers"][nxt].split(" ", 1))) if nxt else {"model": None, "effort": None}))
            elif now < failed + BACKOFF[e["tries"]] * 60:
                lines.append(f"CAPACITY {name}: {t['model']} at capacity; retry {e['tries'] + 1}/3 at {clock(failed + BACKOFF[e['tries']] * 60)}")
            else:
                astra = t["model"] != ASTRA[0] and plan["fallback"] == "codex:astra"
                model, effort = ASTRA if astra else (t["model"], t["effort"])
                e.update(tries=e["tries"] + 1, at=now, on="astra" if astra else "same")
                actions.append(("send", t["id"], model, effort))
                events.append(dict(worker=name, run=t["id"], step="fallback" if astra else "retry", model=model, effort=effort))
                lines.append(f"CAPACITY {name}: Fleet parent replacement requested at {model} {effort}"
                             if astra else f"CAPACITY {name}: retry {e['tries']}/3 on {model} {effort}: resent continue")
        elif e and t["outcome"] == "ok" and not t["running"] and t["model"] == ASTRA[0] and e.get("on") == "astra":
            model, effort = e["tier"].split(" ", 1)
            actions.append(("model", t["id"], model, effort))
            lines.append(f"CAPACITY {name}: answered on {ASTRA[0]}; probing {e['tier']} on its next turn")
            new[t["id"]] = dict(e, on="probe")
        elif e and t["outcome"] == "ok" and t["model"] != ASTRA[0] and e.get("on") in ("astra", "probe"):
            events.append(dict(worker=name, run=t["id"], step="switch_back", model=t["model"], effort=t["effort"]))
            lines.append(f"CAPACITY {name}: {t['model']} answered; back on {t['model']} {t['effort']}")
        elif e and (t["running"] or t["outcome"] != "ok"):
            new[t["id"]] = e
    return new, lines, events, actions


if mode == "capacity":
    base = Path(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))) / "agents/worker-sweep"
    base.mkdir(parents=True, exist_ok=True)
    store = base / f"capacity-{session}.json"
    try:
        state = json.loads(store.read_text())
    except (OSError, ValueError):
        state = {}
    plan = {"fallback": None, "escalation": [], "tiers": {}}
    if any(t["outcome"] == "capacity" for t in threads) or state:
        try:
            snapshot = json.loads(subprocess.run(["agents", "plan", "--json"], capture_output=True, text=True, timeout=120).stdout)
            plan = {"fallback": snapshot.get("capacity", {}).get("codex", {}).get("fallback"),
                    "escalation": snapshot.get("escalation", []), "tiers": snapshot.get("tiers", {})}
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    state, lines, events, actions = capacity_step(state, threads, plan, now)
    for kind, tid, model, effort in actions:
        node = fleet_by_id.get(tid)
        if not node:
            continue
        current = next((t for t in threads if t["id"] == tid), {})
        recipient = node.get("parent") if kind == "restaff" or (kind in ("send", "model") and current.get("model") != model) else node["id"]
        if not recipient:
            lines.append(f"CAPACITY {node['id']}: Fleet parent unavailable for {kind} at {model} {effort}")
            continue
        message = "continue" if recipient == node["id"] else f"Capacity recovery for {node['id']}: launch a replacement Fleet child at {model} {effort}; preserve its Item, brief and lane."
        cmd = ["north", "fleet", "send", recipient, message]
        env = dict(os.environ)
        try:
            done = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=60)
            ok = done.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        if not ok:
            lines.append(f"CAPACITY {tid}: {' '.join(cmd)} failed; apply it from the parent")
    with (base / "capacity.jsonl").open("a") as log:
        for ev in events:
            log.write(json.dumps(dict(at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), session=session, **ev)) + "\n")
    import usage
    sys.path.insert(0, str(Path(ledger).resolve().parent.parent / "harness/hooks/lib"))
    import spawn_capacity
    try:
        verdict = json.loads(usage.gate_path().read_text()).get("codex", {})
        if now - verdict.get("epoch", 0) >= verdict.get("stale_min", 0) * 60:
            verdict = {}
    except (OSError, ValueError):
        verdict = {}
    active = [t for t in threads if t.get("worker") and t["running"]]
    account = spawn_capacity.billed_account("codex") or "codex"
    account_row = (verdict.get("accounts") or {}).get(account) or {}
    issued, failed = [], False
    for t in active:
        caps = []
        if isinstance(account_row.get("used_pct"), (int, float)) and isinstance(account_row.get("cap_pct"), (int, float)):
            caps.append((account_row["cap_pct"], account_row["used_pct"]))
        for cap, reading in caps:
            if reading < cap:
                continue
            try:
                measurement = usage.ledger_reservation("codex", t["model"], t["effort"], details=True)
                remaining = usage.remaining_p75(measurement or {}, t["elapsed"])
            except (OSError, ValueError, RuntimeError):
                remaining = None
            if remaining is not None and remaining <= max(0, cap - reading) / len(active):
                continue
            entry = state.setdefault(t["id"], {})
            if entry.get("hard_stop_at") is not None:
                continue
            hard = entry.get("soft_stop_at") is not None and usage.hard_stop_due(entry["soft_stop_at"], now, reading, cap)
            if entry.get("soft_stop_at") is not None and not hard:
                continue
            message = ("Wrap up now. Land what passes only if you are allowed to land; otherwise commit for parent review. "
                       "Durable harness workers must commit for parent review and never land. Commit WIP in your owned lane. "
                       "Write HANDOFF with state, branch and next step, then exit.")
            recipient = fleet_names.get(t["id"])
            if not recipient:
                lines.append(f"STOP {t['name']}: Fleet session unavailable for capacity delivery")
                failed = True
                break
            env = dict(os.environ)
            try:
                delivery = subprocess.run(["north", "fleet", "interrupt", recipient] if hard else ["north", "fleet", "send", recipient, message],
                                          env=env, capture_output=True, text=True, timeout=60)
                error = (delivery.stdout + delivery.stderr).strip() if delivery.returncode else ""
            except (OSError, subprocess.TimeoutExpired) as failure:
                error = str(failure)
            if error:
                lines.append(f"STOP {t['name']}: delivery failed: {error}")
                failed = True
                break
            entry["hard_stop_at" if hard else "soft_stop_at"] = now
            issued.append(usage.stop_event(session, t["name"], cap, reading, len(active), "hard" if hard else "graceful"))
            break
        if failed:
            break
    seen_file = base / f"stops-seen-{session}"
    try:
        seen = seen_file.read_text().strip()
    except OSError:
        seen = ""
    try:
        stops = [json.loads(line) for line in (usage.gate_path().parent / "worker-sweep/stops.jsonl").read_text().splitlines()]
    except (OSError, ValueError):
        stops = []
    for event in stops:
        if event.get("at", "") > seen and event.get("session") in selected | {t["id"] for t in threads} | {session}:
            lines.append(f"STOP {event['worker']}: {event['mode']} cap={event['cap']:g} reading={event['reading']:g} "
                         f"in_flight={event['in_flight']} at={event['at']}")
            seen = event["at"]
    if seen:
        seen_file.write_text(seen + "\n")
    store.write_text(json.dumps(state))
    if lines or any(t["outcome"] != "running" for t in threads):
        print("\n".join(lines))
    if failed:
        sys.exit(1)
    if issued:
        sys.exit(2)
PYCODEX
}

codex_sessions=$(codex sessions) || exit 1
if { [ -z "$dir" ] || [ ! -d "$dir" ]; } && [ -z "$codex_sessions" ]; then
  printf 'worker-sweep: no subagents directory for session %s under %s\n' "${session:-<newest>}" "$projects" >&2
  exit 1
fi

sweep() {
  local now f id tier
  now=$(date +%s)
  for f in "$dir"/agent-*.jsonl; do
    [ -n "$dir" ] && [ -e "$f" ] || continue
    id=$(basename "$f" .jsonl)
    id=${id#agent-}
    tier=$(jq -r '.agentType // empty' "${f%.jsonl}.meta.json" 2>/dev/null)
    jq -rRn --arg id "$id" --arg tier "$tier" --argjson now "$now" --argjson DEFAULTS "$DEFAULTS" '
      def ctx: (.message.usage // {}) | ((.input_tokens//0)+(.cache_read_input_tokens//0)+(.cache_creation_input_tokens//0));
      def ts: sub("\\.[0-9]+Z$";"Z") | fromdate;
      def texts: [(.message.content | if type=="array" then .[] | select(.type=="text") | .text else tostring end)] | join(" ");
      [inputs] as $raw
      | [$raw[] | fromjson? | select(type=="object")] as $lines
      | [$lines[] | select(.type=="assistant" and .message.usage != null)] as $a
      | select(($a|length) > 0)
      | (if $tier != "" then $tier else ($a[-1].attributionAgent // "?") end) as $t
      | ($DEFAULTS["handoff_ctx"]) as $handoff_ctx
      | [$lines[] | select(.type=="user" or .type=="assistant" or (.type=="attachment" and .attachment.type=="queued_command"))] as $m
      | ($m[-1]) as $last
      | ($last.type=="assistant" and (($last.message.content|type)=="array") and ([$last.message.content[].type]|index("tool_use"))) as $pending
      | ($last.type=="user" and ((($last.message.content|tostring)|test("Request interrupted"))|not)) as $result
      | ($last.type=="attachment") as $notified
      | ([$lines[] | select(.type=="assistant") | .message.content | arrays | .[]
          | select(.type=="tool_use" and (.input.run_in_background==true)) | .id]) as $bg
      | ([$raw[] | select(contains("task-notification"))
          | scan("<tool-use-id>([^<]+)</tool-use-id>") | .[0]]) as $done
      | ([$bg[] | select(. as $b | $done | index($b) | not)] | length > 0) as $open_bg
      | ($last.type=="assistant" and (($last.message.content|type)=="array")
          and ([$last.message.content[].type] - ["thinking", "redacted_thinking"] | length == 0)) as $thinking
      | ($last.type=="assistant" and $open_bg and ($last|texts|length < 600)
          and ($last|texts|test("\\b(waiting|wait for|will be notified|notified when)\\b";"i"))) as $waiting
      | ([$lines[] | .timestamp // empty] | last | ts) as $t1
      | ([($now-$t1)/60, 0] | max | floor) as $idle
      | ($last.type=="assistant" and ($pending|not) and $idle>=$DEFAULTS["stall_idle_min"]
          and ($last|texts|test("^\\s*(Done|Not done|Blocked):")|not)) as $unreported
      | select(($t|startswith("worker")) and ($pending or $result or $notified or $thinking or $waiting or $unreported))
      | ($a[-1]|ctx) as $c
      | ([$lines[] | select(.type == "user")][0] | texts) as $brief
      | ($brief | [scan("(?i)\\bETA\\b[^0-9\\n]{0,12}([0-9]+(?:\\.[0-9]+)?)\\s*(hours?|hrs?|h|minutes?|mins?|m)\\b")] | first
         | if . == null then null else (.[0] | tonumber) * (if (.[1] | test("^h"; "i")) then 60 else 1 end) end) as $eta
      | ([$lines[] | .timestamp // empty] | first | ts) as $t0
      | ([$last.message.content | arrays | .[] | select(.type=="tool_use")] | last | .input.command // "") as $cmd
      | ($pending and ($cmd | test("safe-push|gh run watch|sleep|until .*; do|farm test .*--wait")) and (($now-($last.timestamp|ts)) > $DEFAULTS["parked_wait_s"])) as $parked
      | [ (if $idle>=$DEFAULTS["stall_idle_min"] then "STALLED" else empty end), (if (($now-$t0)/60)>=$DEFAULTS["overtime_min"] or ($eta != null and (($now-$t0)/60)>=$DEFAULTS["overdue_ratio"]*$eta) then "OVERTIME" else empty end), (if $c>=$handoff_ctx then "HANDOFF" else empty end), (if $parked then "PARKED" else empty end) ] as $flags
      | "\($id)\t\($t)\tctx=\($c/1000|floor)k\tran=\((($now-$t0)/60)|floor)m\tidle=\($idle)m\t\(if $waiting then "waiting-bg " else "" end)\($flags|join(","))"
    ' <"$f" 2>/dev/null
  done
  [ -z "$codex_sessions" ] || codex rows
}

record() {
  python3 -I "$(dirname "$ledger")/../harness/lib/usage.py" --burn-step codex
  "$ledger" --session "$session_id" >/dev/null 2>&1 &
  recording=$!
}

table() {
  sort -t= -k2 -nr | column -t -s $'\t'
}

recover() {
  python3 - "$1" "${dir:-}" "$session_id" <<'PYRECOVER'
import json, os, re, subprocess, sys, time
from pathlib import Path

NEXT = {"worker-haiku": "worker", "worker-sonnet": "worker", "worker": "worker-high", "worker-high": "worker-xhigh",
        "low": "medium", "medium": "high", "high": "xhigh"}
NUDGE = {"STALLED": "Report now: Done, Not done or Blocked, with what passed.",
         "OVERTIME": "Land what passes and write a complete handoff at a checkpoint now, then report.",
         "HANDOFF": "Land what passes and write a complete handoff at a checkpoint now, then report."}
GAP = 600


def up(tier):
    model, _, effort = tier.rpartition(" ")
    if model and not tier.startswith("worker"):
        return f"{model} {NEXT[effort]}" if effort in NEXT else None
    return NEXT.get(tier)


def step(state, rows, successors, now):
    state, steps, closed = {k: dict(v) for k, v in state.items()}, [], []
    flagged = {i: r for i, r in rows.items() if r["flags"]}
    for root, e in list(state.items()):
        while e["worker"] in successors:
            e["worker"], e["moved"] = successors[e["worker"]], True
        row = rows.get(e["worker"])
        evidence = f"{e['stage']} at {time.strftime('%H:%M', time.localtime(e['at']))}"
        if row and row["flags"]:
            if now - e["at"] < GAP or (e["stage"] != "nudged" and not e.get("moved")):
                continue
            if e["stage"] == "escalated":
                continue
            tier = row["tier"] if e["stage"] == "nudged" else up(row["tier"])
            e.update(stage="handed_off" if e["stage"] == "nudged" else "escalated", at=now, moved=False)
            if tier is None:
                steps.append(("stuck", e["worker"], None, f"{evidence}; no higher tier runs here: bring the supervisor one recommendation"))
            else:
                steps.append(("handoff" if e["stage"] == "handed_off" else "escalate", e["worker"], tier,
                              f"Follows: {e['worker']} {row['tier']}\nEvidence: {row['evidence']}; {evidence}, still flagged"))
        elif row or e.get("moved") or e["stage"] == "nudged":
            closed.append((root, {"nudged": "nudge", "handed_off": "handoff", "escalated": "escalation"}[e["stage"]], "closed"))
            del state[root]
        elif now - e["at"] > 86400:
            closed.append((root, {"handed_off": "handoff", "escalated": "escalation"}[e["stage"]], "lapsed"))
            del state[root]
    held = {e["worker"] for e in state.values()}
    for i, r in flagged.items():
        if i not in held and i not in state and i not in successors:
            state[i] = {"stage": "nudged", "worker": i, "at": now}
            steps.append(("nudge", i, r["tier"], " ".join(dict.fromkeys(NUDGE[f] for f in r["flags"]))))
    return state, steps, closed


table, transcripts, session = sys.argv[1:]
rows = {}
for line in table.splitlines():
    f = line.split("\t")
    if len(f) < 6 or f[-1] == "finished":
        continue
    flags = [x for x in re.split(r"[ ,]", f[-1]) if x in NUDGE]
    rows[f[0]] = {"tier": f[1], "flags": flags, "evidence": " ".join(x for x in f[2:] if x)}
successors = {}
for path in sorted(Path(transcripts).glob("agent-*.jsonl")) if transcripts else []:
    for raw in path.open():
        try:
            line = json.loads(raw)
        except ValueError:
            continue
        if isinstance(line, dict) and line.get("type") == "user":
            content = line.get("message", {}).get("content")
            text = content if isinstance(content, str) else " ".join(c.get("text", "") for c in content or [] if isinstance(c, dict))
            if m := re.search(r"\bFollows:[ \t]*([^\s`<>]+)", text):
                successors[m[1]] = path.stem.removeprefix("agent-")
            break

home = Path(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")))
base = home / "agents/worker-sweep"
base.mkdir(parents=True, exist_ok=True)
store = base / f"recovery-{session}.json"
try:
    state = json.loads(store.read_text())
except (OSError, ValueError):
    state = {}
now = time.time()
state, steps, closed = step(state, rows, successors, now)
try:
    fleet = json.loads(subprocess.check_output(["north", "fleet", "list", "--json"], text=True))
    nodes = [dict(id=n["name"], session=n["conversation"], parent=n.get("parent"), status=n["status"]) for n in fleet]
except (OSError, subprocess.CalledProcessError, ValueError, KeyError):
    nodes = []
parent = next((n.get("parent") for n in nodes if n.get("session") == session), None) or next((n["id"] for n in nodes if n.get("session") == session), session)
for kind, worker, tier, text in steps:
    if kind == "nudge":
        subprocess.run(["north", "fleet", "send", worker, text], check=False)
        print(f"RECOVER nudge {worker}: sent")
        continue
    if kind == "stuck":
        print(f"RECOVER stuck {worker}: {text}")
        continue
    brief = text
    how = f"north fleet send {parent}"
    subprocess.run(["north", "fleet", "send", parent, f"{kind} {worker} needs a fresh {tier}:\n{brief}"], check=False)
    print(f"RECOVER {kind} {worker}: sent to parent through Fleet\n{brief}")
with (base / "stalls.jsonl").open("a") as log:
    for root, stage, outcome in closed:
        print(f"RECOVER {outcome} {root} at {stage}")
        log.write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), "session": session,
                              "worker": root, "stage": stage, "outcome": outcome}) + "\n")
store.write_text(json.dumps(state))
PYRECOVER
}

safe_push_alive() {
  kill -0 "$1" 2>/dev/null && tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -q safe-push
}

wait_landing() {
  local now q t name holder lane age
  now=$(date +%s)
  for q in "${XDG_STATE_HOME:-$HOME/.local/state}"/safe-push/*.queue; do
    [ -d "$q" ] || continue
    holder=$(sed -n 's/^pid \([0-9]*\) .*/\1/p' "${q%.queue}.lock" 2>/dev/null)
    for t in "$q"/*; do
      name=${t##*/}
      [[ "$name" =~ ^([0-9]+)-([0-9]+)$ ]] || continue
      [ "${BASH_REMATCH[2]}" != "$holder" ] && [ ! -e "$t.result" ] || continue
      safe_push_alive "${BASH_REMATCH[2]}" || continue
      age=$(( (now - ${BASH_REMATCH[1]} / 1000000) / 60 ))
      [ "$age" -gt 10 ] || continue
      lane=$(cut -f1 "$t" 2>/dev/null)
      printf 'WAIT landing: safe-push %s for %s has waited %s minutes for the landing lock; check that train mode picked it up, since it should land in the holder'"'"'s train.\n' \
        "${BASH_REMATCH[2]}" "${lane:-an unknown lane}" "$age"
    done
  done
}

wait_parked() {
  local id
  while IFS= read -r id; do
    [ -n "$dir" ] && [ -n "$id" ] && [ -f "$dir/agent-$id.jsonl" ] || continue
    jq -rRn --arg id "$id" --argjson now "$(date +%s)" '
      def ts: sub("\\.[0-9]+Z$";"Z") | fromdate;
      [inputs | fromjson? | select(type=="object")] as $l
      | ([$l[] | select(.type=="user" or .type=="assistant" or (.type=="attachment" and .attachment.type=="queued_command"))] | last) as $last
      | ([$last.message.content | arrays | .[] | select(.type=="tool_use")] | last | .input.command // "") as $cmd
      | "PARKED \($id): \($cmd | .[0:80]) for \((($now-($last.timestamp|ts))/60)|floor)m; land it from the parent in the background"
    ' <"$dir/agent-$id.jsonl" 2>/dev/null
  done < <(awk -F'\t' '/PARKED/ {print $1}' <<<"$1")
  [ -z "$codex_sessions" ] || codex parked "$1"
}

wait_actions() {
  local repo json
  for repo in ${WORKER_SWEEP_REPOS:-tompassarelli/smashcraft tompassarelli/wisp}; do
    json=$(gh api "repos/$repo/actions/runs?status=queued&per_page=100" 2>/dev/null) || continue
    jq -r --arg repo "$repo" --argjson now "$(date +%s)" '
      (.total_count // 0) as $n
      | ([.workflow_runs[]?.created_at | fromdate] | min) as $oldest
      | (if $oldest == null then 0 else (($now - $oldest) / 60 | floor) end) as $age
      | select($n > 4 or $age > 10)
      | "WAIT actions: \($repo) has \($n) queued runs, the oldest queued \($age) minutes; cut duplicate workflows or batch the pushes."
    ' <<<"$json"
  done
}

worker_facts() {
  local f
  for f in "$dir"/agent-*.jsonl; do
    [ -n "$dir" ] && [ -e "$f" ] || continue
    jq -cRn --arg id "$(basename "$f" .jsonl | sed 's/^agent-//')" '
      [inputs | fromjson? | select(type=="object")] as $l
      | ([$l[] | select(.type=="user")][0].message.content | if type=="array" then map(.text? // "") | join(" ") else tostring end) as $brief
      | ([$l[] | select(.type=="assistant") | .message.content | arrays | .[] | select(.type=="text") | .text] | last // "") as $report
      | [$l[] | select(.type=="assistant" or .type=="user") | .message.content | arrays | .[]
          | if .type=="tool_use" then (if ((.input.command // "") | test("render";"i")) then "R" else empty end)
            elif .type=="tool_result" and (.is_error == true or ((.content|tostring) | test("\\b(FAIL|failed|Error)\\b"))) then "F"
            else empty end] | join("") as $renders
      | { id: $id,
          item: ($brief | capture("\\bItem:\\s*(?:[\\w-]+/)?(?<r>[\\w-]+#[0-9]+)").r? // ($brief | capture("\\bItem:\\s*(?<t>[^\\n.]{1,60})").t? // null)),
          category: ($brief | capture("\\bCategory:\\s*(?<c>[\\w-]+)").c? // ""),
          ended: ([$l[] | .timestamp // empty] | last // ""),
          notdone: ($report | test("^\\W*not done";"i")),
          rerender: ($renders | test("R+F+R")) }
    ' <"$f" 2>/dev/null
  done
}

bug_items() {
  local repo
  for repo in ${WORKER_SWEEP_REPOS:-tompassarelli/smashcraft tompassarelli/wisp}; do
    gh api "repos/$repo/issues?labels=bug&state=open&per_page=100" --jq ".[] | \"${repo#*/}#\(.number)\"" 2>/dev/null
  done
}

wait_serial() {
  local running="$1" facts="$2" bugs
  bugs=$(bug_items | jq -Rn '[inputs]')
  jq -rn --argjson running "$running" --argjson bugs "$bugs" '
    [inputs | select(.item != null)] | group_by(.item)[]
    | (map(select(.id as $i | $running | index($i)))) as $active
    | (map(select(.id as $i | $running | index($i) | not)) | sort_by(.ended)) as $done
    | select(($active | length) == 1 and ($done | length) >= 2 and ($done[-2:] | all(.notdone)))
    | select(any(.[]; .category | test("^(debugging-unknown-cause|netcode-determinism)$")) or (.[0].item as $i | $bugs | index($i)))
    | "WAIT serial: \(.[0].item) has one active worker (\($active[0].id)) after \([$done[] | select(.notdone)] | length) Not done reports, the last two in a row; start a parallel hypothesis worker."
  ' <<<"$facts"
}

wait_gpu() {
  local running="$1" facts="$2" path busy prev state renders
  path=${AGENT_CAPACITY_GPU_BUSY:-$(compgen -G '/sys/class/drm/card[0-9]*/device/gpu_busy_percent' | head -n 1)}
  state="${XDG_STATE_HOME:-$HOME/.local/state}/worker-sweep/gpu-$session_id"
  if [ -n "$path" ] && busy=$(tr -dc '0-9' <"$path" 2>/dev/null) && [ -n "$busy" ]; then
    prev=$(cat "$state" 2>/dev/null) || prev=""
    mkdir -p "${state%/*}" && printf '%s\n' "$busy" >"$state"
    if [ "$busy" -ge 90 ] && [ "${prev:-0}" -ge 90 ]; then
      jq -rn --argjson running "$running" --arg busy "$busy" --arg prev "$prev" '
        [inputs | select(.rerender and (.id as $i | $running | index($i)))] | select(length > 0)
        | "WAIT gpu: GPU busy at \($prev)% then \($busy)% on two sweeps while \(length) render worker(s) (\(map(.id) | join(", "))) fail and rerender; render variants per pass and cap renders at 2."
      ' <<<"$facts"
    fi
  fi
  renders=$({ if [ -n "${WORKER_SWEEP_PS:-}" ]; then cat "$WORKER_SWEEP_PS"; else ps -eo args; fi; } 2>/dev/null |
    grep -oE -- '--user-data-dir=[^ ]*wisp-render[^ ]*' | sort -u | wc -l)
  if [ "$renders" -gt 2 ]; then
    printf 'WAIT gpu: %s headless wisp-render browsers are running at once; render variants per pass and cap renders at 2.\n' "$renders"
  fi
}

# Cloud routines (idle lanes) need claude.ai OAuth that this tool does not hold, so that check is skipped.
waits() {
  local running facts
  running=$(awk '{print $1}' <<<"$1" | jq -Rn '[inputs | select(length > 0)]')
  facts=$(worker_facts)
  wait_landing
  wait_parked "$1"
  wait_actions
  wait_serial "$running" "$facts"
  wait_gpu "$running" "$facts"
  north follows-release 2>/dev/null
}

stale_report() {
  python3 - "${XDG_STATE_HOME:-$HOME/.local/state}/agents/lane-gc/stale.json" "$session_id" <<'PYSTALE'
import json, os, subprocess, sys, time
from datetime import datetime
from pathlib import Path

try:
    report = json.loads(Path(sys.argv[1]).read_text())
    at = datetime.fromisoformat(report["at"].replace("Z", "+00:00")).timestamp()
except (OSError, ValueError, KeyError, TypeError):
    print("STALE report missing or old")
    sys.exit(0)
if time.time() - at > 26 * 3600:
    print("STALE report missing or old")
    sys.exit(0)
for repo, entries in report["repos"].items():
    remote = len(entries["remote_landed"]) + len(entries["remote_stale"])
    local = entries["local_stale"]
    if remote or local:
        dirty = sum(lane["dirty"] for lane in local)
        print(f"STALE {repo}: {remote} remote branches, {len(local)} local lanes older than 24 h ({dirty} dirty); report ~/.local/state/agents/lane-gc/stale.json")
try:
    nodes = json.loads(subprocess.check_output(["north", "fleet", "list", "--json"], text=True))
except (OSError, subprocess.CalledProcessError, ValueError):
    nodes = []
parent = next((n["name"] for n in nodes if n.get("conversation") == sys.argv[2]), None)
owned = sorted((dict(row, repo=repo) for repo, entries in report["repos"].items() for row in entries.get("owned", []) if parent and row.get("owner") == parent), key=lambda row: -row["age_h"])
for row in owned[:10]:
    print(f"OWNED {row['repo']} {row['branch']} {row['age_h']}h {' '.join(row['refs']) or 'no issue'}: continue, land or archive")
if len(owned) > 10:
    print(f"OWNED {parent}: {len(owned) - 10} more, oldest first in lane-gc --unlanded")
if len(owned) > 25 or any(row["age_h"] > 72 for row in owned):
    print(f"ALERT {parent}: {len(owned)} owned unlanded lanes, oldest {owned[0]['age_h']}h; decide each before new work")
PYSTALE
}

if [ "$wait" -eq 0 ]; then
  record
  out=$(sweep)
  table <<<"$out"
  recover "$out"
  [ -z "$codex_sessions" ] || codex capacity || { [ "$?" -eq 2 ] || { wait "$recording"; exit 1; }; }
  waits "$out"
  stale_report
  wait "$recording"
  exit 0
fi
while :; do
  record
  out=$(sweep)
  steps=$(recover "$out")
  capacity=""
  stopped=0
  [ -z "$codex_sessions" ] || capacity=$(codex capacity) || { [ "$?" -eq 2 ] && stopped=1 || { [ -z "$capacity" ] || printf '%s\n' "$capacity"; wait "$recording"; exit 1; }; }
  flags=$(waits "$out")
  wait "$recording"
  if grep -qE 'STALLED|OVERTIME|HANDOFF|PARKED|STOP' <<<"$out" || grep -qE ': fall back:' <<<"$capacity" || [ "$stopped" -eq 1 ] || [ -n "$flags" ]; then
    date +%H:%M
    table <<<"$out"
    [ -z "$steps" ] || printf '%s\n' "$steps"
    [ -z "$capacity" ] || printf '%s\n' "$capacity"
    [ -z "$flags" ] || printf '%s\n' "$flags"
    stale_report
    exit 0
  fi
  if [ -n "$capacity" ]; then sleep 60; else sleep 900; fi
done
