#!/usr/bin/env bash
# Validate one final North release identity without publishing it.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
tag="${1:-}"

if [[ ! "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "north-release-preflight: release tag must be v-prefixed final SemVer" >&2
  exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
  echo "north-release-preflight: jq is required" >&2
  exit 2
fi

version="${tag#v}"
package_version="$(jq -er '.version | select(type == "string")' "$ROOT/sdk/package.json")"
if [[ "$package_version" != "$version" ]]; then
  echo "north-release-preflight: tag $tag disagrees with sdk/package.json $package_version" >&2
  exit 1
fi

# The Nix package reads this same package identity. Match the bindings at their
# owning sites so a duplicate string elsewhere cannot conceal package drift.
if ! awk '
  previous == "        lib = pkgs.lib;" &&
    $0 == "        northVersion = (builtins.fromJSON (builtins.readFile ./sdk/package.json)).version;" {
      matches++
    }
  { previous = $0 }
  END { exit matches == 1 ? 0 : 1 }
' "$ROOT/flake.nix"; then
  echo "north-release-preflight: flake.nix must derive northVersion from sdk/package.json" >&2
  exit 1
fi
if ! awk '
  $0 == "        northPkg = pkgs.stdenvNoCC.mkDerivation {" {
    blocks++
    inside = 1
    next
  }
  inside && $0 == "        };" {
    inside = 0
    next
  }
  inside && $0 == "          version = northVersion;" { matches++ }
  END { exit blocks == 1 && matches == 1 ? 0 : 1 }
' "$ROOT/flake.nix"; then
  echo "north-release-preflight: flake.nix northPkg must use northVersion" >&2
  exit 1
fi

notes="$ROOT/.github/release-notes/$tag.md"
if [[ ! -s "$notes" ]]; then
  echo "north-release-preflight: missing authored release notes at $notes" >&2
  exit 1
fi
if [[ "$(sed -n '1p' "$notes")" != "# North $tag" ]]; then
  echo "north-release-preflight: $notes must start with # North $tag" >&2
  exit 1
fi
if ! grep -Eq '^## (Highlights|Changes)$' "$notes"; then
  echo "north-release-preflight: $notes must contain a Highlights or Changes section" >&2
  exit 1
fi

printf 'north release preflight: PASS (%s)\n' "$tag"
