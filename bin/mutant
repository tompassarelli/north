#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" != check ] && north mutant --help >/dev/null 2>&1; then exec north mutant "$@"; fi

usage() {
  echo 'Usage: mutant record <id> | mutant check <id> <base> <head>'
  echo 'Record the scratch copy diff against HEAD; check its applicability before landing.'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  record) [ "$#" -eq 2 ] || { usage >&2; exit 2; } ;;
  check) [ "$#" -eq 4 ] || { usage >&2; exit 2; } ;;
  *) usage >&2; exit 2 ;;
esac
id=$2
[[ "$id" =~ ^[[:alnum:]][[:alnum:]_-]*$ ]] || { echo 'mutant: invalid id' >&2; exit 2; }
origin=$(git remote get-url origin)
for _ in 1 2 3 4 5; do
  dir=${origin#file://}
  [ -d "$dir" ] && [ "$(git -C "$dir" rev-parse --is-bare-repository 2>/dev/null)" = false ] || break
  origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || { echo "mutant: origin $dir is a clone with no origin of its own" >&2; exit 2; }
done
[ ! -d "${origin#file://}" ] || [ "$(git -C "${origin#file://}" rev-parse --is-bare-repository 2>/dev/null)" = true ] || { echo "mutant: cannot resolve the repository behind origin $origin" >&2; exit 2; }
repo=${origin%/}
repo=${repo##*/}
repo=${repo%.git}
[[ "$repo" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || { echo 'mutant: invalid repository name' >&2; exit 2; }
patch="${XDG_STATE_HOME:-$HOME/.local/state}/agents/mutants/$repo/$id.patch"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/mutant.XXXXXX")
trap 'rm -rf "${scratch:?}"' EXIT

case "$1" in
  record)
    git diff --binary --no-color --no-ext-diff --no-textconv HEAD >"$scratch/record.patch"
    [ -s "$scratch/record.patch" ] || { echo "mutant: $id has an empty diff; NOT recorded." >&2; exit 1; }
    mkdir -p "$(dirname "$patch")"
    cp "$scratch/record.patch" "$patch.tmp.$$"
    mv "$patch.tmp.$$" "$patch"
    printf 'mutant: recorded %s\n' "$patch"
    ;;
  check)
    [ -s "$patch" ] || exit 1
    for tree in "$3" "$4"; do
      GIT_INDEX_FILE="$scratch/index" git read-tree "$tree"
      if GIT_INDEX_FILE="$scratch/index" git apply --cached --check "$patch" 2>/dev/null; then
        exit 0
      fi
    done
    exit 1
    ;;
esac
