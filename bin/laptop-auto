#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def collect(proc=Path("/proc"), drm=Path("/sys/class/drm"), idle=None):
    gaming = agent_gpu = False
    for entry in proc.iterdir():
        if not entry.name.isdecimal():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            cgroup = (entry / "cgroup").read_text()
            owned = any(part in cgroup for part in ("/agent.slice/", "/native.slice/", "libpod-"))
            comm = (entry / "comm").read_text().strip()
            executable = Path(os.fsdecode((entry / "cmdline").read_bytes().split(b"\0")[0])).name
            if not owned and re.search(r"wine|proton|Warcraft III|dolphin|Slippi", comm + " " + executable, re.I):
                gaming = True
            if owned:
                for fd in (entry / "fd").iterdir():
                    try:
                        if os.readlink(fd).startswith("/dev/dri/"):
                            agent_gpu = True
                            break
                    except OSError:
                        pass
        except (OSError, ValueError):
            continue
    busy = []
    for path in drm.glob("card*/device/gpu_busy_percent"):
        try:
            value = int(path.read_text())
            if 0 <= value <= 100:
                busy.append(value)
        except (OSError, ValueError):
            pass
    return {"gaming": gaming, "agent_gpu": agent_gpu, "gpu_busy": max(busy) if busy else None, "idle": idle}


def main():
    if sys.argv[1:] not in ([], ["--dry-run"]):
        raise SystemExit("usage: laptop-auto [--dry-run]")
    idle = None
    try:
        result = subprocess.run(["loginctl", "show-session", "auto", "-p", "IdleHint", "-p", "Type", "-p", "Active", "-p", "Remote"],
                                capture_output=True, text=True, timeout=5, check=True)
        session = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        if session.get("Active") == "yes" and session.get("Remote") == "no" and session.get("Type") in ("wayland", "x11"):
            if session.get("IdleHint") in ("yes", "no"):
                idle = session["IdleHint"] == "yes"
    except (OSError, subprocess.SubprocessError):
        pass
    sample = json.dumps(collect(idle=idle))
    if sys.argv[1:] == ["--dry-run"]:
        print(sample)
    else:
        subprocess.run([str(Path(__file__).resolve().with_name("laptop")), "observe", sample], timeout=45, check=True)


if __name__ == "__main__":
    main()
