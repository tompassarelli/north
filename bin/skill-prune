#!/usr/bin/env bash
set -euo pipefail
handoffs=${AGENTS_HANDOFFS:-$HOME/.local/state/agents/handoffs}
operator=${AGENTS_OPERATOR_DIR:-$HOME/code/south/main/agents}
report=$handoffs/skill-prune.md
lessons=$handoffs/codex-lessons.md
case ${1:-} in
  -h|--help) echo "usage: skill-prune [--measure]"
    echo "Weekly: one Claude Opus medium session prunes the shared SKILL.md bodies toward the 60-line playbook target and"
    echo "shrinks duplicated or stale rules, folds $lessons, lands each repository through safe-push, and writes the"
    echo "counts to $report."
    echo "--measure prints every shared skill's body lines (domain skills marked) and the total beside the operating point"
    echo "in $operator/operating-point.toml (informational, no cap)."; exit 0 ;;
esac

measure() {
  python3 - "$operator/catalog-config.json" "$operator/operating-point.toml" <<'PY'
import json, pathlib, re, subprocess, sys, tomllib
catalog = json.load(open(sys.argv[1]))
rows, total = [], 0
for unit, entry in catalog["activation"].items():
    if not any(d.get("type") == "skill" and "shared" in d.get("targets", []) for d in entry.get("distributions", [])):
        continue
    found = subprocess.run(["agents", "path", unit], capture_output=True, text=True)
    path = found.stdout.strip()
    text = open(path).read() if found.returncode == 0 and path else ""
    match = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not match:
        rows.append((0, unit, "unreadable"))
        continue
    lines = len(text[match.end():].splitlines())
    total += lines
    domain = re.search(r"^metadata:\n(?:[ \t]+.*\n)*?[ \t]+kind:[ \t]*domain[ \t]*$", match.group(1) + "\n", re.M)
    rows.append((lines, unit, "domain" if domain else ("over 60" if lines > 60 else "")))
for lines, unit, mark in sorted(rows, reverse=True):
    print(f"{lines:5} {unit} {mark}".rstrip())
point_file = pathlib.Path(sys.argv[2])
point = tomllib.loads(point_file.read_text()) if point_file.is_file() else None
if point is None:
    print(f"total {total} (no operating point yet)")
else:
    lines = f"skill lines {point['skill_lines']}, " if "skill_lines" in point else ""
    print(f"total {total} (operating point {point['date']}: {lines}startup tokens {point['startup_tokens']}, "
          f"conformance {point['conformance']})")
PY
}

[[ ${1:-} == --measure ]] && { measure; exit 0; }

brief="You are the weekly skill prune. Read north:harness/skills/agent-policy/SKILL.md and the verification and repo-safety skills first.
1. Measure: run \`skill-prune --measure\`. It lists every shared SKILL.md body, marks domain skills (metadata.kind: domain, exempt from the 60-line playbook target) and totals the bodies beside the operating point.
2. Prune each playbook body toward 60 lines, a reported target that fails nothing (agent-config-check fails only over 500), and keep shrinking wherever a rule is duplicated, detailed or no longer true. Move detail into the skill's references/notes.md. Merge duplicated rules, keeping the copy in the owning skill. Delete a rule only after checking it against the current code and CLI help. Lose no live rule: under a dated heading in $handoffs/skill-prune-moves.md, write each removed or moved line and where it went.
3. Fold $lessons: a lesson that held in two or more independent runs (its \`also\` entries name other boxes from separate incidents) goes into the skill line it names; a lesson that did not hold is dropped; one with no second run 14 days after its date moves out marked \`expired\`, and a lead that sees it again moves it back with its \`also\` entry, which counts as its second run; a tool defect or a privacy, safety or data-loss slip still pending is filed as an issue for its owning lead. Move each folded, dropped or filed line, marked with where it went, to codex-lessons-folded.md beside it.
4. Edit each repository in its own lane: \`git -C ~/code/REPO/main worktree add -b skill-prune-DATE ~/code/REPO/worktrees/skill-prune-DATE origin/main\`. Commit there, land with \`safe-push --to main\`, then run \`agents sync\`.
5. End with one line per landed repository and its SHA.
Write policy prose as clear, complete, well-made sentences. Change nothing outside skills, their references, the hooks that restate a moved rule and the two lessons files."

mkdir -p "$handoffs"
before=$(measure)
lessons_before=$(wc -l < "$lessons" 2>/dev/null || echo 0)
session=$(north fleet launch --provider claude --account "${SKILL_PRUNE_ACCOUNT:-a}" \
  --model claude-opus-5-5 --tier-reason "skill and policy prose goes to Opus, never a cheaper tier" --name "skill-prune-$(date +%Y%m%d)" "$brief") || session=""
if [[ -n "$session" ]]; then
  out=$(timeout 5400 north fleet show "$session" --follow) || out="session failed: exit $?"
else
  out="session failed to launch through north fleet"
fi
after=$(measure)
lessons_after=$(wc -l < "$lessons" 2>/dev/null || echo 0)
{
  printf '# Skill prune %s\n\n## Bodies before\n\n```\n%s\n```\n\n## Bodies after\n\n```\n%s\n```\n\n' "$(date -Iminutes)" "$before" "$after"
  printf 'codex-lessons.md: %s lines before, %s after.\n\n## Session\n\n%s\n' "$lessons_before" "$lessons_after" "$out"
} > "$report"
echo "$report"
