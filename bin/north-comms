#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
north_home="${NORTH_HOME:-$(cd "$script_dir/.." && pwd)}"
bb="${NORTH_BB:-bb}"
port="${NORTH_PORT:-7977}"
verb="${1:-}"
shift || true

case "$verb" in
  send|mention|interrupt|ack)
    exec "$bb" "$north_home/cli/msg-cli.clj" "$port" "$verb" "$@"
    ;;
  poll)
    [ "$#" -eq 1 ] || exit 2
    exec "$bb" "$north_home/cli/inbox-peek.clj" "$port" "$1"
    ;;
  lease)
    if [ "$#" -eq 2 ] && [ "$2" = "--announce" ]; then
      exec "$bb" "$north_home/cli/presence-cli.clj" "$port" register "$1" \
        "${NORTH_COMMS_DIR:-$PWD}" "${NORTH_COMMS_SESSION_ID:-$1}"
    fi
    [ "$#" -eq 1 ] || exit 2
    exec "$bb" "$north_home/cli/msg-cli.clj" "$port" presence "$1"
    ;;
  watch)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || exit 2
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--once" ] || exit 2
      exec "$bb" "$north_home/cli/north-listen.clj" "$port" "$1" --once --ack
    fi
    exec "$bb" "$north_home/cli/north-listen.clj" "$port" "$1" --ack
    ;;
  *)
    exit 2
    ;;
esac
