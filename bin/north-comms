#!/usr/bin/env bash
# north-comms — one protocol contract over off, DB, and file mail backends.
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NORTH_HOME="${NORTH_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
export NORTH_HOME

BB="${NORTH_BB:-bb}"
PORT="${NORTH_PORT:-7977}"
PRESENCE_TTL_S="${NORTH_COMMS_PRESENCE_TTL_S:-1800}"
OUTPUT_BYTE_LIMIT=$((24 * 1024))
DEFAULT_MAX=3

die() {
  printf 'north-comms: %s\n' "$*" >&2
  exit 2
}

raw_or() {
  local key="$1" fallback="$2" value='' line
  local state="${NORTH_HARNESS_STATE:-${HOME:?}/.local/state/north/harness.conf}"
  if [[ -r $state ]]; then
    while IFS= builtin read -r line || [[ -n $line ]]; do
      [[ $line == "$key="* ]] && value="${line#*=}"
    done <"$state"
  fi
  builtin printf '%s\n' "${value:-$fallback}"
}

valid_protocol() {
  [[ $1 == off || $1 == db || $1 == file || $1 == both ]]
}

base_protocol="$(raw_or comms db)"
valid_protocol "$base_protocol" || base_protocol=db
surface="${NORTH_COMMS_SURFACE:-}"
if [[ $surface != native && $surface != managed ]]; then
  if [[ ${NORTH_MANAGED_LANE:-0} == 1 ]]; then
    surface=managed
  else
    surface=native
  fi
fi
surface_protocol="$(raw_or "comms.$surface" inherit)"
if [[ $surface_protocol == inherit ]] || ! valid_protocol "$surface_protocol"; then
  selected_protocol="$base_protocol"
else
  selected_protocol="$surface_protocol"
fi
enforcement="$(raw_or comms.enforcement forced)"
[[ $enforcement == forced || $enforcement == biased ]] || enforcement=forced

requested_protocol="${NORTH_COMMS_REQUESTED_PROTOCOL:-}"
if [[ -n $requested_protocol ]] && ! valid_protocol "$requested_protocol"; then
  die "requested protocol must be db, file, or both"
fi
if [[ $enforcement == forced && -n $requested_protocol &&
      $requested_protocol != "$selected_protocol" ]]; then
  die "protocol $requested_protocol is denied by comms.enforcement=forced; use $selected_protocol through north-comms"
fi

db_poll_mode="$(raw_or comms.db.poll hook)"
db_budget_ms="$(raw_or comms.db.budget-ms 1800)"
file_poll_mode="$(raw_or comms.file.poll hook)"
file_root="$(raw_or comms.file.root "${HOME:?}/.local/state/north/comms")"
file_retain_hours="$(raw_or comms.file.retain-hours 24)"
[[ $db_poll_mode == hook || $db_poll_mode == listener || $db_poll_mode == off ]] ||
  db_poll_mode=hook
[[ $file_poll_mode == hook || $file_poll_mode == inotify || $file_poll_mode == off ]] ||
  file_poll_mode=hook
[[ $db_budget_ms =~ ^[1-9][0-9]*$ ]] || db_budget_ms=1800
[[ $file_retain_hours =~ ^[0-9]+$ ]] || file_retain_hours=24

utf8_bytes() {
  LC_ALL=C builtin printf '%s' "$1" | wc -c
}

valid_handle() {
  local value="$1" maximum="$2" size
  [[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || return 1
  size="$(utf8_bytes "$value")"
  ((size <= maximum))
}

valid_message_id() {
  local value="$1" size
  [[ $value =~ ^@msg:[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || return 1
  size="$(utf8_bytes "$value")"
  ((size <= 512))
}

validate_message() {
  local from="$1" to="$2" subject="$3" body="$4"
  valid_handle "$from" 1024 || die "sender is malformed or too large"
  if [[ $to != '*' ]]; then
    valid_handle "$to" 512 || die "target is malformed or too large"
  fi
  [[ $subject =~ [^[:space:]] ]] ||
    die "subject is blank, malformed, or too large"
  (( $(utf8_bytes "$subject") <= 16384 )) ||
    die "subject is blank, malformed, or too large"
  if LC_ALL=C builtin printf '%s' "$subject" |
      grep -q $'[\001-\010\013\014\016-\037\177]'; then
    die "subject is blank, malformed, or too large"
  fi
  [[ $body =~ [^[:space:]] ]] ||
    die "body is blank, malformed, or too large"
  (( $(utf8_bytes "$body") <= 131072 )) ||
    die "body is blank, malformed, or too large"
}

file_require_root() {
  [[ $file_root == /* && $file_root != / ]] ||
    die "comms.file.root must be an absolute non-root path"
  mkdir -p "$file_root/tmp" "$file_root/.aliases"
  chmod 700 "$file_root" "$file_root/tmp" "$file_root/.aliases" 2>/dev/null || true
}

file_handle_dirs() {
  local handle="$1"
  valid_handle "$handle" 512 || die "handle is malformed or too large"
  file_require_root
  mkdir -p "$file_root/$handle/new" "$file_root/$handle/cur"
  chmod 700 "$file_root/$handle" "$file_root/$handle/new" \
    "$file_root/$handle/cur" 2>/dev/null || true
}

file_prune_cur() {
  local handle="$1" retain_minutes
  retain_minutes=$((file_retain_hours * 60))
  find "$file_root/$handle/cur" -mindepth 1 -maxdepth 1 \
    -type f -name '*.msg' -mmin "+${retain_minutes}" -delete
}

file_resolve_address() {
  local requested="$1" link target
  FILE_RESOLVED="$requested"
  [[ $requested == '*' ]] && return 0
  valid_handle "$requested" 512 || die "target is malformed or too large"
  link="$file_root/.aliases/$requested"
  if [[ -L $link ]]; then
    target="$(readlink "$link")"
    if [[ $target == ../* ]] && valid_handle "${target#../}" 512; then
      FILE_RESOLVED="${target#../}"
    fi
  fi
}

file_live() {
  local handle="$1" modified now
  [[ -f "$file_root/$handle/.live" ]] || return 1
  modified="$(stat -c %Y "$file_root/$handle/.live" 2>/dev/null || builtin printf 0)"
  now="$(date +%s)"
  [[ $modified =~ ^[0-9]+$ && $now =~ ^[0-9]+$ ]] || return 1
  ((now >= modified && now - modified <= PRESENCE_TTL_S))
}

file_alias_announce() {
  local alias="$1" handle="$2" tmp
  [[ -n $alias ]] || return 0
  valid_handle "$alias" 512 || die "alias is malformed or too large"
  tmp="$file_root/.aliases/.${alias}.$$.${RANDOM}.tmp"
  ln -s "../$handle" "$tmp"
  mv -Tf "$tmp" "$file_root/.aliases/$alias"
}

file_presence() {
  local handle="$1" announce="$2"
  file_require_root
  if [[ $announce == 1 ]]; then
    file_handle_dirs "$handle"
    file_prune_cur "$handle"
    touch "$file_root/$handle/.live"
    file_alias_announce "${NORTH_COMMS_ALIAS:-}" "$handle"
  fi
  file_resolve_address "$handle"
  if file_live "$FILE_RESOLVED"; then
    builtin printf 'reachable %s\n' "$FILE_RESOLVED"
    return 0
  fi
  builtin printf 'absent %s\n' "$FILE_RESOLVED"
  return 1
}

db_presence() {
  local handle="$1" announce="$2"
  valid_handle "$handle" 512 || die "handle is malformed or too large"
  if [[ $announce == 1 ]]; then
    "$BB" "$NORTH_HOME/cli/presence-cli.clj" "$PORT" register "$handle" \
      "${NORTH_COMMS_DIR:-$PWD}" "${NORTH_COMMS_SESSION_ID:-$handle}" >/dev/null
    builtin printf 'reachable %s\n' "$handle"
    return 0
  fi
  NORTH_COMMS_DB_HANDLE="$handle" "$BB" -e '
    (System/setProperty "north.msg-cli.lib" "1")
    (load-file (str (System/getenv "NORTH_HOME") "/cli/msg-cli.clj"))
    (let [port (Integer/parseInt (or (System/getenv "NORTH_PORT") "7977"))
          requested (System/getenv "NORTH_COMMS_DB_HANDLE")
          route (north.message-routing/require-live-address port requested)
          recipient (or (:recipient route) requested)]
      (if (= true (:live route))
        (println (str "reachable " recipient))
        (do (println (str "absent " recipient)) (System/exit 1))))'
}

mint_message_id() {
  local stamp uuid
  stamp="$(date +%Y%m%d-%H%M%S)"
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    read -r uuid </proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then
    uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  else
    die "no collision-resistant UUID source is available"
  fi
  MINTED_ID="@msg:$stamp-$uuid"
  valid_message_id "$MINTED_ID" || die "generated message id is invalid"
}

b64() {
  builtin printf '%s' "$1" | base64 -w0
}

file_publish_one() {
  local recipient="$1" id="$2" from="$3" to="$4" subject="$5" body="$6"
  local sent_at="$7" audience="$8" tmp dest
  file_handle_dirs "$recipient"
  tmp="$file_root/tmp/${id#@msg:}.${recipient}.$$.${RANDOM}.tmp"
  dest="$file_root/$recipient/new/${id#@msg:}.msg"
  (
    set -o noclobber
    exec 3>"$tmp"
    builtin printf 'north-comms-v1\n' >&3
    builtin printf 'id=%s\n' "$(b64 "$id")" >&3
    builtin printf 'from=%s\n' "$(b64 "$from")" >&3
    builtin printf 'to=%s\n' "$(b64 "$to")" >&3
    builtin printf 'subject=%s\n' "$(b64 "$subject")" >&3
    builtin printf 'body=%s\n' "$(b64 "$body")" >&3
    builtin printf 'sent_at=%s\n' "$(b64 "$sent_at")" >&3
    builtin printf 'broadcast_audience_version=%s\n' \
      "$(b64 "$([[ $to == '*' ]] && builtin printf snapshot-v1)")" >&3
    builtin printf 'broadcast_audience=%s\n' "$(b64 "$audience")" >&3
    if [[ -n ${FILE_ATTENTION_KIND:-} ]]; then
      builtin printf 'attention_kind=%s\n' "$(b64 "$FILE_ATTENTION_KIND")" >&3
      builtin printf 'delivery_class=%s\n' "$(b64 "$FILE_DELIVERY_CLASS")" >&3
      builtin printf 'requires_ack=%s\n' "$(b64 true)" >&3
      builtin printf 'about=%s\n' "$(b64 "${FILE_ATTENTION_ABOUT:-}")" >&3
    fi
  ) || die "could not create an exclusive message temp file"
  chmod 600 "$tmp"
  mv -Tn "$tmp" "$dest"
  if [[ -e $tmp ]]; then
    rm -f -- "$tmp"
    die "message id collision at $dest"
  fi
}

file_live_handles() {
  local directory handle
  FILE_AUDIENCE=()
  file_require_root
  while IFS= read -r directory; do
    handle="${directory##*/}"
    valid_handle "$handle" 512 || continue
    file_live "$handle" || continue
    FILE_AUDIENCE+=("$handle")
  done < <(find "$file_root" -mindepth 1 -maxdepth 1 -type d \
             ! -name tmp ! -name .aliases -print | LC_ALL=C sort)
}

file_send_with_id() {
  local id="$1" from="$2" requested_to="$3" subject="$4" body="$5"
  local dead_drop="$6" sent_at audience_text="" recipient
  validate_message "$from" "$requested_to" "$subject" "$body"
  valid_message_id "$id" || die "message id is malformed or too large"
  sent_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  file_require_root
  if [[ $requested_to == '*' ]]; then
    file_live_handles
    local filtered=()
    for recipient in "${FILE_AUDIENCE[@]}"; do
      [[ $recipient == "$from" ]] || filtered+=("$recipient")
    done
    FILE_AUDIENCE=("${filtered[@]}")
    if ((${#FILE_AUDIENCE[@]})); then
      audience_text="$(IFS=,; builtin printf '%s' "${FILE_AUDIENCE[*]}")"
    fi
    for recipient in "${FILE_AUDIENCE[@]}"; do
      file_publish_one "$recipient" "$id" "$from" '*' "$subject" "$body" \
        "$sent_at" "$audience_text"
    done
    builtin printf 'sent %s -> * (%s snapshotted recipients; sender excluded)\n' \
      "$id" "${#FILE_AUDIENCE[@]}"
    return 0
  fi

  file_resolve_address "$requested_to"
  recipient="$FILE_RESOLVED"
  if [[ $dead_drop != 1 ]] && ! file_live "$recipient"; then
    die "recipient $recipient has no live presence; pass --dead-drop only for deliberate delivery to an absent identity"
  fi
  file_publish_one "$recipient" "$id" "$from" "$recipient" "$subject" "$body" \
    "$sent_at" ""
  builtin printf 'sent %s -> %s\n' "$id" "$recipient"
}

db_send() {
  local from="$1" to="$2" subject="$3" body="$4" dead_drop="$5"
  if [[ $dead_drop == 1 ]]; then
    "$BB" "$NORTH_HOME/cli/msg-cli.clj" "$PORT" send --dead-drop \
      "$from" "$to" "$subject" "$body"
  else
    "$BB" "$NORTH_HOME/cli/msg-cli.clj" "$PORT" send \
      "$from" "$to" "$subject" "$body"
  fi
}

valid_about_ref() {
  local value="$1" size
  [[ $value =~ ^@[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || return 1
  size="$(utf8_bytes "$value")"
  ((size <= 512))
}

parse_directed_attention() {
  local verb="$1"
  shift
  (($# >= 3)) ||
    die "$verb requires from, recipient, optional --about <@thread>, and body"
  ATTENTION_FROM="$1"
  ATTENTION_TO="$2"
  ATTENTION_ABOUT=""
  ATTENTION_BODY=""
  shift 2
  while (($#)); do
    case "$1" in
      --about)
        [[ -z $ATTENTION_ABOUT ]] ||
          die "$verb received duplicate --about"
        (($# >= 2)) && [[ $2 != --* ]] ||
          die "$verb --about requires an @thread value"
        valid_about_ref "$2" ||
          die "--about must be an exact @ref within the transport bound"
        ATTENTION_ABOUT="$2"
        shift 2
        ;;
      --*)
        die "$verb received unknown option $1"
        ;;
      *)
        (($# == 1)) ||
          die "$verb requires exactly one body argument after options"
        ATTENTION_BODY="$1"
        shift
        ;;
    esac
  done
  [[ -n $ATTENTION_BODY ]] ||
    die "$verb requires exactly one non-option body argument"
  if [[ $verb == mention ]]; then
    ATTENTION_SUBJECT=mention
    ATTENTION_KIND=mention
    ATTENTION_DELIVERY_CLASS=inbox
    ATTENTION_DEAD_DROP=1
  else
    ATTENTION_SUBJECT=URGENT
    ATTENTION_KIND=interrupt
    ATTENTION_DELIVERY_CLASS=interrupt
    ATTENTION_DEAD_DROP=0
  fi
  validate_message "$ATTENTION_FROM" "$ATTENTION_TO" \
    "$ATTENTION_SUBJECT" "$ATTENTION_BODY"
}

db_directed_attention() {
  local verb="$1"
  shift
  "$BB" "$NORTH_HOME/cli/msg-cli.clj" "$PORT" "$verb" "$@"
}

file_directed_attention_with_id() {
  local id="$1"
  FILE_ATTENTION_KIND="$ATTENTION_KIND"
  FILE_DELIVERY_CLASS="$ATTENTION_DELIVERY_CLASS"
  FILE_ATTENTION_ABOUT="$ATTENTION_ABOUT"
  file_send_with_id "$id" "$ATTENTION_FROM" "$ATTENTION_TO" \
    "$ATTENTION_SUBJECT" "$ATTENTION_BODY" "$ATTENTION_DEAD_DROP"
}

extract_message_id() {
  local output="$1"
  if [[ $output =~ (@msg:[A-Za-z0-9][A-Za-z0-9._:-]*) ]]; then
    EXTRACTED_ID="${BASH_REMATCH[1]}"
    valid_message_id "$EXTRACTED_ID" ||
      die "DB backend returned an invalid message id"
  else
    die "DB backend did not return a message id"
  fi
}

decode_field_to() {
  local source="$1" field="$2" destination="$3" encoded
  encoded="$(sed -n "s/^${field}=//p" "$source" | tail -n 1)"
  [[ -n $encoded ]] || return 1
  builtin printf '%s' "$encoded" | base64 -d >"$destination" 2>/dev/null
}

file_message_id() {
  local source="$1" encoded
  encoded="$(sed -n 's/^id=//p' "$source" | tail -n 1)"
  [[ -n $encoded ]] || return 1
  FILE_MESSAGE_ID="$(builtin printf '%s' "$encoded" | base64 -d 2>/dev/null)"
  valid_message_id "$FILE_MESSAGE_ID"
}

FILE_DELIVERED_IDS=()
file_poll() {
  local handle="$1" budget_ms="$2" maximum="$3"
  local start_ms now_ms output_bytes=0 delivered=0 message decode_dir
  local from_bytes subject_bytes body_bytes rendered_bytes id dest
  valid_handle "$handle" 512 || die "handle is malformed or too large"
  file_require_root
  file_resolve_address "$handle"
  handle="$FILE_RESOLVED"
  file_handle_dirs "$handle"
  file_prune_cur "$handle"
  start_ms="$(date +%s%3N)"
  while IFS= read -r message; do
    now_ms="$(date +%s%3N)"
    ((now_ms - start_ms < budget_ms)) || break
    ((delivered < maximum)) || break
    [[ -f $message ]] || continue
    file_message_id "$message" || continue
    id="$FILE_MESSAGE_ID"
    decode_dir="$(mktemp -d "$file_root/tmp/read.XXXXXX")"
    if ! decode_field_to "$message" from "$decode_dir/from" ||
       ! decode_field_to "$message" subject "$decode_dir/subject" ||
       ! decode_field_to "$message" body "$decode_dir/body"; then
      rm -rf -- "${decode_dir:?}"
      continue
    fi
    from_bytes="$(wc -c <"$decode_dir/from")"
    subject_bytes="$(wc -c <"$decode_dir/subject")"
    body_bytes="$(wc -c <"$decode_dir/body")"
    rendered_bytes=$((18 + from_bytes + subject_bytes + body_bytes))
    if ((rendered_bytes > OUTPUT_BYTE_LIMIT ||
         output_bytes + rendered_bytes > OUTPUT_BYTE_LIMIT)); then
      rm -rf -- "${decode_dir:?}"
      continue
    fi
    now_ms="$(date +%s%3N)"
    if ((now_ms - start_ms >= budget_ms)); then
      rm -rf -- "${decode_dir:?}"
      break
    fi
    builtin printf '✉ from '
    cat "$decode_dir/from"
    builtin printf ' — '
    cat "$decode_dir/subject"
    builtin printf '\n  '
    cat "$decode_dir/body"
    builtin printf '\n'
    # Shell builtins and cat write directly to stdout. Publish the complete
    # rendering before the one atomic acknowledgement rename.
    dest="$file_root/$handle/cur/${message##*/}"
    mv -Tn "$message" "$dest"
    if [[ -e $message ]]; then
      rm -rf -- "${decode_dir:?}"
      continue
    fi
    FILE_DELIVERED_IDS+=("$id")
    output_bytes=$((output_bytes + rendered_bytes))
    delivered=$((delivered + 1))
    rm -rf -- "${decode_dir:?}"
  done < <(find "$file_root/$handle/new" -mindepth 1 -maxdepth 1 \
             -type f -name '*.msg' -print | LC_ALL=C sort)
}

file_ack() {
  local handle="$1" id="$2" source dest
  valid_handle "$handle" 512 || die "handle is malformed or too large"
  valid_message_id "$id" || die "message id is malformed or too large"
  file_require_root
  file_resolve_address "$handle"
  handle="$FILE_RESOLVED"
  file_handle_dirs "$handle"
  file_prune_cur "$handle"
  source="$file_root/$handle/new/${id#@msg:}.msg"
  dest="$file_root/$handle/cur/${id#@msg:}.msg"
  if [[ -f $source ]]; then
    mv -Tn "$source" "$dest"
  fi
  if [[ ! -f $dest ]]; then
    die "$id is not addressed to $handle"
  fi
  builtin printf '%s acked %s\n' "$handle" "$id"
}

db_ack() {
  "$BB" "$NORTH_HOME/cli/msg-cli.clj" "$PORT" ack "$1" "$2"
}

db_poll() {
  local handle="$1" timeout_s status
  [[ $db_poll_mode == hook ]] || return 0
  builtin printf -v timeout_s '%d.%03d' \
    "$((db_budget_ms / 1000))" "$((db_budget_ms % 1000))"
  set +e
  timeout --signal=TERM --kill-after=0.2s "${timeout_s}s" \
    "$BB" "$NORTH_HOME/cli/inbox-peek.clj" "$PORT" "$handle"
  status=$?
  set -e
  [[ $status -eq 0 || $status -eq 124 || $status -eq 137 ]] || return "$status"
  return 0
}

file_watch() {
  local handle="$1" once="$2"
  valid_handle "$handle" 512 || die "handle is malformed or too large"
  file_require_root
  file_resolve_address "$handle"
  handle="$FILE_RESOLVED"
  file_handle_dirs "$handle"
  while true; do
    if find "$file_root/$handle/new" -mindepth 1 -maxdepth 1 \
        -type f -name '*.msg' -print -quit | grep -q .; then
      file_poll "$handle" "$db_budget_ms" 1
      [[ $once == 1 ]] && return 0
    elif command -v inotifywait >/dev/null 2>&1; then
      inotifywait -qq -e moved_to "$file_root/$handle/new" || true
    else
      sleep 2
    fi
  done
}

db_watch() {
  local handle="$1" once="$2"
  if [[ $once == 1 ]]; then
    "$BB" "$NORTH_HOME/cli/north-listen.clj" "$PORT" "$handle" --once --ack
  else
    "$BB" "$NORTH_HOME/cli/north-listen.clj" "$PORT" "$handle" --ack
  fi
}

doctor() (
  local scratch state doctor_root alias_send direct_poll dead broadcast
  scratch="$(mktemp -d /tmp/north-comms-doctor.XXXXXX)"
  trap 'rm -rf -- "${scratch:?}"' EXIT
  state="$scratch/harness.conf"
  doctor_root="$scratch/mail"
  builtin printf 'comms=file\ncomms.enforcement=forced\ncomms.file.root=%s\ncomms.file.poll=hook\n' \
    "$doctor_root" >"$state"
  local -a env_args=(
    env HOME="$scratch/home" NORTH_HOME="$NORTH_HOME"
    NORTH_HARNESS_STATE="$state" NORTH_BB="$BB"
  )
  mkdir -p "$scratch/home"
  "${env_args[@]}" "$0" presence alice --announce >/dev/null
  NORTH_COMMS_ALIAS=team-worker "${env_args[@]}" \
    "$0" presence bob --announce >/dev/null
  alias_send="$("${env_args[@]}" "$0" send alice team-worker hello world)"
  direct_poll="$("${env_args[@]}" "$0" poll bob)"
  [[ $direct_poll == $'✉ from alice — hello\n  world' ]] ||
    die "doctor direct/alias round-trip failed"
  extract_message_id "$alias_send"
  "${env_args[@]}" "$0" ack bob "$EXTRACTED_ID" >/dev/null
  if "${env_args[@]}" "$0" send alice absent blocked body >/dev/null 2>&1; then
    die "doctor unreachable-send check failed"
  fi
  dead="$("${env_args[@]}" "$0" send alice absent dead body --dead-drop)"
  [[ $dead == sent\ @msg:*' -> absent' ]] ||
    die "doctor dead-drop check failed"
  broadcast="$("${env_args[@]}" "$0" send alice '*' broadcast body --broadcast)"
  [[ $broadcast == *'snapshotted recipients'* ]] ||
    die "doctor broadcast snapshot failed"
  builtin printf 'north-comms doctor: PASS protocol=file presence=reachable dead-drop=guarded broadcast=snapshot-v1 dedupe=id ack=idempotent\n'
)

verb="${1:-}"
shift || true
case "$verb" in
  mention|interrupt)
    original_attention_args=("$@")
    parse_directed_attention "$verb" "$@"
    case "$selected_protocol" in
      off)
        die "communications are disabled by comms=off"
        ;;
      db)
        db_directed_attention "$verb" "${original_attention_args[@]}"
        ;;
      file)
        mint_message_id
        file_directed_attention_with_id "$MINTED_ID"
        ;;
      both)
        db_output="$(
          db_directed_attention "$verb" "${original_attention_args[@]}"
        )"
        extract_message_id "$db_output"
        file_directed_attention_with_id "$EXTRACTED_ID" >/dev/null
        builtin printf '%s\n' "$db_output"
        ;;
    esac
    ;;
  send)
    dead_drop=0
    broadcast=0
    positional=()
    for argument in "$@"; do
      case "$argument" in
        --dead-drop) dead_drop=1 ;;
        --broadcast) broadcast=1 ;;
        *) positional+=("$argument") ;;
      esac
    done
    ((${#positional[@]} == 4)) ||
      die "usage: north-comms send <from> <to> <subject> <body> [--dead-drop] [--broadcast]"
    from="${positional[0]}"
    to="${positional[1]}"
    subject="${positional[2]}"
    body="${positional[3]}"
    [[ $broadcast == 0 || $to == '*' ]] ||
      die "--broadcast requires the '*' address"
    validate_message "$from" "$to" "$subject" "$body"
    case "$selected_protocol" in
      off)
        die "communications are disabled by comms=off"
        ;;
      db)
        db_send "$from" "$to" "$subject" "$body" "$dead_drop"
        ;;
      file)
        mint_message_id
        file_send_with_id "$MINTED_ID" "$from" "$to" "$subject" "$body" \
          "$dead_drop"
        ;;
      both)
        db_output="$(db_send "$from" "$to" "$subject" "$body" "$dead_drop")"
        extract_message_id "$db_output"
        file_send_with_id "$EXTRACTED_ID" "$from" "$to" "$subject" "$body" \
          "$dead_drop" >/dev/null
        builtin printf '%s\n' "$db_output"
        ;;
    esac
    ;;
  poll)
    handle="${1:-}"
    [[ -n $handle ]] || die "usage: north-comms poll <me> [--budget-ms N] [--max N]"
    shift
    budget_ms="$db_budget_ms"
    maximum="$DEFAULT_MAX"
    while (($#)); do
      case "$1" in
        --budget-ms)
          (($# >= 2)) || die "--budget-ms requires a value"
          budget_ms="$2"
          shift 2
          ;;
        --max)
          (($# >= 2)) || die "--max requires a value"
          maximum="$2"
          shift 2
          ;;
        *) die "usage: north-comms poll <me> [--budget-ms N] [--max N]" ;;
      esac
    done
    [[ $budget_ms =~ ^[1-9][0-9]*$ && $maximum =~ ^[1-9][0-9]*$ ]] ||
      die "poll budgets must be positive integers"
    read_both=0
    [[ $selected_protocol != off &&
       ($selected_protocol == both || $enforcement == biased) ]] &&
      read_both=1
    if [[ $selected_protocol == file || $read_both == 1 ]]; then
      [[ $file_poll_mode == hook ]] &&
        file_poll "$handle" "$budget_ms" "$maximum"
    fi
    if [[ $read_both == 1 ]]; then
      for id in "${FILE_DELIVERED_IDS[@]}"; do
        db_ack "$handle" "$id" >/dev/null 2>&1 || true
      done
    fi
    if [[ $selected_protocol == db || $read_both == 1 ]]; then
      db_poll "$handle"
    fi
    ;;
  ack)
    (($# == 2)) || die "usage: north-comms ack <me> <message-id>"
    valid_message_id "$2" || die "message id is malformed or too large"
    case "$selected_protocol" in
      off) die "communications are disabled by comms=off" ;;
      db) db_ack "$1" "$2" ;;
      file) file_ack "$1" "$2" ;;
      both)
        file_ack "$1" "$2"
        db_ack "$1" "$2" >/dev/null
        ;;
    esac
    ;;
  presence)
    (($# >= 1 && $# <= 2)) ||
      die "usage: north-comms presence <me> [--announce]"
    handle="$1"
    announce=0
    [[ ${2:-} != --announce ]] || announce=1
    [[ $# == 1 || ${2:-} == --announce ]] ||
      die "usage: north-comms presence <me> [--announce]"
    if [[ $announce == 1 ]]; then
      case "$selected_protocol" in
        off) exit 0 ;;
        db) db_presence "$handle" 1 ;;
        file) file_presence "$handle" 1 ;;
        both)
          db_presence "$handle" 1 >/dev/null
          file_presence "$handle" 1
          ;;
      esac
    elif [[ $selected_protocol != off &&
            ($selected_protocol == both || $enforcement == biased) ]]; then
      db_result="$(db_presence "$handle" 0 2>/dev/null || true)"
      file_result="$(file_presence "$handle" 0 2>/dev/null || true)"
      if [[ $file_result == reachable* ]]; then
        builtin printf '%s\n' "$file_result"
      elif [[ $db_result == reachable* ]]; then
        builtin printf '%s\n' "$db_result"
      else
        builtin printf '%s\n' "${file_result:-${db_result:-absent $handle}}"
        exit 1
      fi
    elif [[ $selected_protocol == off ]]; then
      builtin printf 'absent %s\n' "$handle"
      exit 1
    elif [[ $selected_protocol == db ]]; then
      db_presence "$handle" 0
    else
      file_presence "$handle" 0
    fi
    ;;
  watch)
    (($# >= 1 && $# <= 2)) ||
      die "usage: north-comms watch <me> [--once]"
    handle="$1"
    once=0
    [[ ${2:-} != --once ]] || once=1
    [[ $# == 1 || ${2:-} == --once ]] ||
      die "usage: north-comms watch <me> [--once]"
    case "$selected_protocol" in
      off) die "communications are disabled by comms=off" ;;
      db) db_watch "$handle" "$once" ;;
      file) file_watch "$handle" "$once" ;;
      both) file_watch "$handle" "$once" ;;
    esac
    ;;
  doctor)
    (($# == 0)) || die "usage: north-comms doctor"
    doctor
    ;;
  *)
    die "usage: north-comms {send|mention|interrupt|poll|ack|presence|watch|doctor}"
    ;;
esac
