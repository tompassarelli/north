#!/usr/bin/env bash
set -euo pipefail
[[ $# -le 1 ]] || exit 64
state="${XDG_STATE_HOME:-$HOME/.local/state}/machine-updates"
mkdir -p "$state"
exec 9>"$state/agent-runtime-update.lock"
flock 9
failed=()
step() { "$@" || failed+=("$* (exit $?)"); }
step codex-runtime-update "${1:-latest}"
step north runtime update
step claude-runtime-update "${1:-latest}"
step agy-runtime-update "${1:-latest}"
if (( ${#failed[@]} )); then
  printf 'agent-runtime-update: failed: %s\n' "${failed[@]}" >&2
  exit 1
fi
date +%s > "$state/.agent-runtime-update.success.$$"
mv -f -- "$state/.agent-runtime-update.success.$$" "$state/agent-runtime-update.success"
