#!/usr/bin/env bash
# north-exec — launch floor: two preconditions (codex on PATH + its cached
# login); observers never gate. Runs in wt-<slug> beside main/; never pushes.
# usage: north-exec <checkout|container> <prompt|@brief> [--slug NAME] [--model MODEL]
set -euo pipefail

die() { echo "north-exec: $*" >&2; exit 1; }

[ $# -ge 2 ] || die "usage: north-exec <project> <prompt|@brief-file> [--slug NAME] [--model MODEL]"
project=$1; shift
prompt=$1; shift
slug="exec-$(date +%m%d-%H%M%S)"
model=""
while [ $# -gt 0 ]; do
  case $1 in
    --slug)  slug=${2:?--slug needs a value}; shift 2 ;;
    --model) model=${2:?--model needs a value}; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
case $slug in
  */*|.*) die "slug must be a plain branch name: $slug" ;;
esac
case $prompt in
  @*) prompt=$(cat "${prompt#@}") || die "unreadable brief: ${prompt#@}" ;;
esac
[ -n "$prompt" ] || die "empty prompt"

# Auth is deliberately not prechecked: a failure surfaces in the event
# stream as the provider's real error.
command -v codex >/dev/null || die "codex not on PATH — npm install -g @openai/codex"

root=$project
git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1 || root=$project/main
git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1 \
  || die "$project is neither a git checkout nor a container with main/"
root=$(git -C "$root" rev-parse --show-toplevel)
container=$(dirname "$root")

wt=$container/wt-$slug
[ ! -e "$wt" ] || die "worktree already exists: $wt"
# Clone, not worktree: a worktree's git metadata lives under main/.git,
# outside the workspace-write sandbox, so the agent could never commit.
git clone -q "$root" "$wt"
git -C "$wt" switch -q -c "$slug"
git -C "$wt" remote set-url --push origin DISABLED
base=$(git -C "$wt" rev-parse --short HEAD)

logdir=${XDG_STATE_HOME:-$HOME/.local/state}/north/exec
mkdir -p "$logdir"
log=$logdir/$slug.jsonl
err=$logdir/$slug.stderr
echo "north-exec: $slug on $base -> $wt"
echo "north-exec: events -> $log"

set +e
(cd "$wt" && codex exec --json --sandbox workspace-write \
    ${model:+--model "$model"} "$prompt") >"$log" 2>"$err"
status=$?
set -e

commits=$(git -C "$wt" rev-list --count "$base..HEAD")
echo "north-exec: exit $status, $commits commit(s)"
git -C "$wt" log --oneline "$base..HEAD" | sed 's/^/  /'
if [ "$status" -ne 0 ]; then
  echo "north-exec: last stderr lines:" && tail -3 "$err" | sed 's/^/  /'
fi
if [ "$commits" -gt 0 ]; then
  echo "land:  git -C $root fetch $wt $slug && git -C $root merge --ff-only FETCH_HEAD"
fi
echo "clean: rm -rf $wt"
exit $status
