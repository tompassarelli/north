#!/usr/bin/env bash
set -uo pipefail
helper="$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs"
status=0
for git_dir in "$HOME"/code/*/main/.git; do
  [ -e "$git_dir" ] || continue
  repo="${git_dir%/.git}"
  name="$(basename "$(dirname "$repo")")"
  case "$name" in clause|beagle|archive) continue ;; esac
  printf 'git-maintenance-nightly: %s\n' "$repo"
  bun "$helper" run --class moderate --owner "git-maintenance:$name" --timeout-seconds 3600 -- \
    git -C "$repo" -c pack.threads=2 maintenance run || status=1
done
exit "$status"
