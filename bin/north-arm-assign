#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: north-arm-assign [--record --thread <id>]
                        [--force graph|text --why <reason>]
                        <task-id-or-thread>

Hashes the exact UTF-8 identifier bytes with SHA-256 (no trailing newline).
An even low hexadecimal bit selects graph; an odd bit selects text.

Forced assignments must be recorded so the override remains auditable.
EOF
}

die() {
  echo "north-arm-assign: $*" >&2
  exit 2
}

assignment_id=""
record=0
thread=""
force=""
why=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --record)
      record=1
      shift
      ;;
    --thread)
      [ "$#" -ge 2 ] || die "--thread requires an id"
      thread="$2"
      shift 2
      ;;
    --force)
      [ "$#" -ge 2 ] || die "--force requires graph or text"
      force="$2"
      shift 2
      ;;
    --why)
      [ "$#" -ge 2 ] || die "--why requires a reason"
      why="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      [ "$#" -eq 1 ] || die "expected exactly one task id or thread after --"
      assignment_id="$1"
      shift
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [ -z "$assignment_id" ] || die "expected exactly one task id or thread"
      assignment_id="$1"
      shift
      ;;
  esac
done

[ -n "$assignment_id" ] || die "a nonempty task id or thread is required"

case "$force" in
  ""|graph|text) ;;
  *) die "--force must be graph or text" ;;
esac

if [ "$record" -eq 1 ]; then
  [ -n "$thread" ] || die "--record requires --thread <id>"
elif [ -n "$thread" ]; then
  die "--thread is only valid with --record"
fi

if [ -n "$force" ]; then
  [ -n "$why" ] || die "--force requires a nonempty --why reason"
  [ "$record" -eq 1 ] || die "forced assignments require --record --thread <id>"
elif [ -n "$why" ]; then
  die "--why is only valid with --force"
fi

command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
digest="$(printf '%s' "$assignment_id" | sha256sum)"
digest="${digest%% *}"
[[ "$digest" =~ ^[0-9a-f]{64}$ ]] || die "sha256sum returned an invalid digest"

case "${digest:63:1}" in
  0|2|4|6|8|a|c|e) arm=graph ;;
  1|3|5|7|9|b|d|f) arm=text ;;
  *) die "cannot read the digest's low bit" ;;
esac

if [ -n "$force" ]; then
  arm="$force"
fi

if [ "$record" -eq 1 ]; then
  root="$(cd "$(dirname "$0")/.." && pwd -P)"
  north_bin="${NORTH_ARM_ASSIGN_NORTH_BIN:-$root/bin/north}"
  [ -x "$north_bin" ] || die "north executable not found: $north_bin"
  recorded_arm="$arm"
  if [ -n "$force" ]; then
    recorded_arm="forced-$force"
  fi
  if [ -n "$force" ]; then
    "$north_bin" tell "$thread" run_arm_why "$why"
  fi
  "$north_bin" tell "$thread" run_arm "$recorded_arm"
fi

printf '%s\n' "$arm"
