#!/usr/bin/env bash
# safe-push — the standing-authorized way to push to GitHub without asking a human.
# Encodes the global AGENTS.md push policy as a mechanical check so every
# agent pushes identically-safe: scan the to-be-pushed commits for secrets, refuse
# force/destructive pushes, then push HEAD to the same-named remote branch unless
# an explicit --to destination is supplied. Any guard
# trip => nothing is pushed, nonzero exit. The secret scan — not a human — is the
# guard, and it travels with this command, so it protects repos that have no
# commit-time hook (north today). The repository state that defines
# the scan is captured first and must remain identical at publication; pushes
# name the captured object ID and destination ref explicitly.
#
# Usage:  safe-push [--dry-run] [--to BRANCH] [--keep-lane]
#         safe-push [--dry-run] --tag NAME
# /proc is the host's even inside run-bounded's PID namespace, so peers are named by host PID.
read -r self_pid _ </proc/self/stat
set -euo pipefail

safe_push_terminal() {
  local status="${1:-$?}" terminal_sha="" terminal_reason
  trap - EXIT
  if [ "$status" -eq 130 ] || [ "$status" -eq 143 ]; then
    printf 'safe-push: cancelled\n'
    exit 130
  fi
  if [ "${safe_push_internal:-0}" = 1 ] || [ "${safe_push_help:-0}" = 1 ]; then exit "$status"; fi
  if [ "${safe_push_timed_out:-0}" -eq 1 ]; then
    local north_runtime="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
    if [ -x "$north_runtime" ] && "$north_runtime" safe-push-result timeout '' '' "${safe_push_timeout_minutes:-180}" "${safe_push_run_url:-unknown}"; then exit 2; fi
    printf 'safe-push: timed out after %sm (run %s)\n' "${safe_push_timeout_minutes:-180}" "${safe_push_run_url:-unknown}"
    exit 2
  fi
  if [ "$status" -eq 0 ] && [ "${dry:-0}" -eq 1 ]; then exit 0; fi
  if [ "$status" -eq 0 ] && [ "${dry:-0}" -eq 0 ]; then
    terminal_sha="${safe_push_landed_sha:-}"
    if [ -n "$terminal_sha" ] && [ "$terminal_sha" = "${safe_push_published_head:-}" ] \
        && git --git-dir="$safe_push_common_dir" fetch -q --no-tags "$origin_url" "refs/heads/${to:-$destination_branch}"; then
      local missing
      missing=$(git --git-dir="$safe_push_common_dir" cherry FETCH_HEAD "$terminal_sha" | grep -c '^+') || true
      if [ "$terminal_sha" = "${destination_oid:-}" ] && [ "${safe_push_nothing_to_push:-0}" -ne 1 ]; then missing=$((missing > 0 ? missing : 1)); fi
      if [ "$missing" -gt 0 ]; then
        safe_push_refusal="NOT landed: $missing lane commits missing from origin/${to:-$destination_branch}"
        printf 'safe-push: %s\n' "$safe_push_refusal" >&2
        terminal_sha=""
      fi
    else
      terminal_sha=""
    fi
    if [ -n "$terminal_sha" ]; then
      local north_runtime="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
      if [ -x "$north_runtime" ] && "$north_runtime" safe-push-result landed "$terminal_sha" '' 0 ''; then exit 0; fi
      printf 'safe-push: landed %s\n' "$terminal_sha"
      exit 0
    fi
  fi
  terminal_reason="${safe_push_refusal:-safe-push did not land}"
  local north_runtime="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
  if [ -x "$north_runtime" ] && "$north_runtime" safe-push-result refused '' "$terminal_reason" 0 ''; then exit 1; fi
  printf 'safe-push: refused %s\n' "$terminal_reason"
  exit 1
}

safe_push_exit() {
  local status=$?
  if declare -F finish_push >/dev/null; then finish_push; fi
  if [ "${NORTH_NO_AUTOREAP:-0}" = 1 ]; then exit "$status"; fi
  safe_push_terminal "$status"
}

safe_push_internal=0
safe_push_help=0
if [ "${1:-}" = --durable-harness-paths ] && [ "$#" -eq 2 ]; then safe_push_internal=1; fi
if [ "$#" -eq 1 ] && [[ "$1" = -h || "$1" = --help ]]; then safe_push_help=1; fi
trap safe_push_exit EXIT
drop_land_branch() { SAFE_PUSH_ACTIVE=1 git push -q --force-with-lease="refs/heads/$1:$2" origin ":refs/heads/$1"; }
safe_push_cancel() {
  trap - INT TERM HUP
  [ -z "${safe_push_child:-}" ] || kill -TERM "$safe_push_child" 2>/dev/null || true
  [ -z "${autoland_reply:-}" ] || rm -f -- "$autoland_reply"
  [ -z "${queue_branch:-}" ] || printf 'safe-push: stopped; %s stays queued for Autoland once pushed (safe-push abandon withdraws it)\n' "$queue_branch"
  exit 130
}
trap safe_push_cancel INT TERM HUP
original_arguments=("$@")
if [ "${1:-}" = abandon ]; then
  safe_push_internal=1; abandoned=$(north land-abandon "${@:2}") || exit $?
  drop_land_branch "${abandoned%%$'\t'*}" "${abandoned#*$'\t'}" && printf 'safe-push: deleted %s from origin\n' "${abandoned%%$'\t'*}"; exit
fi
safe_push_common_dir=""

durable_harness_paths() {
  case "$1" in
    north) printf '%s\n' harness/ agent-machinery/ bin/ lib/ ;;
    south) printf '%s\n' agents/ ;;
    firn|nixos-config)
      printf 'modules/%s/\n' agent-runtime-update agent-slice agents-flow-stall \
        capacity-watchdog claude codex codex-runtime job-run job-watch lane-gc model-watch \
        north-profile plato skill-review-queue worker-ledger
      ;;
  esac
}

if [ "${1:-}" = --durable-harness-paths ] && [ "$#" -eq 2 ]; then
  durable_harness_paths "$2"
  exit 0
fi

usage() {
  cat <<'USAGE'
Usage: safe-push [--dry-run] [--to BRANCH] [--keep-lane] [--direct]
       safe-push [--dry-run] --tag NAME
       safe-push abandon [BRANCH]

Check instruction limits and scan secrets, then push the current branch or one tag.
Repository AGENTS.md: 100 lines.
Move longer detail to CLI --help, help TOPIC, or indexed docs.

Options:
  --dry-run    run all safety checks without pushing
  --to BRANCH  explicitly publish HEAD to another remote branch: rebases onto
               origin BRANCH and runs the repo's pre-push hook, then takes the
               per-origin landing lock only to fetch, rebase and push; a
               repository whose committed .safe-push sets landing.exact = true
               instead queues for the lock in arrival order before the hook,
               and re-runs the hook only when another push moved origin BRANCH;
               the lock holder lands the lanes queued behind it as one train
               (origin BRANCH plus each lane cherry-picked in arrival order,
               one hook run, halves re-run on red) and tells each its verdict;
               a lane already on origin BRANCH counts as landed; while the
               open "BRANCH is red" issue is #N, a lane with #N in a commit
               subject queues ahead of the others, and a holder hands its
               undecided lanes back behind it before its next check run;
               when main has .github/workflows/autoland.yml or its .safe-push
               sets landing.queue = autoland,
               the lane is checked, pushed to claude/land-<lane>-<sha> and
               waits for the Autoland workflow's batched queue to land it;
               a stop, a refusal or a handback deletes that queue branch, and
               a Classic record refresh handback returns 75 keeping the lane;
               a BRANCH other than origin's default (farm/*, scratch) skips
               the lock and the queue and runs the hook in its own push
  --keep-lane  after landing --to main from ~/code/<project>/worktrees/<slug>,
               keep the lane instead of removing it and its branch
  --direct     with --to main in an Autoland repository, push main directly
               instead of joining the queue; emergencies only, logged in
               ~/.local/state/safe-push/direct-landings.tsv
  --tag NAME   push an existing annotated tag after scanning new content
  -h, --help   print this help without inspecting a repository
  abandon      delete this lane's claude/land-<lane>-<sha>, or BRANCH, from
               origin once main holds each of its commit subjects or Autoland
               handed it back; any other branch is refused

On a non-default branch, plain "safe-push" (no --to/--tag) is refused —
one-branch-main doctrine: origin carries the default branch only. Publish
with --to main, or --to another branch as a deliberate escape hatch.

Generated records opt in through committed .safe-push:
  [generated "path/to/record"]
      input = path/to/primary-source
Repeat input for each exact tracked primary file. The base/head inventory union
counts changed file blobs; private external assets are outside this guarantee.
Rewriting over half the old rows with fewer than 5% of those files changed is
refused. Missing enabled input authority is refused; undeclared files pass.

Each running safe-push needs its own output log file; a second one writing to
the same file is refused.

A landing on origin's default branch runs follows-release, which starts each
queued Follows box (threads queue follow) whose predecessor is now on it.

A clean lane landed with --to main is removed afterwards (git worktree remove,
then git branch -d), and its same-named origin branch is deleted when main
holds all of it.
USAGE
}

argument_error() {
  printf 'safe-push: %s\n' "$1" >&2
  usage >&2
  exit 2
}

plan_push() {
  local mode="$1"
  shift
  case "$mode" in
    arguments)
      dry=0
      keep_lane=0
      direct=0
      tag=""
      tag_seen=0
      to=""
      to_seen=0
      while [ "$#" -gt 0 ]; do
        case "$1" in
          -h|--help)
            if [ "$#" -ne 1 ] || [ "$dry" -eq 1 ] || [ "$tag_seen" -eq 1 ] || [ "$to_seen" -eq 1 ]; then
              argument_error '--help cannot be combined with other arguments'
            fi
            usage
            exit 0
            ;;
          --dry-run) [ "$dry" -eq 0 ] || argument_error 'duplicate --dry-run'; dry=1; shift ;;
          --keep-lane) [ "$keep_lane" -eq 0 ] || argument_error 'duplicate --keep-lane'; keep_lane=1; shift ;;
          --direct) [ "$direct" -eq 0 ] || argument_error 'duplicate --direct'; direct=1; shift ;;
          --tag)
            [ "$tag_seen" -eq 0 ] || argument_error 'duplicate --tag'
            [ "$#" -ge 2 ] || argument_error '--tag needs a name'
            case "$2" in
              ''|-*) argument_error '--tag needs a name' ;;
            esac
            tag="$2"
            tag_seen=1
            shift 2
            ;;
          --to)
            [ "$to_seen" -eq 0 ] || argument_error 'duplicate --to'
            [ "$#" -ge 2 ] || argument_error '--to needs a branch name'
            case "$2" in
              ''|-*) argument_error '--to needs a branch name' ;;
            esac
            to="$2"
            to_seen=1
            shift 2
            ;;
          -f|--force|--force-with-lease|--mirror|--delete|--prune)
            printf "safe-push: refuses '%s' — force/destructive pushes are deliberate + manual, not automatic\n" "$1" >&2
            exit 1
            ;;
          *)
            argument_error "unknown argument '$1'"
            ;;
        esac
      done

      [ "$tag_seen" -eq 0 ] || [ "$to_seen" -eq 0 ] \
        || argument_error '--to cannot be combined with --tag'
      [ "$keep_lane" -eq 0 ] || [ "$to_seen" -eq 1 ] \
        || argument_error '--keep-lane needs --to'

      if [ "$to_seen" -eq 1 ]; then
        case "$to" in
          ''|-*|HEAD|refs/*|origin/*|*'..'*|*'@{'*|*\\*|*' '*|*'~'*|*'^'*|*':'*|*'?'*|*'*'*|*'['*)
            argument_error "invalid destination branch '$to'"
            ;;
        esac
      fi
      ;;
    source)
      [ "$1" = "$2" ] && return 0
      printf 'safe-push: non-main branch %s: publish with safe-push --to main (one-branch-main doctrine)\n' "$1" >&2
      printf 'safe-push: pushing branch names to origin is disabled\n' >&2
      exit 1
      ;;
    snapshot)
      local output="$1" destination_ref="$2" value ref extra count=0 oid=""
      if [ -z "$output" ]; then
        printf 'absent\n'
        return 0
      fi
      while IFS=$'\t' read -r value ref extra; do
        case "$value" in
          'ref: '*)
            echo "safe-push: origin destination $destination_ref is symbolic — refusing" >&2
            return 1
            ;;
        esac
        if { [[ "$value" =~ ^[0-9a-f]{40}$ ]] || [[ "$value" =~ ^[0-9a-f]{64}$ ]]; } \
            && [ "$ref" = "$destination_ref" ] && [ -z "$extra" ]; then
          oid="$value"
          count=$((count + 1))
        else
          echo "safe-push: origin destination $destination_ref is malformed or ambiguous — refusing" >&2
          return 1
        fi
      done <<<"$output"
      if [ "$count" -ne 1 ]; then
        echo "safe-push: origin destination $destination_ref is malformed or ambiguous — refusing" >&2
        return 1
      fi
      printf 'object:%s\n' "$oid"
      ;;
    publication)
      local head_oid="$1" destination_ref="$2" destination_oid="$3"
      publication="${head_oid}:${destination_ref}"
      publication_flags=(--force-with-lease="${destination_ref}:${destination_oid}")
      ;;
  esac
}

plan_push arguments "$@"

validate_destination_name() {
  git check-ref-format "refs/heads/$1" >/dev/null 2>&1 \
    || argument_error "invalid destination branch '$1'"
}

if [ "$to_seen" -eq 1 ]; then validate_destination_name "$to"; fi

# A log file belongs to one safe-push tree: workers sharing a scratch push.log read each other's landings as their own.
claim_output_log() {
  local fd target claimed=""
  for fd in 1 2; do
    target=$(readlink "/proc/$self_pid/fd/$fd" 2>/dev/null) || continue
    [ -f "$target" ] || continue
    case " $claimed ${SAFE_PUSH_OUTPUT_CLAIMED:-} " in *" $target "*) continue ;; esac
    exec {output_lock_fd}<"$target"
    if ! flock -n "$output_lock_fd"; then
      printf 'safe-push: refusing in %s: %s is already the log of another running safe-push; give each landing its own log file. NOT pushed.\n' \
        "$PWD" "$target" >&2
      exit 1
    fi
    claimed="$claimed $target"
  done
  export SAFE_PUSH_OUTPUT_CLAIMED="${SAFE_PUSH_OUTPUT_CLAIMED:-}$claimed"
}
claim_output_log

state_changed() {
  printf 'safe-push: repository state changed during secret scan (%s) — refusing; NOT pushed.\n' "$1" >&2
  exit 1
}

record_push() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
  local repository="${origin_url##*/}"
  repository="${repository%.git}"
  mkdir -p "$dir" && printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$repository" "$2" "$3" "$4" "$5" >>"$dir/pushes.tsv" \
    || printf 'safe-push: could not record push timing\n' >&2
}

capture_repository_state() {
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "safe-push: not in a git repo"; exit 1; }
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
    || { echo "safe-push: cannot identify this Git worktree"; exit 1; }
  origin_url=$(git remote get-url --push origin 2>/dev/null) \
    || { echo "safe-push: origin has no push URL"; exit 1; }
  branch_ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) \
    || { echo "safe-push: detached HEAD — checkout a branch first"; exit 1; }
  case "$branch_ref" in
    refs/heads/*) branch=${branch_ref#refs/heads/} ;;
    *) echo "safe-push: HEAD does not name a local branch"; exit 1 ;;
  esac
  head_oid=$(git rev-parse --verify "${branch_ref}^{commit}" 2>/dev/null) \
    || { echo "safe-push: cannot resolve $branch_ref to a commit"; exit 1; }
}

check_instruction_limits() {
  local helper
  helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-instruction-check"
  "$helper" --repo "$repo_root" --ref "$1"
}

# Public deny-list: private identity values never reach a public repository.
# An absent deny-list refuses a public push where south exists and warns
# elsewhere; an unknown visibility fails closed.
south="${SAFE_PUSH_SOUTH:-$HOME/code/south}"
denylist="${SAFE_PUSH_DENYLIST:-$south/main/privacy/public-denylist.toml}"
origin_visibility=""
resolve_origin_visibility() {
  { [ -f "$denylist" ] || [ -d "$south" ]; } && [ -z "$origin_visibility" ] || return 0
  origin_visibility=$(gh repo view "$1" --json visibility -q .visibility 2>/dev/null) || origin_visibility=""
  [ -n "$origin_visibility" ] || origin_visibility=UNKNOWN
}

commit_email_scan() {
  local self addr allowed sha author committer role email log
  local -a allow=()
  self=$(git config user.email 2>/dev/null) || self=""
  if [ -z "$self" ]; then
    echo "safe-push: ✗ git config user.email is empty, so outgoing author and committer emails cannot be checked; set it before pushing; NOT pushed."
    return 1
  fi
  allow=("${self,,}")
  for addr in "${GIT_AUTHOR_EMAIL:-}" "${GIT_COMMITTER_EMAIL:-}"; do
    [ -z "$addr" ] || allow+=("${addr,,}")
  done
  while IFS= read -r addr; do
    [ -z "$addr" ] || allow+=("${addr,,}")
  done < <(git config --get-all safe-push.allowEmail 2>/dev/null || true)
  allowed=$(printf '%s, ' "${allow[@]}")
  allowed=${allowed%, }
  log=$(git log --format='%H %ae %ce' "$@") || { echo "safe-push: cannot read the outgoing commit emails; NOT pushed."; return 1; }
  while read -r sha author committer; do
    [ -n "$sha" ] || continue
    for role in author committer; do
      email=${!role}
      for addr in "${allow[@]}"; do
        [ "${email,,}" != "$addr" ] || continue 2
      done
      echo "safe-push: commit $(git rev-parse --short "$sha") $role email $email is not $allowed; re-author with git commit --amend --reset-author (or rebase --exec) before pushing; NOT pushed."
      return 1
    done
  done <<<"$log"
}

native_ref_re='(^|[^[:alnum:]_])(life|accounts|travel|ops)#[0-9]+'

denylist_scan() {
  if [ ! -f "$denylist" ] && [ ! -d "$south" ]; then
    echo "safe-push: ⚠ no deny-list at $denylist and no south checkout at $south, so private values were not scanned."
    return 0
  fi
  resolve_origin_visibility "$origin_url"
  case "$origin_visibility" in PRIVATE|INTERNAL) return 0 ;; esac
  if [ ! -f "$denylist" ]; then
    echo "safe-push: ✗ the deny-list $denylist is missing although $south exists, so a $origin_visibility push cannot be scanned for private values; restore it in south; NOT pushed."
    return 1
  fi
  local findings status=0
  findings=$(north denylist scan --config "$denylist" "$1" "$2" ${3:+--ref "$3"} 2>&1) || status=$?
  [ "$status" -ne 0 ] || return 0
  printf '%s\n' "$findings"
  [ "$status" -eq 1 ] || { echo "safe-push: ✗ the deny-list scan could not run (exit $status), so a $origin_visibility push was not checked for private values; NOT pushed."; return 1; }
  echo "safe-push: ✗ PRIVATE VALUE for a $origin_visibility repository matched the deny-list $denylist — it belongs in south; NOT pushed."
  return 1
}

native_ref_scan() {
  local text
  text=$(printf '%s\n' "$@"; git log --format=%B "${scan_range_for_native[@]}" 2>/dev/null) || { echo "safe-push: cannot read the outgoing commit messages for the native-ref scan; NOT pushed."; return 1; }
  if grep -Eq "$native_ref_re" <<<"$text"; then
    echo "safe-push: ✗ a branch name or commit message names a native NorthThread item (life/accounts/travel/ops#N); those stay in threads.db — reword without the ref; NOT pushed."
    return 1
  fi
}

core_tools="agents threads safe-push capacity-watchdog"

tracked_executable() {
  local mode
  mode=$(git -C "$1" ls-tree "$2" -- "$3" 2>/dev/null | awk '{print $1}')
  [ "$mode" = 100755 ] || [ "$mode" = 120000 ]
}

# ~/.local/bin links every tool out-of-store into north bin/ and firn dotfiles/bin/, so a tool removed from main breaks every session.
tool_removal_scan() {
  local base="${1%%..*}" head="${1##*..}" url own peer peer_bin path name trailers refused=0
  [ "$base" != "$1" ] && [ -n "$base" ] || return 0
  url=$(git remote get-url --push origin 2>/dev/null) || return 0
  case "${url%.git}" in
    */north) own=bin peer="$HOME/code/nixos-config/main" peer_bin=dotfiles/bin ;; # hardcoded-repo-path:allow
    */firn) own=dotfiles/bin peer="$HOME/code/north/main" peer_bin=bin ;; # hardcoded-repo-path:allow
    *) return 0 ;;
  esac
  trailers=$(git log --format=%B "$base..$head" | sed -n 's/^Removes-tool:[[:space:]]*\([^[:space:]]*\).*/\1/p')
  while IFS=$'\t' read -r meta path; do
    case "$meta" in :100755\ *|:120000\ *) ;; *) continue ;; esac
    name=${path#"$own"/}
    case "$name" in */* | *.test.*) continue ;; esac
    tracked_executable . "$head" "$own/$name" && continue
    tracked_executable "$peer" refs/remotes/origin/main "$peer_bin/$name" && continue
    case " $core_tools " in
      *" $name "*)
        echo "safe-push: ✗ removes core tool $name with no same-name replacement in $own/ or $peer_bin/ — a core tool cannot be removed; NOT pushed." ;;
      *) grep -Fxq -- "$name" <<<"$trailers" && continue
         echo "safe-push: ✗ removes tool $name from $own/ with no same-name replacement — add 'Removes-tool: $name' to the commit message if intended; NOT pushed." ;;
    esac
    refused=1
  done < <(git diff --raw --no-renames --diff-filter=D "$(git merge-base "$base" "$head" 2>/dev/null || echo "$base")" "$head" -- "$own/")
  [ "$refused" -eq 0 ]
}

mutant_marker_re='MUTANT:[[:alnum:]_-]'
test_path_re='(^|/)tests?/|[._]tests?\.[^/]*$|(^|/)test_[^/]*\.py$'
skip_marker_re='(^|[^[:alnum:]_])(it|test|describe)\.(skip|only)\(|#\[ignore|pytest\.mark\.(skip|xfail)|unittest\.skip'

vendored_trees() {
  local base="$1" entry
  command -v jq >/dev/null 2>&1 || return 0
  {
    git show "$base:effect-kit.json" 2>/dev/null | jq -r '.vendor // empty' 2>/dev/null || true
    while IFS= read -r entry; do
      case "$entry" in repos/*.json) git show "$base:$entry" 2>/dev/null | jq -r '.prefix // empty' 2>/dev/null || true ;; esac
    done < <(git ls-tree --name-only "$base" repos/ 2>/dev/null)
  } | grep -E '^[[:alnum:]_-][[:alnum:]._-]*(/[[:alnum:]_-][[:alnum:]._-]*)*$' || true
}

test_integrity_scan() {
  local base="${1%%..*}" head="${1##*..}" allow=0 test_kinds trailer name mutant helper vendored
  [ "$base" != "$1" ] && [ -n "$base" ] || return 0
  base=$(git merge-base "$base" "$head" 2>/dev/null || echo "$base")
  vendored=$(vendored_trees "$base")
  git log --format=%B "$base..$head" | grep -E '^Test-change:[[:space:]]*[^[:space:]]' >/dev/null && allow=1
  test_kinds=$(git log --format=%B "$base..$head" | sed -n "/^Test-kind:/p")
  helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/mutant"
  while IFS= read -r trailer; do
    if [[ "$trailer" =~ ^Test-kind:[[:space:]]+(.+)[[:space:]]+[1-5][[:space:]]+kills[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
      name=${BASH_REMATCH[1]}
      mutant=${BASH_REMATCH[2]}
      if ! "$helper" check "$mutant" "$base" "$head"; then
        printf 'safe-push: ✗ Test-kind %s claims mutant %s, which has no recorded non-empty patch; record it with mutant record; NOT pushed.\n' "$name" "$mutant"
        return 1
      fi
    fi
  done <<<"$test_kinds"
  git diff --unified=2147483647 --no-color --no-ext-diff --no-renames "$base" "$head" \
    | MUTANT_RE="$mutant_marker_re" TEST_PATH_RE="$test_path_re" SKIP_RE="$skip_marker_re" SKIP_ALLOWED=$allow TEST_KINDS="$test_kinds" VENDORED="$vendored" awk '
    function require_kind(name,    key, file) {
      file = path; sub(/^.*\//, "", file); key = file SUBSEP name
      if (removing) { removed[key] = 1; removed_name[name] = 1; return }
      if (retitling) candidate[key] = 1
      if (!(key in added)) { order[++added_count] = key; shown[key] = path }
      added[key] = 1
    }
    function in_vendored(file,    i) {
      for (i = 1; i <= vendored_count; i++) if (file == vendored_tree[i] || index(file, vendored_tree[i] "/") == 1) return 1
      return 0
    }
    function skeleton(line) { gsub(/"[^"]*"|\047[^\047]*\047/, "\"\"", line); return line }
    function test_names(line,    name, quote, escaped, j, char) {
      if (match(line, /(^|[^[:alnum:]_])def[[:space:]]+test_[[:alnum:]_]+/)) {
        name = substr(line, RSTART, RLENGTH); sub(/^.*def[[:space:]]+/, "", name); require_kind(name)
      }
      while (match(line, /(^|[^[:alnum:]_$])(test|it)[[:space:]]*\([[:space:]]*["\047]/)) {
        quote = substr(line, RSTART + RLENGTH - 1, 1)
        line = substr(line, RSTART + RLENGTH); name = ""; escaped = 0
        for (j = 1; j <= length(line); j++) {
          char = substr(line, j, 1)
          if (!escaped && char == quote) break
          if (!escaped && char == "\\") { escaped = 1; continue }
          name = name char; escaped = 0
        }
        if (j <= length(line)) require_kind(name)
        line = substr(line, j + 1)
      }
    }
    BEGIN {
      vendored_count = split(ENVIRON["VENDORED"], vendored_tree, "\n")
      count = split(ENVIRON["TEST_KINDS"], trailers, "\n")
      for (i = 1; i <= count; i++) {
        trailer = trailers[i]
        sub(/^Test-kind:[[:space:]]*/, "", trailer)
        if (match(trailer, /[[:space:]]+[1-5][[:space:]]+kills[[:space:]]+[^[:space:]].*$/))
          justified[substr(trailer, 1, RSTART - 1)] = 1
      }
    }
    /^diff --git / { header = 1; vendored = 0; new_file = 0; deleted_file = 0; rust_test = 0; next }
    header && /^new file mode / { new_file = 1; next }
    header && /^deleted file mode / { deleted_file = 1; next }
    header && /^--- / { old_path = substr($0, 7); next }
    header && /^\+\+\+ / {
      path = substr($0, 7); header = 0
      if (deleted_file) path = old_path
      vendored = in_vendored(path)
      if (vendored) next
      if ((new_file || deleted_file) && path ~ /\.test\.(sh|py|ts)$/) {
        name = path; sub(/^.*\//, "", name); removing = deleted_file; require_kind(name); removing = 0
      }
      next
    }
    !header && vendored { next }
    !header && path ~ /\.rs$/ && /^[+ ]/ {
      if (/#\[(tokio::)?test\]/) { rust_test = 1; rust_added = /^\+/ }
      if (rust_test && match($0, /(^|[^[:alnum:]_])fn[[:space:]]+[[:alnum:]_]+/)) {
        name = substr($0, RSTART, RLENGTH)
        sub(/^.*fn[[:space:]]+/, "", name)
        if (rust_added || /^\+/) require_kind(name)
        rust_test = 0
      }
    }
    !header && path ~ /\.rs$/ && /^-/ && match($0, /(^|[^[:alnum:]_])fn[[:space:]]+[[:alnum:]_]+/) {
      name = substr($0, RSTART, RLENGTH); sub(/^.*fn[[:space:]]+/, "", name)
      removing = 1; require_kind(name); removing = 0
    }
    !header && NR == candidate_nr + 1 { if (/^ /) for (key in candidate) retitled[key] = 1; delete candidate }
    !header && !/^[-+]/ { minus_count = 0; plus_index = 0 }
    !header && /^-/ { if (!last_minus) { minus_count = 0; plus_index = 0 } minus[++minus_count] = substr($0, 2) }
    !header { last_minus = /^-/ }
    !header && /^-/ && path ~ ENVIRON["TEST_PATH_RE"] { removing = 1; test_names(substr($0, 2)); removing = 0; next }
    header || !/^\+/ { next }
    $0 ~ ENVIRON["MUTANT_RE"] {
      print "safe-push: ✗ " path " adds a mutation marker: " substr($0, 2) " — mutants stay in scratch copies; NOT pushed."; bad = 1; next }
    ENVIRON["SKIP_ALLOWED"] != 1 && path ~ ENVIRON["TEST_PATH_RE"] && $0 ~ ENVIRON["SKIP_RE"] {
      print "safe-push: ✗ " path " adds a skip or focus: " substr($0, 2) " — name the changed requirement in a Test-change: trailer; NOT pushed."; bad = 1 }
    path ~ ENVIRON["TEST_PATH_RE"] && ++plus_index <= minus_count && skeleton(substr($0, 2)) == skeleton(minus[plus_index]) { retitling = 1; test_names(substr($0, 2)); retitling = 0; candidate_nr = NR; next }
    path ~ ENVIRON["TEST_PATH_RE"] || path ~ /\.rs$/ { test_names(substr($0, 2)) }
    END {
      for (i = 1; i <= added_count; i++) {
        key = order[i]
        split(key, part, SUBSEP)
        if (key in removed || part[2] in removed_name) continue
        if (key in retitled) continue
        if (!(part[2] in justified)) {
          print "safe-push: ✗ " shown[key] " adds test " part[2] " without a Test-kind: trailer naming its kind (1-5) and a mutant only it kills; NOT pushed."
          bad = 1
        }
      }
      exit bad
    }'
}

generated_rewrite_scan() {
  local base="${1%%..*}" head="${1##*..}"
  [ "$base" != "$1" ] && [ -n "$base" ] || return 0
  python3 - "$base" "$head" <<'PYGENERATED'
from collections import Counter
from pathlib import PurePosixPath
import subprocess
import sys


def git(*args, optional=False):
    result = subprocess.run(["git", *args], capture_output=True)
    if result.returncode and not optional:
        raise ValueError("cannot read committed generated authority")
    return result.stdout if not result.returncode else None


def declarations(ref):
    if git("cat-file", "-e", f"{ref}:.safe-push", optional=True) is None:
        return {}
    values = git("config", "--blob", f"{ref}:.safe-push", "--null", "--list")
    records = {}
    for entry in values.split(b"\0"):
        key, _, value = entry.partition(b"\n")
        name = key.decode("utf-8", "surrogateescape")
        if name.startswith("generated.") and name.endswith(".input"):
            output = name[len("generated."):-len(".input")]
            records.setdefault(output, set())
            if value:
                records[output].add(value.decode("utf-8", "surrogateescape"))
    return records


def valid_path(path):
    return bool(path and not path.startswith("/") and "\0" not in path
                and all(part not in ("", ".", "..") for part in path.split("/"))
                and not any(char in path for char in "*?[]") and str(PurePosixPath(path)) == path)


def tree(ref):
    entries = git("ls-tree", "-r", "-z", ref)
    return {path.decode("utf-8", "surrogateescape"): metadata.split()[2]
            for entry in entries.split(b"\0") if entry
            for metadata, path in [entry.split(b"\t", 1)]}


try:
    base, head = sys.argv[1:]
    old, new = declarations(base), declarations(head)
    if not old and not new:
        sys.exit(0)
    before, after = tree(base), tree(head)
    for output in sorted(old.keys() | new.keys()):
        inputs = old.get(output, set()) | new.get(output, set())
        if (not valid_path(output) or not inputs or output in inputs
                or output not in before and output not in after
                or output in old and output not in new
                or any(not valid_path(path) or path not in before and path not in after for path in inputs)):
            raise ValueError(f"{output}: missing or invalid generated input authority; declare repeated input = <tracked primary file> in [generated \"{output}\"]")
        if not old.get(output) and output in old or not new.get(output) and output in new:
            raise ValueError(f"{output}: enabled generated declaration has no primary inputs")
        if before.get(output) == after.get(output):
            continue
        if output not in before:
            continue
        rows = git("show", f"{base}:{output}").splitlines()
        next_rows = git("show", f"{head}:{output}").splitlines() if output in after else []
        removed = sum((Counter(rows) - Counter(next_rows)).values())
        changed = sum(before.get(path) != after.get(path) for path in inputs)
        if removed * 2 > len(rows) and changed * 20 < len(inputs):
            raise ValueError(f"{output}: rewrites {removed}/{len(rows)} old rows with {changed}/{len(inputs)} tracked primary inputs changed; keep generation proportional or fix its producer")
except (ValueError, OSError) as error:
    print(f"safe-push: ✗ {error}; NOT pushed.", file=sys.stderr)
    sys.exit(1)
PYGENERATED
}

provenance_scan() {
  local base="${1%%..*}" head="${1##*..}"
  [ "$base" != "$1" ] && [ -n "$base" ] || return 0
  command -v north >/dev/null 2>&1 || return 0; north provenance check "$base" "$head" && return 0
  echo "safe-push: ✗ a new gating bar, hook or policy line has no Provenance record; add 'Provenance: <claim with the bar>; origin <tom|experiment|prior-art|incident>; pointer <quote with date | run file plus rerun command | link | issue>; rationale <repo path#anchor | not recorded>; revisit <YYYY-MM-DD | closed REPO#N | event text>', or end it '; soft' (origin none allowed) for a bar that does not gate, whose miss lands with 'Target-debt: <bar>; measured <value>; owner <owner>; revisit <trigger>'; NOT pushed."
  return 1
}

review_scan() {
  local base="${1%%..*}" head="${1##*..}" paths
  [ "$base" != "$1" ] && [ -n "$base" ] || return 0
  mapfile -t paths < <(durable_harness_paths "$(basename "$(git remote get-url origin 2>/dev/null)" .git)")
  [ "${#paths[@]}" -gt 0 ] || return 0
  ! git -C "$(git rev-parse --show-toplevel)" --literal-pathspecs diff --quiet "$(git merge-base "$base" "$head")" "$head" -- "${paths[@]}" || return 0
  command -v north >/dev/null 2>&1 || { echo "safe-push: north not on PATH; refusing to land covered harness paths without the review gate; NOT pushed."; return 1; }
  north review-gate check "$base" "$head" "${paths[@]}" && return 0
  echo "safe-push: ✗ the covered harness diff lacks a review of its final patch-id; NOT pushed."
  return 1
}

ci_workflow_triggered() {
  local workflow="$1" filters pattern path
  shift
  case "$workflow" in local:*) return 0 ;; esac
  command -v yq >/dev/null 2>&1 || return 0
  filters=$(git show "refs/remotes/origin/main:.github/workflows/$workflow" 2>/dev/null \
    | yq -r '.on.push | select(type == "!!map") | .paths // [] | .[]' 2>/dev/null) || return 0
  [ -n "$filters" ] || return 0
  while IFS= read -r pattern; do
    case "$pattern" in '!'*) return 0 ;; esac
    for path in "$@"; do
      # shellcheck disable=SC2053
      [[ "$path" == $pattern ]] && return 0
    done
  done <<<"$filters"
  return 1
}

# Only throughput gates take this way through; correctness and safety refusals stay until the lane fixes them.
ci_budget_hold() {
  local workflow="$1" reason="$2" median="${3:--}" budget="${4:--}" dir file repo now first
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
  repo=$(git remote get-url origin 2>/dev/null || true)
  repo=${repo%.git}; repo=${repo##*/}; repo=${repo##*:}
  file="$dir/ci-budget-hold-$(printf '%s-%s' "$repo" "$workflow" | tr -c 'A-Za-z0-9._-' '_')"
  now=$(date +%s)
  mkdir -p "$dir"
  first=''
  [ ! -r "$file" ] || read -r first <"$file" || true
  if [[ ! "$first" =~ ^[0-9]+$ ]]; then
    first=$now
    printf '%s\n' "$now" >"$file"
  fi
  if (( now - first < 1800 )); then
    printf 'safe-push: ✗ CI budget %s: %s; NOT pushed.\n' "$workflow" "$reason"
    printf 'safe-push: CI budget %s has refused since %s; a recorded override opens at %s.\n' \
      "$workflow" "$(date -d "@$first" +%H:%M)" "$(date -d "@$((first + 1800))" +%H:%M)"
    return 1
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$repo" "$workflow" "$median" "$budget" \
    "$(git rev-parse --short HEAD)" "$(git branch --show-current)" "$reason" >>"$dir/ci-budget-overrides.tsv"
  printf 'safe-push: CI budget %s override: %s for %sm; landing with a recorded override in %s.\n' \
    "$workflow" "$reason" "$(( (now - first) / 60 ))" "$dir/ci-budget-overrides.tsv"
}

ci_budget_debt() {
  local workflow="$1" median="$2" budget="$3" ceiling="$4" dir repo
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
  repo=$(git remote get-url origin 2>/dev/null || true)
  repo=${repo%.git}; repo=${repo##*/}; repo=${repo##*:}
  mkdir -p "$dir"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$repo" "$workflow" "$median" "$budget" "$ceiling" \
    "$(git rev-parse --short HEAD)" "$(git branch --show-current)" >>"$dir/ci-budget-debt.tsv"
  printf 'safe-push: CI budget %s debt: median %ss over target %ss, under ceiling %ss; landing, recorded in %s.\n' \
    "$workflow" "$median" "$budget" "$ceiling" "$dir/ci-budget-debt.tsv"
}

ci_budget_clear() {
  local dir repo
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
  repo=$(git remote get-url origin 2>/dev/null || true)
  repo=${repo%.git}; repo=${repo##*/}; repo=${repo##*:}
  rm -f -- "$dir/ci-budget-hold-$(printf '%s-%s' "$repo" "$1" | tr -c 'A-Za-z0-9._-' '_')"
}

ci_budget_scan() {
  local range="$1" budgets base="${1%%..*}" head="${1##*..}" github_only=1 markdown_only=1 path
  local -a changed=()
  budgets=$(git config --blob refs/remotes/origin/main:.safe-push --get-all ci.budget 2>/dev/null) || return 0
  [ "$base" != "$range" ] && [ -n "$base" ] || return 0
  base=$(git merge-base "$base" "$head")
  range="$base..$head"
  while IFS= read -r -d '' path; do
    changed+=("$path")
    case "$path" in .github/*) ;; *) github_only=0 ;; esac
    case "$path" in *.md) ;; *) markdown_only=0 ;; esac
  done < <(git diff --name-only -z --no-renames "$base" "$head")
  if [ "${#changed[@]}" -gt 0 ] && [ "$github_only" = 1 ]; then
    echo 'safe-push: CI budget exemption — every changed path is under .github/.'
    return 0
  fi
  if [ "${#changed[@]}" -gt 0 ] && [ "$markdown_only" = 1 ]; then
    echo 'safe-push: CI budget exemption — every changed path is Markdown.'
    return 0
  fi

  local commits test_kind=0 workflow budget ceiling extra commit trailers name before arrow after matched improved
  local source rows sha wall result slowest runs ids id jobs measurement median since need head_sha
  local newest_job newest_seconds job_seconds
  local -a walls
  commits=$(git log --format=%H "$range")
  local main_red='' red
  while IFS= read -r commit; do
    red=$(git show -s --format='%(trailers:key=Main-red,valueonly)' "$commit" | awk 'NF { print $1; exit }')
    if [ -z "$red" ] || { [ -n "$main_red" ] && [ "$red" != "$main_red" ]; }; then main_red=''; break; fi
    main_red=$red
  done <<<"$commits"
  if git log --format='%(trailers:key=Test-kind)' "$range" | grep . >/dev/null; then test_kind=1; fi
  while read -r workflow budget ceiling extra; do
    if [ -z "$workflow" ] || [[ ! "$budget" =~ ^[0-9]+([.][0-9]+)?$ ]] || [ -n "$extra" ] \
        || { [ -n "$ceiling" ] && { [[ ! "$ceiling" =~ ^[0-9]+([.][0-9]+)?$ ]] \
          || ! awk -v c="$ceiling" -v b="$budget" 'BEGIN { exit !(c > b) }'; }; }; then
      echo 'safe-push: ✗ invalid ci.budget in main’s .safe-push — expected <workflow-file> <seconds> [<ceiling seconds>]; NOT pushed.'
      return 1
    fi
    if ! ci_workflow_triggered "$workflow" "${changed[@]}"; then
      printf 'safe-push: CI budget %s exemption — no changed path matches its push paths filter.\n' "$workflow"
      continue
    fi
    improved=0
    if [ "$test_kind" = 0 ] && [ -n "$commits" ]; then
      improved=1
      while IFS= read -r commit; do
        matched=0
        trailers=$(git show -s --format='%(trailers:key=CI-budget,valueonly)' "$commit")
        while read -r name before arrow after extra; do
          if [ "$name" = "$workflow" ] && [ "$arrow" = '->' ] && [ -z "$extra" ] \
              && [[ "$before" =~ ^[0-9]+([.][0-9]+)?s$ && "$after" =~ ^[0-9]+([.][0-9]+)?s$ ]] \
              && awk -v before="${before%s}" -v after="${after%s}" 'BEGIN { exit !(before > after) }'; then
            matched=1
          fi
        done <<<"$trailers"
        [ "$matched" = 1 ] || { improved=0; break; }
      done <<<"$commits"
    fi
    if [ "$improved" = 1 ]; then
      printf 'safe-push: CI budget %s exemption — every commit records a measured speed-up and none carries Test-kind:.\n' "$workflow"
      continue
    fi

    walls=()
    newest_job=''
    newest_seconds=''
    since=$(git log refs/remotes/origin/main -n 500 -z --format='%H%n%B' \
      | awk -v RS='\0' -v wf="$workflow" '{ n = split($0, l, "\n"); for (i = 2; i <= n; i++) {
          split(l[i], f, " "); b = f[3]; a = f[5]; sub(/s$/, "", b); sub(/s$/, "", a)
          if (f[1] == "CI-budget:" && f[2] == wf && f[4] == "->" && b + 0 > a + 0) { print l[1]; exit } } }')
    need=3
    [ -z "$since" ] || need=1
    case "$workflow" in
      local:*)
        source=${workflow#local:}
        case "$source" in /*) ;; *) source="$(git rev-parse --show-toplevel)/$source" ;; esac
        rows=$(tail -n 3 -- "$source") || {
          printf 'safe-push: ✗ CI budget %s: cannot read local timing source; NOT pushed.\n' "$workflow"
          return 1
        }
        if [ -n "$main_red" ] && [ "$(tail -n 1 -- "$source" | cut -f1)" = "$main_red" ] \
            && [[ ! "$(tail -n 1 -- "$source" | cut -f3)" =~ ^(pass|passed|success|ok)$ ]]; then
          printf 'safe-push: CI budget %s exemption — main is red at %s and every commit names it in Main-red:.\n' "$workflow" "$main_red"
          continue
        fi
        while IFS=$'\t' read -r sha wall result slowest; do
          [ -n "$sha" ] || continue
          case "$result" in cancelled|skipped) continue ;; esac
          if [[ ! "$wall" =~ ^[0-9]+([.][0-9]+)?$ ]] || [ -z "$result" ] || [ -z "$slowest" ]; then
            printf 'safe-push: ✗ CI budget %s: invalid local timing row; NOT pushed.\n' "$workflow"
            return 1
          fi
          walls+=("$wall")
          newest_job="$slowest"
        done <<<"$rows"
        ;;
      *)
        runs=$(gh run list --workflow "$workflow" --branch main --status completed --limit 10 \
          --json databaseId,conclusion,createdAt,headSha) || {
          ci_budget_hold "$workflow" 'gh failed to list completed main runs' || return 1
          continue
        }
        ids=$(jq -r 'sort_by(.createdAt) | reverse | .[] | select(.conclusion != "cancelled" and .conclusion != "skipped") | "\(.databaseId) \(.headSha // "")"' <<<"$runs") || {
          ci_budget_hold "$workflow" 'cannot parse main runs' || return 1
          continue
        }
        if [ -n "$main_red" ] && [ "$(jq -r 'sort_by(.createdAt) | reverse | map(select(.conclusion != "cancelled" and .conclusion != "skipped")) | .[0] | "\(.databaseId) \(.conclusion)"' <<<"$runs")" = "$main_red failure" ]; then
          printf 'safe-push: CI budget %s exemption — main is red at run %s and every commit names it in Main-red:.\n' "$workflow" "$main_red"
          continue
        fi
        while read -r id head_sha; do
          [ -n "$id" ] || continue
          if [ -n "$since" ] && ! git merge-base --is-ancestor "$since" "${head_sha:-$since^}" 2>/dev/null; then
            continue
          fi
          jobs=$(gh api "repos/{owner}/{repo}/actions/runs/$id/jobs?per_page=100" --paginate --slurp) || {
            ci_budget_hold "$workflow" "gh failed to read jobs for run $id" || return 1
            continue 2
          }
          measurement=$(jq -r '
            [.[].jobs[] | select(.started_at != null and .completed_at != null)
              | {name, start: (.started_at | fromdateiso8601), end: (.completed_at | fromdateiso8601)}
              | .seconds = (.end - .start)] as $jobs
            | if ($jobs | length) == 0 then empty else
                ($jobs | max_by(.seconds)) as $slowest
                | [([$jobs[].end] | max) - ([$jobs[].start] | min), $slowest.name, $slowest.seconds] | @tsv
              end' <<<"$jobs") || {
            ci_budget_hold "$workflow" "cannot measure jobs for run $id" || return 1
            continue 2
          }
          [ -n "$measurement" ] || continue
          IFS=$'\t' read -r wall slowest job_seconds <<<"$measurement"
          if [ "${#walls[@]}" = 0 ]; then newest_job="$slowest"; newest_seconds="$job_seconds"; fi
          walls+=("$wall")
          [ "${#walls[@]}" -lt 3 ] || break
        done <<<"$ids"
        ;;
    esac
    if [ "${#walls[@]}" -lt "$need" ]; then
      printf 'safe-push: CI budget %s: %s usable completed main runs (need %s) — passing.\n' "$workflow" "${#walls[@]}" "$need"
      continue
    fi
    [ -z "$since" ] || printf 'safe-push: CI budget %s: measuring %s main runs since CI-budget commit %s.\n' "$workflow" "${#walls[@]}" "${since:0:12}"
    median=$(printf '%s\n' "${walls[@]}" | sort -n | sed -n "$(( (${#walls[@]} + 1) / 2 ))p")
    if [ -n "$ceiling" ] && awk -v median="$median" -v budget="$budget" -v ceiling="$ceiling" \
        'BEGIN { exit !(median > budget && median <= ceiling) }'; then
      ci_budget_debt "$workflow" "$median" "$budget" "$ceiling"
      ci_budget_clear "$workflow"
      continue
    fi
    if awk -v median="$median" -v budget="$budget" 'BEGIN { exit !(median > budget) }'; then
      [ -z "$newest_seconds" ] || newest_job="$newest_job (${newest_seconds}s)"
      ci_budget_hold "$workflow" "median ${median}s > budget ${budget}s; slowest job in most recent run: $newest_job" \
        "$median" "$budget" || return 1
      continue
    fi
    ci_budget_clear "$workflow"
  done <<<"$budgets"
}

has_land_checks() {
  git config --blob HEAD:.safe-push --get-all land.check >/dev/null 2>&1
}

run_language_gate() {
  local base="$1" head="$2" root status
  root=$(git rev-parse --show-toplevel)
  [ -n "$base" ] || base=$(git hash-object -t tree /dev/null)
  command -v north >/dev/null 2>&1 || {
    echo 'safe-push: north not on PATH; refusing to land without the language gate; NOT pushed.' >&2
    return 1
  }
  north language-gate --repo "$root" --base "$base" --head "$head" || {
    status=$?
    echo 'safe-push: language gate refused the landing; NOT pushed.' >&2
    return "$status"
  }
}

run_land_checks() {
  local base="$1" head="$2" entry patterns command status entries root log_dir log
  local stdout_fd stderr_fd stdout_pid stderr_pid
  local -a specs=() commands=()
  local -A seen=()
  root=$(git rev-parse --show-toplevel)
  [ "${destination_branch:-${to:-}}" = main ] || return 0
  entries=$(git config --blob "$head:.safe-push" --get-all land.check 2>/dev/null) || return 0
  while IFS= read -r entry; do
    if [[ "$entry" != *' :: '* ]]; then
      echo "safe-push: invalid land.check: $entry; NOT pushed." >&2
      return 1
    fi
    patterns=${entry%% :: *}
    command=${entry#* :: }
    IFS=',' read -r -a specs <<<"$patterns"
    [ -n "$patterns" ] && [ -n "$command" ] || return 1
    if [ -n "$base" ]; then
      [ -n "$(git diff --name-only --no-renames "$base" "$head" -- "${specs[@]}")" ] || continue
    else
      [ -n "$(git ls-tree -r --name-only "$head" -- "${specs[@]}")" ] || continue
    fi
    [ -z "${seen[$command]:-}" ] || continue
    seen[$command]=1
    commands+=("$command")
  done <<<"$entries"
  for command in "${commands[@]}"; do
    log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
    mkdir -p "$log_dir"
    log_dir=$(cd "$log_dir" && pwd -P)
    find "$log_dir" -name 'land-check-*.log' -mtime +14 -delete
    log=$(mktemp "$log_dir/land-check-XXXXXXXXXX.log")
    printf 'safe-push: land check: %s\n' "$command"
    exec {stdout_fd}> >(drop_lock_fd; tee -a "$log")
    stdout_pid=$!
    exec {stderr_fd}> >(exec {stdout_fd}>&-; drop_lock_fd; tee -a "$log" >&2)
    stderr_pid=$!
    status=0
    (drop_lock_fd; cd "$root"; SAFE_PUSH_LAND_BASE="$base" SAFE_PUSH_LAND_HEAD="$head" north capacity deadline "${XDG_RUNTIME_DIR:-/run/user/$UID}/agent-capacity-v1/leases/${AGENT_CAPACITY_LEASE:-}.json" "${SAFE_PUSH_LAND_CHECK_TIMEOUT:-2100}" -- bash -euo pipefail -c "$command") >&"$stdout_fd" 2>&"$stderr_fd" {stdout_fd}>&- {stderr_fd}>&- &
    safe_push_child=$!
    wait "$safe_push_child" || status=$?
    safe_push_child=""
    exec {stdout_fd}>&- {stderr_fd}>&-
    reap_log_pipes "$stdout_pid" "$stderr_pid"
    if [ "$status" -ne 0 ]; then
      printf 'safe-push: land check %s exited %s; log: %s; NOT pushed.\n' "$command" "$status" "$log" >&2
      return "$status"
    fi
    rm -f -- "$log"
  done
}

reap_log_pipes() {
  local killer
  ( sleep 5; kill "$@" 2>/dev/null ) >/dev/null 2>&1 &
  killer=$!
  wait "$@" 2>/dev/null || true
  pkill -P "$killer" 2>/dev/null || true
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
}

remote_destination_snapshot() {
  local output
  output=$(git ls-remote --symref "$origin_url" "$destination_ref") \
    || { echo "safe-push: cannot read origin destination $destination_ref" >&2; return 1; }
  plan_push snapshot "$output" "$destination_ref"
}

report_reap_ready() {
  local container ready=0 wt main_branch head dirty ignored
  [ "$(basename "$repo_root")" = main ] || return 0
  container=$(dirname "$repo_root")
  main_branch=$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  # worktrees/ only: pins/ is externally consumed and is never a reap candidate.
  for wt in "$container"/worktrees/*; do
    [ -e "$wt/.git" ] || continue
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null) || continue
    [ -z "$dirty" ] || continue
    head=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || continue
    # Mirror wt-reap's ignored-file keep: ignored paths beyond disposable
    # caches (.direnv, result symlinks) make a tree not reap-ready.
    ignored=$(git -C "$wt" ls-files --others --ignored --exclude-standard 2>/dev/null |
      grep -v -E '(^|/)\.direnv/' | grep -v -E '^result(-[^/]*)?$') || true
    [ -z "$ignored" ] || continue
    if git -C "$repo_root" merge-base --is-ancestor "$head" "$main_branch" 2>/dev/null; then
      ready=$((ready + 1))
    fi
  done
  [ "$ready" -eq 0 ] || printf '%s reap-ready worktrees — run wt-reap\n' "$ready"
}

# A landing is the moment spent lanes become collectable, and nothing else ever
# triggers the sweep — a printed hint accumulated 13 stale trees. Best-effort by
# construction: the reap can never change safe-push's exit status.
auto_reap() {
  local container wt_reap self_dir has_lanes=0 wt
  [ "$(basename "$repo_root")" = main ] || return 0
  container=$(dirname "$repo_root")
  # worktrees/ only: pins/ is externally consumed and is never swept.
  for wt in "$container"/worktrees/*; do
    [ -e "$wt/.git" ] || continue
    has_lanes=1
    break
  done
  [ "$has_lanes" -eq 1 ] || return 0

  if [ "${NORTH_NO_AUTOREAP:-0}" = 1 ]; then
    report_reap_ready
    return 0
  fi

  # The just-landed repo copy beside this script wins over a stale deployed one.
  self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) || self_dir=""
  if [ -n "$self_dir" ] && [ -x "$self_dir/wt-reap" ]; then
    wt_reap="$self_dir/wt-reap"
  else
    wt_reap=$(command -v wt-reap 2>/dev/null) || wt_reap=""
  fi
  if [ -z "$wt_reap" ]; then
    report_reap_ready
    return 0
  fi

  (cd "$container" && "$wt_reap" 2>&1) | sed 's/^/auto-reap: /' || true
  return 0
}

default_branch() {
  local default
  default=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || default=""
  default=${default#refs/remotes/origin/}
  printf '%s\n' "${default:-main}"
}

# A fleet session landing on the default branch is read back from this column.
trunk_landing() {
  [ "$1" != "$(default_branch)" ] || printf '%s' "$2"
}

# Workers land and walk away, so lanes piled up by the hundred. Landing is the
# one moment a lane is provably spent; best-effort, never changes exit status.
cleanup_landed_lane() {
  local container main_checkout tracking remote_oid lane_ref dirty occupants
  [ "$to_seen" -eq 1 ] && [ "$to" = "$(default_branch)" ] || return 0
  [ "$branch" != "$to" ] || return 0
  [ "$(basename "$(dirname "$repo_root")")" = worktrees ] || return 0
  container=$(dirname "$(dirname "$repo_root")")
  main_checkout="$container/main"
  [ -e "$main_checkout/.git" ] || return 0
  tracking="refs/remotes/origin/$to"
  git fetch -q "$origin_url" "+${destination_ref}:${tracking}" 2>/dev/null || return 0
  git merge-base --is-ancestor HEAD "$tracking" 2>/dev/null || return 0

  lane_ref="refs/heads/$branch"
  remote_oid=$(git ls-remote "$origin_url" "$lane_ref" 2>/dev/null | awk 'NR==1 {print $1}') || remote_oid=""
  if [ -n "$remote_oid" ] \
      && git fetch -q "$origin_url" "+${lane_ref}:refs/remotes/origin/$branch" 2>/dev/null \
      && ! git cherry "$tracking" "refs/remotes/origin/$branch" 2>/dev/null | grep -q '^+'; then
    echo "safe-push: origin $branch is fully on $to — deleting it"
    if SAFE_PUSH_ACTIVE=1 git push -q --no-follow-tags --force-with-lease="${lane_ref}:${remote_oid}" \
        "$origin_url" ":${lane_ref}"; then
      git update-ref -d "refs/remotes/origin/$branch" 2>/dev/null || true
    else
      echo "safe-push: could not delete origin $branch; left in place" >&2
    fi
  fi

  if [ "$keep_lane" -eq 1 ]; then
    echo "safe-push: --keep-lane: keeping $repo_root and branch $branch"
    return 0
  fi
  dirty=$(git status --porcelain 2>/dev/null) || return 0
  if [ -n "$dirty" ]; then
    printf 'safe-push: lane %s has uncommitted or untracked files, so it was kept; once they are saved: git -C %s worktree remove %s && git -C %s branch -d %s\n' \
      "$repo_root" "$main_checkout" "$repo_root" "$main_checkout" "$branch"
    return 0
  fi
  # branch -d judges merged-ness against the upstream, so a stale local main
  # in the main checkout cannot block deleting a branch origin already holds.
  git branch -q --set-upstream-to="origin/$to" "$branch" >/dev/null 2>&1 || true
  cd "$container" || return 0
  occupants=$(lane_occupants "$repo_root")
  if [ -n "$occupants" ]; then
    printf 'safe-push: lane landed — your shell is in %s, so it and branch %s are removed once it leaves\n' "$repo_root" "$branch"
    printf 'safe-push: cd %s when finished in the lane\n' "$main_checkout"
    # shellcheck disable=SC2086
    setsid -f "$BASH" -c "$(declare -f lane_occupied remove_landed_lane remove_landed_lane_when_vacant); remove_landed_lane_when_vacant \"\$@\"" \
      safe-push-lane-reaper "$main_checkout" "$repo_root" "$branch" $occupants </dev/null >/dev/null 2>&1 || true
    return 0
  fi
  printf 'safe-push: lane landed — removing worktree %s and branch %s\n' "$repo_root" "$branch"
  remove_landed_lane "$main_checkout" "$repo_root" "$branch" || return 0
  printf 'safe-push: your working directory %s no longer exists; cd %s\n' "$repo_root" "$main_checkout"
}

# A caller shell runs pwd after safe-push returns; deleting its cwd turns success into exit 1.
lane_occupants() {
  local pid=$PPID
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    ! lane_occupied "$1" "$pid" || printf '%s ' "$pid"
    pid=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null) || return 0
  done
}

lane_occupied() {
  local cwd
  cwd=$(readlink "/proc/$2/cwd" 2>/dev/null) || return 1
  [ "$cwd" = "$1" ] || [ "${cwd#"$1"/}" != "$cwd" ]
}

remove_landed_lane() {
  if ! git -C "$1" worktree remove "$2"; then
    echo "safe-push: could not remove $2; left in place" >&2
    return 1
  fi
  git -C "$1" branch -q -d "$3" \
    || echo "safe-push: could not delete branch $3; left in place" >&2
}

remove_landed_lane_when_vacant() {
  local main_checkout=$1 lane=$2 branch=$3 pid waited=0
  shift 3
  for pid in "$@"; do
    while lane_occupied "$lane" "$pid"; do
      [ "$waited" -lt 21600 ] || return 0
      sleep 1
      waited=$((waited + 1))
    done
  done
  remove_landed_lane "$main_checkout" "$lane" "$branch"
}

release_follows() {
  [ "$to_seen" -eq 1 ] && [ "$to" = "$(default_branch)" ] || return 0
  local north_runtime="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
  [ -x "$north_runtime" ] || return 0
  "$north_runtime" follows-release --repo-dir "$repo_root" 2>&1 | sed 's/^/safe-push: /' || true
}

capture_destination_state() {
  destination_branch=${to:-$branch}
  destination_ref="refs/heads/$destination_branch"
  destination_snapshot=$(remote_destination_snapshot) || exit 1
  destination_oid=""
  if [[ "$destination_snapshot" == object:* ]]; then
    destination_oid=${destination_snapshot#object:}
    git cat-file -e "${destination_oid}^{commit}" 2>/dev/null \
      || { echo "safe-push: origin $destination_ref is not available locally at $destination_oid — fetch it first" >&2; exit 1; }
    git merge-base --is-ancestor "$destination_oid" "$head_oid" 2>/dev/null \
      || { echo "safe-push: non-fast-forward $head_oid -> $destination_ref (origin at $destination_oid) — refusing" >&2; exit 1; }
    scan_range="${destination_oid}..${head_oid}"
  else
    # A new branch publishes only what origin's default branch lacks; scanning
    # the whole reachable history costs minutes and cores on every scratch push.
    absent_base=$(git ls-remote "$origin_url" HEAD 2>/dev/null | awk 'NR==1 {print $1}')
    if [ -n "$absent_base" ] && git cat-file -e "${absent_base}^{commit}" 2>/dev/null; then
      scan_range="${absent_base}..${head_oid}"
    else
      absent_base=""
      scan_range="$head_oid"
    fi
  fi
}

revalidate_repository_state() {
  local current_root current_git_dir current_origin_url current_branch_ref
  local current_head_oid current_destination_snapshot current_range

  current_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || state_changed 'repository unavailable'
  [ "$current_root" = "$repo_root" ] || state_changed 'repository root/worktree changed'

  current_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
    || state_changed 'Git worktree unavailable'
  [ "$current_git_dir" = "$git_dir" ] || state_changed 'Git worktree changed'

  current_origin_url=$(git remote get-url --push origin 2>/dev/null) \
    || state_changed 'origin push URL unavailable'
  [ "$current_origin_url" = "$origin_url" ] || state_changed 'origin push URL changed'

  current_branch_ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) \
    || state_changed 'HEAD became detached'
  [ "$current_branch_ref" = "$branch_ref" ] || state_changed 'current branch changed'

  current_head_oid=$(git rev-parse --verify "${current_branch_ref}^{commit}" 2>/dev/null) \
    || state_changed 'HEAD commit unavailable'
  [ "$current_head_oid" = "$head_oid" ] || state_changed 'HEAD commit changed'

  [ "${1:-branch}" = branch ] || return 0

  current_destination_snapshot=$(remote_destination_snapshot) \
    || state_changed 'origin destination became unavailable, symbolic, malformed, or ambiguous'
  [ "$current_destination_snapshot" = "$destination_snapshot" ] \
    || state_changed "origin destination $destination_ref changed"
  if [[ "$current_destination_snapshot" == object:* ]]; then
    current_range="${current_destination_snapshot#object:}..${current_head_oid}"
  else
    current_range="${absent_base:+${absent_base}..}${current_head_oid}"
  fi
  [ "$current_range" = "$scan_range" ] || state_changed 'outgoing range changed'
}

# --- one-branch-main doctrine: no silent default publish of a non-main branch -----
# safe-push's own default (no --to) publishes HEAD under its CURRENT branch name —
# exactly how feature-branch litter accumulates on origin from native sessions.
# Refuse that default the moment the current branch isn't the repo's default
# branch; an explicit --to (even to a non-main destination) is the deliberate
# escape hatch and is left alone. Tag pushes are a different ref namespace and
# are untouched by this guard.
enforce_one_branch_main() {
  local ref current default
  ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) || return 0
  case "$ref" in
    refs/heads/*) current=${ref#refs/heads/} ;;
    *) return 0 ;;
  esac
  default=$(default_branch)
  plan_push source "$current" "$default"
}

if [ "$tag_seen" -eq 0 ] && [ "$to_seen" -eq 0 ]; then enforce_one_branch_main; fi

# --- tag mode: scan the tag object and commit history absent from origin -----------
safe_push_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
if [ -n "$tag" ]; then
  capture_repository_state
  tag_ref="refs/tags/$tag"
  tag_oid=$(git rev-parse -q --verify "$tag_ref" 2>/dev/null) \
    || { echo "safe-push: no such tag '$tag'"; exit 1; }
  [ "$(git cat-file -t "$tag_oid" 2>/dev/null)" = tag ] \
    || { echo "safe-push: tag '$tag' is not annotated — refusing"; exit 1; }
  target=$(git rev-list -n1 "$tag_oid")
  command -v gitleaks >/dev/null 2>&1 || { echo "safe-push: gitleaks not on PATH — refusing to push without a secret scan"; exit 1; }
  tmpd=$(mktemp -d)
  origin_namespace="refs/safe-push-origin/$$-$RANDOM"
  cleanup_tag_scan() {
    local ref
    while IFS= read -r ref; do git update-ref -d "$ref" || true; done \
      < <(git for-each-ref --format='%(refname)' "$origin_namespace/")
    rm -rf "${tmpd:?}"
  }
  trap cleanup_tag_scan EXIT

  git fetch -q --no-tags --no-write-fetch-head "$origin_url" \
    "+refs/*:${origin_namespace}/*"
  fetched_origin_snapshot=$(
    git for-each-ref --format='%(objectname) %(refname)' "$origin_namespace/" |
      while read -r oid ref; do
        printf '%s\trefs/%s\n' "$oid" "${ref#"$origin_namespace/"}"
      done | LC_ALL=C sort
  )
  origin_snapshot=$(git ls-remote --refs "$origin_url" | LC_ALL=C sort)
  [ "$origin_snapshot" = "$fetched_origin_snapshot" ] \
    || state_changed 'origin refs changed while capturing tag scan base'

  tag_scan_revs=("$target")
  while IFS= read -r ref; do
    if oid=$(git rev-parse -q --verify "${ref}^{commit}" 2>/dev/null); then
      tag_scan_revs+=("^$oid")
    fi
  done < <(git for-each-ref --format='%(refname)' "$origin_namespace/")
  tag_scan_range="${tag_scan_revs[*]}"
  tag_base=$(git rev-list --boundary "${tag_scan_revs[@]}" | sed -n 's/^-//p')
  tag_base=${tag_base%%$'\n'*}
  if [ "$(git rev-list --count "${tag_scan_revs[@]}")" -eq 0 ]; then tag_base="$target"; fi
  run_language_gate "$tag_base" "$target" || exit $?
  check_instruction_limits "$target"
  scan_range_for_native=("${tag_scan_revs[@]}")
  native_ref_scan "$tag" "$(git cat-file -p "$tag_oid")" || exit 1
  if [ "$(git rev-list --count "${tag_scan_revs[@]}")" -gt 0 ]; then
    gitleaks detect --no-banner --redact --log-opts="$tag_scan_range" \
      || { echo "safe-push: ✗ SECRET DETECTED in tag commit history — fix it; NOT pushed."; exit 1; }
    commit_email_scan "${tag_scan_revs[@]}" || exit 1
  fi
  denylist_scan "$tag_base" "$target" "$tag" || exit 1

  git cat-file -p "$tag_oid" > "$tmpd/tag-object.txt"
  # gitleaks CLI drift: 8.19+ uses `dir`, older uses `detect --no-git --source`
  gitleaks dir "$tmpd" --no-banner --redact >/dev/null 2>&1 \
    || gitleaks detect --no-git --source "$tmpd" --no-banner --redact >/dev/null 2>&1 \
    || { echo "safe-push: ✗ SECRET DETECTED in tag annotation — fix it; NOT pushed."; exit 1; }
  revalidate_repository_state identity
  current_tag_oid=$(git rev-parse -q --verify "$tag_ref" 2>/dev/null) \
    || state_changed 'tag disappeared'
  [ "$current_tag_oid" = "$tag_oid" ] || state_changed 'tag object changed'
  current_target=$(git rev-list -n1 "$current_tag_oid")
  [ "$current_target" = "$target" ] || state_changed 'tag target changed'
  current_origin_snapshot=$(git ls-remote --refs "$origin_url" | LC_ALL=C sort)
  [ "$current_origin_snapshot" = "$origin_snapshot" ] \
    || state_changed 'origin refs changed'
  if [ "$dry" = 1 ]; then echo "safe-push: ✓ clean (--dry-run) — would push tag $tag -> origin"; exit 0; fi
  echo "safe-push: ✓ clean — pushing tag $tag -> origin"
  SAFE_PUSH_ACTIVE=1 git push --no-follow-tags "$origin_url" "${tag_oid}:${tag_ref}"
  safe_push_published_head="$target"; safe_push_landed_sha="$target"
  exit 0
fi

# --- --to landings: serialize per origin, rebase onto the fresh destination -------
# ~20 workers land on one busy main, so an unserialized landing loses the race to
# non-fast-forward. A repo's pre-push hook can take minutes, so it runs before
# the lock; holders of the lock only fetch, rebase, scan and push.
push_lock_fd=""
push_lock_taken=""
push_ticket=""
push_ticket_info=""
red_fix=""
requeued=0
finish_push() {
  [ -z "$push_ticket" ] || rm -f -- "$push_ticket" "$push_ticket.result"
}

live_safe_push() {
  { tr '\0' ' ' <"/proc/$1/cmdline"; } 2>/dev/null | grep -q safe-push
}

drop_lock_fd() {
  [ "$BASHPID" != "$$" ] && [ -n "$push_lock_fd" ] || return 0
  exec {push_lock_fd}>&-
}

red_fix_issue() {
  local named issue
  [ -n "$1" ] || return 0
  if git log --format=%B "$1..HEAD" | grep -qE '^Main-red:[[:space:]]+[^[:space:]]'; then printf 'marker\n'; return 0; fi
  named=$(git log --format=%s "$1..HEAD" | grep -oE '#[0-9]+') || return 0
  issue=$(timeout 10 gh issue list --state open --search "\"$to is red\" in:title" --json number,title \
      --jq '.[] | "\(.number)\t\(.title)"' 2>/dev/null \
    | awk -F'\t' -v title="$to is red" '$2 == title { print $1; exit }') || return 0
  if [ -n "$issue" ] && grep -qxF "#$issue" <<<"$named"; then printf '%s\n' "$issue"; fi
}

red_fix_waiting() {
  local t name
  [ -z "$red_fix" ] || return 1
  for t in "${push_ticket%/*}"/0*; do
    name=${t##*/}
    [[ "$name" =~ ^[0-9]+-([0-9]+)$ ]] && [ "$t" != "$push_ticket" ] && [ ! -e "$t.result" ] || continue
    live_safe_push "${BASH_REMATCH[1]}" && return 0
  done
  return 1
}

# Prints the oldest ticket in queue $1 whose safe-push is still running.
first_ticket() {
  local t name
  for t in "$1"/*; do
    name=${t##*/}
    [[ "$name" =~ ^[0-9]+-([0-9]+)$ ]] || continue
    if [ "$1/$name" = "$push_ticket" ] || live_safe_push "${BASH_REMATCH[1]}"; then
      printf '%s\n' "$1/$name"
      return 0
    fi
  done
}

acquire_push_lock() {
  local url="$1" limit="${2:-600}" dir key file holder waited=0 queue
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
  mkdir -p "$dir"
  key=$(printf '%s' "$url" | sha256sum | cut -c1-16)
  file="$dir/$key.lock"
  if [ "${SAFE_PUSH_LOCK_HELD:-}" = "$key" ]; then
    printf 'safe-push: the landing lock on %s is held by the safe-push whose checks started this one\n' "$url" >&2
    return 0
  fi
  queue="$dir/$key.queue"
  mkdir -p "$queue"
  if [ -z "$push_ticket" ]; then
    # A leading 0 sorts a red-fix lane's ticket first in every safe-push's glob, older versions included.
    push_ticket="$queue/${red_fix:+0}${EPOCHREALTIME/./}-$self_pid"
    printf '%s' "$push_ticket_info" >"$push_ticket"
  fi
  exec {push_lock_fd}>>"$file"
  while take_train_result; [ "$(first_ticket "$queue")" != "$push_ticket" ] || ! flock -n "$push_lock_fd"; do
    if [ $((waited % 300)) -eq 0 ]; then
      holder=$(cat "$file" 2>/dev/null) || holder=""
      printf 'safe-push: waiting for the landing lock on %s in arrival order, held by %s (%ss/%ss)\n' \
        "$url" "${holder:-unknown}" "$((waited / 10))" "$limit" >&2
    fi
    if [ "$waited" -ge $((limit * 10)) ]; then
      printf 'safe-push: gave up after %ss waiting for the landing lock on %s, held by %s; NOT pushed.\n' \
        "$limit" "$url" "${holder:-unknown}" >&2
      exit 1
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  take_train_result
  printf 'pid %s in %s\n' "$self_pid" "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" >"$file"
  export SAFE_PUSH_LOCK_HELD="$key"
  push_lock_taken=$EPOCHREALTIME
}

unlock_push_lock() {
  flock -u "$push_lock_fd" || true
  exec {push_lock_fd}>&-
  push_lock_fd=""
  unset SAFE_PUSH_LOCK_HELD
}

release_push_lock() {
  [ -n "$push_lock_fd" ] || return 0
  unlock_push_lock
  rm -f -- "$push_ticket"
  push_ticket=""
  awk -v a="$push_lock_taken" -v b="$EPOCHREALTIME" \
    'BEGIN { printf "safe-push: held the landing lock for %.1f s\n", b - a }'
}

requeue_behind_red_fix() {
  printf 'safe-push: a lane that fixes red %s is queued; this lane waits behind it\n' "$to"
  unlock_push_lock
  requeued=1
}

# --- landing train: the exact-landing lock holder lands the lanes queued behind it
# Waiting lanes poll <ticket>.result: "landed <main-oid> <lane-oid>",
# "conflict <files> <lane-oid>" or "failed <log-or-url> <lane-oid>".
take_train_result() {
  local result verdict detail lane_oid
  [ -n "$push_ticket" ] || return 0
  result="$push_ticket.result"
  [ -s "$result" ] || return 0
  read -r verdict detail lane_oid <"$result"
  rm -f -- "$result" "$push_ticket"
  push_ticket=""
  if [ -n "$push_lock_fd" ]; then
    flock -u "$push_lock_fd" || true
    exec {push_lock_fd}>&-
    push_lock_fd=""
  fi
  case "$verdict" in
    landed)
      printf 'safe-push: ✓ landed in a landing train: origin %s is at %s\n' "$to" "$detail"
      capture_repository_state
      destination_ref="refs/heads/$to"
      if [ "$head_oid" != "$lane_oid" ]; then
        printf 'safe-push: this lane moved from %s while it waited; only that commit landed, so the lane was kept\n' "$lane_oid" >&2
        exit 1
      fi
      fetch_destination >/dev/null
      release_follows
      safe_push_published_head="$detail"; safe_push_landed_sha="$detail"
      if git reset -q --keep "$detail"; then cleanup_landed_lane || true; fi
      auto_reap || true
      exit 0
      ;;
    conflict)
      printf 'safe-push: ✗ this lane conflicts with the lanes ahead of it in the landing train in: %s\nsafe-push: rebase onto origin/%s and retry. NOT pushed.\n' \
        "${detail//,/ }" "$to" >&2
      ;;
    *)
      printf 'safe-push: ✗ the pre-push checks failed on this lane in the landing train (%s); NOT pushed.\n' "$detail" >&2
      ;;
  esac
  exit 1
}

without() {
  local drop="$1" x
  shift
  for x in "$@"; do [ "$x" = "$drop" ] || printf '%s\n' "$x"; done
}

collect_train() {
  local t name branch_name
  train_tickets=()
  if red_fix_waiting; then
    requeue_behind_red_fix
    return 0
  fi
  for t in "${push_ticket%/*}"/*; do
    name=${t##*/}
    [[ "$name" =~ ^[0-9]+-([0-9]+)$ ]] || continue
    [ "$t" != "$push_ticket" ] && [ -s "$t" ] && [ ! -e "$t.result" ] || continue
    live_safe_push "${BASH_REMATCH[1]}" || continue
    IFS=$'\t' read -r _ branch_name _ <"$t" || true
    [[ "$branch_name" != safe-push-train-* ]] || continue
    train_tickets+=("$t")
  done
}

# A candidate or rebase can move a Bun lockfile (a vendored pin bump) under a
# worktree whose node_modules were installed for another commit; the checks
# would then judge the new code against old dependencies. Reinstall each
# installed Bun project whose package.json or bun.lock no longer matches. In
# smashcraft and wisp a fresh worktree's top-level projects get their first
# install too, since their pre-push checks import from node_modules.
sync_dependencies() {
  local lock dir want stamp top first_install=0
  top=$(git rev-parse --show-toplevel)
  case "$(basename "$(git remote get-url origin 2>/dev/null)" .git)" in
    smashcraft|wisp) first_install=1 ;;
  esac
  while IFS= read -r lock; do
    dir="$top/$(dirname "$lock")"
    if [ ! -d "$dir/node_modules" ]; then
      [ "$first_install" = 1 ] && [[ "$lock" != */*/* ]] || continue
      echo "safe-push: no node_modules — bun install --frozen-lockfile in $dir"
    fi
    want=$(cat "$dir/bun.lock" "$dir/package.json" 2>/dev/null | sha256sum | cut -c1-16)
    stamp="$dir/node_modules/.safe-push-deps"
    [ "$(cat "$stamp" 2>/dev/null)" != "$want" ] || continue
    echo "safe-push: $lock changed — bun install --frozen-lockfile in $dir"
    (drop_lock_fd; cd "$dir" && bun install --frozen-lockfile) || return 1
    printf '%s\n' "$want" >"$stamp"
  done < <(git ls-files -- 'bun.lock' '*/bun.lock')
}

# Prints "ok" or the farm URL (else the log path) of the failed check on the
# train branch's HEAD; returns nonzero on failure.
check_candidate() {
  local hook="$1" base="$2" log="$3" head="$4" url
  drop_lock_fd
  : >"$log"
  if [ "$(git rev-parse HEAD)" != "$head" ]; then
    printf 'safe-push: train HEAD differs from captured candidate %s; NOT pushed.\n' "$head" | tee -a "$log" >&2
    printf '%s\n' "$log"
    return 1
  fi
  if run_language_gate "$base" "$head" 2>&1 | tee -a "$log" >&2 \
      && sync_dependencies >>"$log" 2>&1 \
      && check_instruction_limits "$head" >>"$log" 2>&1 \
      && scan_range_for_native=("$base..$head") && native_ref_scan >>"$log" 2>&1 \
      && gitleaks detect --no-banner --redact --log-opts="$base..$head" >>"$log" 2>&1 \
      && denylist_scan "$base" "$head" "$to" >>"$log" 2>&1 \
      && commit_email_scan "$base..$head" >>"$log" 2>&1 \
      && (cd "$repo_root" && printf 'refs/heads/%s %s refs/heads/%s %s\n' "$train_branch" "$head" "$to" "$base" \
        | "$hook" origin "$lock_url") 2>&1 | tee -a "$log" >&2; then
    return 0
  fi
  url=$(grep -oE 'https?://[^[:space:]()]+/actions/runs/[0-9]+' "$log" | tail -n1) || url=""
  printf '%s\n' "${url:-$log}"
  return 1
}

run_train() {
  local hook="$1" own_branch own_root own_oid base cand verdict detail i n half cherry
  local -a roots=() branches=() oids=() tickets=() sessions=() pending=() group=() rest=()
  local -a results=()
  own_root=$(git rev-parse --show-toplevel)
  own_branch=$(git symbolic-ref --quiet --short HEAD)
  own_oid=$(git rev-parse HEAD)
  roots+=("$own_root"); branches+=("$own_branch"); oids+=("$own_oid"); tickets+=(""); sessions+=("${NORTH_FLEET_SESSION:-}")
  for i in "${train_tickets[@]}"; do
    local root branch_name oid session
    IFS=$'\t' read -r root branch_name oid session <"$i" || true
    tickets+=("$i"); roots+=("$root"); branches+=("$branch_name"); oids+=("$oid"); sessions+=("$session")
  done
  n=${#oids[@]}
  base=$(fetch_destination)
  [ -n "$base" ] || return 0
  printf 'safe-push: landing train of %s lanes onto origin %s@%s\n' "$n" "$to" "$base"
  capture_repository_state
  resolve_origin_visibility "$origin_url"
  destination_ref="refs/heads/$to"
  train_branch="safe-push-train-$self_pid"
  local log="${XDG_STATE_HOME:-$HOME/.local/state}/safe-push/train-$self_pid.log"

  train_verdict() {
    results[$1]="$2 $3 ${oids[$1]}"
    printf 'safe-push: train lane %s (%s): %s %s\n' "${branches[$1]}" "${oids[$1]}" "$2" "$3"
    [ -z "${tickets[$1]}" ] || printf '%s\n' "${results[$1]}" >"${tickets[$1]}.result"
  }

  for ((i = 0; i < n; i++)); do
    results+=("")
    if ! git cat-file -e "${oids[i]}^{commit}" 2>/dev/null; then
      git fetch -q --no-tags "${roots[i]}" "refs/heads/${branches[i]}" 2>/dev/null || true
    fi
    if git cat-file -e "${oids[i]}^{commit}" 2>/dev/null \
        && cherry=$(git cherry "$base" "${oids[i]}" 2>/dev/null) && ! grep -q '^+' <<<"$cherry"; then
      echo "safe-push: train lane ${branches[i]} is already on origin $to"
      train_verdict "$i" landed "$base"
    else
      pending+=("$i")
    fi
  done

  while [ "${#pending[@]}" -gt 0 ]; do
    group=("${pending[@]}")
    while :; do
      if red_fix_waiting; then break 2; fi
      base=$(fetch_destination)
      git switch -q -C "$train_branch" "$base"
      local built=1
      for i in "${group[@]}"; do
        if ! git cat-file -e "${oids[i]}^{commit}" 2>/dev/null; then
          train_verdict "$i" conflict unreadable
        elif ! GIT_EDITOR=true git cherry-pick "$base..${oids[i]}" >/dev/null 2>&1; then
          detail=$(git diff --name-only --diff-filter=U 2>/dev/null | paste -sd, -)
          git cherry-pick --abort >/dev/null 2>&1 || git reset -q --hard HEAD
          train_verdict "$i" conflict "${detail:-cherry-pick}"
        else
          continue
        fi
        built=0
        pending=($(without "$i" "${pending[@]}"))
        group=($(without "$i" "${group[@]}"))
        break
      done
      [ "$built" -eq 1 ] || { [ "${#group[@]}" -gt 0 ] && continue || break; }
      cand=$(git rev-parse HEAD)
      printf 'safe-push: train candidate %s carries %s lanes; running the pre-push checks on it\n' "$cand" "${#group[@]}"
      if detail=$(check_candidate "$hook" "$base" "$log" "$cand"); then
        local pushed_at=$EPOCHSECONDS
        if [ "$(remote_destination_snapshot)" = "object:$base" ] \
            && SAFE_PUSH_ACTIVE=1 git push -q --no-verify --no-follow-tags --force-with-lease="$destination_ref:$base" \
              "$origin_url" "$cand:$destination_ref"; then
          for i in "${group[@]}"; do
            record_push "$pushed_at" "${branches[i]}" "${oids[i]}" "$(trunk_landing "$to" "$cand")" "${sessions[i]}"
            train_verdict "$i" landed "$cand"
          done
        else
          for i in "${group[@]}"; do train_verdict "$i" failed "origin-$to-moved"; done
        fi
        rest=()
        for i in "${pending[@]}"; do printf '%s\n' "${group[@]}" | grep -qx "$i" || rest+=("$i"); done
        pending=("${rest[@]}")
        break
      fi
      if [ "${#group[@]}" -eq 1 ]; then
        train_verdict "${group[0]}" failed "$detail"
        pending=($(without "${group[0]}" "${pending[@]}"))
        break
      fi
      half=$(( (${#group[@]} + 1) / 2 ))
      group=("${group[@]:0:half}")
      echo "safe-push: train candidate failed; re-running the checks on its first $half lanes"
    done
  done

  git switch -q "$own_branch"
  git branch -q -D "$train_branch" 2>/dev/null || true
  [ "${#pending[@]}" -eq 0 ] \
    || printf 'safe-push: handing %s undecided lanes of this train back to the queue\n' "${#pending[@]}"
  if [ -z "${results[0]}" ]; then
    requeue_behind_red_fix
    return 0
  fi
  read -r verdict detail _ <<<"${results[0]}"
  release_push_lock
  if [ "$verdict" = landed ]; then
    git reset -q --keep "$detail"
    safe_push_published_head="$detail"; safe_push_landed_sha="$detail"
    capture_repository_state
    destination_ref="refs/heads/$to"
    release_follows
    safe_push_published_head="$detail"; safe_push_landed_sha="$detail"
    cleanup_landed_lane || true
    auto_reap || true
    exit 0
  fi
  printf 'safe-push: ✗ this lane did not land in its landing train (%s %s); NOT pushed.\n' "$verdict" "$detail" >&2
  [ "$verdict" = failed ] || echo "safe-push: rebase onto origin/$to and retry." >&2
  exit 1
}

rebase_in_progress() {
  local d
  for d in rebase-merge rebase-apply; do
    [ -d "$(git rev-parse --git-path "$d")" ] && return 0
  done
  return 1
}

# Fetches origin's destination and prints its tip; nothing when it is absent
# (a real fetch failure is caught by the destination snapshot later).
fetch_destination() {
  local remote_ref="refs/remotes/origin/$to"
  git fetch -q origin "+refs/heads/$to:$remote_ref" 2>/dev/null || return 0
  git rev-parse -q --verify "${remote_ref}^{commit}" 2>/dev/null || true
}

rebase_onto_destination() {
  local upstream="$1" conflicts log
  [ -n "$upstream" ] || return 0
  git merge-base --is-ancestor "$upstream" HEAD 2>/dev/null && return 0
  # Unrelated history is left to the non-fast-forward refusal.
  git merge-base HEAD "$upstream" >/dev/null 2>&1 || return 0
  echo "safe-push: origin $to moved to $upstream — rebasing onto it"
  if log=$(GIT_EDITOR=true git rebase --no-autostash "$upstream" 2>&1); then
    return 0
  fi
  conflicts=$(git diff --name-only --diff-filter=U 2>/dev/null) || conflicts=""
  if rebase_in_progress; then git rebase --abort >/dev/null 2>&1 || true; fi
  if [ -n "$conflicts" ]; then
    printf 'safe-push: ✗ rebase onto origin %s conflicts in:\n' "$to" >&2
    sed 's/^/  /' <<<"$conflicts" >&2
    printf 'safe-push: rebase aborted, worktree unchanged; resolve against origin/%s and retry. NOT pushed.\n' "$to" >&2
  else
    printf 'safe-push: ✗ rebase onto origin %s failed; NOT pushed.\n%s\n' "$to" "$log" >&2
  fi
  exit 1
}

sync_with_destination() {
  rebase_onto_destination "$(fetch_destination)"
}

# The pre-push hook git would run, resolved as git does (core.hooksPath
# included); nothing when the repo has none.
pre_push_hook() {
  local top path
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  path=$(cd "$top" && git rev-parse --git-path hooks/pre-push 2>/dev/null) || return 0
  case "$path" in /*) ;; *) path="$top/$path" ;; esac
  if [ -f "$path" ] && [ -x "$path" ]; then printf '%s\n' "$path"; fi
  return 0
}

# Runs the hook as git would for pushing HEAD to origin's destination at $2.
run_pre_push_checks() {
  local hook="$1" base="$2" head local_ref top zero
  head=$(git rev-parse HEAD)
  run_language_gate "$base" "$head" || exit $?
  local_ref=$(git symbolic-ref --quiet HEAD)
  top=$(git rev-parse --show-toplevel)
  zero=$(printf '%0*d' "${#head}" 0)
  if [ -n "$push_lock_fd" ]; then
    echo "safe-push: running the pre-push checks on $head under the landing lock"
  else
    echo "safe-push: running the pre-push checks on $head before taking the landing lock"
  fi
  sync_dependencies || exit 1
  (drop_lock_fd; cd "$top" && printf '%s %s refs/heads/%s %s\n' "$local_ref" "$head" "$to" "${base:-$zero}" \
      | "$hook" origin "$lock_url") &
  safe_push_child=$!
  if ! wait "$safe_push_child"; then
    echo "safe-push: ✗ the pre-push checks failed; NOT pushed." >&2
    exit 1
  fi
  safe_push_child=""
}

# Whether origin's commits base..upstream change any file that base..head changes.
touches_same_files() {
  LC_ALL=C comm -12 \
    <(git diff --no-renames --name-only "$1" "$3" | LC_ALL=C sort -u) \
    <(git diff --no-renames --name-only "$1" "$2" | LC_ALL=C sort -u) | grep -q .
}

touches_workflows() {
  git diff --name-only "$1" "$2" -- .github/workflows | grep -q .
}

# hook_verified=1: the hook passed on HEAD's change against the destination it
# will land on (or one whose new commits touch none of its files, unless the
# repository's committed .safe-push sets landing.exact and the lane changes no
# workflow), so the push skips it.
hook_verified=0
# Read from the destination too: its new commits may be what introduce the setting.
exact_landing() {
  local ref
  for ref in HEAD "$1"; do
    [ "$(git config --blob "$ref:.safe-push" --type=bool --get landing.exact 2>/dev/null)" = true ] && return 0
  done
  return 1
}
# A repository whose main's committed .safe-push sets landing.queue = autoland
# lands every change through its Autoland workflow's one batched queue: the lane
# is checked and pushed to claude/land-<lane>-<sha> and the `autoland` commit
# status on that SHA is the verdict. Workflow changes can't land that way.
autoland_repo() {
  [ -n "$1" ] || return 1
  [ "$(git config --blob "$1:.safe-push" --get landing.queue 2>/dev/null)" = autoland ] \
    || git cat-file -e "$1:.github/workflows/autoland.yml" 2>/dev/null
}
autoland_queue() {
  autoland_repo "$1" && ! git diff --name-only "$1...HEAD" -- .github/workflows | grep -q .
}
# A train fixes its base when its test starts, so a workflow lane waits for no train in flight, before it queues for the lock.
autoland_gap() {
  local waited=0 limit="${SAFE_PUSH_AUTOLAND_GAP_SECONDS:-1800}" poll="${SAFE_PUSH_AUTOLAND_POLL_SECONDS:-30}" trains
  [ "$direct" = 0 ] && [ "$to" = "$(default_branch)" ] && autoland_repo "refs/remotes/origin/$to" || return 0
  while :; do
    trains=$(gh run list --workflow autoland.yml --status in_progress --limit 50 --json displayTitle \
      --jq '[.[] | select(.displayTitle | startswith("Autoland plan") | not)] | length' 2>/dev/null) || trains=unknown
    [ "$trains" != 0 ] || return 0
    if [ "$waited" -ge "$limit" ]; then
      printf 'safe-push: Autoland trains stayed in flight for %sm; landing this workflow lane over them; a train in flight retests once\n' "$((limit / 60))"
      return 0
    fi
    [ "$waited" -gt 0 ] || printf 'safe-push: %s Autoland train runs in flight; waiting for none before pushing %s (up to %sm)\n' "$trains" "$to" "$((limit / 60))"
    sleep "$poll"
    waited=$((waited + poll))
  done
}

land_through_autoland() {
  local lane sha queue_branch autoland_reply line state description url wait_status=0 landed limit="${SAFE_PUSH_AUTOLAND_WAIT_SECONDS:-10800}"
  rebase_onto_destination "$1"
  lane=$(git symbolic-ref --quiet --short HEAD)
  sha=$(git rev-parse HEAD)
  queue_branch="claude/land-$(printf '%s' "$lane" | tr -c 'A-Za-z0-9._-' '-')-${sha:0:12}"
  echo "safe-push: $to lands through Autoland's one queue — checking and pushing $sha as $queue_branch"
  NORTH_NO_AUTOREAP=1 "$(readlink -f "${BASH_SOURCE[0]}")" --to "$queue_branch" || exit 1
  autoland_reply=$(mktemp)
  "${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}" autoland-wait \
    --sha "$sha" --branch "$queue_branch" --destination "$to" \
    --timeout-seconds "$limit" --poll-seconds "${SAFE_PUSH_AUTOLAND_POLL_SECONDS:-10}" >"$autoland_reply" 2>/dev/null &
  safe_push_child=$!
  wait "$safe_push_child" || wait_status=$?
  safe_push_child=""
  line=$(<"$autoland_reply")
  rm -f -- "$autoland_reply"
  IFS=$'\t' read -r state description url <<<"$line"
  if [ "$state" = timeout ] || [ "$wait_status" -eq 2 ]; then
    safe_push_timed_out=1
    safe_push_timeout_minutes=$(((limit + 59) / 60))
    safe_push_run_url="$url"
    exit 2
  fi
  if [ "$state" = error ] && [ "$description" = 'local refresh required: Classic effect record' ]; then
    safe_push_refusal="Autoland returned this lane for local Classic record refresh: $url"
    printf 'safe-push: Autoland returned this lane for local Classic record refresh: %s; source lane retained, queue branch %s deleted; NOT landed.\n' "$url" "$queue_branch" >&2
    drop_land_branch "$queue_branch" "$sha" 2>/dev/null || true
    exit 75
  fi
  if [ "$state" != success ]; then
    safe_push_refusal="Autoland did not land this lane: ${description:-unknown} ${url:-unknown}"
    printf 'safe-push: ✗ Autoland did not land this lane: %s %s; NOT landed.\n' "$description" "$url" >&2
    drop_land_branch "$queue_branch" "$sha" 2>/dev/null || true
    exit 1
  fi
  landed=${description##* }
  printf 'safe-push: ✓ Autoland landed this lane: origin %s is at %s (%s)\n' "$to" "$landed" "$url"
  safe_push_published_head="$landed"; safe_push_landed_sha="$landed"
  fetch_destination >/dev/null
  capture_repository_state
  destination_ref="refs/heads/$to"
  release_follows
  if git reset -q --keep "$landed"; then cleanup_landed_lane || true; fi
  auto_reap || true
  exit 0
}

safe_push_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
if [ "$dry" -eq 0 ] && [ "$to_seen" -eq 1 ] && [ "$to" = "$(default_branch)" ] \
    && [ "${SAFE_PUSH_CAPACITY_ADMITTED:-}" != "$(git rev-parse --show-toplevel)" ]; then
  capacity_command=$(git config --blob HEAD:.safe-push --get landing.capacity 2>/dev/null) || capacity_command=''
  if [ -n "$capacity_command" ]; then
    capacity_status=0
    SAFE_PUSH_LAND_HEAD=$(git rev-parse HEAD) bash -euo pipefail -c \
      "exec $capacity_command env SAFE_PUSH_CAPACITY_ADMITTED=\"\$PWD\" bash \"\$@\"" \
      safe-push-capacity "$(readlink -f "${BASH_SOURCE[0]}")" "${original_arguments[@]}" &
    safe_push_child=$!
    wait "$safe_push_child" || capacity_status=$?
    safe_push_child=""
    safe_push_internal=1
    exit "$capacity_status"
  fi
fi

if [ "$to_seen" -eq 1 ] && git rev-parse -q --verify "refs/remotes/origin/$to" >/dev/null 2>&1; then
  scan_range_for_native=("refs/remotes/origin/$to..HEAD")
  native_ref_scan "$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)" "$to" || exit 1
  tool_removal_scan "refs/remotes/origin/$to..HEAD" || exit 1
  test_integrity_scan "refs/remotes/origin/$to..HEAD" || exit 1
  generated_rewrite_scan "refs/remotes/origin/$to..HEAD" || exit 1
  provenance_scan "refs/remotes/origin/$to..HEAD" || exit 1
  [ "$to" != "$(default_branch)" ] || review_scan "refs/remotes/origin/$to..HEAD" || exit 1
  ci_budget_scan "refs/remotes/origin/$to..HEAD" || exit 1
fi

if [ "$to_seen" -eq 1 ] && [ "$dry" = 0 ]; then
  [ -n "${SAFE_PUSH_LOCK_HELD:-}" ] || case "$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" in
    safe-push-train-*)
      echo "safe-push: this worktree is on the branch of a landing train whose holder stopped, not on a lane; git switch back to the lane's own branch (git reflog shows it) and retry. NOT pushed." >&2
      exit 1
      ;;
  esac
  lock_url=$(git remote get-url --push origin 2>/dev/null) \
    || { echo "safe-push: origin has no push URL"; exit 1; }
  hook=$(pre_push_hook)
  if [ "$to" = main ] && has_land_checks; then hook=""; hook_verified=1; fi
  if [ "$to" = "$(default_branch)" ]; then
    autoland_base=$(fetch_destination)
    if autoland_queue "$autoland_base" && [ "$direct" = 1 ]; then
      mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/safe-push"
      printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$lock_url" "$(git rev-parse --short HEAD)" \
        "$(git symbolic-ref --quiet --short HEAD || true)" >>"${XDG_STATE_HOME:-$HOME/.local/state}/safe-push/direct-landings.tsv"
      echo "safe-push: --direct: bypassing Autoland's queue for an emergency push to $to; logged in direct-landings.tsv"
    elif autoland_queue "$autoland_base"; then
      land_through_autoland "$autoland_base"
    fi
    autoland_gap
    red_fix=$(red_fix_issue "$(fetch_destination)")
  fi
  if [ "$to" != "$(default_branch)" ]; then
    echo "safe-push: $to is not origin's default branch — pushing without the landing lock"
    sync_with_destination
  elif [ -z "$hook" ]; then
    acquire_push_lock "$lock_url"
    sync_with_destination
  else
    queued=0
    first_base=$(fetch_destination)
    if exact_landing "${first_base:-HEAD}"; then
      [ -z "$red_fix" ] || echo "safe-push: $to is red (#$red_fix) and this lane names it — queueing it ahead of the other lanes"
      echo "safe-push: exact landing — queueing for the landing lock before the checks, so a lane ahead can't restart them"
      push_ticket_info=$(printf '%s\t%s\t%s\t%s\n' "$(git rev-parse --show-toplevel)" \
        "$(git symbolic-ref --quiet --short HEAD || true)" "$(git rev-parse HEAD)" "${NORTH_FLEET_SESSION:-}")
      queued=1
      requeued=1
      while [ "$requeued" -eq 1 ]; do
        requeued=0
        acquire_push_lock "$lock_url" 10800
        collect_train
        [ "${#train_tickets[@]}" -eq 0 ] || run_train "$hook"
      done
    fi
    attempt=1
    while :; do
      checked_base=$(fetch_destination)
      rebase_onto_destination "$checked_base"
      checked_head=$(git rev-parse HEAD)
      run_pre_push_checks "$hook" "$checked_base"
      [ "$queued" -eq 1 ] || acquire_push_lock "$lock_url"
      [ "$(git rev-parse HEAD)" = "$checked_head" ] \
        || { echo "safe-push: HEAD changed while the pre-push checks ran — refusing; NOT pushed." >&2; exit 1; }
      upstream=$(fetch_destination)
      if [ "$upstream" = "$checked_base" ]; then
        hook_verified=1
        break
      fi
      if { ! exact_landing "$upstream" || touches_workflows "$checked_base" "$checked_head"; } \
          && [ -n "$checked_base" ] && [ -n "$upstream" ] \
          && git merge-base --is-ancestor "$checked_base" "$upstream" 2>/dev/null \
          && ! touches_same_files "$checked_base" "$upstream" "$checked_head"; then
        echo "safe-push: origin $to's new commits touch none of this change's files — keeping the checks' verdict"
        rebase_onto_destination "$upstream"
        hook_verified=1
        break
      fi
      if [ "$attempt" -ge 3 ]; then
        echo "safe-push: origin $to changed this change's files during $attempt check runs — running the checks under the landing lock"
        rebase_onto_destination "$upstream"
        break
      fi
      echo "safe-push: origin $to changed this change's files during the checks — re-running them ($attempt/3)"
      [ "$queued" -eq 1 ] || release_push_lock
      attempt=$((attempt + 1))
    done
  fi
fi

# --- the load-bearing guard: secret scan of the commits about to be pushed -------
capture_repository_state
capture_destination_state
run_language_gate "${destination_oid:-${absent_base:-}}" "$head_oid" || exit $?
check_instruction_limits "$head_oid"
generated_rewrite_scan "${destination_oid:-${absent_base:-}}..$head_oid" || exit 1
while :; do
  land_base="${destination_oid:-${absent_base:-}}"
  land_locked=0
  if [ -n "$push_lock_fd" ] && has_land_checks && [ "${SAFE_PUSH_CAPACITY_ADMITTED:-}" != "$repo_root" ]; then
    land_locked=1
    release_push_lock
  fi
  run_land_checks "$land_base" "$head_oid" || exit $?
  [ "$land_locked" -eq 1 ] || break
  acquire_push_lock "$lock_url"
  upstream=$(fetch_destination)
  [ "$upstream" != "$land_base" ] || break
  release_push_lock
  rebase_onto_destination "$upstream"
  capture_repository_state
  capture_destination_state
  acquire_push_lock "$lock_url"
done
if [ "$destination_branch" = main ] && has_land_checks; then hook_verified=1; fi
command -v gitleaks >/dev/null 2>&1 || { echo "safe-push: gitleaks not on PATH — refusing to push without a secret scan"; exit 1; }
if [ -n "$destination_oid" ] && [ "$destination_oid" = "$head_oid" ]; then
  echo "safe-push: nothing to push ($head_oid already at origin $destination_ref)"
  safe_push_nothing_to_push=1
  safe_push_published_head=$(git rev-parse HEAD); safe_push_landed_sha="$head_oid"
  exit 0
fi

command -v north >/dev/null 2>&1 || { echo "safe-push: north missing on PATH — refusing to push without the dependency gate; NOT pushed."; exit 1; }
echo "safe-push: north dep-gate ${destination_oid:-${absent_base:-}} $head_oid"
(cd "$repo_root" && north dep-gate "${destination_oid:-${absent_base:-}}" "$head_oid") \
  || { echo "safe-push: ✗ dependency gate refused — NOT pushed."; exit 1; }

code_health="${SAFE_PUSH_CODE_HEALTH:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/code-health}"
has_structure=0
git cat-file -e "$head_oid:structure.toml" 2>/dev/null && has_structure=1
if [ -x "$code_health" ]; then
  code_health_status=0
  (cd "$repo_root" && "$code_health" gate "${destination_oid:-${absent_base:-}}" "$head_oid") || code_health_status=$?
  case "$code_health_status" in
    0) ;;
    1) echo "safe-push: ✗ code-health gate refused — NOT pushed."; exit 1 ;;
    *)
      if [ "$has_structure" -eq 1 ]; then
        echo "safe-push: ✗ code-health gate failed (exit $code_health_status) — fix the tool; NOT pushed."; exit 1
      fi
      echo "safe-push: code-health gate failed (exit $code_health_status) in a repo with no structure.toml — continuing"
      ;;
  esac
elif [ "$has_structure" -eq 1 ]; then
  echo "safe-push: code-health missing at $code_health — refusing to push a repo with structure.toml ungated; NOT pushed."; exit 1
fi

scan_range_for_native=("$scan_range")
native_ref_scan "$branch" "$destination_branch" || exit 1
tool_removal_scan "$scan_range" || exit 1
test_integrity_scan "$scan_range" || exit 1
generated_rewrite_scan "$scan_range" || exit 1
provenance_scan "$scan_range" || exit 1
[ "$destination_branch" != "$(default_branch)" ] || review_scan "$scan_range" || exit 1
[ "$to_seen" -eq 1 ] || [ "$destination_branch" != main ] || ci_budget_scan "$scan_range" || exit 1
echo "safe-push: scanning $scan_range for secrets ($branch_ref@$head_oid -> origin $destination_ref@${destination_oid:-absent})…"
gitleaks detect --no-banner --redact --log-opts="$scan_range" \
  || { echo "safe-push: ✗ SECRET DETECTED — fix the leak; NOT pushed."; exit 1; }
denylist_scan "${destination_oid:-${absent_base:-}}" "$head_oid" "$destination_branch" || exit 1
commit_email_scan "$scan_range" || exit 1

revalidate_repository_state
plan_push publication "$head_oid" "$destination_ref" "$destination_oid"
if [ "$dry" = 1 ]; then
  echo "safe-push: ✓ clean (--dry-run) — would push $branch -> origin as $publication"
  exit 0
fi
echo "safe-push: ✓ clean — pushing $branch -> origin as $publication"
# Marker for the north hook tripwire guard (PreToolUse deny): raw `git push` is denied
# estate-wide; this env var identifies the sanctioned inner push as safe-push's own.
# The source is the immutable object that was scanned, never a mutable branch/HEAD.
# The exact lease closes the final destination race. It cannot authorize a
# non-fast-forward update: capture_destination_state proved ancestry first.
push_flags=()
[ "$hook_verified" -eq 0 ] || push_flags+=(--no-verify)
if [ "$hook_verified" -eq 0 ] && ! sync_dependencies; then
  echo "safe-push: ✗ bun install failed before the pre-push checks; NOT pushed." >&2
  exit 1
fi
pushed_at=$EPOCHSECONDS
(drop_lock_fd; SAFE_PUSH_ACTIVE=1 git push --no-follow-tags "${push_flags[@]}" \
  "${publication_flags[@]}" \
  "$origin_url" "$publication")
record_push "$pushed_at" "$([ "$destination_branch" = main ] && printf '%s' "$branch" || printf '%s' "$destination_branch")" "$head_oid" \
  "$(trunk_landing "$destination_branch" "$head_oid")" "${NORTH_FLEET_SESSION:-}"
release_push_lock
if [ "$to_seen" -eq 0 ]; then
  tracking_ref="refs/remotes/origin/$destination_branch"
  if git fetch -q "$origin_url" "${destination_ref}:${tracking_ref}" \
      && git branch --set-upstream-to="origin/$destination_branch" "$branch" >/dev/null; then
    :
  else
    printf 'safe-push: pushed successfully, but could not establish origin/%s tracking\n' \
      "$destination_branch" >&2
  fi
fi
release_follows
safe_push_published_head="$head_oid"; safe_push_landed_sha="$head_oid"
cleanup_landed_lane || true
auto_reap || true
