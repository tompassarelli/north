#!/usr/bin/env bash
# safe-push — the standing-authorized way to push to GitHub without asking a human.
# Encodes the global AGENTS.md push policy as a mechanical check so every
# agent pushes identically-safe: scan the to-be-pushed commits for secrets, refuse
# force/destructive pushes, then push HEAD to the same-named remote branch unless
# an explicit --to destination is supplied. Any guard
# trip => nothing is pushed, nonzero exit. The secret scan — not a human — is the
# guard, and it travels with this command, so it protects repos that have no
# commit-time hook (north today). The repository state that defines
# the scan is captured first and must remain identical at publication; pushes
# name the captured object ID and destination ref explicitly.
#
# Usage:  safe-push [--dry-run] [--to BRANCH] [--keep-lane]
#         safe-push --restore [--dry-run] COMMIT BRANCH   (recreate a deleted branch at a commit that is already public)
#         safe-push [--dry-run] --tag NAME
#         safe-push [--dry-run] --delete-tag NAME
# /proc is the host's even inside run-bounded's PID namespace, so peers are named by host PID.
read -r self_pid _ </proc/self/stat
safe_push_started_ms=$(( ${EPOCHREALTIME//./} / 1000 ))
safe_push_started_at=$(date -u +%FT%T.%3NZ)
set -euo pipefail
json_text() {
  local text="${1//\\/\\\\}"
  text="${text//\"/\\\"}"
  printf '%s' "${text//[$'\001'-$'\037']/ }"
}

safe_push_events_file() { printf '%s/safe-push/events.jsonl' "${XDG_STATE_HOME:-$HOME/.local/state}"; }

safe_push_event_line() {
  local repository="${origin_url:-}" lane="${branch:-}" sha="${head_oid:-}"
  repository="${repository##*/}"
  printf '{"time":%s,"repo":"%s","lane":"%s","sha":"%s","stage":"%s","status":"%s","detail":"%s","seconds":%s,"pid":%s,"session":"%s","host":"%s"}\n' \
    "$EPOCHREALTIME" "$(json_text "${repository%.git}")" "$(json_text "$lane")" "$sha" "$(json_text "$1")" "$2" "$(json_text "${3:-}")" "${4:-0}" "$self_pid" \
    "$(json_text "${NORTH_FLEET_SESSION:-}")" "$(json_text "${HOSTNAME:-}")"
}

safe_push_event() {
  local file; file=$(safe_push_events_file)
  { mkdir -p "${file%/*}" && safe_push_event_line "$@" >>"$file"; } 2>/dev/null || true
  local watcher="${SAFE_PUSH_WATCH:-$HOME/.local/state/north/current/north}"
  [ -z "${SAFE_PUSH_TEST_REAL_NORTH:-}" ] || watcher="${SAFE_PUSH_WATCH:-}"
  case "$2" in
    refused|failed) [ -x "$watcher" ] && setsid -f "$watcher" watch --once >/dev/null 2>&1 </dev/null || true ;;
  esac
}

safe_push_terminal() {
  local status="${1:-$?}" terminal_reason
  trap - EXIT
  if [ "$status" -eq 130 ] || [ "$status" -eq 143 ]; then
    printf 'safe-push: cancelled\n'
    exit 130
  fi
  if [ "${safe_push_internal:-0}" = 1 ] || [ "${safe_push_help:-0}" = 1 ]; then exit "$status"; fi
  if [ "$status" -eq 0 ] && [ "${dry:-0}" -eq 1 ]; then exit 0; fi
  terminal_reason="${safe_push_refusal:-safe-push did not land}"
  safe_push_event exit refused "$terminal_reason"
  local north_runtime="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
  if [ -x "$north_runtime" ] && "$north_runtime" safe-push-result refused '' "$terminal_reason" 0 ''; then exit 1; fi
  printf 'safe-push: refused %s\n' "$terminal_reason"
  exit 1
}

safe_push_exit() {
  local status=$?
  [ "$status" -ne 0 ] || [ -z "${land_check_root:-}" ] || release_land_check_build "$land_check_root"
  if [ "${NORTH_NO_AUTOREAP:-0}" = 1 ]; then exit "$status"; fi
  safe_push_terminal "$status"
}

safe_push_internal=0
safe_push_help=0
if [ "${1:-}" = --publication-scan ]; then safe_push_internal=1; fi
if [ "$#" -eq 1 ] && [[ "$1" = -h || "$1" = --help ]]; then safe_push_help=1; fi
trap safe_push_exit EXIT
safe_push_cancel() {
  trap - INT TERM HUP
  [ -z "${safe_push_child:-}" ] || kill -TERM $safe_push_child 2>/dev/null || true
  exit 130
}
trap safe_push_cancel INT TERM HUP
original_arguments=("$@")
safe_push_self=$(readlink -f "${BASH_SOURCE[0]}")
if [ "${1:-}" = abandon ]; then
  safe_push_internal=1; north land-abandon "${@:2}"; exit $?
fi
if [ "${1:-}" = --restore ]; then
  safe_push_internal=1; command -v north >/dev/null 2>&1 && north land restore --help >/dev/null 2>&1 || { echo "safe-push: this host's north runtime lacks north land restore; run north runtime update; NOT restored." >&2; exit 1; }; exec north land restore "${@:2}"
fi
if [ "${1:-}" = --enqueue ]; then
  safe_push_internal=1; north land enqueue --help >/dev/null 2>&1 || { echo "safe-push: this host's north runtime lacks north land enqueue; run north runtime update; NOT queued." >&2; exit 1; }; exec north land enqueue "${@:2}"
fi
usage() {
  north safe-push --help 2>/dev/null || echo 'safe-push: the help text is north safe-push --help, which this host lacks; run north runtime update'
}

argument_error() {
  printf 'safe-push: %s\n' "$1" >&2
  usage >&2
  exit 2
}

plan_push() {
  local mode="$1"
  shift
  case "$mode" in
    arguments)
      dry=0
      keep_lane=0
      tag=""
      message_file=""
      several_commits=""
      tag_seen=0
      delete_tag=""
      delete_tag_seen=0
      to=""
      to_seen=0
      publication_scan_range=()
      check_base=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --check-candidate)
            [ "$#" -eq 3 ] && [ "$2" = --base ] && [[ "$3" =~ ^[0-9a-f]{40}$ ]] || argument_error '--check-candidate needs --base SHA and nothing else'
            check_base=$3 to=main to_seen=1
            shift 3
            ;;
          -h|--help)
            if [ "$#" -ne 1 ] || [ "$dry" -eq 1 ] || [ "$tag_seen" -eq 1 ] || [ "$delete_tag_seen" -eq 1 ] || [ "$to_seen" -eq 1 ]; then
              argument_error '--help cannot be combined with other arguments'
            fi
            usage
            exit 0
            ;;
          --dry-run) [ "$dry" -eq 0 ] || argument_error 'duplicate --dry-run'; dry=1; shift ;;
          --keep-lane) [ "$keep_lane" -eq 0 ] || argument_error 'duplicate --keep-lane'; keep_lane=1; shift ;;
          --message)
            [ -z "$message_file" ] || argument_error 'duplicate --message'
            [ "$#" -ge 2 ] || argument_error '--message needs a file'
            case "$2" in ''|-*) argument_error '--message needs a file' ;; esac
            message_file="$2"
            shift 2
            ;;
          --several-commits)
            [ -z "$several_commits" ] || argument_error 'duplicate --several-commits'
            case "${2:-}" in ''|-*) argument_error '--several-commits needs a reason' ;; esac
            several_commits="$2"
            shift 2
            ;;
          --tag)
            [ "$tag_seen" -eq 0 ] || argument_error 'duplicate --tag'
            [ "$#" -ge 2 ] || argument_error '--tag needs a name'
            case "$2" in
              ''|-*) argument_error '--tag needs a name' ;;
            esac
            tag="$2"
            tag_seen=1
            shift 2
            ;;
          --delete-tag)
            [ "$delete_tag_seen" -eq 0 ] || argument_error 'duplicate --delete-tag'
            [ "$#" -ge 2 ] || argument_error '--delete-tag needs a name'
            case "$2" in
              ''|-*) argument_error '--delete-tag needs a name' ;;
            esac
            delete_tag="$2"
            delete_tag_seen=1
            shift 2
            ;;
          --to)
            [ "$to_seen" -eq 0 ] || argument_error 'duplicate --to'
            [ "$#" -ge 2 ] || argument_error '--to needs a branch name'
            case "$2" in
              ''|-*) argument_error '--to needs a branch name' ;;
            esac
            to="$2"
            to_seen=1
            shift 2
            ;;
          --publication-scan)
            [ "$#" -eq 3 ] || argument_error '--publication-scan needs BASE HEAD and nothing else'
            publication_scan_range=("$2" "$3")
            shift 3
            ;;
          -f|--force|--force-with-lease|--mirror|--delete|--prune)
            printf "safe-push: refuses '%s' — force/destructive pushes are deliberate + manual, not automatic\n" "$1" >&2
            exit 1
            ;;
          *)
            argument_error "unknown argument '$1'"
            ;;
        esac
      done

      [ "$delete_tag_seen" -eq 0 ] || { [ "$tag_seen" -eq 0 ] && [ "$to_seen" -eq 0 ] && [ "$keep_lane" -eq 0 ] && [ -z "$message_file$several_commits" ]; } \
        || argument_error '--delete-tag cannot be combined with other arguments but --dry-run'
      [ "$tag_seen" -eq 0 ] || [ "$to_seen" -eq 0 ] \
        || argument_error '--to cannot be combined with --tag'
      [ "$keep_lane" -eq 0 ] || [ "$to_seen" -eq 1 ] \
        || argument_error '--keep-lane needs --to'
      [ -z "$message_file$several_commits" ] || [ "$to_seen" -eq 1 ] \
        || argument_error '--message and --several-commits need --to'
      [ -z "$message_file" ] || [ -z "$several_commits" ] \
        || argument_error '--message cannot be combined with --several-commits'

      if [ "$to_seen" -eq 1 ]; then
        case "$to" in
          ''|-*|HEAD|refs/*|origin/*|*'..'*|*'@{'*|*\\*|*' '*|*'~'*|*'^'*|*':'*|*'?'*|*'*'*|*'['*)
            argument_error "invalid destination branch '$to'"
            ;;
        esac
      fi
      ;;
    snapshot)
      local output="$1" destination_ref="$2" value ref extra count=0 oid=""
      if [ -z "$output" ]; then
        printf 'absent\n'
        return 0
      fi
      while IFS=$'\t' read -r value ref extra; do
        case "$value" in
          'ref: '*)
            echo "safe-push: origin destination $destination_ref is symbolic — refusing" >&2
            return 1
            ;;
        esac
        if { [[ "$value" =~ ^[0-9a-f]{40}$ ]] || [[ "$value" =~ ^[0-9a-f]{64}$ ]]; } \
            && [ "$ref" = "$destination_ref" ] && [ -z "$extra" ]; then
          oid="$value"
          count=$((count + 1))
        else
          echo "safe-push: origin destination $destination_ref is malformed or ambiguous — refusing" >&2
          return 1
        fi
      done <<<"$output"
      if [ "$count" -ne 1 ]; then
        echo "safe-push: origin destination $destination_ref is malformed or ambiguous — refusing" >&2
        return 1
      fi
      printf 'object:%s\n' "$oid"
      ;;
    publication)
      local head_oid="$1" destination_ref="$2" destination_oid="$3"
      publication="${head_oid}:${destination_ref}"
      ;;
  esac
}

plan_push arguments "$@"
if [ "$tag_seen" -eq 1 ] || [ "$delete_tag_seen" -eq 1 ] || { north remote-land --help >/dev/null 2>&1 && north remote-land routes "${original_arguments[@]}" 2>/dev/null; }; then
  safe_push_internal=1
  north safe-push --help >/dev/null 2>&1 || { echo "safe-push: tags, tag deletions and ledger-client south lands publish through north safe-push, which this host's north runtime lacks; run north runtime update; NOT pushed."; exit 1; }
  exec north safe-push "${original_arguments[@]}"
fi

default_branch() {
  local default
  default=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || default=""
  default=${default#refs/remotes/origin/}
  printf '%s\n' "${default:-main}"
}

rust_target=$to
[ "$to_seen" -eq 1 ] || rust_target=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || rust_target=""
if [ -n "$check_base" ] || { [ "$dry" -eq 1 ] && [ "$rust_target" = "$(default_branch)" ]; }; then
  safe_push_internal=1
  command -v north >/dev/null 2>&1 || { echo "safe-push: north not on PATH; refusing to land without the language gate; NOT pushed." >&2; exit 1; }
  SAFE_PUSH_SELF="$safe_push_self" exec north safe-push "${original_arguments[@]}"
fi

# A log file belongs to one safe-push tree: workers sharing a scratch push.log read each other's landings as their own.
claim_output_log() {
  local fd target claimed=""
  for fd in 1 2; do
    target=$(readlink "/proc/$self_pid/fd/$fd" 2>/dev/null) || continue
    [ -f "$target" ] || continue
    case " $claimed ${SAFE_PUSH_OUTPUT_CLAIMED:-} " in *" $target "*) continue ;; esac
    exec {output_lock_fd}<"$target"
    if ! flock -n "$output_lock_fd"; then
      printf 'safe-push: refusing in %s: %s is already the log of another running safe-push; give each landing its own log file. NOT pushed.\n' \
        "$PWD" "$target" >&2
      exit 1
    fi
    claimed="$claimed $target"
  done
  export SAFE_PUSH_OUTPUT_CLAIMED="${SAFE_PUSH_OUTPUT_CLAIMED:-}$claimed"
}
claim_output_log

safe_push_stage_ms=$safe_push_started_ms
printf 'safe-push: start %s\n' "$safe_push_started_at"
# Prints how long the stage that just ended took and the time since safe-push started, so a landing's start-to-landed time is measured, not estimated.
stage() {
  local now=$(( ${EPOCHREALTIME//./} / 1000 ))
  printf 'safe-push: stage %s: %s.%03d s (+%s.%03d s since start)\n' "$1" $(( (now - safe_push_stage_ms) / 1000 )) $(( (now - safe_push_stage_ms) % 1000 )) $(( (now - safe_push_started_ms) / 1000 )) $(( (now - safe_push_started_ms) % 1000 ))
  local repository="${origin_url:-}"; repository="${repository##*/}"; mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/safe-push" 2>/dev/null || true
  { printf '%s\t%s\t%s\t%s\t%s\t%s\n' $((safe_push_started_ms / 1000)) "${repository%.git}" "${branch:-}" "$1" $((now - safe_push_stage_ms)) $((now - safe_push_started_ms)) >>"${XDG_STATE_HOME:-$HOME/.local/state}/safe-push/stages.tsv"; } 2>/dev/null || true
  safe_push_event "$1" end "" "$(( (now - safe_push_stage_ms) / 1000 )).$(( (now - safe_push_stage_ms) % 1000 / 100 ))"
  safe_push_stage_ms=$now
}

state_changed() {
  printf 'safe-push: repository state changed during secret scan (%s) — refusing; NOT pushed.\n' "$1" >&2
  exit 1
}

capture_repository_state() {
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "safe-push: not in a git repo"; exit 1; }
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
    || { echo "safe-push: cannot identify this Git worktree"; exit 1; }
  origin_url=$(git remote get-url --push origin 2>/dev/null) \
    || { echo "safe-push: origin has no push URL"; exit 1; }
  if [ -n "$check_base" ]; then
    branch="" branch_ref=""
    head_oid=$(git rev-parse --verify "HEAD^{commit}" 2>/dev/null) \
      || { echo "safe-push: cannot resolve HEAD to a commit"; exit 1; }
    return 0
  fi
  branch_ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) \
    || { echo "safe-push: detached HEAD — checkout a branch first"; exit 1; }
  case "$branch_ref" in
    refs/heads/*) branch=${branch_ref#refs/heads/} ;;
    *) echo "safe-push: HEAD does not name a local branch"; exit 1 ;;
  esac
  head_oid=$(git rev-parse --verify "${branch_ref}^{commit}" 2>/dev/null) \
    || { echo "safe-push: cannot resolve $branch_ref to a commit"; exit 1; }
}

# Public deny-list: private identity values never reach a public repository.
# An absent deny-list refuses a public push where south exists and warns
# elsewhere; an unknown visibility fails closed.
south="${SAFE_PUSH_SOUTH:-$HOME/code/south}"
denylist="${SAFE_PUSH_DENYLIST:-}"
origin_visibility=""
resolve_origin_visibility() {
  { [ -f "$denylist" ] || [ -d "$south" ]; } && [ -z "$origin_visibility" ] || return 0
  origin_visibility=$(gh repo view "$1" --json visibility -q .visibility 2>/dev/null) || origin_visibility=""
  [ -n "$origin_visibility" ] || origin_visibility=UNKNOWN
}

commit_email_scan() {
  north land scan commit-email "$@"
}

denylist_scan() {
  north land scan denylist "$1" "$2" "$3"
}

native_ref_scan() {
  north land scan native-ref --range "${scan_range_for_native[0]}" -- "$@"
}

# ~/.local/bin links every tool out-of-store into north bin/ and firn dotfiles/bin/, so a tool removed from main breaks every session.
tool_removal_scan() {
  north land scan tool-removal "$1"
}

test_integrity_scan() {
  north land scan test-integrity "$1"
}

test_admission_scan() {
  local status=0
  north land scan test-admission "$1" || status=$?
  [ "$status" -ne 64 ] || echo "safe-push: this host's north runtime lacks north land scan test-admission, which safe-push calls; run north runtime update; NOT pushed." >&2
  return "$status"
}

docs_owners_scan() {
  local status=0
  north land scan docs-owners "$1" || status=$?
  [ "$status" -ne 64 ] || echo "safe-push: this host's north runtime lacks north land scan docs-owners, which safe-push calls; run north runtime update; NOT pushed." >&2
  return "$status"
}

doc_links_scan() {
  local status=0
  north land scan doc-links "$1" || status=$?
  [ "$status" -ne 64 ] || echo "safe-push: this host's north runtime lacks north land scan doc-links, which safe-push calls; run north runtime update; NOT pushed." >&2
  return "$status"
}

policy_sweep_scan() {
  north land scan policy-sweep "$1"
}

strategy_replay_scan() {
  [[ "$(north land scan --help 2>&1)" == *strategy-replay* ]] || { echo "safe-push: this host's north runtime predates north land scan strategy-replay; the replay of a lane that touches a logged decision is skipped until north runtime update." >&2; return 0; }
  north land scan strategy-replay "$1"
}

publication_scan() {
  north land scan publication "$1" "$2"
}

if [ "${#publication_scan_range[@]}" -eq 2 ]; then
  publication_scan "${publication_scan_range[@]}"
  exit $?
fi

lane_scan() {
  local north; north=$(command -v north) && [ -x "$north" ] || north="${SAFE_PUSH_TEST_REAL_NORTH:-$HOME/.local/state/north/current/north}"
  "$north" land scan "$@"
}

refuse_dropped_lane_commits() {
  lane_scan dropped-commits --lane "$lane_tip" --head "$head_oid" --onto "${destination_branch:-$to}" --destination "${destination_oid:-}" || exit 1
}

refuse_stale_revert() {
  lane_scan stale-revert --repo "$repo_root" --destination "$destination_branch" --base "${destination_oid:-}" --lane "${lane_tip:-$head_oid}" "$head_oid" || exit 1
}

has_land_checks() {
  git config --blob HEAD:.safe-push --get-all land.check >/dev/null 2>&1 \
    || { command -v north >/dev/null 2>&1 && north land checks --any --head HEAD >/dev/null 2>&1; }
}

north_offers() {
  [[ "$(north "$1" --help 2>&1)" == *"unrecognized command '$1"* ]] || return 0
  local needed; needed=$(git -C "$(dirname "$safe_push_self")" rev-parse --short=12 HEAD 2>/dev/null || echo "this safe-push")
  echo "safe-push: this host's north runtime lacks north $1, which safe-push $needed calls; run north runtime update to $needed or later; NOT pushed." >&2
  return 1
}

run_language_gate() {
  command -v north >/dev/null 2>&1 || { echo 'safe-push: north not on PATH; refusing to land without the language gate; NOT pushed.' >&2; exit 1; }
  local status=0; north land scan language --base "$1" --head "$2" --origin "${origin_url:-}" --safe-push "$safe_push_self" || status=$?
  [ "$status" -ne 69 ] || exit 1; return "$status"
}

land_offload_host() {
  [ "${SAFE_PUSH_LAND_OFFLOAD:-1}" = 1 ] || return 1
  has_land_checks && command -v north >/dev/null 2>&1 || return 1
  north land checks --portable --base "refs/remotes/origin/${to:-main}" --head HEAD 2>/dev/null || return 1
  north capacity offload choose
}

land_checks_call() {
  local outcome status=0 kind first second third
  outcome=$(mktemp)
  land_check_skip=""
  (drop_lock_fd; exec north land checks --base "$1" --head "$2" --dry "${dry:-0}" --safe-push "$safe_push_self" --outcome "$outcome" \
    --destination "${destination_branch:-${to:-}}" --event-log "$(safe_push_events_file)" --wait-event "$(safe_push_event_line 'land checks' wait)") &
  safe_push_child=$!
  wait "$safe_push_child" || status=$?
  safe_push_child=""
  [ "$status" -ne 130 ] && [ "$status" -ne 143 ] || exit 130
  while IFS=$'\t' read -r kind first second third; do
    case "$kind" in
      event) safe_push_event "$first" "$second" "$third" ;;
      skip) land_check_skip=$first ;;
      red-main) blocked_by_red_main=$first ;;
      ran) land_check_root=$(git rev-parse --show-toplevel) ;;
    esac
  done <"$outcome"
  rm -f -- "$outcome"
  return "$status"
}

blocked_by_red_main=""

release_land_check_build() {
  [ "${keep_lane:-0}" -eq 0 ] || return 0
  north land-clean "$1" || true
}

remote_destination_snapshot() {
  local output
  output=$(git ls-remote --symref "$origin_url" "$destination_ref") \
    || { echo "safe-push: cannot read origin destination $destination_ref" >&2; return 1; }
  plan_push snapshot "$output" "$destination_ref"
}

capture_destination_state() {
  destination_branch=${to:-$branch}
  destination_ref="refs/heads/$destination_branch"
  destination_snapshot=$(remote_destination_snapshot) || exit 1
  destination_oid=""
  if [[ "$destination_snapshot" == object:* ]]; then
    destination_oid=${destination_snapshot#object:}
    git cat-file -e "${destination_oid}^{commit}" 2>/dev/null \
      || { echo "safe-push: origin $destination_ref is not available locally at $destination_oid — fetch it first" >&2; exit 1; }
    git merge-base --is-ancestor "$destination_oid" "$head_oid" 2>/dev/null \
      || { echo "safe-push: non-fast-forward $head_oid -> $destination_ref (origin at $destination_oid) — refusing" >&2; exit 1; }
    scan_range="${destination_oid}..${head_oid}"
  else
    # A new branch publishes only what origin's default branch lacks; scanning
    # the whole reachable history costs minutes and cores on every scratch push.
    absent_base=$(git ls-remote "$origin_url" HEAD 2>/dev/null | awk 'NR==1 {print $1}')
    if [ -n "$absent_base" ] && git cat-file -e "${absent_base}^{commit}" 2>/dev/null; then
      scan_range="${absent_base}..${head_oid}"
    else
      absent_base=""
      scan_range="$head_oid"
    fi
  fi
}

revalidate_repository_state() {
  local current_root current_git_dir current_origin_url current_branch_ref
  local current_head_oid current_destination_snapshot current_range

  current_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || state_changed 'repository unavailable'
  [ "$current_root" = "$repo_root" ] || state_changed 'repository root/worktree changed'

  current_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
    || state_changed 'Git worktree unavailable'
  [ "$current_git_dir" = "$git_dir" ] || state_changed 'Git worktree changed'

  current_origin_url=$(git remote get-url --push origin 2>/dev/null) \
    || state_changed 'origin push URL unavailable'
  [ "$current_origin_url" = "$origin_url" ] || state_changed 'origin push URL changed'

  current_branch_ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) \
    || state_changed 'HEAD became detached'
  [ "$current_branch_ref" = "$branch_ref" ] || state_changed 'current branch changed'

  current_head_oid=$(git rev-parse --verify "${current_branch_ref}^{commit}" 2>/dev/null) \
    || state_changed 'HEAD commit unavailable'
  [ "$current_head_oid" = "$head_oid" ] || state_changed 'HEAD commit changed'

  current_destination_snapshot=$(remote_destination_snapshot) \
    || state_changed 'origin destination became unavailable, symbolic, malformed, or ambiguous'
  [ "$current_destination_snapshot" = "$destination_snapshot" ] \
    || state_changed "origin destination $destination_ref changed"
  if [[ "$current_destination_snapshot" == object:* ]]; then
    current_range="${current_destination_snapshot#object:}..${current_head_oid}"
  else
    current_range="${absent_base:+${absent_base}..}${current_head_oid}"
  fi
  [ "$current_range" = "$scan_range" ] || state_changed 'outgoing range changed'
}

# A bare safe-push on the default branch lands it; every other push publishes through north land push.
if [ -z "$check_base" ] && [ "$to_seen" -eq 0 ] && [ "$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" = "$(default_branch)" ]; then to=$(default_branch) to_seen=1; fi
if [ "$to_seen" -eq 0 ] || [ "$to" != "$(default_branch)" ]; then
  safe_push_internal=1
  command -v north >/dev/null 2>&1 || { echo "safe-push: north not on PATH; refusing to land without the language gate; NOT pushed." >&2; exit 1; }
  north land push --help >/dev/null 2>&1 || { echo "safe-push: this host's north runtime lacks north land push, which publishes every branch but $(default_branch); run north runtime update; NOT pushed." >&2; exit 1; }
  SAFE_PUSH_SELF="$safe_push_self" exec north land push "${original_arguments[@]}"
fi

drop_lock_fd() {
  [ "$BASHPID" != "$$" ] || return 0
  [ -z "${output_lock_fd:-}" ] || exec {output_lock_fd}<&-
}

sync_dependencies() {
  (drop_lock_fd; lane_scan deps)
}

# Fetches origin's destination and prints its tip; nothing when origin has no
# such branch. A failed fetch of a branch origin has, or of an origin that
# cannot be asked, is refused by the caller instead of read as an empty base.
fetch_destination() {
  local remote_ref="refs/remotes/origin/$to" status=0
  if ! git fetch -q origin "+refs/heads/$to:$remote_ref" 2>/dev/null; then
    git ls-remote --exit-code origin "refs/heads/$to" >/dev/null 2>&1 || status=$?
    [ "$status" -eq 2 ] && return 0
    printf 'safe-push: could not fetch origin/%s; NOT pushed.\n' "$to" >&2
    return 1
  fi
  git rev-parse -q --verify "${remote_ref}^{commit}" 2>/dev/null || true
}

lane_tip=$(git rev-parse -q --verify HEAD) || lane_tip=""
export SAFE_PUSH_LAND_CAPACITY=''
if [ "$dry" -eq 0 ] && [ "$to_seen" -eq 1 ] && [ "$to" = "$(default_branch)" ]; then
  SAFE_PUSH_LAND_CAPACITY=$(git config --blob HEAD:.safe-push --get landing.capacity 2>/dev/null) || SAFE_PUSH_LAND_CAPACITY=''
  if offloaded_command=$(git config --blob HEAD:.safe-push --get landing.offloaded-capacity 2>/dev/null) && offload_host=$(land_offload_host); then
    SAFE_PUSH_LAND_CAPACITY=$offloaded_command
    export SAFE_PUSH_LAND_OFFLOAD_HOST=$offload_host
  fi
fi

candidate_verdict() {
  local base="$1" head log status class=refused detail
  head=$(git rev-parse HEAD) log=$(mktemp) safe_push_internal=1
  capture_repository_state
  resolve_origin_visibility "$origin_url"
  destination_branch=main destination_ref=refs/heads/main scan_range_for_native=("$base..$head")
  if ! sync_dependencies >>"$log" 2>&1; then
    class=transient detail="bun install failed"
  elif ! { north_offers language-gate && north_offers build-cache-gate; } 2>>"$log"; then
    class=transient detail="this host's north runtime predates safe-push; run north runtime update"
  elif ! { run_language_gate "$base" "$head" && native_ref_scan && north land scan secrets "$base..$head" \
      && denylist_scan "$base" "$head" main && commit_email_scan "$base..$head" && north land scan dep-gate "$base..$head" \
      && tool_removal_scan "$base..$head" && test_integrity_scan "$base..$head" && policy_sweep_scan "$base..$head" && strategy_replay_scan "$base..$head"; } >>"$log" 2>&1; then
    :
  elif land_checks_call "$base" "$head" >>"$log" 2>&1; then
    class=green detail=$head
  else
    status=$?
    if [ -n "$blocked_by_red_main" ]; then class=red-main detail=$base
    elif [ "$status" -eq 75 ] && [[ "$land_check_skip" == "main's check environment is broken: "* ]]; then class=transient detail=$land_check_skip
    elif [ "$status" -eq 75 ] && grep -q 'DEFER' "$log"; then class=deferred
    elif [ "$status" -eq 75 ] || [[ "$land_check_skip" == *'bun install failed'* ]]; then class=transient detail=${land_check_skip:-exit 75}
    fi
  fi
  cat "$log"
  [ "$class" != refused ] || detail=$(grep -oE 'https?://[^[:space:]()]+/actions/runs/[0-9]+' "$log" | tail -n1) || detail=""
  printf 'safe-push: verdict %s %s\n' "$class" "${detail:-$log}"
  [ "$class" = green ]
  exit
}
[ -z "$check_base" ] || candidate_verdict "$check_base"

policy_failures=()
policy_scans() {
  local branch="$1" destination="$2" range="$3"
  policy_failures=()
  scan_range_for_native=("$range")
  native_ref_scan "$branch" "$destination" || policy_failures+=("native item reference")
  tool_removal_scan "$range" || policy_failures+=("tool removal")
  test_integrity_scan "$range" || policy_failures+=("test integrity")
  test_admission_scan "$range" || policy_failures+=("test admission")
  policy_sweep_scan "$range" || policy_failures+=("policy sweep")
  docs_owners_scan "$range" || policy_failures+=("document owners")
  doc_links_scan "$range" || policy_failures+=("document links")
  [ "${#policy_failures[@]}" -eq 0 ]
}

# Every blocking check runs to completion; a refused landing names each failure in one line.
refusals=()
refuse_collected() {
  local joined
  [ "${#refusals[@]}" -gt 0 ] || return 0
  joined=$(printf '%s; ' "${refusals[@]}")
  safe_push_refusal="${#refusals[@]} blocking check(s) failed: ${joined%; }"
  printf 'safe-push: ✗ %s; NOT pushed.\n' "$safe_push_refusal"
  exit 1
}

if [ "$to_seen" -eq 1 ] && [ "$dry" = 0 ]; then
  fetch_destination >/dev/null || exit 1
  command -v north >/dev/null 2>&1 || { echo "safe-push: north not on PATH; refusing to land without the language gate; NOT pushed." >&2; exit 1; }
  north land route --help >/dev/null 2>&1 || { echo "safe-push: this host's north runtime lacks north land route, which decides whether the lander takes this lane; run north runtime update; NOT pushed." >&2; exit 1; }
  route_status=0; north land route "${original_arguments[@]}" || route_status=$?
  [ "$route_status" -ne 0 ] || safe_push_internal=1
  exit "$route_status"
fi

capture_repository_state
capture_destination_state
run_language_gate "${destination_oid:-${absent_base:-}}" "$head_oid" || refusals+=("language gate")
stage "language gate"
stale_revert_refused=0
if has_land_checks && ! (refuse_stale_revert); then
  stale_revert_refused=1
  refusals+=("stale revert of newer main")
fi
# The dependency gate and the policy, secret, deny-list and email scans read only the commits being landed.
final_scans() {
  if ! command -v north >/dev/null 2>&1; then
    echo "safe-push: north missing on PATH — refusing to push without the dependency gate; NOT pushed."
    refusals+=("dependency gate (no north on PATH)")
  else
    echo "safe-push: north land scan dep-gate ${destination_oid:-${absent_base:-}}..$head_oid"
    north land scan dep-gate "${destination_oid:-${absent_base:-}}..$head_oid" \
      || { echo "safe-push: ✗ dependency gate refused — NOT pushed."; refusals+=("dependency gate"); }
  fi
  policy_scans "$branch" "$destination_branch" "$scan_range" || refusals+=("${policy_failures[@]}")
  echo "safe-push: scanning $scan_range for secrets with betterleaks ($branch_ref@$head_oid -> origin $destination_ref@${destination_oid:-absent})…"
  north land scan secrets "$scan_range" \
    || { echo "safe-push: ✗ SECRET DETECTED — fix the leak; NOT pushed."; refusals+=("secret scan"); }
  denylist_scan "${destination_oid:-${absent_base:-}}" "$head_oid" "$destination_branch" || refusals+=("deny-list scan")
  commit_email_scan "$scan_range" || refusals+=("commit email")
}
land_base="${destination_oid:-${absent_base:-}}"
land_status=0
land_checks_call "$land_base" "$head_oid" || land_status=$?
stage "land checks"
if [ "$land_status" -ne 0 ]; then
  [ -z "$blocked_by_red_main" ] || echo "safe-push: blocked by red main ($blocked_by_red_main), not this lane; it can land once a Main-red: lane lands"
  refusals+=("land checks${land_check_skip:+ $land_check_skip}")
fi
command -v betterleaks >/dev/null 2>&1 || { echo "safe-push: betterleaks not on PATH — refusing to push without a secret scan"; exit 1; }
(refuse_dropped_lane_commits) || refusals+=("lane commits dropped by the rebase")
[ "$stale_revert_refused" -eq 1 ] || (refuse_stale_revert) || refusals+=("stale revert of newer main")
if [ "${#refusals[@]}" -eq 0 ] && [ -n "$destination_oid" ] && [ "$destination_oid" = "$head_oid" ]; then
  echo "safe-push: nothing to push ($head_oid already at origin $destination_ref)"
  exit 0
fi
safe_push_event "dependency gate and scans" wait
final_scans
stage "dependency gate and scans"
refuse_collected

revalidate_repository_state
plan_push publication "$head_oid" "$destination_ref" "$destination_oid"
echo "safe-push: ✓ clean (--dry-run) — would push $branch -> origin as $publication"
exit 0
