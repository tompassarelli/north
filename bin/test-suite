#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: bin/test-suite [--sandbox-home] -- COMMAND [ARG ...]

Runs COMMAND unchanged by default. --sandbox-home gives it a newly created,
empty HOME and removes ambient XDG home overrides for the duration of the run.

The invocation is the sole authority on the mode: NORTH_TEST_SANDBOX_HOME
reports this run's mode to COMMAND and is never read back in as input, so a
nested run without --sandbox-home is normal mode even inside a sandboxed one.
EOF
  exit 2
}

sandbox_home=0
if [[ "${1:-}" == "--sandbox-home" ]]; then
  sandbox_home=1
  shift
fi
[[ "${1:-}" == "--" ]] || usage
shift
(($# > 0)) || usage

if ((sandbox_home == 0)); then
  exec env -u NORTH_TEST_SANDBOX_HOME "$@"
fi

scratch="$(mktemp -d -t north-test-home.XXXXXX)"
cleanup() {
  rm -rf "${scratch:?}"
}
trap cleanup EXIT

printf 'sandbox-home: HOME=%s\n' "$scratch"
HOME="$scratch" \
NORTH_TEST_SANDBOX_HOME=1 \
env \
  -u CLAUDE_CONFIG_DIR \
  -u CODEX_HOME \
  -u FRAM_LOG \
  -u FRAM_TELEMETRY_LOG \
  -u FRAM_THREADS \
  -u NORTH_COORD_RUNTIME_STATE \
  -u NORTH_STATE_ROOT \
  -u NORTH_TELEMETRY_PARTITION \
  -u NORTH_TELEMETRY_PORT \
  -u NORTH_TELEMETRY_RUNTIME_STATE \
  -u XDG_CACHE_HOME \
  -u XDG_CONFIG_HOME \
  -u XDG_DATA_HOME \
  -u XDG_STATE_HOME \
  "$@"
