#!/usr/bin/env bash
set -euo pipefail

image=${FARM_RUNNER_IMAGE:-localhost/farm-runner:2.338.0}
owner=${FARM_RUNNER_OWNER:-tompassarelli}
specs=${FARM_RUNNER_SPECS:-smashcraft=3}
state_cache="${XDG_STATE_HOME:-$HOME/.local/state}/laptop-runner/laptop-state.json"

usage() {
  echo "usage: farm-runner run REPO-N | sync | units | status" >&2
  exit 2
}

laptop_state() {
  local s
  s=$(timeout 10 laptop status --json 2>/dev/null | jq -r '.state // empty') || true
  [ -n "$s" ] || s=$(jq -r '.state // empty' "$state_cache" 2>/dev/null) || true
  echo "${s:-unavailable}"
}

units() {
  local spec repo count i
  for spec in $specs; do
    repo=${spec%=*}
    count=${spec#*=}
    for i in $(seq 1 "$count"); do echo "farm-runner@$repo-$i.service"; done
  done
}

case ${1:-} in
  run)
    name=${2:?REPO-N}
    repo=${name%-*}
    if [ "$(laptop_state)" != available ]; then
      sleep 60
      exit 0
    fi
    token=$(gh api -X POST "repos/$owner/$repo/actions/runners/registration-token" --jq .token)
    exec podman run --rm -i --name "farm-$name" --cpus "${FARM_RUNNER_CPUS:-4}" --memory "${FARM_RUNNER_MEMORY:-12g}" \
      "$image" bash -c 'read -r t && ./config.sh --unattended --ephemeral --replace --disableupdate --url "$0" --token "$t" --name "$1" --labels farm-big --work _work >/dev/null && exec ./run.sh' \
      "https://github.com/$owner/$repo" "$(hostname)-$name" <<<"$token"
    ;;
  sync)
    state=$(laptop_state)
    mapfile -t all < <(units)
    case $state in
      available) systemctl --user start "${all[@]}" ;;
      draining) ;;
      *) systemctl --user stop "${all[@]}" ;;
    esac
    ;;
  units) units ;;
  status)
    echo "laptop: $(laptop_state)"
    mapfile -t all < <(units)
    systemctl --user is-active "${all[@]}" | paste <(printf '%s\n' "${all[@]}") - || true
    ;;
  *) usage ;;
esac
