#!/usr/bin/env bash
set -euo pipefail

owner=${FARM_RUNNER_OWNER:-tompassarelli}
specs=${FARM_RUNNER_SPECS:-makgora=3}
slice=${FARM_RUNNER_SLICE:-agent-capacity-farm.slice}
state_cache=${FARM_RUNNER_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/laptop-runner/laptop-state.json}
pool_state=${FARM_RUNNER_POOL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/wisp/lan}
here=$(dirname "$(readlink -f "$0")")
north=${FARM_RUNNER_NORTH:-$here/north}
agent_cpus=${FARM_RUNNER_AGENT_CPUS:-4-11,16-23}
farm_cgroup=${FARM_RUNNER_CGROUP:-/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/agent.slice/agent-capacity.slice/$slice}

usage() {
  echo "usage: farm-runner run REPO-N | sync | units | status" >&2
  exit 2
}

laptop_state() {
  local s
  s=$(jq -r '.state // empty' "$state_cache" 2>/dev/null) || true
  echo "${s:-unavailable}"
}

pool_game_live() {
  [ -n "$(find "$pool_state" -path '*/games/*/actions.log' -newermt '-30 seconds' -print -quit 2>/dev/null)" ]
}

tom_game() {
  "$north" capacity game-reserve playing >/dev/null 2>&1 || [ $? -ne 1 ]
}

game_reserve_hook() {
  "$north" capacity game-reserve auto >/dev/null || echo "farm-runner: game-reserve auto failed" >&2
}

frozen() {
  [ "$(laptop_state)" != available ] || tom_game
}

allowed() {
  ! frozen && ! pool_game_live
}

pin_to_agent_cores() {
  local procs pid
  procs=$(find "$farm_cgroup" -name cgroup.procs 2>/dev/null) || return 0
  for pid in $(cat $procs 2>/dev/null); do
    taskset -a -p -c "$agent_cpus" "$pid" >/dev/null 2>&1 || true
  done
}

units() {
  local spec repo count i
  for spec in $specs; do
    repo=${spec%=*}
    count=${spec#*=}
    for i in $(seq 1 "$count"); do echo "farm-runner@$repo-$i.service"; done
  done
}

containers() {
  podman ps --filter name=farm- --filter "status=$1" --format '{{.Names}}'
}

case ${1:-} in
  run)
    name=${2:?REPO-N}
    repo=${name%-*}
    if ! allowed; then
      sleep 60
      exit 0
    fi
    token=$(gh api -X POST "repos/$owner/$repo/actions/runners/registration-token" --jq .token)
    exec podman run --rm -i --name "farm-$name" --cgroup-parent "$slice" --cpus "${FARM_RUNNER_CPUS:-4}" --memory "${FARM_RUNNER_MEMORY:-12g}" \
      "$("$here/farm-runner-image")" bash -c 'read -r t && ./config.sh --unattended --ephemeral --replace --disableupdate --url "$0" --token "$t" --name "$1" --labels farm-big --work _work >/dev/null && exec nice -n 19 ionice -c 3 ./run.sh' \
      "https://github.com/$owner/$repo" "$(hostname)-$name" <<<"$token"
    ;;
  sync)
    game_reserve_hook
    if frozen; then
      mapfile -t running < <(containers running)
      [ ${#running[@]} -eq 0 ] || podman pause "${running[@]}" >/dev/null
    else
      mapfile -t paused < <(containers paused)
      [ ${#paused[@]} -eq 0 ] || podman unpause "${paused[@]}" >/dev/null
      if pool_game_live; then
        pin_to_agent_cores
      else
        mapfile -t all < <(units)
        systemctl --user start "${all[@]}"
      fi
    fi
    ;;
  units) units ;;
  status)
    echo "laptop: $(laptop_state)$(tom_game && echo ", Tom's game running")$(pool_game_live && echo ', pool game live: draining')"
    podman ps -a --filter name=farm- --format '{{.Names}} {{.State}}'
    ;;
  *) usage ;;
esac
