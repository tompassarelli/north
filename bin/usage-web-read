#!/usr/bin/env python3

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import date, datetime, timezone
from uuid import UUID


def main():
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "agents"
    path = state / "usage/claude-web.json"
    try:
        browser = Path(__file__).resolve().parent / "automation-chrome"
        result = subprocess.run([str(browser), "tool"], input=json.dumps({"action": "usage"}),
                                capture_output=True, text=True, timeout=90)
        if result.returncode:
            raise ValueError("Automation browser failed")
        reply = json.loads(result.stdout)
        if reply.get("error", "").startswith("NEEDS-SIGNIN"):
            print("usage-web-read: NEEDS-SIGNIN: claude.ai; previous cache kept", file=sys.stderr)
            return 1
        reading = reply["result"]
        UUID(reading["account_uuid"])
        account = hashlib.sha256(reading["account_uuid"].encode()).hexdigest()[:8]
        read_at = datetime.fromisoformat(reading["read_at"].replace("Z", "+00:00"))
        if read_at.tzinfo is None:
            raise ValueError("Automation browser returned a time without a timezone")
        resets = {}
        for kind in ("full", "five_hour"):
            grant = reading["resets"][kind]
            count = grant["count"]
            if count is not None and (type(count) is not int or count < 0):
                raise ValueError("Automation browser returned an invalid reset count")
            expires = grant.get("expires")
            if expires:
                date.fromisoformat(expires)
            resets[kind] = {"count": count, "expires": expires}
        if not all(isinstance(reading[k], t) for k, t in (("windows", list), ("resets_text", str))):
            raise ValueError("Automation browser returned invalid page data")
        cache = json.loads(path.read_text()) if path.exists() else {"accounts": {}}
        entries = cache.setdefault("accounts", {})
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness/lib"))
        import usage
        label = usage.account_label("claude", account)
        entry = {"account": account, "read_at": read_at.astimezone(timezone.utc).isoformat().replace("+00:00", "Z"),
                 "resets_available": sum(g["count"] for g in resets.values())
                 if all(g["count"] is not None for g in resets.values()) else None,
                 "resets_text": reading["resets_text"], "windows": reading["windows"], "resets": resets,
                 "source": "claude.ai settings/usage via Chrome"}
        if label:
            entry["account_label"] = label
        entries[account] = entry
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(cache) + "\n")
        tmp.replace(path)
    except subprocess.TimeoutExpired:
        print("usage-web-read: Chrome read timed out after 90 seconds; previous cache kept", file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError, TypeError):
        print("usage-web-read: Chrome read failed or returned invalid data; previous cache kept", file=sys.stderr)
        return 1
    print("usage-web-read: Claude reset availability cached")
    return 0


if __name__ == "__main__":
    sys.exit(main())
