#!/usr/bin/env bash
# Human/internal authoring entrypoint. The ordinary `north` surface fails closed
# to bounded agent reports; this wrapper issues one random, parent-bound
# capability for exactly the child invocation it launches.
set -euo pipefail
umask 077

script_dir="$(cd "$(dirname "$0")" && pwd)"
authority_dir="${XDG_RUNTIME_DIR:-/tmp}/north-thread-write-authority"
mkdir -p "$authority_dir"
capability_file="$(mktemp "$authority_dir/cap.$$.XXXXXX")"
cleanup() {
  rm -f -- "$capability_file"
}
trap cleanup EXIT HUP INT TERM

capability="$(
  od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
)"
[[ "$capability" =~ ^[0-9a-f]{64}$ ]] || {
  echo "north-author: could not mint thread-write capability" >&2
  exit 74
}
printf '%s %s\n' "$$" "$capability" >"$capability_file"
chmod 600 "$capability_file"

NORTH_THREAD_WRITE_CAPABILITY="$capability" \
NORTH_THREAD_WRITE_CAPABILITY_FILE="$capability_file" \
  "$script_dir/north" "$@"
