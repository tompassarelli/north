#!/usr/bin/env python3
"""playtest: reserve laptop capacity for Tom's playtest.

  playtest on [--auto]   move Steam, Battle.net and Warcraft III into playtest.slice on the reserved cores and
                         confine agent.slice to the rest; returns once the split and the moves are applied
  playtest off           give agent.slice every core again; the game stays where it is
  playtest status        exit 0 when on, print both core sets and where Warcraft III runs

The reserve comes from the 14 Oct pool measurement (two clients: 2.7 cores, 2.1 GiB): CCX0 (CPUs 0-3,12-15) and
a 6 GiB memory floor for the game, agents on CCX1 with an 80 GiB cap. Wisp's LAN pool clients (native.slice) and
containers stay in their cgroups; pool client threads are pinned to CCX1 with the agents. Both commands are idempotent. Every game and agent thread is also pinned with
sched_setaffinity, because AllowedCPUs needs the cpuset controller delegated to the user manager; `on` re-pins
agent threads started since the last call.

Inputs for tests: PLAYTEST_PROC (default /proc), PLAYTEST_STATE (default ~/.local/state/playtest/state.json),
PLAYTEST_SYSTEMCTL (default systemctl), PLAYTEST_BUSCTL (default busctl), and PLAYTEST_AFFINITY_LOG, which records
each pin instead of applying it.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

GAME_CPUS = os.environ.get("PLAYTEST_GAME_CPUS") or "0-3,12-15"
AGENT_CPUS = os.environ.get("PLAYTEST_AGENT_CPUS") or "4-11,16-23"
AGENT_MEMORY_MAX = os.environ.get("PLAYTEST_AGENT_MEMORY_MAX") or "80G"
GAME_SLICE = "playtest.slice"
GAME_PROPERTIES = [f"AllowedCPUs={GAME_CPUS}", "CPUWeight=1000", "IOWeight=1000", "MemoryMin=4G", "MemoryLow=6G"]
ROOT_COMMS = {"steam"}
ROOT_ARGS = re.compile(r"Warcraft III\.exe|Battle\.net\.exe|Battle\.net Launcher\.exe")


def env_path(name, default):
    return Path(os.environ.get(name) or default)


def processes(proc):
    table = {}
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text()
            cgroup = (entry / "cgroup").read_text()
            args = (entry / "cmdline").read_text().replace("\0", " ")
        except OSError:
            continue
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        ppid = int(stat[stat.rindex(")") + 2:].split()[1])
        path = next((line.split(":", 2)[2] for line in cgroup.splitlines() if line.startswith("0::")), "")
        table[int(entry.name)] = {"comm": comm, "ppid": ppid, "cgroup": path, "args": args}
    return table


def outside(info):
    cg = info["cgroup"]
    return "/native.slice/" not in cg and "/agent.slice/" not in cg and "libpod" not in cg


def game_tree(table):
    roots = {pid for pid, info in table.items() if outside(info) and (info["comm"] in ROOT_COMMS or ROOT_ARGS.search(info["args"]))}
    children = {}
    for pid, info in table.items():
        children.setdefault(info["ppid"], []).append(pid)
    tree, stack = set(), list(roots)
    while stack:
        pid = stack.pop()
        if pid in tree:
            continue
        tree.add(pid)
        stack.extend(children.get(pid, []))
    return sorted(pid for pid in tree if outside(table[pid]) and GAME_SLICE not in table[pid]["cgroup"].split("/"))


def cpu_set(spec):
    cpus = set()
    for part in spec.split(","):
        lo, _, hi = part.partition("-")
        cpus.update(range(int(lo), int(hi or lo) + 1))
    return cpus


def pin(pids, cpus, proc):
    log = os.environ.get("PLAYTEST_AFFINITY_LOG")
    changed = 0
    for pid in pids:
        if log:
            with open(log, "a") as f:
                f.write(f"pin {pid} {min(cpus)}-{max(cpus)}:{len(cpus)}\n")
            changed += 1
            continue
        try:
            tids = [int(t.name) for t in (proc / str(pid) / "task").iterdir()]
        except OSError:
            continue
        for tid in tids:
            try:
                if os.sched_getaffinity(tid) != cpus:
                    os.sched_setaffinity(tid, cpus)
                    changed += 1
            except OSError:
                pass
    return changed


def run(*args):
    return subprocess.run(list(args), capture_output=True, text=True)


def systemctl(*args):
    return run(os.environ.get("PLAYTEST_SYSTEMCTL") or "systemctl", "--user", *args)


def move(pids):
    unit = f"playtest-{int(time.time())}-{pids[0]}.scope"
    result = run(os.environ.get("PLAYTEST_BUSCTL") or "busctl", "--user", "call", "org.freedesktop.systemd1",
                 "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager", "StartTransientUnit",
                 "ssa(sv)a(sa(sv))", unit, "fail", "2", "PIDs", "au", str(len(pids)), *map(str, pids),
                 "Slice", "s", GAME_SLICE, "0")
    if result.returncode != 0:
        raise SystemExit(f"playtest: moving {len(pids)} game processes failed: {result.stderr.strip()}")


def on(auto):
    proc = env_path("PLAYTEST_PROC", "/proc")
    state = env_path("PLAYTEST_STATE", Path.home() / ".local/state/playtest/state.json")
    result = systemctl("set-property", "--runtime", "agent.slice", f"AllowedCPUs={AGENT_CPUS}", f"MemoryMax={AGENT_MEMORY_MAX}")
    if result.returncode != 0:
        raise SystemExit(f"playtest: confining agent.slice failed: {result.stderr.strip()}")
    table = processes(proc)
    pids = game_tree(table)
    if pids:
        move(pids)
    game = [pid for pid, info in table.items() if GAME_SLICE in info["cgroup"].split("/")] + pids
    agents = [pid for pid, info in table.items() if "/agent.slice/" in info["cgroup"] or "/native.slice/" in info["cgroup"]]
    pinned = pin(game, cpu_set(GAME_CPUS), proc) + pin(agents, cpu_set(AGENT_CPUS), proc)
    result = systemctl("set-property", "--runtime", GAME_SLICE, *GAME_PROPERTIES)
    if result.returncode != 0 and pids:
        raise SystemExit(f"playtest: reserving {GAME_SLICE} failed: {result.stderr.strip()}")
    previous = {}
    try:
        previous = json.loads(state.read_text())
    except (OSError, ValueError):
        pass
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps({"on": True, "auto": auto if not previous.get("on") else previous.get("auto", auto),
                                 "since": previous.get("since") if previous.get("on") else int(time.time())}))
    print(f"playtest on: game CPUs {GAME_CPUS}, agents CPUs {AGENT_CPUS}; moved {len(pids)} game processes, pinned {pinned} threads")
    return 0


def off():
    proc = env_path("PLAYTEST_PROC", "/proc")
    state = env_path("PLAYTEST_STATE", Path.home() / ".local/state/playtest/state.json")
    table = processes(proc)
    every = cpu_set(GAME_CPUS) | cpu_set(AGENT_CPUS)
    pin([pid for pid, info in table.items() if "/agent.slice/" in info["cgroup"] or "/native.slice/" in info["cgroup"]
         or GAME_SLICE in info["cgroup"].split("/")], every, proc)
    result = systemctl("set-property", "--runtime", "agent.slice", "AllowedCPUs=", "MemoryMax=infinity")
    if result.returncode != 0:
        raise SystemExit(f"playtest: releasing agent.slice failed: {result.stderr.strip()}")
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps({"on": False}))
    print("playtest off: agents may use every CPU")
    return 0


def status():
    proc = env_path("PLAYTEST_PROC", "/proc")
    state = env_path("PLAYTEST_STATE", Path.home() / ".local/state/playtest/state.json")
    try:
        current = json.loads(state.read_text())
    except (OSError, ValueError):
        current = {}
    table = processes(proc)
    games = [pid for pid, info in table.items() if "Warcraft III.exe" in info["args"] and "/native.slice/" not in info["cgroup"]]
    placed = [pid for pid in games if GAME_SLICE in table[pid]["cgroup"].split("/")]
    where = f"Warcraft III {len(placed)}/{len(games)} in {GAME_SLICE}" if games else "Warcraft III not running"
    if current.get("on"):
        print(f"playtest on{' (auto)' if current.get('auto') else ''}: game CPUs {GAME_CPUS}, agents CPUs {AGENT_CPUS}; {where}")
        return 0
    print(f"playtest off; {where}")
    return 1


def main(argv):
    command = argv[1] if len(argv) > 1 else ""
    if command == "on":
        return on("--auto" in argv[2:])
    if command == "off":
        return off()
    if command == "status":
        return status()
    print(__doc__.strip().splitlines()[2], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
