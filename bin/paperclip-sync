#!/usr/bin/env -S JSC_numberOfGCMarkers=1 bun --no-install
import { Database } from "bun:sqlite";
import { appendFileSync, mkdirSync, readFileSync, writeFileSync, renameSync, statSync, existsSync, watch, readdirSync } from "node:fs";
import { join, resolve, dirname } from "node:path";
import { homedir } from "node:os";
import { createConnection } from "node:net";
import { titleOnlyRepos, titleOnlyRef, titleOnlyDomain, commentId, desiredState, parseBrief, parseStatusLine, sourceFieldDiff, type DesiredState, type GitHubIssue, type IssueRef, type OrgNode, type ProjectConfig } from "../harness/lib/paperclip-core.ts";
import { boxMetadata, restrictedBoxes, recordAgents, statusBoxes, topologyState, workstreamBrief, type RecordAgent } from "../harness/lib/paperclip-topology.ts";

import { LeadInbox, type LeadMessage, type LeadDelivery, type LeadReply } from "../harness/lib/paperclip-messages.ts";
import { labelledSnapshot } from "../harness/lib/paperclip-labelled.ts";
import { DecisionsInbox, type PendingAnswer } from "../harness/lib/paperclip-decisions.ts";
import { chatText, dialogOpen, inputReady } from "../harness/lib/chat-core.ts";

import { collectSchedules, collectMachineSnapshot } from "../harness/lib/paperclip-schedules.ts";

const usage = `usage: paperclip-sync check
       paperclip-sync run [--once] [--dry-run]
       paperclip-sync ship [--once]
       paperclip-sync receive
       paperclip-sync ask --source KEY [--target KEY] < question.json
       paperclip-sync ask --withdraw ID
       paperclip-sync record --source KEY [--target KEY] < answer.json
       paperclip-sync answers
       paperclip-sync ack ID
PAPERCLIP_SYNC_CONFIG: orchestration.toml (default ~/code/south/main/agents/orchestration.toml)
PAPERCLIP_SYNC_ORG: org.json (default $XDG_STATE_HOME/agents/org.json)
PAPERCLIP_SYNC_INPUT_ROOT: optional root prepended to absolute brief/status paths
PAPERCLIP_SYNC_STATE_DIR: SQLite directory (default $XDG_STATE_HOME/paperclip-sync)
PAPERCLIP_SYNC_ADOPT_FILE: optional explicit project-name/issue-ref UUID seed file (one-time adoption)
PAPERCLIP_SYNC_GITHUB_OWNER: GitHub owner (default authenticated gh user's login)
PAPERCLIP_SYNC_HOLD_REPOS: comma-separated repos excluded except title-only workstreams
PAPERCLIP_SYNC_COLLECTOR_ROOT: complete North checkout for routine/ledger inventory
PAPERCLIP_SYNC_ROUTINES_DIR: optional routine inventory directory
PAPERCLIP_SYNC_LAPTOP_SCHEDULES: received schedules.json path
PAPERCLIP_SYNC_SSH_ARGS: JSON SSH argv including target for ship and schedules
PAPERCLIP_SYNC_REMOTE_COMMAND: receiver command (default paperclip-sync receive)
PAPERCLIP_SYNC_LAPTOP_HOST: laptop receipt hostname
PAPERCLIP_SYNC_PROXY_INBOX: answer inbox path
PAPERCLIP_SYNC_PROXY_PANE: optional socket:session (otherwise SOCRATES_CHAT_PROXY_PANE)
[paperclip].github_body_refs: exact refs authorized for full GitHub body mirroring
[paperclip].github_labels: repo -> labels for source discovery and nonrestricted full bodies
Lead replies: $PAPERCLIP_SYNC_STATE_DIR/lead-replies/<comment-id>.json
Uses gh's existing credentials and [paperclip] url/company; record-only org agents.`;
const stateHome = process.env.XDG_STATE_HOME || join(homedir(), ".local/state");
const configFile = process.env.PAPERCLIP_SYNC_CONFIG || join(homedir(), "code/south/main/agents/orchestration.toml");
const orgFile = process.env.PAPERCLIP_SYNC_ORG || join(stateHome, "agents/org.json");
const stateDir = process.env.PAPERCLIP_SYNC_STATE_DIR || join(stateHome, "paperclip-sync");
const inputPath = (path: string) => process.env.PAPERCLIP_SYNC_INPUT_ROOT ? resolve(process.env.PAPERCLIP_SYNC_INPUT_ROOT, `.${path.startsWith("/") ? path : `/${path}`}`) : path;
const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
type Fields = Record<string, unknown>;
type Kind = "projects" | "issues" | "agents" | "labels";
type Saved = { id: string; fields: string };
const heldRepos = new Set((process.env.PAPERCLIP_SYNC_HOLD_REPOS || "").split(",").map(r => r.trim()).filter(Boolean));
const proseRepos = new Set([...heldRepos, ...titleOnlyRepos]);
const heldRef = (ref: string) => proseRepos.has(ref.replace(/^gh:/, "").split("#")[0]);
const fetchHeldRef = (ref: string) => heldRef(ref) && !titleOnlyRef(ref);
const fetchHeldRepo = (repo: string) => heldRepos.has(repo) && !titleOnlyRepos.has(repo);
function restrictedAliases(org?: { nodes: OrgNode[] }, projects?: Record<string, ProjectConfig>): Set<string> {
  const path = join(stateDir, "restricted-node-ids.json");
  const retained = existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : [];
  const aliases = new Set<string>(Array.isArray(retained) ? retained.filter((id: unknown): id is string => typeof id === "string" && /^[A-Za-z0-9_.-]+$/.test(id)) : []);
  if (!org && existsSync(orgFile)) org = JSON.parse(readFileSync(orgFile, "utf8"));
  if (!org) return aliases;
  projects ??= readConfig().projects;
  const size = aliases.size;
  for (const node of org.nodes.filter(node => heldNode(node, projects!))) aliases.add(node.id);
  if (aliases.size !== size) atomic(path, JSON.stringify([...aliases].sort()));
  return aliases;
}
const heldLine = (line: string, aliases = restrictedAliases()) => (line.match(/[A-Za-z0-9_.-]+#[1-9][0-9]*/g) || []).some(heldRef) || (line.match(/[A-Za-z0-9_.-]+/g) || []).some(name => proseRepos.has(name) || aliases.has(name));
const safeText = (text: string, aliases = restrictedAliases()) => text.split("\n").filter(line => !heldLine(line, aliases)).join("\n");
const heldNode = (node: OrgNode, projects: Record<string, ProjectConfig>) => proseRepos.has(node.domain) || (projects[node.domain]?.repos || []).some(r => proseRepos.has(r));
type ProgressSource = { path: string; node?: OrgNode };
function nodeProgressPaths(node: OrgNode): string[] {
  return [...new Set([node.status_file, join(dirname(node.status_file || node.brief), `${node.id}-peer.md`), (node as any).peer_file, (node as any).peer].filter((v): v is string => typeof v === "string"))];
}
function sourceDiscovery(nodes: OrgNode[], projects: Record<string, ProjectConfig>) {
  const heldPaths = new Set(nodes.filter(n => heldNode(n, projects)).flatMap(n => [n.brief, ...nodeProgressPaths(n)]));
  const safeNodes = nodes.filter(n => !heldNode(n, projects));
  const globalPaths = new Set([join(stateHome, "agents/handoffs/codex-lead-peer.md"), ...safeNodes.map(n => join(dirname(n.status_file || n.brief), "codex-lead-peer.md"))]);
  const progress = new Map<string, ProgressSource>();
  for (const node of safeNodes) for (const path of nodeProgressPaths(node)) if (!heldPaths.has(path) && !globalPaths.has(path) && !progress.has(path)) progress.set(path, { path, node });
  for (const path of globalPaths) if (!heldPaths.has(path)) progress.set(path, { path });
  return { heldPaths, progress: [...progress.values()], paths: [...new Set([...safeNodes.map(n => n.brief).filter(path => !heldPaths.has(path)), ...progress.keys()])] };
}

async function gh(args: string[]): Promise<string> {
  const child = Bun.spawn(["gh", ...args], { stdout: "pipe", stderr: "pipe" });
  const [stdout, stderr, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
  if (code !== 0) throw new Error(`gh ${args[0]} failed (${code}): ${stderr.replace(/(?:gh[pousr]_[A-Za-z0-9_]+|github_pat_[A-Za-z0-9_]+)/g, "[redacted]").slice(0, 1000)}`);
  return stdout;
}

async function snapshots(projects: Record<string, ProjectConfig>, nodes: OrgNode[], briefs: Record<string, string>, previous?: DesiredState, additionalRefs: readonly IssueRef[] = [], labelledOnly = false): Promise<GitHubIssue[]> {
  const bodyRefs = configuredBodyRefs();
  const labelSources = configuredLabelSources();
  const owner = process.env.PAPERCLIP_SYNC_GITHUB_OWNER || (await gh(["api", "user", "--jq", ".login"])).trim();
  if (!/^[A-Za-z0-9_.-]+$/.test(owner)) throw new Error("Invalid GitHub owner");
  const refs = new Set<IssueRef>([
    ...nodes.filter(n => n.state === "active" && n.role !== "worker").flatMap(n => parseBrief(briefs[n.brief] ?? "").refs),
    ...(previous?.trackedRefs ?? []),
    ...(previous?.issues.flatMap(issue => issue.ref && titleOnlyRef(issue.ref) ? [issue.ref] : []) ?? []),
    ...additionalRefs,
  ]);
  const representedRepos = new Set(Object.entries(projects).flatMap(([name, p]) => p.repos ?? [name]).filter(r => !fetchHeldRepo(r)));
  const repos = new Set([...representedRepos].filter(repo => labelledOnly ? repo in labelSources : !process.env.PAPERCLIP_SYNC_INPUT_ROOT || !(repo in labelSources)));
  const representedRef = (ref: string) => representedRepos.has(ref.split("#")[0]);
  const fetchedRef = (ref: string) => repos.has(ref.split("#")[0]);
  for (const ref of refs) if (!fetchedRef(ref)) refs.delete(ref);
  const result = new Map<IssueRef, GitHubIssue>();
  const page = "pageInfo { hasNextPage endCursor }";
  const refFields = "number repository { name }";
  const base = `number title body url state stateReason repository { name } labels(first:100) { nodes { name } ${page} } parent { ${refFields} }`;
  const fields = (repo: string, ref?: IssueRef) => `${titleOnlyRepos.has(repo) && (!ref || !bodyRefs.includes(ref)) ? base.replace("title body url", "title url") : base} subIssues(first:100) { nodes { ${refFields} } ${page} }`;
  const missing = new Set<IssueRef>();
  const toRef = (raw: any): IssueRef => `${raw.repository.name}#${raw.number}`;
  async function query(repo: string, selection: string): Promise<any> {
    if (fetchHeldRepo(repo)) throw new Error("Held GitHub repository reached fetch boundary");
    if (!/^[A-Za-z0-9_.-]+$/.test(repo)) throw new Error(`Invalid GitHub repo: ${repo}`);
    const query = `query { repository(owner:${JSON.stringify(owner)}, name:${JSON.stringify(repo)}) { ${selection} } }`;
    const response = JSON.parse(await gh(["api", "graphql", "-f", `query=${query}`]));
    if (response.errors?.length || !response.data?.repository) throw new Error(`GitHub snapshot failed for ${repo}`);
    return response.data.repository;
  }
  async function normalize(raw: any) {
    if (!raw) return;
    if (raw.labels.pageInfo.hasNextPage) throw new Error(`GitHub label pagination required for ${toRef(raw)}; no partial reconcile performed`);
    if (labelledOnly && !(labelSources[raw.repository.name] ?? []).some(label => raw.labels.nodes.some((item: any) => item.name === label))) { missing.add(toRef(raw)); return; }
    if (bodyRefs.includes(toRef(raw)) && typeof raw.body !== "string") {
      raw = (await query(raw.repository.name, `issue(number:${raw.number}) { ${fields(raw.repository.name, toRef(raw))} }`)).issue;
      if (!raw) throw new Error("Authorized GitHub source disappeared");
    }
    const children = raw.subIssues.nodes.map(toRef).filter((ref: IssueRef) => representedRef(ref));
    let cursor = raw.subIssues.pageInfo.hasNextPage ? raw.subIssues.pageInfo.endCursor : null;
    while (cursor) {
      const extra = await query(raw.repository.name, `issue(number:${raw.number}) { subIssues(first:100,after:${JSON.stringify(cursor)}) { nodes { ${refFields} } ${page} } }`);
      children.push(...extra.issue.subIssues.nodes.map(toRef).filter((ref: IssueRef) => representedRef(ref)));
      cursor = extra.issue.subIssues.pageInfo.hasNextPage ? extra.issue.subIssues.pageInfo.endCursor : null;
    }
    const ref = toRef(raw);
    const parent = raw.parent && representedRef(toRef(raw.parent)) ? toRef(raw.parent) : null;
    result.set(ref, { ref, title: raw.title, body: titleOnlyRef(ref) && !bodyRefs.includes(ref) ? "" : raw.body ?? "", url: raw.url, state: raw.state, stateReason: raw.stateReason,
      labels: raw.labels.nodes.map((l: any) => l.name), parent, subissues: children });
    if (parent && fetchedRef(parent)) refs.add(parent);
    for (const child of children) if (fetchedRef(child)) refs.add(child);
  }
  for (const repo of [...repos].sort()) {
    for (const label of labelSources[repo] ?? ["priority:now"]) {
      let cursor: string | null = null;
      do {
        const repository = await query(repo, `issues(first:100,states:${labelledOnly ? "[OPEN,CLOSED]" : "OPEN"},labels:[${JSON.stringify(label)}]${cursor ? `,after:${JSON.stringify(cursor)}` : ""}) { nodes { ${fields(repo)} } ${page} }`);
        for (const issue of repository.issues.nodes) { refs.add(toRef(issue)); await normalize(issue); }
        cursor = repository.issues.pageInfo.hasNextPage ? repository.issues.pageInfo.endCursor : null;
      } while (cursor);
    }
  }
  while ([...refs].some(ref => !result.has(ref) && !missing.has(ref))) {
    const pending = [...refs].filter(ref => !result.has(ref) && !missing.has(ref));
    const batches = new Map<string, IssueRef[]>();
    for (const ref of pending) {
      const repo = ref.split("#")[0];
      batches.set(repo, [...(batches.get(repo) ?? []), ref]);
    }
    for (const [repo, batch] of batches) for (let offset = 0; offset < batch.length; offset += 50) {
      const chunk = batch.slice(offset, offset + 50);
      const repository = await query(repo, chunk.map((ref, i) => `r${i}: issue(number:${Number(ref.split("#")[1])}) { ${fields(repo, ref)} }`).join("\n"));
      for (const [i, ref] of chunk.entries()) {
        if (repository[`r${i}`]) await normalize(repository[`r${i}`]);
        else missing.add(ref);
      }
    }
  }
  return [...result.values()];
}

async function main(refresh = true) {
  const [command, ...args] = process.argv.slice(2);
  if (!command || command === "--help" || command === "-h") { console.log(usage); return; }
  if (command !== "check" && command !== "run" || command === "check" && args.length || command === "run" && args.some(a => !["--once", "--dry-run"].includes(a))) throw new Error(usage);
  const config = readConfig() as any;
  if (!config.paperclip || typeof config.paperclip.url !== "string" || !uuid.test(config.paperclip.company)) throw new Error("Invalid [paperclip] url/company configuration");
  const url = new URL(config.paperclip.url);
  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash) throw new Error("Invalid Paperclip URL");
  const company = config.paperclip.company as string;
  const root = `/api/companies/${company}`;
  const api = decisionApi();
  if (command === "check") {
    const health = await api("/api/health");
    if (health.status !== "ok") throw new Error("Paperclip health is not ok");
    const companyRecord = await api(root);
    if (companyRecord.id !== company) throw new Error("Paperclip company mismatch");
    for (const kind of ["projects", "issues", "attention"]) {
      const response = await api(`${root}/${kind}`);
      if (kind === "attention" ? response.companyId !== company || !Array.isArray(response.items) : !Array.isArray(response)) throw new Error(`Invalid ${kind} response`);
    }
    console.log("check: 5 endpoints ok");
    return;
  }
  const projects = config.projects as Record<string, ProjectConfig>;
  if (!projects || !Object.keys(projects).length) throw new Error("Missing projects configuration");
  for (const [name, p] of Object.entries(projects)) {
    if (!Number.isFinite(p.priority) || p.repos && (!Array.isArray(p.repos) || p.repos.some(r => typeof r !== "string"))) throw new Error(`Invalid project configuration: ${name}`);
    if (p.target instanceof Date) p.target = p.target.toISOString();
  }
  const org = JSON.parse(readFileSync(orgFile, "utf8"));
  if (org.version !== 1 || !Array.isArray(org.nodes)) throw new Error("Invalid org snapshot");
  const heldLeadIds = new Set<string>(org.nodes.filter((n: OrgNode) => heldNode(n, projects) && !titleOnlyDomain(n, projects)).map((n: OrgNode) => n.id));
  const nodes: OrgNode[] = org.nodes.filter((n: OrgNode) => ["lead", "sub-lead", "worker"].includes(n.role) && !heldLeadIds.has(n.id));
  const briefs: Record<string, string> = {};
  const statuses: Record<string, string> = {};
  for (const node of nodes) {
    if (typeof node.id !== "string" || typeof node.domain !== "string" || typeof node.brief !== "string" || !["active", "finished"].includes(node.state)) throw new Error("Invalid org node");
    if (node.role !== "worker" && titleOnlyDomain(node, projects)) {
      node.boxes = process.env.PAPERCLIP_SYNC_INPUT_ROOT ? boxMetadata(node.boxes) : restrictedBoxes(existsSync(node.brief) ? readFileSync(node.brief, "utf8") : "", existsSync(node.status_file) ? readFileSync(node.status_file, "utf8") : "");
      continue;
    }
    if (node.role !== "worker") briefs[node.brief] = safeText(readFileSync(inputPath(node.brief), "utf8"));
    if (node.role !== "worker" && existsSync(inputPath(node.status_file))) statuses[node.status_file] = safeText(readFileSync(inputPath(node.status_file), "utf8"));
  }
  const dryRun = args.includes("--dry-run");
  mkdirSync(stateDir, { recursive: true, mode: 0o700 });
  const db = new Database(join(stateDir, "state.db"));
  try {
    db.exec("PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000; CREATE TABLE IF NOT EXISTS sync_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS sync_objects (key TEXT PRIMARY KEY, kind TEXT NOT NULL, id TEXT NOT NULL, fields TEXT NOT NULL)");
    const getMeta = db.query("SELECT value FROM sync_meta WHERE key = ?");
    const putMeta = db.query("INSERT INTO sync_meta(key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value");
    const identity = JSON.stringify([url.origin, company]);
    const savedIdentity = getMeta.get("instance") as { value: string } | null;
    if (savedIdentity && savedIdentity.value !== identity) throw new Error("State database belongs to another Paperclip instance/company");
    if (!savedIdentity && !dryRun) putMeta.run("instance", identity);
    const prior = getMeta.get("desired") as { value: string } | null;
    let previous = prior ? JSON.parse(prior.value) as DesiredState : undefined;
    const [remoteIssues, remoteLabels] = await Promise.all([api(`${root}/issues`), api(`${root}/labels`)]);
    if (!Array.isArray(remoteIssues) || !Array.isArray(remoteLabels)) throw new Error("Invalid issues or labels response");
    const remoteIssuesById = new Map<string, any>(remoteIssues.map((issue: any) => [issue.id, issue]));
    if (process.env.PAPERCLIP_SYNC_ADOPT_FILE && !getMeta.get("adopted")) {
      const remoteProjects = await api(`${root}/projects`);
      const adoptedRefs: IssueRef[] = [];
      for (const line of readFileSync(process.env.PAPERCLIP_SYNC_ADOPT_FILE, "utf8").split(/\r?\n/)) {
        if (!line.trim() || line.startsWith("goal ")) continue;
        const [name, objectId, extra] = line.trim().split(/\s+/);
        if (extra || !uuid.test(objectId)) throw new Error("Invalid adoption record");
        const isIssue = /^[A-Za-z0-9_.-]+#[1-9][0-9]*$/.test(name);
        const kind = isIssue ? "issues" : "projects";
        const record = (isIssue ? remoteIssues : remoteProjects).find((r: any) => r.id === objectId);
        if (!record || (isIssue ? !record.title.startsWith(`${name} `) : record.name !== (projects[name]?.name ?? name))) throw new Error(`Adoption identity mismatch: ${name}`);
        const key = isIssue ? `gh:${name}` : `north:project:${name}`;
        if (!dryRun) db.query("INSERT OR IGNORE INTO sync_objects(key,kind,id,fields) VALUES (?,?,?,?)").run(key, kind, objectId, "{}");
        if (isIssue) adoptedRefs.push(name as IssueRef);
      }
      previous = previous ?? { projects: [], issues: [], trackedRefs: adoptedRefs };
      if (!dryRun) putMeta.run("adopted", "true");
    }
    previous = previous ?? { projects: [], issues: [], trackedRefs: (db.query("SELECT key FROM sync_objects WHERE kind='issues'").all() as { key: string }[]).filter(r => r.key.startsWith("gh:")).map(r => r.key.slice(3) as IssueRef) };
    const cached = getMeta.get("github") as { value: string } | null;
    const additionalRefs = [...new Set([...configuredBodyRefs(), ...nodes.filter(n => n.role !== "worker" && n.state === "active").flatMap(node => (titleOnlyDomain(node, projects) ? boxMetadata(node.boxes) : statusBoxes(statuses[node.status_file] ?? "", workstreamBrief(briefs[node.brief] ?? "").boxes).boxes).flatMap(box => box.ref ? [box.ref] : []))])].filter(ref => !fetchHeldRef(ref));
    const cachedGithub = cached ? JSON.parse(cached.value) as GitHubIssue[] : [];
    const needSnapshots = refresh || !cached || Object.entries(projects).some(([domain, config]) => (config.repos ?? [domain]).some(repo => titleOnlyRepos.has(repo))) || additionalRefs.some(ref => !cachedGithub.some(issue => issue.ref === ref));
    const publicGithub = needSnapshots ? await snapshots(projects, nodes, briefs, previous, additionalRefs) : cachedGithub.filter(issue => !process.env.PAPERCLIP_SYNC_INPUT_ROOT || !(issue.ref.split("#")[0] in configuredLabelSources()));
    const labelledGithub = process.env.PAPERCLIP_SYNC_INPUT_ROOT && Object.keys(configuredLabelSources()).length ? labelledSnapshot(JSON.parse(readFileSync(join(snapshotRoot, "label-github.json"), "utf8")), projects, configuredLabelSources(), configuredBodyRefs()) : [];
    const combined = new Map([...publicGithub, ...labelledGithub].filter(g => !fetchHeldRef(g.ref)).map(issue => [issue.ref, issue]));
    const github = [...combined.values()].map(g => ({ ...g, parent: g.parent && combined.has(g.parent) ? g.parent : null, subissues: g.subissues?.filter(ref => combined.has(ref)), ...(titleOnlyRef(g.ref) && !configuredBodyRefs().includes(g.ref) ? { body: "" } : {}) }));
    if (!dryRun && (needSnapshots || process.env.PAPERCLIP_SYNC_INPUT_ROOT && Object.keys(configuredLabelSources()).length)) putMeta.run("github", JSON.stringify(github));
    const finished = getMeta.get("finished") as { value: string } | null;
    const finishedLeadIds: string[] = finished ? JSON.parse(finished.value) : [];
    const labels = configuredLabelSources();
    const fullBodyRefs = github.filter(issue => configuredBodyRefs().includes(issue.ref) || !titleOnlyRef(issue.ref) && (labels[issue.ref.split("#")[0]] ?? []).some(label => issue.labels.includes(label))).map(issue => issue.ref);
    additionalRefs.push(...fullBodyRefs.filter(ref => !additionalRefs.includes(ref)));
    const coreInput = { projects, nodes, briefs, github, previous, finishedLeadIds, additionalRefs, fullBodyRefs };
    const { desired, unknown } = topologyState(desiredState(coreInput), { ...coreInput, statuses });
    if (unknown) console.error(`topology: ${unknown} unparseable status lines; previous box states retained`);
    const heldIssue = (issue: DesiredState["issues"][number]) => !!(issue.ref && fetchHeldRef(issue.ref) || (issue.leadId || issue.assigneeNodeId) && (heldLeadIds.has((issue.leadId || issue.assigneeNodeId)!) || !!issue.projectKey && (projects[issue.projectKey.replace("north:project:", "")]?.repos || [issue.projectKey.replace("north:project:", "")]).some(r => fetchHeldRepo(r))));
    for (const issue of desired.issues) {
      const node = org.nodes.find((node: OrgNode) => node.id === (issue.leadId || issue.assigneeNodeId));
      const domain = titleOnlyDomain(node ?? { domain: issue.projectKey?.replace("north:project:", "") ?? "" } as OrgNode, projects);
      if (issue.ref && titleOnlyRef(issue.ref)) {
        const live = github.find(g => g.ref === issue.ref);
        issue.title = live?.title ?? ""; issue.description = live ? fullBodyRefs.includes(issue.ref) ? `${live.url}\n\n${live.body}` : live.url : "";
      } else if (domain && !issue.ref) {
        issue.title = issue.leadId ? `${issue.leadId}: ${domain} workstream` : issue.boxId ?? "current";
        issue.description = "";
      }
    }
    const safeIssues = desired.issues.filter(i => !heldIssue(i));
    for (const issue of safeIssues) if (issue.parentKey && fetchHeldRef(issue.parentKey)) delete issue.parentKey;
    const getObject = db.query("SELECT id,fields FROM sync_objects WHERE key=? AND kind=?");
    const putObject = db.query("INSERT INTO sync_objects(key,kind,id,fields) VALUES (?,?,?,?) ON CONFLICT(key) DO UPDATE SET id=excluded.id,fields=excluded.fields");
    const ids = new Map<string, string>();
    let writes = 0;
    async function push(kind: Kind, key: string, fields: Fields) {
      const saved = getObject.get(key, kind) as Saved | null;
      if (saved) ids.set(key, saved.id);
      const oldFields = saved ? JSON.parse(saved.fields) : {};
      const observedLabels = saved && kind === "issues" && "labelIds" in fields ? remoteIssuesById.get(saved.id)?.labelIds : undefined;
      const patch = sourceFieldDiff(fields, Array.isArray(observedLabels) ? { ...oldFields, labelIds: [...new Set(observedLabels)].sort() } : oldFields);
      if (kind === "issues" && patch.status === "blocked") patch.unblockDescriptor = fields.unblockDescriptor;
      if (saved && !Object.keys(patch).length) return;
      writes++;
      if (dryRun) { if (!saved) ids.set(key, `dry-run:${key}`); return; }
      let record;
      if (saved) record = await api(`/api/${kind}/${saved.id}`, "PATCH", patch);
      else if (kind === "agents") {
        const { status, ...createFields } = fields;
        record = await api(`${root}/agents`, "POST", createFields);
        if (status !== "active") record = await api(`/api/agents/${record.id}`, "PATCH", { status });
      } else record = await api(`${root}/${kind}`, "POST", { ...(kind === "issues" ? { assigneeAgentId: null, assigneeUserId: null, allowDuplicate: true } : {}), ...fields, idempotencyKey: kind === "issues" ? commentId("north:sync:identity", key) : key.length > 255 ? commentId("north:sync", key) : key });
      if (!uuid.test(record.id) || record.companyId !== company) throw new Error(`Invalid ${kind} write response`);
      ids.set(key, record.id);
      putObject.run(key, kind, record.id, JSON.stringify({ ...oldFields, ...patch }));
    }
    function id(key: string) {
      const value = ids.get(key);
      if (!value) throw new Error(`Unresolved relationship ${key}`);
      return value;
    }
    const remoteAgents = await api(`${root}/agents`);
    if (!Array.isArray(remoteAgents)) throw new Error("Invalid agents response");
    const plato = remoteAgents.find((agent: any) => agent.name === "Plato" && !agent.metadata?.northOrgId);
    if (!plato || !uuid.test(plato.id)) throw new Error("Plato root agent not found");
    const knownAgents: RecordAgent[] = [];
    for (const agent of remoteAgents) {
      const nodeId = agent.metadata?.northOrgId;
      if (typeof nodeId !== "string") continue;
      const key = `north:agent:${nodeId}`;
      if (!getObject.get(key, "agents") && !dryRun) putObject.run(key, "agents", agent.id, "{}");
      ids.set(key, agent.id);
      knownAgents.push({ key, nodeId, parentId: remoteAgents.find((parent: any) => parent.id === agent.reportsTo)?.metadata?.northOrgId, name: agent.name, title: agent.title ?? "", status: "paused" });
    }
    for (const row of db.query("SELECT key,id,fields FROM sync_objects WHERE kind='agents'").all() as { key: string; id: string; fields: string }[]) {
      ids.set(row.key, row.id);
      const nodeId = row.key.replace(/^north:agent:/, "");
      if (!knownAgents.some(agent => agent.nodeId === nodeId)) {
        const fields = JSON.parse(row.fields);
        knownAgents.push({ key: row.key, nodeId, name: fields.name ?? nodeId, title: fields.title ?? "", parentId: knownAgents.find(agent => ids.get(agent.key) === fields.reportsTo)?.nodeId, status: "paused" });
      }
    }
    const agents = recordAgents(org.nodes, knownAgents, finishedLeadIds);
    for (const agent of agents) await push("agents", agent.key, {
      name: agent.name, title: agent.title, role: "general", adapterType: "http", adapterConfig: {},
      runtimeConfig: { heartbeat: { enabled: false, wakeOnDemand: false, wakeOnAssignment: false } },
      metadata: { northOrgId: agent.nodeId }, status: agent.status,
    });
    for (const agent of agents) {
      const remote = remoteAgents.find((record: any) => record.id === ids.get(agent.key));
      const saved = getObject.get(agent.key, "agents") as Saved | null;
      const retainedParent = remote?.reportsTo ?? (saved ? JSON.parse(saved.fields).reportsTo : null);
      await push("agents", agent.key, { reportsTo: agent.parentId && ids.has(`north:agent:${agent.parentId}`) ? id(`north:agent:${agent.parentId}`) : !org.nodes.some((node: OrgNode) => node.id === agent.nodeId) && retainedParent ? retainedParent : plato.id });
    }
    for (const { key, ...fields } of desired.projects) if (!(projects[key.replace("north:project:", "")]?.repos || [key.replace("north:project:", "")]).some(r => fetchHeldRepo(r))) await push("projects", key, fields);
    for (const issue of safeIssues) {
      const { key, ref, leadId, assigneeNodeId, boxId, projectKey, parentKey, ...fields } = issue;
      const activeLeads = nodes.filter(n => n.state === "active" && n.role !== "worker" && (leadId === n.id || ref && parseBrief(briefs[n.brief] ?? "").refs.includes(ref))).map(n => n.id);
      const issueDomain = projectKey?.replace("north:project:", "") ?? "";
      const restrictedDomain = titleOnlyDomain(nodes.find(n => n.id === (leadId || assigneeNodeId)) ?? { domain: issueDomain } as OrgNode, projects);
      const restricted = !!(ref && titleOnlyRef(ref) || restrictedDomain);
      if (restricted && ref && !github.some(g => g.ref === ref)) continue;
      if (restricted && !ref) fields.title = leadId ? `${leadId}: ${restrictedDomain} workstream` : boxId ?? "current";
      else if (leadId && !restricted) fields.title = fields.title.replace(/^\[[0-9]+\/[0-9]+\]\s*/, "");
      const safeFields = ref && fullBodyRefs.includes(ref) ? fields : restricted ? { ...fields, description: ref ? github.find(g => g.ref === ref)?.url ?? "" : "" } : { ...fields, title: safeText(fields.title), description: safeText(fields.description) };
      const rest = fields.status === "in_progress" && !assigneeNodeId ? { ...safeFields, status: "todo", description: restricted ? safeFields.description : `${safeFields.description}\n\nActive lead: ${activeLeads.join(", ")}` } : safeFields;
      const savedAssignment = getObject.get(key, "issues") as Saved | null;
      const assignmentAllowed = !assigneeNodeId || ["active", "error"].includes(agents.find(agent => agent.nodeId === assigneeNodeId)?.status ?? "paused") || !!savedAssignment && JSON.parse(savedAssignment.fields).assigneeAgentId === ids.get(`north:agent:${assigneeNodeId}`);
      await push("issues", key, { ...rest, projectId: projectKey ? id(projectKey) : null,
        ...(assigneeNodeId && assignmentAllowed ? { assigneeAgentId: id(`north:agent:${assigneeNodeId}`), assigneeUserId: null } : {}),
        unblockDescriptor: rest.status === "blocked" ? { owner: "board", action: restricted ? `Update box ${boxId ?? ref ?? "current"}.` : `Resolve the blocker recorded for ${safeText(rest.title)}.` } : null });
    }
    for (const { key, parentKey, ref } of safeIssues) {
      if (ref && titleOnlyRef(ref) && !github.some(g => g.ref === ref)) continue;
      const saved = getObject.get(key, "issues") as Saved | null;
      if (parentKey) await push("issues", key, { parentId: id(parentKey) });
      else if (ref && github.some(g => g.ref === ref) && saved && JSON.parse(saved.fields).parentId) await push("issues", key, { parentId: null });
    }
    if (!dryRun) {
      const currentIssues = await api(`${root}/issues`);
      if (!Array.isArray(currentIssues)) throw new Error("Invalid issues response");
      remoteIssuesById.clear();
      for (const issue of currentIssues) remoteIssuesById.set(issue.id, issue);
    }
    const managedLabelIds = new Set<string>((db.query("SELECT id FROM sync_objects WHERE kind='labels' AND key LIKE 'north:progress:%'").all() as { id: string }[]).map(row => row.id));
    for (const label of remoteLabels) if (/^progress: [0-9]+\/[0-9]+ done$/.test(label.name)) managedLabelIds.add(label.id);
    for (const parent of safeIssues.filter(issue => (issue.leadId || issue.ref && github.some(source => source.ref === issue.ref && (source.subissues?.length || configuredBodyRefs().includes(issue.ref!)))) && nodes.some(node => node.id === (issue.assigneeNodeId ?? issue.leadId) && node.state === "active"))) {
      const children = dryRun ? safeIssues.filter(issue => issue.parentKey === parent.key && ids.has(issue.key)) : [...remoteIssuesById.values()].filter(issue => issue.parentId === id(parent.key));
      const ratio = `${children.filter(issue => issue.status === "done").length}/${children.length}`;
      const key = `north:progress:${ratio}`;
      const fields = { name: `progress: ${ratio} done`, color: "#bfdbfe" };
      const existing = remoteLabels.find((label: any) => label.name === fields.name);
      if (existing && !getObject.get(key, "labels")) {
        if (!uuid.test(existing.id) || existing.companyId !== company) throw new Error("Invalid progress label response");
        ids.set(key, existing.id);
        if (!dryRun) putObject.run(key, "labels", existing.id, JSON.stringify(fields));
      } else await push("labels", key, fields);
      const labelId = id(key);
      managedLabelIds.add(labelId);
      const currentLabels = remoteIssuesById.get(id(parent.key))?.labelIds ?? [];
      if (!Array.isArray(currentLabels)) throw new Error("Invalid parent labelIds response");
      await push("issues", parent.key, { labelIds: [...new Set([...currentLabels.filter((labelId: string) => !managedLabelIds.has(labelId)), labelId])].sort() });
    }
    if (refresh) {
      const schedules = await collectSchedules({ root: process.env.PAPERCLIP_SYNC_COLLECTOR_ROOT, routinesDir: process.env.PAPERCLIP_SYNC_ROUTINES_DIR, laptopSnapshotPath: process.env.PAPERCLIP_SYNC_LAPTOP_SCHEDULES });
      await push("projects", schedules.project.key, { name: schedules.project.name });
      for (const { key, ...fields } of schedules.rows) await push("issues", key, { ...fields, projectId: id(schedules.project.key), unblockDescriptor: fields.status === "blocked" ? { owner: "board", action: `Restore ${fields.title} and verify its next successful run.` } : null });
    }
    if (!dryRun) {
      await new LeadInbox(api, db).closures([...remoteIssuesById.values()], new Set(safeIssues.flatMap(issue => ids.has(issue.key) ? [id(issue.key)] : [])));
      putMeta.run("desired", JSON.stringify(desired));
      const trackedRefs = desired.trackedRefs.filter(r => !heldRef(r));
      for (const { path: source, node } of sourceDiscovery(org.nodes, projects).progress) {
        const nodeId = node?.id ?? "codex-lead";
        const parseLine = (line: string) => {
          const comment = heldLine(line) ? null : parseStatusLine(nodeId, line, trackedRefs, node ? briefs[node.brief] ?? "" : "");
          return !node && comment && !comment.targetKey.startsWith("gh:") ? null : comment;
        };
        const file = inputPath(source);
        if (!existsSync(file)) continue;
        const data = readFileSync(file);
        const offsetKey = `offset:${node ? node.id : "global"}:${source}`;
        const saved = getMeta.get(offsetKey) as { value: string } | null;
        const priorOffset = saved ? JSON.parse(saved.value) : null;
        const digest = (offset: number) => Bun.hash(data.subarray(0, offset)).toString();
        let offset = priorOffset && priorOffset.offset <= data.length && digest(priorOffset.offset) === priorOffset.digest ? priorOffset.offset : 0;
        if (!saved) {
          for (const line of data.toString().split(/\r?\n/)) {
            const comment = parseLine(line);
            if (comment) putMeta.run(`comment:${comment.clientRequestId}`, "initial-history");
          }
          offset = data.length;
        }
        while (offset < data.length) {
          const end = data.indexOf(10, offset);
          if (end < 0) break;
          const line = data.subarray(offset, end).toString().replace(/\r$/, "");
          const comment = parseLine(line);
          if (comment && !getMeta.get(`comment:${comment.clientRequestId}`)) {
            const target = getObject.get(comment.targetKey, "issues") as Saved | null;
            if (!target) throw new Error(`Unresolved comment target ${comment.targetKey}`);
            const response = await api(`/api/issues/${target.id}/comments`, "POST", {
              body: comment.body, clientRequestId: comment.clientRequestId,
              presentation: comment.presentation, metadata: { version: 1, sections: [{ rows: comment.metadata.map(m => ({ type: "key_value", label: m.key, value: m.value })) }] },
            });
            if (!uuid.test(response.id)) throw new Error("Invalid comment response");
            db.transaction(() => {
              putMeta.run(`comment:${comment.clientRequestId}`, JSON.stringify({ id: response.id }));
              if (node && comment.finishedLead && !finishedLeadIds.includes(node.id)) {
                finishedLeadIds.push(node.id); putMeta.run("finished", JSON.stringify(finishedLeadIds));
              }
            })();
            if (node && comment.finishedLead) {
              const lead = safeIssues.find(i => i.leadId === node.id);
              if (lead) { await push("issues", lead.key, { status: "done" }); lead.status = "done"; }
              putMeta.run("desired", JSON.stringify(desired));
            }
          }
          offset = end + 1;
          putMeta.run(offsetKey, JSON.stringify({ offset, digest: digest(offset) }));
        }
        if (!saved) putMeta.run(offsetKey, JSON.stringify({ offset, digest: digest(offset) }));
      }
      heartbeat(null);
    }
    console.log(JSON.stringify({ dryRun, projects: desired.projects.length, issues: desired.issues.length, github: github.length, writes }));
  } finally { db.close(); }
}

function decisionApi() {
  const config = readConfig();
  if (!config.paperclip || !uuid.test(config.paperclip.company)) throw new Error("Invalid [paperclip] configuration");
  const url = new URL(config.paperclip.url);
  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash) throw new Error("Invalid Paperclip URL");
  return async function api(path: string, method = "GET", body?: Fields): Promise<any> {
    const response = await fetch(new URL(path, url), { method, headers: { "Content-Type": "application/json" }, ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(30000) });
    if (!response.ok) {
      const detail = await response.json().catch(() => ({})) as { error?: string };
      throw new Error(`Paperclip ${method} ${path}: HTTP ${response.status}${typeof detail.error === "string" ? ` (${detail.error})` : ""}`);
    }
    return response.json();
  };
}
async function decisions<T>(action: (inbox: DecisionsInbox, db: Database) => Promise<T> | T, fallback = false): Promise<T> {
  mkdirSync(stateDir, { recursive: true, mode: 0o700 });
  const db = new Database(join(stateDir, "state.db"));
  try {
    db.exec("PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000; CREATE TABLE IF NOT EXISTS sync_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS sync_objects (key TEXT PRIMARY KEY, kind TEXT NOT NULL, id TEXT NOT NULL, fields TEXT NOT NULL)");
    const config = readConfig();
    const identity = JSON.stringify([new URL(config.paperclip.url).origin, config.paperclip.company]);
    const saved = db.query("SELECT value FROM sync_meta WHERE key='instance'").get() as { value: string } | null;
    if (saved && saved.value !== identity) throw new Error("State database belongs to another Paperclip instance/company");
    db.query("INSERT OR IGNORE INTO sync_meta(key,value) VALUES ('instance',?)").run(identity);
    const api = decisionApi();
    const targets = Object.fromEntries((db.query("SELECT key,id FROM sync_objects WHERE kind='issues'").all() as { key: string; id: string }[]).map(r => [r.key, r.id]));
    if (fallback && !targets["north:decisions"]) {
      const record = await api(`/api/companies/${config.paperclip.company}/issues`, "POST", { title: "Decisions for Tom", status: "todo", assigneeAgentId: null, assigneeUserId: null, idempotencyKey: "north:decisions" });
      if (!uuid.test(record.id) || record.companyId !== config.paperclip.company) throw new Error("Invalid decisions issue");
      db.query("INSERT OR IGNORE INTO sync_objects(key,kind,id,fields) VALUES ('north:decisions','issues',?,?)").run(record.id, JSON.stringify({ title: "Decisions for Tom", status: "todo" }));
      targets["north:decisions"] = record.id;
    }
    return await action(new DecisionsInbox(api, db, targets, "north:decisions"), db);
  } finally { db.close(); }
}
async function decisionCommand(command: string, args: string[]) {
  if (command === "answers" && !args.length) return decisions(inbox => inbox.pendingAnswers());
  if (command === "ack" && args.length === 1) return decisions(inbox => ({ acknowledged: inbox.ackDelivered(args[0]) }));
  if (command === "ask" && args[0] === "--withdraw" && args.length === 2) return decisions(async inbox => ({ status: await inbox.withdraw(args[1]) }));
  const options: Record<string, string> = {};
  for (let i = 0; i < args.length; i += 2) {
    if (!["--source", "--target"].includes(args[i]) || !args[i + 1] || options[args[i]]) throw new Error(usage);
    options[args[i]] = args[i + 1];
  }
  if (!options["--source"] || !["ask", "record"].includes(command)) throw new Error(usage);
  const input = JSON.parse(await Bun.stdin.text());
  if (heldLine([JSON.stringify(input), options["--source"] ?? "", options["--target"] ?? ""].join("\n")) || heldRef(options["--target"] || "") || heldRepos.has(options["--source"])) throw new Error("Decision is held by repository restriction");
  if (command === "record" && typeof input.answer !== "string") throw new Error("Expected {input,answer} JSON");
  return decisions(inbox => command === "ask" ? inbox.ask(options["--source"], input, options["--target"]) : inbox.record(options["--source"], input.input, input.answer, options["--target"]), !options["--target"]);
}
function receipts(db: Database) {
  db.exec("CREATE TABLE IF NOT EXISTS paperclip_answer_receipts (id TEXT PRIMARY KEY, pane_delivered INTEGER NOT NULL DEFAULT 0)");
  return db.query("SELECT id FROM paperclip_answer_receipts WHERE pane_delivered=1").all() as { id: string }[];
}
async function deliverAnswers(answers: PendingAnswer[]) {
  await decisions(async (_, db) => {
    receipts(db);
    const path = process.env.PAPERCLIP_SYNC_PROXY_INBOX || join(stateHome, "agents/handoffs/proxy-inbox.md");
    for (const answer of answers) {
      if (typeof answer.id !== "string" || typeof answer.line !== "string" || heldLine(JSON.stringify(answer))) continue;
      const marker = `<!-- paperclip-answer:${encodeURIComponent(answer.id)} -->`;
      const text = existsSync(path) ? readFileSync(path, "utf8") : "";
      if (!text.includes(marker)) {
        mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
        appendFileSync(path, `${marker}\n${chatText(answer.line)}\n`, { mode: 0o600 });
      }
      db.query("INSERT OR IGNORE INTO paperclip_answer_receipts(id) VALUES (?)").run(answer.id);
      const row = db.query("SELECT pane_delivered FROM paperclip_answer_receipts WHERE id=?").get(answer.id) as { pane_delivered: number };
      if (row.pane_delivered) continue;
      const route = process.env.PAPERCLIP_SYNC_PROXY_PANE || process.env.SOCRATES_CHAT_PROXY_PANE;
      if (!route || !route.includes(":")) continue;
      const split = route.indexOf(":");
      const socket = route.slice(0, split), target = route.slice(split + 1);
      const terminal = (command: string, args: string[] = []) => Bun.spawnSync(["tmux", "-L", socket, command, "-t", target, ...args], { stdout: "pipe", stderr: "ignore" });
      const pane = terminal("capture-pane", ["-p"]);
      if (pane.exitCode || dialogOpen(pane.stdout.toString()) || !inputReady(pane.stdout.toString())) continue;
      const buffer = `paperclip-answer-${process.pid}`;
      if (Bun.spawnSync(["tmux", "-L", socket, "load-buffer", "-b", buffer, "-"], { stdin: Buffer.from(chatText(answer.line)), stderr: "ignore" }).exitCode) continue;
      if (terminal("paste-buffer", ["-p", "-d", "-b", buffer]).exitCode) continue;
      await Bun.sleep(150);
      if (terminal("send-keys", ["Enter"]).exitCode) continue;
      db.query("UPDATE paperclip_answer_receipts SET pane_delivered=1 WHERE id=?").run(answer.id);
    }
  });
}
let exchangePending = Promise.resolve();
async function exchange(bundle: any) {
  const previous = exchangePending;
  let release!: () => void;
  exchangePending = new Promise<void>(resolve => { release = resolve; });
  await previous;
  try {
  const acks = await decisions((_, db) => receipts(db).map(row => row.id));
  const leadExchange = await localLeadExchange();
  const argv = JSON.parse(process.env.PAPERCLIP_SYNC_SSH_ARGS || "[]");
  if (!Array.isArray(argv) || !argv.length || argv.some(a => typeof a !== "string")) throw new Error("PAPERCLIP_SYNC_SSH_ARGS must be a JSON SSH argument array including target");
  const request = async (payload: any) => {
    const child = Bun.spawn(["ssh", ...argv, process.env.PAPERCLIP_SYNC_REMOTE_COMMAND || "paperclip-sync receive"], { stdin: "pipe", stdout: "pipe", stderr: "pipe", timeout: 30000 });
    child.stdin.write(JSON.stringify(payload)); child.stdin.end();
    const [code, stdout, stderr] = await Promise.all([child.exited, new Response(child.stdout).text(), new Response(child.stderr).text()]);
    if (code) throw new Error(`Snapshot SSH failed (${code}): ${stderr.slice(0, 500)}`);
    const response = JSON.parse(stdout);
    if (response.version !== 1 || !Array.isArray(response.answers)) throw new Error("Invalid answer exchange");
    return response;
  };
  const response = await request({ ...bundle, acks, ...leadExchange });
  await deliverAnswers(response.answers);
  await deliverLeadMessages(response.messages ?? []);
  await acknowledgeLeadReplies(response.replyAcks ?? []);
  const delivered = await decisions((_, db) => receipts(db).map(row => row.id));
  const leadUpdates = await localLeadExchange();
  if (delivered.some(id => !acks.includes(id)) || JSON.stringify(leadUpdates) !== JSON.stringify(leadExchange)) {
    const acknowledgment = await request({ version: 1, decisionExchange: true, acks: delivered, ...leadUpdates });
    await acknowledgeLeadReplies(acknowledgment.replyAcks ?? []);
  }
  } finally { release(); }
}

function configuredBodyRefs(): IssueRef[] {
  const refs = readConfig().paperclip.github_body_refs ?? [];
  if (!Array.isArray(refs) || refs.some(ref => typeof ref !== "string" || !/^[A-Za-z0-9_.-]+#[1-9][0-9]*$/.test(ref))) throw new Error("Invalid authorized GitHub body refs");
  return refs;
}
function configuredLabelSources(): Record<string, string[]> {
  const labels = readConfig().paperclip.github_labels ?? {};
  if (!labels || typeof labels !== "object" || Array.isArray(labels) || Object.entries(labels).some(([repo, values]) => !/^[A-Za-z0-9_.-]+$/.test(repo) || !Array.isArray(values) || values.some(value => typeof value !== "string" || !value.trim()))) throw new Error("Invalid configured GitHub label sources");
  return labels;
}
function readConfig(): any {
  const text = readFileSync(configFile, "utf8");
  return configFile.endsWith(".json") ? JSON.parse(text) : Bun.TOML.parse(text);
}
function atomic(path: string, data: string) {
  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
  const temporary = `${path}.${process.pid}.tmp`;
  writeFileSync(temporary, data, { mode: 0o600 }); renameSync(temporary, path);
}
function heartbeat(error: string | null) {
  const path = join(stateDir, "heartbeat.json");
  const old = existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : {};
  const shipment = process.env.PAPERCLIP_SYNC_INPUT_ROOT ? join(dirname(process.env.PAPERCLIP_SYNC_INPUT_ROOT), "shipment.json") : "";
  atomic(path, JSON.stringify({ last_ok: error ? old.last_ok ?? null : new Date().toISOString(), last_ok_format: "ISO-8601", last_error: error, source_shipment_age_seconds: shipment && existsSync(shipment) ? Math.max(0, (Date.now() - statSync(shipment).mtimeMs) / 1000) : null }));
}
const snapshotRoot = join(stateDir, "laptop");
async function receive() {
  const text = await Bun.stdin.text();
  if (Buffer.byteLength(text) > 32 * 1024 * 1024) throw new Error("Snapshot exceeds 32 MiB");
  const bundle = JSON.parse(text);
  if (bundle.version === 1 && bundle.decisionExchange === true) { await answerBundle(bundle); return; }
  if (bundle.version !== 1 || !Array.isArray(bundle.files) || bundle.files.length > 1000 || !bundle.org || !bundle.config?.paperclip) throw new Error("Invalid snapshot");
  for (const file of bundle.files) {
    if (typeof file.path !== "string" || !file.path.startsWith("/") || file.path !== resolve(file.path) || file.path.split("/").includes("..") || typeof file.text !== "string") throw new Error("Invalid snapshot path");
  }
  const labelledGithub = labelledSnapshot(bundle.labelGithub, bundle.config.projects, bundle.config.paperclip.github_labels ?? {}, bundle.config.paperclip.github_body_refs ?? []);
  const { heldPaths } = sourceDiscovery(bundle.org.nodes, bundle.config.projects);
  for (const file of bundle.files.filter((f: any) => !heldPaths.has(f.path))) atomic(resolve(snapshotRoot, `inputs/.${file.path}`), safeText(file.text, restrictedAliases(bundle.org, bundle.config.projects)));
  atomic(join(snapshotRoot, "config.json"), JSON.stringify(bundle.config));
  atomic(join(snapshotRoot, "label-github.json"), JSON.stringify(labelledGithub));
  const org = sanitizedOrg(bundle.org, bundle.config.projects);
  atomic(join(snapshotRoot, "org.json"), JSON.stringify(org));
  atomic(join(snapshotRoot, "schedules.json"), JSON.stringify(bundle.schedules));
  atomic(join(snapshotRoot, "shipment.json"), JSON.stringify({ receivedAt: new Date().toISOString(), sentAt: bundle.sentAt }));
  await answerBundle(bundle);
}
async function answerBundle(bundle: any) {
  const answers = await decisions(inbox => {
    if (bundle.acks !== undefined && (!Array.isArray(bundle.acks) || bundle.acks.some((id: unknown) => typeof id !== "string"))) throw new Error("Invalid answer acknowledgments");
    for (const id of bundle.acks || []) inbox.ackDelivered(id);
    return inbox.pendingAnswers();
  });
  const leadExchange = await decisions(async (_, db) => {
    const inbox = await pollLeadInbox(db);
    if (bundle.leadDeliveries !== undefined && !Array.isArray(bundle.leadDeliveries) || bundle.leadReplies !== undefined && !Array.isArray(bundle.leadReplies)) throw new Error("Invalid lead exchange");
    for (const delivery of bundle.leadDeliveries ?? []) inbox.acknowledge(delivery);
    const replyAcks: string[] = [];
    for (const reply of bundle.leadReplies ?? []) replyAcks.push(await inbox.reply(reply));
    return { messages: inbox.pending(), replyAcks };
  });
  console.log(JSON.stringify({ version: 1, answers, ...leadExchange }));
}
async function pollLeadInbox(db: Database) {
  const api = decisionApi(), inbox = new LeadInbox(api, db);
  const nodes = JSON.parse(readFileSync(orgFile, "utf8")).nodes as OrgNode[];
  const issues = await api(`/api/companies/${readConfig().paperclip.company}/issues`);
  if (!Array.isArray(issues)) throw new Error("Invalid lead issue response");
  const agents = Object.fromEntries((db.query("SELECT key,id FROM sync_objects WHERE kind='agents' AND key LIKE 'north:agent:%'").all() as { key: string; id: string }[]).map(row => [row.id, row.key.slice("north:agent:".length)]));
  const eligibleParents = new Set(configuredBodyRefs().flatMap(ref => {
    const row = db.query("SELECT id FROM sync_objects WHERE kind='issues' AND key=?").get(`gh:${ref}`) as { id: string } | null;
    return row ? [row.id] : [];
  }));
  await inbox.poll(issues, agents, nodes, eligibleParents);
  return inbox;
}
function localLeadReceipts(db: Database) {
  db.exec("CREATE TABLE IF NOT EXISTS paperclip_local_lead_receipts (id TEXT PRIMARY KEY, data TEXT NOT NULL, delivery TEXT, replied INTEGER NOT NULL DEFAULT 0)");
}
async function localLeadExchange() {
  return decisions((_, db) => {
    localLeadReceipts(db);
    const rows = db.query("SELECT id,data,delivery,replied FROM paperclip_local_lead_receipts WHERE delivery IS NOT NULL").all() as { id: string; data: string; delivery: string; replied: number }[];
    const leadReplies: LeadReply[] = [];
    for (const row of rows.filter(row => !row.replied)) {
      const path = join(stateDir, "lead-replies", `${row.id}.json`);
      if (!existsSync(path)) continue;
      let reply: LeadReply;
      try { reply = JSON.parse(readFileSync(path, "utf8")); }
      catch { console.error(`paperclip-sync lead reply pending ${row.id}: invalid envelope`); continue; }
      const message: LeadMessage = JSON.parse(row.data), delivery: LeadDelivery = JSON.parse(row.delivery);
      if (reply.id !== row.id || reply.issueId !== message.issueId || reply.leadId !== message.leadId || reply.session !== delivery.session || typeof reply.body !== "string" || !reply.body.trim()) { console.error(`paperclip-sync lead reply pending ${row.id}: origin/session mismatch`); continue; }
      leadReplies.push(reply);
    }
    return { leadDeliveries: rows.map(row => JSON.parse(row.delivery)), leadReplies };
  });
}
async function acknowledgeLeadReplies(ids: string[]) {
  await decisions((_, db) => {
    localLeadReceipts(db);
    for (const id of ids) db.query("UPDATE paperclip_local_lead_receipts SET replied=1 WHERE id=?").run(id);
  });
}
async function deliverLeadMessages(messages: LeadMessage[]) {
  if (process.env.PAPERCLIP_SYNC_INPUT_ROOT) throw new Error("Lead transport requires laptop org/session state");
  await decisions(async (_, db) => {
    localLeadReceipts(db);
    const nodes = JSON.parse(readFileSync(orgFile, "utf8")).nodes as OrgNode[];
    mkdirSync(join(stateDir, "lead-replies"), { recursive: true, mode: 0o700 });
    mkdirSync(join(stateDir, "lead-receipts"), { recursive: true, mode: 0o700 });
    for (const message of messages) {
      if (!uuid.test(message.id) || !uuid.test(message.issueId) || typeof message.body !== "string" || typeof message.leadId !== "string") throw new Error("Invalid lead message");
      const old = db.query("SELECT delivery FROM paperclip_local_lead_receipts WHERE id=?").get(message.id) as { delivery: string | null } | null;
      if (old?.delivery) continue;
      const node = nodes.find(node => node.id === message.leadId && node.role !== "worker" && node.state === "active" && !node.died && node.session);
      if (!node || !["claude", "codex"].includes(node.provider ?? "")) continue;
      const receivedAt = new Date().toISOString();
      db.query("INSERT INTO paperclip_local_lead_receipts(id,data) VALUES (?,?) ON CONFLICT(id) DO UPDATE SET data=excluded.data WHERE delivery IS NULL").run(message.id, JSON.stringify(message));
      const path = join(stateDir, "lead-replies", `${message.id}.json`);
      const receiptPath = join(stateDir, "lead-receipts", `${message.id}.json`);
      const envelope: LeadReply = { id: message.id, issueId: message.issueId, leadId: node.id, session: node.session!, body: "YOUR ACTUAL REPLY" };
      const receipt = { id: message.id, leadId: node.id, session: node.session! };
      const acknowledged = () => [receiptPath, path].some(file => {
        try {
          const value = JSON.parse(readFileSync(file, "utf8"));
          return value.id === receipt.id && value.leadId === receipt.leadId && value.session === receipt.session && (file === receiptPath || value.issueId === message.issueId && typeof value.body === "string" && value.body.trim() && value.body !== envelope.body);
        } catch { return false; }
      });
      const prompt = `Tom's Paperclip comment on issue ${message.issueId} (origin ${message.id}):\n${message.body}\nBefore answering, acknowledge receipt by writing this exact JSON to ${receiptPath}:\n${JSON.stringify(receipt)}\nReply to Tom by writing exactly one JSON reply envelope to ${path}:\n${JSON.stringify(envelope)}\nReplace body with your actual reply only. Do not include unrelated assistant prose. This is an explicit Tom message, including when the project uses title-only GitHub synchronization.`;
      const sendKey = `lead-send:${message.id}`;
      const sent = db.query("SELECT value FROM sync_meta WHERE key=?").get(sendKey) as { value: string } | null;
      try {
        if (node.provider === "claude" && !acknowledged()) {
          if (sent?.value === JSON.stringify(receipt)) continue;
          if (!await sendLead(node, prompt)) continue;
          db.query("INSERT OR REPLACE INTO sync_meta(key,value) VALUES (?,?)").run(sendKey, JSON.stringify(receipt));
          const deadline = Date.now() + 30000;
          while (!acknowledged() && Date.now() < deadline) await Bun.sleep(Math.min(100, deadline - Date.now()));
          if (!acknowledged()) continue;
        } else if (node.provider === "codex" && !await sendLead(node, prompt)) continue;
      }
      catch { console.error(`paperclip-sync lead delivery pending ${message.id} lead=${node.id}`); continue; }
      const delivery: LeadDelivery = { id: message.id, leadId: node.id, session: node.session!, receivedAt, deliveredAt: new Date().toISOString() };
      db.query("UPDATE paperclip_local_lead_receipts SET delivery=? WHERE id=?").run(JSON.stringify(delivery), message.id);
      console.error(`paperclip-sync lead receipt ${JSON.stringify(delivery)}`);
    }
  });
}
async function sendLead(node: OrgNode, prompt: string) {
  if (node.provider === "codex") {
    const child = Bun.spawn(["codex-lead", "send", prompt], { env: { ...process.env, CODEX_LEAD_THREAD: node.session! }, stdout: "pipe", stderr: "pipe", timeout: 30000 });
    const [code] = await Promise.all([child.exited, new Response(child.stdout).text(), new Response(child.stderr).text()]);
    if (code) throw new Error(`Codex lead delivery failed (${code})`);
    return true;
  }
  const directory = `/run/user/${process.getuid!()}/cc-socks`;
  const socket = existsSync(directory) ? readdirSync(directory).filter(name => /^[0-9]+\.sock$/.test(name)).sort().find(name => {
    try { return readFileSync(`/proc/${name.slice(0, -5)}/cmdline`).toString().split("\0").slice(1).includes(node.session!); } catch { return false; }
  }) : undefined;
  if (!socket) return false;
  await new Promise<void>((resolve, reject) => {
    const connection = createConnection(join(directory, socket));
    const timeout = setTimeout(() => { connection.destroy(); reject(new Error("Claude socket acceptance timed out")); }, 3000);
    connection.once("error", error => { clearTimeout(timeout); connection.destroy(); reject(error); });
    connection.once("connect", () => connection.end(`${JSON.stringify({ type: "user", message: { role: "user", content: prompt } })}\n`, () => { clearTimeout(timeout); connection.destroy(); resolve(); }));
  });
  return true;
}
function sanitizedOrg(org: any, projects: Record<string, ProjectConfig>, local = false) {
  return { version: org.version, nodes: org.nodes.map((node: OrgNode) => {
    if (!heldNode(node, projects)) return node;
    const boxes = titleOnlyDomain(node, projects) ? local ? restrictedBoxes(existsSync(node.brief) ? readFileSync(node.brief, "utf8") : "", existsSync(node.status_file) ? readFileSync(node.status_file, "utf8") : "") : boxMetadata(node.boxes) : [];
    return { id: node.id, role: node.role, domain: node.domain, state: node.state, brief: node.brief, status_file: node.status_file,
      ...(node.parent ? { parent: node.parent } : {}), ...(node.provider ? { provider: node.provider } : {}), ...(node.died ? { died: "DIED" } : {}), boxes };
  }) };
}
function restrictedSources(): string[] {
  if (process.env.PAPERCLIP_SYNC_INPUT_ROOT) return [];
  const org = JSON.parse(readFileSync(orgFile, "utf8"));
  const projects = readConfig().projects;
  return org.nodes.filter((node: OrgNode) => titleOnlyDomain(node, projects)).flatMap((node: OrgNode) => [node.brief, node.status_file]);
}
function sources(): string[] {
  const org = JSON.parse(readFileSync(orgFile, "utf8"));
  const projects = readConfig().projects;
  return [orgFile, configFile, ...sourceDiscovery(org.nodes, projects).paths];
}
async function ship() {
  const localOrg = JSON.parse(readFileSync(orgFile, "utf8"));
  const config = readConfig();
  const org = sanitizedOrg(localOrg, config.projects, true);
  const files = [...new Set(sources().filter(p => p !== orgFile && p !== configFile))].filter(existsSync).map(path => ({ path, text: safeText(readFileSync(path, "utf8")) }));
  const labelGithub = Object.keys(configuredLabelSources()).length ? labelledSnapshot(await snapshots(config.projects, [], {}, undefined, [], true), config.projects, configuredLabelSources(), configuredBodyRefs()) : [];
  const bundle = JSON.stringify({ version: 1, sentAt: new Date().toISOString(), org, config: { paperclip: { url: config.paperclip.url, company: config.paperclip.company, github_body_refs: configuredBodyRefs(), github_labels: configuredLabelSources() }, projects: config.projects }, files, labelGithub, schedules: collectMachineSnapshot("laptop") });
  await exchange(JSON.parse(bundle));
}
async function start() {
  const command = process.argv[2];
  if (["ask", "record", "answers", "ack"].includes(command)) { console.log(JSON.stringify(await decisionCommand(command, process.argv.slice(3)))); return; }
  if (command === "receive") { await receive(); return; }
  const once = process.argv.includes("--once");
  if (command !== "ship" && (command !== "run" || once || process.argv.includes("--dry-run"))) { await main(); return; }
  let changed = true, stopping = false, retry = 1000, next = 0;
  const decisionLoop = once ? Promise.resolve() : (async () => {
    while (!stopping) {
      const deadline = Date.now() + 10000;
      try {
        if (command === "ship") await exchange({ version: 1, decisionExchange: true });
        else await decisions(async (inbox, db) => { await inbox.poll(); await pollLeadInbox(db); });
      } catch (error: any) { console.error(`paperclip-sync decisions: ${error.message}`); }
      while (!stopping && Date.now() < deadline) await Bun.sleep(Math.min(250, deadline - Date.now()));
    }
  })();
  const watchers = new Map<string, ReturnType<typeof watch>>();
  const stop = () => { stopping = true; for (const watcher of watchers.values()) watcher.close(); };
  process.on("SIGTERM", stop); process.on("SIGINT", stop);
  try {
    do {
      for (const path of [...sources(), ...restrictedSources()]) {
        const directory = dirname(command === "ship" || path === orgFile || path === configFile ? path : inputPath(path));
        if (!watchers.has(directory) && existsSync(directory)) watchers.set(directory, watch(directory, () => { changed = true; }));
      }
      if (changed || Date.now() >= next) {
        const refresh = Date.now() >= next;
        changed = false;
        try {
          if (command === "ship") await ship(); else await main(refresh);
          if (refresh) next = Date.now() + 300000;
          retry = 1000;
        } catch (error: any) {
          if (command === "run") heartbeat(error.message);
          console.error(`paperclip-sync: ${error.message}`);
          if (once) { process.exitCode = 1; return; }
          changed = true;
          const until = Date.now() + retry;
          while (!stopping && Date.now() < until) await Bun.sleep(Math.min(250, until - Date.now()));
          retry = Math.min(300000, retry * 2);
        }
      }
      if (!once && !stopping) await Bun.sleep(250);
    } while (!once && !stopping);
  } finally { stop(); await decisionLoop; }
}
start().catch(error => { console.error(`paperclip-sync: ${error.message}`); process.exitCode = 1; });
