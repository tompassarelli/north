#!/usr/bin/env bash
# galileo-full-suite SHA: run Galileo's full test suite (GALILEO_FULL=1) at SHA in a worktree of
# ~/code/galileo/main under a machine-capacity lease, print wall time and result, then remove the
# worktree. It builds once, then runs the test binaries GALILEO_FULL_JOBS (default 4, the heavy lease's CPUs on nexus) at a time, slowest first by the
# previous run's times, and finishes with the doc tests. It builds with the workspace's full profile (the test profile at opt-level 2). The worktree path is fixed and its target
# directory is kept between runs in ~/.cache/galileo-full-suite so only changed crates rebuild.
# --only NAME,... runs just those test binaries (named without their hash) and skips the doc tests;
# --skip NAME,... runs everything else. Exits with the suite's code. Queued for nexus by
#   threads queue add nexus - -- galileo-full-suite SHA --skip differential
#   threads queue add nexus - -- galileo-full-suite SHA --only differential
set -uo pipefail

usage() { echo "usage: galileo-full-suite SHA [--only NAME,...|--skip NAME,...]" >&2; exit 2; }
[ -n "${1:-}" ] || usage
only= skip=
case "${2:-}:$#" in
  :1) ;;
  --only:3) only=$3 ;;
  --skip:3) skip=$3 ;;
  *) usage ;;
esac
container=${GALILEO_CONTAINER:-$HOME/code/galileo}
main=$container/main
state=${XDG_CACHE_HOME:-$HOME/.cache}/galileo-full-suite
mkdir -p "$state"
exec 9>"$state/lock"
flock 9
git -C "$main" fetch -q origin || echo "galileo-full-suite: fetch failed, using local objects" >&2
sha=$(git -C "$main" rev-parse --verify "$1^{commit}") || exit 2
lane=$container/worktrees/full-suite
if [ -d "$lane" ]; then
  [ -d "$lane/target" ] && [ ! -d "$state/target" ] && mv "$lane/target" "$state/target"
  git -C "$main" worktree remove --force "$lane"
fi
git -C "$main" worktree add -q --detach "$lane" "$sha" || exit 2
[ -d "$state/target" ] && mv "$state/target" "$lane/target"
cleanup() {
  [ -d "$lane/target" ] && mv "$lane/target" "$state/target"
  git -C "$main" worktree remove --force "$lane"
}
trap cleanup EXIT

mkdir -p "$lane/target/full-suite"
cat >"$lane/target/full-suite/run.sh" <<'EOF'
set -uo pipefail
out=target/full-suite
rm -rf "$out/logs" && mkdir -p "$out/logs"
start=$SECONDS
cargo test --workspace --profile full --no-fail-fast --locked --offline --no-run --message-format=json-render-diagnostics >"$out/build.jsonl" || exit $?
echo "galileo-full-suite: build $((SECONDS - start))s"
start=$SECONDS
touch "$out/times.tsv"
jq -r 'select(.reason == "compiler-artifact" and .executable != null and .profile.test) | [.executable, (.manifest_path | sub("/Cargo.toml$"; ""))] | @tsv' "$out/build.jsonl" |
  awk -F'\t' 'FILENAME != "-" { t[$1] = $2; next } { n = $1; sub(/.*\//, "", n); print ((n in t) ? t[n] : 1e9) "\t" $0 }' "$out/times.tsv" - |
  sort -t$'\t' -k1,1gr | cut -f2- >"$out/all.tsv"
awk -F'\t' -v only=",$GALILEO_FULL_ONLY," -v skip=",$GALILEO_FULL_SKIP," '{ n = $1; sub(/.*\//, "", n); sub(/-[0-9a-f]+$/, "", n) }
  (only == ",," || index(only, "," n ",")) && !index(skip, "," n ",")' "$out/all.tsv" >"$out/binaries.tsv"
[ -s "$out/binaries.tsv" ] || { echo "galileo-full-suite: no test binaries found" >&2; exit 1; }
echo "galileo-full-suite: $(wc -l <"$out/binaries.tsv") test binaries"
shard() {
  name=${1##*/}
  begin=$SECONDS
  (cd "$2" && CARGO_MANIFEST_DIR="$2" "$1") >"$out/logs/$name.log" 2>&1
  rc=$?
  printf '%s\t%s\t%s\n' "$name" "$((SECONDS - begin))" "$rc" >"$out/logs/$name.rc"
}
export -f shard
export out GALILEO_FULL_JOBS
tr '\t\n' '\0\0' <"$out/binaries.tsv" | xargs -0 -n2 -P"$GALILEO_FULL_JOBS" bash -c 'shard "$0" "$1"'
rc=0
while IFS=$'\t' read -r exe _; do
  name=${exe##*/}
  echo "     Running $name"
  cat "$out/logs/$name.log"
  read -r _ seconds code <"$out/logs/$name.rc" 2>/dev/null || code=1
  [ "${code:-1}" -eq 0 ] || rc=1
done <"$out/binaries.tsv"
cat "$out"/logs/*.rc | cut -f1,2 >"$out/ran.tsv"
awk -F'\t' 'FILENAME ~ /all\.tsv$/ { n = $1; sub(/.*\//, "", n); built[n] = 1; next }
  FILENAME ~ /ran\.tsv$/ { ran[$1] = 1; print; next } ($1 in built) && !($1 in ran)' "$out/all.tsv" "$out/ran.tsv" "$out/times.tsv" |
  sort -t$'\t' -k2,2nr >"$out/times.new" && mv "$out/times.new" "$out/times.tsv"
echo "galileo-full-suite: binary times (s), slowest first"
head -12 "$out/times.tsv"
echo "galileo-full-suite: tests $((SECONDS - start))s"
[ -n "$GALILEO_FULL_ONLY" ] || cargo test --workspace --profile full --doc --no-fail-fast --locked --offline || rc=1
exit "$rc"
EOF

capacity=$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs
cd "$lane" || exit 2
start=$EPOCHSECONDS
bun "$capacity" run --class "${GALILEO_FULL_CLASS:-heavy}" --owner galileo-full-suite --timeout-seconds 3600 -- \
  depbox run -- nix develop -c env GALILEO_FULL=1 GALILEO_FULL_JOBS="${GALILEO_FULL_JOBS:-4}" GALILEO_FULL_ONLY="$only" GALILEO_FULL_SKIP="$skip" bash target/full-suite/run.sh
rc=$?
wall=$((EPOCHSECONDS - start))
result=passed
[ "$rc" -eq 0 ] || result=failed
echo "galileo-full-suite: $sha${only:+ only $only}${skip:+ skip $skip} $result rc=$rc wall=${wall}s"
exit "$rc"
