#!/usr/bin/env -S bun --no-install
import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, unlinkSync, watch, statSync, openSync, readSync, closeSync, writeFileSync, type FSWatcher } from "fs";
import { basename, dirname, isAbsolute, join } from "path";
import { hostname } from "os";
import { Database } from "bun:sqlite";
import { bootstrapNodes, chatText, dialogOpen, inputReady, routeInbound, decide, decideParents, decideSpaces, decideWatches, domains, displayname, formatOutbound, localpart, outboundRoom, roomTopic, restDelay, spaceStateChanged, type ChatEvent, type ChatWatch, type ChatEta, type WatchTimeline, type WatchPost, type Entry, type Node, type Room, type SpaceChild, type SpaceParent } from "../socrates/lib/chat-core.ts";

const USAGE = `usage: socrates-chat run
       socrates-chat post [--as NODE] [--kind reply|result|notice] [--tag TAG]
                          [--file PATH] [--source SOURCE] [--session ID] TEXT|-
       socrates-chat rooms [--json]
       socrates-chat log NODE [--last N] [--json]
       socrates-chat latency [--last N] [--json]
       socrates-chat probe NODE TEXT|-
       socrates-chat avatar ROOM FILE
       socrates-chat replay [FILE]

run reconciles local org rooms, drains the atomic outbox and syncs every device.
post writes only the local spool; - reads text from stdin.
replay reads {org|nodes, rooms, live} without network or credentials.
Network commands require SOCRATES_CHAT_HOMESERVER and SOCRATES_CHAT_TOM_USER_ID.
SOCRATES_CHAT_TOKEN_FILE names the rendered appservice token; otherwise sops reads
SOCRATES_CHAT_SOPS_FILE (default ~/code/south/main/secrets/nexus/matrix.yaml).
SOCRATES_CHAT_ADMIN_ROOM defaults to #admins:<server>.
SOCRATES_CHAT_PROXY_PANE enables proxy output and inbound delivery (socket:session).
SOCRATES_CHAT_WATCHES=1 enables watches and ETA tracking on exactly one relay.
Tom can write watch TARGET [done] [if over Nm|Nmin|Nh|Nd] or unwatch TARGET.
TARGET is REPO#ISSUE, this, an org node or a box id. Other posts are quiet notices;
Plato replies are text.
Only exact Tom sender ids deliver. probe logs in as Tom with his encrypted password.
State: $XDG_STATE_HOME/socrates-chat (default ~/.local/state/socrates-chat).
Org: $AGENTS_ORG_FILE (default ~/.local/state/agents/org.json).`;

const stateHome = process.env.XDG_STATE_HOME || join(process.env.HOME!, ".local/state");
const stateDir = join(stateHome, "socrates-chat");
const spoolDir = join(stateDir, "outbox");
const orgFile = process.env.AGENTS_ORG_FILE || join(stateHome, "agents/org.json");
const host = hostname();
const epochNs = BigInt(Date.now()) * 1_000_000n;
const monotonicNs = process.hrtime.bigint();
const sources = new Set(["claude-stop", "claude-subagent", "codex-stop", "remote-trigger", "vast-job", "vast-reaper", "status", "cli"]);

function readNodes(): Node[] {
  if (!existsSync(orgFile)) return [];
  const org = JSON.parse(readFileSync(orgFile, "utf8"));
  if (org.version !== 1 || !Array.isArray(org.nodes)) throw new Error("invalid org snapshot");
  return org.nodes;
}

function livePid(pid: number): boolean {
  try { return !/\) [ZX] /.test(readFileSync(`/proc/${pid}/stat`, "utf8")); }
  catch { return false; }
}

function validateEntry(entry: Entry) {
  if (entry.v !== 1 || typeof entry.node !== "string" || !entry.node ||
      !["reply", "result", "notice"].includes(entry.kind) || typeof entry.text !== "string" ||
      !(entry.tag === null || typeof entry.tag === "string") ||
      !(entry.file === null || typeof entry.file === "string" && isAbsolute(entry.file)) ||
      !(entry.session === null || typeof entry.session === "string") ||
      !sources.has(entry.source) || typeof entry.ts !== "string" || !Number.isFinite(Date.parse(entry.ts))) {
    throw new Error("invalid v1 outbox entry");
  }
}

function spool(entry: Entry): string {
  validateEntry(entry);
  mkdirSync(spoolDir, { recursive: true });
  const file = join(spoolDir, `${epochNs + process.hrtime.bigint() - monotonicNs}-${process.pid}.json`);
  writeFileSync(file + ".tmp", JSON.stringify(entry) + "\n", { flag: "wx", mode: 0o600 });
  renameSync(file + ".tmp", file);
  return file;
}

function ledger(): Database {
  mkdirSync(stateDir, { recursive: true });
  const db = new Database(join(stateDir, "relay.db"), { create: true });
  db.exec(`PRAGMA journal_mode=WAL;
    CREATE TABLE IF NOT EXISTS rooms (node TEXT PRIMARY KEY, host TEXT NOT NULL, room_id TEXT NOT NULL, state TEXT NOT NULL, tom TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS users (node TEXT PRIMARY KEY, displayname_set INTEGER NOT NULL);
    CREATE TABLE IF NOT EXISTS outbox (file TEXT PRIMARY KEY, txn_id TEXT NOT NULL, event_id TEXT NOT NULL, node TEXT, session TEXT, turn_end INTEGER, posted INTEGER);
    CREATE TABLE IF NOT EXISTS inbound (event_id TEXT PRIMARY KEY, node TEXT NOT NULL, state TEXT NOT NULL, text TEXT, sent INTEGER, delivered INTEGER, received INTEGER, turn_end INTEGER, posted INTEGER);
    CREATE TABLE IF NOT EXISTS sync (key TEXT PRIMARY KEY, since TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS status (node TEXT PRIMARY KEY, path TEXT NOT NULL, offset INTEGER NOT NULL);`);
  db.exec("CREATE TABLE IF NOT EXISTS inbound_targets (event_id TEXT PRIMARY KEY, session TEXT NOT NULL); CREATE TABLE IF NOT EXISTS room_spaces (room_id TEXT PRIMARY KEY, space TEXT NOT NULL)");
  db.exec("CREATE TABLE IF NOT EXISTS space_rooms (space TEXT PRIMARY KEY, node TEXT NOT NULL, room_id TEXT NOT NULL, tom TEXT NOT NULL)");
  db.exec(`CREATE TABLE IF NOT EXISTS chat_watches (id TEXT PRIMARY KEY, value TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS chat_etas (target TEXT PRIMARY KEY, value TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS watch_events (event_id TEXT PRIMARY KEY);
    CREATE TABLE IF NOT EXISTS watch_posts (txn TEXT PRIMARY KEY, value TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS watch_issues (target TEXT PRIMARY KEY, checked INTEGER NOT NULL, state TEXT NOT NULL);`);
  return db;
}

async function appserviceToken(): Promise<string> {
  const tokenFile = process.env.SOCRATES_CHAT_TOKEN_FILE;
  if (tokenFile) return readFileSync(tokenFile, "utf8").trim();
  const sopsFile = process.env.SOCRATES_CHAT_SOPS_FILE || join(process.env.HOME!, "code/south/main/secrets/nexus/matrix.yaml");
  const result = Bun.spawn(["sops", "-d", "--extract", '["matrix-appservice-as-token"]', sopsFile], { stdout: "pipe", stderr: "ignore" });
  const token = (await new Response(result.stdout).text()).trim();
  if (await result.exited !== 0 || !token) throw new Error("matrix-appservice-as-token is unavailable");
  return token;
}

class MatrixError extends Error {
  constructor(public code: string, method: string, path: string, status: number) {
    super(`Matrix ${method} ${path} returned ${status} ${code}`);
  }
}

type Event = ChatEvent;
type SyncBatch = { next_batch: string; rooms?: { join?: Record<string, { state?: { events?: Event[] }; timeline?: { events?: Event[] } }> } };

export class Matrix {
  readonly server: string;
  readonly tom: string;
  readonly base: string;
  sender = "";
  private deviceToken = "";

  constructor(private token: string) {
    const base = process.env.SOCRATES_CHAT_HOMESERVER;
    const tom = process.env.SOCRATES_CHAT_TOM_USER_ID;
    if (!base || !tom || !/^@[^:]+:.+$/.test(tom)) throw new Error("set SOCRATES_CHAT_HOMESERVER and SOCRATES_CHAT_TOM_USER_ID");
    this.base = base.replace(/\/$/, "");
    this.tom = tom;
    this.server = tom.slice(tom.indexOf(":") + 1);
  }

  user(node: string): string { return `@agent-${node === "proxy" ? "plato" : localpart(node)}:${this.server}`; }
  alias(node: string): string { return `#socrates-${node === "proxy" ? "plato" : node === "alerts" ? "alerts" : `${localpart(host)}-${localpart(node)}`}:${this.server}`; }
  spaceAlias(domain: string): string { return `#socrates${domain === "socrates" ? "" : `-${domain}`}:${this.server}`; }

  async request<T = Record<string, any>>(method: string, path: string, body?: unknown, user?: string, query: Record<string, string> = {}, device = false): Promise<T> {
    const url = new URL(path, this.base + "/");
    for (const [key, value] of Object.entries(query)) url.searchParams.set(key, value);
    if (user) url.searchParams.set("user_id", user);
    let response: Response;
    try {
      response = await fetch(url, {
        method, headers: { ...(this.token ? { Authorization: `Bearer ${device ? this.deviceToken : this.token}` } : {}), "Content-Type": "application/json" },
        body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(45_000),
      });
    } catch {
      throw new Error(`Matrix ${method} ${path} failed`);
    }
    const data = await response.json() as Record<string, any>;
    if (!response.ok) throw new MatrixError(typeof data.errcode === "string" ? data.errcode.replace(/[^A-Z_]/g, "") : "HTTP_ERROR", method, path, response.status);
    return data as T;
  }

  async identify() {
    const who = await this.request("GET", "/_matrix/client/v3/account/whoami");
    this.sender = who.user_id;
    if (!["socrates", "socrates-relay"].some((name) => this.sender === `@${name}:${this.server}`)) throw new Error("appservice sender is not the registered Socrates administrator");
  }

  async login() {
    await this.identify();
    const login = await this.request("POST", "/_matrix/client/v3/login", {
      type: "m.login.application_service", identifier: { type: "m.id.user", user: this.sender }, device_id: `socrates-chat-${host}`,
    });
    this.deviceToken = login.access_token;
    if (!this.deviceToken) throw new Error("appservice login returned no device token");
  }

  async register(node: string) {
    try {
      await this.request("POST", "/_matrix/client/v3/register", { type: "m.login.application_service", username: this.user(node).slice(1).split(":")[0], inhibit_login: true });
    } catch (error) {
      if (!(error instanceof MatrixError && error.code === "M_USER_IN_USE")) throw error;
    }
    await this.request("PUT", `/_matrix/client/v3/profile/${encodeURIComponent(this.user(node))}/displayname`, { displayname: displayname(node) }, this.user(node));
  }

  async resolve(alias: string): Promise<string | null> {
    try { return (await this.request("GET", `/_matrix/client/v3/directory/room/${encodeURIComponent(alias)}`)).room_id; }
    catch (error) { if (error instanceof MatrixError && error.code === "M_NOT_FOUND") return null; throw error; }
  }

  async create(alias: string, name: string, user: string, topic: string, space = false): Promise<string> {
    const existing = await this.resolve(alias);
    if (existing) return existing;
    try {
      return (await this.request("POST", "/_matrix/client/v3/createRoom", {
        room_alias_name: alias.slice(1, alias.indexOf(":")), name, topic, visibility: "private", preset: "public_chat",
        ...(space ? { creation_content: { type: "m.space" } } : {}),
        power_level_content_override: { users: { [user]: 100, [this.sender]: 100, [this.tom]: 100 } },
        initial_state: [
          { type: "m.room.join_rules", state_key: "", content: { join_rule: "public" } },
          { type: "m.room.history_visibility", state_key: "", content: { history_visibility: "shared" } },
        ],
      }, user)).room_id;
    } catch (error) {
      if (!(error instanceof MatrixError && error.code === "M_ROOM_IN_USE")) throw error;
      const room = await this.resolve(alias);
      if (!room) throw error;
      return room;
    }
  }

  async join(room: string, user = this.sender) { await this.request("POST", `/_matrix/client/v3/join/${encodeURIComponent(room)}`, {}, user); }
  async state(room: string, type: string, key: string, content: unknown, user = this.sender) {
    await this.request("PUT", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/state/${encodeURIComponent(type)}/${encodeURIComponent(key)}`, content, user);
  }
  async send(room: string, txn: string, content: unknown, user = this.sender): Promise<string> {
    return (await this.request("PUT", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/send/m.room.message/${encodeURIComponent(txn)}`, content, user)).event_id;
  }
  async members(room: string): Promise<Record<string, { display_name?: string }>> {
    return (await this.request("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/joined_members`, undefined, this.sender)).joined;
  }
  async sync(since?: string): Promise<SyncBatch> {
    return this.request("GET", "/_matrix/client/v3/sync", undefined, undefined, { timeout: "30000", ...(since ? { since } : {}) }, true);
  }
  async upload(data: Uint8Array, filename: string, mimetype: string, user: string): Promise<string> {
    const url = new URL("/_matrix/media/v3/upload", this.base);
    url.searchParams.set("filename", filename);
    url.searchParams.set("user_id", user);
    let response: Response;
    try { response = await fetch(url, { method: "POST", headers: { Authorization: `Bearer ${this.token}`, "Content-Type": mimetype }, body: data, signal: AbortSignal.timeout(45_000) }); }
    catch { throw new Error("Matrix media upload failed"); }
    const result = await response.json() as { content_uri: string; errcode?: string };
    if (!response.ok || !result.content_uri) throw new Error(`Matrix media upload returned ${response.status}`);
    return result.content_uri;
  }
  async event(room: string, event: string): Promise<Event> { return this.request("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/event/${encodeURIComponent(event)}`, undefined, this.sender); }

  async probe(room: string, text: string): Promise<string> {
    const file = process.env.SOCRATES_CHAT_SOPS_FILE || join(process.env.HOME!, "code/south/main/secrets/nexus/matrix.yaml");
    const child = Bun.spawn(["sops", "-d", "--extract", '["matrix-tom-password"]', file], { stdout: "pipe", stderr: "ignore" });
    const password = (await new Response(child.stdout).text()).trim();
    if (await child.exited !== 0 || !password) throw new Error("Tom's encrypted Matrix password is unavailable");
    const login = await new Matrix("").request("POST", "/_matrix/client/v3/login", {
      type: "m.login.password", identifier: { type: "m.id.user", user: this.tom }, password,
      initial_device_display_name: "socrates-chat probe",
    });
    const client = new Matrix(login.access_token);
    try { return await client.send(room, `probe-${process.pid}-${process.hrtime.bigint()}`, { msgtype: "m.text", body: text }); }
    finally { await client.request("POST", "/_matrix/client/v3/logout", {}); }
  }
}

export class Relay {
  space = "";
  admin = "";
  spaces: Record<string, string> = {};
  children: SpaceChild[] = [];
  delivering = false;
  postingWatches = false;
  watchRooms = new Map<string, string | null>();
  get watchesEnabled() { return process.env.SOCRATES_CHAT_WATCHES === "1"; }
  transcripts = new Map<string, string>();
  layoutDue = true;
  changed = () => {};
  watchers = new Map<string, { watcher: FSWatcher; names: Set<string> | null }>();
  waiters = new Map<number, Bun.Subprocess>();
  constructor(readonly db: Database, readonly matrix: Matrix) {}
  rooms(): Room[] { return this.db.query("SELECT * FROM rooms WHERE host = ? ORDER BY node").all(host) as Room[]; }
  room(node: string): Room | null { return this.db.query("SELECT * FROM rooms WHERE node = ?").get(node) as Room | null; }
  save(room: Room) { this.db.query("INSERT OR REPLACE INTO rooms VALUES (?, ?, ?, ?, ?)").run(room.node, room.host, room.room_id, room.state, room.tom); }

  async user(node: string) {
    if (this.db.query("SELECT node FROM users WHERE node = ? AND displayname_set = 1").get(node)) return;
    await this.matrix.register(node);
    this.db.query("INSERT OR REPLACE INTO users VALUES (?, 1)").run(node);
  }

  async membership(room: string, membership: "join" | "leave"): Promise<"join" | "leave"> {
    let members = await this.matrix.members(room);
    if ((this.matrix.tom in members) !== (membership === "join")) {
      await this.matrix.send(this.admin, `membership-${process.pid}-${process.hrtime.bigint()}`, {
        msgtype: "m.text", body: `!admin users force-${membership}-room ${this.matrix.tom} ${room}`,
      });
      members = await this.matrix.members(room);
    }
    return this.matrix.tom in members ? "join" : "leave";
  }

  async bootstrap() {
    await this.matrix.login();
    this.admin = process.env.SOCRATES_CHAT_ADMIN_ROOM || `#admins:${this.matrix.server}`;
    if (this.admin.startsWith("#")) {
      const resolved = await this.matrix.resolve(this.admin);
      if (!resolved) throw new Error("admin room alias is missing");
      this.admin = resolved;
    }
    this.space = await this.matrix.create(`#socrates:${this.matrix.server}`, "Socrates", this.matrix.sender, "Socrates agent sessions", true);
    this.spaces.socrates = this.space;
    for (const domain of domains) {
      this.spaces[domain] = await this.matrix.create(this.matrix.spaceAlias(domain), domain[0]!.toUpperCase() + domain.slice(1), this.matrix.sender, `${domain} agent sessions`, true);
    }
    this.children = [];
    for (const [parent, room] of Object.entries(this.spaces)) {
      const members = await this.matrix.members(room);
      if (!(this.matrix.sender in members)) await this.matrix.join(room);
      const tom = await this.membership(room, "join");
      this.db.query("INSERT OR REPLACE INTO space_rooms VALUES (?, ?, ?, ?)").run(this.matrix.spaceAlias(parent), parent, room, tom);
      const state = await this.matrix.request<{ type: string; state_key: string; content: SpaceChild["content"] }[]>("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/state`, undefined, this.matrix.sender);
      this.children.push(...state.filter((event) => event.type === "m.space.child").map((event) => ({ parent, room_id: event.state_key, content: event.content })));
    }
  }

  async open(node: Node) {
    await this.user(node.id);
    const room = await this.matrix.create(this.matrix.alias(node.id), displayname(node.id), this.matrix.user(node.id), roomTopic(node, host));
    await this.matrix.join(room, this.matrix.user(node.id));
    await this.matrix.join(room);
    await this.matrix.state(room, "m.room.name", "", { name: displayname(node.id) });
    await this.matrix.state(room, "m.room.topic", "", { topic: roomTopic(node, host) });
    const tom = await this.membership(room, "join");
    const state = this.room(node.id)?.state === "died" ? "died" : "active";
    this.save({ node: node.id, host, room_id: room, state, tom });
    console.log(`opened ${displayname(node.id)} tom:${tom}`);
  }

  async close(node: string) {
    const room = this.room(node)!;
    await this.matrix.state(room.room_id, "m.room.name", "", { name: `✔ ${displayname(node)}` });
    const tom = await this.membership(room.room_id, "leave");
    this.save({ ...room, state: "finished", tom });
    console.log(`closed ${displayname(node)} tom:${tom}`);
  }

  async reconcile() {
    const nodes = [...bootstrapNodes, ...readNodes()];
    const live: Record<string, boolean> = {};
    for (const node of nodes) {
      live[node.id] = true;
      if (node.pid) live[node.id] = livePid(node.pid);
    }
    for (const action of decide(nodes, this.rooms(), live)) {
      if (action.kind === "open" || action.kind === "close") this.layoutDue = true;
      if (action.kind === "open") await this.open(action.node);
      else if (action.kind === "close") await this.close(action.node);
      else {
        const room = this.room(action.node)!;
        if (action.kind === "died") await this.matrix.send(room.room_id, `died-${action.node}-${Date.now()}`, { msgtype: "m.notice", body: action.text }, this.matrix.user(action.node));
        this.save({ ...room, state: action.kind === "died" ? "died" : "active" });
      }
    }
    if (this.layoutDue) {
      this.layoutDue = false;
      await this.layout(nodes);
    }
    this.tail(nodes);
    await this.deliverQueued(nodes);
    this.measureReceived(nodes);
    await this.drain(nodes);
    if (this.watchesEnabled) await this.watchTick();
  }

  async layout(nodes: Node[]) {
    const rooms = this.rooms();
    const managed = [...new Set([...domains.map((domain) => this.spaces[domain]!), ...rooms.map((room) => room.room_id)])];
    const parents: SpaceParent[] = [];
    for (const room of managed) {
      const state = await this.matrix.request<{ type: string; state_key: string; content: SpaceParent["content"] }[]>("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(room)}/state`, undefined, this.matrix.sender);
      parents.push(...state.filter((event) => event.type === "m.space.parent").map((event) => ({ parent: event.state_key, room_id: room, content: event.content })));
    }
    for (const action of decideSpaces(nodes, rooms, this.spaces, this.children, this.matrix.server)) {
      await this.matrix.state(this.spaces[action.parent]!, "m.space.child", action.room_id, action.content);
      this.children = this.children.filter((child) => child.parent !== action.parent || child.room_id !== action.room_id);
      this.children.push(action);
    }
    for (const action of decideParents(nodes, rooms, this.spaces, parents, this.matrix.server)) {
      await this.matrix.state(action.room_id, "m.space.parent", action.parent, action.content);
    }
    for (const room of managed) {
      const parent = this.children.find((child) => child.room_id === room && child.content.via?.length)?.parent;
      if (parent) this.db.query("INSERT OR REPLACE INTO room_spaces VALUES (?, ?)").run(room, this.matrix.spaceAlias(parent));
      else this.db.query("DELETE FROM room_spaces WHERE room_id = ?").run(room);
    }
  }

  tail(nodes: Node[]) {
    for (const node of nodes) {
      if (node.state !== "active" || !node.status_file || !existsSync(node.status_file)) continue;
      const size = statSync(node.status_file).size;
      const previous = this.db.query("SELECT path, offset FROM status WHERE node = ?").get(node.id) as { path: string; offset: number } | null;
      if (!previous || previous.path !== node.status_file) {
        this.db.query("INSERT OR REPLACE INTO status VALUES (?, ?, ?)").run(node.id, node.status_file, size);
        continue;
      }
      const offset = size < previous.offset ? 0 : previous.offset;
      if (size === offset) continue;
      const bytes = Buffer.alloc(size - offset);
      const fd = openSync(node.status_file, "r");
      let read: number;
      try { read = readSync(fd, bytes, 0, bytes.length, offset); } finally { closeSync(fd); }
      const end = bytes.subarray(0, read).lastIndexOf(10) + 1;
      for (const text of bytes.subarray(0, end).toString("utf8").split("\n").filter((line) => line.trim())) {
        spool({ v: 1, node: node.id, kind: "notice", tag: null, text, file: null, source: "status", session: node.session || null, ts: new Date().toISOString() });
      }
      this.db.query("UPDATE status SET offset = ? WHERE node = ?").run(offset + end, node.id);
    }
  }

  async drain(nodes: Node[]) {
    for (const file of readdirSync(spoolDir).filter((name) => /^\d+-\d+\.json$/.test(name)).sort()) {
      const path = join(spoolDir, file);
      if (this.db.query("SELECT event_id FROM outbox WHERE file = ?").get(file)) { unlinkSync(path); continue; }
      const entry = JSON.parse(readFileSync(path, "utf8")) as Entry;
      validateEntry(entry);
      const routed = outboundRoom(entry, nodes);
      if (routed.node === "proxy" && !process.env.SOCRATES_CHAT_PROXY_PANE) {
        console.log("dropped proxy: proxy not served");
        unlinkSync(path);
        continue;
      }
      const room = this.room(routed.node);
      if (!room) continue;
      const message = formatOutbound({ ...entry, tag: routed.tag }, routed.node);
      const user = this.matrix.user(routed.node);
      const content: Record<string, unknown> = { msgtype: message.msgtype, body: message.body };
      if (message.attachment) {
        const data = entry.file ? readFileSync(entry.file) : Buffer.from(message.text);
        const filename = entry.file ? basename(entry.file) : message.filename;
        const mimetype = entry.file ? Bun.file(entry.file).type || "application/octet-stream" : "text/markdown";
        content.filename = filename;
        content.url = await this.matrix.upload(data, filename, mimetype, user);
        content.info = { mimetype, size: data.length };
      }
      const txn = file.slice(0, -5);
      const event = await this.matrix.send(room.room_id, txn, content, user);
      const posted = (await this.matrix.event(room.room_id, event)).origin_server_ts;
      this.db.query("INSERT INTO outbox (file, txn_id, event_id, node, session, turn_end, posted) VALUES (?, ?, ?, ?, ?, ?, ?)")
        .run(file, txn, event, routed.node, entry.session, Date.parse(entry.ts), posted);
      if (entry.kind === "reply" && entry.session) {
        this.measureReceived(nodes);
        this.db.query(`UPDATE inbound SET turn_end = ?, posted = ? WHERE node = ? AND received IS NOT NULL
          AND received <= ? AND turn_end IS NULL AND event_id IN (SELECT event_id FROM inbound_targets WHERE session = ?)`)
          .run(Date.parse(entry.ts), posted, routed.node, Date.parse(entry.ts), entry.session);
      }
      unlinkSync(path);
      console.log(`posted ${routed.node} ${message.msgtype}`);
    }
  }

  pane(node: string): string[] {
    const proxy = process.env.SOCRATES_CHAT_PROXY_PANE;
    if (node === "proxy" && proxy) {
      const split = proxy.indexOf(":");
      return ["-L", proxy.slice(0, split), "-t", proxy.slice(split + 1)];
    }
    return ["-L", `socrates-${node}`, "-t", node];
  }

  terminal(node: string, command: string, args: string[] = []) {
    const [socketFlag, socket, targetFlag, target] = this.pane(node);
    return Bun.spawnSync(["tmux", socketFlag!, socket!, command, targetFlag!, target!, ...args], { stdout: "pipe", stderr: "ignore" });
  }

  availability(nodes: Node[]) {
    const live: Record<string, boolean> = {};
    const dialogs: Record<string, boolean> = {};
    for (const node of nodes) {
      live[node.id] = node.state === "active" && !node.died && !!node.pid;
      if (live[node.id]) live[node.id] = livePid(node.pid!);
      if (node.id === "proxy") live[node.id] = !!process.env.SOCRATES_CHAT_PROXY_PANE;
      if (live[node.id]) {
        const pane = this.terminal(node.id, "capture-pane", ["-p"]);
        live[node.id] = pane.exitCode === 0;
        dialogs[node.id] = dialogOpen(pane.stdout.toString());
      }
    }
    return { live, dialogs };
  }

  async notice(node: string, txn: string, text: string) {
    const room = this.room(node);
    if (room) await this.matrix.send(room.room_id, txn, { msgtype: node === "proxy" ? "m.text" : "m.notice", body: text }, this.matrix.user(node));
  }

  watchState() {
    const values = <T,>(table: string): T[] => (this.db.query(`SELECT value FROM ${table}`).all() as { value: string }[]).map((row) => JSON.parse(row.value));
    return { watches: values<ChatWatch>("chat_watches"), etas: values<ChatEta>("chat_etas") };
  }

  async watchNode(roomId: string): Promise<string | null> {
    const own = this.rooms().find((room) => room.room_id === roomId);
    if (own) return own.node;
    if (this.watchRooms.has(roomId)) return this.watchRooms.get(roomId)!;
    const state = await this.matrix.request<{ type: string; content: Record<string, any> }[]>("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/state`, undefined, this.matrix.sender);
    const alias = state.find((event) => event.type === "m.room.canonical_alias")?.content.alias;
    const space = state.find((event) => event.type === "m.room.create")?.content.type === "m.space";
    const name = state.find((event) => event.type === "m.room.name")?.content.name;
    const node = !space && typeof alias === "string" && alias.startsWith("#socrates-") && typeof name === "string" ? nodeId(name.replace(/^✔ /, "").toLowerCase()) : null;
    this.watchRooms.set(roomId, node);
    return node;
  }

  async watchTick(timeline: WatchTimeline[] = []) {
    const now = Date.now();
    const targets = new Set(this.watchState().watches.filter((watch) => !watch.ended && /^[^#]+#[1-9]\d*$/.test(watch.target)).map((watch) => watch.target));
    for (const target of targets) {
      const old = this.db.query("SELECT checked, state FROM watch_issues WHERE target = ?").get(target) as { checked: number; state: string } | null;
      if (old && now - old.checked < 60_000) continue;
      this.db.query("INSERT OR REPLACE INTO watch_issues VALUES (?, ?, ?)").run(target, now, old?.state ?? "");
      const [repo, issue] = target.split("#");
      const child = Bun.spawn(["gh", "issue", "view", issue!, "-R", `tompassarelli/${repo}`, "--json", "state"], { stdout: "pipe", stderr: "ignore" });
      const output = await new Response(child.stdout).text();
      if (await child.exited !== 0) { console.log(`watch issue poll failed: ${target}`); continue; }
      const state = JSON.parse(output).state;
      if (state === "OPEN" || state === "CLOSED") this.db.query("UPDATE watch_issues SET state = ? WHERE target = ?").run(state, target);
    }
    const issues = Object.fromEntries((this.db.query("SELECT target, state FROM watch_issues").all() as { target: string; state: string }[]).map((row) => [row.target, row.state]));
    const unseen = timeline.filter(({ event }) => !this.db.query("SELECT event_id FROM watch_events WHERE event_id = ?").get(event.event_id));
    const state = this.watchState();
    const result = decideWatches(state.watches, state.etas, unseen, issues, Date.now(), this.matrix.tom);
    this.db.transaction(() => {
      this.db.exec("DELETE FROM chat_watches; DELETE FROM chat_etas");
      for (const watch of result.watches) this.db.query("INSERT INTO chat_watches VALUES (?, ?)").run(watch.id, JSON.stringify(watch));
      for (const eta of result.etas) this.db.query("INSERT INTO chat_etas VALUES (?, ?)").run(eta.target, JSON.stringify(eta));
      for (const { event } of unseen) this.db.query("INSERT INTO watch_events VALUES (?)").run(event.event_id);
      for (const post of result.posts) this.db.query("INSERT OR IGNORE INTO watch_posts VALUES (?, ?)").run(post.txn, JSON.stringify(post));
    })();
    if (this.postingWatches) return;
    this.postingWatches = true;
    try {
      for (const row of this.db.query("SELECT txn, value FROM watch_posts ORDER BY rowid").all() as { txn: string; value: string }[]) {
        const post = JSON.parse(row.value) as WatchPost;
        await this.matrix.send(post.room_id, post.txn, post.content);
        this.db.query("DELETE FROM watch_posts WHERE txn = ?").run(post.txn);
      }
    } finally { this.postingWatches = false; }
  }

  async inbound(batch: SyncBatch) {
    const nodes = [...bootstrapNodes, ...readNodes()];
    const { live, dialogs } = this.availability(nodes);
    if (this.watchesEnabled) {
      const timeline: WatchTimeline[] = [];
      for (const [roomId, room] of Object.entries(batch.rooms?.join ?? {})) {
        const events = (room.timeline?.events ?? []).filter((event) => event.type === "m.room.message");
        if (!events.length) continue;
        const node = await this.watchNode(roomId);
        if (node) timeline.push(...events.map((event) => ({ room_id: roomId, node, event })));
      }
      await this.watchTick(timeline);
    }
    for (const [roomId, room] of Object.entries(batch.rooms?.join ?? {})) {
      for (const event of room.timeline?.events ?? []) {
        if (this.db.query("SELECT event_id FROM inbound WHERE event_id = ?").get(event.event_id)) continue;
        const queued = this.db.query("SELECT count(*) AS n FROM inbound WHERE node = (SELECT node FROM rooms WHERE room_id = ?) AND state = 'queued'").get(roomId) as { n: number };
        let result = routeInbound(event, roomId, nodes, this.rooms(), this.matrix.tom, live, dialogs, !!process.env.SOCRATES_CHAT_PROXY_PANE, "", queued.n);
        if (result.kind === "watch") continue;
        if (result.kind === "drop") {
          if (result.reason === "sender not Tom") console.log(`dropped: sender not Tom ${event.event_id}`);
          continue;
        }
        if (result.kind === "notice") { await this.notice(result.node, `text-${event.event_id}`, result.text); continue; }
        const relation = event.content["m.relates_to"] as { "m.in_reply_to"?: { event_id?: string } } | undefined;
        const replyId = relation?.["m.in_reply_to"]?.event_id;
        if (replyId) {
          const reply = await this.matrix.event(roomId, replyId);
          result = routeInbound(event, roomId, nodes, this.rooms(), this.matrix.tom, live, dialogs, !!process.env.SOCRATES_CHAT_PROXY_PANE, reply.content.body ?? "", queued.n);
        }
        if (result.kind !== "deliver" && result.kind !== "queue") continue;
        this.db.query("INSERT INTO inbound (event_id, node, state, text, sent) VALUES (?, ?, 'queued', ?, ?)")
          .run(event.event_id, result.node, result.text, event.origin_server_ts);
        if (result.copy) await this.notice("proxy", `copy-${event.event_id}`, result.copy);
        if (result.notice) await this.notice(result.node, `queue-${event.event_id}`, result.notice);
        if (result.wake) {
          const parent = nodes.find((node) => node.id === result.wake!.node);
          if (parent && parent.id !== "proxy") {
            if (!await this.deliver(parent, result.wake.text)) await this.notice("proxy", `wake-${event.event_id}`, result.wake.text);
          }
          else await this.notice("proxy", `wake-${event.event_id}`, result.wake.text);
        }
      }
    }
    await this.deliverQueued(nodes);
  }

  async deliver(node: Node, text: string): Promise<boolean> {
    if (node.provider === "codex") {
      const child = Bun.spawn(["codex-lead", "send", text], {
        env: { ...process.env, CODEX_LEAD_THREAD: node.session }, stdout: "pipe", stderr: "pipe",
      });
      const output = new Response(child.stdout).text();
      const error = new Response(child.stderr).text();
      const code = await child.exited;
      await Promise.all([output, error]);
      return code === 0;
    }
    const pane = this.terminal(node.id, "capture-pane", ["-p"]);
    if (pane.exitCode !== 0 || dialogOpen(pane.stdout.toString()) || !inputReady(pane.stdout.toString())) return false;
    const [flag, socket] = this.pane(node.id);
    const load = Bun.spawnSync(["tmux", flag!, socket!, "load-buffer", "-b", "socrates-chat", "-"], { stdin: Buffer.from(chatText(text)), stderr: "ignore" });
    if (load.exitCode !== 0) return false;
    if (this.terminal(node.id, "paste-buffer", ["-p", "-d", "-b", "socrates-chat"]).exitCode !== 0) return false;
    await Bun.sleep(150);
    return this.terminal(node.id, "send-keys", ["Enter"]).exitCode === 0;
  }

  async deliverQueued(nodes: Node[]) {
    if (this.delivering) return;
    this.delivering = true;
    try {
      const rows = this.db.query("SELECT event_id, node, text FROM inbound WHERE state = 'queued' ORDER BY sent, rowid").all() as { event_id: string; node: string; text: string }[];
      if (!rows.length) return;
      const { live, dialogs } = this.availability(nodes);
      for (const row of rows) {
        const node = nodes.find((node) => node.id === row.node);
        if (!node || !live[row.node] || dialogs[row.node]) continue;
        if (!await this.deliver(node, row.text)) { live[row.node] = false; continue; }
        this.db.query("UPDATE inbound SET state = 'delivered', delivered = ? WHERE event_id = ?").run(Date.now(), row.event_id);
        this.db.query("INSERT OR REPLACE INTO inbound_targets VALUES (?, ?)").run(row.event_id, node.session);
        console.log(`delivered ${row.node}`);
      }
    } finally { this.delivering = false; }
  }

  transcript(node: Node): string | undefined {
    if (this.transcripts.has(node.session)) return this.transcripts.get(node.session);
    let path: string | undefined;
    if (node.provider === "claude") {
      const root = join(process.env.CLAUDE_CONFIG_DIR || join(process.env.HOME!, ".claude"), "projects");
      if (existsSync(root)) path = readdirSync(root).map((dir) => join(root, dir, `${node.session}.jsonl`)).find(existsSync);
    } else {
      const file = join(process.env.NORTH_CODEX_POOLED_HOME || join(process.env.HOME!, ".local/state/north/codex-pooled"), "sqlite/state_5.sqlite");
      if (existsSync(file)) {
        const db = new Database(file, { readonly: true });
        try { path = (db.query("SELECT rollout_path FROM threads WHERE id = ?").get(node.session) as { rollout_path: string } | null)?.rollout_path; }
        finally { db.close(); }
      }
    }
    if (path) this.transcripts.set(node.session, path);
    return path;
  }

  measureReceived(nodes: Node[]) {
    const rows = this.db.query(`SELECT inbound.event_id, inbound.node, text, sent, session FROM inbound
      JOIN inbound_targets USING (event_id) WHERE state = 'delivered' AND received IS NULL`).all() as { event_id: string; node: string; text: string; sent: number; session: string }[];
    for (const row of rows) {
      const node = nodes.find((node) => node.id === row.node);
      if (!node) continue;
      const path = this.transcript({ ...node, session: row.session });
      if (!path || !existsSync(path)) continue;
      const size = statSync(path).size;
      const bytes = Buffer.alloc(Math.min(size, 1024 * 1024));
      const fd = openSync(path, "r");
      try { readSync(fd, bytes, 0, bytes.length, size - bytes.length); } finally { closeSync(fd); }
      for (const line of bytes.toString().split("\n")) {
        let entry: any;
        try { entry = JSON.parse(line); } catch { continue; }
        let text: string | undefined;
        if (entry.type === "user") {
          const content = entry.message?.content;
          text = typeof content === "string" ? content : Array.isArray(content) ? content.filter((part: any) => part.type === "text").map((part: any) => part.text).join("\n") : undefined;
        } else if (entry.type === "event_msg" && entry.payload?.type === "user_message") text = entry.payload.message;
        else if (entry.type === "response_item" && entry.payload?.role === "user") {
          text = entry.payload.content?.filter((part: any) => part.type === "input_text").map((part: any) => part.text).join("\n");
        }
        const received = Date.parse(entry.timestamp);
        if (text && chatText(text).includes(chatText(row.text)) && received >= row.sent) {
          this.db.query("UPDATE inbound SET received = ? WHERE event_id = ?").run(received, row.event_id);
          const reply = this.db.query("SELECT turn_end, posted FROM outbox WHERE node = ? AND session = ? AND turn_end >= ? ORDER BY turn_end LIMIT 1")
            .get(row.node, row.session, received) as { turn_end: number; posted: number } | null;
          if (reply) this.db.query("UPDATE inbound SET turn_end = ?, posted = ? WHERE event_id = ?").run(reply.turn_end, reply.posted, row.event_id);
          break;
        }
      }
    }
  }

  async sync() {
    const cursor = this.db.query("SELECT since FROM sync WHERE key = 'device'").get() as { since: string } | null;
    const batch = await this.matrix.sync(cursor?.since);
    if (cursor) await this.inbound(batch);
    if (cursor && spaceStateChanged(batch)) { this.layoutDue = true; this.changed(); }
    this.db.query("INSERT OR REPLACE INTO sync VALUES ('device', ?)").run(batch.next_batch);
    console.log(`sync ${Object.keys(batch.rooms?.join ?? {}).length} rooms`);
    return batch;
  }

  watchPaths(paths: string[]) {
    const wanted = new Map<string, Set<string> | null>();
    for (const path of paths) {
      const dir = dirname(path);
      if (!existsSync(dir)) continue;
      if (!wanted.has(dir)) wanted.set(dir, new Set());
      wanted.get(dir)?.add(basename(path));
    }
    wanted.set(dirname(orgFile), new Set([basename(orgFile)]));
    wanted.set(spoolDir, null);
    for (const [dir, entry] of this.watchers) {
      if (!wanted.has(dir)) { entry.watcher.close(); this.watchers.delete(dir); }
    }
    for (const [dir, names] of wanted) {
      const entry = this.watchers.get(dir);
      if (entry) { entry.names = names; continue; }
      const next = { names } as { watcher: FSWatcher; names: Set<string> | null };
      try {
        next.watcher = watch(dir, (_, name) => { if (!next.names || next.names.has(name?.toString() ?? "")) this.changed(); });
        this.watchers.set(dir, next);
      } catch {}
    }
  }

  waitPids(pids: number[]) {
    const wanted = new Set(pids);
    for (const [pid, child] of this.waiters) {
      if (!wanted.has(pid)) { this.waiters.delete(pid); child.kill(); }
    }
    for (const pid of wanted) {
      if (this.waiters.has(pid) || !livePid(pid)) continue;
      let child: Bun.Subprocess;
      try { child = Bun.spawn(["waitpid", String(pid)], { stdin: "ignore", stdout: "ignore", stderr: "ignore" }); } catch { continue; }
      this.waiters.set(pid, child);
      child.exited.then(() => { if (this.waiters.get(pid) === child) { this.waiters.delete(pid); this.changed(); } });
    }
  }

  arm(): number {
    const nodes = [...bootstrapNodes, ...readNodes()];
    const pending = this.db.query("SELECT DISTINCT inbound.node, session FROM inbound JOIN inbound_targets USING (event_id) WHERE state = 'delivered' AND received IS NULL").all() as { node: string; session: string }[];
    const transcripts = pending.flatMap((row) => {
      const node = nodes.find((node) => node.id === row.node);
      const path = node && this.transcript({ ...node, session: row.session });
      return path ? [path] : [];
    });
    const status = nodes.filter((node) => node.state === "active" && node.status_file).map((node) => node.status_file!);
    this.watchPaths([...status, ...transcripts]);
    this.waitPids(nodes.filter((node) => node.state === "active" && node.pid).map((node) => node.pid!));
    const queued = this.db.query("SELECT count(*) AS n FROM inbound WHERE state = 'queued'").get() as { n: number };
    return restDelay(queued.n, this.watchesEnabled ? this.watchState().watches : []);
  }

  async run() {
    mkdirSync(spoolDir, { recursive: true });
    mkdirSync(dirname(orgFile), { recursive: true });
    await this.bootstrap();
    let dirty = false;
    let wake: (() => void) | undefined;
    this.changed = () => { dirty = true; wake?.(); };
    const reconcile = async () => {
      while (true) {
        dirty = false;
        await this.reconcile();
        const delay = this.arm();
        if (!dirty) await new Promise<void>((resolve) => {
          const timer = setTimeout(() => { wake = undefined; resolve(); }, delay);
          wake = () => { clearTimeout(timer); wake = undefined; resolve(); };
        });
      }
    };
    try { await Promise.all([reconcile(), (async () => { while (true) await this.sync(); })()]); }
    finally {
      for (const entry of this.watchers.values()) entry.watcher.close();
      for (const child of this.waiters.values()) child.kill();
    }
  }
}

function take(argv: string[], option: string): string | undefined {
  const index = argv.indexOf(option);
  if (index === -1) return;
  if (index + 1 === argv.length) throw new Error(`${option} requires a value`);
  return argv.splice(index, 2)[1];
}

async function input(argv: string[]): Promise<string> { return argv.length === 1 && argv[0] === "-" ? Bun.stdin.text() : argv.join(" "); }
const nodeId = (id: string) => id === "plato" ? "proxy" : id;

async function main(argv: string[]) {
  const command = argv.shift();
  if (!command || ["help", "--help", "-h"].includes(command)) { console.log(USAGE); return; }
  if (command === "replay") {
    const data = JSON.parse(argv[0] ? readFileSync(argv[0], "utf8") : await Bun.stdin.text());
    const nodes = data.nodes ?? data.org?.nodes ?? [];
    if (data.inbound) {
      console.log(JSON.stringify(data.inbound.map((input: any) => routeInbound(input.event, input.room_id, nodes,
        data.rooms ?? [], data.tom, data.live ?? {}, data.dialogs ?? {}, data.proxyPane ?? false, input.reply ?? "", input.queued ?? 0))));
      return;
    }
    console.log(JSON.stringify([...decide(nodes, data.rooms ?? [], data.live ?? {}),
      ...(data.spaces ? [
        ...decideSpaces(nodes, data.rooms ?? [], data.spaces, data.children ?? [], data.server).map((action) => ({ kind: "space", ...action })),
        ...decideParents(nodes, data.rooms ?? [], data.spaces, data.parents ?? [], data.server).map((action) => ({ kind: "parent", ...action })),
      ] : [])]));
    return;
  }
  if (command === "post") {
    const node = nodeId(take(argv, "--as") || process.env.AGENT_ORG_NAME || "proxy");
    const kind = take(argv, "--kind") || "reply";
    const tag = take(argv, "--tag") ?? null;
    const file = take(argv, "--file") ?? null;
    const source = take(argv, "--source") || "cli";
    const session = take(argv, "--session") ?? null;
    const text = await input(argv);
    if (!text && !file) throw new Error("post requires text or a file");
    console.log(spool({ v: 1, node, kind, tag, text, file, source, session, ts: new Date().toISOString() } as Entry));
    return;
  }
  if (command === "avatar") {
    if (argv.length !== 2 || !/^[#!]/.test(argv[0]!)) throw new Error("avatar requires a room alias or id and a file");
    const matrix = new Matrix(await appserviceToken());
    await matrix.identify();
    const room = argv[0]!.startsWith("#") ? await matrix.resolve(argv[0]!) : argv[0]!;
    if (!room) throw new Error("avatar room alias is missing");
    const file = Bun.file(argv[1]!);
    const uri = await matrix.upload(new Uint8Array(await file.arrayBuffer()), basename(argv[1]!), file.type || "application/octet-stream", matrix.sender);
    await matrix.state(room, "m.room.avatar", "", { url: uri });
    console.log(uri);
    return;
  }
  if (!["run", "rooms", "log", "latency", "probe"].includes(command)) throw new Error(USAGE);
  const db = ledger();
  const json = argv.includes("--json");
  const count = Number(take(argv, "--last") || "10");
  if (!Number.isSafeInteger(count) || count < 1) throw new Error("--last requires a positive integer");
  if (command === "rooms") {
    const rooms = db.query(`SELECT rooms.*, room_spaces.space, parent.room_id AS parent FROM rooms
      LEFT JOIN room_spaces USING (room_id) LEFT JOIN space_rooms AS parent ON parent.space = room_spaces.space
      UNION ALL SELECT space_rooms.node, ?, space_rooms.room_id, 'active', space_rooms.tom, room_spaces.space, parent.room_id
      FROM space_rooms LEFT JOIN room_spaces USING (room_id) LEFT JOIN space_rooms AS parent ON parent.space = room_spaces.space
      ORDER BY node`).all(host) as (Room & { space: string | null; parent: string | null })[];
    console.log(json ? JSON.stringify(rooms) : rooms.map((room) => `${displayname(room.node)} ${room.state} tom:${room.tom} ${room.room_id} ${room.space ?? ""}`).join("\n"));
  } else if (command === "latency") {
    const rows = db.query("SELECT event_id, node, sent, delivered, received, turn_end, posted, received - sent AS received_ms, posted - turn_end AS reply_ms FROM inbound ORDER BY sent DESC LIMIT ?").all(count);
    console.log(json ? JSON.stringify(rows) : rows.map((row: any) => `${row.node} received:${row.received_ms ?? "pending"}ms reply:${row.reply_ms ?? "pending"}ms`).join("\n"));
  } else {
    const matrix = new Matrix(await appserviceToken());
    const relay = new Relay(db, matrix);
    if (command === "run") { await relay.run(); return; }
    await matrix.identify();
    const node = nodeId(argv.shift() || "");
    const room = relay.room(node);
    if (!room) throw new Error("node has no cached room; start the relay first");
    if (command === "probe") {
      const text = await input(argv);
      if (!text) throw new Error("probe requires text");
      const event = await matrix.probe(room.room_id, text);
      console.log(event);
    } else {
      const result = await matrix.request<{ chunk: Event[] }>("GET", `/_matrix/client/v3/rooms/${encodeURIComponent(room.room_id)}/messages`, undefined, matrix.sender, {
        dir: "b", limit: String(count), filter: JSON.stringify({ types: ["m.room.message"] }),
      });
      console.log(json ? JSON.stringify(result.chunk) : result.chunk.map((event) => `${new Date(event.origin_server_ts).toISOString()} ${event.content.msgtype} ${event.content.body}`).join("\n"));
    }
  }
  db.close();
}

if (import.meta.main) {
  try { await main(process.argv.slice(2)); }
  catch (error) { console.error(`socrates-chat: ${(error as Error).message}`); process.exit(1); }
}
