#!/usr/bin/env bb
;; North MCP server — the AI-facing edge of one instance.
;;
;; Speaks MCP (JSON-RPC 2.0, newline-delimited, over stdio) and maps each tool
;; call to the existing `north` engine, so it reuses every tested op and the
;; canonical Store RPC path. A consumer chat AI connects, gets the
;; tools + the cheatsheet (server `instructions`), and never touches a CLI.
;;
;; Config (per instance, via env — the same vars the engine reads):
;;   NORTH_BIN   path to the engine wrapper to invoke (default: sibling `north`)
;;   canonical Store RPC endpoint + BEAGLE_STORE_THREADS / provenance vars passed through
;;
;; Transport here is stdio (local, zero-setup). HTTP/SSE + auth is the next layer.
(require '[cheshire.core :as json]
         '[babashka.process :as proc]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def here (-> *file* io/file .getCanonicalFile .getParentFile))
(def engine (or (System/getenv "NORTH_BIN") (str here "/north")))
(load-file (str (.getParentFile here) "/cli/managed-child-env.clj"))
(load-file (str (.getParentFile here) "/cli/orchestration-staffing.clj"))

;; The `instructions` block teaches the FACT MODEL + cross-tool norms ONCE —
;; things no single tool description can carry. Per-verb "what it does" lives in
;; each tool's own description (tools/list), so it is NOT repeated here; doing so
;; paid the same bytes twice on every request.
(def cheatsheet
  (str
   "North is a fact-native substrate for coordinating work and life. Every fact "
   "is a triple (subject predicate object); a thread is any id that has a `title`. "
   "Lifecycle is DERIVED from facts, never stored: committed=accepted, outcome=done, "
   "abandoned=canceled, driver=active, depends_on=blocked. Facts record what was "
   "ASSERTED, not verified — supersession, retraction, and views handle disagreement.\n\n"
   "Refs to other threads are written @<id> (e.g. depends_on @2026-06-16-101500); "
   "everything else is a literal. ids look like 2026-06-16-101500.\n\n"
   "Prefer `capture` for new work and `tell`/`retract` for changes; every write is "
   "serialized and rule-checked, so just state facts and let the engine enforce integrity. "
   "The canonical multi-agent flow: capture a thread -> tell it facts -> dispatch it.\n\n"
   "PRESENTATION CONTRACT: list tools return an `emoji` field per item. Render each item "
   "with its given `emoji`; do NOT invent your own. Keep it terse, group by project, lead "
   "with active work. To change a glyph: tell @ui emoji_<condition> \"<glyph>\" "
   "(conditions: active/ready/blocked/draft)."))

;; tool name -> {desc, schema, argv}. argv maps the JSON arguments map (string
;; keys) to the engine argument vector.
(def read-external-annotations
  {:readOnlyHint true :destructiveHint false :idempotentHint true :openWorldHint true})
(def read-local-annotations
  {:readOnlyHint true :destructiveHint false :idempotentHint true :openWorldHint false})
(def local-write-annotations
  {:readOnlyHint false :destructiveHint false :idempotentHint true :openWorldHint true})
(def remote-write-annotations
  {:readOnlyHint false :destructiveHint true :idempotentHint false :openWorldHint true})
(def server-property
  {:type "string" :minLength 1 :description "Optional configured Linear MCP server name"})

(def evidence-argument-keys #{"bar" "observed"})
(def page-argument-keys #{"offset" "limit" "snapshot" "itemByteOffset"})
(def max-page-offset 2147483647)
(def max-page-limit 100)
(def max-page-response-bytes 65536)
(def artifact-read-argument-keys #{"artifactId" "offset" "limit" "snapshot"})
(def max-artifact-read-limit 65536)

(defn page-argument-problem [arguments required-keys]
  (if-not (map? arguments)
    "arguments must be an object"
    (let [allowed (into page-argument-keys required-keys)
          unknown (sort (remove allowed (keys arguments)))
          offset (get arguments "offset" 0)
          limit (get arguments "limit" 50)
          snapshot (get arguments "snapshot")
          item-byte-offset (get arguments "itemByteOffset" 0)]
      (cond
        (seq unknown) (str "unknown arguments: " (str/join ", " unknown))
        (not (and (integer? offset) (<= 0 offset max-page-offset)))
        "offset must be an integer from 0 through 2147483647"
        (not (and (integer? limit) (<= 1 limit max-page-limit)))
        "limit must be an integer from 1 through 100"
        (not (and (integer? item-byte-offset)
                  (<= 0 item-byte-offset max-page-offset)))
        "itemByteOffset must be an integer from 0 through 2147483647"
        (and (some? snapshot)
             (not (and (string? snapshot) (re-matches #"[0-9a-f]{64}" snapshot))))
        "snapshot must be a 64-character lowercase SHA-256 hash"
        (and (pos? item-byte-offset) (nil? snapshot))
        "itemByteOffset requires snapshot"
        :else nil))))

(defn show-argument-problem [arguments]
  (or (page-argument-problem arguments #{"id"})
      (when-not (and (string? (get arguments "id"))
                     (not (str/blank? (get arguments "id"))))
        "id must be a non-empty string")))

(defn search-argument-problem [arguments]
  (or (page-argument-problem arguments #{"query"})
      (when-not (and (string? (get arguments "query"))
                     (not (str/blank? (get arguments "query"))))
        "query must be a non-empty string")))

(defn artifact-read-argument-problem [arguments]
  (if-not (map? arguments)
    "arguments must be an object"
    (let [unknown (sort (remove artifact-read-argument-keys (keys arguments)))
          artifact-id (get arguments "artifactId")
          offset (get arguments "offset" 0)
          limit (get arguments "limit" 16384)
          snapshot (get arguments "snapshot")]
      (cond
        (seq unknown) (str "unknown artifact_read arguments: " (str/join ", " unknown))
        (not (and (string? artifact-id)
                  (re-matches #"[A-Za-z0-9@][A-Za-z0-9@_.:/-]{0,255}" artifact-id)))
        "artifactId must be a valid Wire artifact ID"
        (not (and (integer? offset) (<= 0 offset max-page-offset)))
        "offset must be an integer from 0 through 2147483647"
        (not (and (integer? limit) (<= 1 limit max-artifact-read-limit)))
        "limit must be an integer from 1 through 65536"
        (and (some? snapshot)
             (not (and (string? snapshot) (re-matches #"[0-9a-f]{64}" snapshot))))
        "snapshot must be a 64-character lowercase SHA-256 hash"
        :else nil))))

(defn evidence-argument-problem [arguments]
  (cond
    (not (map? arguments)) "arguments must be an object"
    (seq (remove evidence-argument-keys (keys arguments)))
    (str "unknown evidence_record arguments: "
         (str/join ", " (sort (remove evidence-argument-keys (keys arguments)))))
    (not (and (string? (get arguments "bar"))
              (not (str/blank? (get arguments "bar")))))
    "bar must be a non-empty string"
    (not (and (string? (get arguments "observed"))
              (not (str/blank? (get arguments "observed")))))
    "observed must be a non-empty string"
    :else nil))

(defn linear-sync-argument-problem [arguments]
  (let [expected (get arguments "expectedPlanHash")]
    (cond
      (and (some? expected)
           (not (and (string? expected)
                     (or (= expected "none")
                         (re-matches #"[0-9a-f]{64}" expected)))))
      "expectedPlanHash must be 'none' or a 64-character lowercase SHA-256 hash"
      (and (some? expected) (not (true? (get arguments "apply"))))
      "expectedPlanHash requires apply=true"
      :else nil)))

(def tools
  [{:name "ready"        :desc "Threads doable now (committed, unblocked, not active, not done). Default: kind=thread, top-15 by leverage. Pass all=true for the full unscoped list. Returns JSON [{id,title,condition,emoji}]."
    :schema {:type "object" :properties {:all {:type "boolean" :description "return every ready thread, unscoped (default false: kind=thread top-15 by leverage)"}}}
    :argv (fn [a] (if (get a "all") ["json" "ready" "--all"] ["json" "ready"]))}
   {:name "next"         :desc "The recommended next thread(s) to pull."
    :schema {:type "object" :properties {}} :argv (fn [_] ["next"])}
   {:name "threads"      :desc "Open threads, kanban view. Default: the curated slice (kind=thread; live-active + top-15 ready by leverage). Pass all=true for every open thread unscoped. Returns JSON [{id,title,condition,emoji}] where condition is active/ready/blocked/draft."
    :schema {:type "object" :properties {:all {:type "boolean" :description "return every open thread, unscoped (default false: curated active + top-15 ready)"}}}
    :argv (fn [a] (if (get a "all") ["json" "board" "--all"] ["json" "board"]))}
   {:name "blocked"      :desc "Threads waiting on an unresolved dependency. Returns JSON [{id,title,condition}]."
    :schema {:type "object" :properties {}} :argv (fn [_] ["json" "blocked"])}
   {:name "agenda"       :desc "Calendar view: threads bucketed by do_on (overdue/today/upcoming)."
    :schema {:type "object" :properties {}} :argv (fn [_] ["agenda"])}
   {:name "leverage"     :desc "High-leverage threads — finishing them unblocks the most downstream work."
    :schema {:type "object" :properties {}} :argv (fn [_] ["leverage"])}
   {:name "needs_review" :desc "Belief-revision queue: judgments whose inputs moved. Returns JSON [{id,title,pred,detail}]."
    :schema {:type "object" :properties {}} :argv (fn [_] ["json" "needs-review"])}
   {:name "validate"     :desc "Integrity check over the whole graph."
    :schema {:type "object" :properties {}} :argv (fn [_] ["validate"])}
   {:name "show"         :desc "Show one graph subject's facts in a JSON-RPC response bounded to 65536 serialized UTF-8 bytes. Oversized items are returned as lossless JSON fragments. Continue with nextOffset, nextItemByteOffset when present, and the returned snapshot; a changed projection rejects the continuation."
    :schema {:type "object"
             :properties {:id {:type "string" :minLength 1}
                          :offset {:type "integer" :minimum 0 :maximum 2147483647 :default 0}
                          :limit {:type "integer" :minimum 1 :maximum 100 :default 50}
                          :itemByteOffset {:type "integer" :minimum 0 :maximum 2147483647 :default 0
                                           :description "exact UTF-8 byte continuation inside an oversized JSON item; use only nextItemByteOffset"}
                          :snapshot {:type "string" :pattern "^[0-9a-f]{64}$"}}
             :required ["id"] :additionalProperties false}
    :argument-problem show-argument-problem
    :argv (fn [a] ["json" "show" (get a "id")])}
   {:name "search"       :desc "Case-insensitive literal search over private North graph titles, predicates, and values. Returns deterministic subject-diverse pages in JSON-RPC responses bounded to 65536 serialized UTF-8 bytes; oversized items use lossless JSON fragments."
    :schema {:type "object"
             :properties {:query {:type "string" :minLength 1}
                          :offset {:type "integer" :minimum 0 :maximum 2147483647 :default 0}
                          :limit {:type "integer" :minimum 1 :maximum 100 :default 50}
                          :itemByteOffset {:type "integer" :minimum 0 :maximum 2147483647 :default 0
                                           :description "exact UTF-8 byte continuation inside an oversized JSON item; use only nextItemByteOffset"}
                          :snapshot {:type "string" :pattern "^[0-9a-f]{64}$"}}
             :required ["query"] :additionalProperties false}
    :argument-problem search-argument-problem
    :argv (fn [a] ["json" "search" (get a "query")])}
   {:name "artifact_read"
    :desc "Read a bounded UTF-8 page from one artifact retained by this managed run. offset, limit, total, and nextOffset count UTF-8 bytes. Continue only with nextOffset and the returned snapshot; a changed artifact rejects the continuation."
    :schema {:type "object"
             :properties {:artifactId {:type "string" :pattern "^[A-Za-z0-9@][A-Za-z0-9@_.:/-]{0,255}$"}
                          :offset {:type "integer" :minimum 0 :maximum 2147483647 :default 0 :description "UTF-8 byte offset; use only a returned nextOffset"}
                          :limit {:type "integer" :minimum 1 :maximum 65536 :default 16384 :description "maximum UTF-8 content bytes"}
                          :snapshot {:type "string" :pattern "^[0-9a-f]{64}$"}}
             :required ["artifactId"] :additionalProperties false}
    :annotations read-local-annotations
    :argument-problem artifact-read-argument-problem}
   {:name "capture"      :desc "Create a new thread from a title (a thought or unit of work)."
    :schema {:type "object" :properties {:title {:type "string"}
                                         :owner {:type "string" :description "defaults to personal"}}
             :required ["title"]}
    :argv (fn [a] ["capture" (get a "title") (get a "owner" "personal")])}
   {:name "tell"         :desc "Add or replace one fact about a thread. For thread refs (depends_on/part_of/relates_to) pass the bare target id; the engine adds the @."
    :schema {:type "object" :properties {:id {:type "string"}
                                         :predicate {:type "string"}
                                         :value {:type "string"}}
             :required ["id" "predicate" "value"]}
    :argv (fn [a] ["tell" (get a "id") (get a "predicate") (get a "value")])}
   {:name "evidence_record"
    :desc "Record an observed result for one exact done_when bar on this managed run. Run, thread, reporter, capability, North port, and Beagle Store log are derived from the managed environment; callers supply only bar and observed."
    :schema {:type "object"
             :properties {:bar {:type "string" :minLength 1}
                          :observed {:type "string" :minLength 1}}
             :required ["bar" "observed"]
             :additionalProperties false}
    :annotations local-write-annotations
    :argument-problem evidence-argument-problem
    :argv (fn [a] ["evidence" "record" (get a "bar") (get a "observed")])}
   {:name "retract"      :desc "Retract one fact about a thread."
    :schema {:type "object" :properties {:id {:type "string"}
                                         :predicate {:type "string"}
                                         :value {:type "string"}}
             :required ["id" "predicate" "value"]}
    :argv (fn [a] ["retract" (get a "id") (get a "predicate") (get a "value")])}
   {:name "presentation" :desc "The effective emoji map (condition -> glyph), engine defaults + user overrides. Returns JSON {active,ready,blocked,draft}."
    :schema {:type "object" :properties {}} :argv (fn [_] ["json" "presentation"])}
   {:name "linear_get"
    :desc "Read one Linear issue mechanically through North. Returns the CLI JSON unchanged; does not start a model turn."
    :schema {:type "object"
             :properties {:issue {:type "string" :minLength 1}
                          :server server-property}
             :required ["issue"] :additionalProperties false}
    :annotations read-external-annotations
    :argv (fn [a] (cond-> ["linear" "get" (get a "issue")]
                    (get a "server") (conj "--server" (get a "server"))))}
   {:name "linear_import"
    :desc "Import one Linear issue into North mechanically. Mutates only North's local graph and is idempotent by persisted North-Linear link identity."
    :schema {:type "object"
             :properties {:issue {:type "string" :minLength 1}
                          :server server-property}
             :required ["issue"] :additionalProperties false}
    :annotations local-write-annotations
    :argv (fn [a] (cond-> ["linear" "import" (get a "issue")]
                    (get a "server") (conj "--server" (get a "server"))))}
   {:name "linear_plan"
    :desc "Compute a read-only North-to-Linear synchronization plan for one thread. Returns JSON and performs no writes."
    :schema {:type "object"
             :properties {:thread {:type "string" :minLength 1}
                          :server server-property}
             :required ["thread"] :additionalProperties false}
    :annotations read-external-annotations
    :argv (fn [a] (cond-> ["linear" "plan" (get a "thread")]
                    (get a "server") (conj "--server" (get a "server"))))}
   {:name "linear_sync"
    :desc "Plan synchronization for one North thread. Remote writes occur only when apply=true; expectedPlanHash makes apply compare the freshly locked plan before mutation."
    :schema {:type "object"
             :properties {:thread {:type "string" :minLength 1}
                          :apply {:type "boolean" :description "Apply the plan to Linear (default false)"}
                          :expectedPlanHash {:type "string"
                                             :pattern "^(none|[0-9a-f]{64})$"
                                             :description "Require this exact fresh plan hash, or none for an in-sync no-op"}
                          :server server-property}
             :required ["thread"] :additionalProperties false}
    :annotations remote-write-annotations
    :argument-problem linear-sync-argument-problem
    :argv (fn [a] (cond-> ["linear" "sync" (get a "thread")]
                    (true? (get a "apply")) (conj "--apply")
                    (get a "expectedPlanHash") (conj "--expect-plan-hash" (get a "expectedPlanHash"))
                    (get a "server") (conj "--server" (get a "server"))))}])

;; --- SDK agent tools (dispatch/spawn) — shell out to bun, not the engine ----
(def root (str (.getParent (io/file (str here)))))
(load-file (str root "/cli/spawn-process.clj"))
(load-file (str root "/cli/topology-authority.clj"))
(def sdk-dir (str root "/sdk/src"))
(def bun (or (System/getenv "NORTH_MCP_BUN") "bun"))
(def policy-bun (or (System/getenv "NORTH_POLICY_BUN") "bun"))
(def driver-bb (or (System/getenv "NORTH_MCP_BB") "bb"))
(def driver-cli (str root "/cli/acquire-cli.clj"))
(def north-port (or (System/getenv "NORTH_PORT") "7977"))
(def route-preflight (str sdk-dir "/mcp-route-preflight.ts"))
(def routing-economics-preflight (str sdk-dir "/routing-economics-preflight-cli.ts"))
(def struggle-policy-cli (str sdk-dir "/struggle.ts"))
(def artifact-read-cli (str sdk-dir "/run-artifact-read-cli.ts"))
(def orchestration-staffing-path
  (or (System/getenv "ORCHESTRATION_STAFFING_CATALOG")
      (str (or (System/getenv "AGENT_MACHINERY_HOME")
               (str (System/getenv "HOME") "/code/agent-machinery/main"))
           "/staffing/catalog.json")))
(def orchestration-staffing
  (try (north.orchestration-staffing/load-catalog orchestration-staffing-path)
       (catch Exception _ nil)))
(def orchestration-role-names
  (set (keep #(get % "name") (get orchestration-staffing "presets"))))
(def orchestration-presets-by-name
  (north.orchestration-staffing/presets-by-name orchestration-staffing))

(def task-grade-values ["novice" "junior" "mid" "senior" "staff" "principal" "research-grade"])
(def topology-values ["worker" "orchestrator"])
(def tier-values ["economy" "standard" "senior" "frontier"])
(def reasoning-values ["low" "medium" "high" "xhigh" "max"])
(def posture-values
  (vec (or (get-in orchestration-staffing ["vocabulary" "postures"]) [])))
(def role-id-pattern "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$")
(def capability-values
  (vec (or (get-in orchestration-staffing ["vocabulary" "capabilities"]) [])))
(def capabilities-schema
  {:type "array" :minItems 1 :uniqueItems true
   :items {:type "string" :enum capability-values}})
(def non-empty-strings-schema
  {:type "array" :minItems 1 :uniqueItems true :items {:type "string" :minLength 1}})
(def bespoke-contract-schema
  {:type "object"
   :properties {:responsibility {:type "string" :minLength 1}
                :deliverable {:type "string" :minLength 1}
                :capabilities capabilities-schema
                :mayDecide non-empty-strings-schema
                :mustEscalate non-empty-strings-schema
                :doneWhen non-empty-strings-schema
                :report {:type "string" :minLength 1}}
   :required ["responsibility" "deliverable" "capabilities" "mayDecide" "mustEscalate" "doneWhen" "report"]
   :additionalProperties false})
(def composition-schema
  {:oneOf
   [{:type "object"
     :properties {:kind {:const "template"}
                  :id {:type "string" :pattern role-id-pattern :not {:enum ["researcher"]}}
                  :overrides {:type "array" :uniqueItems true
                              :items {:type "string" :enum ["taskGrade" "domainRequirements" "tier" "reasoning" "posture"]}}
                  :overrideReason {:type "string" :minLength 1}}
     :required ["kind" "id" "overrides"]
     :allOf [{:if {:properties {:overrides {:minItems 1}} :required ["overrides"]}
              :then {:required ["overrideReason"]}
              :else {:not {:required ["overrideReason"]}}}]
     :additionalProperties false}
    {:type "object"
     :properties {:kind {:const "bespoke"}
                  :id {:type "string" :pattern role-id-pattern :not {:enum ["researcher"]}}
                  :nearestTemplate {:type "string" :pattern role-id-pattern :not {:enum ["researcher"]}}
                  :bespokeReason {:type "string" :minLength 1}
                  :promotionCandidate {:type "boolean"}
                  :contract bespoke-contract-schema}
     :required ["kind" "id" "bespokeReason" "promotionCandidate" "contract"]
     :additionalProperties false}]})
(def routing-properties
  {:taskGrade {:type "string" :enum task-grade-values :description "Real-world work grade; independent of model tier"}
   :domainRequirements {:type "array" :uniqueItems true :items {:type "string" :minLength 1} :description "Expertise/context the brief or adapter must supply; metadata alone loads nothing"}
   :topology {:type "string" :enum topology-values :description "Lane's coordination position; fixed by stock templates and explicit for bespoke compositions"}
   :composition composition-schema})
(def assessment-signal-schema
  {:type "object"
   :properties {:decisionOwnership {:type "string" :enum ["none" "bounded" "cross-boundary" "system-shaping" "open-solution-class"]}
                :seamScope {:type "string" :enum ["none" "established" "consequential" "system-wide"]}
                :errorExposure {:type "string" :enum ["contained-reversible" "material-recoverable" "high-or-hard-to-reverse"]}
                :oracleStrength {:type "string" :enum ["not-applicable" "objective-local" "objective-end-to-end" "partial" "judgment-only"]}
                :foundationalImpact {:type "string" :enum ["none" "implementation-only" "invariant-decision-owned"]}
                :dependencyShape {:type "string" :enum ["atomic-cohesive" "deterministic-workflow" "parallel-breadth" "dynamic-decomposition" "tightly-coupled-sequential"]}
                :reasoningShape {:type "string" :enum ["deterministic" "bounded-branching" "multi-hypothesis" "system-synthesis" "exceptional"]}}
   :required ["decisionOwnership" "seamScope" "errorExposure" "oracleStrength"
              "foundationalImpact" "dependencyShape" "reasoningShape"]
   :additionalProperties false})
(def routing-assessment-schema
  {:type "object"
   :properties {:$schema {:type "string" :minLength 1}
                :version {:const "minimum-sufficient-v1"}
                :signals assessment-signal-schema
                :derived {:type "object"
                          :properties {:minimumTier {:type "string" :enum tier-values}
                                       :minimumReasoning {:type "string" :enum reasoning-values}
                                       :ruleCodes non-empty-strings-schema}
                          :required ["minimumTier" "minimumReasoning" "ruleCodes"]
                          :additionalProperties false}
                :selected {:type "object"
                           :properties {:tier {:type "string" :enum tier-values}
                                        :reasoning {:type "string" :enum reasoning-values}}
                           :required ["tier" "reasoning"]
                           :additionalProperties false}
                :exception {:type "object"
                            :properties {:code {:type "string" :enum ["explicit-human-floor" "recent-lower-tier-failure" "calibration-experiment" "unmodeled-risk"]}
                                         :detail {:type "string" :minLength 1}}
                            :required ["code" "detail"]
                            :additionalProperties false}
                :exceptionalDeliberation {:type "string" :minLength 1}}
   :required ["version" "signals" "derived" "selected"]
   :additionalProperties false})
(def routing-pin-evidence-schema
  {:type "object"
   :description "Fresh north-routing-pin-v1 evidence whose typed pins exactly match every explicit provider, target/account, or model selector. Required whenever automatic routing is overridden."
   :properties {:policyVersion {:const "north-routing-pin-v1"}
                :issuedAt {:type "string" :format "date-time"}
                :expiresAt {:type "string" :format "date-time"}
                :reasonCode {:type "string" :enum ["explicit-human-request" "provider-recovery" "capability-requirement" "calibration-experiment"]}
                :detail {:type "string" :minLength 1}
                :pins {:type "array" :minItems 1 :maxItems 3 :uniqueItems true
                       :items {:type "object"
                               :properties {:kind {:type "string" :enum ["provider" "account" "model"]}
                                            :value {:type "string" :minLength 1}}
                               :required ["kind" "value"]
                               :additionalProperties false}}}
   :required ["policyVersion" "issuedAt" "expiresAt" "reasonCode" "detail" "pins"]
   :additionalProperties false})

(def sdk-tools
  [{:name "dispatch"
    :desc "Dispatch an agent for a thread (must exist — capture first). For automatic routing, omit model and target and omit provider or use auto. Selecting anthropic/openai or supplying any target/model requires fresh exact typed pinEvidence. Returns the agent ID."
    ;; Property ORDER is load-bearing, not cosmetic: cheshire serializes a map in
    ;; its seq order, and a >8-key literal `{}` is a PersistentHashMap (scrambled,
    ;; unstable). `array-map` pins insertion order so tools/list advertises the work
    ;; identifier first, then the eight Orchestration routing fields contiguously, then the
    ;; optional compat/provider fields. Anti-rot: mcp-dispatch-contract.test.ts.
    :schema {:type "object"
             :properties (array-map
                          :id {:type "string" :minLength 1 :description "Thread ID to dispatch (e.g. 2026-06-27-193317)"}
                          :role {:type "string" :pattern role-id-pattern :not {:enum ["researcher"]} :description "Functional responsibility from Orchestration's staffing catalog, or a reasoned bespoke role."}
                          :taskGrade (:taskGrade routing-properties)
                          :domainRequirements (:domainRequirements routing-properties)
                          :topology (:topology routing-properties)
                          :tier {:type "string" :enum ["economy" "standard" "senior" "frontier"] :description "Provider-neutral capability tier"}
                          :reasoning {:type "string" :enum reasoning-values :description "Provider-neutral deliberation; independent of role and tier"}
                          :posture {:type "string" :enum posture-values}
                          :composition (:composition routing-properties)
                          :routingAssessment routing-assessment-schema
                          :pinEvidence routing-pin-evidence-schema
                          :model {:type "string" :minLength 1 :description "Exact model selector. Omit for automatic routing; supplying it requires fresh pinEvidence with an exact matching model pin."}
                          :effort {:type "string" :enum reasoning-values :description "Compatibility alias for reasoning"}
                          :provider {:type "string" :enum ["auto" "anthropic" "openai"] :description "Omit or use auto for automatic routing. Selecting anthropic/openai requires fresh pinEvidence with an exact matching provider pin."}
                          :target {:type "string" :minLength 1 :description "Exact configured routing target/account selector. Omit for automatic routing; supplying it requires fresh pinEvidence with an exact matching account pin and never falls back."}
                          :tokenTarget {:type "integer" :minimum 1 :maximum 9007199254740991 :description "Optional exact-accounted run token target. Enforced between completed model calls; one call may overshoot it."}
                          :coordinator {:type "string" :minLength 1 :description "Caller's north id; the lane pings it on done/death + records a `coordinator` fact. Omit to inherit from AGENT_ID/NORTH_AGENT_ID env; pass explicitly from an interactive session."})
             :required ["id" "role" "taskGrade" "domainRequirements" "topology"
                        "tier" "reasoning" "posture" "composition"]
             :additionalProperties false}}
   {:name "spawn"
    :desc "Spawn an ad-hoc agent from a prompt (no thread needed; for thread work prefer capture+dispatch). For automatic routing, omit model and target and omit provider or use auto. Selecting anthropic/openai or supplying any target/model requires fresh exact typed pinEvidence. Returns the agent ID."
    ;; Same deterministic contract as dispatch (see note there): work identifier
    ;; (prompt) first, then the eight Orchestration routing fields, then optional fields.
    :schema {:type "object"
             :properties (array-map
                          :prompt {:type "string" :minLength 1 :description "The task prompt"}
                          :role {:type "string" :pattern role-id-pattern :not {:enum ["researcher"]} :description "Functional responsibility from Orchestration's staffing catalog, or a reasoned bespoke role."}
                          :taskGrade (:taskGrade routing-properties)
                          :domainRequirements (:domainRequirements routing-properties)
                          :topology (:topology routing-properties)
                          :tier {:type "string" :enum ["economy" "standard" "senior" "frontier"] :description "Provider-neutral capability tier"}
                          :reasoning {:type "string" :enum reasoning-values :description "Provider-neutral deliberation; independent of role and tier"}
                          :posture {:type "string" :enum posture-values}
                          :composition (:composition routing-properties)
                          :routingAssessment routing-assessment-schema
                          :pinEvidence routing-pin-evidence-schema
                          :model {:type "string" :minLength 1 :description "Exact model selector. Omit for automatic routing; supplying it requires fresh pinEvidence with an exact matching model pin."}
                          :effort {:type "string" :enum reasoning-values :description "Compatibility alias for reasoning"}
                          :provider {:type "string" :enum ["auto" "anthropic" "openai"] :description "Omit or use auto for automatic routing. Selecting anthropic/openai requires fresh pinEvidence with an exact matching provider pin."}
                          :target {:type "string" :minLength 1 :description "Exact configured routing target/account selector. Omit for automatic routing; supplying it requires fresh pinEvidence with an exact matching account pin and never falls back."}
                          :caveman {:type "string" :enum ["off" "lite" "full"] :description "Managed response-compression strategy (default off until savings are proven)"}
                          :worktree {:type "boolean" :description "OPT-IN: run this lane in an isolated per-lane git worktree (own index+tree). Default off."}
                          :setupCmd {:type "string" :minLength 1 :description "Optional repo-setup command run in the fresh worktree (e.g. 'bun install'); only with worktree=true"}
                          :tokenTarget {:type "integer" :minimum 1 :maximum 9007199254740991 :description "Optional exact-accounted run token target. Enforced between completed model calls; one call may overshoot it."}
                          :coordinator {:type "string" :minLength 1 :description "Caller's north id; see dispatch.coordinator"})
             :required ["prompt" "role" "taskGrade" "domainRequirements" "topology"
                        "tier" "reasoning" "posture" "composition"]
             :additionalProperties false}}])

;; Attribution (routing-overhaul PART 1): the spawned lane inherits AGENT_COORDINATOR
;; so it records a `coordinator` fact + pings that id on completion/death — otherwise
;; every MCP-spawned lane shows coordinator "(none)" and audits can't attribute fan-out.
;; The host session's north id is NOT in this server's env (north-mcp registers env:{}),
;; so resolve it in priority order:
;;   1. explicit `coordinator` arg — an interactive session passes its "you are agent …" id;
;;   2. the CALLER's AGENT_ID — for a sub-spawn, this is the parent LANE's own id (its MCP
;;      server inherits {...process.env} incl. AGENT_ID), so sub-delegation attributes to
;;      the immediate parent, not a leaked top-of-tree pin;
;;   3. NORTH_AGENT_ID — a pinned session id (last, so an inherited pin never beats #2).
;; Captured from `env` BEFORE cmd-env reassigns AGENT_ID to the new lane.
(def required-store-rpc-instance-keys
  ["BEAGLE_STORE_HOME" "BEAGLE_STORE_BIN" "BEAGLE_STORE_OUT"
   "BEAGLE_STORE_SPACE_ID" "BEAGLE_STORE_SERVER_PORT" "NORTH_PORT"
   "NORTH_TELEMETRY_SPACE_ID" "NORTH_TELEMETRY_PORT"
   "NORTH_TELEMETRY_PARTITION"])

(defn materialize-instance-env
  "Pass the one sealed Store RPC instance inherited from the installed wrapper.
  Missing selector keys fail closed; MCP never invents or parses a second
  runtime selection and never forwards physical log paths to managed clients."
  [source]
  (let [missing (->> required-store-rpc-instance-keys
                     (filter #(str/blank? (get source %)))
                     vec)]
    (when (seq missing)
      (throw (ex-info
              (str "canonical Store RPC environment is incomplete; missing "
                   (str/join ", " missing))
              {:north/error :missing-store-rpc-environment
               :missing missing})))
    (let [home (or (not-empty (get source "HOME"))
                   (System/getProperty "user.home"))
          classpath (str root "/out:" (get source "BEAGLE_STORE_OUT"))]
      (assoc source
             "HOME" home
             "BABASHKA_CLASSPATH" classpath
             "NORTH_RUNTIME_CLASSPATH" classpath
             "BEAGLE_STORE_THREADS"
             (or (not-empty (get source "BEAGLE_STORE_THREADS"))
                 (.getCanonicalPath
                  (io/file home ".local" "state" "north" "threads")))))))

(defn resolve-coordinator [env args]
  (or (not-empty (get args "coordinator"))
      (not-empty (get env "AGENT_ID"))
      (not-empty (get env "NORTH_AGENT_ID"))))

(declare canonical-north-thread-id)

(defn bind-recursive-child-thread [prompt parent-env]
  (when (= "orchestrator" (north.topology-authority/current-topology))
    (let [{:keys [out err exit]}
          (proc/sh {:env parent-env}
                   "bb" (str root "/cli/agents-cli.clj")
                   "bind-child-thread" prompt)
          parsed (when (zero? exit)
                   (try (json/parse-string (str/trim out))
                        (catch Exception _ nil)))
          thread (get parsed "thread")
          parent (get parsed "parent")]
      (when-not (and (= #{"parent" "thread"} (set (keys parsed)))
                     (canonical-north-thread-id thread)
                     (canonical-north-thread-id parent))
        (throw (ex-info
                (or (not-empty (str/trim
                                (str out (when-not (str/blank? err)
                                           (str "\n" err)))))
                    "recursive child thread binding unavailable")
                {:north/error :recursive-child-thread-unavailable
                 :pre-side-effect true})))
      {:thread thread :parent parent})))

;; A child request owns every managed routing axis. Starting from the parent
;; process environment without removing these lets a director's composition or
;; account pin contaminate a role-only worker request. Capture coordinator
;; attribution first, then construct the child from this scrubbed base.
(defn semantic-segment [value]
  (let [s (some-> value str str/trim str/lower-case
                  (str/replace #"[^a-z0-9]+" "-")
                  (str/replace #"(^-|-$)" ""))]
    (if (seq s) s "unknown")))

(defn canonical-north-thread-id [value]
  (let [raw (when (string? value) value)
        bare (some-> raw (str/replace-first #"^@" ""))]
    (when (and raw
               (= raw (str/trim raw))
               (<= (count bare) 512)
               (re-matches #"[A-Za-z0-9][A-Za-z0-9._:-]*" bare))
      bare)))

(defn north-thread-subject [value]
  (when-let [id (canonical-north-thread-id value)]
    (str "@" id)))

(defn semantic-model [value]
  (let [model (semantic-segment value)
        parts (set (str/split model #"-"))]
    (or (some #(when (parts %) %) ["opus" "sonnet" "haiku" "fable" "sol" "terra" "luna"])
        model)))

(defn observed-agent-facts [agent-id]
  (try
    (let [{:keys [out exit]} (proc/sh engine "json" "show" (str "agent:" agent-id))]
      (when (zero? exit)
        (reduce (fn [facts fact]
                  (if-let [predicate (not-empty (get fact "predicate"))]
                    (north.agent-provenance/fold-fact facts predicate (get fact "value"))
                    facts))
                {} (json/parse-string out))))
    (catch Exception _ nil)))

(defn mcp-agent-online? [agent-id]
  (try
    (let [{:keys [out exit]} (proc/sh {:out :string :err :string}
                                      driver-bb (str root "/cli/presence-cli.clj")
                                      north-port "live-leases")]
      (and (zero? exit)
           (boolean
            (some (fn [line]
                    (let [tokens (str/split (str/trim line) #"\s+")]
                      (and (= agent-id (first tokens)) (some #{"yes"} tokens))))
                  (str/split-lines out)))))
    (catch Exception _ false)))

(defn launch-sdk! [command cmd-env log]
  (north.spawn-process/launch-detached! command cmd-env log))

(defn await-sdk-startup [process agent-id log]
  (north.spawn-process/await-startup
   process agent-id log observed-agent-facts mcp-agent-online?))

(defn startup-success? [startup]
  (contains? #{:ready :completed} (:status startup)))

(defn startup-summary [verb startup suffix]
  (if (= :completed (:status startup))
    (str "completed " (:handle startup) suffix
         "\nAgent reached outcome=" (:outcome startup) " during startup acknowledgement. "
         "Control key: @agent:" (:agent-id startup) ".")
    (str verb " " (:handle startup) suffix
         "\nAgent is running in the background. "
         "Control key: @agent:" (:agent-id startup) ".")))

(defn create-mcp-agent-id [thread]
  (let [segment (semantic-segment thread)
        fragment (subs segment (max 0 (- (count segment) 12)))]
    (north.spawn-process/create-agent-id (str "sdk-" fragment))))

(defn driver-command [verb thread agent-id]
  (when-let [subject (north-thread-subject thread)]
    (try
      (:exit (proc/sh {:out :string :err :string}
                      driver-bb driver-cli north-port verb subject agent-id))
      (catch Exception _ nil))))

(defn claim-driver-problem [thread agent-id]
  (let [id (canonical-north-thread-id thread)]
    (case (driver-command "claim" id agent-id)
      0 nil
      3 (str "thread @" id " already has an active driver")
      4 (str "thread @" id " disappeared before its driver could be claimed")
      (str "North coordinator unavailable or mismatched at port " north-port
           " while claiming the driver for thread @" id))))

(defn release-driver! [thread agent-id]
  ;; The child releases on every normal terminal path. This duplicate release is
  ;; intentional: it also covers construction failure and abrupt child exit.
  (driver-command "release" thread agent-id)
  nil)

(defn watch-driver-release! [process thread agent-id]
  (future
    (try
      (north.spawn-process/await-process-exit process)
      (catch Exception _ nil)
      (finally (release-driver! thread agent-id)))))

(def sdk-argument-keys
  {"dispatch" #{"id" "model" "effort" "reasoning" "role" "posture" "provider" "target" "tier"
                 "coordinator" "taskGrade" "domainRequirements" "topology" "composition"
                 "routingAssessment" "pinEvidence" "caveman" "tokenTarget"}
   "spawn" #{"prompt" "model" "effort" "reasoning" "role" "posture" "provider" "target" "tier"
              "caveman" "coordinator" "taskGrade" "domainRequirements" "topology" "composition"
              "routingAssessment" "pinEvidence" "tokenTarget"}})

(def routing-override-fields
  #{"taskGrade" "domainRequirements" "tier" "reasoning" "posture"})
(def managed-routing-fields
  ["role" "taskGrade" "domainRequirements" "topology"
   "tier" "reasoning" "posture" "composition"])
(def bespoke-contract-fields
  #{"responsibility" "deliverable" "capabilities" "mayDecide" "mustEscalate" "doneWhen" "report"})

(def edge-ascii-whitespace #"^[\u0009-\u000d\u0020]+|[\u0009-\u000d\u0020]+$")

(defn canonical-contract-text [value]
  (if (string? value)
    (-> value
        (str/replace #"\r\n?" "\n")
        (java.text.Normalizer/normalize java.text.Normalizer$Form/NFC)
        (str/replace edge-ascii-whitespace ""))
    value))

(defn canonicalize-bespoke-routing [args]
  (let [composition (when (map? args) (get args "composition"))
        contract (when (map? composition) (get composition "contract"))]
    (if (and (= "bespoke" (get composition "kind")) (map? contract))
      (let [normalized
            (-> (reduce (fn [value field]
                          (if (contains? value field)
                            (update value field canonical-contract-text)
                            value))
                        contract ["responsibility" "deliverable" "report"])
                ((fn [value]
                   (reduce (fn [result field]
                             (if (sequential? (get result field))
                               (update result field #(mapv canonical-contract-text %))
                               result))
                           value ["capabilities" "mayDecide" "mustEscalate" "doneWhen"]))))]
        (assoc-in args ["composition" "contract"] normalized))
      args)))

(defn valid-string-list? [value require-items?]
  (and (sequential? value)
       (or (not require-items?) (seq value))
       (every? #(and (string? %) (not (str/blank? %))) value)
       (let [normalized (mapv canonical-contract-text value)]
         (= (count normalized) (count (set normalized))))))

(defn non-empty-string? [value]
  (and (string? value) (not (str/blank? value))))

(defn safe-role-id? [value]
  (and (string? value) (boolean (re-matches (re-pattern role-id-pattern) value))))

(defn topology-capability-problem [topology capabilities]
  (let [caps (set capabilities)
        missing-closure
        (fn [surface required]
          (let [missing (remove caps required)]
            (when (and (caps surface) (seq missing))
              (str "composition.contract.capabilities: capability list is not closed; missing implied "
                   (str/join ", " missing)))))]
    (cond
      (and (caps "shell") (caps "shell.readonly"))
      "shell and shell.readonly are mutually exclusive"
      (and (= topology "orchestrator") (not (caps "coordination")))
      "orchestrator topology requires coordination capability"
      (and (= topology "orchestrator") (caps "filesystem.write"))
      "orchestrator topology forbids filesystem.write capability"
      (and (= topology "orchestrator") (caps "shell"))
      "orchestrator topology forbids unrestricted shell capability"
      (and (= topology "worker") (caps "coordination"))
      "worker topology forbids coordination capability"
      :else
      (or (missing-closure "shell"
                           ["filesystem.read" "filesystem.search" "filesystem.write"])
          (missing-closure "shell.readonly"
                           ["filesystem.read" "filesystem.search"])))))

(defn invalid-routing [nm args]
  (if-not (map? args)
    "arguments must be an object"
    (let [grade (get args "taskGrade") topology (get args "topology") role (get args "role")
        domains (get args "domainRequirements") composition (get args "composition")
        reasoning (get args "reasoning") effort (get args "effort") effective-reasoning reasoning
        tier (get args "tier") posture (get args "posture") provider (get args "provider")
        target (get args "target") model (get args "model") coordinator (get args "coordinator")
        token-target (get args "tokenTarget")
        explicit-selector? (or (and (contains? args "provider") (not= provider "auto"))
                               (contains? args "target")
                               (contains? args "model"))
        id (get args "id") prompt (get args "prompt") caveman (get args "caveman")
        unknown (seq (sort (remove (get sdk-argument-keys nm #{}) (keys args))))
        missing-routing (seq (remove #(contains? args %) managed-routing-fields))
        kind (when (map? composition) (get composition "kind"))
        composition-keys (case kind
                           "template" #{"kind" "id" "overrides" "overrideReason"}
                           "bespoke" #{"kind" "id" "nearestTemplate" "bespokeReason" "promotionCandidate" "contract"}
                           #{"kind" "id" "overrides" "overrideReason" "nearestTemplate" "bespokeReason" "promotionCandidate" "contract"})
        unknown-composition (when (map? composition)
                              (seq (sort (remove composition-keys (keys composition)))))
        contract (when (map? composition) (get composition "contract"))
        contract-capabilities (when (map? contract) (get contract "capabilities"))
        unknown-contract (when (map? contract)
                           (seq (sort (remove bespoke-contract-fields (keys contract)))))
        canonical-role role
        known-role? (contains? orchestration-role-names canonical-role)
        template-id (when (= kind "template") (get composition "id"))
        preset (when template-id (get orchestration-presets-by-name template-id))
        effective-capabilities (if (= kind "template") (get preset "capabilities") contract-capabilities)
        effective-topology topology
        capability-problem (when (and effective-topology (sequential? effective-capabilities))
                             (topology-capability-problem effective-topology effective-capabilities))
        base-posture (or (get preset "posture") (get-in orchestration-staffing ["defaults" "posture"]))
        actual-overrides (set (keep (fn [[field supplied base]]
                                      (when (and (some? supplied) (not= supplied base)) field))
                                    [["taskGrade" grade (get preset "taskGrade")]
                                     ["domainRequirements" domains []]
                                     ["tier" tier (get preset "tier")]
                                     ["reasoning" effective-reasoning (get preset "deliberation")]
                                     ["posture" posture base-posture]]))
        declared-overrides (when (= kind "template") (get composition "overrides"))
        route-problem (north.orchestration-staffing/unsupported-route-problem tier effective-reasoning)
        missing-bespoke-axes (when (and role (not known-role?))
                               (seq (keep (fn [[label value]] (when (nil? value) label))
                                          [["taskGrade" grade] ["domainRequirements" domains]
                                           ["topology" topology] ["tier" tier]
                                           ["reasoning" effective-reasoning] ["posture" posture]])))]
    (cond
      unknown (str "unknown " nm " routing field(s): " (str/join ", " unknown))
      (and (= nm "dispatch") (not (non-empty-string? id))) "dispatch id must be a non-empty string"
      (and (= nm "dispatch") (nil? (canonical-north-thread-id id)))
      "dispatch id must be a safe North thread id (bare or single @ prefix)"
      (and (= nm "spawn") (not (non-empty-string? prompt))) "spawn prompt must be a non-empty string"
      missing-routing
      (str "North " nm " requires the complete eight-field Orchestration request; missing: "
           (str/join ", " missing-routing)
           " (recover the valid payload shape: north show @contract:dispatch)")
      (and (#{"dispatch" "spawn"} nm) (not (non-empty-string? role)))
      (str "North " nm " requires role selecting a canonical Orchestration preset or a complete bespoke composition")
      (and (some? model) (not (non-empty-string? model))) "model must be a non-empty string"
      (and (some? coordinator) (not (non-empty-string? coordinator))) "coordinator must be a non-empty string"
      (and (some? token-target)
           (or (not (integer? token-target))
               (not (pos? token-target))
               (> token-target 9007199254740991)))
      "tokenTarget must be a positive safe integer"
      (and (some? caveman) (not (some #{caveman} ["off" "lite" "full"]))) "invalid caveman mode"
      (and role (or (not (string? role)) (str/blank? role))) "role must be a non-empty string"
      (and role (not (safe-role-id? role))) "role must be a lowercase kebab-case Orchestration role id"
      (= role "researcher") "role researcher is retired because it was ambiguous; use scout, analyst, or research-scientist"
      (#{"worker" "orchestrator"} role) (str role " is a topology, not a role; use director for orchestration or a functional worker role")
      (and role (nil? orchestration-staffing)) (str "Orchestration staffing catalog unavailable: " orchestration-staffing-path)
      (not (some #{grade} task-grade-values)) "invalid taskGrade"
      (not (valid-string-list? domains false))
      "domainRequirements must contain unique non-empty strings"
      (not (some #{topology} topology-values)) "invalid topology"
      (and role known-role? (not= topology (get preset "topology")))
      (str "stock-template topology is fixed at '" (get preset "topology")
           "'; use a bespoke composition for '" topology "'")
      (not (some #{tier} tier-values)) "invalid tier"
      (not (some #{reasoning} reasoning-values)) "invalid reasoning"
      route-problem route-problem
      (not (some #{posture} posture-values)) "invalid posture"
      (and provider (not (some #{provider} ["auto" "anthropic" "openai"]))) "invalid provider"
      (and reasoning effort (not= reasoning effort)) "reasoning and compatibility effort disagree"
      (and target (or (not (string? target)) (str/blank? target))) "target must be a non-empty string"
      (and explicit-selector? (not (contains? args "pinEvidence")))
      "explicit provider, target, or model selectors require fresh exact typed pinEvidence; for automatic routing omit model and target and omit provider or use provider=auto"
      (not (map? composition)) "composition must be an object"
      unknown-composition (str "unknown composition field(s): " (str/join ", " unknown-composition))
      (and composition (not (#{"template" "bespoke"} kind))) "invalid composition.kind"
      (and composition (let [v (get composition "id")] (or (not (string? v)) (str/blank? v)))) "composition.id is required"
      (and composition (not (safe-role-id? (get composition "id"))))
      "composition.id must be a lowercase kebab-case Orchestration role id"
      (and composition (nil? role)) "composition requires role"
      (and role (not known-role?) (= kind "template"))
      (str "unknown role " role " requires a bespoke composition")
      (and (= kind "template") (nil? preset))
      (str "unknown template composition.id " template-id)
      (and role known-role? (= kind "bespoke"))
      (str "known role " canonical-role " requires a template composition")

      (and (= kind "template") (not (valid-string-list? declared-overrides false)))
      "template composition.overrides must be an array of unique routing-axis names"
      (and (= kind "template") (some #(not (routing-override-fields %)) declared-overrides))
      "composition.overrides contains an invalid routing axis"
      (and (= kind "template") (not= actual-overrides (set declared-overrides)))
      (str "composition.overrides must exactly record changed template axes: "
           (if (seq actual-overrides) (str/join ", " (sort actual-overrides)) "none"))
      (and (= kind "template") (seq declared-overrides)
           (let [v (get composition "overrideReason")] (or (not (string? v)) (str/blank? v))))
      "template axis overrides require composition.overrideReason"
      (and (= kind "template") (empty? declared-overrides) (contains? composition "overrideReason"))
      "unchanged template must omit composition.overrideReason"
      (and role known-role? (seq actual-overrides) (nil? composition))
      (str "known role " canonical-role " overrides " (str/join ", " (sort actual-overrides))
           "; supply template composition.overrides and composition.overrideReason")
      (and (= kind "bespoke") (contains? composition "nearestTemplate")
           (let [v (get composition "nearestTemplate")] (or (not (string? v)) (str/blank? v))))
      "bespoke composition.nearestTemplate must be a non-empty string when supplied"
      (and (= kind "bespoke") (some? (get composition "nearestTemplate"))
           (not (contains? orchestration-role-names (get composition "nearestTemplate"))))
      "bespoke composition.nearestTemplate must name a canonical template"
      (and (= kind "bespoke")
           (let [v (get composition "bespokeReason")] (or (not (string? v)) (str/blank? v))))
      "bespoke composition requires bespokeReason"
      (and (= kind "bespoke") (not (boolean? (get composition "promotionCandidate"))))
      "bespoke composition.promotionCandidate must be explicit boolean"
      (and (= kind "bespoke") (not (map? contract))) "bespoke composition.contract must be an object"
      unknown-contract (str "unknown composition.contract field(s): " (str/join ", " unknown-contract))
      (and (= kind "bespoke")
           (some (fn [field]
                   (let [v (get contract field)] (or (not (string? v)) (str/blank? v))))
                 ["responsibility" "deliverable" "report"]))
      "bespoke composition.contract requires responsibility, deliverable, and report"
      (and (= kind "bespoke")
           (some #(not (valid-string-list? (get contract %) true)) ["mayDecide" "mustEscalate" "doneWhen"]))
      "bespoke composition.contract requires non-empty unique mayDecide, mustEscalate, and doneWhen lists"
      (and (= kind "bespoke")
           (or (not (valid-string-list? contract-capabilities true))
               (some #(not (some #{%} capability-values)) contract-capabilities)))
      "bespoke composition.contract capabilities must be non-empty, unique, and canonical"
      capability-problem capability-problem
      (and role (not known-role?)
           (or (not= "bespoke" kind) missing-bespoke-axes))
      (str "unknown role " role " requires complete bespoke composition"
           (when missing-bespoke-axes (str "; missing: " (str/join ", " missing-bespoke-axes))))
      :else nil))))

(defn preflight-exact-target [args]
  (when-let [target (not-empty (get args "target"))]
    (let [provider (or (not-empty (get args "provider")) "auto")
          tier (not-empty (get args "tier"))
          reasoning (or (not-empty (get args "reasoning")) (not-empty (get args "effort")))
          model (not-empty (get args "model"))
          argv [bun "run" route-preflight target provider
                (or tier "-") (or reasoning "-") (or model "-")]
          {:keys [out err exit]} (apply proc/sh argv)]
      (when-not (zero? exit)
        (let [message (str/trim (str err (when (and (seq err) (seq out)) "\n") out))]
          (if (str/blank? message) "exact routing target preflight failed" message))))))

(defn preflight-routing-economics [args]
  ;; This is the single canonical admission seam shared with execution. Orchestration
  ;; derives and validates the sidecar inside the SDK; the MCP edge does not
  ;; carry a weaker copy that could claim a driver before detecting tampering.
  (let [payload (cond-> {"routingMetadata" (select-keys args managed-routing-fields)}
                  (contains? args "routingAssessment")
                  (assoc "routingAssessment" (get args "routingAssessment"))
                  (contains? args "pinEvidence")
                  (assoc "pinEvidence" (get args "pinEvidence"))
                  (contains? args "provider") (assoc "provider" (get args "provider"))
                  (contains? args "target") (assoc "target" (get args "target"))
                  (contains? args "model") (assoc "model" (get args "model")))
        {:keys [out err exit]}
        (proc/sh {:in (json/generate-string payload)}
                 policy-bun "run" routing-economics-preflight)]
    (when-not (zero? exit)
      (let [message (str/trim (str err (when (and (seq err) (seq out)) "\n") out))]
        (if (str/blank? message) "routing economics preflight failed" message)))))

(defn preflight-struggle-policy [args]
  ;; The MCP edge always invokes the same resolver as execution. Its exact JSON
  ;; becomes a one-shot child witness, so defaults and overrides alike cannot
  ;; diverge between admission, selection, and the SDK observer.
  (let [{:keys [out err exit]}
        (proc/sh policy-bun "run" struggle-policy-cli "policy" (get args "topology"))
        expected (str/trim out)]
    (if (zero? exit)
      {:expected expected}
      {:problem (or (not-empty (str/trim err))
                    "invalid struggle detector policy")})))

(defn call-sdk [nm raw-args]
  (let [args (canonicalize-bespoke-routing raw-args)]
    (if-let [problem (north.topology-authority/authority-problem nm)]
      {:content [{:type "text" :text problem}] :isError true}
      (if-let [problem (invalid-routing nm args)]
      {:content [{:type "text" :text problem}] :isError true}
      (if-let [problem (preflight-routing-economics args)]
        {:content [{:type "text" :text problem}] :isError true}
      (if-let [problem (preflight-exact-target args)]
        {:content [{:type "text" :text problem}] :isError true}
        (let [struggle-preflight (preflight-struggle-policy args)]
          (if-let [problem (:problem struggle-preflight)]
            {:content [{:type "text" :text problem}] :isError true}
        (let [parent-env (materialize-instance-env (into {} (System/getenv)))
            coordinator (resolve-coordinator parent-env args)
            env (cond-> (north.managed-child-env/scrub parent-env)
                  (:expected struggle-preflight)
                  (assoc "NORTH_STRUGGLE_POLICY_EXPECTED"
                         (:expected struggle-preflight)))]
        (case nm
          "dispatch"
          (let [id (canonical-north-thread-id (get args "id"))
            model (get args "model")
            effort (get args "effort")
            reasoning (get args "reasoning")
            role (get args "role")
            posture (get args "posture")
            provider (get args "provider")
            target (get args "target")
            tier (get args "tier")
            task-grade (get args "taskGrade")
            domains (get args "domainRequirements")
            topology (get args "topology")
            composition (get args "composition")
            routing-assessment (get args "routingAssessment")
            pin-evidence (get args "pinEvidence")
            token-target (get args "tokenTarget")
            caveman (get args "caveman")
            agent-id (create-mcp-agent-id id)
            cmd-env (cond-> (assoc env
                              "AGENT_ID" agent-id
                              "NORTH_DISPATCH_DRIVER_PRECLAIMED" "1")
                      model       (assoc "AGENT_MODEL" model)
                      reasoning   (assoc "AGENT_REASONING" reasoning)
                      role        (assoc "AGENT_ROLE" role)
                      role        (assoc "AGENT_IDENTITY_ROLE" role)
                      posture     (assoc "AGENT_POSTURE" posture)
                      provider    (assoc "AGENT_PROVIDER" provider)
                      target      (assoc "AGENT_TARGET" target)
                      tier        (assoc "AGENT_TIER" tier)
                      task-grade  (assoc "AGENT_TASK_GRADE" task-grade)
                      domains     (assoc "AGENT_DOMAIN_REQUIREMENTS" (json/generate-string domains))
                      topology    (assoc "AGENT_TOPOLOGY" topology)
                      composition (assoc "AGENT_COMPOSITION" (json/generate-string composition))
                      routing-assessment (assoc "AGENT_ROUTING_ASSESSMENT" (json/generate-string routing-assessment))
                      pin-evidence (assoc "NORTH_ROUTING_PIN_EVIDENCE" (json/generate-string pin-evidence))
                      token-target (assoc "NORTH_RUN_TOKEN_TARGET" (str token-target))
                      caveman     (assoc "AGENT_CAVEMAN" caveman "NORTH_CAVEMAN_SOURCE" "request")
                      coordinator (assoc "AGENT_COORDINATOR" coordinator))]
        (if-let [problem (claim-driver-problem id agent-id)]
          {:content [{:type "text" :text problem}] :isError true}
          (try
            (let [log (io/file (str (get parent-env "HOME") "/.local/state/north/agents/" agent-id ".log"))
                  process (launch-sdk! [bun "run" (str sdk-dir "/dispatch.ts") id] cmd-env log)
                  _ (watch-driver-release! process id agent-id)
                  startup (await-sdk-startup process agent-id log)
                  suffix (str " for thread @" id
                              (when model (str " model=" model))
                              (when target (str " target=" target))
                              (when coordinator (str " coordinator=" coordinator)))]
              (if (startup-success? startup)
                {:content [{:type "text"
                            :text (str (startup-summary "dispatched" startup suffix)
                                       (when (= :ready (:status startup))
                                         " Watch with `north show` or `north agents`."))}]}
                (do
                  (release-driver! id agent-id)
                  {:content [{:type "text" :text (north.spawn-process/failure-message startup)}]
                   :isError true})))
            (catch Exception _
              (release-driver! id agent-id)
              {:content [{:type "text" :text (str "could not start an agent for thread @" id)}]
               :isError true}))))

          "spawn"
          (let [prompt (get args "prompt")
            model (get args "model")
            effort (get args "effort")
            reasoning (get args "reasoning")
            role (get args "role")
            posture (get args "posture")
            provider (get args "provider")
            target (get args "target")
            tier (get args "tier")
            task-grade (get args "taskGrade")
            domains (get args "domainRequirements")
            topology (get args "topology")
            composition (get args "composition")
            routing-assessment (get args "routingAssessment")
            pin-evidence (get args "pinEvidence")
            token-target (get args "tokenTarget")
            caveman (get args "caveman")
            worktree (get args "worktree")
            setup-cmd (get args "setupCmd")
            agent-id (create-mcp-agent-id "spawn")
            recursive-binding (bind-recursive-child-thread prompt parent-env)
            cmd-env (cond-> (assoc env "AGENT_ID" agent-id)
                      model       (assoc "AGENT_MODEL" model)
                      reasoning   (assoc "AGENT_REASONING" reasoning)
                      role        (assoc "AGENT_ROLE" role)
                      role        (assoc "AGENT_IDENTITY_ROLE" role)
                      posture     (assoc "AGENT_POSTURE" posture)
                      provider    (assoc "AGENT_PROVIDER" provider)
                      target      (assoc "AGENT_TARGET" target)
                      tier        (assoc "AGENT_TIER" tier)
                      task-grade  (assoc "AGENT_TASK_GRADE" task-grade)
                      domains     (assoc "AGENT_DOMAIN_REQUIREMENTS" (json/generate-string domains))
                      topology    (assoc "AGENT_TOPOLOGY" topology)
                      composition (assoc "AGENT_COMPOSITION" (json/generate-string composition))
                      routing-assessment (assoc "AGENT_ROUTING_ASSESSMENT" (json/generate-string routing-assessment))
                      pin-evidence (assoc "NORTH_ROUTING_PIN_EVIDENCE" (json/generate-string pin-evidence))
                      token-target (assoc "NORTH_RUN_TOKEN_TARGET" (str token-target))
                      caveman     (assoc "AGENT_CAVEMAN" caveman "NORTH_CAVEMAN_SOURCE" "request")
                      worktree    (assoc "AGENT_WORKTREE" "1")
                      setup-cmd   (assoc "AGENT_SETUP_CMD" setup-cmd)
                      recursive-binding
                      (assoc "NORTH_DELEGATE_THREAD_ID"
                             (:thread recursive-binding))
                      coordinator (assoc "AGENT_COORDINATOR" coordinator))]
        (try
          (let [log (io/file (str (get parent-env "HOME") "/.local/state/north/agents/" agent-id ".log"))
                process (launch-sdk! [bun "run" (str sdk-dir "/spawn.ts") prompt] cmd-env log)
                startup (await-sdk-startup process agent-id log)
                suffix (str (when model (str " model=" model))
                            (when target (str " target=" target))
                            (when recursive-binding
                              (str " thread=@" (:thread recursive-binding)
                                   " part_of=@" (:parent recursive-binding)))
                            (when coordinator (str " coordinator=" coordinator)))]
            (if (startup-success? startup)
              {:content [{:type "text"
                          :text (str (startup-summary "spawned" startup suffix)
                                     (when (= :ready (:status startup))
                                       " Watch with `north show` or `north agents`."))}]}
              {:content [{:type "text" :text (north.spawn-process/failure-message startup)}]
               :isError true}))
            (catch Exception _
              {:content [{:type "text" :text "could not start an ad-hoc agent"}]
               :isError true})))))))))))))

(defn find-tool [nm] (first (filter #(= (:name %) nm) tools)))
(defn find-sdk-tool [nm] (first (filter #(= (:name %) nm) sdk-tools)))

;; Result diet — the MCP is the AI-facing edge, so we slim results for the model
;; without touching engine output the CLI/humans rely on. Cuts BYTES, never facts.
(defn slim-capture
  "capture ack keeps the id+title line; drops the local file path and the
   `Next:` hint (the AI drives via tell, not the .md projection)."
  [text]
  (or (first (str/split-lines text)) text))

(defn slim-output [nm args text]
  (case nm
    "capture"      (slim-capture text)
    text))

(def paged-tool-names #{"show" "search"})

(defn sha256 [text]
  (let [digest (.digest (java.security.MessageDigest/getInstance "SHA-256")
                        (.getBytes text java.nio.charset.StandardCharsets/UTF_8))]
    (format "%064x" (java.math.BigInteger. 1 digest))))

(defn page-state [nm total offset end]
  (cond
    (and (= nm "search") (zero? total)) "no_matches"
    (>= offset total) (if (zero? total) "complete" "exhausted")
    (< end total) "incomplete"
    :else "complete"))

(defn utf8-byte-count [text]
  (alength (.getBytes (str text) java.nio.charset.StandardCharsets/UTF_8)))

(defn page-envelope [nm digest offset limit total end page-items]
  (let [complete (>= end total)]
    {:protocol "north.page"
     :version 1
     :snapshot digest
     :offset offset
     :limit limit
     :maxResponseBytes max-page-response-bytes
     :total total
     :nextOffset (when-not complete end)
     :complete complete
     :state (page-state nm total offset end)
     :items page-items}))

(defn encode-page [body response-id]
  (let [text (json/generate-string body)
        result {:content [{:type "text" :text text}] :isError false}
        response {:jsonrpc "2.0" :id response-id :result result}]
    {:body body
     :result result
     :bytes (utf8-byte-count (json/generate-string response))}))

(defn page-success [{:keys [result bytes]}]
  (when (> bytes max-page-response-bytes)
    (throw (ex-info "serialized page exceeds its byte bound"
                    {:type :page-response-too-large
                     :bytes bytes
                     :limit max-page-response-bytes})))
  result)

(defn page-error [body]
  {:content [{:type "text" :text (json/generate-string body)}] :isError true})

(defn bounded-whole-page [nm items digest offset limit response-id]
  (let [total (count items)
        initial-end (min offset total)
        initial (encode-page
                 (page-envelope nm digest offset limit total initial-end [])
                 response-id)]
    (loop [end initial-end
           best initial]
      (if (or (>= end total) (>= (- end offset) limit))
        {:page best :item-count (- end offset)}
        (let [candidate-end (inc end)
              candidate (encode-page
                         (page-envelope nm digest offset limit total candidate-end
                                        (subvec items offset candidate-end))
                         response-id)]
          (if (<= (:bytes candidate) max-page-response-bytes)
            (recur candidate-end candidate)
            {:page best :item-count (- end offset)}))))))

(defn utf8-continuation-byte? [value]
  (= 128 (bit-and 192 (bit-and 255 value))))

(defn utf8-boundary? [bytes offset]
  (or (zero? offset)
      (= offset (alength bytes))
      (not (utf8-continuation-byte? (aget bytes offset)))))

(defn floor-utf8-boundary [bytes start candidate]
  (loop [end candidate]
    (if (or (= end start)
            (= end (alength bytes))
            (not (utf8-continuation-byte? (aget bytes end))))
      end
      (recur (dec end)))))

(defn item-fragment-envelope [digest offset limit total item-bytes start end]
  (let [item-total (alength item-bytes)
        item-complete (= end item-total)
        projection-end (if item-complete (inc offset) offset)
        complete (>= projection-end total)
        content (String. item-bytes (int start) (int (- end start))
                          java.nio.charset.StandardCharsets/UTF_8)]
    {:protocol "north.page"
     :version 1
     :snapshot digest
     :offset offset
     :limit limit
     :maxResponseBytes max-page-response-bytes
     :total total
     :nextOffset (when-not complete projection-end)
     :nextItemByteOffset (when-not item-complete end)
     :complete complete
     :state (if complete "complete" "incomplete")
     :items []
     :itemFragment {:index offset
                    :encoding "json"
                    :byteOffset start
                    :totalBytes item-total
                    :content content}}))

(defn bounded-item-fragment [items digest offset limit start response-id]
  (let [total (count items)]
    (cond
      (>= offset total)
      {:error "invalid_item_byte_offset"
       :snapshot digest
       :offset offset
       :itemByteOffset start
       :total total}

      :else
      (let [item-text (json/generate-string (nth items offset))
            item-bytes (.getBytes item-text java.nio.charset.StandardCharsets/UTF_8)
            item-total (alength item-bytes)]
        (cond
          (or (>= start item-total) (not (utf8-boundary? item-bytes start)))
          {:error "invalid_item_byte_offset"
           :snapshot digest
           :offset offset
           :itemByteOffset start
           :itemBytes item-total}

          :else
          (let [complete-candidate
                (encode-page
                 (item-fragment-envelope digest offset limit total item-bytes
                                         start item-total)
                 response-id)]
            (if (<= (:bytes complete-candidate) max-page-response-bytes)
              complete-candidate
              (loop [low (inc start)
                     high (dec item-total)
                     best nil]
                (if (> low high)
                  (or best
                      {:error "page_item_too_large"
                       :snapshot digest
                      :offset offset
                      :itemBytes item-total
                       :maxResponseBytes max-page-response-bytes})
                  (let [middle (+ low (quot (- high low) 2))
                        end (floor-utf8-boundary item-bytes start middle)
                        candidate (when (> end start)
                                    (encode-page
                                     (item-fragment-envelope digest offset limit total
                                                             item-bytes start end)
                                     response-id))]
                    (if (and candidate
                             (<= (:bytes candidate) max-page-response-bytes))
                      (recur (inc middle) high candidate)
                      (recur low (dec middle) best))))))))))))

(defn paged-output [nm arguments text response-id]
  (try
    (let [parsed (json/parse-string text)
          _ (when-not (sequential? parsed)
              (throw (ex-info "paged projection must be a JSON array"
                              {:type :invalid-page-projection})))
          items (vec parsed)
          serialized (json/generate-string items)
          digest (sha256 serialized)
          supplied (get arguments "snapshot")]
      (if (and supplied (not= supplied digest))
        (page-error {:error "stale_snapshot"
                     :expected supplied
                     :actual digest})
        (let [total (count items)
              offset (get arguments "offset" 0)
              limit (get arguments "limit" 50)
              item-byte-offset (get arguments "itemByteOffset" 0)
              whole (when (zero? item-byte-offset)
                      (bounded-whole-page nm items digest offset limit response-id))
              result (if (and whole
                              (or (pos? (:item-count whole))
                                  (>= offset total)))
                       (:page whole)
                       (bounded-item-fragment items digest offset limit
                                              item-byte-offset response-id))]
          (if (:error result)
            (page-error result)
            (page-success result)))))
    (catch Exception error
      {:content [{:type "text"
                  :text (str "invalid " nm " projection: " (.getMessage error))}]
       :isError true})))

(def max-tool-error-chars 8192)
(defn bound-tool-error [text]
  (if (<= (count text) max-tool-error-chars)
    text
    (let [marker "\n... tool error truncated ...\n"
          available (- max-tool-error-chars (count marker))
          head (quot available 2)
          tail (- available head)]
      (str (subs text 0 head) marker (subs text (- (count text) tail))))))

(defn call-artifact-read [arguments]
  (let [{:keys [out err exit]}
        (proc/sh {:in (json/generate-string arguments)}
                 bun "run" artifact-read-cli)
        stdout (str/trim (or out ""))
        stderr (str/trim (or err ""))
        text (cond
               (and (zero? exit) (seq stdout) (str/blank? stderr)) stdout
               (seq stdout) stdout
               (seq stderr) (bound-tool-error stderr)
               :else "artifact read failed")]
    {:content [{:type "text" :text text}]
     :isError (boolean (or (not (zero? exit)) (seq stderr)))}))

(defn call-tool [nm args response-id]
  (if-let [st (find-sdk-tool nm)]
    (try
      (call-sdk nm (or args {}))
      (catch Exception error
        {:content [{:type "text" :text (bound-tool-error (.getMessage error))}]
         :isError true}))
    (if-let [t (find-tool nm)]
      (let [arguments (or args {})]
        (if-let [problem (when-let [argument-problem (:argument-problem t)]
                           (argument-problem arguments))]
          {:content [{:type "text" :text problem}] :isError true}
          (if (= nm "artifact_read")
            (call-artifact-read arguments)
            (let [argv (mapv str ((:argv t) arguments))
                {:keys [out err exit]} (apply proc/sh engine argv)
                errs (str/trim (or err ""))
                raw (str/trim (str out (when (seq errs) (str "\n[stderr] " errs))))
                text (if (zero? exit)
                       (slim-output nm arguments raw)
                       (bound-tool-error raw))]
            (if (and (zero? exit) (paged-tool-names nm))
              (if (seq errs)
                {:content [{:type "text"
                            :text (bound-tool-error
                                   (str "invalid " nm " projection: " errs))}]
                 :isError true}
                (paged-output nm arguments (str/trim (or out "")) response-id))
              {:content [{:type "text" :text (if (str/blank? text) (str "(done; exit " exit ")") text)}]
               :isError (not (zero? exit))})))))
      {:content [{:type "text" :text (str "unknown tool: " nm)}] :isError true})))

(defn tool-descriptor [t]
  (cond-> {:name (:name t) :description (:desc t) :inputSchema (:schema t)}
    (:annotations t) (assoc :annotations (:annotations t))))

(defn tools-list []
  {:tools (into (mapv tool-descriptor tools)
                (mapv tool-descriptor sdk-tools))})

(defn on-initialize [params]
  {:protocolVersion (get params "protocolVersion" "2025-06-18")
   :capabilities {:tools {}}
   :serverInfo {:name "north" :version "0.1.0"}
   :instructions cheatsheet})

(defn emit! [m] (println (json/generate-string m)) (flush))
(defn respond [id result] (emit! {:jsonrpc "2.0" :id id :result result}))
(defn respond-err [id code msg] (emit! {:jsonrpc "2.0" :id id :error {:code code :message msg}}))

(defn handle [line]
  (when-not (str/blank? line)
    (let [msg (try (json/parse-string line) (catch Exception _ nil))]
      (when msg
        (let [id (get msg "id") method (get msg "method") params (get msg "params")]
          (cond
            (= method "initialize")                 (respond id (on-initialize params))
            (= method "notifications/initialized")  nil
            (= method "ping")                       (respond id {})
            (= method "tools/list")                 (respond id (tools-list))
            (= method "tools/call")                 (respond id (call-tool (get params "name") (get params "arguments") id))
            (some? id)                              (respond-err id -32601 (str "method not found: " method))
            :else                                   nil))))))

(loop []
  (let [line (read-line)]
    (when (some? line)
      (handle line)
      (recur))))
