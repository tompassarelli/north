#!/usr/bin/env python3
"""follows-release: start each queued Follows box (threads queue follow) once its predecessor is on origin/main.

safe-push runs it with --repo-dir after a landing on the default branch; worker-sweep runs it with no arguments as the
fallback, reading each box's repository from FOLLOWS_RELEASE_ROOT/<repo>/main (default ~/code). A Follows naming a
SHA waits for that commit, one naming an issue ref for a commit whose headline or Item:/Closes/Fixes/Refs line names
it, and anything else for a commit with that exact subject. A released box passes the spawn gate
(harness/hooks/lib/spawn_capacity.py, as its lead) and then runs FOLLOWS_RELEASE_START TIER LEAD BRIEF, by default
codex-lead send to the lead. A box the gate denies, or one released but not started within 5 minutes
(FOLLOWS_RELEASE_NOW fakes the clock), gets one FOLLOWS line in <lead>-inbox.md and proxy-inbox.md under
LEDGER_HANDOFFS (default ~/.local/state/agents/handoffs); a released box is retried on every later pass.
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
THREADS = HERE / "threads"
GATE = HERE.parent / "harness/hooks/lib/spawn_capacity.py"
START_WITHIN = 300
LOG_DEPTH = 2000
SHA = re.compile(r"[0-9a-f]{7,40}")
ISSUE = re.compile(r"(?:[\w.-]+/)?([\w.-]+)#(\d+)")
COMMIT_REF = re.compile(r"^(?:item|closes|close|fixes|fix|refs|ref|part of|issue|for)\b", re.I)


def threads(*args):
    return subprocess.run([str(THREADS), "queue", *args], capture_output=True, text=True)


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)


def repo_name(repo):
    url = git(repo, "remote", "get-url", "origin").stdout.strip().rstrip("/")
    return re.sub(r"\.git$", "", url.rsplit("/", 1)[-1].rsplit(":", 1)[-1])


def names_issue(message, repo, number):
    lines = message.splitlines()
    picked = lines[:1] + [line for line in lines[1:] if COMMIT_REF.match(line.strip())]
    pattern = rf"(?:(?<![\w/-])|(?<={re.escape(repo)}))#{number}(?!\d)"
    return any(re.search(pattern, line) for line in picked)


def landed(repo, follows):
    if SHA.fullmatch(follows):
        return git(repo, "merge-base", "--is-ancestor", follows, "refs/remotes/origin/main").returncode == 0
    log = git(repo, "log", f"-n{LOG_DEPTH}", "--format=%B%x00", "refs/remotes/origin/main").stdout.split("\0")
    issue = ISSUE.fullmatch(follows)
    if issue:
        return any(names_issue(m.strip(), issue.group(1), issue.group(2)) for m in log)
    return any(m.strip().split("\n", 1)[0] == follows for m in log)


def gate(box, repo):
    tier, brief = box["tier"], box["brief"]
    if tier.startswith("worker"):
        tool = {"tool_name": "Agent", "tool_input": {"subagent_type": tier, "description": box["item"], "prompt": brief, "run_in_background": True}}
    else:
        tool = {"tool_name": "spawn_agent", "tool_input": {"message": brief}}
    event = {"hook_event_name": "PreToolUse", "cwd": str(repo), **tool}
    env = {k: v for k, v in os.environ.items() if k not in ("AGENT_DELEGATION_BUDGET", "CODEX_THREAD_ID")}
    env.update(AGENT_ROLE="lead", AGENT_ORG_NAME=box["lead"])
    out = subprocess.run([sys.executable, str(GATE)], input=json.dumps(event), capture_output=True, text=True,
                         env=env).stdout.strip()
    try:
        decision = json.loads(out).get("hookSpecificOutput", {}) if out else {}
    except ValueError:
        return None
    return decision.get("permissionDecisionReason") if decision.get("permissionDecision") == "deny" else None


def start(box):
    configured = os.environ.get("FOLLOWS_RELEASE_START")
    if configured:
        argv = shlex.split(configured) + [box["tier"], box["lead"], box["brief"]]
    else:
        route = " Call Claude Agent with run_in_background: true." if box["tier"].startswith("worker") else ""
        argv = ["codex-lead", "send", f"{box['brief']}\nStaff this queued box now as a fresh worker at {box['tier']}.{route}"]
    try:
        return subprocess.run(argv, env=dict(os.environ, AGENT_ORG_NAME=box["lead"]), stdin=subprocess.DEVNULL,
                              timeout=120).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def alert(box, why, now):
    stamp = datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
    line = f"FOLLOWS {stamp} box {box['id']} {box['item']} (Follows: {box['follows']}, tier {box['tier']}): {why}"
    if threads("follow-alert", str(box["id"]), line).returncode != 0:
        return
    handoffs = Path(os.environ.get("LEDGER_HANDOFFS")
                    or Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "agents/handoffs")
    handoffs.mkdir(parents=True, exist_ok=True)
    for name in (f"{box['lead']}-inbox.md", "proxy-inbox.md"):
        with (handoffs / name).open("a") as inbox:
            inbox.write(line + "\n")
    print(line)


def seconds(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def main():
    p = argparse.ArgumentParser(prog="follows-release", description=__doc__)
    p.add_argument("--repo-dir", help="the repository a landing just reached; only its boxes are considered")
    a = p.parse_args()
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "agents"
    state.mkdir(parents=True, exist_ok=True)
    lock = (state / "follows-release.lock").open("a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    listing = threads("follow-list")
    if listing.returncode != 0:
        print(listing.stderr.strip(), file=sys.stderr)
        return 1
    boxes = json.loads(listing.stdout or "[]")
    root = Path(os.environ.get("FOLLOWS_RELEASE_ROOT") or Path.home() / "code")
    only = Path(a.repo_dir) if a.repo_dir else None
    name = repo_name(only) if only else None
    fetched = {}
    for box in boxes:
        if only and box["repo"] != name:
            continue
        repo = only or root / box["repo"] / "main"
        if repo not in fetched:
            fetched[repo] = git(repo, "fetch", "-q", "origin", "+refs/heads/main:refs/remotes/origin/main").returncode == 0 \
                or git(repo, "rev-parse", "-q", "--verify", "refs/remotes/origin/main").returncode == 0
        if not fetched[repo]:
            continue
        if box["state"] == "queued":
            if not landed(repo, box["follows"]) or threads("follow-release", str(box["id"])).returncode != 0:
                continue
            box.update(state="taken", taken=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
            print(f"FOLLOWS box {box['id']} {box['item']}: released, its predecessor {box['follows']} is on origin/main")
        now = float(os.environ.get("FOLLOWS_RELEASE_NOW") or time.time())
        denied = gate(box, repo)
        if denied:
            alert(box, f"denied by the spawn gate: {denied.splitlines()[0][:300]}", now)
        elif start(box):
            threads("follow-started", str(box["id"]))
            print(f"FOLLOWS box {box['id']} {box['item']}: started on {box['tier']}")
        elif now - seconds(box["taken"]) >= START_WITHIN:
            alert(box, f"released at {box['taken']} but not started within {START_WITHIN // 60} minutes", now)
    return 0


if __name__ == "__main__":
    sys.exit(main())
