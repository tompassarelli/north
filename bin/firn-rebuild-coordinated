#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
north_bin=${NORTH_BIN:-$(cd "$(dirname "$0")" && pwd)/north}
post_rebuild_north=${NORTH_POST_REBUILD_BIN:-north}
firn_bin=${FIRN_BIN:-firn}
runtime_state=${NORTH_COORD_RUNTIME_STATE:-${HOME:?}/.local/state/north/fram-runtime}
runtime_parent=${runtime_state%/*}
runtime_name=${runtime_state##*/}
restart_lock=${NORTH_COORD_RESTART_LOCK:-$runtime_parent/.${runtime_name}.restart.lock}
restart_lock_timeout=${NORTH_COORD_RESTART_LOCK_TIMEOUT:-60}
coord_retry_attempts=${NORTH_REBUILD_COORD_RETRY_ATTEMPTS:-20}

why=
window="immediately after coordination all-clear"
hold=3m
max_delay=15m
firn_args=()

usage() {
  cat >&2 <<EOF
usage: $program --why <text> [--window <text>] [--hold 3m] [--max-delay 15m] [-- <firn rebuild args>]
EOF
  exit 2
}

while (($#)); do
  case "$1" in
    --why|--window|--hold|--max-delay)
      (($# >= 2)) || usage
      case "$1" in
        --why) why=$2 ;;
        --window) window=$2 ;;
        --hold) hold=$2 ;;
        --max-delay) max_delay=$2 ;;
      esac
      shift 2
      ;;
    --)
      shift
      firn_args=("$@")
      break
      ;;
    -h|--help)
      usage
      ;;
    *)
      printf '%s: unknown argument: %s\n' "$program" "$1" >&2
      usage
      ;;
  esac
done

[[ -n "$why" ]] || {
  printf '%s: --why is required\n' "$program" >&2
  usage
}
[[ "$runtime_state" == /* && "$runtime_parent" != "$runtime_state" &&
   -n "$runtime_name" ]] || {
  printf '%s: invalid NORTH_COORD_RUNTIME_STATE: %s\n' "$program" "$runtime_state" >&2
  exit 2
}
[[ "$restart_lock_timeout" =~ ^[0-9]+$ ]] || {
  printf '%s: NORTH_COORD_RESTART_LOCK_TIMEOUT must be a non-negative integer\n' "$program" >&2
  exit 2
}
[[ "$coord_retry_attempts" =~ ^[1-9][0-9]*$ ]] || {
  printf '%s: NORTH_REBUILD_COORD_RETRY_ATTEMPTS must be a positive integer\n' \
    "$program" >&2
  exit 2
}
[[ -x "$north_bin" ]] || {
  printf '%s: North CLI is not executable: %s\n' "$program" "$north_bin" >&2
  exit 2
}
command -v "$firn_bin" >/dev/null 2>&1 || {
  printf '%s: firn executable is unavailable: %s\n' "$program" "$firn_bin" >&2
  exit 2
}

intent_output=$(
  "$north_bin" rebuild-intent start \
    --why "$why" \
    --window "$window" \
    --hold "$hold" \
    --max-delay "$max_delay"
)
intent_id=${intent_output##*$'\n'}
[[ "$intent_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
  printf '%s: rebuild-intent start returned no canonical intent id\n' "$program" >&2
  exit 2
}

printf 'rebuild intent %s posted; entering hold\n' "$intent_id"
"$north_bin" rebuild-intent await "$intent_id"

# This is the exact lock derivation owned by north-coord-runtime:
#   state_parent/.state_name.restart.lock
# Holding it across the whole deployment makes a direct runtime restart wait or
# fail with its named restart-mutex-busy path instead of interleaving.
mkdir -p "$runtime_parent"
exec 9>"$restart_lock" || {
  printf '%s: restart-mutex-open-failed: %s\n' "$program" "$restart_lock" >&2
  exit 2
}
if ! flock -w "$restart_lock_timeout" 9; then
  printf '%s: restart-mutex-busy: another coordinator restart holds %s\n' \
    "$program" "$restart_lock" >&2
  exit 2
fi

"$north_bin" rebuild-intent mark-started "$intent_id"

set +e
"$firn_bin" rebuild "${firn_args[@]}"
firn_rc=$?
set -e

if ((firn_rc != 0)); then
  report="firn rebuild rc $firn_rc"
  "$north_bin" rebuild-intent failed "$intent_id" "$report"
  printf '%s: %s\n' "$program" "$report" >&2
  exit "$firn_rc"
fi

# Resolve readiness through PATH after the generation switch, not this
# already-running wrapper's immutable North package. The selected `north`
# wrapper also carries the new generation's Stage-A client environment, so
# `coord-ready` attests both :7977 and :7978 when the split is active.
post_rebuild_north_bin=
if [[ "$post_rebuild_north" == */* ]]; then
  [[ -x "$post_rebuild_north" ]] && post_rebuild_north_bin="$post_rebuild_north"
else
  post_rebuild_north_bin="$(command -v -- "$post_rebuild_north" 2>/dev/null || true)"
fi
if [[ -z "$post_rebuild_north_bin" || ! -x "$post_rebuild_north_bin" ]]; then
  report="firn rebuild rc 0; post-rebuild North CLI is unavailable: $post_rebuild_north"
  "$north_bin" rebuild-intent failed "$intent_id" "$report"
  printf '%s: %s\n' "$program" "$report" >&2
  exit 1
fi

# `coord-ready` is deliberately identity-only: it checks the selected runtime
# against each live sole writer without folding logs or reading thread files.
# NixOS owns service replacement through restartIfChanged/stopIfChanged; this
# gate only waits and attests. It never guesses which unit to restart.
coord_attempt=1
coord_delay=1
coord_rc=0
while true; do
  set +e
  "$post_rebuild_north_bin" coord-ready
  coord_rc=$?
  set -e
  if ((coord_rc == 0)); then
    break
  fi
  if ((coord_attempt >= coord_retry_attempts)); then
    report="firn rebuild rc 0; north coord-ready rc $coord_rc after $coord_attempt attempts"
    "$north_bin" rebuild-intent failed "$intent_id" "$report"
    printf '%s: %s\n' "$program" "$report" >&2
    exit "$coord_rc"
  fi
  printf '%s: coordinator verification unavailable; retry %d/%d in %ds\n' \
    "$program" "$coord_attempt" "$coord_retry_attempts" "$coord_delay" >&2
  sleep "$coord_delay"
  coord_attempt=$((coord_attempt + 1))
  if ((coord_delay < 4)); then
    coord_delay=$((coord_delay * 2))
  fi
done

report="firn rebuild rc 0; north coord-ready rc 0"
"$north_bin" rebuild-intent deployment-verified "$intent_id" "$report"
printf 'deployment verified: %s\n' "$report"
