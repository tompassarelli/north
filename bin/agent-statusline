#!/usr/bin/env bash
set -uo pipefail

org=${AGENTS_ORG_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/agents/org.json}
[ -r "$org" ] || org=/dev/null
proxy_session=$(head -c 200 "${XDG_STATE_HOME:-$HOME/.local/state}/plato/session-id" 2>/dev/null | tr -d '[:space:]')
head -c 65536 | jq -rj --slurpfile org "$org" --arg name "${AGENT_ORG_NAME:-}" --arg role "${AGENT_ROLE:-}" --arg domain "${AGENT_DOMAIN:-}" --arg proxy "$proxy_session" '
  (($org[0].nodes // []) | map(select(.id == $name)) | first) as $node
  | (if $name != "" then $name
     elif $proxy != "" and .session_id == $proxy then "Plato"
     else (.session_name // ((.workspace.current_dir // .cwd // "session") | split("/") | last)) end) as $who
  | (if ($node.parent // "proxy") != "proxy" then " ← \($node.parent)" else "" end) as $up
  | [($node.role // (if $role != "" then $role elif $proxy != "" and .session_id == $proxy then "proxy" else null end)), ($node.domain // $domain), (.model.display_name // "")]
  | map(select(. != null and . != "")) as $rest
  | "\u001b[1m\($who)\u001b[0m\($up)" + ($rest | map(" · " + .) | join(""))' 2>/dev/null || printf '%s' "${AGENT_ORG_NAME:-${PWD##*/}}"
