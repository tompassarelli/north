#!/usr/bin/env bash
# North — the life app. Routes LIFE verbs to the North CLI (north.main,
# run against the Fram engine on the classpath) and ENGINE verbs to the Fram CLI.
# Both operate on the same private XDG fact data. Supplies North's lifecycle
# configuration and capture provenance; executable predicate schema lives in
# the fact graph itself.
#
#   engine: FRAM_HOME > world manifest > compiled checkout   data: XDG state
export FRAM_THREADS="${FRAM_THREADS:-$HOME/.local/state/north/threads}"
_north_fram_log_explicit=0
if [ -n "${FRAM_LOG:-}" ]; then _north_fram_log_explicit=1; fi
export FRAM_LOG="${FRAM_LOG:-$HOME/.local/state/north/facts.log}"
# --- the log split: kind-routed telemetry segregation -------------------------
# The existing A1 split keeps both origin logs behind one coordinator. An
# explicit NORTH_TELEMETRY_PARTITION=1 advances to Stage A: coordination and
# telemetry each have an independently fenced writer. FRAM_TELEMETRY_LOG is
# still selected by either an explicit caller value or the presence of a seeded
# coordination.log beside FRAM_LOG. An explicit telemetry path does not make the
# default facts.log authoritative; when coordination.log exists it remains the
# coordination writer's exact fence. Without the Stage-A flag, the prior
# single-coordinator behavior remains unchanged.
# Gated ONLY on whether the caller pinned FRAM_LOG. It was ALSO gated on
# FRAM_TELEMETRY_LOG being unset, and that broke every write: the packaged
# wrapper exports FRAM_TELEMETRY_LOG, so this branch never ran, FRAM_LOG stayed
# at facts.log, and the coordinator serves coordination.log. Observed
# 2026-07-29 — every `north tell` died with
#   REFUSED — subject resolver unavailable (coordinator unavailable or
#   incompatible)
# which is a log-identity MISMATCH wearing the costume of a dead daemon: the
# same write through `fram` with FRAM_LOG=coordination.log committed fine.
#
# The two variables answer different questions. FRAM_LOG is WHICH CORPUS;
# FRAM_TELEMETRY_LOG is WHERE TELEMETRY GOES. Letting the second veto the first
# conflated them. cli/tests/north-log-selection-test.sh pins all four cases.
if [ "$_north_fram_log_explicit" -eq 0 ]; then
  _north_log_dir="$(dirname "$FRAM_LOG")"
  if [ -f "$_north_log_dir/coordination.log" ]; then
    export FRAM_LOG="$_north_log_dir/coordination.log"
    # Only DERIVED when the caller named none, so an explicit telemetry route
    # is never clobbered.
    if [ -z "${FRAM_TELEMETRY_LOG:-}" ]; then
      export FRAM_TELEMETRY_LOG="$_north_log_dir/telemetry.log"
    fi
  fi
  unset _north_log_dir
fi
unset _north_fram_log_explicit
export FRAM_TIME_DIR="${FRAM_TIME_DIR:-$HOME/.local/state/north/time}"
# TRANSITIONAL_SCHEMA_BOOTSTRAP: graph declarations win whenever present. Keep
# this compatibility set only until a verified two-corpus snapshot, canonical
# schema-migrate execution, strict audit, and restart proof have all landed; its
# removal is deliberately sequenced after that live-data cutover.
export FRAM_SINGLE_VALUED="${FRAM_SINGLE_VALUED:-title owner lead driver source part_of do_on valid_until estimate_hours wip_floor created_at updated_at name display_name body created_by committed outcome abandoned superseded_by merged_into session_of start_time end_time clocked_by clock_orphaned clockify_id rate invoice_id invoice_state linear kind coordinator provider_target live_input live_input_state live_input_epoch target_identity_manifest_sha256 requested_target fallback_target_path broadcast_audience_version code_port code_log judgment_grade started blocked landed handoff}"
# North DECLARES its lifecycle vocab to the (now genericized) Fram kernel —
# value-identical to the kernel default, so this is the explicit-config form of
# what was previously baked in (Fram >= ec7ef90: FRAM_TERMINAL_PREDS/WITHDRAWN_PREDS).
export FRAM_TERMINAL_PREDS="${FRAM_TERMINAL_PREDS:-outcome abandoned superseded_by}"
export FRAM_WITHDRAWN_PREDS="${FRAM_WITHDRAWN_PREDS:-abandoned}"
export CLOCKIFY_SECRET_FILE="${CLOCKIFY_SECRET_FILE:-/run/secrets/clockify-api-key}"
export NORTH_SOURCE="${NORTH_SOURCE:-tom}"
export NORTH_AUTHOR="${NORTH_AUTHOR:-tom_passarelli}"
export NORTH_LEAD="${NORTH_LEAD:-tom_passarelli}"
export NORTH_DRIVER="${NORTH_DRIVER:-tom_passarelli}"
export NORTH_PROPOSED_BY="${NORTH_PROPOSED_BY:-tom_passarelli}"

NORTH="$(cd "$(dirname "$0")/.." && pwd)"

# Panic is deliberately the first route after locating this checkout. It must
# remain usable when bb, Fram, the world manifest, and the coordinator are unavailable.
if [ "${1:-}" = "panic" ]; then
  exec "$NORTH/bin/north-panic" "${@:2}"
fi

_north_world_manifest="${WORLD_MANIFEST_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/world/manifest.env}"
if [ -f "$_north_world_manifest" ]; then
  if ! bash -n "$_north_world_manifest"; then
    echo "north: invalid world manifest: $_north_world_manifest" >&2
    exit 2
  fi
  # shellcheck disable=SC1090
  source "$_north_world_manifest"
fi
FRAM="${FRAM_HOME:-${WORLD_REPO_FRAM:-$HOME/code/fram/main}}" # world:allow — compiled fallback
FRAM_BIN="${FRAM_BIN:-$FRAM/bin}"
FRAM_OUT="${FRAM_OUT:-$FRAM/out}"
export FRAM_HOME="$FRAM" FRAM_BIN FRAM_OUT
unset _north_world_manifest

# A promoted deployment's exec unit may carry a PATH with neither bb nor
# NORTH_BB: fall back through PATH, then the fixed NixOS system-profile path,
# before failing loud — the promoted tree must not depend on a nix wrapper.
if [ -n "${NORTH_BB:-}" ]; then
  BB="$NORTH_BB"
elif command -v bb >/dev/null 2>&1; then
  BB="bb"
elif [ -x /run/current-system/sw/bin/bb ]; then
  BB="/run/current-system/sw/bin/bb"
else
  echo "north: cannot find babashka — tried \$NORTH_BB, PATH, /run/current-system/sw/bin/bb" >&2
  exit 127
fi
BUN="${NORTH_BUN:-bun}"

if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
  if [ -z "${FRAM_TELEMETRY_LOG:-}" ]; then
    echo "north: NORTH_TELEMETRY_PARTITION=1 requires FRAM_TELEMETRY_LOG" >&2
    exit 2
  fi
  if [[ ! "${NORTH_TELEMETRY_PORT:-}" =~ ^[0-9]+$ ]] ||
     (( 10#$NORTH_TELEMETRY_PORT < 1 || 10#$NORTH_TELEMETRY_PORT > 65535 )); then
    echo "north: NORTH_TELEMETRY_PARTITION=1 requires NORTH_TELEMETRY_PORT=1..65535" >&2
    exit 2
  fi
  NORTH_MAIN=("$BB" -cp "$NORTH/out:$FRAM_OUT" "$NORTH/cli/partitioned-main.clj")
else
  NORTH_MAIN=("$BB" -cp "$NORTH/out:$FRAM_OUT" -m north.main)
fi

# CONCURRENCY GATE — bound how many corpus-loading verb JVMs can exist at once.
#
# Every engine verb below spawns a bb JVM that loads the ENTIRE live corpus
# (~350k facts, ~500 MB RSS) before answering. Nothing bounded how many could
# run simultaneously. On 2026-07-29, five concurrent agent sessions issuing
# verbs against a slowed coordinator accumulated ~150 standing JVMs: 75 GB of
# RSS, memory at 94/94 GB with 0 bytes available, load 176, the box seconds
# from OOM. Twice in one afternoon.
#
# The gate is N slot files under the user runtime dir, acquired with flock.
# The lock fd is inherited through exec, so a slot is held exactly as long as
# the verb process lives and is released by the kernel no matter how it dies —
# no daemon, no cleanup, no stale state possible.
#
# A caller that cannot get a slot WAITS (cheap bash, ~2 MB — waiting is the
# point; it is what 500 MB JVMs were doing before) and after the deadline
# FAILS LOUDLY. Proceeding anyway would recreate the pile-up the gate exists
# to prevent.
#
# Interactive/streaming paths (watch, listen, fram passthrough) do not route
# through these exec sites and are unaffected.
NORTH_VERB_SLOTS="${NORTH_VERB_SLOTS:-8}"
NORTH_VERB_SLOT_WAIT="${NORTH_VERB_SLOT_WAIT:-120}"
north_slot_exec() {
  if command -v flock >/dev/null 2>&1 && [ "$NORTH_VERB_SLOTS" -gt 0 ] 2>/dev/null; then
    local dir="${XDG_RUNTIME_DIR:-/tmp}/north-verb-slots" i fd
    mkdir -p "$dir" 2>/dev/null || { exec "${NORTH_MAIN[@]}" "$@"; }
    # First pass: any free slot, without blocking.
    for ((i = 1; i <= NORTH_VERB_SLOTS; i++)); do
      exec {fd}>>"$dir/slot-$i" 2>/dev/null || continue
      if flock -n "$fd" 2>/dev/null; then
        exec "${NORTH_MAIN[@]}" "$@"
      fi
      exec {fd}>&-
    done
    # All busy: block on one slot with a deadline.
    i=$(( (RANDOM % NORTH_VERB_SLOTS) + 1 ))
    exec {fd}>>"$dir/slot-$i" 2>/dev/null && {
      if flock -w "$NORTH_VERB_SLOT_WAIT" "$fd" 2>/dev/null; then
        exec "${NORTH_MAIN[@]}" "$@"
      fi
      echo "north: all $NORTH_VERB_SLOTS verb slots busy for ${NORTH_VERB_SLOT_WAIT}s — refusing to pile on." >&2
      echo "north: the coordinator is likely overloaded; check \`north doctor\`. Raise NORTH_VERB_SLOTS to override." >&2
      exit 75  # EX_TEMPFAIL: transient, retryable
    }
  fi
  # flock missing or gate disabled: run ungated rather than break the CLI.
  exec "${NORTH_MAIN[@]}" "$@"
}

# Unrestricted thread authoring is positive authority, never the absence of
# managed topology. The kernel-owned cgroup path is checked before the private
# capability because a same-UID agent can manufacture both token inputs.
process_is_in_agent_slice() {
  local cgroup_file="${1:-/proc/self/cgroup}" line path
  builtin test -r "$cgroup_file" || return 1
  while IFS= builtin read -r line || builtin test -n "$line"; do
    path="${line#*:}"
    path="${path#*:}"
    case "/${path#/}/" in
      */agent.slice/*) return 0 ;;
    esac
  done <"$cgroup_file"
  return 1
}

if process_is_in_agent_slice /proc/self/cgroup; then
  north_agent_cgroup=1
else
  north_agent_cgroup=0
fi

north_trusted_thread_writer=0
consume_trusted_thread_write_capability() {
  local supplied_token="${NORTH_THREAD_WRITE_CAPABILITY:-}"
  local capability_file="${NORTH_THREAD_WRITE_CAPABILITY_FILE:-}"
  local authority_dir resolved_dir resolved_file owner mode
  local capability_parent stored_token extra

  unset NORTH_THREAD_WRITE_CAPABILITY NORTH_THREAD_WRITE_CAPABILITY_FILE
  [ "$north_agent_cgroup" -eq 0 ] || return 0
  [ -n "$supplied_token" ] && [ -n "$capability_file" ] || return 0
  [[ "$supplied_token" =~ ^[0-9a-f]{64}$ ]] || return 0

  authority_dir="${XDG_RUNTIME_DIR:-/tmp}/north-thread-write-authority"
  resolved_dir="$(readlink -f -- "$authority_dir" 2>/dev/null)" || return 0
  resolved_file="$(readlink -f -- "$capability_file" 2>/dev/null)" || return 0
  case "$resolved_file" in "$resolved_dir"/*) ;; *) return 0 ;; esac
  [ ! -L "$capability_file" ] && [ -f "$capability_file" ] || return 0
  owner="$(stat -c %u -- "$capability_file" 2>/dev/null)" || return 0
  mode="$(stat -c %a -- "$capability_file" 2>/dev/null)" || return 0
  [ "$owner" = "$(id -u)" ] && [ "$mode" = 600 ] || return 0
  IFS=' ' read -r capability_parent stored_token extra <"$capability_file" || return 0
  [ -z "${extra:-}" ] || return 0
  [ "$capability_parent" = "$PPID" ] || return 0
  [ "$stored_token" = "$supplied_token" ] || return 0
  north_trusted_thread_writer=1
}

consume_trusted_thread_write_capability

# Agent thread reports are a bounded delivery protocol, not a general graph
# editor. Evidence retains its separate capability-bound writer. Missing,
# malformed, stale, or forged authority all select this bounded path.
guard_agent_thread_write() {
  [ "$north_trusted_thread_writer" -eq 0 ] || return 0
  case "${1:-}" in
    capture)
      echo "north: capture REFUSED — unrestricted thread-write authority is absent; return the request to the user" >&2
      return 1
      ;;
    tell)
      if [ "$#" -ne 4 ]; then
        echo "north: tell REFUSED — agent reports require exactly: <thread> <started|checkpoint|blocked|landed|handoff> <value>" >&2
        return 1
      fi
      case "${3:-}" in
        started|checkpoint|blocked|landed|handoff) return 0 ;;
        *)
          echo "north: tell REFUSED — agent sessions may report only started, checkpoint, blocked, landed, or handoff" >&2
          return 1
          ;;
      esac
      ;;
    retract|untell|set|merge|import)
      echo "north: $1 REFUSED — unrestricted thread-write authority is absent" >&2
      return 1
      ;;
  esac
}

guard_agent_thread_write "$@" || exit 1

# judgment_grade is dispatcher/orchestrator-owned calibration input, never an
# agent delivery report. New values pass the one canonical parser;
# malformed legacy values can still be retracted by an ambient human/orchestrator.
# `set` is included because the generic engine passthrough would otherwise bypass
# the coordinated tell policy (and remains discouraged under concurrency).
guard_judgment_grade_write() {
  case "${1:-}" in tell|retract|untell|set) ;; *) return 0 ;; esac
  [ "${3:-}" = judgment_grade ] || return 0
  case "${AGENT_TOPOLOGY:-}" in
    ""|orchestrator) ;;
    *)
      echo "north: $1 REFUSED — judgment_grade is dispatcher/orchestrator-owned; worker topology cannot mutate it" >&2
      return 1 ;;
  esac
  case "$1" in
    tell|set)
      if [ "$#" -ne 4 ]; then
        echo "north: $1 REFUSED — judgment_grade requires exactly one value: s, m, or l" >&2
        return 1
      fi
      "$BUN" run "$NORTH/sdk/src/judgment-grade.ts" validate "$4" >/dev/null || {
        echo "north: $1 REFUSED — judgment_grade must be exactly one of: s, m, l" >&2
        return 1
      }
      ;;
  esac
}

guard_judgment_grade_write "$@" || exit 1

# Agent identity/lifecycle is harness evidence, not agent-authored data:
# generic fact verbs may not mutate
# any agent subject (self or peer). Trusted harness writes use a subprocess-only
# private writer not routed by this CLI; peer control remains an orchestrator
# operation. This is an application boundary, not same-UID hostile-code isolation.
# Run this before subject resolution: even a read/daemon failure is too late for
# an authorization boundary, and installed MCP `tell`/`retract` routes here too.
deny_worker_agent_mutation() {
  case "${AGENT_TOPOLOGY:-}" in ""|orchestrator) return 0 ;; esac
  case "${1:-}" in tell|retract|untell) ;; *) return 0 ;; esac
  local subject="${2:-}" predicate="${3:-}"
  subject="${subject#@}"
  case "$subject" in agent:*) ;; *) return 0 ;; esac
  echo "north: $1 REFUSED — worker topology cannot mutate agent identity or authority via generic facts ($subject $predicate); report work on the thread or return control to the orchestrator" >&2
  return 1
}

deny_worker_agent_mutation "$@" || exit 1

# Run reservations/evidence/telemetry are harness-owned for the same reason as
# agent identity. A worker records proof only through `north evidence record`;
# generic facts must not bypass the capability-bound writer or poison another
# lane's write-once run subject.
deny_generic_run_mutation() {
  case "${1:-}" in tell|retract|untell) ;; *) return 0 ;; esac
  local subject="${2:-}" predicate="${3:-}"
  subject="${subject#@}"
  case "$subject" in run-*|run:*) ;; *) return 0 ;; esac
  echo "north: $1 REFUSED — generic fact verbs cannot mutate harness-owned run facts ($subject $predicate); use 'north evidence record' for done-bar observations" >&2
  return 1
}

deny_generic_run_mutation "$@" || exit 1

prepare_agent_report_write() {
  [ "$north_trusted_thread_writer" -eq 0 ] || return 0
  [ "${1:-}" = tell ] || return 0
  case "${3:-}" in
    started|checkpoint|blocked|landed|handoff) ;;
    *) return 0 ;;
  esac

  local runtime_dir key now previous age wait
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/north-agent-reports"
  umask 077
  mkdir -p "$runtime_dir" || {
    echo "north: report REFUSED — cannot open the agent report rate-limit state" >&2
    return 1
  }
  key="$(
    printf '%s\0%s' \
      "${AGENT_ID:-${NORTH_AGENT_ID:-${NORTH_AUTHOR:-${AGENT_TOPOLOGY}}}}" \
      "${2#@}" | sha256sum
  )"
  key="${key%% *}"
  north_agent_report_marker="$runtime_dir/$key"
  exec {north_agent_report_lock_fd}>>"$runtime_dir/$key.lock" || {
    echo "north: report REFUSED — cannot lock the agent report rate limit" >&2
    return 1
  }
  flock -w 5 "$north_agent_report_lock_fd" || {
    echo "north: report REFUSED — agent report rate-limit lock is busy" >&2
    return 1
  }
  now="$(date +%s)"
  if [ -e "$north_agent_report_marker" ]; then
    previous="$(stat -c %Y "$north_agent_report_marker" 2>/dev/null || printf '%s' "$now")"
    age=$((now - previous))
    if [ "$age" -lt 600 ]; then
      wait=$((600 - age))
      echo "north: report REFUSED — agent reports are rate-limited to one per agent/thread every 600s (retry in about ${wait}s)" >&2
      return 1
    fi
  fi
}

exec_agent_report_write() {
  if [ -z "${north_agent_report_marker:-}" ]; then
    exec "$@"
  fi
  "$@"
  local status=$?
  if [ "$status" -eq 0 ]; then
    record_agent_report_success || return $?
  fi
  return "$status"
}

record_agent_report_success() {
  [ -n "${north_agent_report_marker:-}" ] || return 0
  touch "$north_agent_report_marker" || {
    echo "north: report committed but rate-limit state could not be recorded" >&2
    return 74
  }
}

# Cheap deployment-readiness boundary. Runtime identity comes from the selected
# coordinator generation and the live listener process; unlike coord-doctor,
# this never folds either log or reads the projected thread corpus. In Stage A,
# each sole writer has its own runtime selector and must attest independently.
coord_runtime_ready() {
  "$NORTH/bin/north-coord-up" --check-runtime || return $?
  if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
    local telemetry_runtime_state
    telemetry_runtime_state="${NORTH_TELEMETRY_RUNTIME_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/north/fram-telemetry-runtime}"
    env -u FRAM_TELEMETRY_LOG \
      NORTH_TELEMETRY_PARTITION=0 \
      FRAM_PORT="$NORTH_TELEMETRY_PORT" \
      FRAM_LOG="$FRAM_TELEMETRY_LOG" \
      NORTH_COORD_RUNTIME_STATE="$telemetry_runtime_state" \
      NORTH_COORD_SYSTEMD_UNIT=north-telemetry-coord.service \
      "$NORTH/bin/north-coord-up" --check-runtime
  fi
}

coord_safety_ready() {
  local coordination_port="${NORTH_PORT:-${FRAM_PORT:-7977}}"

  # Runtime identity proves that the intended immutable generation owns each
  # listener. The strict probes then prove an exact-log fenced round trip
  # without folding either log or loading the projected thread corpus.
  coord_runtime_ready || return $?
  "$BB" "$NORTH/cli/coord.clj" strict-probe \
    "$coordination_port" "$FRAM_LOG" >/dev/null || return $?
  echo "coordinator strict log fence OK on :$coordination_port"

  if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
    env -u FRAM_TELEMETRY_LOG \
      NORTH_TELEMETRY_PARTITION=0 \
      FRAM_PORT="$NORTH_TELEMETRY_PORT" \
      FRAM_LOG="$FRAM_TELEMETRY_LOG" \
      "$BB" "$NORTH/cli/coord.clj" strict-probe \
      "$NORTH_TELEMETRY_PORT" "$FRAM_TELEMETRY_LOG" >/dev/null || return $?
    echo "telemetry coordinator strict log fence OK on :$NORTH_TELEMETRY_PORT"
  fi
}

case "${1:-}" in
  ""|help|-h|--help)
    # THE CARD — one screen, grouped, "type this → do this". Bare `north` and
    # `north help` are the same implementation (help IS the card verb, not an
    # alias). Every line below is a command that actually works; verify before
    # adding. Kept honest by hand, not generated.
    cat <<'CARD'
north — your one card. Type a command to do the thing next to it.

  GET HELP
    north                              this card
    north <verb> --help                most verbs print their own usage

  SEE WHAT'S GOING ON
    north dashboard                    the cockpit: agents, concerns, board, health, profile
    north threads                      thread-kind overview: active/ready/blocked  (--all = everything; aliases: board, plate)
    north ready                        committed + unblocked work, start anytime, ranked by leverage
    north wip                          live managed lanes vs coordinator floor  (--check = exit 3 on pullable shortfall)
    north worktrees                    every repo's wt-* trees: drift, dirt, age, owning lane/concern  (--json)
    north agenda                       what's dated / overdue today
    north health                       coordination rollup: lanes ran/died, stale concerns
    north trace <id>                   diagnose one agent's lifecycle
    north templates                    Orchestration's reusable stock templates and routing defaults
    north routing report performance  current managed evidence  (--all = legacy/incomplete history)
    north routing report usage        provider work usage (never dollars / API credits)
    north routing report economics    bounded routing-cost signals + alert-only policy findings
    north routing report promotions   bespoke patterns for stock-template review
    north routing report calibration  run-local judgment/struggle detector cohorts
    north canary run --target ID|--matrix
                                       production-path managed-lane reliability canary
    north canary report --window N     rolling provider-vs-North canary failure rate
    north ccr prepare|retrieve         default-off structured-output CCR canary
    north schema                       the fact vocabulary in use
    north predicate ls|show|define     inspect or extend executable predicate entities
    north schema-migrate plan|audit    deterministic schema cutover and strict audit
    north snapshot create|verify|restore-plan
                                       immutable dual-log checkpoint and restore planning
    north corpus-transaction check-boundaries
                                       verify split-log append safety before maintenance

  HAND OFF WORK   (starts a new lane — your own channel never blocks)
    /delegate "<thing>" [--new]        chat: delegate; session context rides by
                                       default · --new = empty-context lane
    north delegate "<task>" (--role <worker> | --composite)
                                       shell: intake must classify atomic vs composite

  DRIVE AGENTS
    north agents [--json]              who's live now + stable machine roster
    north watch <id>                   tail an agent's transcript
    north steer <id> "<msg>"           inject a message into a running agent
    north mention <recipient> [--about <thread>] "<body>"
                                       durable sender-driven request; offline is allowed
    north interrupt <recipient> [--about <thread>] "<body>"
                                       urgent sender-driven request; live recipient required
    north follow <thread> [--as <principal>] [...]
                                       subscribe to observer-driven thread attention
    north unfollow <thread> [--as <principal>]
    north following [--as <principal>]
    north notifications [--as <principal>] [--all] [--mark-read]
                                       inspect and acknowledge durable notifications
    north retask <id> "<goal>"         redirect a running agent's goal
    north escalate needs-replan ...    checkpoint scope overrun + route it up the live parent chain
    north evidence record <bar> <result>
                                       bind done-bar evidence to this exact managed run
      --thread <id>                     no reservation in env: record UNRESERVED thread evidence
    north bars list|prune <thread>     groom a thread's done_when set back under the reserve limit
    north delivery attest <agent-id>   unavailable until verifier lanes have OS isolation
    north spawn <role> "<prompt>"      compose from Orchestration's staffing catalog
      --provider auto|anthropic|openai  select or auto-route the worker provider
      --taskGrade/--domain              independently override stock staffing axes
      --topology                        bespoke compositions only; stock topology is fixed
      --tier/--reasoning/--posture      capability, deliberation, and posture
      --assessment JSON|@file           canonical Orchestration selection sidecar (required for max)
      --pin-evidence JSON|@file         typed reason + <=24h expiry for any exact pin
      --rationale "why"                 required for a bespoke role
    (agents dispatch via MCP)          in-harness agents call mcp__north__dispatch / spawn

  LIFE   (capture thoughts, track work + time)
    north-author capture "<thought>"   trusted human/internal thread creation
    north show <id>                    read one thread's facts
    north-author tell <id> <pred> <val>
                                       trusted fact authoring   (retract … to remove)
    north tell <id> <report> <value>   bounded agent report: started, checkpoint,
                                       blocked, landed, or handoff
    north clock in <owner>|out         open/close one human client billing session
    north clock start|stop             compatibility aliases for legacy thread sessions
    north clock audit                  commits-vs-clock coverage drift report
    north rebuild request --why ...    queue a rebuild ask (returns at once; never builds)
    north rebuild-intent start ...     coordinate a held/batched firn rebuild
    north linear get|import|plan|sync  mechanical Linear bridge (sync is plan-only unless --apply)

  SETTINGS & HEALTH
    north config                       posture + routing policy in one report
    north config routing               provider order, pressure, reserves, envelopes
    north account add|login|status     manage provider subscription accounts
    north account usage [id]           subscription windows, resets, and unknown reasons
    north account availability         cached per-account availability verdicts
    north account list [--verbose]    grouped accounts + live login state
    north failover check              classify the active provider rungs and name a same-tier heir
    north failover fire --thread ID --brief PATH [--dry-run]
                                       compose or launch a provider-recovery team lead
    north spend status [target]        API-billing budget: cap, reserved, settled, headroom
    north spend init|override <target> create a guarded budget · add a time-boxed override
    north providers                    provider readiness and auto-route decision
    north coord-ready                  cheap exact runtime identity for every active writer
    north coord-safety                 bounded identity + strict log-fence round trip
    north doctor                       is everything healthy — daemons, rev skew, env, hooks
CARD
    exit 0 ;;
  clock)
    # `clock audit` is a standalone read-only report (commits-vs-sessions coverage,
    # bin/north-clock-audit); every other clock verb is engine-side in north.main.
    if [ "${2:-}" = "audit" ]; then exec "$NORTH/bin/north-clock-audit" "${@:3}"; fi
    north_slot_exec "$@" ;;
  threads)
    # Kind-scoped noun command: the THREAD-kind overview (threads are one kind
    # among several in the store — see `north schema`; people/concerns/runs are
    # not threads). Same projection the kanban-metaphor aliases render: active
    # drivers + top-ready by leverage + counts. `board`/`plate` = legacy aliases.
    # Future kinds follow the pattern (`north people` when a person registry lands).
    north_slot_exec board "${@:2}" ;;
  ready|blocked|leverage|next|agenda|board|plate|capture|json|needs-review|audit|resolve|validate|schema|schema-seed|tools|heal|boot)
    # `validate` runs north's FULL check (engine-generic ++ north work rules,
    # north.validate) — the fram CLI `validate` is generic-only since the work
    # rules moved out of the kernel. The MCP validate tool shells through here too.
    north_slot_exec "$@" ;;
  coord-ready)
    coord_runtime_ready ;;
  coord-safety)
    coord_safety_ready ;;
  coord-doctor)
    # Engine-level coordinator SAFETY handshake + log-hygiene diff (north.main
    # cmd-doctor): tell/untell safe? daemon state matches on-disk log? This is the
    # raw primitive the cockpit `north doctor` leads with. Renamed from the old bare
    # `north doctor` (2026-07-10) when the convoy cockpit doctor folded in.
    coord_runtime_ready || exit $?
    north_slot_exec doctor "${@:2}" ;;
  dashboard|doctor)
    # The cockpit (ported from convoy/bin/my-agents, 2026-07-10): `dashboard` =
    # what is happening (agents/concerns/board/daemons/health/profile); `doctor` =
    # is everything healthy (coordinator handshake + daemons/health/rev-skew/env/
    # guard-hooks). Both teach the primitive they wrap. cli/dashboard-cli.clj.
    exec "$BB" "$NORTH/cli/dashboard-cli.clj" "$@" ;;
  hotspots)
    # Where is the time going and what is failing, ranked (north hotspots is
    # already the work-queue unblocker ranking, so this is hotspots) — read out of the
    # telemetry that ALREADY exists (coordinator slow-read attribution, agent
    # logs). Adds no instrumentation and no daemon. cli/hotspots-cli.clj.
    exec "$BB" "$NORTH/cli/hotspots-cli.clj" "${@:2}" ;;
  deployed)
    # Is the code I committed the code that is RUNNING? Three columns, because a
    # change gets stuck in three different places: committed but not built
    # (rebuild), built but not adopted by the live process (restart), or live.
    # Those need opposite actions, so the table never merges them.
    # cli/deployed-cli.clj.
    exec "$BB" "$NORTH/cli/deployed-cli.clj" "${@:2}" ;;
  config)
    # Personal-stack posture + durable provider routing policy.
    # + the no-arg full report. Ported from dotfiles/bin/my-agent-config (bash)
    # 2026-07-10: north is the settings surface. Provider-neutral state lives at
    # ~/.local/state/north/harness.conf; the Claude-era path is a read-only
    # migration fallback. cli/config-cli.clj.
    exec "$BB" "$NORTH/cli/config-cli.clj" "${@:2}" ;;
  providers)
    exec "$BUN" run "$NORTH/sdk/src/providers-cli.ts" "${@:2}" ;;
  account)
    # Isolated Claude Code / Codex subscription account homes. The TypeScript
    # CLI owns path validation, allowlisted config links, and normalized auth.
    exec "$BUN" run "$NORTH/sdk/src/account-cli.ts" "${@:2}" ;;
  failover)
    # Provider-recovery control surface. Availability is read through the stable
    # cached JSON boundary; only `fire` without --dry-run may launch an heir.
    exec "$BUN" run "$NORTH/sdk/src/failover-cli.ts" "${@:2}" ;;
  handoff)
    # Renamed to `failover` (2026-07-30): "handoff" is doctrine vocabulary.
    echo "renamed: use \`north failover\`" >&2
    exit 1 ;;
  spend)
    # API-billing budget LEDGER (spend-guard step 2). Owns schema declaration,
    # the cap-checked CAS reservation, terminal settlement, and human overrides
    # on the coordination log via cli/coord.clj — writes the coordinator wire the
    # read-only TS SDK client cannot. init/status/override are the cockpit surface
    # (each prints the primitive it runs); reserve/settle/headroom are machine
    # verbs the admission + terminal seams shell out to.
    exec "$BB" "$NORTH/cli/spend-cli.clj" "${@:2}" ;;
  delivery)
    # Historical attestation surface. Shared-UID agents cannot establish an
    # independent verifier boundary, so promotion fails closed.
    exec "$BUN" run "$NORTH/sdk/src/delivery-attest.ts" "${@:2}" ;;
  evidence)
    # Capability-bound self-reporting surface. Run/thread/reporter are inherited
    # from the managed child environment; callers supply only exact bar + result.
    # With NO reservation in the environment it falls back to explicitly
    # unreserved thread-scoped evidence (never run-bound verification).
    exec "$BUN" run "$NORTH/sdk/src/delivery-evidence.ts" "${@:2}" ;;
  bars)
    # Coordinator-facing done_when grooming: the one-step recovery the delivery
    # reserve error points at when a thread accumulates past the bar limit.
    exec "$BB" "$NORTH/cli/bars-cli.clj" "${@:2}" ;;
  rebuild-intent)
    # Rebuild coordination is a fact + finite live-roster broadcast protocol.
    # The Clojure module owns its CAS-closed hold/response/all-clear state.
    exec "$BB" "$NORTH/cli/rebuild-intent-cli.clj" "${@:2}" ;;
  rebuild)
    # The QUEUE in front of that protocol: `request` records a durable ask and
    # returns immediately — an agent never fires a rebuild itself. The reactor's
    # window owner is the only collector. cli/rebuild-request-cli.clj.
    exec "$BB" "$NORTH/cli/rebuild-request-cli.clj" "${@:2}" ;;
  linear)
    # Zero-turn Linear adapter over Codex app-server MCP. `sync` defaults to a
    # read-only plan; only an explicit `sync <thread> --apply` writes remotely.
    exec "$BUN" run "$NORTH/sdk/src/integrations/linear/cli.ts" "${@:2}" ;;
  provider-observe)
    # Hidden machine-ingestion surface. Interactive adapters feed provider
    # telemetry here; it is intentionally silent and best-effort.
    exec "$BUN" run "$NORTH/sdk/src/provider-observations-cli.ts" "${@:2}" ;;
  ccr)
    # Explicit canary only: this does not intercept provider tool results or
    # change provider prompts/tool lists. Compression requires --enable.
    exec "$BUN" run "$NORTH/sdk/src/ccr-cli.ts" "${@:2}" ;;
  predicate)
    # Generated read/authoring projection over exact executable @<predicate>
    # entities. Bootstrap inventory is available only through its explicitly
    # weak offline lint; connected commands read the graph authority.
    exec "$BB" "$NORTH/cli/pred-cli.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  schema-migrate)
    # Exact Fram fold over coordination + telemetry. Canonical execution is a
    # maintenance operation and must follow a verified two-corpus snapshot;
    # plan/audit remain read-only at all times.
    exec "$BB" -cp "$FRAM_OUT" "$NORTH/cli/schema-migrate.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  snapshot)
    # Content-addressed dual-log preservation. Create and restore-plan default
    # to dry-run; restore-plan can only emit a corpus-transaction plan and has
    # no authority to apply it or mutate the selected live corpus.
    exec "$BB" -cp "$FRAM_OUT" "$NORTH/cli/snapshot-cli.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  corpus-transaction)
    # Package-owned split-corpus replacement/recovery. The mutable journal and
    # immutable preimage/receipt objects live under XDG state, never in a
    # checkout; the system unit invokes the same route before/after daemon boot.
    exec "$BB" -cp "$FRAM_OUT" "$NORTH/cli/corpus-transaction-cli.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  up)
    if [ "${NORTH_TELEMETRY_PARTITION:-0}" != 1 ]; then
      exec "$NORTH/bin/north-coord-up" "${@:2}"
    fi
    if [ "${2:-}" = "--stop" ]; then
      env -u FRAM_TELEMETRY_LOG \
        NORTH_TELEMETRY_PARTITION=0 \
        FRAM_PORT="$NORTH_TELEMETRY_PORT" \
        FRAM_LOG="$FRAM_TELEMETRY_LOG" \
        NORTH_COORD_SYSTEMD_UNIT=north-telemetry.service \
        "$NORTH/bin/north-coord-up" --stop
      exec env -u FRAM_TELEMETRY_LOG \
        NORTH_TELEMETRY_PARTITION=0 \
        NORTH_COORD_SYSTEMD_UNIT=north-coord.service \
        "$NORTH/bin/north-coord-up" --stop
    fi
    env -u FRAM_TELEMETRY_LOG \
      NORTH_TELEMETRY_PARTITION=0 \
      NORTH_COORD_SYSTEMD_UNIT=north-coord.service \
      "$NORTH/bin/north-coord-up" "${@:2}"
    exec env -u FRAM_TELEMETRY_LOG \
      NORTH_TELEMETRY_PARTITION=0 \
      FRAM_PORT="$NORTH_TELEMETRY_PORT" \
      FRAM_LOG="$FRAM_TELEMETRY_LOG" \
      NORTH_COORD_SYSTEMD_UNIT=north-telemetry.service \
      "$NORTH/bin/north-coord-up" "${@:2}" ;;
  agents|templates|spawn|delegate|request|fork|req|watch|steer|retask|escalate)
    # Agent verbs — agents are a north concern (spawn/presence/facts live here).
    # Implementation: cli/agents-cli.clj (ported from the convoy cockpit 2026-07-09).
    exec "$BB" "$NORTH/cli/agents-cli.clj" "$@" ;;
  follow|unfollow|following|notifications)
    # Durable observer attention. attention-cli owns the complete argument
    # contract; this wrapper deliberately forwards the verb and tail unchanged.
    exec "$BB" "$NORTH/cli/attention-cli.clj" "${NORTH_PORT:-7977}" "$@" ;;
  mention|interrupt)
    # Sender-driven attention. Prefer the live harness identity, then North's
    # stable agent id, then the configured author identity. The shared comms
    # seam owns transport selection; no Attention entry point bypasses it.
    _north_attention_sender="${AGENT_ID:-${NORTH_AGENT_ID:-${NORTH_AUTHOR:-}}}"
    exec "$NORTH/bin/north-comms" \
      "$1" "$_north_attention_sender" "${@:2}" ;;
  trace)
    # Single-agent lifecycle diagnosis — walk the invariant-spine checklist for one id,
    # flag the first failing stage (F1–F7). Read-only. cli/trace-cli.clj.
    exec "$BB" "$NORTH/cli/trace-cli.clj" "${@:2}" ;;
  health)
    # Aggregate coordination rollup — one durable log fold (lane outcomes, stale
    # concerns, ping-loss, zombie forks, died-unreported). Read-only. cli/health-cli.clj.
    exec "$BB" "$NORTH/cli/health-cli.clj" "${@:2}" ;;
  wip)
    # Presence-derived managed lanes + reservation thread bindings, coordinator
    # floor, and the ready/leverage pull queue. Read-only. cli/wip-cli.clj.
    exec "$BB" -cp "$NORTH/out:$FRAM_OUT" "$NORTH/cli/wip-cli.clj" "${@:2}" ;;
  dials)
    # Compatibility bridge to the evidence-aware report. Dollar-centric dial
    # scoring is intentionally retired for subscription entitlement routing.
    exec "$BB" "$NORTH/cli/dials-cli.clj" "${@:2}" ;;
  routing)
    # Empirical routing feedback joins run telemetry to its exact proof-carrying
    # lane terminal, with current thread facts retained only as review context.
    # It never claims causal model quality or auto-promotes bespoke recurrence.
    exec "$BB" "$NORTH/cli/routing-report.clj" "${@:2}" ;;
  canary)
    # Recurring reliability probe. `run` composes the existing capture + delegate
    # production path; `report` reads the same terminal telemetry and failure
    # attribution as routing performance.
    exec "$BB" "$NORTH/cli/canary-cli.clj" "${@:2}" ;;
  stream-sync)
    # Zero-AI cursor-based transcript log-shipping (streams/CLAUDE.md) — a
    # plain bash script, not a north.main verb, so it execs directly.
    exec "$NORTH/bin/north-stream-sync" "${@:2}" ;;
  listen)
    # Real-time interrupt listener — RUN AS A BACKGROUND TASK. Dormant (zero
    # tokens) until a peer addresses you, then prints the message and exits:
    # that exit is the interrupt. Read it, act, re-arm. bin/north-arm = alias.
    exec "$BB" "$NORTH/cli/north-listen.clj" "${NORTH_PORT:-7977}" "${2:?usage: north listen <agent-id>}" --once --ack "${@:3}" ;;
  reactor)
    # Coordinator AUTO-EXPORT sidecar — RUN AS A LONG-LIVED BACKGROUND TASK next to
    # the daemon. Subscribes to the coordinator commit firehose and re-projects
    # touched threads (`heal`, debounced) so threads/*.md never lag the log. Rides
    # the existing :subscribe seam — no daemon change. Inherits FRAM_LOG/FRAM_THREADS.
    #   north reactor [port] [debounce-ms]   (defaults: 7977, 400)
    exec "$BB" "$NORTH/cli/north-reactor.clj" "${2:-${NORTH_PORT:-7977}}" "${@:3}" ;;
  worktrees)
    # Machine-wide worktree census: every wt-* sibling of a container repo's main
    # checkout, joined to live concerns and graph lane registrations. Read-only.
    # cli/worktrees-cli.clj.
    exec "$BB" "$NORTH/cli/worktrees-cli.clj" "${@:2}" ;;
  worktree)
    # Explicit landing reconciliation. It never pushes and removes only
    # harvested lane refs already proved reachable from main.
    if [ "${2:-}" = "lander" ]; then
      exec "$BB" "$NORTH/cli/worktree-lander.clj" "${@:3}"
    fi
    echo "usage: north worktree lander [repository]" >&2
    exit 2 ;;
  show|history)
    # Stage A gives telemetry subjects an independent sole writer. Generic Fram
    # reads otherwise ask only the coordination writer and turn a real telemetry
    # subject into a false "no facts" result. Exact namespace-qualified reads
    # follow the same subject router as writes and fail closed when that writer
    # is unavailable; partition-off (A1/rollback) keeps the prior Fram surface.
    if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
      case "${2#@}" in
        run:*|session:*|mine:*|guard_denial:*)
          exec "$BB" -cp "$NORTH/out:$FRAM_OUT" \
            "$NORTH/cli/subject-read-cli.clj" "$@"
          ;;
      esac
    fi
    exec "$FRAM_BIN/fram" "$@" ;;
  tell|untell|retract)
    # `retract` is the primary agent-facing retraction verb (R&N TELL/RETRACT);
    # `untell` is an accepted legacy alias. Both map onto fram's `untell` CLI verb
    # (whose wire op is already "retract") at the boundary below.
    # Handles (and @ids) are a NORTH concern: fram is handle-blind and re-adds
    # the leading @ to the bare subject it's handed. So resolve the SUBJECT ref to
    # its canonical id here first — that's what makes `north tell @perf ...`
    # land on the right thread — then pass fram the bare canonical id. Only rewrite
    # when the full `tell <id> <pred> <value>` shape is present; otherwise pass
    # through untouched so fram's own usage/arg checks are unchanged.
    if [ "$#" -ge 4 ]; then
      north_exact_subject=0
      # FAIL-CLOSED: an unresolvable id-like ref (or a dead resolver) aborts the
      # write — passing the raw ref through would mint a phantom subject under a
      # truncated id and strand the facts (2026-07-03 incident: 19 orphans).
      bare_subject="${2#@}"
      if [[ "$bare_subject" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        # Exact UUID writes use Fram's one-request atomic operation below. It
        # checks existence and commits in one coordinator turn, and never
        # renders/scans provenance merely to prove that the subject exists.
        canon="@$bare_subject"
        north_exact_subject=1
      else
        canon="$("${NORTH_MAIN[@]}" resolve "$2" 2>/dev/null)"
      fi
      case "$canon" in
        ERROR*) echo "north: $1 REFUSED — ${canon#ERROR }" >&2; exit 1 ;;
        "")     echo "north: $1 REFUSED — subject resolver unavailable for '$2' (build out/? daemon?)" >&2; exit 1 ;;
        *)      set -- "$1" "${canon#@}" "${@:3}" ;;
      esac
    fi
    prepare_agent_report_write "$@" || exit 1
    framverb="$1"; [ "$framverb" = retract ] && framverb=untell
    # Done-bars echo (friction gradient): closing a barred thread SEES its bars
    # at the moment of judgment — a reminder, never a reject. cmd-done-bars is
    # silent for bar-less threads; failures never block the write.
    if [ "$framverb" = tell ] && [ "${3:-}" = outcome ]; then
      "$BB" "$NORTH/cli/bars-cli.clj" echo "$2" 2>/dev/null || true
    fi
    # Reserve-limit echo: bars accumulate across runs, so the Nth done_when is
    # what silently makes future managed runs unable to reserve delivery
    # evidence. Warn at write time (advisory, never a reject) and name the
    # one-step recovery. Runs only for done_when tells.
    if [ "$framverb" = tell ] && [ "${3:-}" = done_when ] && [ -n "${4:-}" ]; then
      "$BB" "$NORTH/cli/bars-cli.clj" check "$2" "$4" || true
    fi
    case "${2#@}" in
      run:*|session:*|mine:*|guard_denial:*)
        if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
          exec_agent_report_write env -u FRAM_TELEMETRY_LOG \
            FRAM_PORT="$NORTH_TELEMETRY_PORT" \
            FRAM_LOG="$FRAM_TELEMETRY_LOG" \
            "$FRAM_BIN/fram" "$framverb" "${@:2}"
          exit $?
        fi ;;
    esac
    if [ "${north_exact_subject:-0}" = 1 ]; then
      existing_output="$(
        "$FRAM_BIN/fram" "${framverb}-existing" "${@:2}" 2>&1
      )"
      existing_status=$?
      case "$existing_status" in
        0)
          record_agent_report_success || exit $?
          printf '%s\n' "$existing_output"
          exit 0
          ;;
        3)
          echo "north: $1 REFUSED — unresolved id-like ref ${2#@} — not a live exact thread id" >&2
          exit 1
          ;;
        4)
          echo "north: $1 REFUSED — subject resolver unavailable for '${2#@}' (coordinator unavailable or incompatible)" >&2
          exit 1
          ;;
        *)
          printf '%s\n' "$existing_output" >&2
          exit "$existing_status"
          ;;
      esac
    fi
    exec_agent_report_write "$FRAM_BIN/fram" "$framverb" "${@:2}"
    exit $? ;;
  *)  # engine verbs: import/export/set/merge/watch
    exec "$FRAM_BIN/fram" "$@" ;;
esac
