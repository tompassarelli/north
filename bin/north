#!/usr/bin/env bash
# North — the life app. Routes LIFE verbs to the North CLI (north.main,
# run against the Beagle Store engine on the classpath) and ENGINE verbs to the Beagle Store CLI.
# Both operate on the same private XDG coordination data. Supplies North's lifecycle
# configuration and capture provenance; executable predicate schema lives in
# the coordination graph itself.
#
#   engine: Nix-published FRAMRPC environment or explicit test env   data: XDG state
# `zero` is deliberately before every export below: it is the escape hatch when
# this wrapper or its state is the broken component.
if [ "${1:-}" = "zero" ]; then
  _north_self_dir="${0%/*}"
  [ "$_north_self_dir" = "$0" ] && _north_self_dir="."
  NORTH="$(cd "$_north_self_dir/.." && pwd)"
  exec "$NORTH/bin/north-zero" "${@:2}"
fi

# Self-located checkout root, same idiom as north-runtime/north-succession.
# Consumers prefer the live checkout over any composed copy (docs, bridge assets).
_north_home_dir="${0%/*}"
[ "$_north_home_dir" = "$0" ] && _north_home_dir="."
export NORTH_HOME="${NORTH_HOME:-$(cd "$_north_home_dir/.." && pwd)}"

export BEAGLE_STORE_THREADS="${BEAGLE_STORE_THREADS:-$HOME/.local/state/north/threads}"
# North DECLARES its lifecycle vocab to the (now genericized) Beagle Store kernel —
# value-identical to the kernel default, so this is the explicit-config form of
# what was previously baked in (Beagle Store >= ec7ef90: BEAGLE_STORE_TERMINAL_PREDS/WITHDRAWN_PREDS).
export BEAGLE_STORE_TERMINAL_PREDS="${BEAGLE_STORE_TERMINAL_PREDS:-outcome abandoned superseded_by}"
export BEAGLE_STORE_WITHDRAWN_PREDS="${BEAGLE_STORE_WITHDRAWN_PREDS:-abandoned}"
export NORTH_SOURCE="${NORTH_SOURCE:-tom}"
export NORTH_AUTHOR="${NORTH_AUTHOR:-tom_passarelli}"
export NORTH_LEAD="${NORTH_LEAD:-tom_passarelli}"
export NORTH_DRIVER="${NORTH_DRIVER:-tom_passarelli}"
export NORTH_PROPOSED_BY="${NORTH_PROPOSED_BY:-tom_passarelli}"
export NORTH_AGENT_LOGS_DIR="${NORTH_AGENT_LOGS_DIR:-$HOME/.local/state/north/agents}"

_north_self_dir="${0%/*}"
[ "$_north_self_dir" = "$0" ] && _north_self_dir="."
NORTH="$(cd "$_north_self_dir/.." && pwd)"

# Help is answered before any interpreter, Beagle Store, or coordinator is resolved,
# using shell builtins only: it must work on a completely empty PATH.
north_help() {
    # THE CARD + topic pages — projections of cli/surface.edn (regenerate:
    # bb cli/surface-gen.clj); cli/tests/surface-sync-test.clj welds registry,
    # rendered pages, and these case arms together.
    _north_help_dir="$NORTH/share/help"
    case "${2:-}" in
      "")        _north_help_file="$_north_help_dir/card.txt" ;;
      --all|all) _north_help_file="$_north_help_dir/all.txt" ;;
      *)         _north_help_file="$_north_help_dir/topic-${2}.txt" ;;
    esac
    if [ -f "$_north_help_file" ]; then
      printf '%s\n' "$(<"$_north_help_file")"
      exit 0
    fi
    if [ ! -f "$_north_help_dir/card.txt" ]; then
      echo "north: help pages missing from $_north_help_dir — regenerate: bb $NORTH/cli/surface-gen.clj" >&2
      exit 1
    fi
    echo "north: no help topic '${2:-}'" >&2
    _north_topics=""
    for _north_topic_file in "$_north_help_dir"/topic-*.txt; do
      _north_topic_file="${_north_topic_file##*/topic-}"
      _north_topics="$_north_topics ${_north_topic_file%.txt}"
    done
    echo "north: topics:$_north_topics  (north help --all = everything)" >&2
    exit 2
}

case "${1:-}" in
  ""|help|-h|--help) north_help "$@" ;;
esac

if [ "${1:-}" = "set" ]; then
  echo "north: direct Store writes are not supported; use tell or retract" >&2
  exit 1
fi

# Panic is deliberately the first route after locating this checkout. It must
# remain usable when bb, Beagle Store, the coordination data store, and the coordinator are unavailable.
if [ "${1:-}" = "panic" ]; then
  exec "$NORTH/bin/north-panic" "${@:2}"
fi

# Export is a local, read-only projection over immutable Bridge Wire journals.
# Keep it independent of Beagle Store and the coordinator so archived runs remain usable
# during an engine outage; the URL fragment key is emitted only by this process.
if [ "${1:-}" = "run-share" ]; then
  exec "${NORTH_BUN:-bun}" run "$NORTH/sdk/src/run-share-cli.ts" "${@:2}"
fi

# The PreToolUse dispatch guard needs these two policy answers before every
# shell call. Keep this read-only probe independent of Beagle Store so a missing or
# restarting engine cannot disable the harness itself. Full `north config`
# remains engine-backed below.
if [ "${1:-}" = "config" ] && [ "${2:-}" = "dispatch" ] \
  && [ "$#" -eq 3 ] \
  && { [ "$3" = "--guard-action" ] || [ "$3" = "--managed-admission" ]; }; then
  NORTH_DISPATCH_STATE="${NORTH_HARNESS_STATE:-$HOME/.local/state/north/harness.conf}"
  if [ ! -f "$NORTH_DISPATCH_STATE" ]; then
    NORTH_DISPATCH_STATE="${NORTH_LEGACY_HARNESS_STATE:-$HOME/.claude/my-config.state}"
  fi
  NORTH_DISPATCH_MODE=managed
  if [ -r "$NORTH_DISPATCH_STATE" ]; then
    while IFS= read -r NORTH_DISPATCH_LINE || [ -n "$NORTH_DISPATCH_LINE" ]; do
      case "$NORTH_DISPATCH_LINE" in
        dispatch=*) NORTH_DISPATCH_MODE="${NORTH_DISPATCH_LINE#dispatch=}" ;;
      esac
    done < "$NORTH_DISPATCH_STATE"
  fi
  case "$NORTH_DISPATCH_MODE" in
    native) NORTH_DISPATCH_GUARD=allow; NORTH_DISPATCH_ADMISSION=deny ;;
    managed) NORTH_DISPATCH_GUARD=deny; NORTH_DISPATCH_ADMISSION=allow ;;
    auto) NORTH_DISPATCH_GUARD=allow; NORTH_DISPATCH_ADMISSION=allow ;;
    *)
      echo "north: invalid dispatch mode: $NORTH_DISPATCH_MODE" >&2
      exit 1
      ;;
  esac
  if [ "$3" = "--guard-action" ]; then
    printf '%s\n' "$NORTH_DISPATCH_GUARD"
  else
    printf '%s\n' "$NORTH_DISPATCH_ADMISSION"
  fi
  exit 0
fi

# Both sandboxed paths — managed Codex exec and the read-only shell — refuse to run
# without bwrap, and an interactive PATH rarely carries one. The provider packages
# already declare it, so take it from the closure that requires it.
if [ -z "${NORTH_BWRAP_BIN:-}" ] && ! command -v bwrap >/dev/null 2>&1; then
  _north_codex_bin="${NORTH_MANAGED_CODEX_BIN:-${NORTH_MCP_MANAGED_CODEX_BIN:-}}"
  if [ -n "$_north_codex_bin" ] && command -v nix-store >/dev/null 2>&1; then
    _north_codex_pkg="$(cd "$(dirname "$(readlink -f "$_north_codex_bin")")/.." && pwd -P)"
    for _north_ref in $(nix-store --query --references "$_north_codex_pkg" 2>/dev/null); do
      case "$_north_ref" in
        *-bubblewrap-*)
          [ -x "$_north_ref/bin/bwrap" ] && export NORTH_BWRAP_BIN="$_north_ref/bin/bwrap"
          break ;;
      esac
    done
  fi
  unset _north_codex_bin _north_codex_pkg _north_ref
fi
STORE="${BEAGLE_STORE_HOME:?north requires the Nix-published FRAMRPC environment or explicit BEAGLE_STORE_HOME}"
BEAGLE_STORE_BIN="${BEAGLE_STORE_BIN:-$STORE/bin}"
BEAGLE_STORE_OUT="${BEAGLE_STORE_OUT:-${NORTH_STORE_OUT:-$STORE/out}}"
NORTH_STORE_OUT="${NORTH_STORE_OUT:-$BEAGLE_STORE_OUT}"
BEAGLE_STORE_CLI="${BEAGLE_STORE_CLI:-${STORE%/store}/bin/beagle}"
export BEAGLE_STORE_HOME="$STORE" BEAGLE_STORE_BIN BEAGLE_STORE_OUT NORTH_STORE_OUT
export BEAGLE_STORE_SPACE_ID="${BEAGLE_STORE_SPACE_ID:-north-coordination}"
# Launch admission requires NORTH_PORT explicitly; export it with the same default.
export NORTH_PORT="${NORTH_PORT:-7977}"
export BEAGLE_STORE_SERVER_PORT="${BEAGLE_STORE_SERVER_PORT:-$NORTH_PORT}"
export NORTH_TELEMETRY_SPACE_ID="${NORTH_TELEMETRY_SPACE_ID:-north-telemetry}"
# A checkout owns its Orchestration contract; the packaged tree ships none, so its env pin stands.
if [ -d "$NORTH/orchestration" ]; then
  export NORTH_ORCHESTRATION_HOME="$NORTH/orchestration"
fi
NORTH_RUNTIME_CLASSPATH="$NORTH/out:$BEAGLE_STORE_OUT"
BABASHKA_CLASSPATH="$NORTH_RUNTIME_CLASSPATH${BABASHKA_CLASSPATH:+:$BABASHKA_CLASSPATH}"
export NORTH_RUNTIME_CLASSPATH BABASHKA_CLASSPATH

# A promoted deployment's exec unit may carry a PATH with neither bb nor
# NORTH_BB: fall back through PATH, then the fixed NixOS system-profile path,
# before failing loud — the promoted tree must not depend on a nix wrapper.
if [ -n "${NORTH_BB:-}" ]; then
  BB="$NORTH_BB"
elif command -v bb >/dev/null 2>&1; then
  BB="bb"
elif [ -x /run/current-system/sw/bin/bb ]; then
  BB="/run/current-system/sw/bin/bb"
else
  echo "north: cannot find babashka — tried \$NORTH_BB, PATH, /run/current-system/sw/bin/bb" >&2
  exit 127
fi
BUN="${NORTH_BUN:-bun}"
# Every North data path speaks canonical FRAMRPC through the one façade.
NORTH_BARS=("$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/bars-cli.clj")
NORTH_MAIN=("$BB" -cp "$NORTH_RUNTIME_CLASSPATH" --init "$NORTH/cli/coord.clj" -m north.main)

# CONCURRENCY GATE — bound how many corpus-loading verb JVMs can exist at once.
#
# Every engine verb below spawns a bb JVM that loads the ENTIRE live corpus
# (~350k facts, ~500 MB RSS) before answering. Nothing bounded how many could
# run simultaneously. On 2026-07-29, five concurrent agent sessions issuing
# verbs against a slowed coordinator accumulated ~150 standing JVMs: 75 GB of
# RSS, memory at 94/94 GB with 0 bytes available, load 176, the box seconds
# from OOM. Twice in one afternoon.
#
# The gate is N slot files under the user runtime dir, acquired with flock.
# The lock fd is inherited through exec, so a slot is held exactly as long as
# the verb process lives and is released by the kernel no matter how it dies —
# no daemon, no cleanup, no stale state possible.
#
# A caller that cannot get a slot WAITS (cheap bash, ~2 MB — waiting is the
# point; it is what 500 MB JVMs were doing before) and after the deadline
# FAILS LOUDLY. Proceeding anyway would recreate the pile-up the gate exists
# to prevent.
#
# Interactive/streaming paths (watch, listen, Beagle Store passthrough) do not route
# through these exec sites and are unaffected.
NORTH_VERB_SLOTS="${NORTH_VERB_SLOTS:-8}"
NORTH_VERB_SLOT_WAIT="${NORTH_VERB_SLOT_WAIT:-120}"
north_slot_exec() {
  if command -v flock >/dev/null 2>&1 && [ "$NORTH_VERB_SLOTS" -gt 0 ] 2>/dev/null; then
    local dir="${XDG_RUNTIME_DIR:-/tmp}/north-verb-slots" i fd
    mkdir -p "$dir" 2>/dev/null || { exec "${NORTH_MAIN[@]}" "$@"; }
    # First pass: any free slot, without blocking.
    for ((i = 1; i <= NORTH_VERB_SLOTS; i++)); do
      { exec {fd}>>"$dir/slot-$i"; } 2>/dev/null || continue
      if flock -n "$fd" 2>/dev/null; then
        exec "${NORTH_MAIN[@]}" "$@"
      fi
      exec {fd}>&-
    done
    # All busy: block on one slot with a deadline.
    i=$(( (RANDOM % NORTH_VERB_SLOTS) + 1 ))
    { exec {fd}>>"$dir/slot-$i"; } 2>/dev/null && {
      if flock -w "$NORTH_VERB_SLOT_WAIT" "$fd" 2>/dev/null; then
        exec "${NORTH_MAIN[@]}" "$@"
      fi
      echo "north: all $NORTH_VERB_SLOTS verb slots busy for ${NORTH_VERB_SLOT_WAIT}s — refusing to pile on." >&2
      echo "north: the coordinator is likely overloaded; check \`north doctor\`. Raise NORTH_VERB_SLOTS to override." >&2
      exit 75  # EX_TEMPFAIL: transient, retryable
    }
  fi
  # flock missing or gate disabled: run ungated rather than break the CLI.
  exec "${NORTH_MAIN[@]}" "$@"
}

# judgment_grade is dispatcher/orchestrator-owned calibration input. Ordinary
# worker thread writes remain available, but managed workers cannot tell,
# retract, or cold-set this predicate. New values pass the one canonical parser;
# malformed legacy values can still be retracted by an ambient human/orchestrator.
guard_judgment_grade_write() {
  case "${1:-}" in tell|retract) ;; *) return 0 ;; esac
  [ "${3:-}" = judgment_grade ] || return 0
  case "${AGENT_TOPOLOGY:-}" in
    ""|orchestrator) ;;
    *)
      echo "north: $1 REFUSED — judgment_grade is dispatcher/orchestrator-owned; worker topology cannot mutate it" >&2
      return 1 ;;
  esac
  case "$1" in
    tell)
      if [ "$#" -ne 4 ]; then
        echo "north: $1 REFUSED — judgment_grade requires exactly one value: s, m, or l" >&2
        return 1
      fi
      "$BUN" run "$NORTH/sdk/src/judgment-grade.ts" validate "$4" >/dev/null || {
        echo "north: $1 REFUSED — judgment_grade must be exactly one of: s, m, l" >&2
        return 1
      }
      ;;
  esac
}

guard_judgment_grade_write "$@" || exit 1

# A worker still needs ordinary THREAD fact writes. Agent identity/lifecycle is
# harness evidence, not agent-authored data: generic fact verbs may not mutate
# any agent subject (self or peer). Trusted harness writes use a subprocess-only
# private writer not routed by this CLI; peer control remains an orchestrator
# operation. This is an application boundary, not same-UID hostile-code isolation.
# Run this before subject resolution: even a read/daemon failure is too late for
# an authorization boundary, and installed MCP `tell`/`retract` routes here too.
deny_worker_agent_mutation() {
  case "${AGENT_TOPOLOGY:-}" in ""|orchestrator) return 0 ;; esac
  case "${1:-}" in tell|retract) ;; *) return 0 ;; esac
  local subject="${2:-}" predicate="${3:-}"
  subject="${subject#@}"
  case "$subject" in agent:*) ;; *) return 0 ;; esac
  echo "north: $1 REFUSED — worker topology cannot mutate agent identity or authority via generic facts ($subject $predicate); report work on the thread or return control to the orchestrator" >&2
  return 1
}

deny_worker_agent_mutation "$@" || exit 1

# Run reservations/evidence/telemetry are harness-owned for the same reason as
# agent identity. A worker records proof only through `north evidence record`;
# generic facts must not bypass the capability-bound writer or poison another
# lane's write-once run subject.
deny_generic_run_mutation() {
  case "${1:-}" in tell|retract) ;; *) return 0 ;; esac
  local subject="${2:-}" predicate="${3:-}"
  subject="${subject#@}"
  case "$subject" in run-*|run:*) ;; *) return 0 ;; esac
  echo "north: $1 REFUSED — generic fact verbs cannot mutate harness-owned run facts ($subject $predicate); use 'north evidence record' for done-bar observations" >&2
  return 1
}

deny_generic_run_mutation "$@" || exit 1

# Cheap canonical FRAMRPC readiness boundary. A status request is fenced by the
# configured SpaceId and never reads or folds the projected corpus.
coord_runtime_ready() {
  local runtime_root
  runtime_root="${XDG_STATE_HOME:-$HOME/.local/state}/north/store-runtime"
  "$BB" "$NORTH/cli/coord.clj" "${NORTH_PORT:-7977}" coordination \
    >/dev/null || return $?
  "$BB" "$NORTH/cli/runtime-attestation.clj" \
    "${NORTH_PORT:-7977}" "$BEAGLE_STORE_LOG" "$BEAGLE_STORE_SPACE_ID" \
    "$runtime_root/north-store.runtime" north-store.service \
    >/dev/null || return $?
  if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
    env -u BEAGLE_STORE_TELEMETRY_LOG \
      NORTH_TELEMETRY_PARTITION=0 \
      "$BB" "$NORTH/cli/coord.clj" "$NORTH_TELEMETRY_PORT" telemetry \
      >/dev/null || return $?
    "$BB" "$NORTH/cli/runtime-attestation.clj" \
      "$NORTH_TELEMETRY_PORT" "$BEAGLE_STORE_TELEMETRY_LOG" \
      "$NORTH_TELEMETRY_SPACE_ID" \
      "$runtime_root/north-telemetry-coord.runtime" \
      north-telemetry-coord.service >/dev/null
  fi
}

coord_safety_ready() {
  coord_runtime_ready || return $?
  echo "canonical FRAMRPC SpaceId readiness OK"
}

case "${1:-}" in
  threads)
    # Kind-scoped noun command: the THREAD-kind overview (threads are one kind
    # among several in the store — see `north schema`; people/concerns/runs are
    # not threads). Same projection the kanban-metaphor aliases render: active
    # drivers + top-ready by leverage + counts.
    # Future kinds follow the pattern (`north people` when a person registry lands).
    if [ "${NORTH_FAST_LIST_RENDER:-}" = 1 ]; then north_slot_exec threads "${@:2}"; fi
    exec env NORTH_HOME="$NORTH" "$BB" "$NORTH/cli/fast-list-cli.clj" threads "${@:2}" ;;
  ready|next|report)
    if [ "$1" = report ] && [ "${NORTH_FAST_LIST_RENDER:-}" = 1 ]; then
      exec "$BB" "$NORTH/cli/shipped-report.clj" "${@:2}"
    fi
    if [ "${NORTH_FAST_LIST_RENDER:-}" = 1 ]; then north_slot_exec "$@"; fi
    exec env NORTH_HOME="$NORTH" "$BB" "$NORTH/cli/fast-list-cli.clj" "$@" ;;
  blocked|leverage|agenda|capture|json|needs-review|audit|resolve|validate|schema|tools|boot)
    # `validate` runs north's FULL check (engine-generic ++ north work rules,
    # north.validate) — the Beagle Store CLI `validate` is generic-only since the work
    # rules moved out of the kernel. The MCP validate tool shells through here too.
    #
    # `json show` is already an exact-subject operation. Sending it through
    # north.main would first fetch and index the entire live corpus, then throw
    # everything but one subject away. Managed admission uses this read before
    # identity publication, so corpus growth can consume the complete startup
    # acknowledgement budget before a provider is even constructed.
    #
    # `json children` is the same shape from the other direction — one indexed
    # `part_of` reverse lookup — and it is the read every managed orchestrator
    # turn-end reconciles against, under the SDK's 45s budget.
    # `json child-settlement` is that same turn-end's other half, under the
    # tighter 5s settlement deadline.
    if [ "$1" = json ] && [ "$#" -eq 3 ]; then
      case "${2:-}" in
        show) exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/json-show-cli.clj" "$3" ;;
        search) exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/json-search-cli.clj" "$3" ;;
        children) exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/json-children-cli.clj" "$3" ;;
        child-settlement) exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/json-child-settlement-cli.clj" "$3" ;;
      esac
    fi
    north_slot_exec "$@" ;;
  coord-ready)
    coord_runtime_ready ;;
  coord-safety)
    coord_safety_ready ;;
  acp)
    if [ "$#" -ne 1 ]; then
      echo "usage: north acp" >&2
      exit 2
    fi
    exec "$BUN" run "$NORTH/sdk/src/acp/cli.ts" ;;
  dashboard)
    # Compatibility alias: Bridge owns the operator cockpit command surface.
    exec "$BUN" run "$NORTH/sdk/src/bridge/cli.ts" dashboard "${@:2}" ;;
  doctor)
    # The cockpit (ported from convoy/bin/my-agents, 2026-07-10): `dashboard` =
    # what is happening (agents/concerns/board/daemons/health/profile); `doctor` =
    # is everything healthy (coordinator handshake + daemons/health/rev-skew/env/
    # guard-hooks). Dashboard is mounted under Bridge above; doctor remains here.
    exec "$BB" "$NORTH/cli/dashboard-cli.clj" "$@" ;;
  hotspots)
    # Where is the time going and what is failing, ranked (north hotspots is
    # already the work-queue unblocker ranking, so this is hotspots) — read out of the
    # telemetry that ALREADY exists (coordinator slow-read attribution, agent
    # logs). Adds no instrumentation and no daemon. cli/hotspots-cli.clj.
    exec "$BB" "$NORTH/cli/hotspots-cli.clj" "${@:2}" ;;
  config)
    # Personal-stack posture + durable provider routing policy.
    # + the no-arg full report. Ported from dotfiles/bin/my-agent-config (bash)
    # 2026-07-10: north is the settings surface. Provider-neutral state lives at
    # ~/.local/state/north/harness.conf; the Claude-era path is a read-only
    # migration fallback. cli/config-cli.clj.
    exec "$BB" "$NORTH/cli/config-cli.clj" "${@:2}" ;;
  providers)
    exec "$BUN" run "$NORTH/sdk/src/providers-cli.ts" "${@:2}" ;;
  learning)
    # Read-only deterministic comparison over immutable learning/run facts.
    exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/learning-compare.clj" "${@:2}" ;;
  account)
    # Isolated Claude Code / Codex subscription account homes. The TypeScript
    # CLI owns path validation, allowlisted config links, and normalized auth.
    exec "$BUN" run "$NORTH/sdk/src/account-cli.ts" "${@:2}" ;;
  failover)
    # Provider-recovery control surface. Availability is read through the stable
    # cached JSON boundary; only `fire` without --dry-run may launch an heir.
    exec "$BUN" run "$NORTH/sdk/src/failover-cli.ts" "${@:2}" ;;
  spend)
    # API-billing budget LEDGER (spend-guard step 2). Owns schema declaration,
    # the cap-checked CAS reservation, terminal settlement, and human overrides
    # on the coordination log via cli/coord.clj — writes the coordinator wire the
    # read-only TS SDK client cannot. init/status/override are the cockpit surface
    # (each prints the primitive it runs); reserve/settle/headroom are machine
    # verbs the admission + terminal seams shell out to.
    exec "$BB" "$NORTH/cli/spend-cli.clj" "${@:2}" ;;
  delivery)
    # Historical attestation surface. Shared-UID agents cannot establish an
    # independent verifier boundary, so promotion fails closed.
    exec "$BUN" run "$NORTH/sdk/src/delivery-attest.ts" "${@:2}" ;;
  evidence)
    # Capability-bound self-reporting surface. Run/thread/reporter are inherited
    # from the managed child environment; callers supply only exact bar + result.
    # With NO reservation in the environment it falls back to explicitly
    # unreserved thread-scoped evidence (never run-bound verification).
    exec "$BUN" run "$NORTH/sdk/src/delivery-evidence.ts" "${@:2}" ;;
  bars)
    # Coordinator-facing done_when grooming: the one-step recovery the delivery
    # reserve error points at when a thread accumulates past the bar limit.
    exec "${NORTH_BARS[@]}" "${@:2}" ;;
  linear)
    # Zero-turn Linear adapter over Codex app-server MCP. `sync` defaults to a
    # read-only plan; only an explicit `sync <thread> --apply` writes remotely.
    exec "$BUN" run "$NORTH/sdk/src/integrations/linear/cli.ts" "${@:2}" ;;
  provider-observe)
    # Hidden machine-ingestion surface. Interactive adapters feed provider
    # telemetry here; it is intentionally silent and best-effort.
    exec "$BUN" run "$NORTH/sdk/src/provider-observations-cli.ts" "${@:2}" ;;
  ccr)
    # Explicit canary only: this does not intercept provider tool results or
    # change provider prompts/tool lists. Compression requires --enable.
    exec "$BUN" run "$NORTH/sdk/src/ccr-cli.ts" "${@:2}" ;;
  predicate)
    # Generated read/authoring projection over exact executable @<predicate>
    # entities. Bootstrap inventory is available only through its explicitly
    # weak offline lint; connected commands read the graph authority.
    exec "$BB" "$NORTH/cli/pred-cli.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  lanes)
    # Durable local lifecycle receipts remain readable during coordinator faults.
    exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/lanes-cli.clj" "${@:2}" ;;
  agents|templates|spawn|delegate|watch|msg|goal|escalate)
    # Agent verbs — agents are a north concern (spawn/presence/facts live here).
    # Implementation: cli/agents-cli.clj (ported from the convoy cockpit 2026-07-09).
    exec "$BB" "$NORTH/cli/agents-cli.clj" "$@" ;;
  inbox|notifications)
    _north_inbox_actor="${AGENT_ID:-${NORTH_AGENT_ID:-${NORTH_AUTHOR:-}}}"
    shift
    if [ "${1:-}" = "--as" ]; then
      if [ "$#" -ne 2 ] || [ -z "${2:-}" ]; then
        echo "north inbox: --as requires exactly one recipient" >&2
        exit 2
      fi
      _north_inbox_actor="$2"
      shift 2
    fi
    if [ "$#" -ne 0 ] || [ -z "$_north_inbox_actor" ]; then
      echo "usage: north inbox [--as <recipient>]" >&2
      exit 2
    fi
    exec "$BB" "$NORTH/cli/msg-cli.clj" "${NORTH_PORT:-7977}" inbox \
      "$_north_inbox_actor" ;;
  mention|interrupt)
    # Sender-driven attention. Prefer the live harness identity, then North's
    # stable agent id, then the configured author identity. The shared comms
    # seam owns transport selection; no Attention entry point bypasses it.
    _north_attention_sender="${AGENT_ID:-${NORTH_AGENT_ID:-${NORTH_AUTHOR:-}}}"
    exec "$NORTH/bin/north-comms" \
      "$1" "$_north_attention_sender" "${@:2}" ;;
  trace)
    # Single-agent lifecycle diagnosis — walk the invariant-spine checklist for one id,
    # flag the first failing stage (F1–F7). Read-only. cli/trace-cli.clj.
    exec "$BB" "$NORTH/cli/trace-cli.clj" "${@:2}" ;;
  health)
    # Aggregate coordination rollup — one durable log fold (lane outcomes, stale
    # concerns, ping-loss, zombie forks, died-unreported). Read-only. cli/health-cli.clj.
    exec "$BB" "$NORTH/cli/health-cli.clj" "${@:2}" ;;
  wip)
    # Presence-derived managed lanes + reservation thread bindings, coordinator
    # floor, and the ready/leverage pull queue. Read-only. cli/wip-cli.clj.
    exec "$BB" -cp "$NORTH/out:$BEAGLE_STORE_OUT" "$NORTH/cli/wip-cli.clj" "${@:2}" ;;
  stream-sync)
    # Zero-AI cursor-based transcript log-shipping (streams/CLAUDE.md) — a
    # plain bash script, not a north.main verb, so it execs directly.
    exec "$NORTH/bin/north-stream-sync-all" "${@:2}" ;;
  stream-distill)
    # Claim one settled mirror and publish its provenance-complete Tier 1
    # Markdown projection through the cheap-tier managed provider boundary.
    exec "$BUN" run "$NORTH/sdk/src/tier1-distiller-cli.ts" "${@:2}" ;;
  bridge)
    # Durable local execution host. It does not read or write the coordinator;
    # replay remains available when Beagle Store is down.
    exec "$BUN" run "$NORTH/sdk/src/bridge/cli.ts" "${@:2}" ;;
  queue)
    # Ready-lane ordering is a coordinator CAS over one single-valued thread
    # receipt; the queue never owns or mutates lifecycle condition.
    exec "$BB" -cp "$NORTH/out:$BEAGLE_STORE_OUT" "$NORTH/cli/queue-cli.clj" "${NORTH_PORT:-7977}" "${@:2}" ;;
  listen)
    # Real-time interrupt listener — RUN AS A BACKGROUND TASK. Dormant (zero
    # tokens) until a peer addresses you, then prints the message and exits:
    # that exit is the interrupt. Read it, act, re-arm. bin/north-arm = alias.
    exec "$BB" -cp "$NORTH_RUNTIME_CLASSPATH" "$NORTH/cli/north-listen.clj" \
      "${NORTH_PORT:-7977}" "${2:?usage: north listen <agent-id>}" --once --ack "${@:3}" ;;
  worktrees)
    # Machine-wide worktree census: every tree under a container's worktrees/
    # directory, joined to live concerns and graph lane registrations. Nothing
    # under pins/ is enumerated — a pin is never a lane. Read-only.
    # cli/worktrees-cli.clj.
    exec "$BB" "$NORTH/cli/worktrees-cli.clj" "${@:2}" ;;
  worktree)
    # Explicit landing reconciliation. It never pushes and removes only
    # harvested lane refs already proved reachable from main.
    if [ "${2:-}" = "lander" ]; then
      exec "$BB" "$NORTH/cli/worktree-lander.clj" "${@:3}"
    fi
    echo "usage: north worktree lander [repository]" >&2
    exit 2 ;;
  show|history)
    # Stage A gives telemetry subjects an independent sole writer. Generic Beagle Store
    # reads otherwise ask only the coordination writer and turn a real telemetry
    # subject into a false "no facts" result. Exact namespace-qualified reads
    # follow the same subject router as writes and fail closed when that writer
    # is unavailable; partition-off (A1/rollback) keeps the prior Beagle Store surface.
    if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
      case "${2#@}" in
        run:*|session:*|mine:*|guard_denial:*)
          exec env BEAGLE_STORE_SPACE_ID="${NORTH_TELEMETRY_SPACE_ID:-north-telemetry}" \
            BEAGLE_STORE_SERVER_PORT="$NORTH_TELEMETRY_PORT" \
            "$BEAGLE_STORE_CLI" store "$@"
          ;;
      esac
    fi
    exec "$BEAGLE_STORE_CLI" store "$@" ;;
  tell|retract)
    # `retract` is the primary agent-facing retraction verb (R&N TELL/RETRACT);
    # Both map onto Store's `untell` CLI verb (whose wire op is already "retract")
    # at the boundary below.
    # Handles (and @ids) are a NORTH concern: Store is handle-blind and re-adds
    # the leading @ to the bare subject it's handed. So resolve the SUBJECT ref to
    # its canonical id here first — that's what makes `north tell @perf ...`
    # land on the right thread — then pass Store the bare canonical id. Only rewrite
    # when the full `tell <id> <pred> <value>` shape is present; otherwise pass
    # through untouched so Store's own usage/arg checks are unchanged.
    if [ "$#" -ge 4 ]; then
      north_exact_subject=0
      # FAIL-CLOSED: an unresolvable id-like ref (or a dead resolver) aborts the
      # write — passing the raw ref through would mint a phantom subject under a
      # truncated id and strand the facts (2026-07-03 incident: 19 orphans).
      bare_subject="${2#@}"
      if [[ "$bare_subject" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        # Exact UUID writes use Beagle Store's one-request atomic operation below. It
        # checks existence and commits in one coordinator turn, and never
        # renders/scans provenance merely to prove that the subject exists.
        canon="@$bare_subject"
        north_exact_subject=1
      else
        canon="$("${NORTH_MAIN[@]}" resolve "$2" 2>/dev/null)"
      fi
      case "$canon" in
        ERROR*) echo "north: $1 REFUSED — ${canon#ERROR }" >&2; exit 1 ;;
        "")     echo "north: $1 REFUSED — subject resolver unavailable for '$2' (build out/? daemon?)" >&2; exit 1 ;;
        *)      set -- "$1" "${canon#@}" "${@:3}" ;;
      esac
    fi
    store_verb="$1"; [ "$store_verb" = retract ] && store_verb=untell
    # Done-bars echo (friction gradient): closing a barred thread SEES its bars
    # at the moment of judgment — a reminder, never a reject. cmd-done-bars is
    # silent for bar-less threads; failures never block the write.
    if [ "$store_verb" = tell ] && [ "${3:-}" = outcome ]; then
      "${NORTH_BARS[@]}" echo "$2" 2>/dev/null || true
    fi
    # Reserve-limit echo: bars accumulate across runs, so the Nth done_when is
    # what silently makes future managed runs unable to reserve delivery
    # evidence. Warn at write time (advisory, never a reject) and name the
    # one-step recovery. Runs only for done_when tells.
    if [ "$store_verb" = tell ] && [ "${3:-}" = done_when ] && [ -n "${4:-}" ]; then
      "${NORTH_BARS[@]}" check "$2" "$4" || true
    fi
    case "${2#@}" in
      run:*|session:*|mine:*|guard_denial:*)
        if [ "${NORTH_TELEMETRY_PARTITION:-0}" = 1 ]; then
          exec env -u BEAGLE_STORE_TELEMETRY_LOG \
            BEAGLE_STORE_SPACE_ID="${NORTH_TELEMETRY_SPACE_ID:-north-telemetry}" \
            BEAGLE_STORE_SERVER_PORT="$NORTH_TELEMETRY_PORT" \
            BEAGLE_STORE_LOG="$BEAGLE_STORE_TELEMETRY_LOG" \
            "$BEAGLE_STORE_CLI" store "$store_verb" "${@:2}"
        fi ;;
    esac
    if [ "${north_exact_subject:-0}" = 1 ]; then
      existing_output="$(
        "$BEAGLE_STORE_CLI" store "${store_verb}-existing" "${@:2}" 2>&1
      )"
      existing_status=$?
      case "$existing_status" in
        0)
          printf '%s\n' "$existing_output"
          exit 0
          ;;
        3)
          echo "north: $1 REFUSED — unresolved id-like ref ${2#@} — not a live exact thread id" >&2
          exit 1
          ;;
        4)
          echo "north: $1 REFUSED — subject resolver unavailable for '${2#@}' (coordinator unavailable or incompatible)" >&2
          exit 1
          ;;
        *)
          printf '%s\n' "$existing_output" >&2
          exit "$existing_status"
          ;;
      esac
    fi
    exec "$BEAGLE_STORE_CLI" store "$store_verb" "${@:2}" ;;
  *)  # engine verbs: import/export/merge/watch
    exec "$BEAGLE_STORE_CLI" store "$@" ;;
esac
