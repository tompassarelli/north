#!/usr/bin/env bash
set -uo pipefail

placement=${LAPTOP_RUNNER_PLACEMENT:-laptop}
poll=${LAPTOP_RUNNER_POLL:-30}
north=${NORTH_BIN:-$(dirname "$0")/north}
"$(dirname "$0")/agent-contain" sweep || true; "$north" private-desktop reap || true
lock="${XDG_RUNTIME_DIR:-/tmp}/laptop-runner.lock"
exec 9>"$lock"
flock -n 9 || exit 0
logs="${XDG_STATE_HOME:-$HOME/.local/state}/laptop-runner"
mkdir -p "$logs"
cache="$logs/laptop-state.json"

laptop_state() {
  local s
  if s=$(timeout 15 laptop status --json 2>/dev/null) && jq -e .state <<<"$s" >/dev/null 2>&1; then
    printf '%s\n' "$s" >"$cache.tmp" && mv "$cache.tmp" "$cache"
  fi
  cat "$cache" 2>/dev/null || echo '{"state":"unavailable","deadline":0}'
}

capacity=$(dirname "$(agents path machine-capacity 2>/dev/null)")/scripts/machine-capacity.mjs
places() {
  if [ "$placement" = laptop ] && [ "$(laptop_state | jq -r .state)" != available ]; then
    return
  fi
  local online=(/sys/class/power_supply/*/online)
  if { [ ! -e "${online[0]}" ] || grep -qx 1 "${online[@]}"; } && bun "$capacity" probe --class heavy >/dev/null 2>&1; then
    echo "$placement,pool"
  else
    echo "$placement"
  fi
}

past_grace() {
  [ "$placement" = laptop ] || return 1
  local deadline
  deadline=$(laptop_state | jq -r '.deadline // empty')
  [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ]
}

ran=0
while where=$(places) && [ -n "$where" ] && job=$(threads queue take "$where") && [ -n "$job" ]; do
  id=$(jq -r .id <<<"$job")
  mapfile -d '' -t cmd < <(jq -j '.cmd[] + "\u0000"' <<<"$job")
  log="$logs/queue-$id.log"
  setsid "$north" job-run "queue-$id" -- "${cmd[@]}" >"$log" 2>&1 &
  pid=$!
  stopped=0
  while kill -0 "$pid" 2>/dev/null; do
    timeout "$poll" tail --pid="$pid" -f /dev/null
    if kill -0 "$pid" 2>/dev/null && past_grace; then
      kill -TERM -- "-$pid" 2>/dev/null
      stopped=1
      break
    fi
  done
  wait "$pid"
  rc=$?
  status="done"
  [ "$rc" -eq 0 ] || status=failed
  [ "$stopped" -eq 0 ] || status=requeued
  threads queue msg "$id" "$status" "rc=$rc log=$(hostname):$log
$(tail -c 3000 "$log")" >/dev/null
  ran=$((ran + 1))
done
echo "laptop-runner: ran $ran"
