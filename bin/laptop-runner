#!/usr/bin/env bash
set -uo pipefail

placement=${LAPTOP_RUNNER_PLACEMENT:-laptop}
lock="${XDG_RUNTIME_DIR:-/tmp}/laptop-runner.lock"
exec 9>"$lock"
flock -n 9 || exit 0
logs="${XDG_STATE_HOME:-$HOME/.local/state}/laptop-runner"
mkdir -p "$logs"

capacity=$(dirname "$(agents path machine-capacity 2>/dev/null)")/scripts/machine-capacity.mjs
places() {
  local online=(/sys/class/power_supply/*/online)
  if { [ ! -e "${online[0]}" ] || grep -qx 1 "${online[@]}"; } && bun "$capacity" probe --class heavy >/dev/null 2>&1; then
    echo "$placement,pool"
  else
    echo "$placement"
  fi
}

ran=0
while job=$(threads queue take "$(places)") && [ -n "$job" ]; do
  id=$(jq -r .id <<<"$job")
  mapfile -d '' -t cmd < <(jq -j '.cmd[] + "\u0000"' <<<"$job")
  log="$logs/queue-$id.log"
  job-run "queue-$id" -- "${cmd[@]}" >"$log" 2>&1
  rc=$?
  status=done
  [ "$rc" -eq 0 ] || status=failed
  threads queue msg "$id" "$status" "rc=$rc log=$(hostname):$log
$(tail -c 3000 "$log")" >/dev/null
  ran=$((ran + 1))
done
echo "laptop-runner: ran $ran"
