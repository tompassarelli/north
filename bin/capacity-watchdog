#!/usr/bin/env -S bun --no-install
import { appendFileSync, existsSync, mkdirSync, readFileSync, readdirSync, readlinkSync, realpathSync, renameSync, statSync, writeFileSync } from "fs";
import { dirname, join } from "path";
import { Database } from "bun:sqlite";
import { DEFAULTS } from "../harness/skills/machine-capacity/scripts/machine-capacity-logic.ts";

const USAGE = `usage: capacity-watchdog sample [--once] [--interval SECONDS]
       capacity-watchdog report [--minutes N]... [--since DATE]
       capacity-watchdog replay FILE
       capacity-watchdog rest-check [--seconds N] [--expected FILE] [--observed FILE] [--save FILE]

sample   every 30 s append load, CPU/memory PSI, per-cgroup CPU, leases, clients and the
         top processes outside capacity scopes to samples.jsonl (rotated daily); log an
         incident for an unleased process tree over 4 cores for 2 minutes and SIGTERM git
         maintenance/gc/repack outside capacity scopes and the nightly timer. Each sample also goes
         to north capacity watchdog step, which on sustained overload names the top process trees
         by fleet session, caps the offending session scope and sends the owner and coordinators.
report   summarize the last N minutes (default 5 and 30) of samples and incidents with flags.
         Claude workers over 350k with no handoff fire flag in that window since the hook fix.
         A fire without HANDOFF or a Done:/Not done: report in its next three assistant turns flags as handoff ignored.
         --since DATE replays ledger runs from DATE, including pre-fix runs (samples keep their minute window).
         A Codex turn in the window that failed with "Selected model is at capacity" flags provider-capacity codex.
replay   run recorded snapshots (JSONL) through the decision core and print its actions.
rest-check  compare running system and user units, active timers and listening sockets with the
         host's expected-at-rest set and measure each unit's CPU and context switches over N s
         (default 30); sockets read "PROTO ADDR:PORT UNIT", UNIT "-" when its creating cgroup is
         gone (kernel WireGuard); print each extra unit, socket and over-budget unit, list agent sessions
         separately, and exit 1 on any failure. --observed checks a saved observation, --save
         writes the live one. Expected set: --expected, $CAPACITY_WATCHDOG_REST or
         ~/.config/capacity-watchdog/rest.json, declared per host in firn.
State: $CAPACITY_WATCHDOG_DIR (default ~/.local/state/agents/watchdog).
Ledger: $THREADS_DB (default ~/.local/state/threads/threads.db), read only.`;

const TREE_CORES = 4;
const TREE_SECONDS = 120;
const PSI_LIMIT = 50;
const CLIENT_SHARE = 1.6;
const HANDOFF_FIX = Date.parse("2026-10-10T20:24:00Z");
const CLAUDE_TIERS = new Set(["haiku", "sonnet", "low", "medium", "high", "xhigh", "max"]);
const ROTATE_MS = 24 * 3600 * 1000;
const LEASED = /\/agent-capacity-[0-9a-f]{32}\.scope(\/|$)/;
const NIGHTLY = /\/git-maintenance-nightly\.service(\/|$)/;
const CLIENT = /^(Warcraft III|BlizzardBrows)/;

type Proc = { pid: number; ppid: number; sid: number; comm: string; args: string[]; cgroup: string; ticks: number; start: string; rssKiB: number; cwd: string | null };
type Lease = { owner: string; class: string; cpus: number; declaredCpus?: number; memoryMiB: number; recentCores: number | null; usedMiB: number | null; wrapperPid?: number; session?: string | null; parent?: string | null };
type FleetSession = { name: string; conversation: string; host_pid: number | null; parent: string | null };
type Snapshot = { at: number; load: number[]; cpuPsi: number; cpuPsi60: number; memPsi: number; memFullPsi: number; memAvailableMiB: number; memTotalMiB: number; cgroups: Record<string, number>; busyTicks?: number; procs: Proc[]; leases: Lease[] };
type Hot = { since: number; reported: boolean };
type State = { prev: Snapshot | null; hot: Record<string, Hot> };
type Incident = { at: string; kind: "unleased-tree" | "git-maintenance-terminated"; summary: string; cgroup: string; cores?: number; seconds?: number; cwd?: string | null; chain?: string[]; pids?: number[] };
type Term = { pid: number; start: string };
type Run = { agent: string; tier: string; role: string; ended: string; peak_ctx: number | null; handoff_fires: number | null; handoff_ignored: number | null };

const r2 = (n: number) => Math.round(n * 100) / 100;
const command = (p: Proc) => (p.args.length ? p.args.join(" ") : `[${p.comm}]`).slice(0, 160);
const leased = (cgroup: string) => LEASED.test(cgroup);
const short = (cgroup: string) => cgroup.replace(/^\/user\.slice\/user-\d+\.slice\/user@\d+\.service\//, "");

export function gitMaintenanceVerb(args: string[]): string | null {
  if (!args.length || args[0].split("/").at(-1) !== "git") return null;
  for (let i = 1; i < args.length; i++) {
    const a = args[i];
    if (a === "-C" || a === "-c" || a === "--git-dir" || a === "--work-tree") { i++; continue; }
    if (a.startsWith("-")) continue;
    return ["maintenance", "gc", "repack"].includes(a) ? a : null;
  }
  return null;
}

export function leaseHolder(pid: number | undefined, byPid: Map<number, Proc>, sessions: FleetSession[]): { session: string | null; parent: string | null } {
  const chain: Proc[] = [];
  for (let p = pid === undefined ? undefined : byPid.get(pid); p && !chain.includes(p); p = byPid.get(p.ppid)) chain.push(p);
  const agent = chain.find((p) => p.comm === "claude" || p.comm === "codex");
  if (!agent) return { session: null, parent: null };
  const i = agent.args.findIndex((a, k) => ["--session-id", "--resume", "resume"].includes(a) && /^[0-9a-f-]{32,36}$/.test(agent.args[k + 1] ?? ""));
  const session = i >= 0 ? agent.args[i + 1] : null;
  const pids = chain.map((p) => p.pid);
  const owner = sessions.find((n) => session !== null && n.conversation === session) ?? sessions.find((n) => n.host_pid !== null && pids.includes(n.host_pid));
  return { session: session ?? owner?.conversation ?? null, parent: owner?.parent ?? null };
}

function chainOf(pid: number, byPid: Map<number, Proc>): string[] {
  const out: string[] = [];
  for (let p = byPid.get(pid), n = 0; p && n < 8; p = byPid.get(p.ppid), n++) out.push(`${p.pid} ${command(p)}`);
  return out;
}

export function step(state: State, snap: Snapshot): { state: State; sample: object; incidents: Incident[]; terms: Term[] } {
  const prev = state.prev;
  const dt = prev ? (snap.at - prev.at) / 1000 : 0;
  const prevProc = new Map(prev?.procs.map((p) => [p.pid, p]) ?? []);
  const byPid = new Map(snap.procs.map((p) => [p.pid, p]));
  const cores = new Map<number, number>();
  if (dt > 0) for (const p of snap.procs) {
    const q = prevProc.get(p.pid);
    if (q && q.start === p.start) cores.set(p.pid, Math.max(0, (p.ticks - q.ticks) / 100 / dt));
  }
  const cgroupCores = dt > 0 ? Object.entries(snap.cgroups).flatMap(([cg, usec]) => {
    const before = prev!.cgroups[cg];
    return before === undefined ? [] : [{ cgroup: cg, cores: r2(Math.max(0, usec - before) / 1e6 / dt) }];
  }).filter((c) => c.cores >= 0.05).sort((a, b) => b.cores - a.cores).filter((c, i) => i < 15 || /\.(scope|service)$/.test(c.cgroup)) : [];
  const unleased = snap.procs.filter((p) => !leased(p.cgroup) && p.cgroup !== "/");
  const top = unleased.filter((p) => (cores.get(p.pid) ?? 0) >= 0.05).sort((a, b) => cores.get(b.pid)! - cores.get(a.pid)!).slice(0, 8)
    .map((p) => ({ pid: p.pid, cores: r2(cores.get(p.pid)!), rssMiB: Math.round(p.rssKiB / 1024), cgroup: short(p.cgroup), command: command(p) }));
  const clients = snap.procs.filter((p) => CLIENT.test(p.comm)).map((p) => ({ pid: p.pid, comm: p.comm, cores: r2(cores.get(p.pid) ?? 0), rssMiB: Math.round(p.rssKiB / 1024) }));

  const incidents: Incident[] = [];
  const iso = new Date(snap.at).toISOString();
  const trees = new Map<string, Proc[]>();
  for (const p of unleased) {
    const key = `${p.cgroup}|${p.sid}`;
    trees.set(key, [...(trees.get(key) ?? []), p]);
  }
  const hot: Record<string, Hot> = {};
  for (const [key, procs] of trees) {
    const total = procs.reduce((s, p) => s + (cores.get(p.pid) ?? 0), 0);
    if (total <= TREE_CORES) continue;
    const was = state.hot[key];
    const h: Hot = was ? { ...was } : { since: prev ? prev.at : snap.at, reported: false };
    hot[key] = h;
    const seconds = (snap.at - h.since) / 1000;
    if (!h.reported && seconds >= TREE_SECONDS) {
      h.reported = true;
      const lead = procs.reduce((a, b) => ((cores.get(b.pid) ?? 0) > (cores.get(a.pid) ?? 0) ? b : a));
      incidents.push({ at: iso, kind: "unleased-tree", cgroup: short(procs[0].cgroup), cores: r2(total), seconds: Math.round(seconds), cwd: lead.cwd,
        chain: chainOf(lead.pid, byPid), pids: procs.map((p) => p.pid).slice(0, 20),
        summary: `unleased tree using ${r2(total)} cores for ${Math.round(seconds)} s: ${command(lead).slice(0, 80)}` });
    }
  }

  const terms: Term[] = [];
  const gitRoots = snap.procs.filter((p) => !leased(p.cgroup) && !NIGHTLY.test(p.cgroup) && gitMaintenanceVerb(p.args));
  const killed = new Set<number>();
  for (const root of gitRoots) {
    const group = [root, ...snap.procs.filter((p) => !killed.has(p.pid) && p.pid !== root.pid && chainOf(p.pid, byPid).some((c) => c.startsWith(`${root.pid} `)))];
    const fresh = group.filter((p) => !killed.has(p.pid));
    if (!fresh.length) continue;
    for (const p of fresh) { killed.add(p.pid); terms.push({ pid: p.pid, start: p.start }); }
    incidents.push({ at: iso, kind: "git-maintenance-terminated", cgroup: short(root.cgroup), cwd: root.cwd, chain: chainOf(root.pid, byPid), pids: fresh.map((p) => p.pid),
      summary: `SIGTERM git ${gitMaintenanceVerb(root.args)} outside the nightly timer (${fresh.length} processes) in ${root.cwd ?? "?"}` });
  }

  const busyCores = dt > 0 && prev?.busyTicks !== undefined && snap.busyTicks !== undefined ? r2(Math.max(0, snap.busyTicks - prev.busyTicks) / 100 / dt) : undefined;
  const sample = {
    at: iso, load: snap.load, cpuPsi: snap.cpuPsi, cpuPsi60: snap.cpuPsi60, memPsi: snap.memPsi, memFullPsi: snap.memFullPsi,
    memAvailableMiB: snap.memAvailableMiB, memTotalMiB: snap.memTotalMiB, intervalSeconds: r2(dt), busyCores,
    cgroups: cgroupCores, top, clients, leases: snap.leases, hotTrees: Object.keys(hot).length,
  };
  return { state: { prev: snap, hot }, sample, incidents, terms };
}

type RestExpected = { system: string[]; user: string[]; sockets: string[]; cores: number; budgets?: string[] };
type RestUnit = { scope: "system" | "user"; name: string; cores?: number; csPerSec?: number; agent?: string };
type RestObserved = { seconds: number; units: RestUnit[]; sockets: string[] };

const globRe = (g: string) => new RegExp(`^${g.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*")}$`);

export function restCheck(expected: RestExpected, observed: RestObserved) {
  const allowed = { system: expected.system.map(globRe), user: expected.user.map(globRe) };
  const known = (u: RestUnit) => {
    const res = allowed[u.scope];
    const timer = u.name.replace(/\.service$/, ".timer");
    return res.some((r) => r.test(u.name)) || (timer !== u.name && res.some((r) => r.test(timer)));
  };
  const agents = observed.units.filter((u) => u.agent);
  const rest = observed.units.filter((u) => !u.agent);
  const extraUnits = rest.filter((u) => !known(u));
  const sockets = expected.sockets.map(globRe);
  const extraSockets = [...new Set(observed.sockets)].filter((s) => !sockets.some((r) => r.test(s))).sort();
  const budgets = new Map((expected.budgets ?? []).map((b) => b.split(/\s+/)).map(([n, c]) => [n, Number(c)]));
  const budget = (name: string) => budgets.get(name) ?? expected.cores;
  const overBudget = rest.filter((u) => known(u) && u.cores !== undefined && u.cores > budget(u.name))
    .map((u) => ({ ...u, budget: budget(u.name) }));
  const csPerSec = r2(rest.reduce((s, u) => s + (u.csPerSec ?? 0), 0));
  const cores = r2(rest.reduce((s, u) => s + (u.cores ?? 0), 0));
  return { ok: !extraUnits.length && !extraSockets.length && !overBudget.length, extraUnits, extraSockets, overBudget, agents, cores, csPerSec };
}

const median = (xs: number[]) => { const s = [...xs].sort((a, b) => a - b); return s.length ? s[Math.floor(s.length / 2)] : 0; };

export function report(samples: any[], incidents: string[], minutes: number, now: number, runs: Run[] = [], ledgerSince?: number) {
  const since = now - minutes * 60000;
  const win = samples.filter((s) => Date.parse(s.at) >= since);
  const inc = incidents.filter((line) => { const m = line.match(/^- (\S+)/); return m && Date.parse(m[1]) >= since; });
  const flags: string[] = [];
  for (const run of runs) {
    const ended = Date.parse(run.ended);
    if (run.role !== "worker" || !CLAUDE_TIERS.has(run.tier) || ended < (ledgerSince ?? Math.max(since, HANDOFF_FIX)) || ended > now) continue;
    if ((run.peak_ctx ?? 0) > DEFAULTS["handoff_ctx"] && run.handoff_fires === 0) {
      flags.push(`handoff hook silent: ${run.agent} peak ${Math.round(run.peak_ctx! / 1000)}k, 0 fires`);
    }
    if ((run.handoff_fires ?? 0) > 0 && (run.handoff_ignored ?? 0) > 0) flags.push(`handoff ignored: ${run.agent}`);
  }
  if (!win.length) return { minutes, samples: 0, incidents: inc, flags: ["no samples: is capacity-watchdog.service running?", ...flags] };
  const psi = win.map((s) => s.cpuPsi);
  const high = psi.filter((p) => p > PSI_LIMIT).length;
  if (high >= Math.max(2, win.length / 2)) flags.push(`cpu PSI above ${PSI_LIMIT}% in ${high}/${win.length} samples (max ${Math.max(...psi)})`);
  const owners = new Map<string, { cpus: number; seen: number[]; class: string; org: string | null }>();
  for (const s of win) for (const l of s.leases ?? []) {
    const cpus = Math.max(l.cpus, l.declaredCpus ?? l.cpus);
    const key = `${l.owner}\0${l.class}\0${cpus}`;
    const o = owners.get(key) ?? { cpus, seen: [], class: l.class, org: null };
    o.seen.push(l.recentCores ?? 0);
    o.org = l.org ?? o.org;
    owners.set(key, o);
  }
  for (const [key, o] of owners) {
    const owner = key.split("\0")[0];
    const m = median(o.seen);
    if (o.class !== "native" && o.seen.length >= 2 && m > o.cpus * 1.1) flags.push(`${o.class} lease ${owner} median ${r2(m)} cores over its ${o.cpus} declared${o.org ? ` org=${o.org}` : ""}`);
  }
  const perClient = new Map<string, number[]>();
  for (const s of win) for (const c of s.clients ?? []) perClient.set(`${c.comm}#${c.pid}`, [...(perClient.get(`${c.comm}#${c.pid}`) ?? []), c.cores]);
  for (const [client, xs] of perClient) {
    const m = median(xs);
    if (xs.length >= 2 && m > CLIENT_SHARE) flags.push(`client ${client} median ${r2(m)} cores over its measured share ${CLIENT_SHARE}`);
  }
  const first = win[0], last = win.at(-1);
  const floor = Math.max(8192, Math.round(last.memTotalMiB * 0.2));
  const spanMin = (Date.parse(last.at) - Date.parse(first.at)) / 60000;
  const slope = spanMin > 0 ? (last.memAvailableMiB - first.memAvailableMiB) / spanMin : 0;
  const toFloor = slope < 0 ? (last.memAvailableMiB - floor) / -slope : null;
  if (last.memAvailableMiB < floor) flags.push(`memory available ${last.memAvailableMiB} MiB is under the ${floor} MiB floor`);
  else if (toFloor !== null && toFloor < 30) flags.push(`memory available falling ${Math.round(-slope)} MiB/min, reaches the ${floor} MiB floor in ${Math.round(toFloor)} min`);
  const unleased = new Map<string, number[]>();
  for (const s of win) for (const t of s.top ?? []) unleased.set(t.cgroup, [...(unleased.get(t.cgroup) ?? []), t.cores]);
  const topUnleased = [...unleased].map(([cgroup, xs]) => ({ cgroup, meanCores: r2(xs.reduce((a, b) => a + b, 0) / win.length) }))
    .sort((a, b) => b.meanCores - a.meanCores).slice(0, 5);
  if (inc.length) flags.push(`${inc.length} incident(s) in window`);
  return {
    minutes, samples: win.length, load: last.load, cpuPsi: { mean: r2(psi.reduce((a, b) => a + b, 0) / psi.length), max: Math.max(...psi), last: last.cpuPsi },
    memAvailableMiB: { last: last.memAvailableMiB, min: Math.min(...win.map((s) => s.memAvailableMiB)), slopePerMin: Math.round(slope), floor },
    topUnleased, leases: [...owners].map(([owner, o]) => ({ owner, class: o.class, cpus: o.cpus, medianCores: r2(median(o.seen)), org: o.org })),
    incidents: inc, flags,
  };
}

const HOME = process.env.HOME ?? "/tmp";
const DIR = process.env.CAPACITY_WATCHDOG_DIR ?? join(HOME, ".local/state/agents/watchdog");
const SAMPLES = join(DIR, "samples.jsonl");
const INCIDENTS = join(DIR, "incidents.md");
const CGROOT = "/sys/fs/cgroup";
const UID = process.getuid?.() ?? 1000;
const USER_ROOT = `${CGROOT}/user.slice/user-${UID}.slice/user@${UID}.service`;
const RUNTIME = process.env.XDG_RUNTIME_DIR ?? `/run/user/${UID}`;

const read = (path: string) => { try { return readFileSync(path, "utf8"); } catch { return null; } };
const avg10 = (path: string, kind: string) => Number(read(path)?.split("\n").find((l) => l.startsWith(kind))?.match(/avg10=([0-9.]+)/)?.[1] ?? 0);
const avg60 = (path: string, kind: string) => Number(read(path)?.split("\n").find((l) => l.startsWith(kind))?.match(/avg60=([0-9.]+)/)?.[1] ?? 0);

function cgroupUsage(): Record<string, number> {
  const out: Record<string, number> = {};
  const walk = (dir: string, rel: string, depth: number) => {
    const usec = read(join(dir, "cpu.stat"))?.match(/^usage_usec (\d+)$/m)?.[1];
    if (usec !== undefined && rel) out[rel] = Number(usec);
    if (depth >= 4) return;
    let entries: string[] = [];
    try { entries = readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory()).map((e) => e.name); } catch { return; }
    for (const e of entries) walk(join(dir, e), rel ? `${rel}/${e}` : e, depth + 1);
  };
  walk(USER_ROOT, "", 0);
  walk(`${CGROOT}/system.slice`, "system.slice", 3);
  const login = `user.slice/user-${UID}.slice`;
  let sessions: string[] = [];
  try { sessions = readdirSync(`${CGROOT}/${login}`).filter((name) => /^session-\d+\.scope$/.test(name)); } catch {}
  for (const name of sessions) walk(`${CGROOT}/${login}/${name}`, `${login}/${name}`, 4);
  return out;
}

function busyTicks(): number | undefined {
  const fields = read("/proc/stat")?.split("\n", 1)[0].split(/\s+/).slice(1).map(Number);
  if (!fields || fields.length < 8) return undefined;
  const [user, nice, system, , , irq, softirq, steal] = fields;
  return user + nice + system + irq + softirq + steal;
}

function procs(): Proc[] {
  const out: Proc[] = [];
  for (const name of readdirSync("/proc")) {
    if (!/^\d+$/.test(name)) continue;
    const stat = read(`/proc/${name}/stat`);
    if (!stat) continue;
    const close = stat.lastIndexOf(")");
    const f = stat.slice(close + 2).split(" ");
    if (f[0] === "Z" || f[1] === "2" || name === "2") continue;
    const cg = (read(`/proc/${name}/cgroup`) ?? "").trim().replace(/^0::/, "");
    let cwd: string | null = null;
    try { cwd = readlinkSync(`/proc/${name}/cwd`); } catch {}
    out.push({ pid: Number(name), ppid: Number(f[1]), sid: Number(f[3]), comm: stat.slice(stat.indexOf("(") + 1, close), cgroup: cg,
      args: (read(`/proc/${name}/cmdline`) ?? "").split("\0").filter(Boolean).slice(0, 24), ticks: Number(f[11]) + Number(f[12]),
      start: f[19], rssKiB: Number(f[21]) * 4, cwd });
  }
  return out;
}

function leases(): Lease[] {
  const dir = join(RUNTIME, "agent-capacity-v1/leases");
  let names: string[] = [];
  try { names = readdirSync(dir).filter((n) => n.endsWith(".json")); } catch { return []; }
  return names.flatMap((n) => {
    try {
      const l = JSON.parse(readFileSync(join(dir, n), "utf8"));
      const u = JSON.parse(read(join(dir, n.replace(/\.json$/, ".usage"))) ?? "null");
      return [{ owner: l.owner, class: l.class, cpus: l.cpus, declaredCpus: l.declared?.cpus ?? l.cpus, memoryMiB: l.memoryMiB, recentCores: u ? r2(u.recentCores) : null, usedMiB: u ? Math.round(u.memoryMiB) : null, wrapperPid: l.wrapperPid }];
    } catch { return []; }
  });
}

function fleetSessions(): FleetSession[] {
  try {
    const result = Bun.spawnSync(["north", "fleet", "list", "--json"], { stdout: "pipe", stderr: "ignore" });
    if (result.exitCode !== 0) return [];
    const rows = JSON.parse(result.stdout.toString());
    return rows.map((row: any) => ({ name: row.name, conversation: row.conversation, host_pid: row.host_pid ?? null, parent: row.parent ?? null }));
  } catch { return []; }
}

function snapshot(): Snapshot {
  const all = procs();
  const byPid = new Map(all.map((p) => [p.pid, p]));
  const sessions = fleetSessions();
  const mem = read("/proc/meminfo") ?? "";
  const kib = (k: string) => Number(mem.match(new RegExp(`^${k}:\\s+(\\d+)`, "m"))?.[1] ?? 0);
  return {
    at: Date.now(), load: (read("/proc/loadavg") ?? "0 0 0").split(" ").slice(0, 3).map(Number),
    cpuPsi: avg10("/proc/pressure/cpu", "some"), cpuPsi60: avg60("/proc/pressure/cpu", "some"),
    memPsi: avg10("/proc/pressure/memory", "some"), memFullPsi: avg10("/proc/pressure/memory", "full"),
    memAvailableMiB: Math.round(kib("MemAvailable") / 1024), memTotalMiB: Math.round(kib("MemTotal") / 1024),
    cgroups: cgroupUsage(), busyTicks: busyTicks(), procs: all, leases: leases().map(({ wrapperPid, ...l }) => ({ ...l, ...leaseHolder(wrapperPid, byPid, sessions) })),
  };
}

let fileStart: number | null = null;
function appendSample(line: object) {
  mkdirSync(DIR, { recursive: true });
  if (fileStart === null && existsSync(SAMPLES)) {
    const head = (read(SAMPLES) ?? "").slice(0, 200).match(/"at":"([^"]+)"/)?.[1];
    fileStart = head ? Date.parse(head) : Date.now();
  }
  if (fileStart !== null && Date.now() - fileStart >= ROTATE_MS) { renameSync(SAMPLES, join(DIR, "samples.1.jsonl")); fileStart = null; }
  if (fileStart === null) fileStart = Date.now();
  appendFileSync(SAMPLES, JSON.stringify(line) + "\n");
}

function act(incidents: Incident[], terms: Term[]) {
  for (const t of terms) {
    const stat = read(`/proc/${t.pid}/stat`);
    if (stat && stat.slice(stat.lastIndexOf(")") + 2).split(" ")[19] === t.start) { try { process.kill(t.pid, "SIGTERM"); } catch {} }
  }
  if (!incidents.length) return;
  mkdirSync(DIR, { recursive: true });
  for (const i of incidents) {
    appendFileSync(INCIDENTS, `- ${i.at} ${i.kind}: ${i.summary}\n  cgroup: ${i.cgroup}\n  cwd: ${i.cwd ?? "?"}\n  pids: ${(i.pids ?? []).join(" ")}\n${(i.chain ?? []).map((c) => `  < ${c}`).join("\n")}\n`);
    const notify = process.env.CAPACITY_WATCHDOG_NOTIFY ?? "notify-send";
    if (notify) Bun.spawnSync([notify, "-u", "critical", "-a", "capacity-watchdog", `watchdog: ${i.kind}`, i.summary], { stdin: "ignore", stdout: "ignore", stderr: "ignore" });
  }
}

let stepping: Promise<void> | null = null;
function actOnOverload(sample: object): Promise<void> {
  if (stepping) return stepping;
  stepping = (async () => {
    try {
      const north = process.env.NORTH_BIN || "north";
      const step = Bun.spawn([north, "capacity", "watchdog", "step"], { stdin: new TextEncoder().encode(JSON.stringify(sample)), stdout: "ignore", stderr: "inherit", timeout: 90_000 });
      if ((await step.exited) !== 0) console.error(`capacity-watchdog: north capacity watchdog step exited ${step.exitCode}`);
    } catch (error) {
      console.error(`capacity-watchdog: north capacity watchdog step: ${(error as Error).message}`);
    }
  })().finally(() => { stepping = null; });
  return stepping;
}

const AGENT = /^(claude|codex|tmux)/;

function unitCgroups(): Map<string, string> {
  const out = new Map<string, string>();
  const walk = (dir: string, depth: number) => {
    let entries: string[] = [];
    try { entries = readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory()).map((e) => e.name); } catch { return; }
    for (const e of entries) {
      const path = join(dir, e);
      if (path === USER_ROOT) out.set(`system|${e}`, path);
      else if (/\.(service|scope)$/.test(e)) out.set(`${path.startsWith(USER_ROOT + "/") ? "user" : "system"}|${e}`, path);
      if (depth < 8) walk(path, depth + 1);
    }
  };
  walk(CGROOT, 0);
  return out;
}

function cgroupCost(path: string): { usec: number; cs: Map<number, number> } {
  const usec = Number(read(join(path, "cpu.stat"))?.match(/^usage_usec (\d+)$/m)?.[1] ?? 0);
  const cs = new Map<number, number>();
  const walk = (dir: string) => {
    for (const tid of (read(join(dir, "cgroup.threads")) ?? "").split("\n").filter(Boolean)) {
      const st = read(`/proc/${tid}/status`) ?? "";
      const n = [...st.matchAll(/^(?:non)?voluntary_ctxt_switches:\s+(\d+)$/gm)].reduce((a, m) => a + Number(m[1]), 0);
      cs.set(Number(tid), n);
    }
    try { for (const e of readdirSync(dir, { withFileTypes: true })) if (e.isDirectory()) walk(join(dir, e.name)); } catch {}
  };
  walk(path);
  return { usec, cs };
}

async function restObserve(seconds: number): Promise<RestObserved> {
  const list = (scope: "system" | "user", args: string[]) => {
    const r = Bun.spawnSync(["systemctl", ...(scope === "user" ? ["--user"] : []), "list-units", "--no-legend", "--plain", ...args], { stderr: "ignore" });
    return r.stdout.toString().split("\n").map((l) => l.trim().split(/\s+/)[0]).filter(Boolean).map((name) => ({ scope, name }));
  };
  const units: RestUnit[] = (["system", "user"] as const).flatMap((scope) => [...list(scope, ["--type=service,scope", "--state=running"]), ...list(scope, ["--type=timer", "--state=active"])]);
  const paths = unitCgroups();
  const measured = units.flatMap((u) => { const p = paths.get(`${u.scope}|${u.name}`); return p ? [{ u, p }] : []; });
  const leaves = measured.filter(({ p }) => !measured.some((o) => o.p.startsWith(p + "/")));
  const t0 = leaves.map(({ p }) => cgroupCost(p));
  const start = Date.now();
  await Bun.sleep(seconds * 1000);
  const dt = (Date.now() - start) / 1000;
  const all = procs();
  leaves.forEach(({ u, p }, i) => {
    const t1 = cgroupCost(p);
    u.cores = r2(Math.max(0, t1.usec - t0[i].usec) / 1e6 / dt);
    u.csPerSec = r2([...t1.cs].reduce((a, [tid, n]) => a + Math.max(0, n - (t0[i].cs.get(tid) ?? 0)), 0) / dt);
  });
  for (const { u, p } of measured) {
    const rel = p.slice(CGROOT.length);
    const agentName = (q: Proc) => AGENT.test(q.comm) ? q.comm : q.args.slice(0, 2).map((a) => a.split("/").pop() ?? "").find((a) => AGENT.test(a));
    const agent = all.find((q) => (q.cgroup === rel || q.cgroup.startsWith(rel + "/")) && agentName(q));
    if (agent && p !== USER_ROOT) u.agent = agentName(agent);
  }
  const ss = Bun.spawnSync(["ss", "-Htlnu", "--cgroup"], { stderr: "ignore" }).stdout.toString();
  const sockets = ss.split("\n").filter(Boolean).map((l) => {
    const f = l.trim().split(/\s+/);
    const cg = l.match(/cgroup:(\/\S*)/)?.[1];
    return `${f[0]} ${f[4].replace(/%[^:\]]+/, "")} ${cg ? cg.split("/").at(-1) || "/" : "-"}`;
  });
  return { seconds: r2(dt), units, sockets };
}

function restPrint(r: ReturnType<typeof restCheck>) {
  for (const u of r.extraUnits) console.log(`extra ${u.scope} unit: ${u.name}${u.cores !== undefined ? ` (${u.cores} cores, ${u.csPerSec} cs/s)` : ""}`);
  for (const s of r.extraSockets) console.log(`extra socket: ${s}`);
  for (const u of r.overBudget) console.log(`over budget: ${u.scope} ${u.name} ${u.cores} cores > ${u.budget} (${u.csPerSec} cs/s)`);
  for (const u of r.agents) console.log(`agent: ${u.scope} ${u.name} (${u.agent}${u.cores !== undefined ? `, ${u.cores} cores` : ""})`);
  console.log(`rest-check: ${r.ok ? "at rest" : "not at rest"}; ${r.extraUnits.length} extra units, ${r.extraSockets.length} extra sockets, ${r.overBudget.length} over budget, ${r.agents.length} agents; non-agent ${r.cores} cores, ${r.csPerSec} cs/s`);
}

const readLines = (path: string) => (read(path) ?? "").split("\n").filter(Boolean);

async function main(argv: string[]) {
  const cmd = argv.shift();
  if (cmd === "sample") {
    const once = argv.includes("--once");
    const i = argv.indexOf("--interval");
    const interval = i >= 0 ? Number(argv[i + 1]) : 30;
    let state: State = { prev: null, hot: {} };
    for (;;) {
      const r = step(state, snapshot());
      state = r.state;
      let stepped: Promise<void> | null = null;
      if (r.state.prev && (r.sample as any).intervalSeconds > 0) {
        appendSample(r.sample);
        stepped = actOnOverload(r.sample);
      }
      act(r.incidents, r.terms);
      if (once && (r.sample as any).intervalSeconds > 0) { await stepped; return 0; }
      await Bun.sleep((once ? 1 : interval) * 1000);
    }
  }
  if (cmd === "report") {
    const mins: number[] = [];
    let ledgerSince: number | undefined;
    for (let i = 0; i < argv.length; i++) {
      if (argv[i] === "--minutes") mins.push(Number(argv[++i]));
      else if (argv[i] === "--since") {
        ledgerSince = Date.parse(argv[++i]);
        if (!Number.isFinite(ledgerSince)) { console.error("invalid --since date"); return 2; }
      }
    }
    const samples = [...readLines(join(DIR, "samples.1.jsonl")), ...readLines(SAMPLES)].slice(-200).flatMap((l) => { try { return [JSON.parse(l)]; } catch { return []; } });
    const incidents = readLines(INCIDENTS).filter((l) => l.startsWith("- "));
    const windows = mins.length ? mins : [5, 30];
    const now = Date.now();
    let path = process.env.THREADS_DB ?? join(HOME, ".local/state/threads/threads.db");
    let runs: Run[] = [];
    let ledgerError = "";
    try {
      if (!process.env.THREADS_DB && existsSync(join(HOME, ".config/threads/remote"))) {
        mkdirSync(DIR, { recursive: true });
        path = join(DIR, "ledger-snapshot.db");
        const remote = readFileSync(join(HOME, ".config/threads/remote"), "utf8").trim();
        const pull = Bun.spawnSync([process.env.NORTH_BIN || "north", "threads", "snapshot-pull", "--force", "--snapshot", path, remote], { stderr: "pipe" });
        if (pull.exitCode !== 0) throw new Error(`threads snapshot-pull exit ${pull.exitCode}`);
      }
      if (existsSync(path)) {
        const db = new Database(path, { readonly: true });
        try {
          const since = new Date(ledgerSince ?? Math.max(now - Math.max(...windows) * 60000, HANDOFF_FIX)).toISOString();
          runs = db.query("SELECT agent, tier, role, ended, peak_ctx, handoff_fires, handoff_ignored FROM runs WHERE julianday(ended) >= julianday(?) AND julianday(ended) <= julianday(?)").all(since, new Date(now).toISOString()) as Run[];
        } finally { db.close(); }
      }
    } catch (error) {
      ledgerError = (error as Error).message;
    }
    for (const m of windows) {
      const result = report(samples, incidents, m, now, runs, ledgerSince);
      if (ledgerError) result.flags.push(`handoff check unavailable: ${ledgerError}`);
      const lib = join(dirname(realpathSync(Bun.fileURLToPath(import.meta.url))), "../harness/lib/provider_capacity.py");
      const probe = Bun.spawnSync(["python3", lib, "events", "--minutes", String(m)], { stderr: "pipe" });
      try {
        const hits = JSON.parse(probe.stdout.toString()) as { at: string; model: string }[];
        if (hits.length) result.flags.push(`provider-capacity codex: ${hits.length} turn(s) of ${[...new Set(hits.map((h) => h.model))].join(", ")} at capacity, last ${hits.at(-1)!.at}`);
      } catch {
        result.flags.push(`provider-capacity check unavailable: exit ${probe.exitCode}`);
      }
      console.log(JSON.stringify(result));
    }
    return 0;
  }
  if (cmd === "replay" && argv[0]) {
    let state: State = { prev: null, hot: {} };
    for (const line of readLines(argv[0])) {
      const r = step(state, JSON.parse(line));
      state = r.state;
      for (const i of r.incidents) console.log(JSON.stringify(i));
      for (const t of r.terms) console.log(JSON.stringify({ term: t.pid }));
    }
    return 0;
  }
  if (cmd === "rest-check") {
    const opt = (name: string) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };
    const expectedPath = opt("--expected") ?? process.env.CAPACITY_WATCHDOG_REST ?? join(process.env.XDG_CONFIG_HOME ?? join(HOME, ".config"), "capacity-watchdog/rest.json");
    const expected = JSON.parse(read(expectedPath) ?? "null") as RestExpected | null;
    if (!expected) { console.error(`no expected-at-rest set at ${expectedPath}`); return 2; }
    const observedPath = opt("--observed");
    const observed = observedPath ? JSON.parse(readFileSync(observedPath, "utf8")) as RestObserved : await restObserve(Number(opt("--seconds") ?? 30));
    const save = opt("--save");
    if (save) writeFileSync(save, JSON.stringify(observed) + "\n");
    const r = restCheck(expected, observed);
    restPrint(r);
    return r.ok ? 0 : 1;
  }
  console.error(USAGE);
  return 2;
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));
