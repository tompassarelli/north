#!/usr/bin/env bash
# codex-lead: supervise a Codex lead session from outside, without touching
# Tom's keyboard or focus. Every call resolves the live app-server daemon
# socket, because the pooled control symlink can point at a dead daemon.
#   codex-lead start BRIEF [codex args]  backend of `agents lead start --provider codex`: open the lead on Sol high (Astra only when Tom names it, via codex args) without taking focus; prints the thread id
#   codex-lead id                        newest user-started Codex TUI thread
#   codex-lead send MESSAGE              deliver a message to the lead now (mid-turn if it is working)
#   codex-lead goal OBJECTIVE            replace the lead's goal (status active)
#   codex-lead goal-get                  print the lead's goal
#   codex-lead fast on|off               switch the live lead's service tier (fast while `agents usage --fast codex` is on)
#   codex-lead model MODEL EFFORT        set the thread's model for its next turns (worker-sweep's capacity fallback and switch back)
#   codex-lead status [N]                status file plus the lead's last N rollout events (default 12)
#   codex-lead workers                   the lead's worker tree: path, model, effort, tokens, minutes idle
# The thread is $CODEX_LEAD_THREAD, else the caller's Codex node in the org (or the caller's own), else the only live Codex lead; otherwise it refuses and lists them.
set -euo pipefail

CODEX_HOME_DIR=${NORTH_CODEX_POOLED_HOME:-$HOME/.local/state/north/codex-pooled}
DB=$CODEX_HOME_DIR/sqlite/state_5.sqlite
STATUS_FILE=${CODEX_LEAD_STATUS:-$HOME/.local/state/agents/handoffs/codex-lead-status.md}

die() { echo "codex-lead: $*" >&2; exit 1; }

usage() { sed -n '5,15p' "$0" | sed 's/^# \{0,1\}//' >&2; echo 'codex-lead interrupt: interrupt the active turn of CODEX_LEAD_THREAD' >&2; exit 2; }

sock() {
  local s
  s=$(ss -xlp 2>/dev/null | rg -o '/tmp/codex-daemon-1000/[0-9a-f]+' | head -1 || true)
  [ -n "$s" ] || die "no Codex app-server daemon is listening (start any codex session first)"
  printf '%s\n' "$s"
}

thread() {
  local t=${CODEX_LEAD_THREAD:-} org=${AGENTS_ORG_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/agents/org.json} me=${AGENT_ORG_NAME:-} listing
  local -a rows=()
  if [ -z "$t" ] && [ -f "$org" ]; then
    listing=$(jq -r --arg me "$me" '
      (.nodes // []) | map(select(.provider == "codex" and .state == "active" and (.session // "") != "")) as $live
      | ($live | map(select(.id == $me))) as $own
      | ($live | map(select($me != "" and .parent == $me))) as $kids
      | (if $own != [] then $own elif $kids != [] then $kids else $live end)
      | .[] | "\(.id)\t\(.session)"' "$org") || die "cannot read $org"
    if [ -n "$listing" ]; then mapfile -t rows <<<"$listing"; fi
  fi
  if [ -z "$t" ]; then
    case ${#rows[@]} in
      1) t=${rows[0]#*$'\t'} ;;
      0) die "no live Codex lead: set CODEX_LEAD_THREAD or run 'codex-lead start BRIEF'" ;;
      *) { printf 'codex-lead: %s Codex leads are live; set CODEX_LEAD_THREAD to one of:\n' "${#rows[@]}"
           for r in "${rows[@]}"; do printf '%s  %s\n' "${r%%$'\t'*}" "${r#*$'\t'}"; done; } >&2
         exit 1 ;;
    esac
  fi
  printf '%s\n' "$t"
}

sql() { sqlite3 -readonly -cmd '.timeout 5000' "$DB" "$@"; }

newest_tui() { # $1 = optional minimum created_at (epoch seconds)
  local prompt_filter=
  if [ $# -ge 2 ]; then prompt_filter=" and first_user_message='${2//\'/\'\'}'"; fi
  sql "select id from threads where originator='codex-tui' and thread_source='user'
       and archived=0 and created_at >= ${1:-0}$prompt_filter order by created_at desc limit 1"
}

websocat_cmd() {
  if command -v websocat >/dev/null 2>&1; then echo websocat; return; fi
  local out
  out=$(nix build --no-link --print-out-paths nixpkgs#websocat 2>/dev/null | tail -1) ||
    die "cannot build websocat"
  echo "$out/bin/websocat"
}

rpc() { # $1 = method, $2 = params JSON; prints the result JSON
  local s ws out
  s=$(sock); ws=$(websocat_cmd)
  out=$({ printf '%s\n' \
      '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"codex-lead","version":"1"},"capabilities":{"experimentalApi":true}}}' \
      '{"jsonrpc":"2.0","method":"initialized"}' \
      "$(jq -cn --arg m "$1" --argjson p "$2" '{jsonrpc:"2.0",id:2,method:$m,params:$p}')"
    sleep 3; } |
    timeout 20 "$ws" -t --ws-c-uri=ws://localhost/ - "ws-c:unix:$s" 2>/dev/null |
    jq -c 'select(.id==2)' | head -1) || true
  [ -n "$out" ] || die "$1: no reply from the daemon"
  jq -e 'has("error") | not' >/dev/null <<<"$out" || die "$1: $(jq -c .error <<<"$out")"
  jq -c .result <<<"$out"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  start)
    [ $# -ge 1 ] || usage
    brief=$(realpath -e "$1") || die "brief not found: $1"; shift
    if [ "${CODEX_LEAD_COACH:-0}" = 1 ]; then
      export CODEX_LEAD_STATUS=$STATUS_FILE
      export CODEX_LEAD_COACH_STATE=${CODEX_LEAD_COACH_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agents/codex-coach}
      export CODEX_LEAD_COACH_BRIEF=$brief CODEX_LEAD_COACH_TOOL
      CODEX_LEAD_COACH_TOOL=$(realpath -e "$0")
      python3 "$(dirname "$CODEX_LEAD_COACH_TOOL")/../lib/codex/coach.py" prepare "$brief"
      if [ -n "${CODEX_LEAD_RESUME:-}" ]; then
        rollout=$(sql "select rollout_path from threads where id='${CODEX_LEAD_RESUME//\'/\'\'}'")
        [ -f "$rollout" ] || die "no rollout for thread $CODEX_LEAD_RESUME"
        python3 "$(dirname "$CODEX_LEAD_COACH_TOOL")/../lib/codex/coach.py" prepare "$brief" --resume "$CODEX_LEAD_RESUME" "$rollout"
      fi
      export CODEX_LEAD_PROMPT
      CODEX_LEAD_PROMPT=$(python3 "$(dirname "$CODEX_LEAD_COACH_TOOL")/../lib/codex/coach.py" prompt "$brief" "${CODEX_LEAD_PROMPT:-read $brief and follow it}")
    fi
    if agents usage --fast codex ${AGENT_DOMAIN:+--domain "$AGENT_DOMAIN"} >/dev/null 2>&1; then
      set -- -c 'service_tier="fast"' "$@"
    fi
    since=$(( $(date +%s) - 1 ))
    if [ "${CODEX_LEAD_COACH:-0}" = 1 ]; then export CODEX_LEAD_COACH_SINCE=$since; fi
    script='if [ -n "${AGENT_ORG_NAME:-}" ]; then agents org set "$AGENT_ORG_NAME" --pid $$ >/dev/null
         trap "agents org exit \"\$AGENT_ORG_NAME\" --pid $$ >/dev/null" EXIT HUP TERM; fi; codex "$@"; exit $?'
    if [ "${CODEX_LEAD_COACH:-0}" = 1 ]; then
      script='coach_pid=
        cleanup() { if [ -n "$coach_pid" ]; then kill "$coach_pid" 2>/dev/null || true; wait "$coach_pid" 2>/dev/null || true; fi
          if [ -n "${AGENT_ORG_NAME:-}" ]; then agents org exit "$AGENT_ORG_NAME" --pid $$ >/dev/null; fi; }
        trap cleanup EXIT
        trap "exit 130" HUP INT TERM
        if [ -n "${AGENT_ORG_NAME:-}" ]; then agents org set "$AGENT_ORG_NAME" --pid $$ >/dev/null; fi
        mkdir -p "$(dirname "$CODEX_LEAD_STATUS")"
        "$CODEX_LEAD_COACH_TOOL" coach "$CODEX_LEAD_COACH_BRIEF" --watch --launch "$CODEX_LEAD_COACH_SINCE" "$CODEX_LEAD_PROMPT" >>"$CODEX_LEAD_STATUS" 2>&1 & coach_pid=$!
        codex "$@"; exit $?'
    fi
    command=(bash -c "$script" _)
    if [ -n "${CODEX_LEAD_RESUME:-}" ]; then command+=(resume); fi
    command+=(-m gpt-6.1-sol -c model_reasoning_effort=high
      -c 'tui.status_line=["thread-title","model-with-reasoning","context-remaining"]' -c 'tui.terminal_title=[]'
      "$@")
    if [ -n "${CODEX_LEAD_RESUME:-}" ]; then command+=("$CODEX_LEAD_RESUME"); fi
    command+=("${CODEX_LEAD_PROMPT:-read $brief and follow it}")
    case ${CODEX_LEAD_HOST:-ghostty} in
      tmux)
        name=${AGENT_ORG_NAME:-codex-lead}
        printf -v pane '%q ' "${command[@]}"
        printf -v socket '%q' "socrates-$name"
        printf -v session '%q' "$name"
        body="tmux -L $socket -f /dev/null new-session -d -s $session -x 200 -y 50"
        printf -v quoted_pane '%q' "$pane"
        body+=" $quoted_pane; tmux -L $socket set-option -g set-clipboard off; "
        body+="while tmux -L $socket has-session -t $session 2>/dev/null; do sleep 5; done"
        unit=(systemd-run --user --expand-environment=no "--unit=socrates-$name" --collect -p KillMode=control-group "--working-directory=$PWD")
        while IFS= read -r key; do
          case $key in
            AGENT*|CODEX_LEAD_*|NORTH_CODEX_POOLED_HOME|CLAUDE_CODE_DISABLE_FAST_MODE|PATH|HOME|XDG_RUNTIME_DIR|WAYLAND_DISPLAY|NIRI_SOCKET|DBUS_SESSION_BUS_ADDRESS|SSH_AUTH_SOCK)
              unit+=("--setenv=$key=${!key}") ;;
          esac
        done < <(compgen -e)
        "${unit[@]}" bash -c "$body" >/dev/null ;;
      ghostty)
        command -v spawn-quiet >/dev/null || die "spawn-quiet is missing"
        spawn-quiet ghostty --title="${AGENT_ORG_NAME:-codex lead}" -e "${command[@]}" >/dev/null ;;
      *) die "CODEX_LEAD_HOST must be ghostty or tmux" ;;
    esac
    t=${CODEX_LEAD_RESUME:-}
    if [ -z "$t" ]; then
      for _ in $(seq 1 60); do
        t=$(newest_tui "$since" "${CODEX_LEAD_PROMPT:-read $brief and follow it}"); [ -n "$t" ] && break; sleep 1
      done
    fi
    [ -n "$t" ] || die "the lead started but no thread appeared within 60s"
    if [ -n "${AGENT_ORG_NAME:-}" ]; then
      rpc thread/name/set "$(jq -cn --arg t "$t" --arg n "$AGENT_ORG_NAME" '{threadId:$t,name:$n}')" >/dev/null \
        || echo "codex-lead: could not name thread $t" >&2
    fi
    echo "$t" ;;
  coach)
    [ "${CODEX_LEAD_COACH:-0}" = 1 ] || die "coach is off; set CODEX_LEAD_COACH=1 for this box"
    [ $# -ge 1 ] || die "coach needs BRIEF [--watch [--launch SINCE PROMPT]]"
    brief=$(realpath -e "$1") || die "brief not found: $1"; shift
    watch=()
    if [ "${1:-}" = --watch ]; then watch=(--watch); shift; fi
    if [ "${1:-}" = --launch ]; then
      [ $# -eq 3 ] || usage
      t=
      for _ in $(seq 1 60); do
        t=${CODEX_LEAD_RESUME:-}
        if [ -z "$t" ]; then t=$(newest_tui "$2" "$3"); fi
        [ -n "$t" ] && break; sleep 1
      done
      [ -n "$t" ] || die "coach: no launch thread appeared within 60s"
    else
      [ $# -eq 0 ] || usage
      t=$(thread)
    fi
    rollout=$(sql "select rollout_path from threads where id='${t//\'/\'\'}'")
    [ -f "$rollout" ] || die "no rollout for thread $t"
    export CODEX_LEAD_THREAD=$t
    export CODEX_LEAD_COACH_PARENT CODEX_LEAD_COACH_PEER CODEX_LEAD_STATUS=$STATUS_FILE
    org=${AGENTS_ORG_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/agents/org.json}
    CODEX_LEAD_COACH_PARENT=
    if [ -f "$org" ]; then
      CODEX_LEAD_COACH_PARENT=$(jq -r --arg t "$t" '(.nodes // []) as $nodes | $nodes[] | select(.session==$t) | .parent as $parent | $nodes[] | select(.id==$parent and .provider=="codex" and .state=="active") | .session // empty' "$org")
    fi
    CODEX_LEAD_COACH_PEER=${CODEX_LEAD_COACH_PEER:-${STATUS_FILE%-status.md}-peer.md}
    exec python3 "$(dirname "$(realpath -e "$0")")/../lib/codex/coach.py" observe "$brief" "$t" "$rollout" "$(realpath -e "$0")" "${watch[@]}" ;;
  id)
    t=$(newest_tui); [ -n "$t" ] || die "no Codex TUI thread found"
    echo "$t" ;;
  send)
    # `codex queue` holds a message until the lead's turn ends, and a lead on a
    # goal can stay in one turn for hours; steer into the live turn instead.
    [ $# -eq 1 ] || usage
    t=$(thread)
    input=$(jq -cn --arg m "$1" '[{type:"text",text:$m,text_elements:[]}]')
    turn=$(rpc thread/turns/list "$(jq -cn --arg t "$t" '{threadId:$t,limit:1,sortDirection:"desc",itemsView:"notLoaded"}')" |
      jq -r '.data[0] | select(.status=="inProgress") | .id')
    if [ -n "$turn" ] && out=$(rpc turn/steer "$(jq -cn --arg t "$t" --arg turn "$turn" --argjson i "$input" \
        '{threadId:$t,expectedTurnId:$turn,input:$i}')" 2>&1); then
      echo "delivered into running turn $(jq -r .turnId <<<"$out")"
    else
      rpc turn/start "$(jq -cn --arg t "$t" --argjson i "$input" --arg m "${CODEX_LEAD_MODEL:-}" --arg e "${CODEX_LEAD_EFFORT:-}" \
        '{threadId:$t,input:$i} + (if $m != "" then {model:$m,effort:$e} else {} end)')" |
        jq -r '"delivered as new turn \(.turn.id)"'
    fi ;;
  interrupt)
    [ $# -eq 0 ] || usage
    t=${CODEX_LEAD_THREAD:-}
    [ -n "$t" ] || die "interrupt requires CODEX_LEAD_THREAD"
    turn=$(rpc thread/turns/list "$(jq -cn --arg t "$t" '{threadId:$t,limit:1,sortDirection:"desc",itemsView:"notLoaded"}')" |
      jq -r '.data[0] | select(.status=="inProgress") | .id')
    if [ -n "$turn" ]; then
      rpc turn/interrupt "$(jq -cn --arg t "$t" --arg turn "$turn" '{threadId:$t,turnId:$turn}')" >/dev/null
      echo "interrupted turn $turn"
    else
      echo "no active turn for $t"
    fi ;;
  goal)
    [ $# -eq 1 ] || usage
    t=$(thread)
    rpc thread/goal/set "$(jq -cn --arg t "$t" --arg o "$1" '{threadId:$t,objective:$o,status:"active"}')" |
      jq -r '.goal | "\(.status // "?"): \(.objective)"' ;;
  fast)
    case ${1:-} in on) tier='"fast"' ;; off) tier=null ;; *) usage ;; esac
    t=$(thread)
    rpc thread/settings/update "$(jq -cn --arg t "$t" --argjson v "$tier" '{threadId:$t,serviceTier:$v}')" >/dev/null &&
      echo "service tier ${1}: $t" ;;
  model)
    [ $# -eq 2 ] || usage
    t=$(thread)
    rpc thread/settings/update "$(jq -cn --arg t "$t" --arg m "$1" --arg e "$2" '{threadId:$t,model:$m,effort:$e}')" >/dev/null &&
      echo "model $1 $2: $t" ;;
  goal-get)
    t=$(thread)
    rpc thread/goal/get "$(jq -cn --arg t "$t" '{threadId:$t}')" |
      jq -r 'if .goal then .goal | "\(.status // "?"): \(.objective)" else "no goal set" end' ;;
  status)
    n=${1:-12}
    if [ -f "$STATUS_FILE" ]; then cat "$STATUS_FILE"; else echo "(no status file at $STATUS_FILE)"; fi
    t=$(thread)
    rollout=$(sql "select rollout_path from threads where id='$t'")
    [ -f "$rollout" ] || die "no rollout for thread $t"
    printf '\n--- lead %s, last %s events ---\n' "$t" "$n"
    tail -n 400 "$rollout" |
      jq -r 'select(.type=="response_item") | .payload as $p
        | select($p.type != "function_call_output" and $p.type != "reasoning")
        | (.timestamp[11:19]) + " " + $p.type
          + (if $p.name then " " + $p.name else "" end) + ": "
          + ((([$p.content[]? | .text? // empty] | join(" ")) + ($p.arguments // ""))
             | gsub("\\s+"; " ") | .[0:220])' |
      tail -n "$n" ;;
  workers)
    t=$(thread)
    sql -separator $'\t' "with recursive tree(id, depth) as (
         select '$t', 0
         union all
         select e.child_thread_id, tree.depth + 1
         from thread_spawn_edges e join tree on e.parent_thread_id = tree.id)
       select coalesce(th.agent_path, '/root'), th.model, coalesce(th.reasoning_effort, '?'),
              (th.tokens_used / 1000) || 'k tok',
              'idle ' || cast((strftime('%s','now') - th.updated_at) / 60 as int) || 'm'
       from tree join threads th on th.id = tree.id
       order by tree.depth, th.created_at" | column -t -s $'\t' ;;
  *) usage ;;
esac
