#!/usr/bin/env bash
# Firn keeps this stable command name; North owns the catalog, permission
# transition, activation generation, and every projection it reports.
# `plan` is local: it reads south:agents/orchestration.toml and the
# providers signed in now, and prints the bands sessions staff from.
# `routines` indexes every recurring job from the operator routines dir (south:agents/routines).
set -uo pipefail


operator_dir() {
  if [ -n "${AGENTS_OPERATOR_DIR:-}" ]; then printf '%s\n' "$AGENTS_OPERATOR_DIR"
  else printf '%s\n' "$HOME/code/south/main/agents"
  fi
}

usage() {
  printf 'agents pace grant ACCOUNT MAX-WORKERS --until UTC --for LEAD --reason TEXT [--task NAME --uses N]\n' >&2
  printf 'usage: agents {status [--json]|stale [--json]|inspect <id> [--json]|path <id>|on <id>|off <id>|sync|presence [--json] [--at ISO]|flow [--json] [--repo NAME]... [--stall-alarm]|plan [--score PROJECT] [--place BRIEF...|--credit] [--quote --project P --boxes N [--category C]] [--json] [--mode split|claude-only] [--at SCENARIO.json]|routines [list|show NAME|pointer NAME] [--crons FILE|-]|report|usage [--refresh] [--json] [--gate PROVIDER] [--fast PROVIDER [--domain D] [--cached]]|news [--days 7] [--noise ID|--more ID] [--feedback PATH]}\n' >&2
}

plan() {
  case "${1:-}" in
    --score|--place|--credit) exec "${NORTH_PACE_BIN:-north}" agents plan "$@" ;;
  esac
  for arg in "$@"; do
    if [ "$arg" = "--quote" ]; then exec "${NORTH_PACE_BIN:-north}" agents plan "$@"; fi
  done
  if command -v update-status >/dev/null; then update-status >&2; fi
  local mode="" at="" json="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json="1"; shift ;;
      --mode) [ $# -ge 2 ] || { usage; exit 2; }; mode=$2; shift 2 ;;
      --at) [ $# -ge 2 ] || { usage; exit 2; }; at=$2; shift 2 ;;
      *) usage; exit 2 ;;
    esac
  done
  local config="${AGENTS_ORCHESTRATION:-$(operator_dir)/orchestration.toml}"
  local catalog="$(dirname "$(readlink -f "$0")")/../harness/model-catalog.toml"
  local lib="$(dirname "$(readlink -f "$0")")/../harness/lib"
  if [ -n "$at" ]; then
    AGENTS_PLAN_JSON="$json" exec python3 -I -c '
import json, os, sys
sys.path.insert(0, sys.argv[1])
import plan_usage
try:
    with open(sys.argv[2]) as f:
        ctx = json.load(f)
    out, bad = plan_usage.replay(ctx)
    if os.environ["AGENTS_PLAN_JSON"] == "1":
        ctx["now"] = plan_usage.ts(ctx["now"])
        out = [json.dumps(plan_usage.json_plan(ctx), allow_nan=False)]
except (OSError, ValueError, KeyError) as e:
    sys.exit(f"agents plan --at: {e}")
print("\n".join(out))
if bad:
    print(f"MISMATCH {bad}", file=sys.stderr)
    sys.exit(1)
' "$lib" "$at"
  fi
  AGENTS_PLAN_JSON="$json" AGENTS_PLAN_MODE="$mode" AGENTS_PLAN_CONFIG="$config" \
    AGENTS_PLAN_CATALOG="$catalog" AGENTS_PLAN_LIB="$lib" \
    AGENTS_PLAN_SELF="$(readlink -f "$0")" \
    AGENTS_CLAUDE_BIN="${AGENTS_CLAUDE_BIN:-claude}" \
    exec python3 -I -c '
import json, os, sqlite3, subprocess, sys, tomllib
from pathlib import Path
sys.path.insert(0, os.environ["AGENTS_PLAN_LIB"])
from plan_usage import bands_of, resolve_bands, resolve_mode

def die(msg):
    print(f"agents plan: {msg}", file=sys.stderr)
    sys.exit(2)

path = os.environ["AGENTS_PLAN_CONFIG"]
try:
    with open(path, "rb") as f:
        cfg = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError) as e:
    die(f"cannot read {path}: {e}")

tiers = cfg.get("tiers", {})
for ref, t in tiers.items():
    st = t.get("start")
    if ":" not in ref or "model" not in t or "effort" not in t or not (isinstance(st, (int, float)) and not isinstance(st, bool) and 0 <= st <= 100):
        die(f"tier {ref!r} needs provider:name, model, effort and start = difficulty percentile (0-100)")
try:
    mode, providers, wanted = resolve_mode(cfg, os.environ["AGENTS_PLAN_MODE"])
except ValueError as e:
    die(str(e))

def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        return r.returncode, r.stdout + r.stderr
    except (OSError, subprocess.TimeoutExpired):
        return None, ""

def signed_in(name):
    if name == "claude":
        code, out = run([os.environ["AGENTS_CLAUDE_BIN"], "auth", "status"])
        try:
            return code == 0 and json.loads(out).get("loggedIn") is True, "claude auth status"
        except ValueError:
            return False, "claude auth status"
    return False, "no sign-in check for this provider"

json_output = os.environ["AGENTS_PLAN_JSON"] == "1"
if not json_output:
    print(f"mode: {mode}")
usable = []
dropped = {}
for name in providers:
    if name not in wanted:
        dropped[name] = f"mode is {mode}"
        if not json_output:
            print(f"{name}: dropped, mode is {mode}")
        continue
    ok, how = signed_in(name)
    if ok:
        usable.append(name)
        if not json_output:
            print(f"{name}: signed in")
    else:
        dropped[name] = f"not signed in ({how})"
        if not json_output:
            print(f"{name}: dropped, not signed in ({how})")
if not usable:
    if not json_output:
        print("bands: none; recommend to Tom (no provider is usable)")
    if json_output:
        sys.stdout.write(json.dumps({"mode": mode, "usable": [], "bands": [], "escalation": []}) + "\n")
    sys.exit(1)

def label(r):
    t = tiers[r]
    agent = f" ({t["agent"]})" if t.get("agent") else ""
    return f"{t["model"]} {t["effort"]}{agent}"

catalog_path = os.environ["AGENTS_PLAN_CATALOG"]
try:
    with open(catalog_path, "rb") as f:
        catalog = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError) as e:
    die(f"cannot read {catalog_path}: {e}")
models = catalog["models"]
threads_state = Path.home() / ".local/state/threads"
db_path = Path(os.environ.get("THREADS_DB") or threads_state / (
    "snapshot.db" if (Path.home() / ".config/threads/remote").exists() else "threads.db"))

import plan_usage
from calibration import open_ledger
from datetime import datetime, timezone
cost_path = Path(path).with_name("costs.toml")
try:
    with cost_path.open("rb") as f:
        costs = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError) as e:
    die(f"cannot read {cost_path}: {e}")
code, out = run([os.environ["AGENTS_PLAN_SELF"], "usage", "--json"])
try:
    rows = json.loads(out) if code == 0 else []
except ValueError:
    rows = []
db = plan_usage.open_db(db_path)
ctx = plan_usage.live_ctx(cfg, catalog, [r for r in rows if r["provider"] in usable], db, datetime.now(timezone.utc),
                          {k: t for k, t in tiers.items() if k.split(":")[0] in usable}, costs)
try:
    result = plan_usage.json_plan(ctx)
except ValueError as e:
    die(str(e))
unavailable = {p for p, c in result["capacity"].items() if not c["fallback"]}
avail = [r for r in tiers if r.split(":")[0] in usable and r.split(":")[0] not in unavailable]

if json_output:
    snapshot = {"mode": mode, "usable": usable, "bands": resolve_bands(bands_of(tiers), avail), "escalation": avail}
    snapshot.update({k: result[k] for k in ("accounts", "routes", "capacity")})
    snapshot["projects"] = ctx["projects"]
    snapshot["tiers"] = {k: f"{t["model"]} {t["effort"]}" for k, t in tiers.items()}
    sys.stdout.write(json.dumps(snapshot, allow_nan=False) + "\n")
    sys.exit(0)

full = bands_of(tiers)
print("bands (difficulty percentile: start tier):")
if not avail:
    reasons = [f"{p} dropped, {dropped[p]}" if p in dropped else
               f"{p} capacity error since {result["capacity"][p]["since"]}" for p in providers]
    print(f"  none: no provider available ({"; ".join(reasons)})")
for lo, hi, r in resolve_bands(full, avail):
    took = {}
    for x in full:
        if x[2] not in avail and x[0] < hi and x[1] > lo:
            why = "provider capacity" if x[2].split(":")[0] in unavailable else "provider dropped"
            took.setdefault(why, []).append(f"{x[2]} {x[0]}-{x[1]}")
    note = f" (takes {"; ".join(f"{", ".join(v)}: {k}" for k, v in took.items())})" if took else ""
    print(f"  {lo}-{hi} {tiers[r].get("role", r)}: {label(r)}{note}")
print("escalation: " + ", ".join(label(r) for r in avail) + ", then recommend to Tom")

if not ctx["accounts"]:
    print("accounts: no usage snapshot; run `agents usage --refresh`")
print("\n".join(plan_usage.lines(ctx, result) + plan_usage.promo_lines(catalog, db, ctx["now"])))
import goal_eta
goals = goal_eta.plan_lines(cfg, db_path)
if goals:
    print("\n".join(goals))

run_tiers = plan_usage.RUN_TIERS
try:
    db = open_ledger(db_path)
    measured = {tier: (n, done) for tier, n, done in db.execute(
        "SELECT tier, COUNT(*), SUM(outcome = ?) FROM runs GROUP BY tier", ("done",)
    )}
    db.close()
except sqlite3.Error as e:
    measured = None
    print(f"measured runs unavailable: {e}")

def show(ref, entry, run_tier):
    value = entry.get("value", {})
    api = value.get("api")
    print(f"  {ref}: {entry["model"]} {entry["effort"]}")
    if entry.get("restriction"):
        print(f"    restriction: {entry["restriction"]}")
    print("    strengths: " + "; ".join(entry["strengths"]))
    options = "/".join(str(price) for price in value.get("monthly_price_options", []))
    price = value["monthly_price"]
    monthly = "monthly price unknown" if price == "unknown" else f"{value["currency"]} {price}/month"
    print(f"    value: {value["plan"]}; {monthly} "
          f"({value["monthly_price_note"]}" + (f"; public options {options} {value["currency"]}/month" if options else "") + "); "
          f"{value["source"]}, checked {value["checked"]}")
    if api:
        print(f"    API list comparison: {api["currency"]} {api["input_per_million"]} input / "
              f"{api["output_per_million"]} output per million tokens ({api["context"]}); "
              f"{api["long_input_per_million"]} input / {api["long_output_per_million"]} output "
              f"({api["long_context"]}); {api["source"]}, checked {api["checked"]}")
    print(f"    discounts: {value["discounts"]}; expiry {value["discount_expiry"]}; "
          f"{value["discount_source"]}, checked {value["discount_checked"]}")
    benchmarks = entry["benchmarks"]
    if benchmarks:
        best = benchmarks[0]
        result = ", ".join(f"{field} {best[field]}" for field in ("rank", "score") if field in best)
        print(f"    best benchmark: {best["name"]}, {result}; "
              f"{best["source"]}, checked {best["checked"]}")
    else:
        print("    best benchmark: none verified for this model and effort")
    if measured is None:
        print("    measured: unavailable")
    else:
        n, done = measured.get(run_tier, (0, 0))
        share = f"{done / n:.1%}" if n else "n/a (zero samples)"
        print(f"    measured: {n} runs; {done} done; done share {share}")

print("catalog (hand-edited; API prices are comparison only, separate from plan usage):")
for ref, t in tiers.items():
    if ref.split(":")[0] in usable:
        show(ref, {**models[ref], "model": t["model"], "effort": t["effort"]}, run_tiers[ref])
others = {}
for ref, entry in models.items():
    if ref.split(":")[0] not in providers:
        others.setdefault(ref.split(":")[0], []).append(entry)
for provider, entries in others.items():
    first = entries[0]
    if not first.get("model"):
        print(f"{provider} (no staffing band): not set up ({first.get("note", "no model yet")})")
        continue
    value = first["value"]
    print(f"{provider} (no staffing band): {value["plan"]}, {value["currency"]} {value["monthly_price"]}/month; {value["source"]}, checked {value["checked"]}")
    if first.get("restriction"):
        print(f"  restriction: {first["restriction"]}")
    for entry in entries:
        best = (entry["benchmarks"] or [{}])[0]
        n, done = (measured or {}).get(f"{entry["model"]} {entry["effort"]}", (0, 0))
        bench = f"{best["name"].split(" (")[0]} rank {best["rank"]}, checked {best["checked"]}" if best else "no benchmark"
        print(f"  {entry["model"]} {entry["effort"]}: {bench}; measured {n} runs, {done} done")
'
}

case "${1:-}" in
  plan)
    shift
    plan "$@"
    ;;
  *)
    exec "${NORTH_PACE_BIN:-north}" agents "$@"
    ;;
esac
