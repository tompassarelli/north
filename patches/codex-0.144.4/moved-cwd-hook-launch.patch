+fn resolve_command_cwd(cwd: &Path, process_cwd: Option<PathBuf>) -> Cow<'_, Path> {
+    if cwd.is_dir() {
+        return Cow::Borrowed(cwd);
+    }
+
+    match process_cwd {
+        Some(process_cwd) if process_cwd.is_dir() => Cow::Owned(process_cwd),
+        // Preserve the existing fail-closed spawn error when neither pathname
+        // is usable. Genuine hook failures remain governed by managed policy.
+        Some(_) | None => Cow::Borrowed(cwd),
+    }
+}
