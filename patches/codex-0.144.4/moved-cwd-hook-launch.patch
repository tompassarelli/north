+#[cfg(test)]
+mod tests {
+    use std::fs;
+
+    use tempfile::tempdir;
+
+    use super::resolve_command_cwd;
+
+    #[test]
+    fn missing_semantic_cwd_uses_live_process_cwd() {
+        let temp = tempdir().expect("create temp directory");
+        let moved = temp.path().join("moved");
+        fs::create_dir(&moved).expect("create live moved directory");
+        let missing = temp.path().join("old-name");
+
+        assert_eq!(
+            resolve_command_cwd(&missing, Some(moved.clone())).as_ref(),
+            moved.as_path()
+        );
+    }
+
+    #[test]
+    fn missing_semantic_and_process_cwds_preserve_fail_closed_spawn() {
+        let temp = tempdir().expect("create temp directory");
+        let missing = temp.path().join("old-name");
+        let also_missing = temp.path().join("gone");
+
+        assert_eq!(
+            resolve_command_cwd(&missing, Some(also_missing)).as_ref(),
+            missing.as_path()
+        );
+        assert_eq!(
+            resolve_command_cwd(&missing, None).as_ref(),
+            missing.as_path()
+        );
+    }
+}
