{
  "name": "north-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    "./ccr": "./src/ccr.ts",
    "./spawn": "./src/spawn.ts",
    "./dispatch": "./src/dispatch.ts",
    "./providers": "./src/providers/index.ts",
    "./wire": "./src/wire/index.ts",
    "./internal/file-lease": "./src/file-lease.ts",
    "./internal/bridge-accept": "./src/bridge/accept.ts",
    "./internal/bridge-pending": "./src/bridge/pending.ts",
    "./internal/delivery-evidence": "./src/delivery-evidence.ts",
    "./internal/north-client": "./src/north-client.ts",
    "./internal/provider-routing": "./src/provider-routing.ts",
    "./internal/providers-catalog": "./src/providers/catalog.ts",
    "./internal/telemetry": "./src/telemetry.ts",
    "./internal/wire": "./src/wire/index.ts",
    "./internal/bridge-command-receipts": "./src/bridge/command-receipts.ts",
    "./internal/bridge-provider": "./src/bridge/provider.ts"
  },
  "scripts": {
    "dispatch": "bun run src/dispatch.ts",
    "license:check": "bun run src/license-integrity.ts",
    "check": "bun run license:check && bun x tsc --noEmit && bash ./scripts/check-builds.sh",
    "test": "bash ./test/support/run-suite.sh",
    "test:bridge-surface": "bun test --isolate --preload ./test/support/hermetic-preload.ts ./test/bridge-semantic-surface.test.ts ./test/bridge-views.test.ts ./test/bridge-app-launch.test.ts ./test/bridge-generated-contract.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.219",
    "@opentui/core": "0.5.0",
    "@opentui/keymap": "0.5.0",
    "zod": "^4.4.3"
  }
}
