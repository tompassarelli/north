#lang beagle/js

(ns north.bridge.app
  (:require [|@opentui/core| :refer [BoxRenderable ScrollBoxRenderable StyledText
                                     bg brightBlack brightCyan brightGreen brightRed brightWhite brightYellow
                                     createCliRenderer dim InputRenderable InputRenderableEvents
                                     red stripAnsiSequences TextRenderable white]]
            [|@opentui/keymap/addons| :refer [registerEmacsBindings registerEscapeClearsPendingSequence]]
            [|@opentui/keymap/opentui| :refer [createDefaultOpenTuiKeymap]]
            [north.bridge.model :refer [Agent BridgeSnapshot WorkItem ->Agent ->WorkItem
                                        agent-id agent-name agent-status agent-task
                                        bridgesnapshot-active-view-id bridgesnapshot-agents
                                        bridgesnapshot-board bridgesnapshot-layout
                                        bridgesnapshot-list bridgesnapshot-notice
                                        bridgesnapshot-selected-thread
                                        focus-view make-model
                                        replace-projection select-agent select-thread
                                        set-filter set-layout snapshot upsert-agent
                                        workitem-body workitem-condition workitem-dependencies
                                        workitem-driver workitem-id workitem-title]]))

(define-mode strict)

(declare-extern [process Bun Response TextDecoder Error String Number Set Intl
                 setInterval clearInterval] Any)

(def IntlSegmenter: Any (.-Segmenter Intl))

(defrecord SlashCommand
  [name: String
   description: String
   arguments: Bool
   completion: String
   emoji: Bool])

(defrecord ParsedCommand
  [name: String
   rest: String])

(defrecord ConversationItem
  [id: String
   kind: String
   title: String
   body: String
   status: String
   data: Any])

(defrecord WorkView
  [id: String
   title: String
   items: (Vec WorkItem)])

(defrecord ListSection
  [id: String
   title: String])

(defrecord ListRow
  [kind: String
   condition: String
   index: Int
   count: Int])

(defrecord WorkSelection
  [view: String
   index: Int])

(defrecord BoardLane
  [id: String
   title: String])

(defrecord SoundPack
  [ready: (Vec String)
   done: (Vec String)
   interrupted: (Vec String)
   failed: (Vec String)])

(defrecord SoundPlayer
  [kind: String
   path: String])

(defrecord ParsedRecord
  [kind: String
   data: Any])

(defrecord CommandParts
  [executable: String
   arguments: String])

(defrecord DiffRow
  [kind: String
   old: String
   new: String
   text: String])

(defrecord DiffState
  [old-line: Int
   new-line: Int
   additions: Int
   deletions: Int
   rows: (Vec DiffRow)])

(defrecord FileChangeDetails
  [path: String
   kind: String
   additions: Int
   deletions: Int
   rows: (Vec DiffRow)])

(defrecord FileChangeSummary
  [additions: Int
   deletions: Int
   files: (Vec FileChangeDetails)])

