;; The agent strip reads left to right: the roster total, then one segment per
;; state bucket that currently has members. Buckets that are empty stay off the
;; strip; the total always answers "how many agents exist at all".
(def STRIP-BUCKETS (Vec StripBucket)
  [(->StripBucket "running" "")
   (->StripBucket "blocked" "! ")
   (->StripBucket "failed" "✕ ")])

(def STRIP-SEPARATOR String " · ")

(def STRIP-INDENT Int 2)

;; Rows a frame owes to everything that is not a scrolling list: the root's
;; single top padding row, the composer line, the view bar under it, and the
;; agent strip. The session identity rides the view bar's tail now instead of
;; owning a line, so the bottom cluster is one row shorter than it was. The
;; root owes no bottom padding — the stack sits on the last row.
(def CHROME-ROWS Int 4)

;; The workspace never collapses entirely, however long a list gets.
(def MIN-WORKSPACE-ROWS Int 4)

;; Pure: how many rows of a list one frame may draw. No list is ever truncated
;; to a fixed count — the window is only as small as the terminal forces it,
;; and every entry outside it stays reachable by scrolling.
(defn fitted-window
  [total Int
   rows Int
   reserved Int]
  Int
  (Math/max 1 (Math/min total (- rows reserved))))

;; Pure: keep the cursor near the middle of the window and never scroll past
;; either end. A window that already fits the whole list starts at zero.
(defn window-start
  [index Int
   total Int
   visible Int]
  Int
  (Math/max 0 (Math/min (- index (Math/floor (/ visible 2)))
                        (- total visible))))

