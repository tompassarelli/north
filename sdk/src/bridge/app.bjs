   kind String
   title String
   body String
   status String
   data Any
   execution-id String
   at String
   cursor Int
   sequence Int])

(defrecord WorkView
  [id String
   title String
   items (Vec WorkItem)])

(defrecord ListSection
  [id String
   title String])

(defrecord ListRow
  [kind String
   condition String
   index Int
   count Int])

(defrecord WorkSelection
  [view String
   index Int])

(defrecord BoardLane
  [id String
   title String])

(defrecord SoundPack
  [ready (Vec String)
   done (Vec String)
   interrupted (Vec String)
   failed (Vec String)])

(defrecord SoundPlayer
  [kind String
   path String])

(defrecord ParsedRecord
  [sequence Int
   kind String
   data Any])

(defrecord CommandParts
  [executable String
   arguments String])

(defrecord DiffRow
  [kind String
   old String
   new String
   text String])

(defrecord DiffState
  [old-line Int
   new-line Int
   additions Int
   deletions Int
   rows (Vec DiffRow)])

(defrecord FileChangeDetails
  [path String
   kind String
   additions Int
   deletions Int
   rows (Vec DiffRow)])

(defrecord FileChangeSummary
  [additions Int
   deletions Int
   files (Vec FileChangeDetails)])

(defrecord StripBucket
  [id String
   glyph String])

(defrecord AgentSegment
  [id String
   label String
   count Int])

(defn north-bin [] String
  (let [configured String (text (.-NORTH_BIN (.-env process)))]
    (if (identical? configured "") "north" configured)))

(def AGENTS-BIN String
  (let [configured String (text (.-AGENTS_BIN (.-env process)))]
    (if (identical? configured "") "agents" configured)))

