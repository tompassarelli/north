   done (Vec String)
   interrupted (Vec String)
   failed (Vec String)])

(defrecord SoundPlayer
  [kind String
   path String])

(defrecord ParsedRecord
  [sequence Int
   kind String
   data Any])

(defrecord CommandParts
  [executable String
   arguments String])

(defrecord DiffRow
  [kind String
   old String
   new String
   text String])

(defrecord DiffState
  [old-line Int
   new-line Int
   additions Int
   deletions Int
   rows (Vec DiffRow)])

(defrecord FileChangeDetails
  [path String
   kind String
   additions Int
   deletions Int
   rows (Vec DiffRow)])

(defrecord FileChangeSummary
  [additions Int
   deletions Int
   files (Vec FileChangeDetails)])

(defrecord StripBucket
  [id String
   glyph String])

(defrecord AgentSegment
  [id String
   label String
   count Int])

(defn north-bin []  String
  (let [configured (text (js/get (js/get process .env) .NORTH_BIN))]
    (if (identical? configured "") "north" configured)))

(def AGENTS-BIN String
  (let [configured (text (js/get (js/get process .env) .AGENTS_BIN))]
    (if (identical? configured "") "agents" configured)))

