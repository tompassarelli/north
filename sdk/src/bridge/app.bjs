#lang beagle/js

(ns north.bridge.app
  (:require [|@opentui/core| :refer [BoxRenderable ScrollBoxRenderable StyledText
                                     bg brightBlack brightCyan brightGreen brightRed brightWhite brightYellow
                                     createCliRenderer dim InputRenderable InputRenderableEvents
                                     red stripAnsiSequences TextRenderable white]]
            [|@opentui/keymap/addons| :refer [registerEmacsBindings registerEscapeClearsPendingSequence]]
            [|@opentui/keymap/opentui| :refer [createDefaultOpenTuiKeymap]]
            [north.bridge.model :refer [Agent BridgeSnapshot WorkItem ->Agent ->WorkItem
                                        agent-effort agent-goal agent-id agent-model
                                        agent-model-display agent-name
                                        agent-orchestration-provenance agent-provider
                                        agent-provider-label agent-provider-target
                                        agent-state agent-status agent-task
                                        bridgesnapshot-active-view-id bridgesnapshot-agents
                                        bridgesnapshot-board
                                        bridgesnapshot-list bridgesnapshot-notice
                                        bridgesnapshot-selected-agent
                                        bridgesnapshot-selected-thread
                                        focus-view make-model
                                        remove-agent
                                        replace-projection select-agent select-thread
                                        set-filter snapshot upsert-agent
                                        workitem-body workitem-condition workitem-dependencies
                                        workitem-driver workitem-id workitem-title]]))

(defrecord ResponseValue [text (Fn [] (Promise String))])

(defrecord StreamRead
  [done Bool
   value Any])

(defrecord StreamReader [read (Fn [] (Promise StreamRead))])

(defrecord ReadableStream [getReader (Fn [] StreamReader)])

(defrecord CommandChild
  [stdout ReadableStream
   stderr ReadableStream
   exited (Promise Int)])

(defrecord PromiseConstructor [all (Fn [Any] (Promise (Vec Any)))])

(declare-extern
  [process Bun
   TextDecoder Error
   String Number
   Set Intl
   setInterval clearInterval] Any)
(declare-extern Response (Fn [Any] ResponseValue))
(declare-extern Promise PromiseConstructor)

(def IntlSegmenter Any (.-Segmenter Intl))

(defrecord SlashCommand
  [name String
   description String
   arguments Bool
   completion String
   emoji Bool])

(defrecord ParsedCommand
  [name String
   rest String])

(defrecord ConversationItem
