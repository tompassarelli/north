#lang beagle/js

(ns north.bridge.app
  (:require [|@opentui/core| :refer [BoxRenderable ScrollBoxRenderable StyledText
                                     brightBlack brightCyan brightGreen brightRed brightWhite brightYellow
                                     createCliRenderer dim InputRenderable InputRenderableEvents
                                     red stripAnsiSequences TextRenderable white]]
            [north.bridge.model :refer [focus-view make-agent make-model make-work replace-projection select-agent select-thread set-filter set-layout snapshot upsert-agent]]))

(define-mode strict)

(declare-extern [process Bun Response TextDecoder Promise JSON console Error Math String Array Set Date
                 setInterval clearInterval] Any)

(defrecord SlashCommand
  [name: String
   description: String
   arguments: Bool])

(def NORTH-BIN: String
  (or (.-NORTH_BIN (.-env process)) "north"))

(def SUPERVISOR-BOOT-PROMPT: String
  "You are the Northbridge supervisor. Reply only READY, then wait for operator input.")

(def SPINNER-FRAMES: Any ["⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"])

(def AGENT-COMMANDS: (Vec SlashCommand)
  [(->SlashCommand "/launch" "start another Codex worker" true)
   (->SlashCommand "/steer" "steer the selected agent" true)
   (->SlashCommand "/interrupt" "interrupt the active agent turn" false)
   (->SlashCommand "/refresh" "refresh agents and work" false)
   (->SlashCommand "/popout" "open the current view in another terminal" true)
   (->SlashCommand "/help" "show Northbridge controls" false)])

(def WORK-COMMANDS: (Vec SlashCommand)
  [(->SlashCommand "/capture" "capture a new work thread" true)
   (->SlashCommand "/filter" "filter visible work" true)
   (->SlashCommand "/assign" "reassign the selected work" true)
   (->SlashCommand "/view" "switch graph or Kanban view" true)
   (->SlashCommand "/split" "switch horizontal or vertical layout" true)
   (->SlashCommand "/refresh" "refresh agents and work" false)
   (->SlashCommand "/popout" "open the current view in another terminal" true)
   (->SlashCommand "/help" "show work commands" false)])

(defn text [value: Any] -> String
  (if (identical? (js/typeof value) "string") value ""))

(defn bare [value: Any] -> String
  (let [value-text (text value)]
    (if (.startsWith value-text "@") (.slice value-text 1) value-text)))

(defn error-message [error: Any] -> String
  (if (and error (identical? (js/typeof error) "object") (.-message error))
    (text (.-message error))
    (String error)))

(defn safe-json [value: Any] -> String
  (try
    (JSON/stringify value nil 2)
    (catch Error _ (String value))))

(defn clean-text [value: Any] -> String
  (stripAnsiSequences (text value)))

(defn clipped [value: Any limit: Int] -> String
  (let [clean (clean-text value)]
    (if (> (.-length clean) limit)
      (str "…" (.slice clean (- (.-length clean) limit)))
      clean)))

(defn next-item-id! [runtime: Any prefix: String] -> String
  (set! (.-itemSequence runtime) (+ (.-itemSequence runtime) 1))
  (str prefix ":" (.-itemSequence runtime)))

(defn conversation-item
  [id: String kind: String title: String body: String status: String]
  -> Any
  {:id id :kind kind :title title :body body :status status})

(defn conversation-index [runtime: Any id: String] -> Int
  (.findIndex (.-conversation runtime)
              (fn [item: Any] -> Bool (identical? (text (.-id item)) id))))

(defn conversation-item-by-id [runtime: Any id: String] -> Any
  (let [index (conversation-index runtime id)]
    (if (>= index 0) (aget (.-conversation runtime) index) nil)))

(defn upsert-conversation! [runtime: Any item: Any] -> Any
  (let [index (conversation-index runtime (text (.-id item)))]
    (if (>= index 0)
      (aset (.-conversation runtime) index item)
      (.push (.-conversation runtime) item))
    (when (> (.-length (.-conversation runtime)) 240)
      (set! (.-conversation runtime) (.slice (.-conversation runtime) -240)))
    (.render runtime)))

(defn append-system! [runtime: Any body: String] -> Any
  (when (not (identical? (.trim body) ""))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "system") "system" "" (.trim body) "done"))))

(defn append-error! [runtime: Any body: String] -> Any
  (when (not (identical? (.trim body) ""))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "error") "error" "Error" (.trim body) "failed"))))

(defn set-working! [runtime: Any working: Bool label: String] -> Any
  (set! (.-working runtime) working)
  (set! (.-workingLabel runtime) label)
  (if working
    (do
      (when (identical? (.-workingSince runtime) 0)
        (set! (.-workingSince runtime) (Date/now)))
      (when (nil? (.-spinnerTimer runtime))
        (let [timer
              (setInterval
               (fn [] -> Any
                 (when (not (.-disposed runtime))
                   (set! (.-spinnerIndex runtime) (+ (.-spinnerIndex runtime) 1))
                   (.render runtime)))
               90)]
          (set! (.-spinnerTimer runtime) timer)
          (when (.-unref timer) (.unref timer)))))
    (do
      (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
      (set! (.-spinnerTimer runtime) nil)
      (set! (.-workingSince runtime) 0)))
  (.render runtime))

(defn command [input: String] -> Any
  (let [trimmed (.trim input)
        normalized (if (.startsWith trimmed "/") (.slice trimmed 1) trimmed)
        split-at (.indexOf normalized " ")]
    (if (< split-at 0)
      {:name (.toLowerCase normalized) :rest ""}
      {:name (.toLowerCase (.slice normalized 0 split-at))
       :rest (.trim (.slice normalized (+ split-at 1)))})))

(defn palette-options [pane: String input: String] -> (Vec SlashCommand)
  (let [query (.toLowerCase (.trim input))
        commands (if (identical? pane "agents") AGENT-COMMANDS WORK-COMMANDS)]
    (if (or (not (.startsWith query "/")) (>= (.indexOf query " ") 0))
      []
      (.filter commands
               (fn [candidate: SlashCommand] -> Bool
                 (.startsWith (slashcommand-name candidate) query))))))

(defn submit-key? [name: String] -> Bool
  (or (identical? name "return")
      (identical? name "enter")
      (identical? name "kpenter")
      (identical? name "linefeed")))

(defn run-command [argv: Any] -> (Promise Any)
  (let [child (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results (js/await
                 (Promise/all [(.text (Response. (.-stdout child)))
                               (.text (Response. (.-stderr child)))
                               (.-exited child)]))
        stdout (text (aget results 0))
        stderr (text (aget results 1))
        exit-code (aget results 2)]
    (if (identical? exit-code 0)
      stdout
      (throw (Error. (str (.join argv " ") " failed (" exit-code "): "
                          (or (.trim stderr) (.trim stdout))))))))

(defn run-json [argv: Any] -> (Promise Any)
  (let [output (js/await (run-command argv))]
    (JSON/parse output)))

(defn read-stream [stream: Any on-chunk: Any] -> (Promise Any)
  (let [reader (.getReader stream)
        decoder (TextDecoder.)]
    (loop []
      (let [result (js/await (.read reader))]
        (when (not (.-done result))
          (on-chunk (.decode decoder (.-value result) {:stream true}))
          (recur))))))

(defn stream-command [argv: Any on-stdout: Any on-stderr: Any] -> (Promise Any)
  (let [child (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results (js/await
                 (Promise/all [(read-stream (.-stdout child) on-stdout)
                               (read-stream (.-stderr child) on-stderr)
                               (.-exited child)]))]
    (aget results 2)))

(defn normalize-agents [payload: Any] -> Any
  (let [rows (if (and payload (Array/isArray (.-agents payload))) (.-agents payload) [])]
    (.map rows
          (fn [row: Any] -> Any
            (let [id (bare (or (.-control_id row) (.-uuid row) (.-id row)))
                  name (text (or (.-display_handle row) (.-display_name row) id))
                  status (text (or (.-state_label row) (.-state row) "unknown"))
                  task (text (or (.-task row) (.-thread_title row) ""))]
              (make-agent id name status task))))))

(defn board-ids [board: Any] -> (Vec String)
  (if (Array/isArray board)
    (.filter
     (.map board (fn [row: Any] -> String (bare (.-id row))))
     (fn [id: String] -> Bool (not (identical? id ""))))
    []))

(defn driver-of [facts: Any id: String] -> String
  (if (not (Array/isArray facts))
    ""
    (let [row (.find facts
                     (fn [fact: Any] -> Bool
                       (and (identical? (text (.-predicate fact)) "driver")
                            (identical? (bare (.-subject fact)) id))))]
      (if row (bare (.-value row)) ""))))

(defn normalize-work [board: Any facts: Any] -> Any
  (if (not (Array/isArray board))
    []
    (.map board
          (fn [row: Any] -> Any
            (let [id (bare (.-id row))
                  title (text (or (.-title row) id))
                  condition (text (or (.-condition row) "open"))
                  emoji (text (.-emoji row))
                  driver (driver-of facts id)
                  prefix (if (identical? emoji "") "" (str emoji " "))]
              (make-work id title condition driver
                               (.trim (str prefix "@" id " " title))
                               (.trim (str condition " · " prefix "@" id " " title))))))))

(defn publish-line! [runtime: Any line: String] -> Any
  (when (and (not (.-disposed runtime))
             (not (identical? (.trim line) "")))
    (append-system! runtime line)))

(defn destroy! [runtime: Any] -> Any
  (when (not (.-disposed runtime))
    (set! (.-disposed runtime) true)
    (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
    (.destroy (.-renderer runtime))
    (.exit process 0)))

(defn install-global-exit! [runtime: Any] -> Any
  (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key: Any] -> Any
         (let [name (text (.-name key))]
           (when (and (.-ctrl key)
                      (or (identical? name "c") (identical? name "q")))
             (.preventDefault key)
             (.stopPropagation key)
             (destroy! runtime))))))

(defn refresh! [runtime: Any] -> (Promise Any)
  (let [payloads
        (js/await
         (Promise/all
          [(.catch (run-json [NORTH-BIN "agents" "--json"])
                   (fn [_: Any] -> Any nil))
           (.catch (run-json [NORTH-BIN "json" "board"])
                   (fn [_: Any] -> Any nil))]))
        agent-payload (aget payloads 0)
        board (aget payloads 1)
        state (snapshot (.-model runtime))
        current-agents (or (.-agents state) [])
        bridge-agents (.filter current-agents
                               (fn [agent: Any] -> Bool
                                 (.has (.-bridgeExecutions runtime) (text (.-id agent)))))
        remote-agents (if agent-payload (normalize-agents agent-payload) [])
        distinct-remote (.filter remote-agents
                                 (fn [agent: Any] -> Bool
                                   (not (.has (.-bridgeExecutions runtime) (text (.-id agent))))))
        agents (if agent-payload (.concat bridge-agents distinct-remote) current-agents)
        ids (if board (board-ids board) [])
        facts (if (> (.-length ids) 0)
                (js/await
                 (.catch (run-json [NORTH-BIN "json" "show-many" (.join ids ",")])
                         (fn [_: Any] -> Any [])))
                [])
        work (if board (normalize-work board facts) (or (.-graph state) []))
        kanban (if board
                 (.sort (.slice work)
                        (fn [left: Any right: Any] -> Int
                          (.localeCompare
                           (str (.-condition left) ":" (.-title left))
                           (str (.-condition right) ":" (.-title right)))))
                 (or (.-kanban state) []))]
    (set! (.-model runtime)
          (replace-projection (.-model runtime) agents work kanban))
    (.render runtime)))

(defn item-line [item: Any] -> String
  (if (identical? (js/typeof item) "string") item (text (.-text item))))

(defn view-list [state: Any] -> Any
  (if (and (Array/isArray (.-views state)) (> (.-length (.-views state)) 0))
    (.-views state)
    [{:id "graph" :title "Threads DAG" :items (or (.-graph state) [])}
     {:id "kanban" :title "Kanban" :items (or (.-kanban state) [])}]))

(defn selected-view [state: Any view-id: String] -> Any
  (let [views (view-list state)
        selected (.find views (fn [view: Any] -> Bool (identical? (text (.-id view)) view-id)))]
    (or selected (aget views 0))))

(defn roster-text [state: Any selected: Int] -> String
  (let [agents (or (.-agents state) [])]
    (if (identical? (.-length agents) 0)
      "No agents attached"
      (.join
       (.map agents
             (fn [agent: Any index: Int] -> String
               (str (if (identical? index selected) "› " "  ")
                    (or (text (.-name agent)) (text (.-id agent)))
                    (if (identical? (text (.-status agent)) "") ""
                      (str " (" (text (.-status agent)) ")"))
                    (if (identical? (text (.-task agent)) "") ""
                      (str " — " (text (.-task agent)))))))
       "\n"))))

(defn push-chunk! [chunks: Any chunk: Any] -> Any
  (.push chunks chunk))

(defn render-command-palette! [commands: (Vec SlashCommand) selected: Int] -> Any
  (let [chunks []]
    (.forEach
     commands
     (fn [candidate: SlashCommand index: Int] -> Any
       (push-chunk! chunks
                    (if (identical? index selected) (brightCyan "› ") (brightBlack "  ")))
       (push-chunk! chunks
                    ((if (identical? index selected) brightGreen brightWhite)
                     (.padEnd (slashcommand-name candidate) 13 " ")))
       (push-chunk! chunks (brightBlack (slashcommand-description candidate)))
       (when (< index (- (.-length commands) 1))
         (push-chunk! chunks (white "\n")))))
    (StyledText. chunks)))

(defn render-conversation! [runtime: Any] -> Any
  (let [chunks []
        items (.-conversation runtime)]
    (.forEach
     items
     (fn [item: Any] -> Any
       (let [kind (text (.-kind item))
             title (text (.-title item))
             body (clipped (.-body item) 6000)
             status (text (.-status item))]
         (cond
           (identical? kind "user")
           (do (push-chunk! chunks (brightCyan "❯ "))
               (push-chunk! chunks (brightWhite body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "assistant")
           (do (push-chunk! chunks (brightGreen "• "))
               (push-chunk! chunks (brightWhite body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "command")
           (do (push-chunk! chunks
                            ((cond
                               (identical? status "failed") brightRed
                               (identical? status "running") brightYellow
                               :else brightGreen)
                             "• "))
               (push-chunk! chunks (brightWhite (str (if (identical? status "running") "Running " "Ran ") title)))
               (when (not (identical? body ""))
                 (push-chunk! chunks (dim (str "\n  └ " (.replaceAll body "\n" "\n    ")))))
               (push-chunk! chunks (white "\n\n")))

           (or (identical? kind "tool") (identical? kind "change"))
           (do (push-chunk! chunks (if (identical? status "failed") (brightRed "• ") (brightGreen "• ")))
               (push-chunk! chunks (brightWhite title))
               (when (not (identical? body ""))
                 (push-chunk! chunks (dim (str "\n  └ " (.replaceAll body "\n" "\n    ")))))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "thought")
           (do (push-chunk! chunks (brightBlack "• Explored "))
               (push-chunk! chunks (dim body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "error")
           (do (push-chunk! chunks (brightRed "• Error\n  "))
               (push-chunk! chunks (red (.replaceAll body "\n" "\n  ")))
               (push-chunk! chunks (white "\n\n")))

           :else
           (do (push-chunk! chunks (brightBlack (str "• " body)))
               (push-chunk! chunks (white "\n\n")))))))
    (when (.-working runtime)
      (let [frame (aget SPINNER-FRAMES (mod (.-spinnerIndex runtime) (.-length SPINNER-FRAMES)))
            elapsed (Math/floor (/ (- (Date/now) (.-workingSince runtime)) 1000))]
        (push-chunk! chunks (brightYellow (str frame " Working")))
        (push-chunk! chunks (brightBlack (str " (" elapsed "s · esc to interrupt)")))))
    (when (and (identical? (.-length items) 0) (not (.-working runtime)))
      (push-chunk! chunks (brightBlack "Starting Codex supervisor…")))
    (StyledText. chunks)))

(defn render-status [runtime: Any state: Any] -> Any
  (if (.-showHelp runtime)
    (StyledText.
     [(brightYellow "Northbridge keys\n")
      (brightWhite "F1") (brightBlack " close help · ")
      (brightWhite "F2") (brightBlack " switch pane · ")
      (brightWhite "F3") (brightBlack " switch work view\n")
      (brightWhite "F4") (brightBlack " toggle split · ")
      (brightWhite "F5") (brightBlack " refresh · ")
      (brightWhite "F6") (brightBlack " pop out\n")
      (brightWhite "Tab") (brightBlack " switch pane · ")
      (brightWhite "Esc") (brightBlack " interrupt active turn · ")
      (brightWhite "/help") (brightBlack " commands")])
    (StyledText.
     [(brightBlack (str (text (.-notice state)) "\n"))
      (brightCyan "F1") (brightBlack " help · ")
      (brightCyan "F2") (brightBlack " pane · ")
      (brightCyan "F3") (brightBlack " view · ")
      (brightCyan "F4") (brightBlack " split · ")
      (brightCyan "F5") (brightBlack " refresh · ")
      (brightCyan "F6") (brightBlack " pop out")])))

(defn tabs-text [state: Any view-id: String] -> String
  (.join
   (.map (view-list state)
         (fn [view: Any] -> String
           (let [selected (identical? (text (.-id view)) view-id)]
             (str (if selected "[" " ")
                  (or (text (.-title view)) (text (.-id view)))
                  (if selected "]" " ")))))
   " "))

(defn work-text [view: Any selected: Int] -> String
  (let [items (or (.-items view) [])]
    (if (identical? (.-length items) 0)
      (str "No " (or (text (.-title view)) "work") " projection")
      (.join
       (.map items
             (fn [item: Any index: Int] -> String
               (str (if (identical? index selected) "› " "  ") (item-line item))))
       "\n"))))

(defn render-ui! [runtime: Any ui: Any] -> Any
  (let [state (snapshot (.-model runtime))
        agents (or (.-agents state) [])
        views (view-list state)
        requested (text (.-activeViewId state))
        current (selected-view state requested)
        items (or (.-items current) [])
        agent-max (Math/max 0 (- (.-length agents) 1))
        work-max (Math/max 0 (- (.-length items) 1))
        agent-options (if (identical? (.-pane runtime) "agents")
                        (palette-options "agents" (text (.-value (.-agentInput ui)))) [])
        work-options (if (identical? (.-pane runtime) "work")
                       (palette-options "work" (text (.-value (.-workInput ui)))) [])
        active-options (if (identical? (.-pane runtime) "agents") agent-options work-options)
        palette-max (Math/max 0 (- (.-length active-options) 1))]
    (set! (.-agentIndex runtime) (Math/max 0 (Math/min (.-agentIndex runtime) agent-max)))
    (set! (.-workIndex runtime) (Math/max 0 (Math/min (.-workIndex runtime) work-max)))
    (set! (.-paletteIndex runtime) (Math/max 0 (Math/min (.-paletteIndex runtime) palette-max)))
    (set! (.-flexDirection (.-root ui))
          (if (identical? (text (.-layout state)) "horizontal") "column" "row"))
    (if (identical? (text (.-layout state)) "horizontal")
      (do (set! (.-width (.-agentsPane ui)) "100%")
          (set! (.-width (.-workPane ui)) "100%")
          (set! (.-height (.-agentsPane ui)) "50%")
          (set! (.-height (.-workPane ui)) "50%"))
      (do (set! (.-width (.-agentsPane ui)) "50%")
          (set! (.-width (.-workPane ui)) "50%")
          (set! (.-height (.-agentsPane ui)) "100%")
          (set! (.-height (.-workPane ui)) "100%")))
    (set! (.-content (.-agentsText ui))
          (roster-text state (.-agentIndex runtime)))
    (set! (.-content (.-transcriptText ui)) (render-conversation! runtime))
    (set! (.-content (.-tabsText ui)) (tabs-text state (text (.-id current))))
    (set! (.-content (.-workText ui)) (work-text current (.-workIndex runtime)))
    (set! (.-content (.-statusText ui)) (render-status runtime state))
    (set! (.-visible (.-agentPalette ui)) (> (.-length agent-options) 0))
    (set! (.-height (.-agentPalette ui)) (Math/max 1 (Math/min 8 (.-length agent-options))))
    (set! (.-content (.-agentPalette ui))
          (if (> (.-length agent-options) 0)
            (render-command-palette! agent-options (.-paletteIndex runtime)) ""))
    (set! (.-visible (.-workPalette ui)) (> (.-length work-options) 0))
    (set! (.-height (.-workPalette ui)) (Math/max 1 (Math/min 8 (.-length work-options))))
    (set! (.-content (.-workPalette ui))
          (if (> (.-length work-options) 0)
            (render-command-palette! work-options (.-paletteIndex runtime)) ""))
    (set! (.-title (.-agentsPane ui))
          (if (identical? (.-pane runtime) "agents") "Agents · active" "Agents"))
    (set! (.-title (.-workPane ui))
          (str "Work" (if (identical? (.-pane runtime) "work") " · active · " " · ")
               (text (.-id current))))
    (set! (.-borderColor (.-agentsPane ui))
          (if (identical? (.-pane runtime) "agents") "#4ade80" "#64748b"))
    (set! (.-borderColor (.-workPane ui))
          (if (identical? (.-pane runtime) "work") "#d97706" "#64748b"))
    (set! (.-activeView runtime) (text (.-id current)))
    views))

(defn bridge-agent! [runtime: Any execution-id: String role: String status: String] -> Any
  (.add (.-bridgeExecutions runtime) execution-id)
  (when (identical? role "supervisor")
    (set! (.-supervisorId runtime) execution-id)
    (set! (.-agentIndex runtime) 0))
  (set! (.-model runtime)
        (upsert-agent (.-model runtime)
                      (make-agent execution-id
                                  (if (identical? role "supervisor")
                                    "Codex supervisor"
                                    (str "Codex " (.slice execution-id 0 8)))
                                  status
                                  (if (identical? role "supervisor")
                                    "Northbridge control session"
                                    "Bridge execution"))))
  (.render runtime))

(defn record-line [line: String] -> Any
  (let [close (.indexOf line "] ")]
    (if (or (not (.startsWith line "[")) (< close 0))
      nil
      (let [rest (.slice line (+ close 2))
            space (.indexOf rest " ")
            kind (if (< space 0) rest (.slice rest 0 space))
            payload (if (< space 0) "" (.trim (.slice rest (+ space 1))))]
        (try
          {:kind kind :data (if (identical? payload "") {} (JSON/parse payload))}
          (catch Error _ nil))))))

(defn event-item-id [execution-id: String item-id: Any] -> String
  (str execution-id ":" (text item-id)))

(defn append-item-delta!
  [runtime: Any id: String kind: String title: String delta: String status: String]
  -> Any
  (let [existing (conversation-item-by-id runtime id)
        prior (if existing (text (.-body existing)) "")]
    (upsert-conversation!
     runtime
     (conversation-item id kind title (clipped (str prior delta) 6000) status))))

(defn assistant-message-text [data: Any] -> String
  (let [message (.-message data)
        content (if message (.-content message) nil)]
    (if (Array/isArray content)
      (.join
       (.filter
        (.map content (fn [part: Any] -> String (text (.-text part))))
        (fn [part: String] -> Bool (not (identical? part ""))))
       "\n")
      (text (or (.-text data) (.-result data))))))

(defn handle-codex-event!
  [runtime: Any stream-state: Any data: Any]
  -> Any
  (let [method (text (.-method data))
        params (or (.-params data) {})
        execution-id (text (.-executionId stream-state))]
    (cond
      (identical? method "turn/started")
      (do (set-working! runtime true "Codex is working")
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id (text (.-role stream-state)) "working")))

      (identical? method "item/started")
      (let [item (.-item params)
            kind (if item (text (.-type item)) "")
            id (event-item-id execution-id (if item (.-id item) "item"))]
        (cond
          (identical? kind "commandExecution")
          (upsert-conversation!
           runtime
           (conversation-item id "command" (clean-text (.-command item)) "" "running"))

          (identical? kind "mcpToolCall")
          (upsert-conversation!
           runtime
           (conversation-item id "tool"
                              (str "Called " (text (.-server item)) "." (text (.-tool item)))
                              (safe-json (.-arguments item)) "running"))

          (identical? kind "fileChange")
          (upsert-conversation!
           runtime (conversation-item id "change" "Editing files" "" "running"))

          :else nil))

      (identical? method "item/commandExecution/outputDelta")
      (append-item-delta! runtime
                          (event-item-id execution-id (.-itemId params))
                          "command" "command" (text (.-delta params)) "running")

      (identical? method "item/agentMessage/delta")
      (when (not (.-booting stream-state))
        (append-item-delta! runtime
                            (event-item-id execution-id (.-itemId params))
                            "assistant" "" (text (.-delta params)) "running"))

      (or (identical? method "item/reasoning/summaryTextDelta")
          (identical? method "item/plan/delta"))
      (append-item-delta! runtime
                          (event-item-id execution-id (.-itemId params))
                          "thought" "" (text (.-delta params)) "running")

      (identical? method "item/fileChange/outputDelta")
      (append-item-delta! runtime
                          (event-item-id execution-id (.-itemId params))
                          "change" "Editing files" (text (.-delta params)) "running")

      (identical? method "item/mcpToolCall/progress")
      (append-item-delta! runtime
                          (event-item-id execution-id (.-itemId params))
                          "tool" "Tool activity" (text (.-message params)) "running")

      (identical? method "item/completed")
      (let [item (.-item params)
            kind (if item (text (.-type item)) "")
            id (event-item-id execution-id (if item (.-id item) "item"))]
        (cond
          (identical? kind "commandExecution")
          (upsert-conversation!
           runtime
           (conversation-item id "command" (clean-text (.-command item))
                              (clipped (.-aggregatedOutput item) 6000)
                              (if (and (identical? (text (.-status item)) "completed")
                                       (identical? (.-exitCode item) 0))
                                "done" "failed")))

          (identical? kind "agentMessage")
          (let [body (clean-text (.-text item))]
            (set! (.-lastAssistantText runtime) body)
            (when (not (.-booting stream-state))
              (upsert-conversation!
               runtime (conversation-item id "assistant" "" body "done"))))

          (identical? kind "mcpToolCall")
          (upsert-conversation!
           runtime
           (conversation-item id "tool"
                              (str "Called " (text (.-server item)) "." (text (.-tool item)))
                              (clipped (safe-json (.-result item)) 6000)
                              (if (identical? (text (.-status item)) "failed") "failed" "done")))

          (identical? kind "fileChange")
          (upsert-conversation!
           runtime
           (conversation-item id "change" "Edited files"
                              (clipped (safe-json (.-changes item)) 6000)
                              (if (identical? (text (.-status item)) "failed") "failed" "done")))

          (or (identical? kind "webSearch") (identical? kind "todoList"))
          (upsert-conversation!
           runtime
           (conversation-item id "tool" kind (clipped (safe-json item) 3000) "done"))

          :else nil))

      (identical? method "turn/completed")
      (set! (.-workingLabel runtime) "Finishing")

      :else nil)))

(defn handle-record! [runtime: Any stream-state: Any record: Any] -> Any
  (let [kind (text (.-kind record))
        data (or (.-data record) {})
        execution-id (text (.-executionId stream-state))]
    (cond
      (identical? kind "provider.starting")
      (when (not (identical? execution-id ""))
        (bridge-agent! runtime execution-id (text (.-role stream-state)) "starting"))

      (identical? kind "provider.codex.event")
      (handle-codex-event! runtime stream-state data)

      (identical? kind "provider.assistant")
      (let [body (assistant-message-text data)]
        (when (and (not (.-booting stream-state))
                   (not (identical? body ""))
                   (not (identical? body (.-lastAssistantText runtime))))
          (set! (.-lastAssistantText runtime) body)
          (upsert-conversation!
           runtime
           (conversation-item (next-item-id! runtime "assistant") "assistant" "" body "done"))))

      (identical? kind "provider.result")
      (set-working! runtime false "")

      (identical? kind "session.idle")
      (do (set-working! runtime false "")
          (set! (.-booting stream-state) false)
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id (text (.-role stream-state)) "ready")))

      (or (.includes kind "failed") (.includes kind "error"))
      (do (set-working! runtime false "")
          (append-error! runtime (str kind ": " (safe-json data))))

      :else nil)))

(defn parse-bridge-stream! [runtime: Any stream-state: Any chunk: String] -> Any
  (let [lines (.split (str (.-buffer stream-state) chunk) "\n")
        remainder (.pop lines)]
    (set! (.-buffer stream-state) remainder)
    (.forEach
     lines
     (fn [raw-line: String] -> Any
       (let [line (.trim raw-line)]
         (cond
           (.startsWith line "execution ")
           (let [execution-id (.trim (.slice line 10))]
             (set! (.-executionId stream-state) execution-id)
             (bridge-agent! runtime execution-id (text (.-role stream-state)) "starting"))

           (.startsWith line "[")
           (let [record (record-line line)]
             (when record (handle-record! runtime stream-state record)))

           (.startsWith line "north bridge:")
           (append-error! runtime line)

           :else nil))))))

(defn launch-agent! [runtime: Any prompt: String role: String] -> (Promise Any)
  (when (identical? (.trim prompt) "")
    (throw (Error. "launch requires a prompt")))
  (when (not (identical? role "supervisor"))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "user") "user" "" (.trim prompt) "done")))
  (set-working! runtime true "Starting Codex")
  (let [stream-state {:buffer "" :stderr "" :executionId "" :role role
                      :booting (identical? role "supervisor")}
        exit-code
        (js/await
         (stream-command
          [NORTH-BIN "bridge" prompt]
          (fn [chunk: String] -> Any
            (parse-bridge-stream! runtime stream-state chunk))
          (fn [chunk: String] -> Any
            (set! (.-stderr stream-state)
                  (clipped (str (.-stderr stream-state) chunk) 6000)))))]
    (when (not (identical? exit-code 0))
      (set-working! runtime false "")
      (append-error! runtime
                     (str "Bridge exited " exit-code
                          (if (identical? (.trim (text (.-stderr stream-state))) "") ""
                            (str "\n" (.trim (text (.-stderr stream-state))))))))))

(defn popout! [runtime: Any view-id: String] -> Any
  (let [ghostty (.which Bun "ghostty")
        kitty (.which Bun "kitty")
        wezterm (.which Bun "wezterm")
        foot (.which Bun "foot")
        xterm (.which Bun "xterm")
        argv (cond
               ghostty [ghostty "-e" NORTH-BIN "bridge" "app" "--view-id" view-id]
               kitty [kitty "--detach" NORTH-BIN "bridge" "app" "--view-id" view-id]
               wezterm [wezterm "start" "--always-new-process" "--" NORTH-BIN "bridge" "app" "--view-id" view-id]
               foot [foot NORTH-BIN "bridge" "app" "--view-id" view-id]
               xterm [xterm "-e" NORTH-BIN "bridge" "app" "--view-id" view-id]
               :else nil)]
    (when (nil? argv)
      (throw (Error. "no supported terminal found for pop-out")))
    (let [child (.spawn Bun {:cmd argv :stdin "ignore" :stdout "ignore" :stderr "ignore"})]
      (.unref child)
      (publish-line! runtime (str "opened " view-id " in a separate terminal")))))

(defn selected-work [runtime: Any selection: Any] -> Any
  (let [state (snapshot (.-model runtime))
        view-id (text (or (.-view selection) (.-activeView runtime)))
        view (selected-view state view-id)
        items (or (.-items view) [])
        index (if (nil? (.-index selection)) -1 (.-index selection))]
    (if (and (>= index 0) (< index (.-length items))) (aget items index) nil)))

(defn submit-agent! [runtime: Any input: String selection: Any] -> (Promise Any)
  (let [parsed (command input)
        name (text (.-name parsed))
        rest (text (.-rest parsed))
        target (text (or selection (.-supervisorId runtime)))]
    (cond
      (identical? name "launch") (js/await (launch-agent! runtime rest "worker"))
      (identical? name "refresh") (js/await (refresh! runtime))
      (identical? name "popout") (popout! runtime (or rest (.-activeView runtime)))
      (identical? name "help")
      (do (set! (.-showHelp runtime) (not (.-showHelp runtime))) (.render runtime))
      :else
      (do
        (when (identical? target "")
          (throw (Error. "select an agent before steering or interrupting")))
        (if (identical? name "interrupt")
          (do
            (when (not (.has (.-bridgeExecutions runtime) target))
              (throw (Error. "interrupt is available for Bridge-launched executions")))
            (js/await (run-command [NORTH-BIN "bridge" "interrupt" target]))
            (set-working! runtime false "")
            (append-system! runtime "Turn interrupted"))
          (let [message (if (identical? name "steer") rest (.trim input))]
            (when (identical? message "") (throw (Error. "steer requires input")))
            (upsert-conversation!
             runtime
             (conversation-item (next-item-id! runtime "user") "user" "" message "done"))
            (set-working! runtime true "Codex is working")
            (if (.has (.-bridgeExecutions runtime) target)
              (js/await (run-command [NORTH-BIN "bridge" "steer" target message]))
              (js/await (run-command [NORTH-BIN "steer" target message])))
            (.render runtime)))))))

(defn submit-work! [runtime: Any input: String selection: Any] -> (Promise Any)
  (let [parsed (command input)
        name (text (.-name parsed))
        rest (text (.-rest parsed))]
    (cond
      (identical? name "filter")
      (do (set! (.-model runtime) (set-filter (.-model runtime) rest)) (.render runtime))

      (identical? name "view")
      (do (set! (.-model runtime) (focus-view (.-model runtime) rest)) (.render runtime))

      (identical? name "split")
      (do (set! (.-model runtime)
                (set-layout (.-model runtime)
                                  (if (or (identical? rest "h") (identical? rest "horizontal"))
                                    "horizontal" "vertical")))
          (.render runtime))

      (identical? name "refresh") (js/await (refresh! runtime))
      (identical? name "popout") (popout! runtime (if (identical? rest "") (.-activeView runtime) rest))

      (identical? name "capture")
      (do
        (when (identical? rest "") (throw (Error. "capture requires a title")))
        (let [output (js/await (run-command [NORTH-BIN "capture" rest]))]
          (publish-line! runtime (.trim (text output))))
        (js/await (refresh! runtime)))

      (identical? name "assign")
      (let [item (selected-work runtime selection)
            words (.filter (.split rest " ") (fn [word: String] -> Bool (not (identical? (.trim word) ""))))
            current (if item (text (.-driver item)) "")
            prior (if (> (.-length words) 1) (aget words 0) current)
            next-driver (if (> (.-length words) 1) (aget words 1) (or (aget words 0) ""))
            thread-id (if item (bare (.-id item)) "")]
        (when (identical? thread-id "") (throw (Error. "select work before assigning")))
        (when (identical? prior "") (throw (Error. "unassigned work requires: /assign <prior-driver> <next-driver>")))
        (when (identical? next-driver "") (throw (Error. "assign requires a new driver")))
        (publish-line! runtime "driver reassignment is a retract-then-tell operation")
        (js/await (run-command [NORTH-BIN "retract" thread-id "driver" prior]))
        (js/await (run-command [NORTH-BIN "tell" thread-id "driver" next-driver]))
        (publish-line! runtime (str "assigned @" thread-id " to " next-driver))
        (js/await (refresh! runtime)))

      (identical? name "help")
      (publish-line! runtime "work commands: /capture <title>, /filter <text>, /assign <driver>, /view graph|kanban, /split h|v, /refresh, /popout")

      :else
      (throw (Error. "unknown work command; use /help")))))

(defn report-promise! [runtime: Any promise: Any] -> Any
  (.catch promise
          (fn [error: Any] -> Any
            (publish-line! runtime (str "error: " (error-message error))))))

(defn focus-pane! [runtime: Any ui: Any pane: String] -> Any
  (set! (.-pane runtime) pane)
  (set! (.-paletteIndex runtime) 0)
  (.focus (if (identical? pane "agents") (.-agentInput ui) (.-workInput ui)))
  (.render runtime))

(defn active-input [runtime: Any ui: Any] -> Any
  (if (identical? (.-pane runtime) "agents") (.-agentInput ui) (.-workInput ui)))

(defn active-palette-options [runtime: Any ui: Any] -> (Vec SlashCommand)
  (let [pane (text (.-pane runtime))
        input (active-input runtime ui)]
    (palette-options pane (text (.-value input)))))

(defn complete-palette! [runtime: Any ui: Any commands: (Vec SlashCommand)] -> Any
  (when (> (.-length commands) 0)
    (let [index (Math/max 0 (Math/min (.-paletteIndex runtime) (- (.-length commands) 1)))
          candidate (aget commands index)
          suffix (if (slashcommand-arguments candidate) " " "")
          input (active-input runtime ui)]
      (set! (.-value input) (str (slashcommand-name candidate) suffix))
      (.focus input)
      (.render runtime))))

(defn install-input! [runtime: Any ui: Any] -> Any
  (.on (.-agentInput ui) (.-INPUT InputRenderableEvents)
       (fn [_value: Any] -> Any
         (set! (.-paletteIndex runtime) 0)
         (.render runtime)))
  (.on (.-workInput ui) (.-INPUT InputRenderableEvents)
       (fn [_value: Any] -> Any
         (set! (.-paletteIndex runtime) 0)
         (.render runtime)))
  (.on (.-agentInput ui) (.-ENTER InputRenderableEvents)
       (fn [] -> Any
         (let [input (.trim (text (.-value (.-agentInput ui))))
               state (snapshot (.-model runtime))
               agents (or (.-agents state) [])
               selected (if (> (.-length agents) 0)
                          (text (.-id (aget agents (.-agentIndex runtime)))) "")]
           (when (not (identical? input ""))
             (set! (.-value (.-agentInput ui)) "")
             (report-promise! runtime (submit-agent! runtime input selected))))))
  (.on (.-workInput ui) (.-ENTER InputRenderableEvents)
       (fn [] -> Any
         (let [input (.trim (text (.-value (.-workInput ui))))]
           (when (not (identical? input ""))
             (set! (.-value (.-workInput ui)) "")
             (report-promise! runtime
                              (submit-work! runtime input
                                            {:view (.-activeView runtime)
                                             :index (.-workIndex runtime)})))))))

(defn install-mouse! [runtime: Any ui: Any] -> Any
  (set! (.-onMouseDown (.-agentsPane ui))
        (fn [event: Any] -> Any
          (when (identical? (.-button event) 0)
            (focus-pane! runtime ui "agents"))))
  (set! (.-onMouseDown (.-workPane ui))
        (fn [event: Any] -> Any
          (when (identical? (.-button event) 0)
            (focus-pane! runtime ui "work")))))

(defn install-keys! [runtime: Any ui: Any] -> Any
  (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key: Any] -> Any
         (let [name (.toLowerCase (text (.-name key)))
               state (snapshot (.-model runtime))
               meta (or (.-meta key) (.-option key))
               palette (active-palette-options runtime ui)
               palette-open (> (.-length palette) 0)]
           (cond
             (and palette-open (or (identical? name "up") (identical? name "down")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (set! (.-paletteIndex runtime)
                       (mod (+ (.-paletteIndex runtime)
                               (if (identical? name "up") -1 1)
                               (.-length palette))
                            (.-length palette))))

             (and palette-open (or (identical? name "tab") (submit-key? name)))
             (let [index (Math/max 0 (Math/min (.-paletteIndex runtime) (- (.-length palette) 1)))
                   candidate (aget palette index)
                   current (.trim (text (.-value (active-input runtime ui))))
                   exact (identical? current (slashcommand-name candidate))]
               (when (or (identical? name "tab")
                         (not exact)
                         (slashcommand-arguments candidate))
                 (.preventDefault key)
                 (.stopPropagation key)
                 (complete-palette! runtime ui palette)))

             (and palette-open (or (identical? name "escape") (identical? name "esc")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (set! (.-value (active-input runtime ui)) "")
                 (.render runtime))

             (or (identical? name "tab") (identical? name "f2"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (focus-pane! runtime ui
                              (if (identical? (.-pane runtime) "agents") "work" "agents")))

             (identical? name "f1")
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (set! (.-showHelp runtime) (not (.-showHelp runtime))))

             (or (identical? name "f3") (and meta (or (identical? name "h") (identical? name "l"))))
             (let [views (view-list state)
                   current (selected-view state (.-activeView runtime))
                   index (.findIndex views
                                     (fn [view: Any] -> Bool
                                       (identical? (.-id view) (.-id current))))
                   delta (if (and meta (identical? name "h")) -1 1)
                   next-index (mod (+ index delta (.-length views)) (.-length views))
                   next-id (text (.-id (aget views next-index)))]
               (.preventDefault key)
               (.stopPropagation key)
               (set! (.-model runtime) (focus-view (.-model runtime) next-id))
               (set! (.-workIndex runtime) 0))

             (or (identical? name "f4") (and meta (identical? name "s")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (set! (.-model runtime)
                       (set-layout (.-model runtime)
                                   (if (identical? (text (.-layout state)) "horizontal")
                                     "vertical" "horizontal"))))

             (or (identical? name "f5") (and (.-ctrl key) (identical? name "r")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (report-promise! runtime (refresh! runtime)))

             (or (identical? name "f6") (and (.-ctrl key) (identical? name "o")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (popout! runtime (.-activeView runtime)))

             (and meta (or (identical? name "j") (identical? name "k")))
             (let [delta (if (identical? name "k") -1 1)]
               (.preventDefault key)
               (.stopPropagation key)
               (if (identical? (.-pane runtime) "agents")
                 (let [agents (or (.-agents state) [])
                       max-index (Math/max 0 (- (.-length agents) 1))
                       next-index (Math/max 0 (Math/min max-index (+ (.-agentIndex runtime) delta)))
                       agent-id (if (> (.-length agents) 0)
                                  (text (.-id (aget agents next-index))) "")]
                   (set! (.-agentIndex runtime) next-index)
                   (set! (.-model runtime) (select-agent (.-model runtime) agent-id)))
                 (let [view (selected-view state (.-activeView runtime))
                       items (or (.-items view) [])
                       max-index (Math/max 0 (- (.-length items) 1))
                       next-index (Math/max 0 (Math/min max-index (+ (.-workIndex runtime) delta)))
                       thread-id (if (> (.-length items) 0)
                                   (bare (.-id (aget items next-index))) "")]
                   (set! (.-workIndex runtime) next-index)
                   (set! (.-model runtime) (select-thread (.-model runtime) thread-id)))))

             (or (identical? name "escape") (identical? name "esc"))
             (let [target (text (.-supervisorId runtime))]
               (when (and (.-working runtime) (not (identical? target "")))
                 (.preventDefault key)
                 (.stopPropagation key)
                 (report-promise! runtime
                                  (submit-agent! runtime "/interrupt" target))))

             :else nil)
           (when (not (.-disposed runtime)) (.render runtime))))))

(defn open-app! [view-id: String] -> (Promise Any)
  (let [renderer (js/await (createCliRenderer {:exitOnCtrlC false :clearOnShutdown true}))
        runtime {:model (make-model view-id)
                 :renderer renderer
                 :disposed false
                 :pane "agents"
                 :activeView (if (identical? view-id "kanban") "kanban" "graph")
                 :agentIndex 0
                 :workIndex 0
                 :bridgeExecutions (Set.)
                 :supervisorId ""
                 :conversation []
                 :itemSequence 0
                 :lastAssistantText ""
                 :working false
                 :workingLabel ""
                 :workingSince 0
                 :spinnerIndex 0
                 :spinnerTimer nil
                 :showHelp false
                 :paletteIndex 0
                 :render (fn [] -> Any nil)}
        root (BoxRenderable. renderer {:flexDirection "row" :width "100%" :height "100%" :gap 1 :padding 1})
        agents-pane (BoxRenderable. renderer {:flexDirection "column" :width "50%" :border true :title "Agents"})
        work-pane (BoxRenderable. renderer {:flexDirection "column" :width "50%" :border true :title "Work · graph"})
        agents-text (TextRenderable. renderer {:height 4 :flexShrink 0 :wrapMode "word"})
        transcript-scroll (ScrollBoxRenderable. renderer {:flexGrow 1 :scrollY true
                                                           :stickyScroll true :stickyStart "bottom"
                                                           :viewportCulling true})
        transcript-text-view (TextRenderable. renderer {:width "100%" :flexShrink 0 :wrapMode "word"})
        tabs-text-view (TextRenderable. renderer {:wrapMode "word"})
        work-text-view (TextRenderable. renderer {:flexGrow 1 :wrapMode "word"})
        status-text (TextRenderable. renderer {:wrapMode "word"})
        agent-palette (TextRenderable. renderer {:visible false :height 1 :width "100%" :flexShrink 0
                                                  :wrapMode "none" :truncate true :bg "#25272d"})
        work-palette (TextRenderable. renderer {:visible false :height 1 :width "100%" :flexShrink 0
                                                 :wrapMode "none" :truncate true :bg "#25272d"})
        agent-input (InputRenderable. renderer {:placeholder "Message Codex supervisor…"})
        work-input (InputRenderable. renderer {:placeholder "/capture, /filter, /assign, /view, /split, /popout"})
        ui {:root root :agentsPane agents-pane :workPane work-pane
            :agentsText agents-text :transcriptText transcript-text-view
            :tabsText tabs-text-view :workText work-text-view :statusText status-text
            :agentPalette agent-palette :workPalette work-palette
            :agentInput agent-input :workInput work-input}]
    (.add agents-pane agents-text)
    (.add transcript-scroll transcript-text-view)
    (.add agents-pane transcript-scroll)
    (.add agents-pane agent-palette)
    (.add agents-pane agent-input)
    (.add work-pane tabs-text-view)
    (.add work-pane work-text-view)
    (.add work-pane status-text)
    (.add work-pane work-palette)
    (.add work-pane work-input)
    (.add root agents-pane)
    (.add root work-pane)
    (.add (.-root renderer) root)
    (set! (.-render runtime) (fn [] -> Any (render-ui! runtime ui)))
    (install-input! runtime ui)
    (install-mouse! runtime ui)
    (install-global-exit! runtime)
    (install-keys! runtime ui)
    (.render runtime)
    (.focus agent-input)
    (.start renderer)
    (report-promise! runtime (refresh! runtime))
    (report-promise! runtime (launch-agent! runtime SUPERVISOR-BOOT-PROMPT "supervisor"))
    runtime))

(js/export
 (defn run-northbridge-app! [options: Any] -> (Promise Any)
   (open-app! (text (or (.-viewId options) "graph")))))
