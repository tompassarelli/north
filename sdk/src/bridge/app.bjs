(defn text [value Any] String
  (if (identical? (js/typeof value) "string") value ""))

(defn text-or
  [value Any
   fallback String] String
  (let [candidate String (text value)]
    (if (identical? candidate "") fallback candidate)))

(defn pad-right
  [value String
   width Int] String
  (.padEnd value width " "))

(defn replace-all
  [value String
   match String
   replacement String] String
  (.replaceAll value match replacement))

(defn bare [value Any] String
  (let [value-text String (text value)]
    (if (.startsWith value-text "@") (.slice value-text 1) value-text)))

(defn error-message [error Any] String
  (if (and error (identical? (js/typeof error) "object") (.-message error))
    (text (.-message error))
    (String error)))

(defn safe-json [value Any] String
  (try
    (JSON/stringify value nil 2)
    (catch Error _ (String value))))

;; The daemon refuses launches once the checkout moves under it, and it retires
;; itself the moment its last session drains. Say that, in one calm line, rather
;; than printing the wire code at someone — and name the way out, because a
;; session nobody is waiting on never drains on its own.
(defn stale-daemon-summary [live Int] String
  (if (> live 0)
    (str "control daemon is stale (" live " live session"
         (if (identical? live 1) "" "s")
         ") — /restart to replace it now, or it retires when they drain")
    "control daemon is stale — /restart to replace it now"))

(defn failure-summary [data Any] String
  (let [message String (text-or (.-message data)
                         (text-or (.-detail data)
                                  (text-or (.-classification data) (text (.-code data)))))
        causes Any (.-causes data)
        cause String (if (and causes (> (.-length causes) 0))
                (text (nth causes 0)) "")]
    (cond
      (or (.includes message "north_coordinator_preflight")
          (.includes cause "ECONNREFUSED 127.0.0.1:7977"))
      "coordinator offline — supervision unavailable; /config and /help still work"

      (identical? message "bridge_daemon_source_stale")
      (stale-daemon-summary (Number (or (.-live data) 0)))

      (identical? message "") (safe-json data)
      (identical? cause "") message
      :else (str message " — " cause))))

(defn clean-text [value Any] String
  (stripAnsiSequences (text value)))

;; Agent identity and route fields come from coordinator-owned facts, but they
;; are still terminal input. A single-line row cannot carry terminal controls
;; or create another row of its own.
(js/export
 (defn agent-field-text [value Any] String
  (.join
   (.map (Array/from (clean-text value))
         (fn [character String] String
           (let [code Any (.charCodeAt character 0)]
             (cond
               (or (identical? code 9) (identical? code 10) (identical? code 13)) " "
               (or (< code 32) (and (>= code 127) (<= code 159))) ""
               :else character))))
   "")))

(js/export
 (defn agent-cell-text!
   [value Any
    width Int] String
   (let [source String (agent-field-text value)
         limit Int (Math/max 1 width)]
     (if (<= (.stringWidth Bun source) limit)
      source
      (let [ellipsis-width Int (.stringWidth Bun "…")
            room Int (Math/max 0 (- limit ellipsis-width))
            kept (Vec Any) []
            state (Map Keyword Any) {:width 0 :done false}]
        (.forEach
         (Array/from (.segment (new IntlSegmenter "en" {:granularity "grapheme"}) source))
         (fn [part Any] Any
           (let [segment String (text (.-segment part))
                 segment-width Int (.stringWidth Bun segment)
                 state-width Int (.-width state)]
             (when (not (.-done state))
               (if (<= (+ state-width segment-width) room)
                 (do (.push kept segment)
                     (set! (.-width state) (+ state-width segment-width)))
                 (set! (.-done state) true))))))
        (str (.join kept "") "…"))))))

(defn clipped
  [value Any
   limit Int] String
  (let [clean String (clean-text value)
        clean-length Int (.-length clean)]
    (if (> clean-length limit)
      (str "…" (.slice clean (- clean-length limit)))
      clean)))

(defn next-item-id!
  [runtime Any
   prefix String] String
  (let [sequence Int (.-itemSequence runtime)]
    (set! (.-itemSequence runtime) (+ sequence 1)))
  (str prefix ":" (.-itemSequence runtime)))

(defn owned-conversation-item
  [id String
   kind String
   title String
   body String
   status String
   data Any
   execution-id String
   at String
   cursor Int
   sequence Int] ConversationItem
  (->ConversationItem id kind title body status data execution-id at cursor sequence))

(defn compare-text
  [left String
   right String] Int
  (.localeCompare left right))

(defn compare-conversation-items
  [left ConversationItem
   right ConversationItem] Int
  (let [at-order Int (compare-text (conversationitem-at left) (conversationitem-at right))
        cursor-order Int (- (conversationitem-cursor left) (conversationitem-cursor right))
        owner-order Int (compare-text (conversationitem-execution-id left)
                                  (conversationitem-execution-id right))
        sequence-order Int (- (conversationitem-sequence left)
                          (conversationitem-sequence right))]
    (cond
      (not (identical? at-order 0)) at-order
      (not (identical? cursor-order 0)) cursor-order
      (not (identical? owner-order 0)) owner-order
      (not (identical? sequence-order 0)) sequence-order
      :else (compare-text (conversationitem-id left) (conversationitem-id right)))))

(defn compare-execution-items
  [left ConversationItem
   right ConversationItem] Int
  (let [cursor-order Int (- (conversationitem-cursor left) (conversationitem-cursor right))
        sequence-order Int (- (conversationitem-sequence left)
                          (conversationitem-sequence right))]
    (cond
      (not (identical? cursor-order 0)) cursor-order
      (not (identical? sequence-order 0)) sequence-order
      :else (compare-text (conversationitem-id left) (conversationitem-id right)))))

;; The same fold serves a live stream and a replay. Arrival order is not
;; authority: control records replay before Wire, while live records interleave.
(js/export
 (defn project-conversation
   [items Any
    execution-id String
    aggregate Bool] Any
   (let [visible Any (if aggregate
                  (.slice items)
                  (.filter items
                           (fn [item ConversationItem] Bool
                             (identical? (conversationitem-execution-id item)
                                         execution-id))))]
    (.sort visible (if aggregate compare-conversation-items
                     compare-execution-items)))))

(defn runtime-selected-agent-id [runtime Any] String
  (let [agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents (snapshot (.-model runtime)))
        total Int (.-length agents)
        selected Any (Number (or (.-agentIndex runtime) 0))]
    (if (> total 0)
      (agent-id (nth agents (Math/max 0 (Math/min selected (- total 1)))))
      "")))

(defn aggregate-transcript? [runtime Any] Bool
  (identical? (text (.-transcriptView runtime)) "all"))

(defn projected-conversation [runtime Any] Any
  (project-conversation (.-conversation runtime)
                        (runtime-selected-agent-id runtime)
                        (aggregate-transcript? runtime)))

(defn transcript-working? [runtime Any] Bool
  (let [executions Any (.-workingExecutions runtime)]
    (if executions
      (if (aggregate-transcript? runtime)
        (> (.-size executions) 0)
        (.has executions (runtime-selected-agent-id runtime)))
      (if (.-working runtime) true false))))

(defn mark-execution-working!
  [runtime Any
   execution-id String
   working Bool] Any
  (let [executions Any (.-workingExecutions runtime)]
    (when (and executions (not (identical? execution-id "")))
      (if working (.add executions execution-id) (.delete executions execution-id)))))

(defn conversation-index
  [runtime Any
   id String] Int
  (.findIndex (.-conversation runtime)
              (fn [item ConversationItem] Bool
                (identical? (conversationitem-id item) id))))

(defn conversation-item-by-id
  [runtime Any
   id String] ConversationItem?
  (let [index Int (conversation-index runtime id)]
    (if (>= index 0) (nth (.-conversation runtime) index) nil)))

(defn upsert-conversation!
  [runtime Any
   item ConversationItem] Any
  (let [index Int (conversation-index runtime (conversationitem-id item))]
    (if (>= index 0)
      (.splice (.-conversation runtime) index 1 item)
      (.push (.-conversation runtime) item))
    (when (> (.-length (.-conversation runtime)) 240)
      (set! (.-conversation runtime)
            (.slice (project-conversation (.-conversation runtime) "" true) -240)))
    (.render runtime)))

(defn append-system!
  [runtime Any
   body String] Any
  (when (not (identical? (.trim body) ""))
    (let [id String (next-item-id! runtime "system")]
      (upsert-conversation!
       runtime
       (owned-conversation-item id "system" "" (.trim body) "done" nil
                                (runtime-selected-agent-id runtime)
                                (.toISOString (new Date))
                                (.-itemSequence runtime) 1)))))

(defn append-error!
  [runtime Any
   body String] Any
  (when (not (identical? (.trim body) ""))
    (let [id String (next-item-id! runtime "error")]
      (upsert-conversation!
       runtime
       (owned-conversation-item id "error" "Error" (.trim body) "failed" nil
                                (runtime-selected-agent-id runtime)
                                (.toISOString (new Date))
                                (.-itemSequence runtime) 1)))))

(defn set-working!
  [runtime Any
   working Bool
   label String] Any
  (set! (.-working runtime) working)
  (set! (.-workingLabel runtime) label)
  (if working
    (do
      (when (identical? (.-workingSince runtime) 0)
        (set! (.-workingSince runtime) (Date/now)))
      (when (nil? (.-spinnerTimer runtime))
        (let [timer Any (setInterval
               (fn [] Any
                 (when (not (.-disposed runtime))
                   (let [spinner-index Int (.-spinnerIndex runtime)]
                     (set! (.-spinnerIndex runtime) (+ spinner-index 1)))
                   (.renderConversation runtime)))
               180)]
          (set! (.-spinnerTimer runtime) timer)
          (when (.-unref timer) (.unref timer)))))
    (do
      (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
      (set! (.-spinnerTimer runtime) nil)
      (set! (.-workingSince runtime) 0)))
  (.renderConversation runtime))

(defn set-execution-working!
  [runtime Any
   execution-id String
   working Bool
   label String] Any
  (let [executions Any (.-workingExecutions runtime)]
    (mark-execution-working! runtime execution-id working)
    (if executions
      (let [any-working? Bool (> (.-size executions) 0)]
        (set-working! runtime any-working?
                      (if any-working? (text-or label (.-workingLabel runtime)) "")))
      (set-working! runtime working label))))

(defn command [input String] ParsedCommand
  (let [trimmed String (.trim input)
        normalized String (if (.startsWith trimmed "/") (.slice trimmed 1) trimmed)
        split-at Int (.indexOf normalized " ")]
    (if (< split-at 0)
      (->ParsedCommand (.toLowerCase normalized) "")
      (->ParsedCommand (.toLowerCase (.slice normalized 0 split-at))
                       (.trim (.slice normalized (+ split-at 1)))))))

;; Quit and escape are separate verbs. `/exit` is accepted as an alias without
;; taking another completion row; `/close` and `/esc` mirror the Escape key.
(js/export
 (defn quit-command? [name String] Bool
  (or (identical? name "q")
      (identical? name "exit"))))

(defn escape-command? [name String] Bool
  (or (identical? name "close")
      (identical? name "esc")))

;; One view is on screen at a time, full width, and North opens on Agents.
(def BOOT-VIEW String "agents")

(js/export
 (defn boot-view [] String BOOT-VIEW))

(def TOP-LEVEL-VIEWS (Vec String) ["agents" "goals" "all"])

(js/export
 (defn top-level-view? [view Any] Bool
  (let [candidate String (text view)]
    (.includes TOP-LEVEL-VIEWS candidate))))

(defn tracked-thing-view? [view Any] Bool
  (let [candidate String (text view)]
    (or (identical? candidate "goals")
        (identical? candidate "all"))))

;; Pure: the escape ladder. One rung per invocation, innermost first, so
;; nothing is ever closed that you could not see was open. Escape never quits;
;; at the root it spends itself on the turn in flight, or on nothing.
;; A live filter is a rung of its own, inside the panel that carries it: the
;; query is the innermost thing you opened, so it is the first thing escape
;; takes back, and the panel underneath survives one more press. Anything else
;; would make the key that clears a typo the key that closes the switchboard.
(js/export
 (defn escape-rung
   [palette-open? Bool
    filtering? Bool
    detail-open? Bool
    strip-focused? Bool
    tracked-things? Bool
    working? Bool] String
   (cond
    palette-open? "close-palette"
    filtering? "clear-filter"
    detail-open? "close-detail"
    strip-focused? "focus-composer"
    tracked-things? "show-agents"
    working? "cancel-turn"
    :else "")))

;; Pure: which surface holds the keyboard. Exactly one, always — that is the
;; whole content of a focus model, and it is what lets one key carry a different
;; verb per context without ever carrying two at once. Innermost first, the same
;; order the escape ladder climbs back out through, so "what does this key do
;; here" and "what does escape take back here" are answered off one ordering.
(js/export
 (defn active-focus
   [palette-open? Bool
    panel-open? Bool
    panel-focused? Bool
    filtering? Bool
    strip-focused? Bool] String
   (cond
    palette-open? "palette"
    (and panel-open? panel-focused? filtering?) "filter"
    (and panel-open? panel-focused?) "panel"
    strip-focused? "strip"
    :else "composer")))

;; Pure: cycle through the complete public route set.
(js/export
 (defn tab-swap-view [view String] String
  (cond
   (identical? view "agents") "goals"
   (identical? view "goals") "all"
   :else "agents")))

;; Every match, always. What fits on screen is a rendering question, answered
;; once in render-minibuffer! — never by dropping options on the floor here.
(defn emoji-options [query String] (Vec SlashCommand)
  (let [needle Any (.toLowerCase (.trim query))]
    (.filter EMOJI-COMMANDS
             (fn [candidate SlashCommand] Bool
               (or (identical? needle "")
                   (.includes
                    (.toLowerCase
                     (str (slashcommand-name candidate) " "
                          (slashcommand-description candidate)))
                    needle))))))

(defn glyph-options [query String] (Vec SlashCommand)
  (let [needle Any (.toLowerCase (.trim query))]
    (.filter GLYPH-COMMANDS
             (fn [candidate SlashCommand] Bool
               (or (identical? needle "")
                   (.includes
                    (.toLowerCase
                     (str (slashcommand-name candidate) " "
                          (slashcommand-description candidate)))
                    needle))))))

;; Which command set a slash is read against: the one belonging to the view
;; that is on screen.
(js/export
 (defn palette-options
   [view String
    input String] (Vec SlashCommand)
   (let [query Any (.toLowerCase (.trim input))
         parsed ParsedCommand (command input)
         name String (parsedcommand-name parsed)
         commands (Vec SlashCommand) (cond
                                       (identical? view "goals") GOAL-COMMANDS
                                       (identical? view "all") ALL-COMMANDS
                                       :else AGENT-COMMANDS)]
     (cond
      (not (.startsWith query "/")) []
      (identical? name "emoji") (emoji-options (parsedcommand-rest parsed))
      (or (identical? name "glyph") (identical? name "prompt"))
      (glyph-options (parsedcommand-rest parsed))
      (>= (.indexOf query " ") 0) []
      :else
      (.filter commands
               (fn [candidate SlashCommand] Bool
                 (.startsWith (slashcommand-name candidate) query)))))))

(defn submit-key? [name String] Bool
  (or (identical? name "return")
      (identical? name "enter")
      (identical? name "kpenter")
      (identical? name "linefeed")))

(defn ^:async run-command [argv (Vec String)] (Promise String)
  (let [child CommandChild (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results Any (await
                 (.all Promise [(.text (new Response (.-stdout child)))
                               (.text (new Response (.-stderr child)))
                               (.-exited child)]))
        stdout String (text (nth results 0))
        stderr String (text (nth results 1))
        exit-code Any (nth results 2)]
    (if (identical? exit-code 0)
      stdout
      (throw (new Error (str (.join argv " ") " failed (" exit-code "): "
                          (text-or (.trim stderr) (.trim stdout))))))))

(defn ^:async run-json [argv (Vec String)] (Promise Any)
  (let [output String (await (run-command argv))]
    (JSON/parse output)))

(defn ^:async discover-session-branch! [runtime Any] (Promise Any)
  (try
    (let [directory String (text (.-sessionCwd runtime))
          output String (await
                  (run-command ["git" "-C" directory "branch" "--show-current"]))
          branch String (.trim (text output))]
      (set! (.-sessionBranch runtime)
            (if (identical? branch "") "detached HEAD" branch)))
    (catch Error _
      (set! (.-sessionBranch runtime) "not a Git worktree")))
  (.render runtime))

(defn ^:async read-stream
  [stream ReadableStream
   on-chunk (Fn [String] Any)] (Promise Any)
  (let [reader StreamReader (.getReader stream)
        decoder Any (new TextDecoder)]
    (loop []
      (let [result Any (await (.read reader))]
        (when (not (.-done result))
          (on-chunk (.decode decoder (.-value result) {:stream true}))
          (recur))))))

(defn ^:async stream-command
  [argv (Vec String)
   on-stdout (Fn [String] Any)
   on-stderr (Fn [String] Any)] (Promise Int)
  (let [child CommandChild (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results Any (await
                 (.all Promise [(read-stream (.-stdout child) on-stdout)
                               (read-stream (.-stderr child) on-stderr)
                               (.-exited child)]))]
    (nth results 2)))

(js/export
 (defn normalize-agents [payload Any] (Vec Agent)
  (let [rows Any (if (and payload (Array/isArray (.-agents payload))) (.-agents payload) [])]
    (.map rows
          (fn [row Any] Agent
            (let [id String (bare (text-or (.-control_id row)
                                    (text-or (.-uuid row) (text (.-id row)))))
                  name String (text-or (.-display_handle row)
                                (text-or (.-display_name row) id))
                  status String (text-or (.-state_label row)
                                  (text-or (.-state row) "unknown"))
                  task String (text-or (.-task row) (text (.-thread_title row)))]
              (->Agent id name status task
                       (text (.-provider row))
                       (text (.-provider_target row))
                       (text (.-provider_label row))
                       (text (.-model row))
                       (text (.-model_display row))
                       (text (.-effort row))
                       (text (.-orchestration_provenance row))
                       (text (.-goal row))
                       (text (.-state row)))))))))

(defn agent-with-route
  [agent Agent
   route Agent] Agent
  (->Agent (agent-id agent)
           (agent-name agent)
           (agent-status agent)
           (agent-task agent)
           (agent-provider route)
           (agent-provider-target route)
           (agent-provider-label route)
           (agent-model route)
           (agent-model-display route)
           (agent-effort route)
           (agent-orchestration-provenance route)
           (agent-goal route)
           (agent-state route)))

(defn board-ids [board Any] (Vec String)
  (if (Array/isArray board)
    (.filter
     (.map board (fn [row Any] String (bare (.-id row))))
     (fn [id String] Bool (not (identical? id ""))))
    []))

(defn driver-of
  [facts Any
   id String] String
  (if (not (Array/isArray facts))
    ""
    (let [row Any (.find facts
                     (fn [fact Any] Bool
                       (and (identical? (text (.-predicate fact)) "driver")
                            (identical? (bare (.-subject fact)) id))))]
      (if row (bare (.-value row)) ""))))

(defn dependencies-of
  [facts Any
   id String] (Vec String)
  (if (not (Array/isArray facts))
    []
    (.map
     (.filter facts
              (fn [fact Any] Bool
                (and (identical? (text (.-predicate fact)) "depends_on")
                     (identical? (bare (.-subject fact)) id))))
     (fn [fact Any] String (bare (.-value fact))))))

(defn body-of
  [facts Any
   id String] String
  (if (not (Array/isArray facts))
    ""
    (let [row Any (.find facts
                     (fn [fact Any] Bool
                       (and (identical? (text (.-predicate fact)) "body")
                            (identical? (bare (.-subject fact)) id))))]
      (if row (text (.-value row)) ""))))

(defn normalize-work
  [board Any
   facts Any] (Vec ExecutionItem)
  (if (not (Array/isArray board))
    []
    (.map board
          (fn [row Any] ExecutionItem
            (let [id String (bare (.-id row))
                  title String (text-or (.-title row) id)
                  body String (body-of facts id)
                  condition String (text-or (.-condition row) "open")
                  driver String (driver-of facts id)
                  dependencies (Vec String) (dependencies-of facts id)]
              (->ExecutionItem id title body condition driver dependencies))))))

(defn terminal-condition? [condition String] Bool
  (or (identical? condition "terminal")
      (identical? condition "done")
      (identical? condition "completed")
      (identical? condition "failed")))

(defn list-section-id [condition String] String
  (cond
    (terminal-condition? condition) "terminal"
    (.includes ["active" "ready" "blocked" "dormant" "draft"] condition) condition
    :else "other"))

(defn list-section-title [section-id String] String
  (let [section Any (.find LIST-SECTIONS
                       (fn [candidate ListSection] Bool
                         (identical? (listsection-id candidate) section-id)))]
    (if section (listsection-title section) section-id)))

(defn list-section-count
  [items (Vec ExecutionItem)
   section-id String] Int
  (.-length
   (.filter items
            (fn [item ExecutionItem] Bool
              (identical? (list-section-id (executionitem-condition item)) section-id)))))

(defn list-rows
  [runtime Any
   items (Vec ExecutionItem)] (Vec ListRow)
  (let [rows (Vec Any) []
        collapsed Any (.-collapsedListConditions runtime)]
    (.forEach
     LIST-SECTIONS
     (fn [section ListSection] Any
       (let [section-id String (listsection-id section)
             count Int (list-section-count items section-id)]
         (when (> count 0)
           (.push rows (->ListRow "header" section-id -1 count))
           (when (not (.has collapsed section-id))
             (.forEach
              items
              (fn
                [item ExecutionItem
                 index Int] Any
                (when (identical? (list-section-id (executionitem-condition item)) section-id)
                  (.push rows (->ListRow "item" section-id index 0))))))))))
    rows))

(defn board-lane-id [condition String] String
  (cond
    (identical? condition "active") "in-progress"
    (terminal-condition? condition) "done"
    :else "not-started"))

(defn ordered-board-items
  [open-items (Vec ExecutionItem)
   done-items (Vec ExecutionItem)] (Vec ExecutionItem)
  (let [ready Any (.filter open-items
                       (fn [item ExecutionItem] Bool
                         (identical? (executionitem-condition item) "ready")))
        waiting Any (.filter open-items
                         (fn [item ExecutionItem] Bool
                           (let [condition String (executionitem-condition item)]
                             (and (not (identical? condition "ready"))
                                  (not (identical? condition "active"))))))
        active Any (.filter open-items
                        (fn [item ExecutionItem] Bool
                          (identical? (executionitem-condition item) "active")))]
    (.concat ready waiting active done-items)))

(defn publish-line!
  [runtime Any
   line String] Any
  (when (and (not (.-disposed runtime))
             (not (identical? (.trim line) "")))
    (append-system! runtime line)))

(defn grapheme-count [value String] Int
  (.-length
   (Array/from
    (.segment (new IntlSegmenter "en" {:granularity "grapheme"}) value))))

(defn current-prompt-glyph [runtime Any] String
  (let [glyph String (text (.-promptGlyph runtime))]
    (if (identical? glyph "") DEFAULT-PROMPT-GLYPH glyph)))

(defn render-prompt!
  [runtime Any
   prompt Any] Any
  (let [glyph String (current-prompt-glyph runtime)
        glyph-width Int (.stringWidth Bun glyph)]
    (set! (.-width prompt) (+ glyph-width 1))
    (set! (.-content prompt) (new StyledText [(brightCyan (str glyph " "))]))))

(defn set-prompt-glyph!
  [runtime Any
   glyph String] Any
  (when (or (identical? (.trim glyph) "")
            (not (identical? (grapheme-count glyph) 1)))
    (throw (new Error "glyph requires exactly one grapheme, or use /glyph reset")))
  (set! (.-promptGlyph runtime) glyph)
  (publish-line! runtime (str "prompt glyph set to " glyph))
  (.render runtime))

(defn sound-enabled-from-env [value String] Bool
  (let [normalized Any (.toLowerCase (.trim value))]
    (not (or (identical? normalized "0")
             (identical? normalized "false")
             (identical? normalized "off")
             (identical? normalized "no")))))

(defn sound-pack-from-env [value String] String
  (if (identical? (.toLowerCase (.trim value)) "peasant") "peasant" "peon"))

;; Derived from NORTH_HOME, never from a composed checkout path: the packaged
;; tree's purity scan rejects one, and a checkout may live anywhere.
(defn sound-directory-from-env [value String] String
  (let [directory String (.trim value)
        north-home String (.trim (text (.-NORTH_HOME (.-env process))))]
    (cond
      (not (identical? directory "")) directory
      (not (identical? north-home "")) (str north-home "/../warcraft-sounds")
      :else "warcraft-sounds")))

(defn discover-sound-player [] SoundPlayer?
  (let [mpv Any (.which Bun "mpv")
        ffplay Any (.which Bun "ffplay")
        pw-play Any (.which Bun "pw-play")]
    (cond
      mpv (->SoundPlayer "mpv" (text mpv))
      ffplay (->SoundPlayer "ffplay" (text ffplay))
      pw-play (->SoundPlayer "pw-play" (text pw-play))
      :else nil)))

(defn sound-warning!
  [runtime Any
   message String] Any
  (when (and (not (.-disposed runtime))
             (not (.-soundWarningShown runtime)))
    (set! (.-soundWarningShown runtime) true)
    (publish-line! runtime (str "sound warning: " message))))

(defn sound-path
  [directory String
   filename String] String
  (str directory (if (.endsWith directory "/") "" "/") filename))

(defn sound-argv
  [player SoundPlayer
   path String] (Vec String)
  (let [executable String (soundplayer-path player)]
    (cond
      (identical? (soundplayer-kind player) "mpv")
      [executable "--no-video" "--really-quiet" path]

      (identical? (soundplayer-kind player) "ffplay")
      [executable "-nodisp" "-autoexit" "-loglevel" "quiet" path]

      :else [executable path])))

(defn spawn-sound!
  [runtime Any
   path String] Any
  (try
    (let [player Any (.-soundPlayer runtime)]
      (if (nil? player)
        (sound-warning! runtime "install mpv, ffplay, or pw-play to play local assets")
        (let [child Any (.spawn Bun {:cmd (sound-argv player path)
                                 :stdin "ignore" :stdout "ignore" :stderr "ignore"})]
          (.add (.-soundChildren runtime) child)
          (.unref child)
          (.catch
           (.then (.-exited child)
                  (fn [exit-code Any] Any
                    (.delete (.-soundChildren runtime) child)
                    (when (not (identical? exit-code 0))
                      (sound-warning! runtime (str "player exited " exit-code " for " path)))))
           (fn [error Any] Any
             (.delete (.-soundChildren runtime) child)
             (sound-warning! runtime (error-message error)))))))
    (catch Error error
      (sound-warning! runtime (error-message error)))))

(defn play-sound-path!
  [runtime Any
   path String] Any
  (try
    (.catch
     (.then (.exists (.file Bun path))
            (fn [exists Any] Any
              (if (and exists (.-soundEnabled runtime) (not (.-disposed runtime)))
                (spawn-sound! runtime path)
                (when (and (not exists) (.-soundEnabled runtime))
                  (sound-warning! runtime (str "missing local asset " path))))))
     (fn [error Any] Any
       (sound-warning! runtime (error-message error))))
    (catch Error error
      (sound-warning! runtime (error-message error)))))

(defn select-sound-path!
  [runtime Any
   event String] String
  (let [pack SoundPack (if (identical? (text (.-soundPack runtime)) "peasant")
               PEASANT-SOUND-PACK PEON-SOUND-PACK)
        files (Vec String) (cond
                (identical? event "ready") (soundpack-ready pack)
                (identical? event "done") (soundpack-done pack)
                (identical? event "interrupted") (soundpack-interrupted pack)
                (identical? event "failed") (soundpack-failed pack)
                :else [])
        count Int (.-length files)]
    (if (identical? count 0)
      ""
      (let [base-index Int (mod (.-soundSequence runtime) count)
            base-file String (text (nth files base-index))
            base-path String (sound-path (text (.-soundDirectory runtime)) base-file)
            index Int (if (and (> count 1)
                           (identical? base-path (text (.-lastSoundPath runtime))))
                    (mod (+ base-index 1) count)
                    base-index)
            path String (sound-path (text (.-soundDirectory runtime))
                             (text (nth files index)))
            sound-sequence Int (.-soundSequence runtime)]
        (set! (.-soundSequence runtime) (+ sound-sequence 1))
        (set! (.-lastSoundPath runtime) path)
        path))))

(defn play-sound-event!
  [runtime Any
   stream-state Any
   event String] Any
  (let [now Int (Date/now)
        last-sound-at Number (.-lastSoundAt runtime)]
    (when (and (.-soundEnabled runtime)
               (.-soundLive stream-state)
               (>= (- now last-sound-at) SOUND-COOLDOWN-MS))
      (let [path String (select-sound-path! runtime event)]
        (when (not (identical? path ""))
          (set! (.-lastSoundAt runtime) now)
          (play-sound-path! runtime path))))))

(defn sound-status [runtime Any] String
  (let [player Any (.-soundPlayer runtime)]
    (str "sound " (if (.-soundEnabled runtime) "on" "off")
         " · pack " (text (.-soundPack runtime))
         " · player " (if player (soundplayer-kind player) "none")
         " · " (text (.-soundDirectory runtime)))))

;; The first four fields keep the panel's small row vocabulary; every remaining
;; field is copied from the resolved activation generation. `state` is the
;; unit's own permission, while `active` is authority-resolved and is never
;; recomputed by Bridge.
(defrecord ConfigEntry
  [kind String
   name String
   state String
   detail String
   title String
   active Bool
   owner String
   members Any
   supports Any
   distributions Any
   activationPaths Any])

(defn config-permission-on? [state String] Bool
  (identical? state "on"))

(defn config-entry-members [entry Any] Any
  (let [members Any (.-members entry)]
    (if (Array/isArray members) members [])))

;; UnitId is globally unique across the three activation kinds, so references
;; never need a directory or source-path alias.
(js/export
 (defn config-reference-text
   [kind String
    name String] String
   (str "@" kind ":" name " ")))

;; UnitId is the lookup key across every kind.
(defn config-find-entry
  [entries Any
   name String] Any
  (.find entries
         (fn [entry Any] Bool
           (identical? (configentry-name entry) name))))

;; Activity is already resolved by North and is never recomputed in Bridge.
(js/export
 (defn config-entry-active? [entry Any] Bool
   (if (.-active entry) true false)))

;; Pure: the same question asked by name, for callers holding a companion or a
;; roster entry rather than a row. A name the generation does not carry is not an
;; active unit.
(js/export
 (defn config-unit-active?
   [entries Any
    name String] Bool
   (let [entry Any (config-find-entry entries name)]
    (if entry (config-entry-active? entry) false))))

;; Ordinary rows present the authority-resolved answer. Stored permission and
;; activation provenance stay available to the module inspector.
(js/export
 (defn config-state-text [entry Any] String
   (if (config-entry-active? entry) "on" "off")))

;; Pure: which CLI verb a space on this row means. The verb follows the answer
;; the row displays, so an inactive unit whose stored permission is already on
;; is never silently pinned off when the operator asks to move it toward on.
(js/export
 (defn config-toggle-verb [resolved String] String
  (if (identical? resolved "on") "off" "on")))

;; Views are projections of the one ordered activation-unit list.
(js/export
 (defn config-view-includes?
   [view String
    kind String
    _name String] Bool
   (cond
    (identical? view "all") true
    :else (identical? kind view))))

(js/export
 (defn config-row-role
   [entry Any
    _rows Any] String
   (configentry-kind entry)))

;; Section order follows the labels operators read: Hooks, Modules, Skills.
(defn config-section-rank [role String] Int
  (cond
    (identical? role "hook") 0
    (identical? role "module") 1
    (identical? role "skill") 2
    :else 10))

(defn config-tree-rows [entries Any] Any
  (.sort (.slice entries)
         (fn
           [a Any
            b Any] Int
           (let [section-order Int (- (config-section-rank (config-row-role a entries))
                    (config-section-rank (config-row-role b entries)))]
             (if (not (identical? section-order 0))
               section-order
               (compare-text (configentry-name a) (configentry-name b)))))))

;; The selected generation owns activity; Bridge owns deterministic presentation.
(js/export
 (defn config-view-rows
   [entries Any
    view String] Any
   (config-tree-rows
    (.filter entries
             (fn [entry Any] Bool
               (config-view-includes? view
                                      (configentry-kind entry)
                                      (configentry-name entry)))))))

;; ---------------------------------------------------------------------------
;; The live filter. `/` inside an open panel narrows its rows as you type; the
;; rows that survive are what the cursor walks, what space flips and what enter
;; edits, so a filtered panel is a smaller panel and not a different surface.
;; ---------------------------------------------------------------------------

;; Search the unit's stable identity and authority-owned presentation fields.
(js/export
 (defn config-row-search-text [entry Any] String
  (let [kind String (configentry-kind entry)
        name String (configentry-name entry)]
    (.toLowerCase (str kind " " name " "
                       (configentry-title entry) " "
                       (configentry-detail entry) " "
                       (configentry-owner entry))))))

;; Pure: case-insensitive substring, and an empty query matches everything —
;; entering filter mode must not blank the panel before a character is typed.
(js/export
 (defn config-row-matches?
   [entry Any
    query String] Bool
   (let [needle Any (.toLowerCase (.trim query))]
    (or (identical? needle "")
        (.includes (config-row-search-text entry) needle)))))

;; Filtering never re-resolves composition; it narrows the rows already emitted
;; by the immutable activation generation.
(js/export
 (defn config-query-rows
   [entries Any
    query String] Any
   (if (identical? (.trim query) "")
     entries
     (.filter entries
              (fn [entry Any] Bool
                (config-row-matches? entry query))))))

(js/export
 (defn config-row-context-only?
   [_entry Any
    _query String] Bool
   false))

(def ACTIVATION-SCHEMA String "north.agent-activation/v1")

(js/export
 (defn config-activation-path-from
   [runtime Any
    environment Any] String
   (let [state-root String (text-or (text (.-NORTH_AGENT_STATE_ROOT environment))
                   (str (text (.-HOME environment))
                        "/.local/state/north/agents"))]
     (text-or (text (.-configActivationPath runtime))
              (str state-root "/current/activation.json")))))

(js/export
 (defn config-activation-path [runtime Any] String
   (config-activation-path-from runtime (.-env process))))

(defn config-array [value Any] Any
  (if (Array/isArray value) value []))

(defn config-owner-text [owner Any] String
  (cond
    (identical? (js/typeof owner) "string") (text owner)
    (and owner (identical? (js/typeof owner) "object"))
    (let [repo String (text (.-repo owner))
          path String (text (.-path owner))]
      (cond
        (and (not (identical? repo "")) (not (identical? path "")))
        (str repo ":" path)
        (not (identical? repo "")) repo
        :else path))
    :else ""))

(defn config-unit-entry [unit Any] Any
  (->ConfigEntry
   (text (.-kind unit))
   (text (.-id unit))
   (text-or (text (.-permission unit)) "default")
   (text (.-triggerDescription unit))
   (text-or (text (.-title unit)) (text (.-id unit)))
   (if (.-active unit) true false)
   (config-owner-text (.-owner unit))
   (config-array (.-members unit))
   (config-array (.-supports unit))
   (config-array (.-distributions unit))
   (config-array (.-activationPaths unit))))

;; The selected immutable generation is the adapter seam. Rejecting every
;; other schema before exposing a row keeps Bridge from silently inventing a
;; legacy interpretation of authority-owned activity.
(js/export
 (defn config-activation-of-json [content String] Any
   (let [parsed Any (JSON/parse content)
         schema String (text (.-schema parsed))
         units Any (.-units parsed)]
     (when (not (identical? schema ACTIVATION-SCHEMA))
       (throw (new Error
               (str "unsupported activation schema: "
                    (text-or schema "missing")))))
     (when (not (Array/isArray units))
       (throw (new Error "activation generation has no ordered units")))
     (let [invalid Any (.find units
                   (fn [unit Any] Bool
                     (let [kind String (text (.-kind unit))]
                       (not (or (identical? kind "module")
                                (identical? kind "skill")
                                (identical? kind "hook"))))))]
       (when invalid
         (throw (new Error
                     (str "activation generation has invalid unit kind: "
                          (text-or (text (.-kind invalid)) "missing"))))))
     {:schema schema
      :digest (text (.-catalogDigest parsed))
      :generation (text (.-generationId parsed))
      :units (.map units config-unit-entry)})))

;; Filter mode is a state of the open panel, not of the generation: the query and
;; the mode are separate facts because `/` with nothing typed yet is already
;; filtering — the field is on screen and the next keystroke goes into it.
(defn panel-filtering? [runtime Any] Bool
  (if (.-panelFiltering runtime) true false))

(defn panel-query [runtime Any] String
  (if (panel-filtering? runtime) (text (.-panelQuery runtime)) ""))

;; The filtered rows are the rows the cursor walks and the toggle mutates.
(js/export
 (defn config-panel-rows [runtime Any] Any
  (let [stored Any (.-configEntries runtime)
        entries Any (if stored stored [])
        query String (panel-query runtime)]
    (if (not (identical? (.trim query) ""))
      (config-query-rows entries query)
      entries))))

;; The cursor belongs to the filtered list, so every change to the query drags
;; it back inside. A query that empties the panel parks it at zero rather than
;; at minus one.
(js/export
 (defn clamp-panel-cursor! [runtime Any] Any
  (let [total Int (.-length (config-panel-rows runtime))
        raw Any (.-configIndex runtime)
        current Int (if raw raw 0)]
    (set! (.-configIndex runtime)
          (if (> total 0) (Math/max 0 (Math/min current (- total 1))) 0)))))

(js/export
 (defn set-panel-query!
   [runtime Any
    query String] Any
   (set! (.-panelFiltering runtime) true)
  (set! (.-panelQuery runtime) query)
  (clamp-panel-cursor! runtime)))

(js/export
 (defn clear-panel-filter! [runtime Any] Any
  (set! (.-panelFiltering runtime) false)
  (set! (.-panelQuery runtime) "")
  (clamp-panel-cursor! runtime)))

(defn ^:async load-config-entries! [runtime Any] (Promise Any)
  (try
    (let [file ResponseValue (.file Bun (config-activation-path runtime))
          content String (await (.text file))
          activation Any (config-activation-of-json content)
          all-entries Any (.-units activation)
          config-filter String (text-or (text (.-configFilter runtime)) "all")
          entries Any (config-view-rows all-entries config-filter)]
      (set! (.-configDiagnostic runtime) "")
      (set! (.-configGeneration runtime) (.-generation activation))
      (set! (.-configDigest runtime) (.-digest activation))
      (set! (.-configAllEntries runtime) all-entries)
      (set! (.-configEntries runtime) entries))
    (catch Error error
      (set! (.-configAllEntries runtime) [])
      (set! (.-configEntries runtime) [])
      (set! (.-configDiagnostic runtime)
            (str "activation unavailable — " (error-message error)))))
  (clamp-panel-cursor! runtime)
  (set! (.-configLoaded runtime) true)
  (.render runtime))

;; An open panel holds the keyboard. The strip already works this way and for
;; the same reason: a surface with a cursor in it must not share the keys with a
;; text field, or `/` means two things at once and the operator finds out which
;; by accident. The composer keeps its content — it only loses the cursor.
(defn focus-panel!
  [runtime Any
   ui Any] Any
  (set! (.-panelFocused runtime) true)
  (.blur (.-composerInput ui)))

(defn focus-composer!
  [runtime Any
   ui Any] Any
  (set! (.-panelFocused runtime) false)
  (.focus (.-composerInput ui)))

;; Missing means focused: a panel is opened by asking for it, so the only way to
;; be looking at one you are not driving is to have handed the keyboard back on
;; purpose.
(defn panel-focused? [runtime Any] Bool
  (and (detail-open? runtime)
       (not (identical? (.-panelFocused runtime) false))))

(defn open-config-panel!
  [runtime Any
   ui Any
   config-filter String] Any
  (let [already Any (and (detail-showing? runtime "config")
                     (identical? (text (.-configFilter runtime)) config-filter))]
    (if already
      (do (close-detail! runtime) (focus-composer! runtime ui))
      (do
        (focus-panel! runtime ui)
        (set! (.-configFilter runtime) config-filter)
        (set! (.-configIndex runtime) 0)
        (set! (.-configLoaded runtime) false)
        ;; A query belongs to the view it was typed in. Switching views carries
        ;; no filter across, and neither does closing and reopening one.
        (clear-panel-filter! runtime)
        (open-detail! runtime "config")
        (report-promise! runtime (load-config-entries! runtime))))
    (.render runtime)))

(defn ^:async edit-config-entry! [runtime Any] (Promise Any)
  (let [entries Any (config-panel-rows runtime)]
    (when (> (.-length entries) 0)
      (let [entry-count Int (.-length entries)
            raw Any (.-configIndex runtime)
            index Int (Math/max 0 (Math/min (if raw raw 0)
                                              (- entry-count 1)))
            entry Any (nth entries index)]
        (when (identical? (configentry-kind entry) "module")
          (set! (.-configInspectId runtime)
                (if (identical? (text (.-configInspectId runtime))
                                (configentry-name entry))
                  ""
                  (configentry-name entry))))))))

(defn ^:async toggle-config-entry! [runtime Any] (Promise Any)
  (let [entries Any (config-panel-rows runtime)]
    (when (> (.-length entries) 0)
      (let [entry-count Int (.-length entries)
            raw Any (.-configIndex runtime)
            index Int (Math/max 0 (Math/min (if raw raw 0)
                                              (- entry-count 1)))
            entry Any (nth entries index)
            verb String (config-toggle-verb (config-state-text entry))]
        (await (run-command [(north-bin) "config" "agents" verb
                            (configentry-name entry)]))
        ;; Reload the authority-owned generation rather than patching one row:
        ;; one permission change can alter every reachable member and supporting
        ;; hook in the resolved module graph.
        (await (load-config-entries! runtime))
        (.render runtime)))))

(defn handle-sound-command!
  [runtime Any
   rest String] Any
  (let [request Any (.toLowerCase (.trim rest))]
    (cond
      (or (identical? request "") (identical? request "status"))
      (publish-line! runtime (sound-status runtime))

      (identical? request "on")
      (do (set! (.-soundEnabled runtime) true)
          (publish-line! runtime (sound-status runtime))
          (when (nil? (.-soundPlayer runtime))
            (sound-warning! runtime "install mpv, ffplay, or pw-play to play local assets")))

      (identical? request "off")
      (do (set! (.-soundEnabled runtime) false)
          (publish-line! runtime (sound-status runtime)))

      (.startsWith request "pack ")
      (let [pack Any (.trim (.slice request 5))]
        (when (not (or (identical? pack "peon") (identical? pack "peasant")))
          (throw (new Error "sound pack must be peon or peasant")))
        (set! (.-soundPack runtime) pack)
        (publish-line! runtime (sound-status runtime)))

      :else
      (throw (new Error "sound requires on, off, status, or pack peon|peasant")))))

;; The control session that died with the daemon. Its execution id belongs to a
;; daemon that no longer exists, so it is not an agent in any state — leaving the
;; row on the roster shows a corpse beside its own successor.
(defn forget-control-session! [runtime Any] Any
  (let [id String (text (.-supervisorId runtime))]
    (when (not (identical? id ""))
      (.delete (.-bridgeExecutions runtime) id)
      (set! (.-model runtime) (remove-agent (.-model runtime) id))
      (set! (.-supervisorId runtime) "")
      (set! (.-agentIndex runtime) 0)
      (.render runtime))))

;; The deliberate replacement, in both command sets because the daemon is
;; underneath both views. A stale daemon replaces itself at the next connect
;; when nothing depends on it; this is the escape for the case where something
;; does. It happens in place: the daemon goes, the row it owned goes with it,
;; its successor comes up, and the control session reopens in this same
;; window — never a chore left on screen.
(defn ^:async restart-daemon! [runtime Any] (Promise Any)
  (try
    (await (run-command [(north-bin) "bridge" "restart"]))
    (forget-control-session! runtime)
    (if (identical? (launch-thread-id runtime "supervisor") "")
      (publish-line! runtime "control daemon replaced; select a tracked thing before /launch")
      (do
        (publish-line! runtime "control daemon replaced; session restored")
        (await (launch-agent! runtime SUPERVISOR-BOOT-PROMPT "supervisor"))))
    (catch Error error
      (append-error! runtime (error-message error)))))

(js/export
(defn handle-local-command!
  [runtime Any
   ui Any
   input String] Bool
  (let [trimmed String (.trim input)]
    (if (not (.startsWith trimmed "/"))
      false
      (let [parsed ParsedCommand (command trimmed)
            name String (parsedcommand-name parsed)
            rest String (parsedcommand-rest parsed)]
        (cond
          (or (identical? name "glyph") (identical? name "prompt"))
          (do
            (if (identical? (.toLowerCase rest) "reset")
              (set-prompt-glyph! runtime DEFAULT-PROMPT-GLYPH)
              (set-prompt-glyph! runtime rest))
            true)

          (identical? name "emoji")
          (let [options (Vec SlashCommand) (emoji-options rest)]
            (when (identical? (.-length options) 0)
              (throw (new Error (str "no emoji matches " rest))))
            (let [input-renderable Any (.-composerInput ui)]
              (set! (.-value input-renderable)
                    (slashcommand-completion (nth options 0)))
              (.focus input-renderable)
              (.render runtime))
            true)

          (identical? name "sound")
          (do (handle-sound-command! runtime rest) true)

          (identical? name "mute")
          (do (set! (.-soundEnabled runtime) false)
              (publish-line! runtime (sound-status runtime))
              true)

          (identical? name "transcript")
          (let [requested Any (.toLowerCase (.trim rest))]
            (when (not (or (identical? requested "selected")
                           (identical? requested "all")))
              (throw (new Error "transcript requires selected or all")))
            (set! (.-transcriptView runtime) requested)
            (.render runtime)
            true)

          (or (identical? name "provider")
              (identical? name "model")
              (identical? name "effort"))
          (do (set-launch-route! runtime name rest) true)

          (identical? name "config")
          (do (open-config-panel! runtime ui "all") true)

          (identical? name "hooks")
          (do (open-config-panel! runtime ui "hook") true)

          (identical? name "skills")
          (do (open-config-panel! runtime ui "skill") true)

          (identical? name "mcp")
          (do
            (let [parts Any (.filter (.split (.trim rest) #"\\s+")
                                 (fn [part String] Bool
                                   (not (identical? part ""))))]
              (.catch
               (.then
                (run-command (.concat [(north-bin) "config" "mcp"] parts))

                (fn [output String] Any
                  (publish-line! runtime (.trim output))))

               (fn [error Any] Any
                 (publish-line! runtime
                                (str "error: " (error-message error))))))
            true)

          (identical? name "modules")
          (do (open-config-panel! runtime ui "module") true)

          (identical? name "restart")
          (do (restart-daemon! runtime) true)

          ;; Public routes are a closed set. A route command never changes the
          ;; meaning of a selected identity or activates a hidden sub-view.
          (.includes TOP-LEVEL-VIEWS name)
          (do (show-view! runtime ui name) true)

          ;; One /help, both views, and it lands in the docked panel where the
          ;; escape ladder can close it.
          (identical? name "help")
          (do (toggle-help! runtime ui) true)

          ;; Quit is unconditional. Escape aliases navigate the same ladder as
          ;; the physical key and therefore never terminate North.
          (quit-command? name)
          (do (destroy! runtime) true)

          (escape-command? name)
          (do (escape-step! runtime ui) true)

          :else false))))))

(defn render-after-suspend! [runtime Any] Any
  (when (and (not (.-disposed runtime)) (.-render runtime))
    (.render runtime)))

;; Exact-listener cleanup is shared by SIGCONT, a failed stop, and teardown.
;; OpenTUI owns the terminal lifecycle; North owns only the process signal.
(js/export
 (defn cleanup-suspend!
   [runtime Any
    process-api Any] Bool
   (let [handler Any (.-suspendResume runtime)
         suspended? Bool (if (.-rendererSuspended runtime) true false)
         active? Any (or handler suspended?)]
     (when handler
      (.removeListener process-api "SIGCONT" handler))
    (set! (.-suspendResume runtime) nil)
    (set! (.-rendererSuspended runtime) false)
    (when suspended?
      (try
        (.resume (.-renderer runtime))
        (catch Error error
          (set! (.-suspendError runtime) (error-message error)))))
    (render-after-suspend! runtime)
    (if active? true false))))

;; POSIX job control stops the foreground process group, not merely this PID.
;; The continuation listener must exist before SIGSTOP because stopped code
;; cannot install its own recovery path.
(js/export
 (defn suspend-runtime!
   [runtime Any
    platform String
    process-api Any] Bool
   (if (or (identical? platform "win32") (.-suspendResume runtime))
    false
    (let [state (Map Keyword Nil) {:handler nil}
          resume (Fn [] Any) (fn [] Any
            (let [handler Any (.-handler state)]
              (when (identical? (.-suspendResume runtime) handler)
                (cleanup-suspend! runtime process-api))))]
      (set! (.-handler state) resume)
      (set! (.-suspendResume runtime) resume)
      (set! (.-suspendError runtime) "")
      (try
        (.once process-api "SIGCONT" resume)
        ;; Treat a suspend call as stateful before invoking it. If OpenTUI
        ;; throws after touching the terminal, the catch path must still call
        ;; resume rather than assume nothing changed.
        (set! (.-rendererSuspended runtime) true)
        (.suspend (.-renderer runtime))
        (.kill process-api 0 "SIGSTOP")
        true
        (catch Error error
          (set! (.-suspendError runtime) (error-message error))
          (cleanup-suspend! runtime process-api)
          false))))))

(defn quiesce! [runtime Any] Any
  (when (not (.-disposed runtime))
    (set! (.-disposed runtime) true)
    (cleanup-suspend! runtime process)
    (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
    (set! (.-spinnerTimer runtime) nil)
    (.forEach (.-soundChildren runtime)
              (fn [child Any] Any
                (try (.kill child) (catch Error _ nil))))
    (.clear (.-soundChildren runtime))))

(defn destroy! [runtime Any] Any
  (when (not (.-disposed runtime))
    (quiesce! runtime)
    (.destroy (.-renderer runtime))
    (.exit process 0)))

(defn install-process-cleanup! [runtime Any] Any
  (doseq [signal ["SIGINT" "SIGTERM" "SIGHUP"]]
    ;; Run before OpenTUI's shutdown listener so late provider/timer callbacks
    ;; see a quiesced runtime before its renderables are destroyed.
    (.prependOnceListener process signal
                          (fn [] Any (quiesce! runtime)))))

(defn install-global-exit! [runtime Any] Any
  (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key Any] Any
         (let [name String (text (.-name key))]
           (cond
             (and (.-ctrl key) (identical? name "z"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (suspend-runtime! runtime (text (.-platform process)) process))

             (and (.-ctrl key) (identical? name "q"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (destroy! runtime))

             :else nil)))))

;; The index is presentation state; the ID is identity. Every roster mutation
;; resolves the old identity in the new ordering before the composer can use
;; the index again.
(js/export
 (defn selected-agent-id
   [state BridgeSnapshot
    selected Int] String
   (let [agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents state)
         total Int (.-length agents)]
     (if (> total 0)
      (agent-id (nth agents (Math/max 0 (Math/min selected (- total 1)))))
      ""))))

(defn selected-semantic-agent-id
  [state BridgeSnapshot
   selected Int] String
  (let [agents Any (bridgesnapshot-semantic-agents state)
        total Int (.-length agents)]
    (if (> total 0)
      (trackedthing-id
       (nth agents (Math/max 0 (Math/min selected (- total 1)))))
      "")))

(js/export
 (defn reconcile-agent-selection!
   [runtime Any
    prior-id String] String
   (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
         agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents state)
         total Int (.-length agents)
         found Any (.findIndex agents
                          (fn [agent Agent] Bool
                            (identical? (agent-id agent) prior-id)))
         fallback Int (Math/max 0
                           (Math/min (.-agentIndex runtime)
                                     (Math/max 0 (- total 1))))
         index Any (if (>= found 0) found fallback)
         selected String (if (> total 0) (agent-id (nth agents index)) "")]
     (set! (.-agentIndex runtime) index)
    (when (not (identical? (bridgesnapshot-selected-agent state) selected))
      (set! (.-model runtime) (select-agent (.-model runtime) selected)))
    selected)))

(js/export
 (defn ^:async refresh! [runtime Any] (Promise Any)
  (let [request Any (referent-action-request! "catalog" [])
        catalog Any (await
                     (run-referent-action!
                      request
                      {:northExecutable (north-bin)
                       :runCommand run-command}))
        state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
        selected-id String (bridgesnapshot-selected-tracked-thing state)
        next-model north.bridge.model/BridgeModel (replace-catalog (.-model runtime)
                         (.-trackedThings catalog)
                         (.-storeSpace catalog)
                         (.-storeVersion catalog))
        next-state north.bridge.model/BridgeSnapshot (snapshot next-model)
        view String (text (.-view runtime))
        next-items Any (cond
                         (identical? view "agents")
                         (bridgesnapshot-semantic-agents next-state)
                         (identical? view "goals")
                         (bridgesnapshot-goals next-state)
                         :else
                         (bridgesnapshot-all next-state))
        next-index Int (.findIndex next-items
                         (fn [item TrackedThing] Bool
                           (identical? (trackedthing-id item) selected-id)))]
    (set! (.-model runtime) next-model)
    (set! (.-workIndex runtime) (if (>= next-index 0) next-index 0))
    (.render runtime))))

(defn canonical-top-level-view [view-id String] String
  (if (top-level-view? view-id) view-id BOOT-VIEW))

(js/export
 (defn view-list [state BridgeSnapshot] (Vec WorkView)
  [(->WorkView "agents" "Agents" (bridgesnapshot-semantic-agents state))
   (->WorkView "goals" "Goals" (bridgesnapshot-goals state))
   (->WorkView "all" "All" (bridgesnapshot-all state))]))

(defn selected-view
  [state BridgeSnapshot
   view-id String] WorkView
  (let [views (Vec WorkView) (view-list state)
        canonical String (canonical-top-level-view view-id)
        selected Any (.find views
                        (fn [view WorkView] Bool
                          (identical? (workview-id view) canonical)))]
    (or selected (nth views 0))))

;; Pure: is this the roster row the banner is already saying? The banner states
;; the control session's revision, model, directory and permissions, and the
;; roster row one line above it states that same session's name and status —
;; with the banner up, the row is the duplicate, and the row is what goes. It
;; comes back with its status the moment the banner does not own the screen any
;; more. Only the control session is ever suppressed; every other agent's row is
;; the only place its status appears.
(js/export
 (defn roster-row-suppressed?
   [agent-id String
    supervisor-id String
    banner? Bool] Bool
   (and banner?
       (not (identical? supervisor-id ""))
       (identical? agent-id supervisor-id))))

(js/export
 (defn roster-text!
   [state BridgeSnapshot
    selected Int
    supervisor-id String
    banner? Bool] String
   (let [agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents state)
         width Int (Math/max 1 (- (terminal-columns) 6))
         rows Any (.filter
              (.map agents
                    (fn
                      [agent Agent
                       index Int] Any
                      {:id (agent-id agent)
                       :text (agent-row-text! agent
                                             (identical? index selected)
                                             width)}))
              (fn [row Any] Bool
                (not (roster-row-suppressed? (.-id row) supervisor-id banner?))))]
     (cond
      (identical? (.-length agents) 0) "No agents attached"
      ;; Everything the roster had to show is what the banner is showing. The
      ;; pane says nothing rather than reporting "no agents" about a session
      ;; that is plainly on the screen underneath.
      (identical? (.-length rows) 0) ""
      :else (.join (.map rows (fn [row Any] String (.-text row))) "\n")))))

;; The roster used to reserve four rows even when the banner suppressed its
;; only row. On a short terminal that left the welcome card with no viewport at
;; all. Give the roster exactly the rows it actually draws; zero means it leaves
;; the layout entirely while the banner owns the empty session.
(js/export
 (defn roster-visible-rows [content Any] Int
  (let [value String (.trim (text content))]
    (if (identical? value "")
      0
      (Math/min 4 (.-length (.split value "\n")))))))

(defn agent-display-name [agent Agent] String
  (let [name String (agent-field-text (agent-name agent))]
    (if (identical? name "") (agent-field-text (agent-id agent)) name)))

(defn agent-summary [agent Agent] String
  (let [status String (agent-field-text (agent-status agent))
        task String (agent-field-text (agent-task agent))]
    (str (agent-display-name agent)
         (if (identical? status "") "" (str " (" status ")"))
         (if (identical? task "") "" (str " — " task)))))

(js/export
 (defn agent-row-text!
   [agent Agent
    selected? Bool
    width Int] String
   (let [prefix String (if selected? "› " "  ")
         prefix-width Int (.stringWidth Bun prefix)]
     (str prefix (agent-cell-text! (agent-summary agent)
                                 (Math/max 1 (- width prefix-width)))))))

(defn route-provider [agent Agent] String
  (let [label String (agent-field-text (agent-provider-label agent))
        provider String (agent-field-text (agent-provider agent))
        target String (agent-field-text (agent-provider-target agent))]
    (cond
      (not (identical? label "")) label
      (and (not (identical? provider "")) (not (identical? target "")))
      (str provider ":" target)
      :else (text-or provider target))))

(defn route-model [agent Agent] String
  (text-or (agent-field-text (agent-model-display agent))
           (agent-field-text (agent-model agent))))

(js/export
 (defn agent-route-text!
   [agent Agent
    width Int] String
   (let [provider String (route-provider agent)
         model String (route-model agent)
         effort String (agent-field-text (agent-effort agent))
         provenance String (agent-field-text (agent-orchestration-provenance agent))
         state String (agent-field-text (agent-state agent))
         goal String (agent-field-text (agent-goal agent))
         parts Any (.filter
               [(if (identical? provider "") "" (str "provider " provider))
                (if (identical? model "") "" (str "model " model))
                (if (identical? effort "") "" (str "effort " effort))
                (if (identical? provenance "") "" provenance)
                (if (identical? state "") "" (str "state " state))
                (if (identical? goal "") "" (str "goal " goal))]
               (fn [part String] Bool (not (identical? part ""))))]
     (agent-cell-text! (.join parts " · ") width))))

;; Pure: every agent state this app can observe folded onto the strip's
;; vocabulary. Bridge-local executions report starting/working/ready/offline;
;; the agents CLI reports working/stalled/offline/inconsistent(...) and
;; finished(process:…, delivery:…). Anything unrecognized stays "other" so it
;; is counted in the total without inventing a state.
(defn agent-bucket [status String] String
  (let [value Any (.toLowerCase (.trim status))]
    (cond
      (identical? value "") "other"

      (.startsWith value "finished(")
      (if (or (.includes value "process:failed")
              (.includes value "process:error"))
        "failed" "other")

      (.startsWith value "inconsistent") "blocked"

      (or (identical? value "stalled")
          (identical? value "blocked")
          (identical? value "waiting")
          (identical? value "paused")
          (identical? value "queued")) "blocked"

      (or (identical? value "failed")
          (identical? value "error")
          (identical? value "crashed")) "failed"

      (or (identical? value "working")
          (identical? value "running")
          (identical? value "starting")
          (identical? value "ready")
          (identical? value "active")
          (identical? value "online")) "running"

      :else "other")))

(defn agents-in-bucket
  [agents (Vec Agent)
   bucket String] (Vec Agent)
  (.filter agents
           (fn [agent Agent] Bool
             (identical? (agent-bucket (agent-status agent)) bucket))))

(defn segment-agents
  [agents (Vec Agent)
   segment-id String] (Vec Agent)
  (if (identical? segment-id "all")
    agents
    (agents-in-bucket agents segment-id)))

(defn agent-total-label [total Int] String
  (str total (if (identical? total 1) " agent" " agents")))

(defn agent-segments [agents (Vec Agent)] (Vec AgentSegment)
  (let [total Int (.-length agents)
        segments (Vec AgentSegment) [(->AgentSegment "all" (agent-total-label total) total)]]
    (.forEach
     STRIP-BUCKETS
     (fn [bucket StripBucket] Any
       (let [id String (stripbucket-id bucket)
             members (Vec Agent) (agents-in-bucket agents id)
             count Int (.-length members)]
         (when (> count 0)
           (.push segments
                  (->AgentSegment id
                                  (str (stripbucket-glyph bucket) count " " id)
                                  count))))))
    segments))

;; Pure: the column each segment starts at, so a click lands on the same
;; segment the eye reads. Focus never changes a label's width.
(defn segment-columns [segments (Vec AgentSegment)] (Vec Int)
  (let [starts (Vec Any) []]
    (.forEach
     segments
     (fn
       [_segment AgentSegment
        index Int] Any
       (.push starts
              (if (identical? index 0)
                STRIP-INDENT
                (let [previous-start Int (nth starts (- index 1))
                      previous-width Int (.-length (agentsegment-label (nth segments (- index 1))))
                      separator-width Int (.-length STRIP-SEPARATOR)]
                  (+ previous-start previous-width separator-width))))))
    starts))

(defn segment-at-column
  [segments (Vec AgentSegment)
   column Int] Int
  (let [starts (Vec Int) (segment-columns segments)]
    (.findIndex starts
                (fn
                  [start Int
                   index Int] Bool
                  (let [segment-width Int (.-length (agentsegment-label (nth segments index)))]
                    (and (>= column start)
                         (< column (+ start segment-width))))))))

(defn push-chunk!
  [chunks (Vec TextChunk)
   chunk TextChunk] Any
  (.push chunks chunk))

(defn render-command-palette!
  [commands (Vec SlashCommand)
   selected Int
   more Int] Any
  (let [chunks (Vec TextChunk) []]
    (.forEach
     commands
     (fn
       [candidate SlashCommand
        index Int] Any
       (push-chunk! chunks
                    (if (identical? index selected) (brightCyan "› ") (brightBlack "  ")))
       (push-chunk! chunks
                    (if (identical? index selected)
                      (brightGreen (pad-right (slashcommand-name candidate) 13))
                      (brightWhite (pad-right (slashcommand-name candidate) 13))))
       (push-chunk! chunks (brightBlack (slashcommand-description candidate)))
       (when (< index (- (.-length commands) 1))
         (push-chunk! chunks (white "\n")))))
    ;; The list never hides anything silently: when the terminal cannot show
    ;; every match, the last row says how many are still out there.
    (when (> more 0)
      (push-chunk! chunks (white "\n"))
      (push-chunk! chunks (brightBlack (str "  … " more " more"))))
    (new StyledText chunks)))

(defn terminal-columns [] Int
  (let [stdout Any (.-stdout process)
        columns Any (if stdout (.-columns stdout) nil)]
    (Math/max 1 (if (identical? (js/typeof columns) "number") columns 120))))

(defn terminal-rows [] Int
  (let [stdout Any (.-stdout process)
        rows Any (if stdout (.-rows stdout) nil)]
    (Math/max 1 (if (identical? (js/typeof rows) "number") rows 40))))

;; One view is on screen at a time, so showing a view is one boolean per
;; container and no arithmetic at all: no ratio, no divider, no minimum.
(js/export
 (defn apply-view-visibility!
   [runtime Any
    ui Any] Any
   (let [agents? Bool (identical? (text (.-view runtime)) "agents")]
    (set! (.-visible (.-agentsPane ui)) agents?)
    (set! (.-visible (.-workPane ui)) (not agents?)))))

;; Every view is full width now, so they all measure the same.
(defn available-view-width [] Int
  (Math/max 24 (- (terminal-columns) 6)))

(defn available-agent-width [_runtime Any] Int
  (available-view-width))

(defn user-block-text
  [runtime Any
   body String] String
  (let [width Int (available-agent-width runtime)
        lines Any (.split body "\n")]
    (.join
     (.map lines
           (fn
             [line String
              index Int] String
             (let [prefix String (if (identical? index 0) "❯ " "  ")]
               (pad-right (str prefix line) width))))
     "\n")))

(defn short-directory [directory Any] String
  (let [path String (text directory)
        home String (text (.-HOME (.-env process)))]
    (if (and (not (identical? home "")) (.startsWith path home))
      (str "~" (.slice path (.-length home)))
      path)))

(defn session-context-text [runtime Any] String
  (str (text-or (.-sessionModel runtime) "model pending") " "
       (text-or (.-sessionEffort runtime) "effort pending") " · "
       (text-or (short-directory (.-sessionCwd runtime)) "directory pending") " · "
       (text-or (.-sessionBranch runtime) "branch pending")))

(defn transcript-context-text [runtime Any] String
  (let [selected String (runtime-selected-agent-id runtime)]
    (cond
      (aggregate-transcript? runtime) "all agent runs"
      (identical? selected (text (.-supervisorId runtime))) (session-context-text runtime)
      (not (identical? selected "")) (str "Agent run " (.slice selected 0 8))
      :else "Agent run pending")))

(defn command-parts [title String] CommandParts
  (let [space Int (.indexOf title " ")]
    (if (< space 0)
      (->CommandParts title "")
      (->CommandParts (.slice title 0 space)
                      (.slice title (+ space 1))))))

(defn push-command-output!
  [chunks (Vec TextChunk)
   output String] Any
  (let [trimmed Any (.trimEnd output)]
    (when (not (identical? trimmed ""))
      (let [lines Any (.split trimmed "\n")
            limit Int 8
            line-count Int (.-length lines)
            overflow Int (Math/max 0 (- line-count limit))
            visible Any (.slice lines 0 (if (> overflow 0) (- limit 1) limit))]
        (.forEach
         visible
         (fn
           [line String
            index Int] Any
           (let [visible-count Int (.-length visible)
                 last? Any (and (identical? overflow 0)
                            (identical? index (- visible-count 1)))]
             (push-chunk! chunks
                          (dim (str "\n  " (if last? "└ " "│ ") line))))))
        (when (> overflow 0)
          (push-chunk! chunks (dim (str "\n  └ … +" (+ overflow 1) " lines"))))))))

(defn push-command-card!
  [chunks (Vec TextChunk)
   title String
   body String
   status String] Any
  (let [parts CommandParts (command-parts title)
        running? Bool (identical? status "running")]
    (push-chunk! chunks
                 (cond
                   (identical? status "failed") (brightRed "• ")
                   running? (brightYellow "• ")
                   :else (brightGreen "• ")))
    (push-chunk! chunks (brightWhite (if running? "Running " "Ran ")))
    (push-chunk! chunks (brightCyan (commandparts-executable parts)))
    (when (not (identical? (commandparts-arguments parts) ""))
      (push-chunk! chunks (dim (str " " (commandparts-arguments parts)))))
    (push-command-output! chunks body)
    (push-chunk! chunks (white "\n\n"))))

(defn diff-start-line [token Any] Int
  (let [value String (text token)
        without-sign String (if (> (.-length value) 0) (.slice value 1) "0")
        comma Int (.indexOf without-sign ",")
        number-text String (if (< comma 0) without-sign (.slice without-sign 0 comma))
        parsed Any (Number number-text)]
    (if (Number/isFinite parsed) parsed 0)))

(defn append-diff-row
  [state DiffState
   row DiffRow] DiffState
  (with state [:rows (.concat (diffstate-rows state) row)]))

(defn diff-rows [diff Any] DiffState
  (let [source String (clean-text diff)]
    (if (identical? source "")
      (->DiffState 0 0 0 0 [])
      (.reduce
       (.split source "\n")
       (fn
         [state DiffState
          line String] DiffState
         (cond
           (.startsWith line "@@ ")
           (let [parts Any (.split line " ")]
             (append-diff-row
              (with state
                [:old-line (diff-start-line (nth parts 1))]
                [:new-line (diff-start-line (nth parts 2))])
              (->DiffRow "hunk" "" "" line)))

           (or (.startsWith line "diff --git ")
               (.startsWith line "index ")
               (.startsWith line "--- ")
               (.startsWith line "+++ ")) state

           (.startsWith line "+")
           (append-diff-row
            (with state
              [:new-line (+ (diffstate-new-line state) 1)]
              [:additions (+ (diffstate-additions state) 1)])
            (->DiffRow "add" "" (str (diffstate-new-line state)) line))

           (.startsWith line "-")
           (append-diff-row
            (with state
              [:old-line (+ (diffstate-old-line state) 1)]
              [:deletions (+ (diffstate-deletions state) 1)])
            (->DiffRow "delete" (str (diffstate-old-line state)) "" line))

           (.startsWith line "\\ No newline")
           (append-diff-row state (->DiffRow "meta" "" "" line))

           :else
           (append-diff-row
            (with state
              [:old-line (+ (diffstate-old-line state) 1)]
              [:new-line (+ (diffstate-new-line state) 1)])
            (->DiffRow "context"
                       (str (diffstate-old-line state))
                       (str (diffstate-new-line state))
                       line))))
       (->DiffState 0 0 0 0 [])))))

(defn file-change-details [change Any] FileChangeDetails
  (let [parsed DiffState (diff-rows (.-diff change))]
    (->FileChangeDetails (text (.-path change))
                         (text (.-kind change))
                         (diffstate-additions parsed)
                         (diffstate-deletions parsed)
                         (diffstate-rows parsed))))

(defn file-change-summary [changes Any] FileChangeSummary
  (.reduce
   changes
   (fn
     [summary FileChangeSummary
      change Any] FileChangeSummary
     (let [details FileChangeDetails (file-change-details change)]
       (with summary
         [:additions (+ (filechangesummary-additions summary)
                        (filechangedetails-additions details))]
         [:deletions (+ (filechangesummary-deletions summary)
                        (filechangedetails-deletions details))]
         [:files (.concat (filechangesummary-files summary) details)])))
   (->FileChangeSummary 0 0 [])))

(defn diff-line-number [value Any] String
  (let [number-text String (text value)]
    (.padStart number-text 4 " ")))

(defn push-diff-rows!
  [chunks (Vec TextChunk)
   rows (Vec DiffRow)
   width Int] Any
  (let [limit Int 36
        visible (Vec DiffRow) (.slice rows 0 limit)
        row-count Int (.-length rows)
        overflow Int (Math/max 0 (- row-count limit))]
    (.forEach
     visible
     (fn [row DiffRow] Any
       (let [kind String (diffrow-kind row)
             numbers String (str (diff-line-number (diffrow-old row)) " "
                          (diff-line-number (diffrow-new row)) " │ ")
             line String (compact-text (str numbers (diffrow-text row)) width)]
         (push-chunk! chunks (white "\n"))
         (push-chunk! chunks
                      (cond
                        (identical? kind "add") ((bg "#173326") (brightGreen (pad-right line width)))
                        (identical? kind "delete") ((bg "#382127") (brightRed (pad-right line width)))
                        (identical? kind "hunk") (brightCyan line)
                        :else (dim line))))))
    (when (> overflow 0)
      (push-chunk! chunks (dim (str "\n          └ … +" overflow " diff lines"))))))

(defn push-file-change-card!
  [chunks (Vec TextChunk)
   item ConversationItem
   status String
   runtime Any] Any
  (let [data Any (conversationitem-data item)
        changes Any (if (and data (Array/isArray (.-changes data))) (.-changes data) [])
        summary FileChangeSummary (file-change-summary changes)
        files (Vec FileChangeDetails) (filechangesummary-files summary)
        width Int (Math/max 24 (- (available-agent-width runtime) 2))]
    (push-chunk! chunks (if (identical? status "failed") (brightRed "• ") (brightGreen "• ")))
    (push-chunk! chunks
                 (brightWhite
                  (str (if (identical? status "running") "Editing " "Edited ")
                       (.-length files) (if (identical? (.-length files) 1) " file" " files")
                       " (+" (filechangesummary-additions summary)
                       " -" (filechangesummary-deletions summary) ")")))
    (.forEach
     files
     (fn
       [file FileChangeDetails
        index Int] Any
       (let [last? Bool (identical? index (- (.-length files) 1))]
         (push-chunk! chunks
                      (brightBlack
                       (str "\n  " (if last? "└ " "├ ")
                            (filechangedetails-path file) " (+"
                            (filechangedetails-additions file)
                            " -" (filechangedetails-deletions file) ")")))
         (when (> (.-length (filechangedetails-rows file)) 0)
           (push-diff-rows! chunks (filechangedetails-rows file) width)))))
    (push-chunk! chunks (white "\n\n"))))

(defn push-working-wave!
  [chunks (Vec TextChunk)
   runtime Any] Any
  (let [letters Any (.split (text-or (.-workingLabel runtime) "Working") "")
        cursor Int (mod (.-spinnerIndex runtime) (.-length letters))]
    (push-chunk! chunks (brightBlack "• "))
    (.forEach
     letters
     (fn
       [letter String
        index Int] Any
       (push-chunk!
        chunks
        (if (identical? index cursor)
          (brightBlack letter)
          (brightWhite letter)))))))

;; The status the roster header and the agent strip already read: the control
;; session's own row in the model, not a guess made from an empty transcript.
(defn supervisor-status [runtime Any] String
  (let [id String (text (.-supervisorId runtime))
        agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents (snapshot (.-model runtime)))
        matches Any (.filter agents
                         (fn [agent Agent] Bool
                           (and (not (identical? id ""))
                                (identical? (agent-id agent) id))))]
    (if (identical? (.-length matches) 0) "" (agent-status (nth matches 0)))))

;; Pure: what the empty transcript should say. The old rule was "empty and not
;; working ⇒ Starting …", which never expired — the session could be ready, the
;; header could say so, and this line still claimed a boot in progress. An empty
;; string means show nothing.
;;
;; The ready state says nothing HERE any more: "Main is ready." was a line that
;; told you the one thing the roster header and the strip were already telling
;; you, on the screen with the most room to say something useful. A ready and
;; empty transcript renders the session banner instead (see
;; transcript-banner?), and this fold keeps the two states a banner cannot
;; stand in for — a boot in progress and a session that is gone.
(js/export
 (defn transcript-placeholder
   [label String
    status String
    item-count Int
    working? Bool] String
   (let [value Any (.toLowerCase (.trim status))]
    (cond
      (> item-count 0) ""
      working? ""
      (or (identical? value "") (identical? value "starting")) (str "Starting " label "…")
      (or (identical? value "offline")
          (identical? value "failed")
          (identical? value "error")) (str label " is offline.")
      :else ""))))

;; Pure: whether the banner is what this transcript should be showing. The same
;; three facts the placeholder folds, asking after the one state it no longer
;; answers for — and the disappearance rule is unchanged, because it is the
;; same rule: any transcript content at all, or a turn in flight, and the empty
;; screen is not empty any more.
(js/export
 (defn transcript-banner?
   [status String
    item-count Int
    working? Bool] Bool
   (let [value Any (.toLowerCase (.trim status))]
    (and (identical? item-count 0)
         (not working?)
         (not (identical? value ""))
         (not (identical? value "starting"))
         (not (identical? value "offline"))
         (not (identical? value "failed"))
         (not (identical? value "error"))))))

;; Whether the banner owns the screen right now, asked of the runtime once so
;; that everything which has to agree with the banner — the transcript that
;; draws it, the roster that stands down for it — reads the same answer instead
;; of each recomputing the rule.
(defn banner-visible? [runtime Any] Bool
  (and (not (aggregate-transcript? runtime))
       (identical? (runtime-selected-agent-id runtime)
                   (text (.-supervisorId runtime)))
       (transcript-banner? (supervisor-status runtime)
                           (.-length (projected-conversation runtime))
                           (transcript-working? runtime))))

;; The banner's own facts, each labelled, in one column. The label width is
;; fixed so the values line up as a column of answers rather than a paragraph.
(def BANNER-LABEL-WIDTH Int 13)

;; Below this the box is more cost than view: the borders take four columns
;; and a clipped path or model tells you less than the plain line does. The
;; banner degrades to its own lines rather than wrapping, because a wrapped box
;; is a broken box.
(def BANNER-MIN-COLUMNS Int 55)

(def BANNER-MODEL-HINT String "/model changes the next launch")

;; Pure: the identity to print. The handshake identity is a full commit hash;
;; what a human needs off the screen is the short rev they would type at git.
(js/export
 (defn banner-revision [identity Any] String
  (let [value String (.trim (text identity))]
    (if (identical? value "") "unknown" (.slice value 0 8)))))

;; Pure: `bypassPermissions` is the mode where nothing is asked, and calling it
;; by its wire name buries that. The operator's word for it is the one that
;; carries the warning.
(js/export
 (defn banner-permissions [mode Any] String
  (let [value String (.trim (text mode))]
    (cond
      (identical? value "") "pending"
      (identical? value "bypassPermissions") "YOLO mode"
      :else value))))

(defn banner-field
  [label String
   value String] String
  (str (pad-right (str label ":") BANNER-LABEL-WIDTH) value))

;; Pure: session facts -> the banner's content lines, before any box is drawn
;; around them. A fact the session has not reported yet says `pending`, which is
;; the word the rest of the view already uses for the same gap.
(js/export
 (defn session-banner-lines
   [identity Any
    model Any
    effort Any
    directory Any
    permissions Any] Any
   (let [named String (text-or (text model) "pending")
         graded String (text effort)
         model-text String (if (identical? graded "") named (str named " " graded))]
     [(str ">_ North (" (banner-revision identity) ")")
     ""
     (banner-field "model" (str model-text "   " BANNER-MODEL-HINT))
     (banner-field "directory" (text-or (text directory) "pending"))
     (banner-field "permissions" (banner-permissions permissions))])))

;; Pure: a line cut to fit, tail-first, so the end of a long path or model name
;; is what survives — the part that distinguishes it from its neighbours.
(defn banner-clip
  [line String
   width Int] String
  (let [limit Int (Math/max 1 width)]
    (if (> (grapheme-count line) limit)
      (str (.slice line 0 (Math/max 0 (- limit 1))) "…")
      line)))

;; Pure: the widest line, which is what the box is drawn around — sized to the
;; content rather than to the terminal, so the banner is a card and not a rule.
(defn widest-line! [lines Any] Int
  (let [widest (Map Keyword Int) {:n 0}]
    (.forEach lines
              (fn [line String] Any
                (when (> (grapheme-count line) (.-n widest))
                  (set! (.-n widest) (grapheme-count line)))))
    (.-n widest)))

;; Pure: content lines -> the lines actually drawn. Wide enough and they get the
;; box, clipped to what fits so a long path cannot push a border off the edge
;; and wrap the view open. Narrow and they get themselves: a box that does not
;; fit is not a smaller box, it is a broken one.
(js/export
 (defn banner-box!
   [lines Any
    width Int] Any
   (let [inner Int (Math/max 1 (- width 4))
         clipped Any (.map lines
                      (fn [line String] String (banner-clip line inner)))]
     (if (< width BANNER-MIN-COLUMNS)
      clipped
      (let [span Int (Math/min inner (widest-line! clipped))
            rule Any (.repeat "─" (+ span 2))]
        (.concat [(str "╭" rule "╮")]
                 (.map clipped
                       (fn [line String] String
                         (str "│ " (pad-right line span) " │")))
                 [(str "╰" rule "╯")]))))))

(js/export
 (defn session-banner!
   [identity Any
    model Any
    effort Any
    directory Any
    permissions Any
    width Int] Any
   (banner-box! (session-banner-lines identity model effort directory permissions)
              width)))

;; The two columns the box costs on each side of a content line. Sliced by
;; UTF-16 length rather than graphemes on purpose: both are single-unit box
;; characters, and the slice has to agree with `.startsWith`/`.endsWith`.
(def BANNER-BOX-PREFIX String "│ ")
(def BANNER-BOX-SUFFIX String " │")

;; Pure: is this drawn line the box's top or bottom rule — border and nothing
;; else? Those two lines carry no content at all, so they are view end to end.
(js/export
 (defn banner-rule-line? [line String] Bool
  (or (.startsWith line "╭") (.startsWith line "╰"))))

;; Pure: one drawn line -> [border-prefix content border-suffix]. The box's
;; sides belong to the VIEW, not to the line they enclose: colouring a whole
;; line coloured its borders with it, which is what made the pipes beside the
;; title bright against an otherwise dim box — a view in two tones, which reads
;; as broken rather than as emphasis.
(js/export
 (defn banner-line-segments [line String] Any
  (let [line-length Int (.-length line)]
   (cond
    (banner-rule-line? line) [line "" ""]

    (and (.startsWith line BANNER-BOX-PREFIX)
         (.endsWith line BANNER-BOX-SUFFIX)
         (>= line-length 4))
    [BANNER-BOX-PREFIX
     (.slice line 2 (- line-length 2))
     BANNER-BOX-SUFFIX]

    ;; The narrow banner draws no box, so the whole line is content.
    :else ["" line ""]))))

;; Pure: the drawn banner -> the runs that paint it, in order, each carrying the
;; tone it paints in. Exactly one tone is bright — the title's own text — and
;; everything else, fields and the entire view alike, is dim. Newlines ride
;; along as view runs so a caller emits the banner by walking this list and
;; nothing else.
(js/export
 (defn session-banner-runs [lines Any] Any
  (let [runs (Vec Any) []]
    (.forEach
     lines
     (fn
       [line String
        index Int] Any
       (let [segments Any (banner-line-segments line)
             prefix Any (nth segments 0)
             content Any (nth segments 1)
             suffix Any (nth segments 2)]
         (when (> index 0) (.push runs {:text "\n" :tone "snapshot"}))
         (when (not (identical? prefix "")) (.push runs {:text prefix :tone "snapshot"}))
         (when (not (identical? content ""))
           (.push runs {:text content
                        :tone (if (.includes content ">_ North (") "title" "field")}))
         (when (not (identical? suffix "")) (.push runs {:text suffix :tone "snapshot"})))))
    runs)))

(js/export
 (defn render-conversation! [runtime Any] Any
  (let [chunks (Vec TextChunk) []
        items Any (projected-conversation runtime)]
    (.forEach
     items
     (fn [item ConversationItem] Any
       (let [kind String (conversationitem-kind item)
             title String (conversationitem-title item)
             body String (clipped (conversationitem-body item) 6000)
             status String (conversationitem-status item)]
         (cond
           (identical? kind "user")
           (do (push-chunk! chunks
                            ((bg "#292c32")
                             (brightWhite (user-block-text runtime body))))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "assistant")
           (do (push-chunk! chunks (brightGreen "• "))
               (push-chunk! chunks (brightWhite body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "command")
           (push-command-card! chunks title body status)

           (identical? kind "interrupted")
           (do (push-chunk! chunks (brightRed "■ Conversation interrupted"))
               (push-chunk! chunks
                            (red " — tell the model what to do differently."))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "change")
           (push-file-change-card! chunks item status runtime)

           (identical? kind "tool")
           (do (push-chunk! chunks (if (identical? status "failed") (brightRed "• ") (brightGreen "• ")))
               (push-chunk! chunks (brightWhite title))
               (when (not (identical? body ""))
                 (push-chunk! chunks (dim (str "\n  └ " (replace-all body "\n" "\n    ")))))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "thought")
           (do (push-chunk! chunks (brightBlack "• Explored "))
               (push-chunk! chunks (dim body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "error")
           (do (push-chunk! chunks (brightRed "• Error\n  "))
               (push-chunk! chunks (red (replace-all body "\n" "\n  ")))
               (push-chunk! chunks (white "\n\n")))

           :else
           (do (push-chunk! chunks (brightBlack (str "• " body)))
               (push-chunk! chunks (white "\n\n")))))))
    (when (transcript-working? runtime)
      (let [working-since Number (.-workingSince runtime)
            elapsed Int (Math/floor (/ (- (Date/now) working-since) 1000))]
        (push-working-wave! chunks runtime)
        (push-chunk! chunks (brightBlack (str " (" elapsed "s · esc or ctrl-c to cancel)\n  ")))
        (push-chunk! chunks (brightBlack (transcript-context-text runtime)))))
    (let [status String (supervisor-status runtime)
          working? Bool (transcript-working? runtime)
          supervisor-view? Any (and (not (aggregate-transcript? runtime))
                                (identical? (runtime-selected-agent-id runtime)
                                            (text (.-supervisorId runtime))))
          placeholder String (if supervisor-view?
                        (transcript-placeholder (main-agent-label runtime) status
                                                (.-length items) working?)
                        "")]
      (when (not (identical? placeholder ""))
        (push-chunk! chunks (brightBlack placeholder)))
      ;; The ready-and-empty screen: the one moment there is room to say what
      ;; session this is, and the one moment nothing else needs the space.
      (when (banner-visible? runtime)
        (.forEach (session-banner-runs
                   (session-banner! (.-sourceIdentity runtime)
                                   (.-sessionModel runtime)
                                   (.-sessionEffort runtime)
                                   (short-directory (.-sessionCwd runtime))
                                   (.-sessionPermissions runtime)
                                   (available-view-width)))
                  (fn [run Any] Any
                    (push-chunk! chunks
                                 (if (identical? (.-tone run) "title")
                                   (brightWhite (text (.-text run)))
                                   (brightBlack (text (.-text run))))))))
    (new StyledText chunks)))))

(defn visible-notice [notice Any] String
  (let [value String (text notice)]
    (cond
      (identical? value "view dag") "view graph"
      (identical? value "view kanban") "view board"
      :else value)))

;; Section labels are the public kind vocabulary.
(js/export
 (defn config-section-title [role String] String
  (cond
    (identical? role "module") "MODULES"
    (identical? role "skill") "SKILLS"
    (identical? role "hook") "HOOKS"
    :else "")))

;; Pure: the headings a row sits under, outermost first — the full path, not
;; just the heading it introduces, so that "which heading does this row still
;; need printed" is answered by comparing paths and nothing has to remember what
;; came before.
;;
(js/export
 (defn config-header-roles [role String] Any
  (cond
    (identical? role "module") ["module"]
    (identical? role "skill") ["skill"]
    (identical? role "hook") ["hook"]
    :else [])))

;; Section names are global because activation units no longer live under
;; directory nodes.
(js/export
 (defn config-header-keys
   [entry Any
    rows Any] Any
   (let [role String (config-row-role entry rows)]
     (.map (config-header-roles role)
          (fn [heading String] String
            heading)))))

;; Pure: how many of two heading paths agree from the outside in, which is how
;; many headings a row does NOT have to print again.
(js/export
 (defn config-header-shared!
   [prior Any
    current Any] Int
   (let [count (Map Keyword Int) {:n 0}]
    (.forEach current
              (fn
                [heading String
                 index Int] Any
                (when (and (identical? (.-n count) index)
                           (< index (.-length prior))
                           (identical? (nth prior index) heading))
                  (set! (.-n count) (+ index 1)))))
    (.-n count))))

(defn config-panel-title [config-filter String] String
  (cond
    (identical? config-filter "hook") "hooks"
    (identical? config-filter "skill") "skills"
    (identical? config-filter "module") "modules"
    :else "switchboard"))

;; An empty result is not a pending one. Saying "loading…" forever is how the
;; panel lied about a generation that simply has no rows of this kind. A query
;; that matches nothing is a third answer again: the rows are there, and this is
;; what you asked for.
(js/export
 (defn config-empty-note
   [loaded? Bool
    filtering? Bool] String
   (cond
    (not loaded?) " loading…"
    filtering? " nothing matches"
    :else " nothing to configure here")))

;; The filter field, on the panel's own header line: the surface you are typing
;; into is the surface that shows what you typed. Present the moment `/` is
;; pressed, empty query and all, because a field you cannot see is a mode you
;; cannot leave on purpose.
(js/export
 (defn config-query-field
   [filtering? Bool
    query String] String
   (if filtering? (str "  /" query) "")))

;; The key legend, which has one more rung to name while a filter is up: escape
;; spends itself on the query before it touches the panel.
(js/export
 (defn config-panel-legend [filtering? Bool] String
  (if filtering?
    "  ↑/↓ move · space toggle · enter inspect module · esc clears filter"
    "  ↑/↓ move · space toggle · enter inspect module · / filter · esc close")))

;; The dimmest tone the panel has: brightBlack with the dim attribute on top of
;; it. What you switched off, and what is only on screen to give a match its
;; context, should recede — a row you pinned off is the last thing that should
;; be shouting at you from a list of things that are running.
(defn dimmest [value String] TextChunk
  (dim (brightBlack value)))

(defn config-member-count-text [count Int] String
  (str count (if (identical? count 1) " member" " members")))

;; Pure: one row, in the order it reads. The UnitId leads because it is the
;; what you came to the list to find; the state follows it after a colon,
;; and the module/support summary follows. The UnitId gives way first when narrow;
;; clipping permission or activity would change the answer.
(js/export
 (defn config-row-parts
   [entry Any
    state-text String
    width Int] Any
   (let [kind String (configentry-kind entry)
         name String (configentry-name entry)
         members Any (config-entry-members entry)
         detail String (cond
                 (identical? kind "hook")
                 (let [claims Any (config-array (.-supports entry))]
                   (if (> (.-length claims) 0)
                     (str "supports " (.join claims ", "))
                     ""))
                 (identical? kind "module")
                 (config-member-count-text (.-length members))
                 :else (text (configentry-detail entry)))
         indent String (config-row-indent)
         indent-width Int (.-length indent)
         state-width Int (.-length state-text)
         detail-width Int (.-length detail)
         room Int (Math/max 8 (- width indent-width state-width detail-width 4))]
     {:indent indent
     :name (compact-text name room)
     :state state-text
     :detail detail})))

;; Section rows sit one step under their heading. Recursive membership is shown
;; by the module inspector instead of creating a second folding hierarchy here.
(def CONFIG-INDENT-WIDTH Int 2)

(defn config-row-indent [] String
  (.repeat " " CONFIG-INDENT-WIDTH))

;; Each kind has one heading level; keep the argument because the renderer walks
;; heading paths generically.
(defn config-header-indent [index Int] String
  (.repeat " " (* CONFIG-INDENT-WIDTH (+ index 1))))

(defn config-unit-parents
  [entries Any
   id String] Any
  (.map
   (.filter entries
            (fn [entry Any] Bool
              (and (identical? (configentry-kind entry) "module")
                   (.includes (config-entry-members entry) id))))
   (fn [entry Any] String (configentry-name entry))))

(defn config-path-text [path Any] String
  (if (Array/isArray path)
    (.join (.map path (fn [id Any] String (text id))) " → ")
    (text path)))

(defn config-unit-summary
  [entry Any
   entries Any
   parent String] String
  (let [id String (configentry-name entry)
        parents Any (config-unit-parents entries id)
        others Any (.filter parents
                            (fn [owner String] Bool
                              (not (identical? owner parent))))
        supports Any (config-array (.-supports entry))]
    (str (configentry-kind entry) " " id
         ": " (if (.-active entry) "on" "off")
         " · permission " (text-or (configentry-state entry) "default")
         (if (identical? (text (.-owner entry)) "")
           ""
           (str " · owner " (text (.-owner entry))))
         (if (> (.-length supports) 0)
           (str " · supports " (.join supports ", "))
           "")
         (if (> (.-length others) 0)
           (str " · also in " (.join others ", "))
           ""))))

(defn config-inspection-walk!
  [lines Any
   entries Any
   entry Any
   parent String
   depth Int
   trail Any] Any
  (let [id String (configentry-name entry)
        indent String (.repeat "  " depth)
        paths Any (config-array (.-activationPaths entry))]
    (.push lines (str indent (if (> depth 0) "└─ " "")
                      (config-unit-summary entry entries parent)))
    (.forEach paths
              (fn [path Any] Any
                (.push lines (str indent "   activation: "
                                  (config-path-text path)))))
    (when (identical? (configentry-kind entry) "module")
      (.forEach (.sort (.slice (config-entry-members entry))
                       (fn
                         [left Any
                          right Any] Int
                         (compare-text (text left) (text right))))
                (fn [member-id Any] Any
                  (let [member String (text member-id)
                        child Any (config-find-entry entries member)]
                    (if (nil? child)
                      (.push lines (str indent "  └─ missing unit " member))
                      (if (.includes trail member)
                        (.push lines (str indent "  └─ cycle " member))
                        (config-inspection-walk!
                         lines entries child id (+ depth 1)
                         (.concat trail [member]))))))))
    lines))

(js/export
 (defn config-module-inspection-text!
   [entries Any
    id String] String
   (let [entry Any (config-find-entry entries id)]
     (if (or (nil? entry)
             (not (identical? (configentry-kind entry) "module")))
       (str "module unavailable: " id)
       (.join (config-inspection-walk! [] entries entry "" 0 [id]) "\n")))))

(js/export
 (defn render-config-panel! [runtime Any] Any
  ;; The filtered rows, not the view's: what the panel draws is what the
  ;; cursor walks and what space flips, and one list decides all three.
  ;; Activity and provenance are already resolved by the selected generation;
  ;; the full unit list remains available only for inspection traversal.
  ;; An unfocused panel is still on screen and no longer yours: the cursor
  ;; stops burning and the row it is on stops standing out, so the view
  ;; says where the keyboard went without moving anything.
  (let [entries Any (config-panel-rows runtime)
        total Any (.-length entries)
        stored-entries Any (.-configEntries runtime)
        stored-all Any (.-configAllEntries runtime)
        all-entries Any (if stored-all
                   stored-all
                   (if stored-entries stored-entries entries))
        basis Any (if stored-entries stored-entries entries)
        config-filter String (text-or (text (.-configFilter runtime)) "all")
        filtering? Bool (panel-filtering? runtime)
        focused? Bool (panel-focused? runtime)
        query String (panel-query runtime)
        inspect-id String (text (.-configInspectId runtime))]
    (cond
      (not (identical? inspect-id ""))
      (new StyledText
           [(brightYellow "module inspection")
            (brightBlack "  enter returns\n")
            (brightWhite (config-module-inspection-text! all-entries inspect-id))])

      (identical? total 0)
      (new StyledText [(brightYellow (config-panel-title config-filter))
                    (brightCyan (config-query-field filtering? query))
                    (brightBlack
                     (text-or (text (.-configDiagnostic runtime))
                              (config-empty-note
                               (if (.-configLoaded runtime) true false)
                               filtering?)))])
      :else
      ;; A user pin stays dim even under the cursor. Filter context is dimmed;
      ;; a bound hook omits provenance already supplied by its parent. Section
      ;; headings print only where they diverge from the preceding row, and
      ;; kind tags stay quiet where the heading already supplies the kind.
      (let [index Int (clamped-index (.-configIndex runtime) total)
            window Int (config-visible-count total config-filter)
            start Int (window-start index total window)
            stop Int (Math/min total (+ start window))
            width Int (Math/max 12 (- (terminal-columns) 12))
            parts (Vec TextChunk) [(brightYellow (config-panel-title config-filter))
                   (brightCyan (config-query-field filtering? query))
                   (brightBlack (str (config-panel-legend filtering?) "\n"))]]
        (.forEach (.slice entries start stop)
                  (fn
                    [entry Any
                     offset Int] Any
                    (let [i Int (+ start offset)
                          cursor? Bool (identical? i index)
                          kind String (configentry-kind entry)
                          active? Bool (config-entry-active? entry)
                          permission-off? Bool (not (config-permission-on? (configentry-state entry)))
                          context? Bool (config-row-context-only? entry query)
                          role String (config-row-role entry basis)
                          state-text String (config-state-text entry)
                          row Any (config-row-parts entry state-text width)
                          headings Any (config-header-keys entry basis)
                          prior Any (if (identical? i start)
                                  []
                                  (config-header-keys (nth entries (- i 1))
                                                      basis))
                          shared Int (config-header-shared! prior headings)
                          tail String (if (identical? (+ i 1) stop) "" "\n")]
                      (.forEach (config-header-roles role)
                                (fn
                                  [heading String
                                   at Int] Any
                                  (when (>= at shared)
                                    (.push parts
                                           (brightYellow
                                            (str (config-header-indent at)
                                                 (config-section-title heading)
                                                 "\n"))))))
                      (.push parts (if (and cursor? focused?)
                                     (brightCyan "› ")
                                     (if cursor? (brightBlack "› ")
                                         (brightBlack "  "))))
                      (let [name-chunk (Fn [String] TextChunk) (fn [value String] TextChunk
                              (cond
                                permission-off? (dimmest value)
                                (and cursor? focused?) (brightWhite value)
                                context? (dimmest value)
                                :else (brightBlack value)))
                            state-chunk (Fn [String] TextChunk) (fn [value String] TextChunk
                              (cond
                                permission-off? (dimmest value)
                                active? (brightGreen value)
                                :else (brightBlack value)))]
                        (.push parts (name-chunk (text (.-indent row))))
                        (.push parts (name-chunk (text (.-name row))))
                        (.push parts (name-chunk ": "))
                        (.push parts (state-chunk (text (.-state row))))
                        (.push parts (name-chunk
                                      (str (if (identical? (.-detail row) "")
                                             ""
                                             (str "  " (.-detail row)))
                                           tail)))))))
        (new StyledText parts))))))

;; ---------------------------------------------------------------------------
;; Docked detail area. One surface, one render path, one piece of state saying
;; which tenant is showing: "" (collapsed), "config" (the switchboard),
;; "agents" (the roster behind a strip segment). New tenants add a branch to
;; render-detail-panel! and detail-body-lines and nothing else.
;; ---------------------------------------------------------------------------

(defn detail-open? [runtime Any] Bool
  (not (identical? (text (.-detailView runtime)) "")))

(defn detail-showing?
  [runtime Any
   view String] Bool
  (identical? (text (.-detailView runtime)) view))

(defn open-detail!
  [runtime Any
   view String] Any
  (set! (.-detailView runtime) view))

;; A closed panel holds no query. The filter is a state of the surface, so it
;; dies with the surface however the surface is closed — the ladder, a command,
;; or the same view's own toggle.
(defn close-detail! [runtime Any] Any
  (clear-panel-filter! runtime)
  (set! (.-detailView runtime) ""))

;; /help and F1 are the same switch, and the panel is where it lands.
(defn toggle-help!
  [runtime Any
   ui Any] Any
  (if (detail-showing? runtime "help")
    (do (close-detail! runtime) (focus-composer! runtime ui))
    (do (open-detail! runtime "help") (focus-panel! runtime ui)))
  (.render runtime))

(defn detail-agents [runtime Any] (Vec Agent)
  (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))]
    (segment-agents (bridgesnapshot-agents state)
                    (text-or (text (.-detailSegment runtime)) "all"))))

;; Rows the docked panel spends before its first list row: its border and the
;; title line that carries the key legend.
(def DETAIL-CHROME-ROWS Int 3)

;; Headings are content the panel inserts between rows, so the layout budgets
;; for the three authority-owned kinds.
(def CONFIG-SECTION-ROWS Int 3)

(defn detail-visible-count
  [total Int
   extra Int] Int
  (fitted-window total (terminal-rows)
                 (+ CHROME-ROWS MIN-WORKSPACE-ROWS DETAIL-CHROME-ROWS extra)))

;; A narrowed view pays only for its one heading, so it keeps the rows the full
;; switchboard gives up to all three kind headings.
(js/export
 (defn config-section-rows [view String] Int
  (cond
    (identical? view "all") CONFIG-SECTION-ROWS
    :else 1)))

(js/export
 (defn config-visible-count
   [total Int
    view String] Int
   (detail-visible-count total (config-section-rows view))))

(defn clamped-index
  [raw Any
   total Int] Int
  (Math/max 0 (Math/min (if raw raw 0) (- total 1))))

(defn selected-detail-agent [runtime Any] Agent?
  (let [agents (Vec Agent) (detail-agents runtime)
        total Int (.-length agents)]
    (if (> total 0)
      (nth agents (clamped-index (.-detailIndex runtime) total))
      nil)))

;; Pure: how many heading lines render-config-panel inserts inside a window, so
;; the docked panel is exactly as tall as its content. The same rule the renderer
;; uses — a row prints the headings it does not share with the row above it, and
;; every heading at the window's first row.
(defn config-header-lines!
  [entries Any
   basis Any
   start Int
   stop Int] Int
  (let [count (Map Keyword Int) {:n 0}]
    (.forEach (.slice entries start stop)
              (fn
                [entry Any
                 offset Int] Any
                (let [i Int (+ start offset)
                      headings Any (config-header-keys entry basis)
                      prior Any (if (identical? i start)
                              []
                              (config-header-keys (nth entries (- i 1)) basis))
                      count-n Int (.-n count)
                      heading-count Int (.-length headings)]
                  (set! (.-n count)
                        (+ count-n
                           (- heading-count
                              (config-header-shared! prior headings)))))))
    (.-n count)))

(js/export
 (defn config-detail-lines! [runtime Any] Int
  (let [entries Any (config-panel-rows runtime)
        total Any (.-length entries)
        stored-entries Any (.-configEntries runtime)
        basis Any (if stored-entries stored-entries entries)
        view String (text-or (text (.-configFilter runtime)) "all")]
    (if (identical? total 0)
      1
      (let [index Int (clamped-index (.-configIndex runtime) total)
            window Int (config-visible-count total view)
            start Int (window-start index total window)
            stop Int (Math/min total (+ start window))]
        (+ 1 (- stop start) (config-header-lines! entries basis start stop)))))))

(defn detail-body-lines! [runtime Any] Int
  (cond
    (detail-showing? runtime "config") (config-detail-lines! runtime)
    (detail-showing? runtime "agents")
    (let [total Int (.-length (detail-agents runtime))
          agent (U Agent Nil) (selected-detail-agent runtime)
          metadata String (if agent (agent-route-text! agent (Math/max 12 (- (terminal-columns) 8))) "")
          extra Int (if (identical? metadata "") 0 1)]
      (+ 1
         (Math/max 1 (Math/min total (detail-visible-count total extra)))
         extra))
    (detail-showing? runtime "help") (+ 1 (help-visible-rows
                                           (panel-query runtime)))
    :else 0))

(js/export
 (defn detail-height! [runtime Any] Int
  (+ 2 (detail-body-lines! runtime))))

(defn agent-detail-title [segment-id String] String
  (if (identical? segment-id "all") "agents" (str "agents · " segment-id)))

(defn agent-detail-row!
  [agent Agent
   width Int] String
  (agent-cell-text! (agent-summary agent) width))

(defn render-agent-detail! [runtime Any] Any
  (let [agents (Vec Agent) (detail-agents runtime)
        total Int (.-length agents)
        title String (agent-detail-title (text-or (text (.-detailSegment runtime)) "all"))
        parts (Vec TextChunk) [(brightYellow title)
               (brightBlack "  ↑/↓ move · ←/→ segment · enter or esc close\n")]]
    (if (identical? total 0)
      (do (.push parts (brightBlack "  no agents in this state"))
          (new StyledText parts))
      (let [index Int (clamped-index (.-detailIndex runtime) total)
            width Int (Math/max 12 (- (terminal-columns) 8))
            selected-agent (U Agent Nil) (selected-detail-agent runtime)
            metadata String (if selected-agent (agent-route-text! selected-agent width) "")
            extra Int (if (identical? metadata "") 0 1)
            window Int (detail-visible-count total extra)
            start Int (window-start index total window)
            stop Int (Math/min total (+ start window))]
        (.forEach (.slice agents start stop)
                  (fn
                    [agent Agent
                     offset Int] Any
                    (let [i Int (+ start offset)
                          cursor? Bool (identical? i index)
                          tail String (if (and (identical? (+ i 1) stop)
                                        (identical? metadata "")) "" "\n")]
                      (.push parts (if cursor? (brightCyan "› ") (brightBlack "  ")))
                      (.push parts
                             (if cursor?
                               (brightWhite (str (agent-detail-row! agent width) tail))
                               (brightBlack (str (agent-detail-row! agent width) tail)))))))
        (when (not (identical? metadata ""))
          (.push parts (brightBlack (str "  " metadata))))
        (new StyledText parts)))))

;; ---------------------------------------------------------------------------
;; Help is a tenant of the docked panel, not a block printed into the
;; transcript: something you opened is something you can see how to close, and
;; the escape ladder closes it on the same rung as every other panel.
;; ---------------------------------------------------------------------------

(defrecord HelpRow
  [keys String
   meaning String])

(def HELP-ROWS (Vec HelpRow)
  ;; One key, two meanings, decided by who holds the keyboard — so the row says
  ;; both rather than naming one and leaving the other to be discovered.
  [(->HelpRow "Tab" "cycle Agents / Goals / All")
   (->HelpRow "←/→" "switch product route")
   (->HelpRow "Ctrl-J / ↓" "into the agent strip, esc back out")
   (->HelpRow "Esc /close /esc" "back or dismiss; cancels a turn at root")
   (->HelpRow "Ctrl-C /interrupt" "cancel the turn; the message comes back")
   (->HelpRow "/q /exit / Ctrl-Q" "quit North")
   (->HelpRow "/help" "this panel")
   (->HelpRow "/glyph <one>|reset" "prompt glyph")
   (->HelpRow "/emoji <query>" "picker")
   (->HelpRow "/sound on|off|pack" "voice lines")
   (->HelpRow "/mute" "quiet")])

(def HELP-KEY-WIDTH Int 22)

;; Pure: help is rows too, so `/` narrows them on the same case-insensitive
;; substring the switchboard uses — over the keys and their meanings, which is
;; the whole of what a help row says.
(js/export
 (defn help-query-rows [query String] Any
  (let [needle Any (.toLowerCase (.trim query))]
    (if (identical? needle "")
      HELP-ROWS
      (.filter HELP-ROWS
               (fn [row HelpRow] Bool
                 (.includes (.toLowerCase (str (helprow-keys row) " "
                                               (helprow-meaning row)))
                            needle)))))))

(defn help-visible-rows [query String] Int
  (let [total Any (.-length (help-query-rows query))]
    (Math/max 1 (Math/min total (detail-visible-count total 0)))))

(defn render-help-panel! [runtime Any] Any
  ;; An empty query result still occupies its budgeted row and explains itself.
  (let [filtering? Bool (panel-filtering? runtime)
        query String (panel-query runtime)
        matched Any (help-query-rows query)
        chunks (Vec TextChunk) [(brightYellow "North keys")
                (brightCyan (config-query-field filtering? query))
                (brightBlack (if filtering?
                               " · esc clears filter\n"
                               " · / filter · esc closes\n"))]
        rows Any (.slice matched 0 (help-visible-rows query))
        row-count Int (.-length rows)]
    (if (identical? row-count 0)
      (push-chunk! chunks (brightBlack " nothing matches"))
      (.forEach
       rows
       (fn
         [row HelpRow
          index Int] Any
         (push-chunk! chunks (brightWhite (pad-right (helprow-keys row)
                                                     HELP-KEY-WIDTH)))
         (push-chunk! chunks (brightBlack (helprow-meaning row)))
         (when (< index (- row-count 1))
           (push-chunk! chunks (brightBlack "\n"))))))
    (new StyledText chunks)))

(js/export
 (defn render-detail-panel! [runtime Any] Any
  (cond
    (detail-showing? runtime "config") (render-config-panel! runtime)
    (detail-showing? runtime "agents") (render-agent-detail! runtime)
    (detail-showing? runtime "help") (render-help-panel! runtime)
    :else (new StyledText [(brightBlack "")]))))

(defn segment-chunk
  [segment AgentSegment
   highlighted? Bool] TextChunk
  (let [label String (agentsegment-label segment)
        id String (agentsegment-id segment)]
    (cond
      highlighted? (brightCyan label)
      (identical? id "failed") (brightRed label)
      (identical? id "blocked") (brightYellow label)
      (identical? id "running") (brightGreen label)
      :else (brightWhite label))))

(defn render-agent-strip
  [state BridgeSnapshot
   focused? Bool
   selected Int] Any
  (let [segments (Vec AgentSegment) (agent-segments (bridgesnapshot-agents state))
        chunks (Vec TextChunk) [(if focused? (brightCyan "› ") (brightBlack "  "))]]
    (.forEach
     segments
     (fn
       [segment AgentSegment
        index Int] Any
       (when (> index 0) (.push chunks (brightBlack STRIP-SEPARATOR)))
       (.push chunks (segment-chunk segment
                                    (and focused? (identical? index selected))))))
    (when focused?
      (.push chunks (brightBlack "   h/l segment · enter open · esc input")))
    (new StyledText chunks)))

(defn status-notice
  [runtime Any
   state BridgeSnapshot] String
  (let [workspace-notice String (text (.-workspaceNotice runtime))
        notice String (if (identical? workspace-notice "")
                 (visible-notice (bridgesnapshot-notice state)) workspace-notice)]
    notice))

(defn render-status
  [runtime Any
   state BridgeSnapshot] Any
  (new StyledText [(brightBlack (status-notice runtime state))]))

;; The view bar is the product vocabulary boundary. These three labels are the
;; complete route set; the tail reports what the active route contains.
(def AGENTS-TAB-LABEL String "Agents")
(def GOALS-TAB-LABEL String "Goals")
(def ALL-TAB-LABEL String "All")
(def VIEW-TAB-SEPARATOR String " | ")
(def VIEW-TAIL-SEPARATOR String " > ")

;; The Agents tail: who you are talking to and from where. Chunks, not a
;; StyledText, so the bar can splice them in after its own labels.
(defn push-session-identity!
  [chunks (Vec TextChunk)
   session Any] Any
  (push-chunk! chunks
               (brightYellow
                (str (text-or (.-sessionModel session) "model pending") " "
                     (text-or (.-sessionEffort session) "effort pending"))))
  (push-chunk! chunks (brightBlack " · "))
  (push-chunk! chunks
               (brightGreen (text-or (short-directory (.-sessionCwd session))
                                     "directory pending")))
  (push-chunk! chunks (brightBlack " · "))
  (push-chunk! chunks (dim (text-or (.-sessionBranch session) "branch pending"))))

(js/export
 (defn render-view-tabs!
   [view Any
    state BridgeSnapshot
    _view-id String
    session Any] Any
   (let [chunks (Vec TextChunk) []
         active String (canonical-top-level-view (text view))]
     (push-chunk! chunks
                  (if (identical? active "agents")
                    (brightGreen AGENTS-TAB-LABEL)
                    (brightBlack AGENTS-TAB-LABEL)))
    (push-chunk! chunks (brightBlack VIEW-TAB-SEPARATOR))
    (push-chunk! chunks
                 (if (identical? active "goals")
                   (brightGreen GOALS-TAB-LABEL)
                   (brightBlack GOALS-TAB-LABEL)))
    (push-chunk! chunks (brightBlack VIEW-TAB-SEPARATOR))
    (push-chunk! chunks
                 (if (identical? active "all")
                   (brightGreen ALL-TAB-LABEL)
                   (brightBlack ALL-TAB-LABEL)))
    (push-chunk! chunks (brightBlack VIEW-TAIL-SEPARATOR))
    (cond
     (identical? active "agents") (push-session-identity! chunks session)
     (identical? active "goals")
     (push-chunk! chunks (brightYellow "desired outcomes"))
     :else
     (push-chunk! chunks (brightYellow "all tracked things")))
    (when (and (identical? active "agents") (aggregate-transcript? session))
      (push-chunk! chunks (brightYellow " · all transcripts")))
    (new StyledText chunks))))

(defn tracked-thing-tags [item TrackedThing] (Vec String)
  (let [tags (Vec String) []]
    (when (trackedthing-agent item) (.push tags "Agent"))
    (when (trackedthing-work item) (.push tags "Work"))
    (when (trackedthing-desired-outcome item) (.push tags "Goal"))
    (when (trackedthing-plan item) (.push tags "Plan"))
    (when (trackedthing-project item) (.push tags "Project"))
    (when (trackedthing-task item) (.push tags "Task"))
    (when (identical? (.-length tags) 0) (.push tags "Tracked"))
    tags))

(defn selection-prefix [selected? Bool] String
  (if selected? "› " "  "))

(defn optional-clean-text [value (U String Nil)] String
  (if value (clean-text value) ""))

(defn semantic-agent-row
  [item TrackedThing
   selected? Bool] String
  (let [status String (optional-clean-text (trackedthing-status item))]
    (str (selection-prefix selected?)
         (clean-text (trackedthing-title item))
         (if (identical? status "") "" (str " (" status ")")))))

(defn semantic-goal-row
  [item TrackedThing
   selected? Bool] String
  (let [assignee String (optional-clean-text (trackedthing-assignee-title item))
        outcome String (optional-clean-text (trackedthing-desired-outcome item))]
    (str (selection-prefix selected?)
         (if (identical? assignee "")
           "[unassigned]"
           (str "[assigned: " assignee "]"))
         " " (clean-text (trackedthing-title item))
         " — " outcome)))

(defn semantic-all-row
  [item TrackedThing
   selected? Bool] String
  (let [tags String (.join (tracked-thing-tags item) " · ")
        outcome String (optional-clean-text (trackedthing-desired-outcome item))
        assignee String (optional-clean-text (trackedthing-assignee-title item))]
    (str (selection-prefix selected?)
         "[" tags "] " (clean-text (trackedthing-title item))
         (if (identical? outcome "") "" (str " — " outcome))
         (cond
          (not (identical? assignee "")) (str " · assigned to " assignee)
          (not (identical? outcome "")) " · unassigned"
          :else ""))))

(js/export
 (defn semantic-view-text!
   [state BridgeSnapshot
    view String
    selected Int
    width Int] String
   (let [canonical String (canonical-top-level-view view)
         items Any (cond
                     (identical? canonical "agents")
                     (bridgesnapshot-semantic-agents state)
                     (identical? canonical "goals")
                     (bridgesnapshot-goals state)
                     :else
                     (bridgesnapshot-all state))]
     (if (identical? (.-length items) 0)
       (cond
        (identical? canonical "agents") "No Agents"
        (identical? canonical "goals") "No Goals"
        :else "No tracked things")
       (.join
        (.map items
              (fn
                [item TrackedThing
                 index Int] String
                (let [row String (cond
                                   (identical? canonical "agents")
                                   (semantic-agent-row item (identical? index selected))
                                   (identical? canonical "goals")
                                   (semantic-goal-row item (identical? index selected))
                                   :else
                                   (semantic-all-row item (identical? index selected)))]
                  (clipped row width))))
        "\n")))))

(defn compact-text
  [value Any
   width Int] String
  (let [source String (text value)
        limit Int (Math/max 1 width)]
    (if (> (.-length source) limit)
      (str (.slice source 0 (Math/max 0 (- limit 1))) "…")
      source)))


;; Pure: the grey hint in the composer. It used to name the command set the
;; focused view answers to; the view bar sits directly under the composer and
;; already says which view is active, so the suffix was explaining twice.
(js/export
 (defn composer-hint
   [pane String
    label String] String
   (cond
    (identical? pane "agents") (str "Message " label "…")
    (identical? pane "goals")
    "/track, /plan, /start, /assign, /request, /ack, /ownership, /settle"
    :else "/filter, /show, /history, /inbox")))

(defn minibuffer-placeholder [runtime Any] String
  (composer-hint (text (.-view runtime)) (main-agent-label runtime)))

;; Pure: rows the slash palette may draw at once. `docked` is whatever the
;; detail panel is already spending, so an open switchboard shrinks the palette
;; instead of overflowing the view.
(defn palette-visible-count
  [total Int
   rows Int
   docked Int] Int
  (fitted-window total rows (+ CHROME-ROWS MIN-WORKSPACE-ROWS docked)))

;; Pure: option rows inside the window. When the list overflows, one row of the
;; window is spent on the "… N more" line instead of an option.
(defn palette-option-rows
  [total Int
   window Int] Int
  (if (and (> total window) (> window 1)) (- window 1) window))

;; Pure: what the overflow line reports, 0 when there is nothing to report or
;; no row to report it on.
(defn palette-overflow
  [total Int
   window Int
   rows Int] Int
  (if (and (> total rows) (> window rows)) (- total rows) 0))

(defn render-minibuffer!
  [runtime Any
   ui Any] (Vec SlashCommand)
  (let [view String (text (.-view runtime))
        input Any (.-composerInput ui)
        options (Vec SlashCommand) (palette-options view (text (.-value input)))
        total Int (.-length options)
        index Int (Math/max 0 (Math/min (.-paletteIndex runtime) (Math/max 0 (- total 1))))
        docked Int (if (detail-open? runtime) (detail-height! runtime) 0)
        window Int (palette-visible-count total (terminal-rows) docked)
        rows Int (palette-option-rows total window)
        start Int (window-start index total rows)]
    (set! (.-paletteIndex runtime) index)
    (set! (.-paletteStart runtime) start)
    (set! (.-paletteRows runtime) rows)
    (set! (.-placeholder input) (minibuffer-placeholder runtime))
    (set! (.-visible (.-composerPalette ui)) (> total 0))
    (set! (.-height (.-composerPalette ui)) window)
    (set! (.-content (.-composerPalette ui))
          (if (> total 0)
            (render-command-palette! (.slice options start (+ start rows))
                                     (- index start)
                                     (palette-overflow total window rows))
            ""))
    options))

(defn render-ui!
  [runtime Any
   ui Any] Any
  (when (not (.-disposed runtime))
    (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
          execution-agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents state)
          views (Vec WorkView) (view-list state)
          current WorkView (selected-view state (text (.-view runtime)))
          items (Vec TrackedThing) (workview-items current)
          semantic-agents (Vec TrackedThing) (bridgesnapshot-semantic-agents state)
          agent-max Int (Math/max 0 (- (.-length semantic-agents) 1))
          work-max Int (Math/max 0 (- (.-length items) 1))
          notice String (status-notice runtime state)
          notice? Bool (not (identical? notice ""))]
      (set! (.-agentIndex runtime) (Math/max 0 (Math/min (.-agentIndex runtime) agent-max)))
    (set! (.-workIndex runtime) (Math/max 0 (Math/min (.-workIndex runtime) work-max)))
    (apply-view-visibility! runtime ui)
    (set! (.-content (.-viewTabsText ui))
          (render-view-tabs! (.-view runtime) state (workview-id current) runtime))
    (set! (.-content (.-transcriptText ui)) (render-conversation! runtime))
    (set! (.-visible (.-workText ui)) true)
    (set! (.-visible (.-boardRoot ui)) false)
    (set! (.-content (.-workText ui))
          (semantic-view-text! state (workview-id current)
                               (.-workIndex runtime) (available-view-width)))
    (set! (.-content (.-statusText ui)) (render-status runtime state))
    (set! (.-content (.-agentStatusText ui)) (render-status runtime state))
    ;; One status line, inside whichever view is showing.
    (set! (.-visible (.-statusText ui))
          (and (tracked-thing-view? (.-view runtime)) notice?))
    (set! (.-visible (.-agentStatusText ui))
          (and (not (tracked-thing-view? (.-view runtime))) notice?))
    (render-prompt! runtime (.-composerPrompt ui))
    (let [segments (Vec AgentSegment) (agent-segments execution-agents)
          strip-max Int (Math/max 0 (- (.-length segments) 1))]
      (set! (.-stripIndex runtime)
            (Math/max 0 (Math/min (.-stripIndex runtime) strip-max)))
      (set! (.-content (.-agentStripText ui))
            (render-agent-strip state (.-stripFocused runtime)
                                (.-stripIndex runtime))))
    (let [open? Bool (detail-open? runtime)]
      (set! (.-visible (.-detailPanel ui)) open?)
      (when open?
        (set! (.-height (.-detailPanel ui)) (detail-height! runtime))
        (set! (.-content (.-detailText ui)) (render-detail-panel! runtime))))
    (render-minibuffer! runtime ui)
      (set! (.-activeView runtime) (workview-id current))
      views)))

(defn bridge-agent!
  [runtime Any
   execution-id String
   role String
   status String] Any
  (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
        agents (Vec north.bridge.model/Agent) (bridgesnapshot-agents state)
        prior-id String (selected-agent-id state (.-agentIndex runtime))
        existing Any (.find agents
                        (fn [agent Agent] Bool
                          (identical? (agent-id agent) execution-id)))
        updated north.bridge.model/Agent (->Agent execution-id
                         (if (identical? role "supervisor")
                           (main-agent-label runtime)
                           (str "Codex " (.slice execution-id 0 8)))
                         status
                         (if (identical? role "supervisor")
                           "North control session"
                           "Agent run")
                         "" "" "" "" "" "" "" "" "")]
    (.add (.-bridgeExecutions runtime) execution-id)
    (when (identical? role "supervisor")
      (set! (.-supervisorId runtime) execution-id))
    (set! (.-model runtime)
          (upsert-agent (.-model runtime)
                        (if existing (agent-with-route updated existing) updated)))
    (reconcile-agent-selection! runtime
                                (text-or prior-id
                                         (if (identical? role "supervisor") execution-id ""))))
  (.render runtime))

(defn record-line [line String] ParsedRecord?
  (let [close Int (.indexOf line "] ")]
    (if (or (not (.startsWith line "[")) (< close 0))
      nil
      (let [rest String (.slice line (+ close 2))
            space Int (.indexOf rest " ")
            kind String (if (< space 0) rest (.slice rest 0 space))
            payload String (if (< space 0) "" (.trim (.slice rest (+ space 1))))]
        (try
          (->ParsedRecord (Number (.slice line 1 close)) kind
                          (if (identical? payload "") {} (JSON/parse payload)))
          (catch Error _ nil))))))

(defn event-item-id
  [execution-id String
   item-id Any] String
  (str execution-id ":" (text item-id)))

(defn safe-sequence [value Any] Int
  (let [candidate Any (Number value)]
    (if (Number/isSafeInteger candidate) candidate 0)))

(defn wire-conversation-item
  [existing ConversationItem?
   id String
   kind String
   title String
   body String
   status String
   item-data Any
   execution-id String
   event Any] ConversationItem
  (owned-conversation-item
   id kind title body status item-data execution-id
   (if existing (conversationitem-at existing) (text (.-at event)))
   (if existing (conversationitem-cursor existing)
     (+ (safe-sequence (.-sequence event)) 1))
   (if existing (conversationitem-sequence existing) 0)))

(defn control-conversation-item
  [execution-id String
   record ParsedRecord
   kind String
   title String
   body String
   status String] ConversationItem
  (let [data Any (or (parsedrecord-data record) {})
        record-sequence Int (parsedrecord-sequence record)
        cursor-candidate Any (Number (.-wireCursor data))
        cursor Any (if (Number/isSafeInteger cursor-candidate)
                 cursor-candidate 9007199254740991)]
    (owned-conversation-item
     (event-item-id execution-id (str "control:" record-sequence))
     kind title body status nil execution-id (text (.-bridgeRecordAt data))
     cursor (+ record-sequence 1))))

(defn append-item-delta!
  [runtime Any
   stream-state Any
   event Any
   id String
   kind String
   title String
   delta String
   status String] Any
  (let [existing (U ConversationItem Nil) (conversation-item-by-id runtime id)
        prior String (if existing (conversationitem-body existing) "")
        actual-title String (if existing (conversationitem-title existing) title)]
    (upsert-conversation!
     runtime
     (wire-conversation-item existing id kind actual-title
                             (clipped (str prior delta) 6000) status
                             (if existing (conversationitem-data existing) nil)
                             (text (.-executionId stream-state)) event))))

(defn wire-content-text [value Any] String
  (cond
    (nil? value) ""
    (identical? (js/typeof value) "string") value
    (Array/isArray value)
    (.join
     (.filter
      (.map value (fn [part Any] String (wire-content-text part)))
      (fn [part String] Bool (not (identical? part ""))))
     "\n")
    :else (safe-json value)))

(defn adopt-wire-model!
  [runtime Any
   model Any
   effort Any] Any
  (when model
    ;; The wire's provider-neutral route is only a fallback; it never replaces
    ;; the concrete provider model already carried by session configuration.
    (let [provider String (text (.-provider model))
          tier String (text (.-tier model))
          label String (cond
                  (and (not (identical? provider ""))
                       (not (identical? tier ""))) (str provider "/" tier)
                  (not (identical? provider "")) provider
                  :else "")]
      (when (and (not (identical? label ""))
                 (identical? (.trim (text (.-sessionModel runtime))) ""))
        (set! (.-sessionModel runtime) label))))
  (let [effort-label String (text effort)]
    (when (not (identical? effort-label ""))
      (set! (.-sessionEffort runtime) effort-label))))

(defn intermediate-provider-session-replacement? [data Any] Bool
  (and (identical? (text (.-status data)) "failed")
       (identical? (text (.-origin data)) "north")
       (identical? (text (.-errorCode data)) "provider_session_replaced")))

(defn handle-wire-message!
  [runtime Any
   stream-state Any
   data Any] Any
  (let [role String (text (.-role data))
        stage String (text (.-stage data))
        execution-id String (text (.-executionId stream-state))
        id String (event-item-id execution-id (.-messageId data))
        body String (clean-text (wire-content-text (.-content data)))
        existing (U ConversationItem Nil) (conversation-item-by-id runtime id)]
    (when (and (identical? role "assistant") (not (.-booting stream-state)))
      (cond
        (identical? stage "started")
        (upsert-conversation!
         runtime
         (wire-conversation-item existing id "assistant" "" "" "running" nil
                                 execution-id data))

        (identical? stage "delta")
        (append-item-delta! runtime stream-state data id "assistant" "" body "running")

        (identical? stage "completed")
        (let [completed-body String (if (identical? body "")
                               (if existing (conversationitem-body existing) "")
                               body)]
          (set! (.-lastAssistantText runtime) completed-body)
          (upsert-conversation!
           runtime
           (wire-conversation-item existing id "assistant" "" completed-body "done" nil
                                   execution-id data)))

        :else nil))))

(defn handle-wire-tool!
  [runtime Any
   stream-state Any
   data Any
   kind String] Any
  (let [id String (event-item-id (text (.-executionId stream-state)) (.-toolCallId data))
        existing (U ConversationItem Nil) (conversation-item-by-id runtime id)]
    (cond
      (identical? kind "tool.admitted")
      (upsert-conversation!
       runtime
       (wire-conversation-item existing id "tool" (text (.-name data))
                               (clean-text (.-argumentPreview data)) "running" nil
                               (text (.-executionId stream-state)) data))

      (identical? kind "tool.progress")
      (append-item-delta! runtime stream-state data id "tool"
                          (if existing (conversationitem-title existing) "Tool activity")
                          (wire-content-text (.-progress data)) "running")

      (identical? kind "tool.terminal")
      (upsert-conversation!
       runtime
       (wire-conversation-item
        existing id "tool"
        (if existing (conversationitem-title existing) "Tool activity")
        (text-or (.-resultPreview data)
                 (if existing (conversationitem-body existing) ""))
        (if (identical? (text (.-status data)) "succeeded") "done" "failed")
        (if existing (conversationitem-data existing) nil)
        (text (.-executionId stream-state)) data))

      :else nil)))

(defn handle-record!
  [runtime Any
   stream-state Any
   record ParsedRecord] Any
  (let [kind String (parsedrecord-kind record)
        data Any (or (parsedrecord-data record) {})
        execution-id String (text (.-executionId stream-state))]
    (cond
      (identical? kind "execution.accepted")
      (let [cwd String (text (.-cwd data))
            prompt String (.trim (text (.-prompt data)))]
        (when (not (identical? cwd ""))
          (set! (.-sessionCwd runtime) cwd))
        (when (and (not (.-booting stream-state))
                   (not (identical? prompt "")))
          (upsert-conversation!
           runtime
           (control-conversation-item execution-id record "user" "" prompt "done"))))

      (identical? kind "session.config")
      (let [model String (.trim (text (.-model data)))
            effort String (.trim (text (.-effort data)))
            cwd String (.trim (text (.-cwd data)))
            permissions String (.trim (text (.-permissionMode data)))]
        (when (not (identical? model "")) (set! (.-sessionModel runtime) model))
        (when (not (identical? effort "")) (set! (.-sessionEffort runtime) effort))
        (when (not (identical? cwd "")) (set! (.-sessionCwd runtime) cwd))
        (when (not (identical? permissions ""))
          (set! (.-sessionPermissions runtime) permissions)))

      (or (identical? kind "control.submit_input")
          (identical? kind "control.redirect_now"))
      (let [input String (.trim (text (.-input data)))]
        (when (not (identical? input ""))
          (upsert-conversation!
           runtime
           (control-conversation-item execution-id record "user" "" input "done"))))

      (identical? kind "control.interrupt_turn")
      (upsert-conversation!
       runtime
       (control-conversation-item
        execution-id record "interrupted" ""
        "Conversation interrupted — tell the model what to do differently."
        "interrupted"))

      (identical? kind "model-call.started")
      (let [booting Any (.-booting stream-state)]
        (adopt-wire-model! runtime (.-model data) (.-effort data))
        (set-execution-working! runtime execution-id true
                                (if booting
                                  (str "Starting " (main-agent-label runtime) "…")
                                  "Agent is working"))
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id (text (.-role stream-state))
                           (if booting "starting" "working"))))

      (identical? kind "message.recorded")
      (handle-wire-message! runtime stream-state data)

      (or (identical? kind "tool.admitted")
          (identical? kind "tool.progress")
          (identical? kind "tool.terminal"))
      (handle-wire-tool! runtime stream-state data kind)

      (identical? kind "run.progress")
      (let [progress Any (or (.-progress data) {})
            action String (text (.-currentAction progress))
            lifecycle String (text (.-lifecycle data))]
        (adopt-wire-model! runtime (.-model progress) (.-effort progress))
        (when (.-branch progress)
          (set! (.-sessionBranch runtime) (text (.-name (.-branch progress)))))
        (if (identical? lifecycle "waiting")
          (set-working! runtime false "")
          (when (not (identical? action "")) (set-working! runtime true action))))

      (identical? kind "artifact.published")
      (let [id String (event-item-id execution-id (.-artifactId data))
            existing (U ConversationItem Nil) (conversation-item-by-id runtime id)]
        (upsert-conversation!
         runtime
         (wire-conversation-item existing id "change"
                                 (text-or (.-label data) "Published artifact")
                                 (text (.-mediaType data)) "done" nil
                                 execution-id data)))

      (identical? kind "model-call.completed")
      (when (not (intermediate-provider-session-replacement? data))
        (set-execution-working! runtime execution-id false ""))

      (identical? kind "session.idle")
      (let [disposition String (text (.-disposition data))
            pending-inputs Any (Number (or (.-pendingInputs data) 0))
            booting Any (.-booting stream-state)]
        (set-execution-working! runtime execution-id false "")
        (cond
          booting (play-sound-event! runtime stream-state "ready")
          (identical? disposition "interrupted")
          (play-sound-event! runtime stream-state "interrupted")
          (and (identical? disposition "completed")
               (<= pending-inputs 0))
          (play-sound-event! runtime stream-state "done")
          :else nil)
        (set! (.-booting stream-state) false)
        (when (not (identical? execution-id ""))
          (bridge-agent! runtime execution-id (text (.-role stream-state)) "ready")))

      (identical? kind "run.terminated")
      (do (set-execution-working! runtime execution-id false "")
          (when (or (identical? (text (.-lifecycle data)) "failed")
                    (identical? (text (.-lifecycle data)) "blocked"))
            (play-sound-event! runtime stream-state "failed")
            (let [id String (event-item-id execution-id (str "terminal:" (.-sequence data)))
                  existing (U ConversationItem Nil) (conversation-item-by-id runtime id)]
              (upsert-conversation!
               runtime
               (wire-conversation-item existing id "error" "Error"
                                       (failure-summary (.-reason data)) "failed" nil
                                       execution-id data))))
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id
                           (text (.-role stream-state)) "offline")))

      (identical? kind "execution.failure")
      (do (set-execution-working! runtime execution-id false "")
          (upsert-conversation!
           runtime
           (control-conversation-item execution-id record "error" "Error"
                                      (str kind ": " (failure-summary data)) "failed")))

      :else nil)))

(js/export
 (defn parse-bridge-stream!
   [runtime Any
    stream-state Any
    chunk String] Any
   (let [lines Any (.split (str (.-buffer stream-state) chunk) "\n")
         remainder Any (.pop lines)]
     (set! (.-buffer stream-state) remainder)
    (.forEach
     lines
     (fn [raw-line String] Any
       (let [line String (.trim raw-line)]
         (cond
           (.startsWith line "execution ")
           (let [execution-id String (.trim (.slice line 10))]
             (set! (.-executionId stream-state) execution-id)
             (set! (.-soundLive stream-state) true)
             (bridge-agent! runtime execution-id (text (.-role stream-state)) "starting"))

           (.startsWith line "attached ")
           (set! (.-soundLive stream-state) true)

           (.startsWith line "[")
           (let [record (U ParsedRecord Nil) (record-line line)]
             (when record (handle-record! runtime stream-state record)))

           ;; The client replaced a stale daemon on its own. That is not an
           ;; error and not a chore — it is one grey line, and then the session
           ;; it was asked for.
           (.startsWith line "northd: ")
           (publish-line! runtime (.slice line 8))

           (.startsWith line "north bridge:")
           (append-error! runtime line)

           :else nil)))))))

(js/export
 (defn launch-route-flags
   [provider Any
    tier Any
    model Any
    effort Any] (Vec String)
   (let [provider-value String (.trim (text provider))
         tier-value String (.trim (text tier))
         model-value String (.trim (text model))
         effort-value String (.trim (text effort))]
     (when (not (or (identical? provider-value "")
                    (identical? provider-value "openai")))
       (throw (new Error "Bridge app launches require provider openai or auto")))
     (.concat []
             (if (identical? provider-value "") [] ["--provider" provider-value])
             (if (identical? tier-value "") [] ["--tier" tier-value])
             (if (identical? model-value "") [] ["--model" model-value])
             (if (identical? effort-value "") [] ["--effort" effort-value])))))

(defn launch-route-summary [runtime Any] String
  (str "next launch: provider " (text-or (.-launchProvider runtime) "auto")
       ", model " (text-or (text-or (.-launchModel runtime)
                                    (text (.-launchTier runtime))) "auto")
       ", effort " (text-or (.-launchEffort runtime) "auto")))

(js/export
 (defn set-launch-route!
   [runtime Any
    name String
    value String] Any
   (let [trimmed String (.trim value)
         choice Any (.toLowerCase trimmed)]
     (when (identical? choice "")
      (throw (new Error (str name " requires a value or auto"))))
    (cond
      (identical? name "provider")
      (do
        (when (not (or (identical? choice "auto")
                       (identical? choice "openai")))
          (throw (new Error "provider requires openai or auto")))
        (set! (.-launchProvider runtime) (if (identical? choice "auto") "" choice)))

      (identical? name "model")
      (if (identical? choice "auto")
        (do (set! (.-launchTier runtime) "")
            (set! (.-launchModel runtime) ""))
        (if (.includes ["economy" "standard" "senior" "frontier"] choice)
          (do (set! (.-launchTier runtime) choice)
              (set! (.-launchModel runtime) ""))
          (do (set! (.-launchTier runtime) "")
              (set! (.-launchModel runtime) trimmed))))

      :else
      (do
        (when (not (or (identical? choice "auto")
                       (.includes ["low" "medium" "high" "xhigh" "max"] choice)))
          (throw (new Error "effort requires low, medium, high, xhigh, max, or auto")))
        (set! (.-launchEffort runtime) (if (identical? choice "auto") "" choice))))
    (publish-line! runtime (launch-route-summary runtime)))))

(js/export
 (defn take-launch-route-flags! [runtime Any] (Vec String)
  (let [flags (Vec String) (launch-route-flags (.-launchProvider runtime)
                                  (.-launchTier runtime)
                                  (.-launchModel runtime)
                                  (.-launchEffort runtime))]
    (set! (.-launchProvider runtime) "")
    (set! (.-launchTier runtime) "")
    (set! (.-launchModel runtime) "")
    (set! (.-launchEffort runtime) "")
    flags)))

;; What the control session is *called* on screen. The role it plays inside the
;; runtime is still "supervisor" — that identifier reaches northd, the journal,
;; and msg routing, and is deliberately not what this returns.
(defn main-agent-label [runtime Any] String
  (let [value String (.trim (text (.-launchProvider runtime)))]
    (cond
      (identical? value "openai") "Codex Main"
      :else "Main")))

(js/export
 (defn launch-thread-id
   [runtime Any
    role String] String
   (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
         selected String (bridgesnapshot-selected-tracked-thing state)]
     (if (identical? role "supervisor")
      (text (.-controlThreadId runtime))
      selected))))

(js/export
 (defn bridge-app-launch-argv!
   [runtime Any
    prompt String
    role String] (Vec String)
   (let [thread-id String (launch-thread-id runtime role)]
     (when (identical? thread-id "")
       (throw (new Error "launch requires a selected tracked thing or managed control identity")))
     (let [route-flags (Vec String) (take-launch-route-flags! runtime)]
       (.concat [(north-bin) "bridge" "app-launch" "--thread" thread-id "--role"
                 (if (identical? role "supervisor") "director" "implementer")]
                route-flags
                [prompt])))))

(defn ^:async launch-agent!
  [runtime Any
   prompt String
   role String] (Promise Any)
  (when (identical? (.trim prompt) "")
    (throw (new Error "launch requires a prompt")))
  (set-working! runtime true (str "Starting " (main-agent-label runtime) "…"))
  (let [stream-state (Map Keyword Any) {:buffer "" :stderr "" :executionId "" :role role
                      :booting (identical? role "supervisor") :soundLive false}
        exit-code Int (await
         (stream-command
          (bridge-app-launch-argv! runtime prompt role)
          (fn [chunk String] Any
            (parse-bridge-stream! runtime stream-state chunk))
          (fn [chunk String] Any
            (set! (.-stderr stream-state)
                  (clipped (str (.-stderr stream-state) chunk) 6000)))))]
    (when (not (identical? exit-code 0))
      (set-working! runtime false "")
      (append-error! runtime
                     (str "Bridge exited " exit-code
                          (if (identical? (.trim (text (.-stderr stream-state))) "") ""
                            (str "\n" (.trim (text (.-stderr stream-state))))))))))

(js/export
 (defn boot!
   [runtime Any
    launch (Fn [String String] (Promise Any))] Any
   (when (not (identical? (launch-thread-id runtime "supervisor") ""))
     (report-promise! runtime (launch SUPERVISOR-BOOT-PROMPT "supervisor")))
   runtime))

(defn popout!
  [runtime Any
   view-id String] Any
  (let [ghostty Any (.which Bun "ghostty")
        kitty Any (.which Bun "kitty")
        wezterm Any (.which Bun "wezterm")
        foot Any (.which Bun "foot")
        xterm Any (.which Bun "xterm")
        argv (U (Vec Any) Nil) (cond
               ghostty [ghostty "-e" (north-bin) "bridge" "--view-id" view-id]
               kitty [kitty "--detach" (north-bin) "bridge" "--view-id" view-id]
               wezterm [wezterm "start" "--always-new-process" "--" (north-bin) "bridge" "--view-id" view-id]
               foot [foot (north-bin) "bridge" "--view-id" view-id]
               xterm [xterm "-e" (north-bin) "bridge" "--view-id" view-id]
               :else nil)]
    (when (nil? argv)
      (throw (new Error "no supported terminal found for pop-out")))
    (let [child Any (.spawn Bun {:cmd argv :stdin "ignore" :stdout "ignore" :stderr "ignore"})]
      (.unref child)
      (publish-line! runtime (str "opened " view-id " in a separate terminal")))))

(def SEMANTIC-ACTION-NAMES (Vec String)
  ["track" "plan" "start" "assign" "request" "ack" "ownership"
   "settle" "show" "history" "inbox"])

(def SEMANTIC-MUTATION-NAMES (Vec String)
  ["track" "plan" "start" "assign" "request" "ack" "ownership" "settle"])

(defn semantic-action? [name String] Bool
  (.includes SEMANTIC-ACTION-NAMES name))

(js/export
 (defn action-arguments [value String] (Vec String)
  (let [trimmed String (.trim value)]
    (if (identical? trimmed "")
      []
      (.map (.split trimmed "|")
            (fn [part String] String (.trim part)))))))

(defn ^:async run-semantic-action!
  [runtime Any
   action String
   argument-text String] (Promise Any)
  (let [request Any (referent-action-request! action (action-arguments argument-text))
        result Any (await
         (run-referent-action!
          request
          {:northExecutable (north-bin)
           :runCommand run-command}))]
    (publish-line! runtime (semantic-action-result-text! request result))
    (when (.includes SEMANTIC-MUTATION-NAMES action)
      (await (refresh! runtime)))))

(js/export
 (defn delegation-argv!
   [north-executable String
    argument-text String] (Vec String)
   (let [north String (.trim north-executable)
         arguments (Vec String) (action-arguments argument-text)]
     (when (or (identical? north "")
              (not (identical? north north-executable))
              (not (.startsWith north "/")))
      (throw (new Error "delegate requires the absolute North executable")))
    (when (identical? (.-length arguments) 0)
      (throw (new Error
              "delegate requires the exact North task and routing arguments")))
    (.concat [north "delegate"] arguments))))

(defn ^:async run-delegation!
  [runtime Any
   argument-text String] (Promise Any)
  (let [argv (Vec String) (delegation-argv! (north-bin) argument-text)]
    (try
      (do
        ;; This is the public delegation command verbatim. No selected tracked
        ;; thing, hidden binding, or semantic Task interpretation is added.
        (await (run-command argv))
        (publish-line! runtime "delegation request accepted by North"))
      (catch Error _
        (throw (new Error "North delegation refused"))))))

;; A cancelled turn gives the message back. The text that started it is
;; remembered at submit time and returned to the composer here, cursor at the
;; end (the input's value setter puts it there), so the thought survives the
;; cancel and can be edited and sent again.
(js/export
 (defn restore-submitted-text!
   [runtime Any
    ui Any] Any
   (let [pending String (text (.-lastSubmitted runtime))
         input Any (.-composerInput ui)]
     (when (and (not (identical? pending "")) input)
      (set! (.-lastSubmitted runtime) "")
      (set! (.-value input) pending)
      (.focus input)))))

;; The one way a turn ends early, whether it was /interrupt, escape or ctrl-c
;; that asked. Everything downstream of "stop" belongs here so the three
;; entrances cannot drift apart.
(defn ^:async cancel-turn!
  [runtime Any
   ui Any
   target String] (Promise Any)
  (when (not (.has (.-bridgeExecutions runtime) target))
    (throw (new Error "interrupt is available for Bridge-launched executions")))
  (await (run-command [(north-bin) "bridge" "interrupt" target]))
  (set-execution-working! runtime target false "")
  (restore-submitted-text! runtime ui))

(defn ^:async submit-agent!
  [runtime Any
   ui Any
   input String
   selection String] (Promise Any)
  (let [trimmed String (.trim input)
        slash? Any (.startsWith trimmed "/")
        parsed ParsedCommand (command input)
        name String (parsedcommand-name parsed)
        rest String (parsedcommand-rest parsed)
        target String (text-or selection (text (.-supervisorId runtime)))]
    (if (handle-local-command! runtime ui input)
      nil
      (cond
      (and slash? (identical? name "launch")) (await (launch-agent! runtime rest "worker"))
      (and slash? (identical? name "delegate")) (await (run-delegation! runtime rest))
      (and slash? (identical? name "refresh")) (await (refresh! runtime))
      (and slash? (identical? name "popout"))
      (popout! runtime (text-or rest (text (.-activeView runtime))))
      :else
      (do
        (when (identical? target "")
          (throw (new Error "select an agent before messaging or interrupting")))
        (if (and slash? (identical? name "interrupt"))
          (await (cancel-turn! runtime ui target))
          ;; Plain text is the message. There is no command spelling of it:
          ;; typing into the composer already messages the selected agent, so
          ;; a /msg verb would only be ceremony in front of the same path.
          (let [message String trimmed]
            (when (identical? message "") (throw (new Error "nothing to send")))
            ;; Bridge submissions are projected from the durable control record
            ;; observed on this execution's stream. Only unmanaged roster rows
            ;; need a local row; both cases retain the chosen target as owner.
            (when (not (.has (.-bridgeExecutions runtime) target))
              (let [id String (next-item-id! runtime "user")]
                (upsert-conversation!
                 runtime
                 (owned-conversation-item id "user" "" message "done" nil target
                                          (.toISOString (new Date))
                                          (.-itemSequence runtime) 1))))
            ;; What a cancel would hand back: the message this turn started with.
            (set! (.-lastSubmitted runtime) message)
            (if (.has (.-bridgeExecutions runtime) target)
              (set-execution-working! runtime target true "Codex is working")
              (set-working! runtime true "Codex is working"))
            (if (.has (.-bridgeExecutions runtime) target)
              (await (run-command [(north-bin) "bridge" "msg" target message]))
              (await (run-command [(north-bin) "msg" target message])))
            (.render runtime))))))))

(defn ^:async submit-work!
  [runtime Any
   ui Any
   input String] (Promise Any)
  (let [trimmed String (.trim input)
        slash? Any (.startsWith trimmed "/")
        parsed ParsedCommand (command input)
        name String (parsedcommand-name parsed)
        rest String (parsedcommand-rest parsed)]
    (if (not slash?)
      (throw (new Error
              "tracked-thing text requires an explicit /request or /delegate command"))
      (if (handle-local-command! runtime ui input)
      nil
      (cond
      (identical? name "filter")
      (do (set! (.-model runtime) (set-filter (.-model runtime) rest)) (.render runtime))

      (identical? name "refresh") (await (refresh! runtime))
      (identical? name "popout") (popout! runtime (if (identical? rest "") (.-activeView runtime) rest))

      (identical? name "delegate") (await (run-delegation! runtime rest))
      (semantic-action? name) (await (run-semantic-action! runtime name rest))

      :else
      (throw (new Error "unknown tracked-thing command; use /help")))))))

(defn report-promise!
  [runtime Any
   promise Any] Any
  (.catch promise
          (fn [error Any] Any
            (publish-line! runtime (str "error: " (error-message error))))))

(defn select-view!
  [runtime Any
   view String] Any
  (set! (.-view runtime) (canonical-top-level-view view))
  (set! (.-paletteIndex runtime) 0)
  (set! (.-workspaceNotice runtime) "")
  (clear-strip-focus! runtime))

;; Swapping which view is on screen. The composer is shared by both and keeps
;; the cursor throughout — there is no pane to focus, only a view to show.
(defn show-view!
  [runtime Any
   ui Any
   view String] Any
  (select-view! runtime view)
  (.focus (.-composerInput ui))
  (.render runtime))

(defn strip-segments [runtime Any] (Vec AgentSegment)
  (agent-segments (bridgesnapshot-agents (snapshot (.-model runtime)))))

;; The composer keeps its content when focus moves to the strip; it only loses
;; the cursor, so nothing typed can be swallowed by the strip's h/l/j/k bindings.
(defn focus-strip!
  [runtime Any
   ui Any] Any
  (set! (.-stripFocused runtime) true)
  (.blur (.-composerInput ui))
  (.render runtime))

(defn leave-strip!
  [runtime Any
   ui Any] Any
  (set! (.-stripFocused runtime) false)
  (when (detail-showing? runtime "agents") (close-detail! runtime))
  (.focus (.-composerInput ui))
  (.render runtime))

(defn clear-strip-focus! [runtime Any] Any
  (when (.-stripFocused runtime)
    (set! (.-stripFocused runtime) false)
    (when (detail-showing? runtime "agents") (close-detail! runtime))))

(defn show-segment-detail!
  [runtime Any
   index Int] Any
  (let [segments (Vec AgentSegment) (strip-segments runtime)]
    (when (> (.-length segments) 0)
      (let [selected Int (clamped-index index (.-length segments))]
        (set! (.-stripIndex runtime) selected)
        (set! (.-detailSegment runtime)
              (agentsegment-id (nth segments selected)))
        (set! (.-detailIndex runtime) 0)
        (open-detail! runtime "agents")))))

(defn toggle-segment-detail! [runtime Any] Any
  (if (detail-showing? runtime "agents")
    (close-detail! runtime)
    (show-segment-detail! runtime (.-stripIndex runtime))))

(defn move-strip-segment!
  [runtime Any
   delta Int] Any
  (let [segments (Vec AgentSegment) (strip-segments runtime)
        total Int (.-length segments)]
    (when (> total 0)
      (let [strip-index Int (.-stripIndex runtime)
            next-index Int (mod (+ strip-index delta total) total)]
        (set! (.-stripIndex runtime) next-index)
        (set! (.-detailIndex runtime) 0)
        (when (detail-showing? runtime "agents")
          (set! (.-detailSegment runtime)
                (agentsegment-id (nth segments next-index))))))))

(defn move-detail-cursor!
  [runtime Any
   delta Int] Any
  (let [total Int (.-length (detail-agents runtime))]
    (when (> total 0)
      (set! (.-detailIndex runtime)
            (mod (+ (clamped-index (.-detailIndex runtime) total) delta total)
                 total)))))

(defn active-input
  [_runtime Any
   ui Any] Any
  (.-composerInput ui))

(defn active-palette-options
  [runtime Any
   ui Any] (Vec SlashCommand)
  (let [view String (text (.-view runtime))
        input Any (active-input runtime ui)]
    (palette-options view (text (.-value input)))))

;; The composer's editing keys. Nothing else registers a layer any more: with
;; one view on screen there are no window chords to arbitrate.
(defn install-composer-keymap!
  [runtime Any
   renderer CliRenderer] Any
  (let [keymap (Keymap Renderable KeyEvent) (createDefaultOpenTuiKeymap renderer)]
    (registerEmacsBindings keymap)
    (registerEscapeClearsPendingSequence keymap)
    (set! (.-keymap runtime) keymap)))

;; The text completion writes for an entry: its completion when it carries one,
;; its own name otherwise, plus the space an argument is going to need. One
;; definition, so "did completion already run?" is answerable by comparison.
(defn palette-completion-text [candidate SlashCommand] String
  (let [completion String (slashcommand-completion candidate)]
    (if (identical? completion "")
      (str (slashcommand-name candidate)
           (if (slashcommand-arguments candidate) " " ""))
      completion)))

(defn palette-candidate
  [runtime Any
   commands (Vec SlashCommand)] SlashCommand
  (nth commands
        (Math/max 0 (Math/min (.-paletteIndex runtime) (- (.-length commands) 1)))))

(defn complete-palette!
  [runtime Any
   ui Any
   commands (Vec SlashCommand)] Any
  (when (> (.-length commands) 0)
    (let [candidate SlashCommand (palette-candidate runtime commands)
          input Any (active-input runtime ui)]
      (set! (.-value input) (palette-completion-text candidate))
      (set! (.-paletteIndex runtime) 0)
      (.focus input)
      (render-minibuffer! runtime ui))))

;; The one way a line leaves the composer, whether the user typed it and hit
;; enter or the palette fired a command on their behalf. The composer is
;; cleared first so the view never shows a line that is already in flight.
(js/export
 (defn submit-input!
   [runtime Any
    ui Any
    input String] Any
   (when (not (identical? input ""))
    (set! (.-value (.-composerInput ui)) "")
    (set! (.-paletteIndex runtime) 0)
    (if (identical? (text (.-view runtime)) "agents")
      (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
            selected String (selected-semantic-agent-id state (.-agentIndex runtime))]
        (report-promise! runtime (submit-agent! runtime ui input selected)))
      (report-promise! runtime
                       (submit-work! runtime ui input))))))

;; Pure: what enter means while the palette is open, given the highlighted
;; entry. A command that takes no arguments has nothing left to say, so enter
;; runs it — one keystroke, not two. A command that takes arguments completes
;; into the composer instead, because firing it bare would only earn an error;
;; the same goes for the emoji and glyph pickers, whose entries are text to
;; insert rather than commands. Once the composer already holds exactly what
;; completion would write, enter has nothing left to complete and fires.
(js/export
 (defn palette-enter-action
   [matches Int
    takes-arguments? Bool
    insert-only? Bool
    completed? Bool] String
   (cond
    (< matches 1) ""
    completed? "fire"
    (or insert-only? takes-arguments?) "complete"
    :else "fire")))

(defn install-input!
  [runtime Any
   ui Any] Any
  (.on (.-composerInput ui) (.-INPUT InputRenderableEvents)
       (fn [_value Any] Any
         (set! (.-paletteIndex runtime) 0)
         (render-minibuffer! runtime ui)))
  (.on (.-composerInput ui) (.-ENTER InputRenderableEvents)
       (fn [] Any
         (submit-input! runtime ui (.trim (text (.-value (.-composerInput ui))))))))

;; Pure fixed geometry for the exact public bar `Agents | Goals | All > ...`.
(js/export
 (defn view-tab-id-at!
   [_view Any
    _views (Vec WorkView)
    column Int] String
   (cond
    (and (>= column 0) (< column 6)) "agents"
    (and (>= column 9) (< column 14)) "goals"
    (and (>= column 17) (< column 20)) "all"
    :else "")))

(defn view-tab-at!
  [runtime Any
   tabs Any
   event Any
   views (Vec WorkView)] String
  (let [event-x Number (.-x event)
        tabs-x Number (.-x tabs)
        column Int (Math/floor (- event-x tabs-x))]
    (view-tab-id-at! (.-view runtime) views column)))

(defn complete-clicked-palette!
  [runtime Any
   ui Any
   view String
   palette-renderable Any
   event Any] Any
  (when (identical? (.-button event) 0)
    (select-view! runtime view)
    ;; The palette scrolls, so screen row N is option start+N. Rows past
    ;; the option rows are the overflow line, which is not clickable.
    (let [input Any (.-composerInput ui)
          options (Vec SlashCommand) (palette-options view (text (.-value input)))
          event-y Number (.-y event)
          palette-y Number (.-y palette-renderable)
          row Int (Math/floor (- event-y palette-y))
          scrolled Any (.-paletteStart runtime)
          start Int (if scrolled scrolled 0)
          drawn Any (.-paletteRows runtime)
          rows Int (if drawn drawn 0)
          picked Int (+ start row)
          option-count Int (.-length options)]
      (when (and (>= row 0) (< row rows) (< picked option-count))
        (.preventDefault event)
        (.stopPropagation event)
        (set! (.-paletteIndex runtime) picked)
        (complete-palette! runtime ui options)))))

(defn handle-list-click!
  [runtime Any
   ui Any
   event Any] Any
  (when (and (identical? (.-button event) 0)
             (tracked-thing-view? (.-view runtime)))
    (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
          view WorkView (selected-view state (text (.-view runtime)))
          items Any (workview-items view)
          event-y Number (.-y event)
          list-y Number (.-screenY (.-workText ui))
          row-index Int (Math/floor (- event-y list-y))]
      (when (and (>= row-index 0) (< row-index (.-length items)))
        (let [item TrackedThing (nth items row-index)]
          (.preventDefault event)
          (.stopPropagation event)
          (set! (.-workIndex runtime) row-index)
          (set! (.-model runtime)
                (select-tracked-thing (.-model runtime)
                                      (trackedthing-id item)))
          (.render runtime))))))

(defn install-mouse!
  [runtime Any
   ui Any] Any
  (set! (.-onMouseDown (.-composer ui))
        (fn [event Any] Any
          (when (identical? (.-button event) 0)
            (.stopPropagation event)
            (clear-strip-focus! runtime)
            (.focus (.-composerInput ui))
            (.render runtime))))
  (set! (.-onMouseDown (.-agentStripText ui))
        (fn [event Any] Any
          (when (identical? (.-button event) 0)
            (.preventDefault event)
            (.stopPropagation event)
            (let [segments (Vec AgentSegment) (strip-segments runtime)
                  event-x Number (.-x event)
                  strip-x Number (.-screenX (.-agentStripText ui))
                  column Int (Math/floor (- event-x strip-x))
                  index Int (segment-at-column segments column)]
              (when (>= index 0) (show-segment-detail! runtime index))
              (focus-strip! runtime ui)))))
  (set! (.-onMouseDown (.-composerPalette ui))
        (fn [event Any] Any
          (complete-clicked-palette! runtime ui (text (.-view runtime))
                                     (.-composerPalette ui) event)))
  (set! (.-onMouseDown (.-workText ui))
        (fn [event Any] Any
          (handle-list-click! runtime ui event)))
  (set! (.-onMouseDown (.-viewTabsText ui))
        (fn [event Any] Any
          (when (identical? (.-button event) 0)
            (let [tab String (view-tab-at! runtime (.-viewTabsText ui) event
                                   (view-list (snapshot (.-model runtime))))]
              (when (not (identical? tab ""))
                (.preventDefault event)
                (.stopPropagation event)
                (show-view! runtime ui tab)))))))

;; Climb one rung, whoever asked. The key and its command spellings share this,
;; so "what does escape do here" has exactly one answer. Returns
;; whether anything was claimed, which is what tells the key handler to swallow
;; the keystroke and the command handler that it was a command.
(defn escape-step!
  [runtime Any
   ui Any] Bool
  (let [palette (Vec SlashCommand) (active-palette-options runtime ui)
        action String (escape-rung (> (.-length palette) 0)
                            (panel-filtering? runtime)
                            (detail-open? runtime)
                            (if (.-stripFocused runtime) true false)
                            (tracked-thing-view? (.-view runtime))
                            (if (.-working runtime) true false))]
    (cond
      (identical? action "close-palette")
      (do (set! (.-value (active-input runtime ui)) "")
          (render-minibuffer! runtime ui)
          true)

      (identical? action "clear-filter")
      (do (clear-panel-filter! runtime) (.render runtime) true)

      (identical? action "close-detail")
      ;; The keyboard goes back where it came from: the panel had it while it
      ;; was open, and the composer gets it the moment the panel is gone.
      (do (close-detail! runtime) (focus-composer! runtime ui) (.render runtime)
          true)

      (identical? action "focus-composer")
      (do (leave-strip! runtime ui) (.render runtime) true)

      (identical? action "show-agents")
      (do (show-view! runtime ui "agents") true)

      (identical? action "cancel-turn")
      (let [target String (text (.-supervisorId runtime))]
        (when (not (identical? target ""))
          (report-promise! runtime (cancel-turn! runtime ui target)))
        true)

      :else false)))

;; The panel tenants that are lists of rows, which is what there is to filter.
;; The agent roster is a list too, but it is reached through the strip, whose
;; keymap already spends the bare letters on navigation — it would be filtering
;; and steering with the same keystroke, so it keeps the keys it has.
(defn panel-filterable? [runtime Any] Bool
  (or (detail-showing? runtime "config") (detail-showing? runtime "help")))

;; Pure: the one character this keystroke types into a query, or "" for
;; everything that is not a character — chords, function keys, the arrows the
;; panel already spends on its cursor. Space is deliberately absent: inside an
;; open panel it flips the selected row, and stealing it for the query would
;; take away the panel's own verb.
(js/export
 (defn filter-character
   [name String
    sequence String
    ctrl? Bool
    meta? Bool] String
   (if (or ctrl? meta?
          (identical? name "space")
          (not (identical? (.-length sequence) 1))
          (< (.charCodeAt sequence 0) 32))
    ""
    sequence)))

;; Pure: what a keystroke means to the filter. `/` opens it, a character types
;; into it, backspace edits it — and a backspace on an empty query is the way
;; out, the same "one more press and the thing you opened is gone" the ladder
;; spells with escape.
(js/export
 (defn filter-key-action
   [filtering? Bool
    query String
    name String
    character String] String
   (cond
    (and (not filtering?) (identical? character "/")) "open"
    (not filtering?) ""
    (identical? name "backspace")
    (if (identical? query "") "close" "erase")
    (not (identical? character "")) "type"
    :else "")))

(defn ctrl-down-key?
  [name String
   key Any] Bool
  (and (.-ctrl key) (identical? name "j")))

(defn bare-letter?
  [name String
   key Any
   letter String] Bool
  (and (identical? name letter)
       (not (.-ctrl key))
       (not (or (.-meta key) (.-option key)))))

(defn ctrl-up-key?
  [name String
   key Any] Bool
  (and (.-ctrl key) (identical? name "k")))

(defn bare-key?
  [name String
   key Any
   letter String] Bool
  (and (identical? name letter)
       (not (.-ctrl key))
       (not (or (.-meta key) (.-option key)))))

;; Keys the strip claims once it holds focus. Everything else falls through to
;; the branches below, so nothing the strip does not name is stolen.
(defn strip-key?
  [name String
   key Any] Bool
  (or (identical? name "left")
      (identical? name "right")
      (identical? name "up")
      (identical? name "down")
      (submit-key? name)
      (ctrl-down-key? name key)
      (ctrl-up-key? name key)
      (bare-key? name key "h")
      (bare-key? name key "l")
      (bare-key? name key "j")
      (bare-key? name key "k")))

(js/export
 (defn install-keys!
   [runtime Any
    ui Any] Any
   (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key Any] Any
         (when (and (not (.-defaultPrevented key))
                    (not (.-propagationStopped key)))
           (let [name Any (.toLowerCase (text (.-name key)))
                 meta Any (or (.-meta key) (.-option key))
                 palette (Vec SlashCommand) (active-palette-options runtime ui)
                 palette-open Bool (> (.-length palette) 0)
                 plain-view-arrow Any (and (top-level-view? (.-view runtime))
                      (identical? (.trim (text (.-value (.-composerInput ui)))) "")
                      (not (.-ctrl key))
                      (not meta)
                      (or (identical? name "left") (identical? name "right")))]
             (cond
             ;; Escape is the ladder and nothing else: one rung per press, and
             ;; whatever rung it lands on, no other branch below gets a say.
             (or (identical? name "escape") (identical? name "esc"))
             (when (escape-step! runtime ui)
               (.preventDefault key)
               (.stopPropagation key))

             ;; The docked switchboard owns the arrows only while the composer
             ;; is quiet, and it owns them over the filtered rows: the cursor
             ;; walks what is on screen, never the rows a query hid.
             ;; ctrl-j is "down into the docked thing" wherever the cursor is.
             ;; With a panel open and unfocused — you pressed `@` and went back
             ;; to your sentence — it is how you climb back into it, which is
             ;; the same key that descends into the strip and one fewer verb to
             ;; learn.
             (and (detail-open? runtime)
                  (not (panel-focused? runtime))
                  (not palette-open)
                  (ctrl-down-key? name key))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (focus-panel! runtime ui)
                 (.render runtime))

             ;; Ctrl-K leaves an expanded Agents panel in the same direction
             ;; as escape: collapse the panel and return the keyboard to the
             ;; composer. The strip owns Ctrl-K only after the strip itself
             ;; has focus; an open Agents panel owns it here.
             (and (detail-showing? runtime "agents")
                  (panel-focused? runtime)
                  (not palette-open)
                  (ctrl-up-key? name key))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (close-detail! runtime)
                 (focus-composer! runtime ui)
                 (.render runtime))

             (and (detail-showing? runtime "config")
                  (panel-focused? runtime)
                  (not palette-open)
                  (or (identical? name "up") (identical? name "down")
                      (ctrl-up-key? name key) (ctrl-down-key? name key)
                      (identical? name "space") (submit-key? name)))
             (let [up? Any (or (identical? name "up") (ctrl-up-key? name key))
                   down? Any (or (identical? name "down") (ctrl-down-key? name key))]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (or up? down?)
                 (let [total Int (.-length (config-panel-rows runtime))]
                   (when (> total 0)
                     (let [raw Any (.-configIndex runtime)
                           current Int (if raw raw 0)
                           delta Int (if up? -1 1)]
                       (set! (.-configIndex runtime)
                             (mod (+ current delta total) total)))))

                 (identical? name "space")
                 (report-promise! runtime (toggle-config-entry! runtime))

                 :else
                 (report-promise! runtime (edit-config-entry! runtime)))
               (.render runtime))

             ;; `@` writes the selected row into the sentence you are about to
             ;; send, and hands the keyboard back so you can finish it. The
             ;; panel stays open behind the composer, dimmed, because you are
             ;; probably about to reference a second row.
             (and (detail-showing? runtime "config")
                  (panel-focused? runtime)
                  (not (panel-filtering? runtime))
                  (not palette-open)
                  (identical? (filter-character name (text (.-sequence key))
                                                (if (.-ctrl key) true false)
                                                (if meta true false))
                              "@"))
             (let [rows Any (config-panel-rows runtime)
                   total Any (.-length rows)]
               (.preventDefault key)
               (.stopPropagation key)
               (when (> total 0)
                 (let [entry Any (nth rows (clamped-index (.-configIndex runtime)
                                                       total))
                       input Any (active-input runtime ui)]
                   (set! (.-value input)
                         (str (text (.-value input))
                              (config-reference-text (configentry-kind entry)
                                                     (configentry-name entry))))
                   (focus-composer! runtime ui)
                   (render-minibuffer! runtime ui)))
               (.render runtime))

             ;; `/` inside an open panel starts a filter rather than a slash
             ;; command: the rows in front of you are what a slash means while
             ;; you are looking at them. Everything typed after it goes to the
             ;; query and never to the composer, so a filtered panel cannot
             ;; leave half a search sitting in the message you send next.
             (and (panel-filterable? runtime)
                  (panel-focused? runtime)
                  (not palette-open)
                  (not (identical?
                        (filter-key-action
                         (panel-filtering? runtime)
                         (panel-query runtime)
                         name
                         (filter-character name (text (.-sequence key))
                                           (if (.-ctrl key) true false)
                                           (if meta true false)))
                        "")))
             (let [character String (filter-character name (text (.-sequence key))
                                               (if (.-ctrl key) true false)
                                               (if meta true false))
                   query String (panel-query runtime)
                   action String (filter-key-action (panel-filtering? runtime) query
                                             name character)]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (identical? action "open") (set-panel-query! runtime "")
                 (identical? action "type")
                 (set-panel-query! runtime (str query character))
                 (identical? action "erase")
                 (let [query-length Int (.-length query)]
                   (set-panel-query! runtime
                                     (.slice query 0 (- query-length 1))))
                 :else (clear-panel-filter! runtime))
               (.render runtime))

             ;; A focused panel eats the rest of the alphabet. Outside filter
             ;; mode the letters mean nothing here, and letting them fall
             ;; through to the composer is exactly the split brain this focus
             ;; model exists to end: keys you press while looking at a list must
             ;; not silently accumulate in a message you are not writing.
             (and (panel-focused? runtime)
                  (not palette-open)
                  (not (identical? (filter-character name
                                                     (text (.-sequence key))
                                                     (if (.-ctrl key) true false)
                                                     (if meta true false))
                                   "")))
             (do (.preventDefault key)
                 (.stopPropagation key))

             (and (.-stripFocused runtime) (strip-key? name key))
             (let [expanded? Bool (detail-showing? runtime "agents")
                   up? Any (or (identical? name "up")
                           (ctrl-up-key? name key)
                           (bare-key? name key "k"))
                   down? Any (or (identical? name "down")
                             (ctrl-down-key? name key)
                             (bare-key? name key "j"))
                   left? Any (or (identical? name "left") (bare-key? name key "h"))
                   right? Any (or (identical? name "right") (bare-key? name key "l"))]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (submit-key? name) (toggle-segment-detail! runtime)
                 left? (move-strip-segment! runtime -1)
                 right? (move-strip-segment! runtime 1)
                 up? (if expanded?
                       (move-detail-cursor! runtime -1)
                       (leave-strip! runtime ui))
                 down? (if expanded?
                         (move-detail-cursor! runtime 1)
                         (toggle-segment-detail! runtime))
                 :else nil)
               (.render runtime))

             (and palette-open
                  (or (identical? name "up")
                      (identical? name "down")
                      (and (.-ctrl key)
                           (or (identical? name "j") (identical? name "k")))))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (let [palette-index Int (.-paletteIndex runtime)
                       palette-delta Int (if (or (identical? name "up")
                                                  (and (.-ctrl key) (identical? name "k")))
                                             -1 1)
                       palette-count Int (.-length palette)]
                   (set! (.-paletteIndex runtime)
                         (mod (+ palette-index palette-delta palette-count)
                              palette-count)))
                 (.focus (active-input runtime ui))
                 (render-minibuffer! runtime ui))

             ;; Tab always completes; that is all tab has ever meant here.
             (and palette-open (identical? name "tab"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (complete-palette! runtime ui palette))

             (and palette-open (submit-key? name))
             (let [candidate SlashCommand (palette-candidate runtime palette)
                   completed String (palette-completion-text candidate)
                   current String (text (.-value (active-input runtime ui)))
                   action String (palette-enter-action (.-length palette)
                                                (slashcommand-arguments candidate)
                                                (slashcommand-emoji candidate)
                                                (identical? current completed))]
               (.preventDefault key)
               (.stopPropagation key)
               (if (identical? action "fire")
                 (submit-input! runtime ui (.trim completed))
                 (complete-palette! runtime ui palette)))

             ;; Down leaves the composer only when the composer has nothing to
             ;; move through: no palette open and an empty line. Ctrl-J is the
             ;; unconditional way in, so the strip is never unreachable.
             (and (not (.-stripFocused runtime))
                  (not palette-open)
                  (or (ctrl-down-key? name key)
                      (and (identical? name "down")
                           (not (.-ctrl key))
                           (not meta)
                           (identical? (.trim (text (.-value (.-composerInput ui)))) ""))))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (focus-strip! runtime ui))

             (or (identical? name "tab") (identical? name "f2"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (show-view! runtime ui (tab-swap-view (text (.-view runtime)))))

             (identical? name "f1")
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (toggle-help! runtime ui))

             (or (identical? name "f3")
                 plain-view-arrow
                 (and meta (or (identical? name "h") (identical? name "l"))))
             (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
                   views (Vec WorkView) (view-list state)
                   current WorkView (selected-view state (.-activeView runtime))
                   index Int (.findIndex views
                                     (fn [view WorkView] Bool
                                       (identical? (workview-id view)
                                                   (workview-id current))))
                   delta Int (if (or (identical? name "left")
                                       (and meta (identical? name "h"))) -1 1)
                   view-count Int (.-length views)
                   next-index Int (mod (+ index delta view-count) view-count)
                   next-id String (text (.-id (nth views next-index)))]
               (.preventDefault key)
               (.stopPropagation key)
               (show-view! runtime ui next-id))

             (or (identical? name "f5") (and (.-ctrl key) (identical? name "r")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (report-promise! runtime (refresh! runtime)))

             (or (identical? name "f6") (and (.-ctrl key) (identical? name "o")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (popout! runtime (.-activeView runtime)))

             (and meta (or (identical? name "j") (identical? name "k")))
             (let [state north.bridge.model/BridgeSnapshot (snapshot (.-model runtime))
                   delta Int (if (identical? name "k") -1 1)]
               (.preventDefault key)
               (.stopPropagation key)
               (if (identical? (text (.-view runtime)) "agents")
                 (let [agents Any (bridgesnapshot-semantic-agents state)
                       agent-count Int (.-length agents)
                       max-index Int (Math/max 0 (- agent-count 1))
                       agent-index Int (.-agentIndex runtime)
                       next-index Int (Math/max 0 (Math/min max-index (+ agent-index delta)))
                       selected-agent-id String (if (> agent-count 0)
                                           (trackedthing-id (nth agents next-index)) "")]
                   (set! (.-agentIndex runtime) next-index)
                   (set! (.-model runtime)
                         (select-tracked-thing (.-model runtime) selected-agent-id)))
                 (let [view WorkView (selected-view state (.-activeView runtime))
                       items Any (workview-items view)
                       item-count Int (.-length items)
                       max-index Int (Math/max 0 (- item-count 1))
                       work-index Int (.-workIndex runtime)
                       next-index Int (Math/max 0 (Math/min max-index
                                                        (+ work-index delta)))
                       tracked-thing-id String (if (> item-count 0)
                                           (trackedthing-id (nth items next-index)) "")]
                   (set! (.-workIndex runtime) next-index)
                   (set! (.-model runtime)
                         (select-tracked-thing (.-model runtime) tracked-thing-id))
                   (.scrollBy (.-workScroll ui) delta "step")))
               (.render runtime))

             ;; Ctrl-C means one thing and only one thing here: stop the turn in
             ;; flight. With nothing running it does nothing at all — it is
             ;; never a way out of North, /q is.
             (and (.-ctrl key) (identical? name "c"))
             (let [target String (text (.-supervisorId runtime))]
               (.preventDefault key)
               (.stopPropagation key)
               (when (and (.-working runtime) (not (identical? target "")))
                 (report-promise! runtime (cancel-turn! runtime ui target))))

             :else nil)))))))

;; One view at a time: the workspace holds two full-width containers and shows
;; exactly one. The single-row InputRenderable gets one line and no vertical
;; padding; the fill remains.
(defn ^:async open-app!
  [view-id String
   source-identity String] (Promise Any)
  (let [view String (canonical-top-level-view view-id)
        renderer-promise (Promise CliRenderer) (createCliRenderer {:exitOnCtrlC false :clearOnShutdown true})
        renderer CliRenderer (await renderer-promise)
        runtime (Map Keyword Any) {:model (make-model view)
                 :renderer renderer
                 :disposed false
                 :rendererSuspended false
                 :suspendResume nil
                 :suspendError ""
                 :view view
                 :activeView view
                 :agentIndex 0
                 :workIndex 0
                 :collapsedListConditions (new Set ["blocked" "dormant" "draft"
                                                   "terminal" "other"])
                 :workScroll nil
                 :boardSignature ""
                 :dragThreadId ""
                 :bridgeExecutions (new Set)
                 :supervisorId ""
                 :conversation []
                 :transcriptView "selected"
                 :itemSequence 0
                 :lastAssistantText ""
                 ;; The text a cancel hands back to the composer.
                 :lastSubmitted ""
                 :working false
                 :workingExecutions (new Set)
                 :workingLabel ""
                 :workingSince 0
                 :spinnerIndex 0
                 :spinnerTimer nil
                 :stripFocused false
                 :stripIndex 0
                 :detailView ""
                 :detailSegment "all"
                 :detailIndex 0
                 :paletteIndex 0
                 :paletteStart 0
                 :paletteRows 0
                 :promptGlyph DEFAULT-PROMPT-GLYPH
                 :soundEnabled (sound-enabled-from-env
                                (text (.-NORTH_BRIDGE_SOUND (.-env process))))
                 :soundPack (sound-pack-from-env
                             (text (.-NORTH_BRIDGE_SOUND_PACK (.-env process))))
                 :soundDirectory (sound-directory-from-env
                                  (text (.-NORTH_BRIDGE_SOUND_DIR (.-env process))))
                 :soundPlayer (discover-sound-player)
                 :soundChildren (new Set)
                 :soundWarningShown false
                 :soundSequence 0
                 :lastSoundPath ""
                 :lastSoundAt 0
                 :workspaceNotice ""
                 :keymap nil
                 :sessionModel (text-or (.-NORTH_BRIDGE_MODEL (.-env process))
                                        (text (.-AGENT_MODEL (.-env process))))
                 :sessionEffort (text (.-AGENT_REASONING (.-env process)))
                 :launchProvider (text (.-NORTH_BRIDGE_PROVIDER (.-env process)))
                 :launchTier (text (.-NORTH_BRIDGE_TIER (.-env process)))
                 :launchModel (text (.-NORTH_BRIDGE_MODEL (.-env process)))
                 :launchEffort (text (.-NORTH_BRIDGE_EFFORT (.-env process)))
                 :controlThreadId
                 (text-or (text (.-NORTH_BRIDGE_CONTROL_THREAD (.-env process)))
                          (text-or (text (.-NORTH_THREAD_ID (.-env process)))
                                   (text (.-AGENT_THREAD (.-env process)))))
                 :sessionCwd (text (.cwd process))
                 :sessionBranch ""
                 ;; Reported by the session, not guessed here: until it says,
                 ;; the banner says `pending` rather than a mode nobody set.
                 :sessionPermissions ""
                 :sourceIdentity source-identity
                 :renderConversation (fn [] Any nil)
                 :render (fn [] Any nil)}
        root Any (new BoxRenderable renderer
                             ;; Symmetric side margins, one row of headroom on
                             ;; top, and nothing below: the bottom stack is
                             ;; anchored flush to the terminal's last row.
                             {:flexDirection "column" :width "100%" :height "100%"
                              :gap 0 :paddingTop 1 :paddingBottom 0
                              :paddingLeft 1 :paddingRight 1
                              :onSizeChange (fn [] Any (.render runtime))})
        workspace Any (new BoxRenderable renderer {:flexDirection "row" :width "100%"
                                             :flexGrow 1 :gap 0})
        view-tabs-text Any (new TextRenderable renderer {:height 1 :width "100%" :flexShrink 0
                                                    :wrapMode "none" :truncate true})
        agents-pane Any (new BoxRenderable renderer {:flexDirection "column" :width "100%"})
        work-pane Any (new BoxRenderable renderer {:flexDirection "column" :width "100%"})
        transcript-scroll Any (new ScrollBoxRenderable renderer {:flexGrow 1 :scrollY true
                                                           :stickyScroll true :stickyStart "bottom"
                                                           :viewportCulling true
                                                           :verticalScrollbarOptions {:visible false}})
        transcript-text-view Any (new TextRenderable renderer {:width "100%" :flexShrink 0 :wrapMode "word"})
        work-scroll Any (new ScrollBoxRenderable renderer {:flexGrow 1 :scrollY true :viewportCulling true
                                                     :verticalScrollbarOptions {:visible false}})
        work-text-view Any (new TextRenderable renderer {:width "100%" :flexShrink 0
                                                   :wrapMode "none" :truncate true})
        board-root Any (new BoxRenderable renderer {:visible false :width "100%"
                                             :flexDirection "column" :flexShrink 0 :gap 1})
        status-text Any (new TextRenderable renderer {:flexShrink 0 :wrapMode "word"})
        agent-status-text Any (new TextRenderable renderer {:visible false :flexShrink 0 :wrapMode "word"})
        composer-palette Any (new TextRenderable renderer {:visible false :height 1 :width "100%" :flexShrink 0
                                                     :wrapMode "none" :truncate true :bg "#25272d"})
        composer Any (new BoxRenderable renderer {:flexDirection "row" :width "100%" :height 1
                                            :paddingLeft 1 :paddingRight 1
                                            :flexShrink 0 :backgroundColor "#25272d"})
        agent-strip-text Any (new TextRenderable renderer {:height 1 :width "100%" :flexShrink 0
                                                     :wrapMode "none" :truncate true})
        detail-panel Any (new BoxRenderable renderer {:visible false :width "100%" :height 5
                                               :flexDirection "column" :flexShrink 0
                                               :border true :borderColor "#64748b"
                                               :paddingLeft 1 :paddingRight 1})
        detail-text Any (new TextRenderable renderer {:width "100%" :flexGrow 1 :wrapMode "none"})
        composer-prompt Any (new TextRenderable renderer {:width 2 :height 1 :flexShrink 0 :wrapMode "none"
                                                   :content (new StyledText [(brightCyan "❯ ")])})
        composer-input Any (new InputRenderable renderer
                                         ;; No explicit width: a `100%` here
                                         ;; resolves against the composer's
                                         ;; content box and then sits *after*
                                         ;; the prompt, spilling the input's
                                         ;; fill past the right margin. Grow
                                         ;; from zero into what's left instead.
                                         {:flexGrow 1 :flexShrink 1 :flexBasis 0 :minWidth 0
                                          :backgroundColor "#25272d" :focusedBackgroundColor "#25272d"
                                          :textColor "#e5e7eb" :focusedTextColor "#f8fafc"
                                          :placeholderColor "#6b7280"
                                          :placeholder (composer-hint "agents" (main-agent-label runtime))})
        ui (Map Keyword Any) {:root root :agentsPane agents-pane :workPane work-pane
            :viewTabsText view-tabs-text
            :transcriptText transcript-text-view
            :workScroll work-scroll
            :workText work-text-view :boardRoot board-root
            :statusText status-text :agentStatusText agent-status-text
            :composerPalette composer-palette :composer composer
            :composerPrompt composer-prompt :composerInput composer-input
            :agentStripText agent-strip-text
            :detailPanel detail-panel :detailText detail-text}]
    (.add transcript-scroll transcript-text-view)
    (.add agents-pane transcript-scroll)
    (.add agents-pane agent-status-text)
    (.add work-scroll work-text-view)
    (.add work-scroll board-root)
    (.add work-pane work-scroll)
    (.add work-pane status-text)
    (.add composer composer-prompt)
    (.add composer composer-input)
    (.add workspace agents-pane)
    (.add workspace work-pane)
    ;; Everything above is content; everything below the workspace is the
    ;; bottom cluster, in reading order: composer, the view bar it switches,
    ;; the agent strip, then the docked panel growing upward off the last row.
    (.add root workspace)
    (.add root composer-palette)
    (.add root composer)
    (.add root view-tabs-text)
    (.add root agent-strip-text)
    (.add detail-panel detail-text)
    (.add root detail-panel)
    (.add (.-root renderer) root)
    (set! (.-visible (.-verticalScrollBar transcript-scroll)) false)
    (set! (.-visible (.-horizontalScrollBar transcript-scroll)) false)
    (set! (.-visible (.-verticalScrollBar work-scroll)) false)
    (set! (.-visible (.-horizontalScrollBar work-scroll)) false)
    (set! (.-workScroll runtime) work-scroll)
    (set! (.-renderConversation runtime)
          (fn [] Any
            (set! (.-content transcript-text-view) (render-conversation! runtime))))
    (set! (.-render runtime) (fn [] Any (render-ui! runtime ui)))
    (install-input! runtime ui)
    (install-mouse! runtime ui)
    (install-composer-keymap! runtime renderer)
    (install-process-cleanup! runtime)
    (install-global-exit! runtime)
    (install-keys! runtime ui)
    (.render runtime)
    (.focus composer-input)
    (report-promise! runtime (discover-session-branch! runtime))
    (report-promise! runtime (refresh! runtime))
    (boot! runtime
           (fn
             [prompt String
              role String] (Promise Any)
             (launch-agent! runtime prompt role)))
    runtime))

(js/export
 (defn run-northbridge-app! [options Any] (Promise Any)
   (open-app! (text-or (.-viewId options) BOOT-VIEW)
              (text (.-sourceIdentity options)))))
