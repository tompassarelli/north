(defn text [value: Any] -> String
  (if (identical? (js/typeof value) "string") value ""))

(defn text-or
  [value: Any
   fallback: String] -> String
  (let [candidate (text value)]
    (if (identical? candidate "") fallback candidate)))

(defn bare [value: Any] -> String
  (let [value-text (text value)]
    (if (.startsWith value-text "@") (.slice value-text 1) value-text)))

(defn error-message [error: Any] -> String
  (if (and error (identical? (js/typeof error) "object") (.-message error))
    (text (.-message error))
    (String error)))

(defn safe-json [value: Any] -> String
  (try
    (JSON/stringify value nil 2)
    (catch Error _ (String value))))

;; The daemon refuses launches once the checkout moves under it, and it retires
;; itself the moment its last session drains. Say that, in one calm line, rather
;; than printing the wire code at someone — and name the way out, because a
;; session nobody is waiting on never drains on its own.
(defn stale-daemon-summary [live: Int] -> String
  (if (> live 0)
    (str "control daemon is stale (" live " live session"
         (if (identical? live 1) "" "s")
         ") — /restart to replace it now, or it retires when they drain")
    "control daemon is stale — /restart to replace it now"))

(defn failure-summary [data: Any] -> String
  (let [message (text-or (.-message data)
                         (text-or (.-detail data)
                                  (text-or (.-classification data) (text (.-code data)))))
        causes (.-causes data)
        cause (if (and causes (> (.-length causes) 0))
                (text (aget causes 0)) "")]
    (cond
      (or (.includes message "north_coordinator_preflight")
          (.includes cause "ECONNREFUSED 127.0.0.1:7977"))
      "coordinator offline — supervision unavailable; /config and /help still work"

      (identical? message "bridge_daemon_source_stale")
      (stale-daemon-summary (Number (or (.-live data) 0)))

      (identical? message "") (safe-json data)
      (identical? cause "") message
      :else (str message " — " cause))))

(defn clean-text [value: Any] -> String
  (stripAnsiSequences (text value)))

;; Agent identity and route fields come from coordinator-owned facts, but they
;; are still terminal input. A single-line row cannot carry terminal controls
;; or create another row of its own.
(js/export
 (defn agent-field-text [value: Any] -> String
  (.join
   (.map (Array/from (clean-text value))
         (fn [character: String] -> String
           (let [code (.charCodeAt character 0)]
             (cond
               (or (identical? code 9) (identical? code 10) (identical? code 13)) " "
               (or (< code 32) (and (>= code 127) (<= code 159))) ""
               :else character))))
   "")))

(js/export
 (defn agent-cell-text
  [value: Any
   width: Int] -> String
  (let [source (agent-field-text value)
        limit (Math/max 1 width)]
    (if (<= (.stringWidth Bun source) limit)
      source
      (let [room (Math/max 0 (- limit (.stringWidth Bun "…")))
            kept []
            state {:width 0 :done false}]
        (.forEach
         (Array/from (.segment (IntlSegmenter. "en" {:granularity "grapheme"}) source))
         (fn [part: Any] -> Any
           (let [segment (text (.-segment part))
                 segment-width (.stringWidth Bun segment)]
             (when (not (.-done state))
               (if (<= (+ (.-width state) segment-width) room)
                 (do (.push kept segment)
                     (set! (.-width state) (+ (.-width state) segment-width)))
                 (set! (.-done state) true))))))
        (str (.join kept "") "…"))))))

(defn clipped
  [value: Any
   limit: Int] -> String
  (let [clean (clean-text value)]
    (if (> (.-length clean) limit)
      (str "…" (.slice clean (- (.-length clean) limit)))
      clean)))

(defn next-item-id!
  [runtime: Any
   prefix: String] -> String
  (set! (.-itemSequence runtime) (+ (.-itemSequence runtime) 1))
  (str prefix ":" (.-itemSequence runtime)))

(defn conversation-item
  [id: String
   kind: String
   title: String
   body: String
   status: String] -> ConversationItem
  (->ConversationItem id kind title body status nil))

(defn conversation-item-with-data!
  [id: String
   kind: String
   title: String
   body: String
   status: String
   data: Any] -> ConversationItem
  (->ConversationItem id kind title body status data))

(defn conversation-index
  [runtime: Any
   id: String] -> Int
  (.findIndex (.-conversation runtime)
              (fn [item: ConversationItem] -> Bool
                (identical? (conversationitem-id item) id))))

(defn conversation-item-by-id
  [runtime: Any
   id: String] -> ConversationItem?
  (let [index (conversation-index runtime id)]
    (if (>= index 0) (aget (.-conversation runtime) index) nil)))

(defn upsert-conversation!
  [runtime: Any
   item: ConversationItem] -> Any
  (let [index (conversation-index runtime (conversationitem-id item))]
    (if (>= index 0)
      (aset (.-conversation runtime) index item)
      (.push (.-conversation runtime) item))
    (when (> (.-length (.-conversation runtime)) 240)
      (set! (.-conversation runtime) (.slice (.-conversation runtime) -240)))
    (.render runtime)))

(defn append-system!
  [runtime: Any
   body: String] -> Any
  (when (not (identical? (.trim body) ""))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "system") "system" "" (.trim body) "done"))))

(defn append-error!
  [runtime: Any
   body: String] -> Any
  (when (not (identical? (.trim body) ""))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "error") "error" "Error" (.trim body) "failed"))))

(defn append-interrupted! [runtime: Any] -> Any
  (upsert-conversation!
   runtime
   (conversation-item (next-item-id! runtime "interrupted")
                      "interrupted" ""
                      "Conversation interrupted — tell the model what to do differently."
                      "interrupted")))

(defn set-working!
  [runtime: Any
   working: Bool
   label: String] -> Any
  (set! (.-working runtime) working)
  (set! (.-workingLabel runtime) label)
  (if working
    (do
      (when (identical? (.-workingSince runtime) 0)
        (set! (.-workingSince runtime) (Date/now)))
      (when (nil? (.-spinnerTimer runtime))
        (let [timer
              (setInterval
               (fn [] -> Any
                 (when (not (.-disposed runtime))
                   (set! (.-spinnerIndex runtime) (+ (.-spinnerIndex runtime) 1))
                   (.renderConversation runtime)))
               180)]
          (set! (.-spinnerTimer runtime) timer)
          (when (.-unref timer) (.unref timer)))))
    (do
      (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
      (set! (.-spinnerTimer runtime) nil)
      (set! (.-workingSince runtime) 0)))
  (.renderConversation runtime))

(defn command [input: String] -> ParsedCommand
  (let [trimmed (.trim input)
        normalized (if (.startsWith trimmed "/") (.slice trimmed 1) trimmed)
        split-at (.indexOf normalized " ")]
    (if (< split-at 0)
      (->ParsedCommand (.toLowerCase normalized) "")
      (->ParsedCommand (.toLowerCase (.slice normalized 0 split-at))
                       (.trim (.slice normalized (+ split-at 1)))))))

;; One escape verb, four spellings, no difference between them. Whichever you
;; type, it climbs exactly one rung out of wherever you are.
(defn escape-command? [name: String] -> Bool
  (or (identical? name "q")
      (identical? name "exit")
      (identical? name "close")
      (identical? name "esc")))

;; One view is on screen at a time, full width, and Northbridge opens on Agents.
(def BOOT-FRAME: String "agents")

(js/export
 (defn boot-frame [] -> String BOOT-FRAME))

(js/export
 (defn threads-frame? [frame: Any] -> Bool
  (identical? (text frame) "threads")))

;; Pure: the escape ladder. One rung per invocation, innermost first, so
;; nothing is ever closed that you could not see was open. Quit lives on the
;; last rung and nowhere else: from the empty root, with no surface left to
;; leave, escaping means leaving Northbridge — always reachable by repeating
;; the same verb, never reachable by accident.
;;
;; The physical escape key climbs rungs one to four and stops. A key you hit
;; reflexively to dismiss something must not be the key that ends the session,
;; so at the root it spends itself on the turn in flight, or on nothing.
;; A live filter is a rung of its own, inside the panel that carries it: the
;; query is the innermost thing you opened, so it is the first thing escape
;; takes back, and the panel underneath survives one more press. Anything else
;; would make the key that clears a typo the key that closes the switchboard.
(js/export
 (defn escape-rung
  [palette-open?: Bool
   filtering?: Bool
   detail-open?: Bool
   strip-focused?: Bool
   threads?: Bool
   working?: Bool
   from-key?: Bool] -> String
  (cond
    palette-open? "close-palette"
    filtering? "clear-filter"
    detail-open? "close-detail"
    strip-focused? "focus-composer"
    threads? "show-agents"
    (and from-key? working?) "cancel-turn"
    from-key? ""
    :else "quit")))

;; Pure: which surface holds the keyboard. Exactly one, always — that is the
;; whole content of a focus model, and it is what lets one key carry a different
;; verb per context without ever carrying two at once. Innermost first, the same
;; order the escape ladder climbs back out through, so "what does this key do
;; here" and "what does escape take back here" are answered off one ordering.
(js/export
 (defn active-focus
  [palette-open?: Bool
   panel-open?: Bool
   panel-focused?: Bool
   filtering?: Bool
   strip-focused?: Bool] -> String
  (cond
    palette-open? "palette"
    (and panel-open? panel-focused? filtering?) "filter"
    (and panel-open? panel-focused?) "panel"
    strip-focused? "strip"
    :else "composer")))

;; Pure: what tab means, which is entirely a question of who has the keyboard.
;; In the panel it is the fold — the affordance the tree had no discoverable key
;; for, since ←/→ and h/l are conventions you either know or never find. In the
;; composer it swaps which view is on screen, which is what it has always meant
;; there. In the palette it completes, which is all it has ever meant there.
;;
;; A live filter keeps folding: tab is never a character — the letters h and l
;; stand down while a query is up precisely because they ARE characters, and tab
;; has no such conflict to lose.
;;
;; On a row that is not a node, tab climbs to the node the row lives inside
;; rather than doing nothing. A key that appears in the legend has to move
;; something wherever the cursor is standing, and the row you land on is the one
;; the next press folds.
(js/export
 (defn tab-action
  [focus: String
   dir-row?: Bool
   expanded?: Bool] -> String
  (cond
    (identical? focus "palette") "complete"
    (or (identical? focus "panel") (identical? focus "filter"))
    (if dir-row? (if expanded? "collapse" "expand") "climb")
    :else "swap-view")))

;; Pure: the view a swap lands on. Two views, so the swap is the other one.
(js/export
 (defn tab-swap-frame [frame: String] -> String
  (if (threads-frame? frame) "agents" "threads")))

;; Every match, always. What fits on screen is a rendering question, answered
;; once in render-minibuffer! — never by dropping options on the floor here.
(defn emoji-options [query: String] -> (Vec SlashCommand)
  (let [needle (.toLowerCase (.trim query))]
    (.filter EMOJI-COMMANDS
             (fn [candidate: SlashCommand] -> Bool
               (or (identical? needle "")
                   (.includes
                    (.toLowerCase
                     (str (slashcommand-name candidate) " "
                          (slashcommand-description candidate)))
                    needle))))))

(defn glyph-options [query: String] -> (Vec SlashCommand)
  (let [needle (.toLowerCase (.trim query))]
    (.filter GLYPH-COMMANDS
             (fn [candidate: SlashCommand] -> Bool
               (or (identical? needle "")
                   (.includes
                    (.toLowerCase
                     (str (slashcommand-name candidate) " "
                          (slashcommand-description candidate)))
                    needle))))))

;; Which command set a slash is read against: the one belonging to the view
;; that is on screen.
(js/export
 (defn palette-options
  [frame: String
   input: String] -> (Vec SlashCommand)
  (let [query (.toLowerCase (.trim input))
        parsed (command input)
        name (parsedcommand-name parsed)
        commands (if (threads-frame? frame) THREAD-COMMANDS AGENT-COMMANDS)]
    (cond
      (not (.startsWith query "/")) []
      (identical? name "emoji") (emoji-options (parsedcommand-rest parsed))
      (or (identical? name "glyph") (identical? name "prompt"))
      (glyph-options (parsedcommand-rest parsed))
      (>= (.indexOf query " ") 0) []
      :else
      (.filter commands
               (fn [candidate: SlashCommand] -> Bool
                 (.startsWith (slashcommand-name candidate) query)))))))

(defn submit-key? [name: String] -> Bool
  (or (identical? name "return")
      (identical? name "enter")
      (identical? name "kpenter")
      (identical? name "linefeed")))

(defn run-command [argv: (Vec String)] -> (Promise String)
  (let [child (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results (js/await
                 (Promise/all [(.text (Response. (.-stdout child)))
                               (.text (Response. (.-stderr child)))
                               (.-exited child)]))
        stdout (text (aget results 0))
        stderr (text (aget results 1))
        exit-code (aget results 2)]
    (if (identical? exit-code 0)
      stdout
      (throw (Error. (str (.join argv " ") " failed (" exit-code "): "
                          (text-or (.trim stderr) (.trim stdout))))))))

(defn run-json [argv: (Vec String)] -> (Promise Any)
  (let [output (js/await (run-command argv))]
    (JSON/parse output)))

(defn discover-session-branch! [runtime: Any] -> (Promise Any)
  (try
    (let [directory (text (.-sessionCwd runtime))
          output (js/await
                  (run-command ["git" "-C" directory "branch" "--show-current"]))
          branch (.trim (text output))]
      (set! (.-sessionBranch runtime)
            (if (identical? branch "") "detached HEAD" branch)))
    (catch Error _
      (set! (.-sessionBranch runtime) "not a Git worktree")))
  (.render runtime))

(defn read-stream
  [stream: Any
   on-chunk: [String -> Any]] -> (Promise Any)
  (let [reader (.getReader stream)
        decoder (TextDecoder.)]
    (loop []
      (let [result (js/await (.read reader))]
        (when (not (.-done result))
          (on-chunk (.decode decoder (.-value result) {:stream true}))
          (recur))))))

(defn stream-command
  [argv: (Vec String)
   on-stdout: [String -> Any]
   on-stderr: [String -> Any]] -> (Promise Int)
  (let [child (.spawn Bun {:cmd argv :stdout "pipe" :stderr "pipe"})
        results (js/await
                 (Promise/all [(read-stream (.-stdout child) on-stdout)
                               (read-stream (.-stderr child) on-stderr)
                               (.-exited child)]))]
    (aget results 2)))

(js/export
 (defn normalize-agents [payload: Any] -> (Vec Agent)
  (let [rows (if (and payload (Array/isArray (.-agents payload))) (.-agents payload) [])]
    (.map rows
          (fn [row: Any] -> Agent
            (let [id (bare (text-or (.-control_id row)
                                    (text-or (.-uuid row) (text (.-id row)))))
                  name (text-or (.-display_handle row)
                                (text-or (.-display_name row) id))
                  status (text-or (.-state_label row)
                                  (text-or (.-state row) "unknown"))
                  task (text-or (.-task row) (text (.-thread_title row)))]
              (->Agent id name status task
                       (text (.-provider row))
                       (text (.-provider_target row))
                       (text (.-provider_label row))
                       (text (.-model row))
                       (text (.-model_display row))
                       (text (.-effort row))
                       (text (.-orchestration_provenance row))
                       (text (.-goal row))
                       (text (.-state row)))))))))

(defn agent-with-route
  [agent: Agent
   route: Agent] -> Agent
  (->Agent (agent-id agent)
           (agent-name agent)
           (agent-status agent)
           (agent-task agent)
           (agent-provider route)
           (agent-provider-target route)
           (agent-provider-label route)
           (agent-model route)
           (agent-model-display route)
           (agent-effort route)
           (agent-orchestration-provenance route)
           (agent-goal route)
           (agent-state route)))

(defn board-ids [board: Any] -> (Vec String)
  (if (Array/isArray board)
    (.filter
     (.map board (fn [row: Any] -> String (bare (.-id row))))
     (fn [id: String] -> Bool (not (identical? id ""))))
    []))

(defn driver-of
  [facts: Any
   id: String] -> String
  (if (not (Array/isArray facts))
    ""
    (let [row (.find facts
                     (fn [fact: Any] -> Bool
                       (and (identical? (text (.-predicate fact)) "driver")
                            (identical? (bare (.-subject fact)) id))))]
      (if row (bare (.-value row)) ""))))

(defn dependencies-of
  [facts: Any
   id: String] -> (Vec String)
  (if (not (Array/isArray facts))
    []
    (.map
     (.filter facts
              (fn [fact: Any] -> Bool
                (and (identical? (text (.-predicate fact)) "depends_on")
                     (identical? (bare (.-subject fact)) id))))
     (fn [fact: Any] -> String (bare (.-value fact))))))

(defn body-of
  [facts: Any
   id: String] -> String
  (if (not (Array/isArray facts))
    ""
    (let [row (.find facts
                     (fn [fact: Any] -> Bool
                       (and (identical? (text (.-predicate fact)) "body")
                            (identical? (bare (.-subject fact)) id))))]
      (if row (text (.-value row)) ""))))

(defn normalize-work
  [board: Any
   facts: Any] -> (Vec WorkItem)
  (if (not (Array/isArray board))
    []
    (.map board
          (fn [row: Any] -> WorkItem
            (let [id (bare (.-id row))
                  title (text-or (.-title row) id)
                  body (body-of facts id)
                  condition (text-or (.-condition row) "open")
                  driver (driver-of facts id)
                  dependencies (dependencies-of facts id)]
              (->WorkItem id title body condition driver dependencies))))))

(defn terminal-condition? [condition: String] -> Bool
  (or (identical? condition "terminal")
      (identical? condition "done")
      (identical? condition "completed")
      (identical? condition "failed")))

(defn list-section-id [condition: String] -> String
  (cond
    (terminal-condition? condition) "terminal"
    (.includes ["active" "ready" "blocked" "dormant" "draft"] condition) condition
    :else "other"))

(defn list-section-title [section-id: String] -> String
  (let [section (.find LIST-SECTIONS
                       (fn [candidate: ListSection] -> Bool
                         (identical? (listsection-id candidate) section-id)))]
    (if section (listsection-title section) section-id)))

(defn list-section-count
  [items: (Vec WorkItem)
   section-id: String] -> Int
  (.-length
   (.filter items
            (fn [item: WorkItem] -> Bool
              (identical? (list-section-id (workitem-condition item)) section-id)))))

(defn list-rows
  [runtime: Any
   items: (Vec WorkItem)] -> (Vec ListRow)
  (let [rows []
        collapsed (.-collapsedListConditions runtime)]
    (.forEach
     LIST-SECTIONS
     (fn [section: ListSection] -> Any
       (let [section-id (listsection-id section)
             count (list-section-count items section-id)]
         (when (> count 0)
           (.push rows (->ListRow "header" section-id -1 count))
           (when (not (.has collapsed section-id))
             (.forEach
              items
              (fn
                [item: WorkItem
                 index: Int] -> Any
                (when (identical? (list-section-id (workitem-condition item)) section-id)
                  (.push rows (->ListRow "item" section-id index 0))))))))))
    rows))

(defn board-lane-id [condition: String] -> String
  (cond
    (identical? condition "active") "in-progress"
    (terminal-condition? condition) "done"
    :else "not-started"))

(defn ordered-board-items
  [open-items: (Vec WorkItem)
   done-items: (Vec WorkItem)] -> (Vec WorkItem)
  (let [ready (.filter open-items
                       (fn [item: WorkItem] -> Bool
                         (identical? (workitem-condition item) "ready")))
        waiting (.filter open-items
                         (fn [item: WorkItem] -> Bool
                           (let [condition (workitem-condition item)]
                             (and (not (identical? condition "ready"))
                                  (not (identical? condition "active"))))))
        active (.filter open-items
                        (fn [item: WorkItem] -> Bool
                          (identical? (workitem-condition item) "active")))]
    (.concat ready waiting active done-items)))

(defn publish-line!
  [runtime: Any
   line: String] -> Any
  (when (and (not (.-disposed runtime))
             (not (identical? (.trim line) "")))
    (append-system! runtime line)))

(defn grapheme-count [value: String] -> Int
  (.-length
   (Array/from
    (.segment (IntlSegmenter. "en" {:granularity "grapheme"}) value))))

(defn current-prompt-glyph [runtime: Any] -> String
  (let [glyph (text (.-promptGlyph runtime))]
    (if (identical? glyph "") DEFAULT-PROMPT-GLYPH glyph)))

(defn render-prompt!
  [runtime: Any
   prompt: Any] -> Any
  (let [glyph (current-prompt-glyph runtime)]
    (set! (.-width prompt) (+ (.stringWidth Bun glyph) 1))
    (set! (.-content prompt) (StyledText. [(brightCyan (str glyph " "))]))))

(defn set-prompt-glyph!
  [runtime: Any
   glyph: String] -> Any
  (when (or (identical? (.trim glyph) "")
            (not (identical? (grapheme-count glyph) 1)))
    (throw (Error. "glyph requires exactly one grapheme, or use /glyph reset")))
  (set! (.-promptGlyph runtime) glyph)
  (publish-line! runtime (str "prompt glyph set to " glyph))
  (.render runtime))

(defn sound-enabled-from-env [value: String] -> Bool
  (let [normalized (.toLowerCase (.trim value))]
    (not (or (identical? normalized "0")
             (identical? normalized "false")
             (identical? normalized "off")
             (identical? normalized "no")))))

(defn sound-pack-from-env [value: String] -> String
  (if (identical? (.toLowerCase (.trim value)) "peasant") "peasant" "peon"))

;; Derived from NORTH_HOME, never from a composed checkout path: the packaged
;; tree's purity scan rejects one, and a checkout may live anywhere.
(defn sound-directory-from-env [value: String] -> String
  (let [directory (.trim value)
        north-home (.trim (text (.-NORTH_HOME (.-env process))))]
    (cond
      (not (identical? directory "")) directory
      (not (identical? north-home "")) (str north-home "/../warcraft-sounds")
      :else "warcraft-sounds")))

(defn discover-sound-player [] -> SoundPlayer?
  (let [mpv (.which Bun "mpv")
        ffplay (.which Bun "ffplay")
        pw-play (.which Bun "pw-play")]
    (cond
      mpv (->SoundPlayer "mpv" (text mpv))
      ffplay (->SoundPlayer "ffplay" (text ffplay))
      pw-play (->SoundPlayer "pw-play" (text pw-play))
      :else nil)))

(defn sound-warning!
  [runtime: Any
   message: String] -> Any
  (when (and (not (.-disposed runtime))
             (not (.-soundWarningShown runtime)))
    (set! (.-soundWarningShown runtime) true)
    (publish-line! runtime (str "sound warning: " message))))

(defn sound-path
  [directory: String
   filename: String] -> String
  (str directory (if (.endsWith directory "/") "" "/") filename))

(defn sound-argv
  [player: SoundPlayer
   path: String] -> (Vec String)
  (let [executable (soundplayer-path player)]
    (cond
      (identical? (soundplayer-kind player) "mpv")
      [executable "--no-video" "--really-quiet" path]

      (identical? (soundplayer-kind player) "ffplay")
      [executable "-nodisp" "-autoexit" "-loglevel" "quiet" path]

      :else [executable path])))

(defn spawn-sound!
  [runtime: Any
   path: String] -> Any
  (try
    (let [player (.-soundPlayer runtime)]
      (if (nil? player)
        (sound-warning! runtime "install mpv, ffplay, or pw-play to play local assets")
        (let [child (.spawn Bun {:cmd (sound-argv player path)
                                 :stdin "ignore" :stdout "ignore" :stderr "ignore"})]
          (.add (.-soundChildren runtime) child)
          (.unref child)
          (.catch
           (.then (.-exited child)
                  (fn [exit-code: Any] -> Any
                    (.delete (.-soundChildren runtime) child)
                    (when (not (identical? exit-code 0))
                      (sound-warning! runtime (str "player exited " exit-code " for " path)))))
           (fn [error: Any] -> Any
             (.delete (.-soundChildren runtime) child)
             (sound-warning! runtime (error-message error)))))))
    (catch Error error
      (sound-warning! runtime (error-message error)))))

(defn play-sound-path!
  [runtime: Any
   path: String] -> Any
  (try
    (.catch
     (.then (.exists (.file Bun path))
            (fn [exists: Any] -> Any
              (if (and exists (.-soundEnabled runtime) (not (.-disposed runtime)))
                (spawn-sound! runtime path)
                (when (and (not exists) (.-soundEnabled runtime))
                  (sound-warning! runtime (str "missing local asset " path))))))
     (fn [error: Any] -> Any
       (sound-warning! runtime (error-message error))))
    (catch Error error
      (sound-warning! runtime (error-message error)))))

(defn select-sound-path!
  [runtime: Any
   event: String] -> String
  (let [pack (if (identical? (text (.-soundPack runtime)) "peasant")
               PEASANT-SOUND-PACK PEON-SOUND-PACK)
        files (cond
                (identical? event "ready") (soundpack-ready pack)
                (identical? event "done") (soundpack-done pack)
                (identical? event "interrupted") (soundpack-interrupted pack)
                (identical? event "failed") (soundpack-failed pack)
                :else [])
        count (.-length files)]
    (if (identical? count 0)
      ""
      (let [base-index (mod (.-soundSequence runtime) count)
            base-file (text (aget files base-index))
            base-path (sound-path (text (.-soundDirectory runtime)) base-file)
            index (if (and (> count 1)
                           (identical? base-path (text (.-lastSoundPath runtime))))
                    (mod (+ base-index 1) count)
                    base-index)
            path (sound-path (text (.-soundDirectory runtime))
                             (text (aget files index)))]
        (set! (.-soundSequence runtime) (+ (.-soundSequence runtime) 1))
        (set! (.-lastSoundPath runtime) path)
        path))))

(defn play-sound-event!
  [runtime: Any
   stream-state: Any
   event: String] -> Any
  (let [now (Date/now)]
    (when (and (.-soundEnabled runtime)
               (.-soundLive stream-state)
               (>= (- now (.-lastSoundAt runtime)) SOUND-COOLDOWN-MS))
      (let [path (select-sound-path! runtime event)]
        (when (not (identical? path ""))
          (set! (.-lastSoundAt runtime) now)
          (play-sound-path! runtime path))))))

(defn sound-status [runtime: Any] -> String
  (let [player (.-soundPlayer runtime)]
    (str "sound " (if (.-soundEnabled runtime) "on" "off")
         " · pack " (text (.-soundPack runtime))
         " · player " (if player (soundplayer-kind player) "none")
         " · " (text (.-soundDirectory runtime)))))

(defrecord ConfigEntry
  [kind: String
   name: String
   ;; The stored axis, which is not the same question for every kind. A skill or
   ;; a knob stores `on`/`off` — whether it is active. A hook stores
   ;; `enabled`/`disabled` — whether the user permits it; its activity is
   ;; derived (see config-entry-active?).
   state: String
   ;; Whatever the manifest carries past the state column — for `dir` rows the
   ;; triggering directory (`~` for the global profile), for a bound `hook` row
   ;; the unit it follows, which may be any non-hook row. Empty when the line
   ;; has three fields, which is every row with no fourth thing to say.
   detail: String])

;; A hook's stored axis is permission, not activity. The pre-two-axis spelling
;; `on` is gone: the CLI normalises every hook row to enabled/disabled when it
;; touches the manifest, and the migration has landed, so a row spelled `on`
;; can no longer reach this panel. Reading one as permission would now be a
;; guess about a shape that does not occur.
(defn config-hook-enabled? [state: String] -> Bool
  (identical? state "enabled"))

;; Membership is not in the manifest. A module's roster lives beside it in
;; modules.d/<module>.json, so joining a bundle never rewrites the member's own
;; row — the member keeps its own switch and gains a gate. One record per file
;; that exists; a module with no file has no roster at all, which is a different
;; fact from a module whose roster is empty (that one shows `0 members`).
(defrecord ModuleMembership
  [module: String
   members: Any])

;; Pure: the modules whose roster names this unit. Union semantics live here —
;; a unit shared by two bundles has two owners and needs only one of them on.
(defn config-owner-modules
  [memberships: Any
   name: String] -> Any
  (.map (.filter memberships
                 (fn [membership: Any] -> Bool
                   (.includes (modulemembership-members membership) name)))
        (fn [membership: Any] -> String
          (modulemembership-module membership))))

;; Pure: this module's roster, or nil when modules.d carries no file for it.
;; Absence and emptiness are different answers and the row says so.
(js/export
 (defn config-module-members
  [memberships: Any
   name: String] -> Any
  (let [found (.find memberships
                     (fn [membership: Any] -> Bool
                       (identical? (modulemembership-module membership) name)))]
    (if found (modulemembership-members found) nil))))

;; The kinds that are rows inside a directory's subtree rather than sections of
;; their own: the directory's instruction file (`ins`), the gate over its
;; memories (`memroot`), and one memory (`mem`). A `dir` row is the subtree's
;; own gate and heads it.
(defn config-subtree-kind? [kind: String] -> Bool
  (or (identical? kind "ins")
      (identical? kind "memroot")
      (identical? kind "mem")))

;; Pure: which directory a row belongs to. Every subtree row is named for its
;; directory's slug; a `mem` row qualifies that with the memory's own name, so
;; two directories may both carry `memories/architecture` without colliding.
(defn config-row-slug
  [kind: String
   name: String] -> String
  (if (identical? kind "mem")
    (let [cut (.indexOf name "/")]
      (if (< cut 0) name (.slice name 0 cut)))
    name))

;; Pure: the memory's own name, which is what the row prints — the slug in front
;; of it is the directory it is already nested under.
(defn config-mem-name [name: String] -> String
  (let [cut (.indexOf name "/")]
    (if (< cut 0) name (.slice name (+ cut 1)))))

;; Pure: how a row is named when some OTHER row is talking about it. A bare name
;; in a provenance column reads as a peer — a hook that says it follows
;; `repo-safety` reads as a hook following a hook — so the kind comes with it,
;; and it stays legible with every colour turned off. The word is the one the
;; panel would use for that row out loud rather than the manifest's token: a
;; directory's instruction file is a `file`, its memories gate is `memories`.
(js/export
 (defn config-kind-word [kind: String] -> String
  (cond
    (identical? kind "ins") "file"
    (identical? kind "memroot") "memories"
    (identical? kind "mem") "memory"
    :else kind)))

(js/export
 (defn config-provenance-name
  [kind: String
   name: String] -> String
  (if (identical? kind "") name (str (config-kind-word kind) ": " name))))

;; Pure: what a row calls itself on screen. A subtree row is named for its
;; directory in the manifest and for what it IS in the panel — the instruction
;; file says `AGENTS.md`, the memories gate says `memories`, a memory says its
;; own name — because the directory is already the row it is nested under and
;; printing the slug again on every child would say nothing new.
(js/export
 (defn config-row-label
  [kind: String
   name: String] -> String
  (cond
    (identical? kind "ins") "AGENTS.md"
    (identical? kind "memroot") "MEMORIES"
    (identical? kind "mem") (config-mem-name name)
    :else name)))

;; Pure: the argument the CLI verbs take for this row — `agents on|off <target>`
;; and `agents path <target>`, which speak the same spellings.
;;
;; Everything under a directory gate is addressed THROUGH it, because that is
;; what it is: `code/AGENTS.md` is that directory's instruction file,
;; `code/memories` the group, and any other leaf is a memory by its file name.
;; The slash is what keeps memory names out of the bare namespace a companion or
;; a module member is written in — two directories may both remember `style.md`
;; — and it is what ends the collision the slug used to have with its own
;; subtree: `agents off code` closes the directory, and nothing else answers to
;; that name any more.
;;
;; A memory's manifest name already carries both halves, extension and all, so
;; it is its own address. One function, so the whole panel speaks to the CLI in
;; one place.
(js/export
 (defn config-cli-name
  [kind: String
   name: String] -> String
  (cond
    (identical? kind "ins") (str name "/AGENTS.md")
    (identical? kind "memroot") (str name "/memories")
    :else name)))

;; Pure: how a row is written into a sentence. `@` on a row drops it into the
;; composer as a reference the reader can resolve without the panel in front of
;; them — the kind first, because `@repo-safety` alone is the same ambiguity the
;; provenance column had, and the CLI's own address after it.
(js/export
 (defn config-reference-text
  [kind: String
   name: String] -> String
  (str "@" (config-kind-word kind) ":" (config-cli-name kind name) " ")))

;; Pure: the row a name refers to. Members may be any kind, so this spans all of
;; them; a companion may not be a hook (see config-entry-active?), so that
;; lookup skips them.
(defn config-find-entry
  [manifest: Any
   name: String] -> Any
  (.find manifest
         (fn [entry: Any] -> Bool
           (identical? (configentry-name entry) name))))

;; Pure: the row of exactly this kind. A name is only unique within a kind now
;; that a directory's slug names its `dir` gate, its `ins` file and its
;; `memroot` alike, so every lookup that knows which kind it wants has to say
;; so or it will answer with whichever row the manifest happened to append
;; first.
(defn config-find-kind
  [manifest: Any
   kind: String
   name: String] -> Any
  (.find manifest
         (fn [entry: Any] -> Bool
           (and (identical? (configentry-kind entry) kind)
                (identical? (configentry-name entry) name)))))

(defn config-find-companion
  [manifest: Any
   name: String] -> Any
  (.find manifest
         (fn [entry: Any] -> Bool
           (and (not (identical? (configentry-kind entry) "hook"))
                (identical? (configentry-name entry) name)))))

;; Pure: the row whose activity gates this one's subtree, or nil for a row that
;; is nobody's child. The instruction file and the memories group hang off their
;; directory's `dir` row; a memory hangs off its directory's `memroot`, which
;; hangs off the same `dir` row in turn — so one press on the directory closes
;; the whole subtree, two links down, without any row but the gate's changing.
;;
;; A memory whose manifest carries no `memroot` falls back to the `dir` gate
;; directly: the dir-gate half of a memory's activity is not optional, and
;; skipping a missing middle row keeps the answer right instead of deriving a
;; permanent off. A subtree row whose directory is not in the manifest at all is
;; ungated rather than dead — absence here means the CLI never registered the
;; scope, and the honest thing to show is the row's own switch. (Derivation
;; always reads the whole manifest, never the filtered view, so absence is
;; really absence and not a narrowed view.)
(defn config-subtree-gate
  [manifest: Any
   kind: String
   name: String] -> Any
  (let [slug (config-row-slug kind name)]
    (cond
      (or (identical? kind "ins") (identical? kind "memroot"))
      (config-find-kind manifest "dir" slug)

      (identical? kind "mem")
      (let [root (config-find-kind manifest "memroot" slug)]
        (if root root (config-find-kind manifest "dir" slug)))

      :else nil)))

;; Pure: the whole activity formula, walked along one path so a cycle can be
;; seen. A unit is active when
;;
;;   its own switch is on
;;   AND (it belongs to no module OR at least one module holding it is active)
;;   AND (for a hook, the unit it follows is active — the full chain, not that
;;        unit's own switch, because a companion inside a switched-off bundle
;;        is not composing either)
;;   AND (for a row inside a directory's subtree, the gate over that subtree is
;;        active — the same full chain, for the same reason)
;;
;; `trail` is the rows already on this path, keyed by kind AND name: a
;; directory's slug names three rows now, and keying on the name alone would
;; read `ins code` gating on `dir code` as a cycle.
(defn config-active-along?
  [entry: Any
   manifest: Any
   memberships: Any
   trail: Any] -> Bool
  (let [kind (configentry-kind entry)
        name (configentry-name entry)
        key (str kind " " name)]
    (if (.includes trail key)
      false
      (let [walked (.concat trail [key])
            hook? (identical? kind "hook")
            state (configentry-state entry)
            own? (if hook?
                   (config-hook-enabled? state)
                   (identical? state "on"))
            owners (config-owner-modules memberships name)
            gated? (or (identical? (.-length owners) 0)
                       (.some owners
                              (fn [owner: String] -> Bool
                                (let [row (config-find-kind manifest "module"
                                                            owner)]
                                  (if row
                                    (config-active-along? row manifest
                                                          memberships walked)
                                    false)))))
            companion (if hook? (text (configentry-detail entry)) "")
            followed? (if (identical? companion "")
                        true
                        (let [row (config-find-companion manifest companion)]
                          (if row
                            (config-active-along? row manifest memberships
                                                  walked)
                            false)))
            gate (config-subtree-gate manifest kind name)
            scoped? (if gate
                      (config-active-along? gate manifest memberships walked)
                      true)]
        (and own? gated? followed? scoped?)))))

;; Pure: the derived axis. Needs the whole manifest, not the filtered view —
;; /hooks shows no companion rows at all and still has to say which of its hooks
;; are running — and the memberships beside it, because a unit's own row never
;; mentions the bundle that gates it.
(js/export
 (defn config-entry-active?
  [entry: Any
   manifest: Any
   memberships: Any] -> Bool
  (config-active-along? entry manifest memberships [])))

;; Pure: the same question asked by name, for callers holding a companion or a
;; roster entry rather than a row. A name the manifest does not carry is not an
;; active unit.
(js/export
 (defn config-unit-active?
  [manifest: Any
   memberships: Any
   name: String] -> Bool
  (let [entry (config-find-entry manifest name)]
    (if entry (config-entry-active? entry manifest memberships) false))))

;; Pure: the rows that are the reason this row is not composing — the gate over
;; its subtree when that gate is closed, plus every module holding it when none
;; of them is active. Empty when nothing above it is in the way, because then
;; naming anything would be noise.
;;
;; One hop, never the whole chain: a memory names `memories`, and the memories
;; row names the directory that closed it. That is the same reading a gated
;; skill already gets — it names the bundle directly over it, and that bundle's
;; own row names whatever is over IT — so a subtree reads top-down as a ladder
;; rather than repeating the root on every rung.
(js/export
 (defn config-gate-modules
  [entry: Any
   manifest: Any
   memberships: Any] -> Any
  (let [kind (configentry-kind entry)
        name (configentry-name entry)
        gate (config-subtree-gate manifest kind name)
        scope (if (and gate
                       (not (config-entry-active? gate manifest memberships)))
                [(config-provenance-name (configentry-kind gate)
                                         (configentry-name gate))]
                [])
        owners (config-owner-modules memberships name)
        open? (or (identical? (.-length owners) 0)
                  (.some owners
                         (fn [owner: String] -> Bool
                           (let [row (config-find-kind manifest "module" owner)]
                             (if row
                               (config-entry-active? row manifest memberships)
                               false)))))]
    (.concat scope
             (if open?
               []
               (.map owners
                     (fn [owner: String] -> String
                       (config-provenance-name "module" owner))))))))

;; Pure: the state a row is in — ONE token, and a qualifier only where the row
;; diverges from what that token would let you assume.
;;
;; The two-axis model underneath is unchanged; this is what it prints. `enabled`
;; is never one of the words: a row that is on says `on`, and a row whose own
;; switch is on while it is not composing says `off` and then why. Spending a
;; whole token on the axis that agrees with the answer said nothing and buried
;; the axis that did not.
;;
;; Provenance is the same rule one level out. A hook drawn UNDER the skill that
;; claims it is already standing in the answer — the parent row names the
;; claimant, and repeating it on every child is the noise that made a nested
;; hook unreadable. Printed only where the row is not nested under its claimant:
;; the flat hooks view, and hooks nobody claimed. Where the row is off BECAUSE
;; of that claimant, the reason already names it and nothing repeats it.
(js/export
 (defn config-state-text
  [entry: Any
   manifest: Any
   memberships: Any
   active?: Bool
   nested?: Bool] -> String
  (let [state (configentry-state entry)
        hook? (identical? (configentry-kind entry) "hook")
        own? (if hook? (config-hook-enabled? state) (identical? state "on"))
        gates (config-gate-modules entry manifest memberships)
        gate-note (if (identical? (.-length gates) 0)
                    ""
                    (str " (" (.join gates ", ") " off)"))
        companion (if hook? (text (configentry-detail entry)) "")
        followed (config-find-companion manifest companion)
        provenance (if (or nested? (identical? companion ""))
                     ""
                     ;; The kind comes with the name, so the unit a hook follows
                     ;; cannot be misread as another hook. A companion the
                     ;; manifest does not carry gets no kind, because there is
                     ;; none to state.
                     (str " · "
                          (config-provenance-name
                           (if followed (configentry-kind followed) "")
                           companion)))
        ;; The claimant IS the reason a bound hook is not running, and it is the
        ;; one provenance a nested row still has to print — not as provenance,
        ;; which the parent row already gives, but as the divergence.
        claimant-off? (and followed
                           (not (config-entry-active? followed manifest
                                                      memberships)))
        reason (cond
                 (not (identical? gate-note "")) gate-note
                 claimant-off? (str " ("
                                    (config-provenance-name
                                     (configentry-kind followed) companion)
                                    " off)")
                 :else "")]
    (cond
      (and hook? (not own?)) "disabled"
      (not own?) "off"
      active? (str "on" provenance)
      :else (str "off" reason)))))

;; Pure: which CLI verb a space on this row means. Both axes flip through the
;; same two verbs — `off` pins a hook disabled or switches a unit off, `on`
;; clears the pin or switches the unit on — and the cascade math is the CLI's.
(js/export
 (defn config-toggle-verb [state: String] -> String
  (if (or (identical? state "on") (identical? state "enabled")) "off" "on")))

;; The global profile is a `dir` row like any other — the instruction file for
;; the root scope, carrying `~` where a per-directory row carries its path. It
;; is one row rather than a kind of its own, which is why /agentsmd is now
;; literally one section and why /globals has to name a row instead of a kind.
(def GLOBAL-DIR-NAME: String "global")

(defn config-global-row?
  [kind: String
   name: String] -> Bool
  (and (identical? kind "dir") (identical? name GLOBAL-DIR-NAME)))

;; ---------------------------------------------------------------------------
;; The switchboard is a DIRECTORY-ROOTED TREE. Directories are the top level and
;; every other row hangs off one of them: a unit is only ever in force somewhere,
;; and the somewhere is the thing you can flip. The root scope is a node like any
;; other — `global`, whose directory is `~` — and it reads first because every
;; narrower scope is layered on top of it.
;;
;; Only the global node carries skills, hooks, modules, plugins and loose
;; switches today, because the CLI has no per-directory spelling for them yet.
;; The shape does not know that: a row names the directory it is scoped to, and
;; the day a project can carry its own skills they slot into that project's node
;; with nothing here to change.
;; ---------------------------------------------------------------------------

;; Pure: the directory node a row belongs under. A `dir` row is its own node; a
;; subtree row names its node in its slug; everything else is scoped to the root
;; until the CLI can say otherwise.
(js/export
 (defn config-row-scope
  [kind: String
   name: String] -> String
  (cond
    (identical? kind "dir") name
    (config-subtree-kind? kind) (config-row-slug kind name)
    :else GLOBAL-DIR-NAME)))

;; The switchboard's views are names, not manifest kinds — and every one of them
;; is now a projection of the same tree, narrowed by which rows it admits.
;; `globals` is the root node alone with everything scoped to it; `agentsmd` is
;; every node's own files; a kind name is that kind under whichever nodes have
;; any. Directory rows are admitted everywhere, because a row with no node over
;; it has nowhere to hang — the nodes that end up holding nothing are pruned
;; afterwards, where the whole list is in view.
(js/export
 (defn config-view-includes?
  [view: String
   kind: String
   name: String] -> Bool
  (cond
    (identical? view "all") true
    (identical? kind "dir")
    (if (identical? view "globals") (identical? name GLOBAL-DIR-NAME) true)
    (identical? view "globals")
    (and (identical? (config-row-scope kind name) GLOBAL-DIR-NAME)
         (not (identical? kind "plugin")))
    (identical? view "agentsmd") (config-subtree-kind? kind)
    :else (identical? kind view))))

;; A view that asked a narrow question prints only the nodes that answer it: an
;; empty SKILLS heading under a directory that has no skills is a row spent
;; saying nothing. The full tree keeps its empty nodes — a directory you have
;; registered exists whether or not anything is scoped to it yet, and that is
;; the fact /config is for.
(defn config-view-prunes? [view: String] -> Bool
  (not (or (identical? view "all")
           (identical? view "globals")
           (identical? view "agentsmd"))))

;; Folding is for the view that shows everything. A narrowed view is already an
;; answer; hiding its rows behind a fold would leave it answering nothing.
(js/export
 (defn config-view-folds? [view: String] -> Bool
  (identical? view "all")))

;; ---------------------------------------------------------------------------
;; A row's ROLE is what it does here, which is not always what kind it is. The
;; manifest's vocabulary is older than the panel's:
;;
;;   a `module` row is a SET — a roster in modules.d that carries other units,
;;   and the coarsest switch a node has;
;;   a `skill` that some hook follows is a MODULE — it brings enforcement with
;;   it, so it reads with its hooks nested under it rather than beside them;
;;   a `skill` nobody follows is a plain SKILL;
;;   a `hook` that follows a skill in view is that skill's, and is drawn there;
;;   only the unclaimed ones need a HOOKS heading of their own.
;;
;; Derived, never stored: the relation already exists in the manifest — a bound
;; hook names the unit it follows — so this is reading what is there, not asking
;; the CLI for a new column.
;;
;; The basis is the rows the VIEW carries, not the whole manifest and not the
;; filtered subset: a narrow view that admits no hooks has no modules in it,
;; which is the truth about what is on screen, and a live filter must not make
;; rows change depth as you type.
(defn config-hook-companion [entry: Any] -> String
  (if (identical? (configentry-kind entry) "hook")
    (text (configentry-detail entry))
    ""))

(js/export
 (defn config-skill-hooks
  [rows: Any
   name: String] -> Any
  (.filter rows
           (fn [entry: Any] -> Bool
             (and (identical? (configentry-kind entry) "hook")
                  (identical? (config-hook-companion entry) name))))))

(js/export
 (defn config-row-role
  [entry: Any
   rows: Any] -> String
  (let [kind (configentry-kind entry)
        name (configentry-name entry)]
    (cond
      (identical? kind "module") "moduleset"

      (identical? kind "skill")
      (if (> (.-length (config-skill-hooks rows name)) 0) "module" "skill")

      (identical? kind "hook")
      (let [companion (config-hook-companion entry)]
        (if (and (not (identical? companion ""))
                 (.some rows
                        (fn [row: Any] -> Bool
                          (and (identical? (configentry-kind row) "skill")
                               (identical? (configentry-name row) companion)))))
          "boundhook"
          "hook"))

      :else kind))))

;; Reading order inside a node: what the directory SAYS before what it turns on.
;; Its instruction file and its memories are the directory itself speaking, and
;; they are the reason you opened the node; the switches under them are things
;; that happen to be in force there. Then the coarsest of those first — the sets
;; that carry everything, the skills (modules with their hooks, then the plain
;; ones), the hooks nobody claimed, other people's plugins, the loose switches.
(defn config-section-rank [role: String] -> Int
  (cond
    (identical? role "ins") 0
    (identical? role "memroot") 1
    (identical? role "mem") 2
    (identical? role "moduleset") 3
    (identical? role "module") 4
    (identical? role "boundhook") 5
    (identical? role "skill") 6
    (identical? role "hook") 7
    (identical? role "plugin") 8
    (identical? role "other") 9
    :else 10))

;; The global profile is the file every other node is read on top of, so its
;; node reads first no matter where the CLI appended it.
(defn config-node-rank [entry: Any] -> Int
  (if (config-global-row? (configentry-kind entry) (configentry-name entry))
    0
    1))

;; Pure: flat manifest rows -> the tree, depth-first. Each directory node is
;; followed by everything scoped to it, in section order; rows whose node is not
;; in this view keep their place at the end rather than disappearing, because a
;; row the panel cannot nest is still a switch that exists and silently dropping
;; rows is the one failure a switchboard exists to prevent.
(defn config-tree-rows [entries: Any] -> Any
  (let [dirs (.filter entries
                      (fn [entry: Any] -> Bool
                        (identical? (configentry-kind entry) "dir")))
        kids (.filter entries
                      (fn [entry: Any] -> Bool
                        (not (identical? (configentry-kind entry) "dir"))))
        ordered (.sort (.slice dirs)
                       (fn
                         [a: Any
                          b: Any] -> Int
                         (- (config-node-rank a) (config-node-rank b))))
        tree []]
    (.forEach ordered
              (fn [node: Any] -> Any
                (.push tree node)
                (let [slug (configentry-name node)
                      owned (.filter kids
                                     (fn [child: Any] -> Bool
                                       (identical?
                                        (config-row-scope
                                         (configentry-kind child)
                                         (configentry-name child))
                                        slug)))
                      ;; Stable, so rows keep the order the CLI wrote them in
                      ;; wherever the section order has nothing to say.
                      sorted (.sort owned
                                    (fn
                                      [a: Any
                                       b: Any] -> Int
                                      (- (config-section-rank
                                          (config-row-role a entries))
                                         (config-section-rank
                                          (config-row-role b entries)))))]
                  (.forEach sorted
                            (fn [child: Any] -> Any
                              ;; A bound hook is drawn under the skill that
                              ;; declared it, so it is placed by that skill and
                              ;; skipped where the sort left it.
                              (when (not (identical?
                                          (config-row-role child entries)
                                          "boundhook"))
                                (.push tree child)
                                (when (identical? (config-row-role child entries)
                                                  "module")
                                  (.forEach (config-skill-hooks
                                             sorted (configentry-name child))
                                            (fn [hook: Any] -> Any
                                              (.push tree hook))))))))))
    ;; Whatever the tree could not place — a row scoped to a node this view does
    ;; not carry, a bound hook whose skill it does not — keeps its place at the
    ;; end rather than disappearing.
    (.concat tree
             (.filter kids
                      (fn [child: Any] -> Bool
                        (not (.includes tree child)))))))

;; Pure: manifest rows -> the rows this view shows, as a tree.
(js/export
 (defn config-view-rows
  [entries: Any
   view: String] -> Any
  (let [kept (.filter entries
                      (fn [entry: Any] -> Bool
                        (config-view-includes? view
                                               (configentry-kind entry)
                                               (configentry-name entry))))
        held (.filter kept
                      (fn [entry: Any] -> Bool
                        (if (or (not (config-view-prunes? view))
                                (not (identical? (configentry-kind entry) "dir")))
                          true
                          ;; A node earns its row by having something under it.
                          (.some kept
                                 (fn [child: Any] -> Bool
                                   (and (not (identical? (configentry-kind child)
                                                         "dir"))
                                        (identical?
                                         (config-row-scope
                                          (configentry-kind child)
                                          (configentry-name child))
                                         (configentry-name entry))))))))]
    (config-tree-rows held))))

;; Pure: which nodes are open. Session-local and defaulting to none, so the panel
;; opens as a list of directories — the question "which scopes exist" answered
;; before the question "what is in them".
(js/export
 (defn config-node-expanded?
  [expanded: Any
   slug: String] -> Bool
  (if expanded (.includes expanded slug) false)))

;; Pure: the tree minus the nodes that are folded shut. A row whose node is not
;; in the list at all stays visible: there is no fold row to open it with, so
;; folding it away would put it out of reach.
(js/export
 (defn config-fold-rows
  [entries: Any
   expanded: Any] -> Any
  (let [nodes (.map (.filter entries
                             (fn [entry: Any] -> Bool
                               (identical? (configentry-kind entry) "dir")))
                    (fn [entry: Any] -> String (configentry-name entry)))]
    (.filter entries
             (fn [entry: Any] -> Bool
               (let [kind (configentry-kind entry)
                     scope (config-row-scope kind (configentry-name entry))]
                 (or (identical? kind "dir")
                     (not (.includes nodes scope))
                     (config-node-expanded? expanded scope))))))))

;; ---------------------------------------------------------------------------
;; The live filter. `/` inside an open panel narrows its rows as you type; the
;; rows that survive are what the cursor walks, what space flips and what enter
;; edits, so a filtered panel is a smaller panel and not a different surface.
;; ---------------------------------------------------------------------------

;; Pure: the text a query is matched against — what the row SAYS plus what it is
;; called plus what it carries. The label is on screen (`AGENTS.md`), the name is
;; how the manifest and the CLI spell it (`code`, `code/style`), and the detail
;; is the path or whatever else the row's fourth field holds. Searching what you
;; can see and what you can address are the same question asked from two ends,
;; and answering only one of them makes rows unfindable by the name printed on
;; them.
(js/export
 (defn config-row-search-text [entry: Any] -> String
  (let [kind (configentry-kind entry)
        name (configentry-name entry)]
    (.toLowerCase (str (config-row-label kind name) " "
                       name " "
                       (text (configentry-detail entry)))))))

;; Pure: case-insensitive substring, and an empty query matches everything —
;; entering filter mode must not blank the panel before a character is typed.
(js/export
 (defn config-row-matches?
  [entry: Any
   query: String] -> Bool
  (let [needle (.toLowerCase (.trim query))]
    (or (identical? needle "")
        (.includes (config-row-search-text entry) needle)))))

;; Pure: the node slugs of the matched rows of one kind, which is how a match
;; reaches the rows above and below it.
(defn config-matched-slugs
  [entries: Any
   query: String
   kind: String] -> Any
  (.map (.filter entries
                 (fn [entry: Any] -> Bool
                   (and (identical? (configentry-kind entry) kind)
                        (config-row-matches? entry query))))
        (fn [entry: Any] -> String
          (config-row-scope (configentry-kind entry) (configentry-name entry)))))

;; Pure: rows + query -> the rows the panel shows. A match never arrives alone:
;;
;;   a matching row keeps the node it is scoped to, because a skill under a
;;   directory you cannot see is a row with no address on screen;
;;   a matching node keeps everything under it, because narrowing to a directory
;;   is how you ask what that directory carries.
;;
;; The fold is not consulted while a query is up — a match opens whatever it is
;; buried under, and the fold state it ignored is still there when the query is
;; cleared. Section headers need no rule of their own either: they are printed
;; from the rows that survive, so a section with nothing left prints nothing.
(js/export
 (defn config-query-rows
  [entries: Any
   query: String] -> Any
  (if (identical? (.trim query) "")
    entries
    (let [open-nodes (config-matched-slugs entries query "dir")
          open-mems (config-matched-slugs entries query "memroot")
          ;; The nodes some matched row hangs off, which is what keeps a
          ;; directory on screen above its match.
          held (.map (.filter entries
                              (fn [entry: Any] -> Bool
                                (config-row-matches? entry query)))
                     (fn [entry: Any] -> String
                       (config-row-scope (configentry-kind entry)
                                         (configentry-name entry))))
          held-mems (.map (.filter entries
                                   (fn [entry: Any] -> Bool
                                     (and (identical? (configentry-kind entry)
                                                      "mem")
                                          (config-row-matches? entry query))))
                          (fn [entry: Any] -> String
                            (config-row-scope (configentry-kind entry)
                                              (configentry-name entry))))
          ;; A bound hook is drawn inside the skill that declared it, so that
          ;; skill is one of its ancestors and comes with it.
          held-skills (.map (.filter entries
                                     (fn [entry: Any] -> Bool
                                       (and (identical? (configentry-kind entry)
                                                        "hook")
                                            (config-row-matches? entry query))))
                            (fn [entry: Any] -> String
                              (config-hook-companion entry)))
          open-skills (.map (.filter entries
                                     (fn [entry: Any] -> Bool
                                       (and (identical? (configentry-kind entry)
                                                        "skill")
                                            (config-row-matches? entry query))))
                            (fn [entry: Any] -> String
                              (configentry-name entry)))]
      (.filter entries
               (fn [entry: Any] -> Bool
                 (let [kind (configentry-kind entry)
                       scope (config-row-scope kind (configentry-name entry))]
                   (or (config-row-matches? entry query)
                       ;; A matched node opens everything scoped to it.
                       (.includes open-nodes scope)
                       ;; A matched memories gate opens the memories it holds.
                       (and (identical? kind "mem") (.includes open-mems scope))
                       ;; A matched anything keeps the node over it.
                       (and (identical? kind "dir") (.includes held scope))
                       ;; A matched memory keeps the gate over it.
                       (and (identical? kind "memroot")
                            (.includes held-mems scope))
                       ;; A matched hook keeps the skill it is drawn inside.
                       (and (identical? kind "skill")
                            (.includes held-skills (configentry-name entry)))
                       ;; A matched skill brings the hooks it declared.
                       (and (identical? kind "hook")
                            (.includes open-skills
                                       (config-hook-companion entry)))))))))))

;; Pure: whether this row is on screen on its own account or only to give a
;; match its context. The panel dims the second kind: it is scaffolding around
;; the answer, not the answer.
(js/export
 (defn config-row-context-only?
  [entry: Any
   query: String] -> Bool
  (and (not (identical? (.trim query) ""))
       (not (config-row-matches? entry query)))))

(defn config-manifest-path [] -> String
  (str (text (.-HOME (.-env process))) "/.config/agents/manifest.conf"))

;; Where the rosters live. A static path the panel reads directly, on exactly
;; the trust it already extends to the manifest: both are files the CLI writes
;; and nobody else does. Injectable through the runtime so a test can point the
;; reader at a fixture directory instead of the machine's real one.
(defn config-modules-dir [runtime: Any] -> String
  (text-or (text (.-configModulesDir runtime))
           (str (text (.-HOME (.-env process)))
                "/code/nixos-config/main/dotfiles/agents/modules.d")))

;; Pure: one modules.d file -> one roster. A file that is unreadable JSON, or
;; carries no `members` array, is a module with an empty roster and never an
;; exception: a broken roster must not take the switchboard down with it.
(js/export
 (defn config-membership-of-json
  [module: String
   content: String] -> Any
  (try
    (let [parsed (JSON/parse content)
          members (if (and parsed (Array/isArray (.-members parsed)))
                    (.-members parsed)
                    [])]
      (->ModuleMembership module
                          (.map members (fn [member: Any] -> String
                                          (text member)))))
    (catch Error _ (->ModuleMembership module [])))))

;; The roster directory need not exist — no module has ever been given members,
;; or this machine has no nixos-config checkout — and that is not an error. No
;; directory means no memberships, which means every unit gates on its own
;; switch exactly as it did before bundles existed.
(defn list-module-files! [directory: String] -> (Promise Any)
  (try
    (let [listing (js/await (run-command ["ls" directory]))]
      (.filter (.split (.trim listing) "\n")
               (fn [name: String] -> Bool (.endsWith name ".json"))))
    (catch Error _ [])))

(defn read-module-file! [path: String] -> (Promise String)
  (try
    (js/await (run-command ["cat" path]))
    (catch Error _ "")))

(js/export
 (defn load-config-memberships!
  [directory: String] -> (Promise Any)
  (let [files (js/await (list-module-files! directory))
        contents (js/await
                  (Promise/all
                   (.map files (fn [file: String] -> Any
                                 (read-module-file! (str directory "/" file))))))]
    (.map files
          (fn [file: String
               index: Int] -> Any
            (config-membership-of-json
             (.slice file 0 (- (.-length file) 5))
             (text (aget contents index))))))))

(defn ensure-config-manifest! [] -> (Promise Any)
  ;; `agents status` creates the manifest; only pay for it when absent.
  (try
    (js/await (run-command ["test" "-f" (config-manifest-path)]))
    (catch Error _
      (js/await (run-command [AGENTS-BIN "status"])))))

;; Filter mode is a state of the open panel, not of the manifest: the query and
;; the mode are separate facts because `/` with nothing typed yet is already
;; filtering — the field is on screen and the next keystroke goes into it.
(defn panel-filtering? [runtime: Any] -> Bool
  (if (.-panelFiltering runtime) true false))

(defn panel-query [runtime: Any] -> String
  (if (panel-filtering? runtime) (text (.-panelQuery runtime)) ""))

;; The rows the panel is actually showing, which is what the cursor walks and
;; what space and enter act on. Every caller that used to read configEntries
;; directly reads this instead, or the filter would be a lie told only to the
;; renderer and space would flip a row that is not on screen.
;; What is open before you have opened anything. GLOBAL is the profile every
;; other node is read on top of, so it is the one node whose contents are always
;; part of the answer; the rest open folded, which is what makes the panel a list
;; of scopes rather than a wall. An empty list is a state you chose — shutting
;; GLOBAL keeps it shut — because only an absent field falls back to this.
(def PANEL-DEFAULT-EXPANDED: Any [GLOBAL-DIR-NAME])

;; The nodes this session has opened. Session-local by construction: it lives on
;; the runtime and nothing writes it to disk, so the panel opens to the same
;; shape every time and a fold is never a setting you have to remember you
;; changed.
(defn panel-expanded [runtime: Any] -> Any
  (let [stored (.-expandedDirs runtime)]
    (if stored stored PANEL-DEFAULT-EXPANDED)))

(js/export
 (defn config-panel-rows [runtime: Any] -> Any
  (let [stored (.-configEntries runtime)
        entries (if stored stored [])
        query (panel-query runtime)
        view (text-or (text (.-configFilter runtime)) "all")]
    (if (not (identical? (.trim query) ""))
      ;; A query outranks the fold: it opens whatever it found.
      (config-query-rows entries query)
      (if (config-view-folds? view)
        (config-fold-rows entries (panel-expanded runtime))
        entries)))))

;; The node a row belongs to, which is the row `h` climbs to and the node `l`
;; opens. A dir row is its own node, so the fold keys work wherever the cursor
;; happens to be inside it.
(js/export
 (defn config-row-node [entry: Any] -> String
  (config-row-scope (configentry-kind entry) (configentry-name entry))))

;; The cursor belongs to the filtered list, so every change to the query drags
;; it back inside. A query that empties the panel parks it at zero rather than
;; at minus one.
(js/export
 (defn clamp-panel-cursor! [runtime: Any] -> Any
  (let [total (.-length (config-panel-rows runtime))
        raw (.-configIndex runtime)
        current (if raw raw 0)]
    (set! (.-configIndex runtime)
          (if (> total 0) (Math/max 0 (Math/min current (- total 1))) 0)))))

(js/export
 (defn set-panel-query!
  [runtime: Any
   query: String] -> Any
  (set! (.-panelFiltering runtime) true)
  (set! (.-panelQuery runtime) query)
  (clamp-panel-cursor! runtime)))

(js/export
 (defn clear-panel-filter! [runtime: Any] -> Any
  (set! (.-panelFiltering runtime) false)
  (set! (.-panelQuery runtime) "")
  (clamp-panel-cursor! runtime)))

;; Open or shut one node. The cursor keeps its index, which is the row it was
;; on: expanding pushes rows in below it and collapsing takes them away, and
;; either way the row under the cursor is the node you just folded.
(js/export
 (defn set-node-expanded!
  [runtime: Any
   slug: String
   open?: Bool] -> Any
  (let [current (panel-expanded runtime)
        without (.filter current
                         (fn [held: String] -> Bool
                           (not (identical? held slug))))]
    (set! (.-expandedDirs runtime)
          (if open? (.concat without [slug]) without))
    (clamp-panel-cursor! runtime))))

;; Pure: what a fold key means on the row under the cursor. `l` opens the node
;; you are on; `h` shuts it, or climbs to the node when you are inside one —
;; the tree convention, so a hand that knows one tree knows this one.
(js/export
 (defn fold-key-action
  [dir-row?: Bool
   expanded?: Bool
   open-key?: Bool] -> String
  (cond
    (and open-key? dir-row?) (if expanded? "" "expand")
    open-key? ""
    dir-row? (if expanded? "collapse" "")
    :else "climb")))

(defn load-config-entries! [runtime: Any] -> (Promise Any)
  (js/await (ensure-config-manifest!))
  (let [content (js/await (run-command ["cat" (config-manifest-path)]))
        memberships (js/await (load-config-memberships!
                               (config-modules-dir runtime)))
        config-filter (text-or (text (.-configFilter runtime)) "all")
        lines (.filter (.split content "\n")
                       (fn [line: String] -> Bool
                         (not (identical? (.trim line) ""))))
        all-entries (.map lines
                          (fn [line: String] -> Any
                            (let [parts (.filter (.split (.trim line) " ")
                                                 (fn [part: String] -> Bool
                                                   (not (identical? part ""))))]
                              (->ConfigEntry (text (aget parts 0))
                                             (text (aget parts 1))
                                             (text (aget parts 2))
                                             (.join (.slice parts 3) " ")))))
        entries (config-view-rows all-entries config-filter)]
    ;; The view's rows are what the panel shows; the whole manifest plus the
    ;; rosters are what it needs to derive activity, because a narrowed view
    ;; drops the very rows that decide it and no row mentions its bundle.
    (set! (.-configAllEntries runtime) all-entries)
    (set! (.-configMemberships runtime) memberships)
    (set! (.-configEntries runtime) entries)
    ;; Against the FILTERED list: a reload under a live query must not park the
    ;; cursor past the end of what is on screen.
    (clamp-panel-cursor! runtime)
    (set! (.-configLoaded runtime) true)
    ;; The switchboard reads the manifest, never the control daemon, so it owns
    ;; the render that shows its own result. Waiting for someone else's render
    ;; left the panel stuck on "loading…" whenever nothing else was ticking —
    ;; exactly the case when the daemon handshake has already failed.
    (.render runtime)))

;; An open panel holds the keyboard. The strip already works this way and for
;; the same reason: a surface with a cursor in it must not share the keys with a
;; text field, or `/` means two things at once and the operator finds out which
;; by accident. The composer keeps its content — it only loses the cursor.
(defn focus-panel!
  [runtime: Any
   ui: Any] -> Any
  (set! (.-panelFocused runtime) true)
  (.blur (.-composerInput ui)))

(defn focus-composer!
  [runtime: Any
   ui: Any] -> Any
  (set! (.-panelFocused runtime) false)
  (.focus (.-composerInput ui)))

;; Missing means focused: a panel is opened by asking for it, so the only way to
;; be looking at one you are not driving is to have handed the keyboard back on
;; purpose.
(defn panel-focused? [runtime: Any] -> Bool
  (and (detail-open? runtime)
       (not (identical? (.-panelFocused runtime) false))))

(defn open-config-panel!
  [runtime: Any
   ui: Any
   config-filter: String] -> Any
  (let [already (and (detail-showing? runtime "config")
                     (identical? (text (.-configFilter runtime)) config-filter))]
    (if already
      (do (close-detail! runtime) (focus-composer! runtime ui))
      (do
        (focus-panel! runtime ui)
        (set! (.-configFilter runtime) config-filter)
        (set! (.-configIndex runtime) 0)
        (set! (.-configLoaded runtime) false)
        ;; A query belongs to the view it was typed in. Switching views carries
        ;; no filter across, and neither does closing and reopening one.
        (clear-panel-filter! runtime)
        (open-detail! runtime "config")
        (report-promise! runtime (load-config-entries! runtime))))
    (.render runtime)))

(defn edit-config-entry! [runtime: Any] -> (Promise Any)
  (let [entries (config-panel-rows runtime)]
    (when (> (.-length entries) 0)
      (let [raw (.-configIndex runtime)
            index (Math/max 0 (Math/min (if raw raw 0)
                                        (- (.-length entries) 1)))
            entry (aget entries index)
            ;; A memory's address carries its directory (`code/architecture`);
            ;; the instruction file's is the directory alone, because that is
            ;; already what `agents path` resolves to that file.
            raw-path (js/await (run-command
                                [AGENTS-BIN "path"
                                 (config-cli-name (configentry-kind entry)
                                                  (configentry-name entry))]))
            path (.trim raw-path)
            editor (text-or (text (.-EDITOR (.-env process))) "vi")
            ghostty (.which Bun "ghostty")
            kitty (.which Bun "kitty")
            foot (.which Bun "foot")
            xterm (.which Bun "xterm")
            argv (cond
                   ghostty [ghostty "-e" editor path]
                   kitty [kitty "--detach" editor path]
                   foot [foot editor path]
                   xterm [xterm "-e" editor path]
                   :else nil)]
        (when (nil? argv)
          (throw (Error. "no supported terminal found for edit")))
        (let [child (.spawn Bun {:cmd argv :stdin "ignore"
                                 :stdout "ignore" :stderr "ignore"})]
          (.unref child)
          (publish-line! runtime (str "editing " path)))))))

(defn toggle-config-entry! [runtime: Any] -> (Promise Any)
  (let [entries (config-panel-rows runtime)]
    (when (> (.-length entries) 0)
      (let [raw (.-configIndex runtime)
            index (Math/max 0 (Math/min (if raw raw 0)
                                        (- (.-length entries) 1)))
            entry (aget entries index)
            verb (config-toggle-verb (configentry-state entry))]
        (js/await (run-command [AGENTS-BIN verb
                                (config-cli-name (configentry-kind entry)
                                                 (configentry-name entry))]))
        ;; Reload the whole manifest, never patch the row that was flipped. One
        ;; skill flip changes the derived activity of every hook bound to it,
        ;; a directory flip changes every row in its subtree two links down, and
        ;; the CLI may pin or unpin rows this panel never touched; a local patch
        ;; would leave the rest of the panel asserting a state that is no longer
        ;; true.
        (js/await (load-config-entries! runtime))
        (.render runtime)))))

(defn handle-sound-command!
  [runtime: Any
   rest: String] -> Any
  (let [request (.toLowerCase (.trim rest))]
    (cond
      (or (identical? request "") (identical? request "status"))
      (publish-line! runtime (sound-status runtime))

      (identical? request "on")
      (do (set! (.-soundEnabled runtime) true)
          (publish-line! runtime (sound-status runtime))
          (when (nil? (.-soundPlayer runtime))
            (sound-warning! runtime "install mpv, ffplay, or pw-play to play local assets")))

      (identical? request "off")
      (do (set! (.-soundEnabled runtime) false)
          (publish-line! runtime (sound-status runtime)))

      (.startsWith request "pack ")
      (let [pack (.trim (.slice request 5))]
        (when (not (or (identical? pack "peon") (identical? pack "peasant")))
          (throw (Error. "sound pack must be peon or peasant")))
        (set! (.-soundPack runtime) pack)
        (publish-line! runtime (sound-status runtime)))

      :else
      (throw (Error. "sound requires on, off, status, or pack peon|peasant")))))

;; The control session that died with the daemon. Its execution id belongs to a
;; daemon that no longer exists, so it is not an agent in any state — leaving the
;; row on the roster shows a corpse beside its own successor.
(defn forget-control-session! [runtime: Any] -> Any
  (let [id (text (.-supervisorId runtime))]
    (when (not (identical? id ""))
      (.delete (.-bridgeExecutions runtime) id)
      (set! (.-model runtime) (remove-agent (.-model runtime) id))
      (set! (.-supervisorId runtime) "")
      (set! (.-agentIndex runtime) 0)
      (.render runtime))))

;; The deliberate replacement, in both command sets because the daemon is
;; underneath both views. A stale daemon replaces itself at the next connect
;; when nothing depends on it; this is the escape for the case where something
;; does. It happens in place: the daemon goes, the row it owned goes with it,
;; its successor comes up, and the control session reopens in this same
;; window — never a chore left on screen.
(defn restart-daemon! [runtime: Any] -> (Promise Any)
  (try
    (js/await (run-command [(north-bin) "bridge" "restart"]))
    (forget-control-session! runtime)
    (publish-line! runtime "control daemon replaced; session restored")
    (js/await (launch-agent! runtime SUPERVISOR-BOOT-PROMPT "supervisor"))
    (catch Error error
      (append-error! runtime (error-message error)))))

(js/export
 (defn handle-local-command!
  [runtime: Any
   ui: Any
   input: String] -> Bool
  (let [trimmed (.trim input)]
    (if (not (.startsWith trimmed "/"))
      false
      (let [parsed (command trimmed)
            name (parsedcommand-name parsed)
            rest (parsedcommand-rest parsed)]
        (cond
          (or (identical? name "glyph") (identical? name "prompt"))
          (do
            (if (identical? (.toLowerCase rest) "reset")
              (set-prompt-glyph! runtime DEFAULT-PROMPT-GLYPH)
              (set-prompt-glyph! runtime rest))
            true)

          (identical? name "emoji")
          (let [options (emoji-options rest)]
            (when (identical? (.-length options) 0)
              (throw (Error. (str "no emoji matches " rest))))
            (let [input-renderable (.-composerInput ui)]
              (set! (.-value input-renderable)
                    (slashcommand-completion (aget options 0)))
              (.focus input-renderable)
              (.render runtime))
            true)

          (identical? name "sound")
          (do (handle-sound-command! runtime rest) true)

          (identical? name "mute")
          (do (set! (.-soundEnabled runtime) false)
              (publish-line! runtime (sound-status runtime))
              true)

          (identical? name "config")
          (do (open-config-panel! runtime ui "all") true)

          (identical? name "hooks")
          (do (open-config-panel! runtime ui "hook") true)

          (identical? name "skills")
          (do (open-config-panel! runtime ui "skill") true)

          (identical? name "mcp")
          (do
            (let [parts (.filter (.split (.trim rest) #"\\s+")
                                 (fn [part: String] -> Bool
                                   (not (identical? part ""))))]
              (-> (run-command (.concat [(north-bin) "config" "mcp"] parts))
                  (.then (fn [output: String] -> Any
                           (publish-line! runtime (.trim output))))
                  (.catch (fn [error: Any] -> Any
                            (publish-line! runtime
                                           (str "error: " (error-message error)))))))
            true)

          (identical? name "plugins")
          (do (open-config-panel! runtime ui "plugin") true)

          (identical? name "modules")
          (do (open-config-panel! runtime ui "module") true)

          (identical? name "globals")
          (do (open-config-panel! runtime ui "globals") true)

          (identical? name "agentsmd")
          (do (open-config-panel! runtime ui "agentsmd") true)

          (identical? name "restart")
          (do (restart-daemon! runtime) true)

          ;; The view switches live here rather than in either submit path,
          ;; because both submit paths run this first: one branch and /list
          ;; means the same thing typed from either view.
          (identical? name "agents")
          (do (show-frame! runtime ui "agents") true)

          (identical? name "threads")
          (do (if (identical? (.toLowerCase (.trim rest)) "popout")
                (popout! runtime (text (.-activeView runtime)))
                (show-frame! runtime ui "threads"))
              true)

          (thread-view-command? name)
          (do (show-thread-view! runtime ui name) true)

          ;; One /help, both views, and it lands in the docked panel where the
          ;; escape ladder can close it.
          (identical? name "help")
          (do (toggle-help! runtime ui) true)

          ;; `:q` and its three synonyms: one rung of the escape ladder each,
          ;; typed instead of pressed. Only the root rung quits.
          (escape-command? name)
          (do (escape-step! runtime ui false) true)

          :else false))))))

(defn quiesce! [runtime: Any] -> Any
  (when (not (.-disposed runtime))
    (set! (.-disposed runtime) true)
    (when (.-spinnerTimer runtime) (clearInterval (.-spinnerTimer runtime)))
    (set! (.-spinnerTimer runtime) nil)
    (.forEach (.-soundChildren runtime)
              (fn [child: Any] -> Any
                (try (.kill child) (catch Error _ nil))))
    (.clear (.-soundChildren runtime))))

(defn destroy! [runtime: Any] -> Any
  (when (not (.-disposed runtime))
    (quiesce! runtime)
    (.destroy (.-renderer runtime))
    (.exit process 0)))

(defn install-process-cleanup! [runtime: Any] -> Any
  (doseq [signal ["SIGINT" "SIGTERM" "SIGHUP"]]
    ;; Run before OpenTUI's shutdown listener so late provider/timer callbacks
    ;; see a quiesced runtime before its renderables are destroyed.
    (.prependOnceListener process signal
                          (fn [] -> Any (quiesce! runtime)))))

(defn install-global-exit! [runtime: Any] -> Any
  (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key: Any] -> Any
         (let [name (text (.-name key))]
           (when (and (.-ctrl key)
                      (or (identical? name "c") (identical? name "q")))
             (.preventDefault key)
             (.stopPropagation key)
             (destroy! runtime))))))

;; The index is presentation state; the ID is identity. Every roster mutation
;; resolves the old identity in the new ordering before the composer can use
;; the index again.
(js/export
 (defn selected-agent-id
  [state: BridgeSnapshot
   selected: Int] -> String
  (let [agents (bridgesnapshot-agents state)
        total (.-length agents)]
    (if (> total 0)
      (agent-id (aget agents (Math/max 0 (Math/min selected (- total 1)))))
      ""))))

(js/export
 (defn reconcile-agent-selection!
  [runtime: Any
   prior-id: String] -> String
  (let [state (snapshot (.-model runtime))
        agents (bridgesnapshot-agents state)
        total (.-length agents)
        found (.findIndex agents
                          (fn [agent: Agent] -> Bool
                            (identical? (agent-id agent) prior-id)))
        fallback (Math/max 0
                           (Math/min (.-agentIndex runtime)
                                     (Math/max 0 (- total 1))))
        index (if (>= found 0) found fallback)
        selected (if (> total 0) (agent-id (aget agents index)) "")]
    (set! (.-agentIndex runtime) index)
    (when (not (identical? (bridgesnapshot-selected-agent state) selected))
      (set! (.-model runtime) (select-agent (.-model runtime) selected)))
    selected)))

(defn refresh! [runtime: Any] -> (Promise Any)
  (let [payloads
        (js/await
         (Promise/all
          [(.catch (run-json [(north-bin) "agents" "--json"])
                   (fn [_: Any] -> Any nil))
           (.catch (run-json [(north-bin) "json" "board" "--all"])
                   (fn [_: Any] -> Any nil))
           (.catch (run-json [(north-bin) "json" "done"])
                   (fn [_: Any] -> Any nil))]))
        agent-payload (aget payloads 0)
        board (aget payloads 1)
        done (aget payloads 2)
        state (snapshot (.-model runtime))
        current-agents (bridgesnapshot-agents state)
        remote-agents (if agent-payload (normalize-agents agent-payload) [])
        bridge-agents
        (.map
         (.filter current-agents
                  (fn [agent: Agent] -> Bool
                    (.has (.-bridgeExecutions runtime) (agent-id agent))))
         (fn [agent: Agent] -> Agent
           (let [remote (.find remote-agents
                               (fn [candidate: Agent] -> Bool
                                 (identical? (agent-id candidate) (agent-id agent))))]
             (if remote (agent-with-route agent remote) agent))))
        distinct-remote (.filter remote-agents
                                 (fn [agent: Agent] -> Bool
                                   (not (.has (.-bridgeExecutions runtime) (agent-id agent)))))
        agents (if agent-payload (.concat bridge-agents distinct-remote) current-agents)
        open-rows (if (Array/isArray board) board [])
        done-rows (if (Array/isArray done) done [])
        ids (.concat (board-ids open-rows) (board-ids done-rows))
        facts (if (> (.-length ids) 0)
                (js/await
                 (.catch (run-json [(north-bin) "json" "show-many" (.join ids ",")])
                         (fn [_: Any] -> Any [])))
                [])
        work (if (Array/isArray board)
               (normalize-work open-rows facts)
               (bridgesnapshot-list state))
        prior-terminal (.filter (bridgesnapshot-board state)
                                (fn [item: WorkItem] -> Bool
                                  (terminal-condition? (workitem-condition item))))
        terminal-work (if (Array/isArray done)
                        (normalize-work done-rows facts)
                        prior-terminal)
        list-work (.concat work terminal-work)
        kanban (ordered-board-items work terminal-work)
        next-model (replace-projection (.-model runtime) agents list-work kanban)
        prior-agent-id (selected-agent-id state (.-agentIndex runtime))
        selected-id (bridgesnapshot-selected-thread state)
        next-state (snapshot next-model)
        next-view (selected-view next-state (.-activeView runtime))
        next-items (workview-items next-view)
        next-index (.findIndex next-items
                               (fn [item: WorkItem] -> Bool
                                 (identical? (workitem-id item) selected-id)))]
    (set! (.-model runtime) next-model)
    (reconcile-agent-selection! runtime prior-agent-id)
    (when (>= next-index 0)
      (set! (.-workIndex runtime) next-index)
      (when (identical? (workview-id next-view) "list")
        (.delete (.-collapsedListConditions runtime)
                 (list-section-id (workitem-condition (aget next-items next-index))))))
    (.render runtime)))

(defn canonical-work-view [view-id: String] -> String
  (cond
    (or (identical? view-id "graph") (identical? view-id "dag")) "graph"
    (or (identical? view-id "board") (identical? view-id "kanban")) "board"
    :else "list"))

;; Pure: is this slash command one of the threads frame's view switches? The
;; command *is* the view — there is no verb to remember and no argument to get
;; wrong, and `dag`/`kanban` are not commands at all.
(js/export
 (defn thread-view-command? [name: String] -> Bool
  (or (identical? name "list")
      (identical? name "board")
      (identical? name "graph"))))

(js/export
 (defn view-list [state: BridgeSnapshot] -> (Vec WorkView)
  [(->WorkView "list" "List" (bridgesnapshot-list state))
   (->WorkView "board" "Board" (bridgesnapshot-board state))
   (->WorkView "graph" "Graph" (bridgesnapshot-list state))]))

(defn selected-view
  [state: BridgeSnapshot
   view-id: String] -> WorkView
  (let [views (view-list state)
        canonical (canonical-work-view view-id)
        selected (.find views
                        (fn [view: WorkView] -> Bool
                          (identical? (workview-id view) canonical)))]
    (or selected (aget views 0))))

;; Pure: is this the roster row the banner is already saying? The banner states
;; the control session's revision, model, directory and permissions, and the
;; roster row one line above it states that same session's name and status —
;; with the banner up, the row is the duplicate, and the row is what goes. It
;; comes back with its status the moment the banner does not own the screen any
;; more. Only the control session is ever suppressed; every other agent's row is
;; the only place its status appears.
(js/export
 (defn roster-row-suppressed?
  [agent-id: String
   supervisor-id: String
   banner?: Bool] -> Bool
  (and banner?
       (not (identical? supervisor-id ""))
       (identical? agent-id supervisor-id))))

(js/export
 (defn roster-text
  [state: BridgeSnapshot
   selected: Int
   supervisor-id: String
   banner?: Bool] -> String
  (let [agents (bridgesnapshot-agents state)
        width (Math/max 1 (- (terminal-columns) 6))
        rows (.filter
              (.map agents
                    (fn
                      [agent: Agent
                       index: Int] -> Any
                      {:id (agent-id agent)
                       :text (agent-row-text agent
                                             (identical? index selected)
                                             width)}))
              (fn [row: Any] -> Bool
                (not (roster-row-suppressed? (.-id row) supervisor-id banner?))))]
    (cond
      (identical? (.-length agents) 0) "No agents attached"
      ;; Everything the roster had to show is what the banner is showing. The
      ;; pane says nothing rather than reporting "no agents" about a session
      ;; that is plainly on the screen underneath.
      (identical? (.-length rows) 0) ""
      :else (.join (.map rows (fn [row: Any] -> String (.-text row))) "\n")))))

(defn agent-display-name [agent: Agent] -> String
  (let [name (agent-field-text (agent-name agent))]
    (if (identical? name "") (agent-field-text (agent-id agent)) name)))

(defn agent-summary [agent: Agent] -> String
  (let [status (agent-field-text (agent-status agent))
        task (agent-field-text (agent-task agent))]
    (str (agent-display-name agent)
         (if (identical? status "") "" (str " (" status ")"))
         (if (identical? task "") "" (str " — " task)))))

(js/export
 (defn agent-row-text
  [agent: Agent
   selected?: Bool
   width: Int] -> String
  (let [prefix (if selected? "› " "  ")]
    (str prefix (agent-cell-text (agent-summary agent)
                                 (Math/max 1 (- width (.stringWidth Bun prefix))))))))

(defn route-provider [agent: Agent] -> String
  (let [label (agent-field-text (agent-provider-label agent))
        provider (agent-field-text (agent-provider agent))
        target (agent-field-text (agent-provider-target agent))]
    (cond
      (not (identical? label "")) label
      (and (not (identical? provider "")) (not (identical? target "")))
      (str provider ":" target)
      :else (text-or provider target))))

(defn route-model [agent: Agent] -> String
  (text-or (agent-field-text (agent-model-display agent))
           (agent-field-text (agent-model agent))))

(js/export
 (defn agent-route-text
  [agent: Agent
   width: Int] -> String
  (let [provider (route-provider agent)
        model (route-model agent)
        effort (agent-field-text (agent-effort agent))
        provenance (agent-field-text (agent-orchestration-provenance agent))
        state (agent-field-text (agent-state agent))
        goal (agent-field-text (agent-goal agent))
        parts (.filter
               [(if (identical? provider "") "" (str "provider " provider))
                (if (identical? model "") "" (str "model " model))
                (if (identical? effort "") "" (str "effort " effort))
                (if (identical? provenance "") "" provenance)
                (if (identical? state "") "" (str "state " state))
                (if (identical? goal "") "" (str "goal " goal))]
               (fn [part: String] -> Bool (not (identical? part ""))))]
    (agent-cell-text (.join parts " · ") width))))

;; Pure: every agent state this app can observe folded onto the strip's
;; vocabulary. Bridge-local executions report starting/working/ready/offline;
;; the agents CLI reports working/stalled/offline/inconsistent(...) and
;; finished(process:…, delivery:…). Anything unrecognized stays "other" so it
;; is counted in the total without inventing a state.
(defn agent-bucket [status: String] -> String
  (let [value (.toLowerCase (.trim status))]
    (cond
      (identical? value "") "other"

      (.startsWith value "finished(")
      (if (or (.includes value "process:failed")
              (.includes value "process:error"))
        "failed" "other")

      (.startsWith value "inconsistent") "blocked"

      (or (identical? value "stalled")
          (identical? value "blocked")
          (identical? value "waiting")
          (identical? value "paused")
          (identical? value "queued")) "blocked"

      (or (identical? value "failed")
          (identical? value "error")
          (identical? value "crashed")) "failed"

      (or (identical? value "working")
          (identical? value "running")
          (identical? value "starting")
          (identical? value "ready")
          (identical? value "active")
          (identical? value "online")) "running"

      :else "other")))

(defn agents-in-bucket
  [agents: (Vec Agent)
   bucket: String] -> (Vec Agent)
  (.filter agents
           (fn [agent: Agent] -> Bool
             (identical? (agent-bucket (agent-status agent)) bucket))))

(defn segment-agents
  [agents: (Vec Agent)
   segment-id: String] -> (Vec Agent)
  (if (identical? segment-id "all")
    agents
    (agents-in-bucket agents segment-id)))

(defn agent-total-label [total: Int] -> String
  (str total (if (identical? total 1) " agent" " agents")))

(defn agent-segments [agents: (Vec Agent)] -> (Vec AgentSegment)
  (let [total (.-length agents)
        segments [(->AgentSegment "all" (agent-total-label total) total)]]
    (.forEach
     STRIP-BUCKETS
     (fn [bucket: StripBucket] -> Any
       (let [id (stripbucket-id bucket)
             members (agents-in-bucket agents id)
             count (.-length members)]
         (when (> count 0)
           (.push segments
                  (->AgentSegment id
                                  (str (stripbucket-glyph bucket) count " " id)
                                  count))))))
    segments))

;; Pure: the column each segment starts at, so a click lands on the same
;; segment the eye reads. Focus never changes a label's width.
(defn segment-columns [segments: (Vec AgentSegment)] -> (Vec Int)
  (let [starts []]
    (.forEach
     segments
     (fn
       [_segment: AgentSegment
        index: Int] -> Any
       (.push starts
              (if (identical? index 0)
                STRIP-INDENT
                (+ (aget starts (- index 1))
                   (.-length (agentsegment-label (aget segments (- index 1))))
                   (.-length STRIP-SEPARATOR))))))
    starts))

(defn segment-at-column
  [segments: (Vec AgentSegment)
   column: Int] -> Int
  (let [starts (segment-columns segments)]
    (.findIndex starts
                (fn
                  [start: Int
                   index: Int] -> Bool
                  (and (>= column start)
                       (< column
                          (+ start
                             (.-length (agentsegment-label (aget segments index))))))))))

(defn push-chunk!
  [chunks: Any
   chunk: Any] -> Any
  (.push chunks chunk))

(defn render-command-palette!
  [commands: (Vec SlashCommand)
   selected: Int
   more: Int] -> Any
  (let [chunks []]
    (.forEach
     commands
     (fn
       [candidate: SlashCommand
        index: Int] -> Any
       (push-chunk! chunks
                    (if (identical? index selected) (brightCyan "› ") (brightBlack "  ")))
       (push-chunk! chunks
                    ((if (identical? index selected) brightGreen brightWhite)
                     (.padEnd (slashcommand-name candidate) 13 " ")))
       (push-chunk! chunks (brightBlack (slashcommand-description candidate)))
       (when (< index (- (.-length commands) 1))
         (push-chunk! chunks (white "\n")))))
    ;; The list never hides anything silently: when the terminal cannot show
    ;; every match, the last row says how many are still out there.
    (when (> more 0)
      (push-chunk! chunks (white "\n"))
      (push-chunk! chunks (brightBlack (str "  … " more " more"))))
    (StyledText. chunks)))

(defn terminal-columns [] -> Int
  (let [stdout (.-stdout process)
        columns (if stdout (.-columns stdout) nil)]
    (Math/max 1 (if (identical? (js/typeof columns) "number") columns 120))))

(defn terminal-rows [] -> Int
  (let [stdout (.-stdout process)
        rows (if stdout (.-rows stdout) nil)]
    (Math/max 1 (if (identical? (js/typeof rows) "number") rows 40))))

;; One view is on screen at a time, so showing a view is one boolean per
;; container and no arithmetic at all: no ratio, no divider, no minimum.
(js/export
 (defn apply-frame-visibility!
  [runtime: Any
   ui: Any] -> Any
  (let [threads? (threads-frame? (.-frame runtime))]
    (set! (.-visible (.-agentsPane ui)) (not threads?))
    (set! (.-visible (.-workPane ui)) threads?))))

;; Every view is full width now, so they all measure the same.
(defn available-frame-width [] -> Int
  (Math/max 24 (- (terminal-columns) 6)))

(defn available-agent-width [_runtime: Any] -> Int
  (available-frame-width))

(defn user-block-text
  [runtime: Any
   body: String] -> String
  (let [width (available-agent-width runtime)
        lines (.split body "\n")]
    (.join
     (.map lines
           (fn
             [line: String
              index: Int] -> String
             (let [prefix (if (identical? index 0) "❯ " "  ")]
               (.padEnd (str prefix line) width " "))))
     "\n")))

(defn short-directory [directory: Any] -> String
  (let [path (text directory)
        home (text (.-HOME (.-env process)))]
    (if (and (not (identical? home "")) (.startsWith path home))
      (str "~" (.slice path (.-length home)))
      path)))

(defn session-context-text [runtime: Any] -> String
  (str (text-or (.-sessionModel runtime) "model pending") " "
       (text-or (.-sessionEffort runtime) "effort pending") " · "
       (text-or (short-directory (.-sessionCwd runtime)) "directory pending") " · "
       (text-or (.-sessionBranch runtime) "branch pending")))

(defn command-parts [title: String] -> CommandParts
  (let [space (.indexOf title " ")]
    (if (< space 0)
      (->CommandParts title "")
      (->CommandParts (.slice title 0 space)
                      (.slice title (+ space 1))))))

(defn push-command-output!
  [chunks: Any
   output: String] -> Any
  (let [trimmed (.trimEnd output)]
    (when (not (identical? trimmed ""))
      (let [lines (.split trimmed "\n")
            limit 8
            overflow (Math/max 0 (- (.-length lines) limit))
            visible (.slice lines 0 (if (> overflow 0) (- limit 1) limit))]
        (.forEach
         visible
         (fn
           [line: String
            index: Int] -> Any
           (let [last? (and (identical? overflow 0)
                            (identical? index (- (.-length visible) 1)))]
             (push-chunk! chunks
                          (dim (str "\n  " (if last? "└ " "│ ") line))))))
        (when (> overflow 0)
          (push-chunk! chunks (dim (str "\n  └ … +" (+ overflow 1) " lines"))))))))

(defn push-command-card!
  [chunks: Any
   title: String
   body: String
   status: String] -> Any
  (let [parts (command-parts title)
        running? (identical? status "running")]
    (push-chunk! chunks
                 ((cond
                    (identical? status "failed") brightRed
                    running? brightYellow
                    :else brightGreen)
                  "• "))
    (push-chunk! chunks (brightWhite (if running? "Running " "Ran ")))
    (push-chunk! chunks (brightCyan (commandparts-executable parts)))
    (when (not (identical? (commandparts-arguments parts) ""))
      (push-chunk! chunks (dim (str " " (commandparts-arguments parts)))))
    (push-command-output! chunks body)
    (push-chunk! chunks (white "\n\n"))))

(defn diff-start-line [token: Any] -> Int
  (let [value (text token)
        without-sign (if (> (.-length value) 0) (.slice value 1) "0")
        comma (.indexOf without-sign ",")
        number-text (if (< comma 0) without-sign (.slice without-sign 0 comma))
        parsed (Number number-text)]
    (if (Number/isFinite parsed) parsed 0)))

(defn append-diff-row
  [state: DiffState
   row: DiffRow] -> DiffState
  (with state [:rows (.concat (diffstate-rows state) row)]))

(defn diff-rows [diff: Any] -> DiffState
  (let [source (clean-text diff)]
    (if (identical? source "")
      (->DiffState 0 0 0 0 [])
      (.reduce
       (.split source "\n")
       (fn
         [state: DiffState
          line: String] -> DiffState
         (cond
           (.startsWith line "@@ ")
           (let [parts (.split line " ")]
             (append-diff-row
              (with state
                [:old-line (diff-start-line (aget parts 1))]
                [:new-line (diff-start-line (aget parts 2))])
              (->DiffRow "hunk" "" "" line)))

           (or (.startsWith line "diff --git ")
               (.startsWith line "index ")
               (.startsWith line "--- ")
               (.startsWith line "+++ ")) state

           (.startsWith line "+")
           (append-diff-row
            (with state
              [:new-line (+ (diffstate-new-line state) 1)]
              [:additions (+ (diffstate-additions state) 1)])
            (->DiffRow "add" "" (str (diffstate-new-line state)) line))

           (.startsWith line "-")
           (append-diff-row
            (with state
              [:old-line (+ (diffstate-old-line state) 1)]
              [:deletions (+ (diffstate-deletions state) 1)])
            (->DiffRow "delete" (str (diffstate-old-line state)) "" line))

           (.startsWith line "\\ No newline")
           (append-diff-row state (->DiffRow "meta" "" "" line))

           :else
           (append-diff-row
            (with state
              [:old-line (+ (diffstate-old-line state) 1)]
              [:new-line (+ (diffstate-new-line state) 1)])
            (->DiffRow "context"
                       (str (diffstate-old-line state))
                       (str (diffstate-new-line state))
                       line))))
       (->DiffState 0 0 0 0 [])))))

(defn file-change-details [change: Any] -> FileChangeDetails
  (let [parsed (diff-rows (.-diff change))]
    (->FileChangeDetails (text (.-path change))
                         (text (.-kind change))
                         (diffstate-additions parsed)
                         (diffstate-deletions parsed)
                         (diffstate-rows parsed))))

(defn file-change-summary [changes: Any] -> FileChangeSummary
  (.reduce
   changes
   (fn
     [summary: FileChangeSummary
      change: Any] -> FileChangeSummary
     (let [details (file-change-details change)]
       (with summary
         [:additions (+ (filechangesummary-additions summary)
                        (filechangedetails-additions details))]
         [:deletions (+ (filechangesummary-deletions summary)
                        (filechangedetails-deletions details))]
         [:files (.concat (filechangesummary-files summary) details)])))
   (->FileChangeSummary 0 0 [])))

(defn diff-line-number [value: Any] -> String
  (let [number-text (text value)]
    (.padStart number-text 4 " ")))

(defn push-diff-rows!
  [chunks: Any
   rows: (Vec DiffRow)
   width: Int] -> Any
  (let [limit 36
        visible (.slice rows 0 limit)
        overflow (Math/max 0 (- (.-length rows) limit))]
    (.forEach
     visible
     (fn [row: DiffRow] -> Any
       (let [kind (diffrow-kind row)
             numbers (str (diff-line-number (diffrow-old row)) " "
                          (diff-line-number (diffrow-new row)) " │ ")
             line (compact-text (str numbers (diffrow-text row)) width)]
         (push-chunk! chunks (white "\n"))
         (push-chunk! chunks
                      (cond
                        (identical? kind "add") ((bg "#173326") (brightGreen (.padEnd line width " ")))
                        (identical? kind "delete") ((bg "#382127") (brightRed (.padEnd line width " ")))
                        (identical? kind "hunk") (brightCyan line)
                        :else (dim line))))))
    (when (> overflow 0)
      (push-chunk! chunks (dim (str "\n          └ … +" overflow " diff lines"))))))

(defn push-file-change-card!
  [chunks: Any
   item: ConversationItem
   status: String
   runtime: Any] -> Any
  (let [data (conversationitem-data item)
        changes (if (and data (Array/isArray (.-changes data))) (.-changes data) [])
        summary (file-change-summary changes)
        files (filechangesummary-files summary)
        width (Math/max 24 (- (available-agent-width runtime) 2))]
    (push-chunk! chunks (if (identical? status "failed") (brightRed "• ") (brightGreen "• ")))
    (push-chunk! chunks
                 (brightWhite
                  (str (if (identical? status "running") "Editing " "Edited ")
                       (.-length files) (if (identical? (.-length files) 1) " file" " files")
                       " (+" (filechangesummary-additions summary)
                       " -" (filechangesummary-deletions summary) ")")))
    (.forEach
     files
     (fn
       [file: FileChangeDetails
        index: Int] -> Any
       (let [last? (identical? index (- (.-length files) 1))]
         (push-chunk! chunks
                      (brightBlack
                       (str "\n  " (if last? "└ " "├ ")
                            (filechangedetails-path file) " (+"
                            (filechangedetails-additions file)
                            " -" (filechangedetails-deletions file) ")")))
         (when (> (.-length (filechangedetails-rows file)) 0)
           (push-diff-rows! chunks (filechangedetails-rows file) width)))))
    (push-chunk! chunks (white "\n\n"))))

(defn push-working-wave!
  [chunks: Any
   runtime: Any] -> Any
  (let [letters (.split "Working" "")
        cursor (mod (.-spinnerIndex runtime) (.-length letters))]
    (push-chunk! chunks (brightBlack "• "))
    (.forEach
     letters
     (fn
       [letter: String
        index: Int] -> Any
       (push-chunk!
        chunks
        (if (identical? index cursor)
          (brightBlack letter)
          (brightWhite letter)))))))

;; The status the roster header and the agent strip already read: the control
;; session's own row in the model, not a guess made from an empty transcript.
(defn supervisor-status [runtime: Any] -> String
  (let [id (text (.-supervisorId runtime))
        agents (bridgesnapshot-agents (snapshot (.-model runtime)))
        matches (.filter agents
                         (fn [agent: Agent] -> Bool
                           (and (not (identical? id ""))
                                (identical? (agent-id agent) id))))]
    (if (identical? (.-length matches) 0) "" (agent-status (aget matches 0)))))

;; Pure: what the empty transcript should say. The old rule was "empty and not
;; working ⇒ Starting …", which never expired — the session could be ready, the
;; header could say so, and this line still claimed a boot in progress. An empty
;; string means show nothing.
;;
;; The ready state says nothing HERE any more: "Main is ready." was a line that
;; told you the one thing the roster header and the strip were already telling
;; you, on the screen with the most room to say something useful. A ready and
;; empty transcript renders the session banner instead (see
;; transcript-banner?), and this fold keeps the two states a banner cannot
;; stand in for — a boot in progress and a session that is gone.
(js/export
 (defn transcript-placeholder
  [label: String
   status: String
   item-count: Int
   working?: Bool] -> String
  (let [value (.toLowerCase (.trim status))]
    (cond
      (> item-count 0) ""
      working? ""
      (or (identical? value "") (identical? value "starting")) (str "Starting " label "…")
      (or (identical? value "offline")
          (identical? value "failed")
          (identical? value "error")) (str label " is offline.")
      :else ""))))

;; Pure: whether the banner is what this transcript should be showing. The same
;; three facts the placeholder folds, asking after the one state it no longer
;; answers for — and the disappearance rule is unchanged, because it is the
;; same rule: any transcript content at all, or a turn in flight, and the empty
;; screen is not empty any more.
(js/export
 (defn transcript-banner?
  [status: String
   item-count: Int
   working?: Bool] -> Bool
  (let [value (.toLowerCase (.trim status))]
    (and (identical? item-count 0)
         (not working?)
         (not (identical? value ""))
         (not (identical? value "starting"))
         (not (identical? value "offline"))
         (not (identical? value "failed"))
         (not (identical? value "error"))))))

;; Whether the banner owns the screen right now, asked of the runtime once so
;; that everything which has to agree with the banner — the transcript that
;; draws it, the roster that stands down for it — reads the same answer instead
;; of each recomputing the rule.
(defn banner-visible? [runtime: Any] -> Bool
  (transcript-banner? (supervisor-status runtime)
                      (.-length (.-conversation runtime))
                      (if (.-working runtime) true false)))

;; The banner's own facts, each labelled, in one column. The label width is
;; fixed so the values line up as a column of answers rather than a paragraph.
(def BANNER-LABEL-WIDTH: Int 13)

;; Below this the box is more cost than frame: the borders take four columns
;; and a clipped path or model tells you less than the plain line does. The
;; banner degrades to its own lines rather than wrapping, because a wrapped box
;; is a broken box.
(def BANNER-MIN-COLUMNS: Int 55)

;; The bridge has no `/model` command, so the banner does not invent one. What
;; actually changes the model is the environment the app is launched with, and
;; that is what the hint names. If a command is ever added, this is the string
;; that changes.
(def BANNER-MODEL-HINT: String "NORTH_BRIDGE_MODEL to change")

;; Pure: the identity to print. The handshake identity is a full commit hash;
;; what a human needs off the screen is the short rev they would type at git.
(js/export
 (defn banner-revision [identity: Any] -> String
  (let [value (.trim (text identity))]
    (if (identical? value "") "unknown" (.slice value 0 8)))))

;; Pure: `bypassPermissions` is the mode where nothing is asked, and calling it
;; by its wire name buries that. The operator's word for it is the one that
;; carries the warning.
(js/export
 (defn banner-permissions [mode: Any] -> String
  (let [value (.trim (text mode))]
    (cond
      (identical? value "") "pending"
      (identical? value "bypassPermissions") "YOLO mode"
      :else value))))

(defn banner-field
  [label: String
   value: String] -> String
  (str (.padEnd (str label ":") BANNER-LABEL-WIDTH " ") value))

;; Pure: session facts -> the banner's content lines, before any box is drawn
;; around them. A fact the session has not reported yet says `pending`, which is
;; the word the rest of the frame already uses for the same gap.
(js/export
 (defn session-banner-lines
  [identity: Any
   model: Any
   effort: Any
   directory: Any
   permissions: Any] -> Any
  (let [named (text-or (text model) "pending")
        graded (text effort)
        model-text (if (identical? graded "") named (str named " " graded))]
    [(str ">_ North Bridge (" (banner-revision identity) ")")
     ""
     (banner-field "model" (str model-text "   " BANNER-MODEL-HINT))
     (banner-field "directory" (text-or (text directory) "pending"))
     (banner-field "permissions" (banner-permissions permissions))])))

;; Pure: a line cut to fit, tail-first, so the end of a long path or model name
;; is what survives — the part that distinguishes it from its neighbours.
(defn banner-clip
  [line: String
   width: Int] -> String
  (let [limit (Math/max 1 width)]
    (if (> (grapheme-count line) limit)
      (str (.slice line 0 (Math/max 0 (- limit 1))) "…")
      line)))

;; Pure: the widest line, which is what the box is drawn around — sized to the
;; content rather than to the terminal, so the banner is a card and not a rule.
(defn widest-line [lines: Any] -> Int
  (let [widest {:n 0}]
    (.forEach lines
              (fn [line: String] -> Any
                (when (> (grapheme-count line) (.-n widest))
                  (set! (.-n widest) (grapheme-count line)))))
    (.-n widest)))

;; Pure: content lines -> the lines actually drawn. Wide enough and they get the
;; box, clipped to what fits so a long path cannot push a border off the edge
;; and wrap the frame open. Narrow and they get themselves: a box that does not
;; fit is not a smaller box, it is a broken one.
(js/export
 (defn banner-box
  [lines: Any
   width: Int] -> Any
  (let [inner (Math/max 1 (- width 4))
        clipped (.map lines
                      (fn [line: String] -> String (banner-clip line inner)))]
    (if (< width BANNER-MIN-COLUMNS)
      clipped
      (let [span (Math/min inner (widest-line clipped))
            rule (.repeat "─" (+ span 2))]
        (.concat [(str "╭" rule "╮")]
                 (.map clipped
                       (fn [line: String] -> String
                         (str "│ " (.padEnd line span " ") " │")))
                 [(str "╰" rule "╯")]))))))

(js/export
 (defn session-banner
  [identity: Any
   model: Any
   effort: Any
   directory: Any
   permissions: Any
   width: Int] -> Any
  (banner-box (session-banner-lines identity model effort directory permissions)
              width)))

;; The two columns the box costs on each side of a content line. Sliced by
;; UTF-16 length rather than graphemes on purpose: both are single-unit box
;; characters, and the slice has to agree with `.startsWith`/`.endsWith`.
(def BANNER-BOX-PREFIX: String "│ ")
(def BANNER-BOX-SUFFIX: String " │")

;; Pure: is this drawn line the box's top or bottom rule — border and nothing
;; else? Those two lines carry no content at all, so they are frame end to end.
(js/export
 (defn banner-rule-line? [line: String] -> Bool
  (or (.startsWith line "╭") (.startsWith line "╰"))))

;; Pure: one drawn line -> [border-prefix content border-suffix]. The box's
;; sides belong to the FRAME, not to the line they enclose: colouring a whole
;; line coloured its borders with it, which is what made the pipes beside the
;; title bright against an otherwise dim box — a frame in two tones, which reads
;; as broken rather than as emphasis.
(js/export
 (defn banner-line-segments [line: String] -> Any
  (cond
    (banner-rule-line? line) [line "" ""]

    (and (.startsWith line BANNER-BOX-PREFIX)
         (.endsWith line BANNER-BOX-SUFFIX)
         (>= (.-length line) 4))
    [BANNER-BOX-PREFIX
     (.slice line 2 (- (.-length line) 2))
     BANNER-BOX-SUFFIX]

    ;; The narrow banner draws no box, so the whole line is content.
    :else ["" line ""])))

;; Pure: the drawn banner -> the runs that paint it, in order, each carrying the
;; tone it paints in. Exactly one tone is bright — the title's own text — and
;; everything else, fields and the entire frame alike, is dim. Newlines ride
;; along as frame runs so a caller emits the banner by walking this list and
;; nothing else.
(js/export
 (defn session-banner-runs [lines: Any] -> Any
  (let [runs []]
    (.forEach
     lines
     (fn
       [line: String
        index: Int] -> Any
       (let [segments (banner-line-segments line)
             prefix (aget segments 0)
             content (aget segments 1)
             suffix (aget segments 2)]
         (when (> index 0) (.push runs {:text "\n" :tone "frame"}))
         (when (not (identical? prefix "")) (.push runs {:text prefix :tone "frame"}))
         (when (not (identical? content ""))
           (.push runs {:text content
                        :tone (if (.includes content "North Bridge") "title" "field")}))
         (when (not (identical? suffix "")) (.push runs {:text suffix :tone "frame"})))))
    runs)))

(js/export
 (defn render-conversation! [runtime: Any] -> Any
  (let [chunks []
        items (.-conversation runtime)]
    (.forEach
     items
     (fn [item: ConversationItem] -> Any
       (let [kind (conversationitem-kind item)
             title (conversationitem-title item)
             body (clipped (conversationitem-body item) 6000)
             status (conversationitem-status item)]
         (cond
           (identical? kind "user")
           (do (push-chunk! chunks
                            ((bg "#292c32")
                             (brightWhite (user-block-text runtime body))))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "assistant")
           (do (push-chunk! chunks (brightGreen "• "))
               (push-chunk! chunks (brightWhite body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "command")
           (push-command-card! chunks title body status)

           (identical? kind "interrupted")
           (do (push-chunk! chunks (brightRed "■ Conversation interrupted"))
               (push-chunk! chunks
                            (red " — tell the model what to do differently."))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "change")
           (push-file-change-card! chunks item status runtime)

           (identical? kind "tool")
           (do (push-chunk! chunks (if (identical? status "failed") (brightRed "• ") (brightGreen "• ")))
               (push-chunk! chunks (brightWhite title))
               (when (not (identical? body ""))
                 (push-chunk! chunks (dim (str "\n  └ " (.replaceAll body "\n" "\n    ")))))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "thought")
           (do (push-chunk! chunks (brightBlack "• Explored "))
               (push-chunk! chunks (dim body))
               (push-chunk! chunks (white "\n\n")))

           (identical? kind "error")
           (do (push-chunk! chunks (brightRed "• Error\n  "))
               (push-chunk! chunks (red (.replaceAll body "\n" "\n  ")))
               (push-chunk! chunks (white "\n\n")))

           :else
           (do (push-chunk! chunks (brightBlack (str "• " body)))
               (push-chunk! chunks (white "\n\n")))))))
    (when (.-working runtime)
      (let [elapsed (Math/floor (/ (- (Date/now) (.-workingSince runtime)) 1000))]
        (push-working-wave! chunks runtime)
        (push-chunk! chunks (brightBlack (str " (" elapsed "s · esc or ctrl-c to cancel)\n  ")))
        (push-chunk! chunks (brightBlack (session-context-text runtime)))))
    (let [status (supervisor-status runtime)
          working? (if (.-working runtime) true false)
          placeholder (transcript-placeholder (main-agent-label) status
                                              (.-length items) working?)]
      (when (not (identical? placeholder ""))
        (push-chunk! chunks (brightBlack placeholder)))
      ;; The ready-and-empty screen: the one moment there is room to say what
      ;; session this is, and the one moment nothing else needs the space.
      (when (banner-visible? runtime)
        (.forEach (session-banner-runs
                   (session-banner (.-sourceIdentity runtime)
                                   (.-sessionModel runtime)
                                   (.-sessionEffort runtime)
                                   (short-directory (.-sessionCwd runtime))
                                   (.-sessionPermissions runtime)
                                   (available-frame-width)))
                  (fn [run: Any] -> Any
                    (push-chunk! chunks
                                 ((if (identical? (.-tone run) "title")
                                    brightWhite brightBlack)
                                  (.-text run)))))))
    (StyledText. chunks))))

(defn visible-notice [notice: Any] -> String
  (let [value (text notice)]
    (cond
      (identical? value "view dag") "view graph"
      (identical? value "view kanban") "view board"
      :else value)))

;; The heading a role prints under. Directories head NOTHING: they are the
;; panel's root level, not rows inside a section about directories, and a
;; heading over them would be a word spent saying what the shape already says.
;; A directory's two files are rows rather than sections for the same reason
;; from the other end — they carry a switch each, and a heading you cannot flip
;; would be a worse lie than a row that reads in capitals. A bound hook heads
;; nothing either: it is drawn under the skill that declared it.
(js/export
 (defn config-section-title [role: String] -> String
  (cond
    (identical? role "moduleset") "SETS"
    (identical? role "module") "MODULES"
    (identical? role "skill") "SKILLS"
    (identical? role "hook") "HOOKS"
    (identical? role "plugin") "PLUGINS"
    (identical? role "other") "OTHER"
    :else "")))

;; Pure: the headings a row sits under, outermost first — the full path, not
;; just the heading it introduces, so that "which heading does this row still
;; need printed" is answered by comparing paths and nothing has to remember what
;; came before. MODULES is a subsection INSIDE skills rather than a sibling of
;; it: a module is a skill — one that brings hooks with it — so it reads within
;; SKILLS and not above it, and its hooks share its path exactly because they
;; are drawn inside it.
;;
;; A directory sits under nothing, and so do the files it carries: an empty path
;; is the root of the panel.
(js/export
 (defn config-header-roles [role: String] -> Any
  (cond
    (identical? role "moduleset") ["moduleset"]
    (identical? role "module") ["skill" "module"]
    (identical? role "boundhook") ["skill" "module"]
    (identical? role "skill") ["skill"]
    (identical? role "hook") ["hook"]
    (identical? role "plugin") ["plugin"]
    (identical? role "other") ["other"]
    :else [])))

;; Pure: those headings as keys that say which NODE they belong to, so two
;; directories with skills print two SKILLS headings — one inside each — and a
;; window that opens mid-node still prints the heading the row is under.
(js/export
 (defn config-header-keys
  [entry: Any
   rows: Any] -> Any
  (let [role (config-row-role entry rows)
        scope (config-row-scope (configentry-kind entry)
                                (configentry-name entry))]
    (.map (config-header-roles role)
          (fn [heading: String] -> String
            (str scope " " heading))))))

;; Pure: how many of two heading paths agree from the outside in, which is how
;; many headings a row does NOT have to print again.
(js/export
 (defn config-header-shared
  [prior: Any
   current: Any] -> Int
  (let [count {:n 0}]
    (.forEach current
              (fn
                [heading: String
                 index: Int] -> Any
                (when (and (identical? (.-n count) index)
                           (< index (.-length prior))
                           (identical? (aget prior index) heading))
                  (set! (.-n count) (+ index 1)))))
    (.-n count))))

(defn config-panel-title [config-filter: String] -> String
  (cond
    (identical? config-filter "hook") "hooks"
    (identical? config-filter "skill") "skills"
    (identical? config-filter "plugin") "plugins"
    (identical? config-filter "module") "modules"
    (identical? config-filter "globals") "globals"
    (identical? config-filter "agentsmd") "directory context"
    :else "context switchboard"))

;; An empty result is not a pending one. Saying "loading…" forever is how the
;; panel lied about a manifest that simply has no rows of this kind. A query
;; that matches nothing is a third answer again: the rows are there, and this is
;; what you asked for.
(js/export
 (defn config-empty-note
  [loaded?: Bool
   filtering?: Bool] -> String
  (cond
    (not loaded?) " loading…"
    filtering? " nothing matches"
    :else " nothing to configure here")))

;; The filter field, on the panel's own header line: the surface you are typing
;; into is the surface that shows what you typed. Present the moment `/` is
;; pressed, empty query and all, because a field you cannot see is a mode you
;; cannot leave on purpose.
(js/export
 (defn config-query-field
  [filtering?: Bool
   query: String] -> String
  (if filtering? (str "  /" query) "")))

;; The key legend, which has one more rung to name while a filter is up: escape
;; spends itself on the query before it touches the panel.
(js/export
 (defn config-panel-legend [filtering?: Bool] -> String
  (if filtering?
    "  ↑/↓ move · tab fold · space toggle · enter edit · esc clears filter"
    "  ↑/↓ move · tab fold · space toggle · enter edit · / filter · esc close")))

;; The dimmest tone the panel has: brightBlack with the dim attribute on top of
;; it. What you switched off, and what is only on screen to give a match its
;; context, should recede — a row you pinned off is the last thing that should
;; be shouting at you from a list of things that are running.
(defn dimmest [value: Any] -> Any
  (dim (brightBlack value)))

(defn config-member-count-text [count: Int] -> String
  (str count (if (identical? count 1) " member" " members")))

;; One row's label: what the row calls itself, plus whatever it has to add after
;; the state. A `dir` row adds its directory. A `module` row adds the size of its
;; roster, which is the one fact about a bundle that is nowhere else on screen —
;; and only when modules.d actually carries a file for it, so "no roster yet" and
;; "a roster with nobody in it" stay different answers. Clipped to the panel so
;; a long path cannot wrap and desync the rendered height from
;; detail-body-lines. A hook's fourth field is the unit it follows, which the
;; state column already carries as provenance — printing it twice on one row
;; says nothing new; a subtree row's directory is the row it is nested under and
;; is not printed twice either.
;; The fold marker, which is the one thing a collapsed node has to say that an
;; open one does not: there is more here. Only directories fold, so only they
;; carry it, and it is drawn rather than stored in the label — a glyph is a
;; rendering of the fold state, not part of what the row is called, and a search
;; must never have to match it.
(defn config-fold-glyph
  [dir-row?: Bool
   expanded?: Bool] -> String
  (if (not dir-row?) "" (if expanded? "▾ " "▸ ")))

;; Pure: what a directory row calls itself on screen — the place, not the slug.
;; `code  ~/code` said the same thing twice, and the half that answers
;; "which directory is this" is the path: two checkouts of one repo have the
;; same slug and different paths, and the path is what you would type. The slug
;; stays every internal thing it already was — the flip address, `agents path`,
;; the search text, an `@dir:` reference — because none of those are reading.
;; A row whose path the CLI has not filled in falls back to the slug rather
;; than rendering nothing.
;;
;; The root scope is the exception, and not really one: its "directory" is `~`,
;; which names a place but not the thing it is — the profile every other node is
;; read on top of. It says GLOBAL, which is what it is.
(defn config-dir-label [entry: Any] -> String
  (if (config-global-row? (configentry-kind entry) (configentry-name entry))
    "GLOBAL"
    (let [path (short-directory (text (configentry-detail entry)))]
      (text-or path (configentry-name entry)))))

;; Pure: does this row have to say what KIND it is? A row drawn under a heading
;; that already names its kind does not — HOOKS says it once over the whole
;; section, and repeating it per row is the same duplication the state column
;; was carrying. A row nested inside another UNIT does: the heading over it names
;; its parent's kind, so without the tag a hook under a module reads as another
;; module. General rule rather than a hook special case — any kind that ends up
;; nested under a differently-kinded parent inherits it.
;;
;; Dim by construction at the call site: the tag says which sort of thing this
;; is, and the name is still what you are scanning for.
(js/export
 (defn config-kind-tag
  [kind: String
   role: String] -> String
  (let [headings (config-header-roles role)
        depth (.-length headings)
        innermost (if (> depth 0) (aget headings (- depth 1)) "")]
    (if (or (identical? innermost "") (identical? innermost role))
      ""
      (str kind " · ")))))

;; Pure: one row, in the order it reads. The NAME leads, because the name is
;; what you came to the list to find; the state follows it after a colon,
;; answering the question you only ask once you have found the row. The state
;; column used to lead, which put a column of `on`s between the cursor and every
;; name on screen.
;;
;; The name is what gives way when the panel is narrow: a clipped state is not a
;; smaller answer, it is a wrong one.
(js/export
 (defn config-row-parts
  [entry: Any
   memberships: Any
   expanded?: Bool
   role: String
   state-text: String
   width: Int] -> Any
  (let [kind (configentry-kind entry)
        name (configentry-name entry)
        dir? (identical? kind "dir")
        members (config-module-members memberships name)
        detail (cond
                 (identical? kind "hook") ""
                 (config-subtree-kind? kind) ""
                 ;; The path IS the directory row's label now, so it is not also
                 ;; the thing printed after it.
                 dir? ""
                 (identical? kind "module")
                 (if (nil? members)
                   ""
                   (config-member-count-text (.-length members)))
                 :else (text (configentry-detail entry)))
        indent (config-row-indent role)
        glyph (config-fold-glyph dir? expanded?)
        tag (config-kind-tag kind role)
        label (if dir? (config-dir-label entry) (config-row-label kind name))
        room (Math/max 8 (- width
                            (.-length indent) (.-length glyph) (.-length tag)
                            (.-length state-text) (.-length detail) 4))]
    {:indent indent
     :glyph glyph
     :tag tag
     :name (compact-text label room)
     :state state-text
     :detail detail})))

;; How far a row sits from the panel's left edge, in steps of two. Depth reads
;; as depth: the directory at the margin, its own two files one step in, the
;; rows inside a section one step further, and a memory under the gate that
;; holds it. Section headings sit one step left of the rows they head, which is
;; the same relation DIRECTORY has to the directories under it. The cursor
;; gutter is outside all of it, so the marker is always in the same column no
;; matter how deep the row it is on.
(def CONFIG-INDENT-WIDTH: Int 2)

(js/export
 (defn config-row-depth [role: String] -> Int
  (cond
    (identical? role "dir") 0
    (identical? role "ins") 1
    (identical? role "memroot") 1
    (identical? role "module") 3
    (identical? role "boundhook") 4
    :else 2)))

(defn config-row-indent [role: String] -> String
  (.repeat " " (* CONFIG-INDENT-WIDTH (config-row-depth role))))

;; A heading is drawn one step left of the rows it heads, which is the relation
;; DIRECTORY already has to the directories under it. The outermost heading in a
;; node sits where that node's own files sit; a subsection heading sits one step
;; further in, over rows one step further in again.
(defn config-header-indent [index: Int] -> String
  (.repeat " " (* CONFIG-INDENT-WIDTH (+ index 2))))

(js/export
 (defn render-config-panel [runtime: Any] -> Any
  (let [;; The filtered rows, not the view's: what the panel draws is what the
        ;; cursor walks and what space flips, and one list decides all three.
        entries (config-panel-rows runtime)
        total (.-length entries)
        stored-entries (.-configEntries runtime)
        ;; Derivation reads the whole manifest. A caller that has only the
        ;; filtered rows (every sectioned view carries its own skills) gets the
        ;; same answer from them.
        stored-manifest (.-configAllEntries runtime)
        manifest (if stored-manifest
                   stored-manifest
                   (if stored-entries stored-entries entries))
        ;; No rosters is a fact, not a missing input: before any module has
        ;; members every unit gates on its own switch alone.
        stored-memberships (.-configMemberships runtime)
        memberships (if stored-memberships stored-memberships [])
        ;; Roles are read off the view's rows, never the filtered ones: a row
        ;; must not change depth because a query hid its neighbour.
        basis (if stored-entries stored-entries entries)
        expanded (panel-expanded runtime)
        config-filter (text-or (text (.-configFilter runtime)) "all")
        filtering? (panel-filtering? runtime)
        ;; An unfocused panel is still on screen and no longer yours: the cursor
        ;; stops burning and the row it is on stops standing out, so the frame
        ;; says where the keyboard went without moving anything.
        focused? (panel-focused? runtime)
        query (panel-query runtime)]
    (if (identical? total 0)
      (StyledText. [(brightYellow (config-panel-title config-filter))
                    (brightCyan (config-query-field filtering? query))
                    (brightBlack (config-empty-note
                                  (if (.-configLoaded runtime) true false)
                                  filtering?))])
      (let [index (clamped-index (.-configIndex runtime) total)
            window (config-visible-count total config-filter)
            start (window-start index total window)
            stop (Math/min total (+ start window))
            width (Math/max 12 (- (terminal-columns) 12))
            parts [(brightYellow (config-panel-title config-filter))
                   (brightCyan (config-query-field filtering? query))
                   (brightBlack (str (config-panel-legend filtering?) "\n"))]]
        (.forEach (.slice entries start stop)
                  (fn [entry: Any offset: Int] -> Any
                    (let [i (+ start offset)
                          cursor? (identical? i index)
                          kind (configentry-kind entry)
                          active? (config-entry-active? entry manifest
                                                        memberships)
                          ;; A user pin is neither on nor off — it is the reason
                          ;; a skill flip will not move this row — and it is the
                          ;; quietest thing in the panel: the whole row recedes,
                          ;; state and name together. What you deliberately
                          ;; turned off should not be the loudest line on a
                          ;; screen listing what is running.
                          pinned? (and (identical? kind "hook")
                                       (not (config-hook-enabled?
                                             (configentry-state entry))))
                          ;; On screen to give a match its context, rather than
                          ;; because it matched: scaffolding, dimmed.
                          context? (config-row-context-only? entry query)
                          role (config-row-role entry basis)
                          open? (and (identical? kind "dir")
                                     (or (not (identical? (.trim query) ""))
                                         (not (config-view-folds? config-filter))
                                         (config-node-expanded?
                                          expanded (configentry-name entry))))
                          ;; A row drawn under the unit that claims it is
                          ;; standing in its own provenance, and says one token
                          ;; less for it.
                          nested? (identical? role "boundhook")
                          state-text (config-state-text entry manifest
                                                        memberships active?
                                                        nested?)
                          row (config-row-parts entry memberships open? role
                                                state-text width)
                          headings (config-header-keys entry basis)
                          prior (if (identical? i start)
                                  []
                                  (config-header-keys (aget entries (- i 1))
                                                      basis))
                          shared (config-header-shared prior headings)
                          tail (if (identical? (+ i 1) stop) "" "\n")]
                      ;; Only the headings this row does not share with the one
                      ;; above it, so a section prints its heading once and a
                      ;; window that opens mid-node still says where it is.
                      (.forEach (config-header-roles role)
                                (fn
                                  [heading: String
                                   at: Int] -> Any
                                  (when (>= at shared)
                                    (.push parts
                                           (brightYellow
                                            (str (config-header-indent at)
                                                 (config-section-title heading)
                                                 "\n"))))))
                      (.push parts (if (and cursor? focused?)
                                     (brightCyan "› ")
                                     (if cursor? (brightBlack "› ")
                                         (brightBlack "  "))))
                      ;; The cursor still lights its row, and a pinned row is
                      ;; the one exception: it stays dim under the cursor, which
                      ;; the marker in the gutter is there to locate.
                      (let [name-tone (cond pinned? dimmest
                                            (and cursor? focused?) brightWhite
                                            context? dimmest
                                            :else brightBlack)
                            state-tone (cond pinned? dimmest
                                             active? brightGreen
                                             :else brightBlack)]
                        (.push parts (name-tone (str (.-indent row)
                                                     (.-glyph row))))
                        ;; The kind, said only where the heading above does not
                        ;; already say it, and said quietly: it tells you what
                        ;; sort of thing this is, not which thing.
                        (when (not (identical? (.-tag row) ""))
                          (.push parts (dimmest (.-tag row))))
                        (.push parts (name-tone (.-name row)))
                        (.push parts (name-tone ": "))
                        (.push parts (state-tone (.-state row)))
                        (.push parts (name-tone
                                      (str (if (identical? (.-detail row) "")
                                             ""
                                             (str "  " (.-detail row)))
                                           tail)))))))
        (StyledText. parts))))))

;; ---------------------------------------------------------------------------
;; Docked detail area. One surface, one render path, one piece of state saying
;; which tenant is showing: "" (collapsed), "config" (the context switchboard),
;; "agents" (the roster behind a strip segment). New tenants add a branch to
;; render-detail-panel! and detail-body-lines and nothing else.
;; ---------------------------------------------------------------------------

(defn detail-open? [runtime: Any] -> Bool
  (not (identical? (text (.-detailView runtime)) "")))

(defn detail-showing?
  [runtime: Any
   view: String] -> Bool
  (identical? (text (.-detailView runtime)) view))

(defn open-detail!
  [runtime: Any
   view: String] -> Any
  (set! (.-detailView runtime) view))

;; A closed panel holds no query. The filter is a state of the surface, so it
;; dies with the surface however the surface is closed — the ladder, a command,
;; or the same view's own toggle.
(defn close-detail! [runtime: Any] -> Any
  (clear-panel-filter! runtime)
  (set! (.-detailView runtime) ""))

;; /help and F1 are the same switch, and the panel is where it lands.
(defn toggle-help!
  [runtime: Any
   ui: Any] -> Any
  (if (detail-showing? runtime "help")
    (do (close-detail! runtime) (focus-composer! runtime ui))
    (do (open-detail! runtime "help") (focus-panel! runtime ui)))
  (.render runtime))

(defn detail-agents [runtime: Any] -> (Vec Agent)
  (let [state (snapshot (.-model runtime))]
    (segment-agents (bridgesnapshot-agents state)
                    (text-or (text (.-detailSegment runtime)) "all"))))

;; Rows the docked panel spends before its first list row: its border and the
;; title line that carries the key legend.
(def DETAIL-CHROME-ROWS: Int 3)

;; Headings are content the panel inserts between rows, so the layout budgets
;; for them: inside a node, SETS, SKILLS, its MODULES subsection, HOOKS,
;; PLUGINS and OTHER. Six, because only the root node carries kind sections
;; today — the day a project carries its own skills, a window spanning two nodes
;; can print more, and this ceiling is where that is paid for. Directories head
;; nothing at all, and a directory's own files and memories are ROWS rather than
;; headings, so a deeper tree costs list rows and never a heading.
(def CONFIG-SECTION-ROWS: Int 6)

(defn detail-visible-count
  [total: Int
   extra: Int] -> Int
  (fitted-window total (terminal-rows)
                 (+ CHROME-ROWS MIN-WORKSPACE-ROWS DETAIL-CHROME-ROWS extra)))

;; A narrowed view pays only for the headings it can actually show, so it keeps
;; the rows the full switchboard has to give up. /globals is the root node with
;; everything but plugins; /agentsmd is directories and the files they carry,
;; which are rows under no heading whatsoever; a kind view is that one kind's
;; heading under whichever nodes have any.
(js/export
 (defn config-section-rows [view: String] -> Int
  (cond
    (identical? view "all") CONFIG-SECTION-ROWS
    (identical? view "globals") 5
    (identical? view "agentsmd") 0
    :else 1)))

(js/export
 (defn config-visible-count
  [total: Int
   view: String] -> Int
  (detail-visible-count total (config-section-rows view))))

(defn clamped-index
  [raw: Any
   total: Int] -> Int
  (Math/max 0 (Math/min (if raw raw 0) (- total 1))))

(defn selected-detail-agent [runtime: Any] -> Agent?
  (let [agents (detail-agents runtime)
        total (.-length agents)]
    (if (> total 0)
      (aget agents (clamped-index (.-detailIndex runtime) total))
      nil)))

;; Pure: how many heading lines render-config-panel inserts inside a window, so
;; the docked panel is exactly as tall as its content. The same rule the renderer
;; uses — a row prints the headings it does not share with the row above it, and
;; every heading at the window's first row.
(defn config-header-lines
  [entries: Any
   basis: Any
   start: Int
   stop: Int] -> Int
  (let [count {:n 0}]
    (.forEach (.slice entries start stop)
              (fn
                [entry: Any
                 offset: Int] -> Any
                (let [i (+ start offset)
                      headings (config-header-keys entry basis)
                      prior (if (identical? i start)
                              []
                              (config-header-keys (aget entries (- i 1)) basis))]
                  (set! (.-n count)
                        (+ (.-n count)
                           (- (.-length headings)
                              (config-header-shared prior headings)))))))
    (.-n count)))

(js/export
 (defn config-detail-lines [runtime: Any] -> Int
  (let [entries (config-panel-rows runtime)
        total (.-length entries)
        stored-entries (.-configEntries runtime)
        basis (if stored-entries stored-entries entries)
        view (text-or (text (.-configFilter runtime)) "all")]
    (if (identical? total 0)
      1
      (let [index (clamped-index (.-configIndex runtime) total)
            window (config-visible-count total view)
            start (window-start index total window)
            stop (Math/min total (+ start window))]
        (+ 1 (- stop start) (config-header-lines entries basis start stop)))))))

(defn detail-body-lines [runtime: Any] -> Int
  (cond
    (detail-showing? runtime "config") (config-detail-lines runtime)
    (detail-showing? runtime "agents")
    (let [total (.-length (detail-agents runtime))
          agent (selected-detail-agent runtime)
          metadata (if agent (agent-route-text agent (Math/max 12 (- (terminal-columns) 8))) "")
          extra (if (identical? metadata "") 0 1)]
      (+ 1
         (Math/max 1 (Math/min total (detail-visible-count total extra)))
         extra))
    (detail-showing? runtime "help") (+ 1 (help-visible-rows
                                           (panel-query runtime)))
    :else 0))

(js/export
 (defn detail-height [runtime: Any] -> Int
  (+ 2 (detail-body-lines runtime))))

(defn agent-detail-title [segment-id: String] -> String
  (if (identical? segment-id "all") "agents" (str "agents · " segment-id)))

(defn agent-detail-row
  [agent: Agent
   width: Int] -> String
  (agent-cell-text (agent-summary agent) width))

(defn render-agent-detail [runtime: Any] -> Any
  (let [agents (detail-agents runtime)
        total (.-length agents)
        title (agent-detail-title (text-or (text (.-detailSegment runtime)) "all"))
        parts [(brightYellow title)
               (brightBlack "  ↑/↓ move · ←/→ segment · enter or esc close\n")]]
    (if (identical? total 0)
      (StyledText. (.concat parts [(brightBlack "  no agents in this state")]))
      (let [index (clamped-index (.-detailIndex runtime) total)
            width (Math/max 12 (- (terminal-columns) 8))
            selected-agent (selected-detail-agent runtime)
            metadata (if selected-agent (agent-route-text selected-agent width) "")
            extra (if (identical? metadata "") 0 1)
            window (detail-visible-count total extra)
            start (window-start index total window)
            stop (Math/min total (+ start window))]
        (.forEach (.slice agents start stop)
                  (fn
                    [agent: Agent
                     offset: Int] -> Any
                    (let [i (+ start offset)
                          cursor? (identical? i index)
                          tail (if (and (identical? (+ i 1) stop)
                                        (identical? metadata "")) "" "\n")]
                      (.push parts (if cursor? (brightCyan "› ") (brightBlack "  ")))
                      (.push parts
                             ((if cursor? brightWhite brightBlack)
                              (str (agent-detail-row agent width) tail))))))
        (when (not (identical? metadata ""))
          (.push parts (brightBlack (str "  " metadata))))
        (StyledText. parts)))))

;; ---------------------------------------------------------------------------
;; Help is a tenant of the docked panel, not a block printed into the
;; transcript: something you opened is something you can see how to close, and
;; the escape ladder closes it on the same rung as every other panel.
;; ---------------------------------------------------------------------------

(defrecord HelpRow
  [keys: String
   meaning: String])

(def HELP-ROWS: (Vec HelpRow)
  ;; One key, two meanings, decided by who holds the keyboard — so the row says
  ;; both rather than naming one and leaving the other to be discovered.
  [(->HelpRow "Tab" "swap Agents/Threads; folds in the switchboard")
   (->HelpRow "←/→" "switch thread view")
   (->HelpRow "Ctrl-J / ↓" "into the agent strip, esc back out")
   (->HelpRow "Esc / Ctrl-C" "cancel the turn; the message comes back")
   (->HelpRow "/q /close /esc /exit" "escape — innermost first; at root, quits")
   (->HelpRow "/help" "this panel")
   (->HelpRow "/glyph <one>|reset" "prompt glyph")
   (->HelpRow "/emoji <query>" "picker")
   (->HelpRow "/sound on|off|pack" "voice lines")
   (->HelpRow "/mute" "quiet")])

(def HELP-KEY-WIDTH: Int 22)

;; Pure: help is rows too, so `/` narrows them on the same case-insensitive
;; substring the switchboard uses — over the keys and their meanings, which is
;; the whole of what a help row says.
(js/export
 (defn help-query-rows [query: String] -> Any
  (let [needle (.toLowerCase (.trim query))]
    (if (identical? needle "")
      HELP-ROWS
      (.filter HELP-ROWS
               (fn [row: HelpRow] -> Bool
                 (.includes (.toLowerCase (str (helprow-keys row) " "
                                               (helprow-meaning row)))
                            needle)))))))

(defn help-visible-rows [query: String] -> Int
  (let [total (.-length (help-query-rows query))]
    (Math/max 1 (Math/min total (detail-visible-count total 0)))))

(defn render-help-panel! [runtime: Any] -> Any
  (let [filtering? (panel-filtering? runtime)
        query (panel-query runtime)
        matched (help-query-rows query)
        chunks [(brightYellow "Northbridge keys")
                (brightCyan (config-query-field filtering? query))
                (brightBlack (if filtering?
                               " · esc clears filter\n"
                               " · / filter · esc closes\n"))]
        rows (.slice matched 0 (help-visible-rows query))]
    ;; A query that matches nothing still owes the layout the row it was
    ;; budgeted, and owes the user a reason the panel is empty.
    (if (identical? (.-length rows) 0)
      (push-chunk! chunks (brightBlack " nothing matches"))
      (.forEach
       rows
       (fn
         [row: HelpRow
          index: Int] -> Any
         (push-chunk! chunks (brightWhite (.padEnd (helprow-keys row)
                                                   HELP-KEY-WIDTH " ")))
         (push-chunk! chunks (brightBlack (helprow-meaning row)))
         (when (< index (- (.-length rows) 1))
           (push-chunk! chunks (brightBlack "\n"))))))
    (StyledText. chunks)))

(js/export
 (defn render-detail-panel! [runtime: Any] -> Any
  (cond
    (detail-showing? runtime "config") (render-config-panel runtime)
    (detail-showing? runtime "agents") (render-agent-detail runtime)
    (detail-showing? runtime "help") (render-help-panel! runtime)
    :else (StyledText. [(brightBlack "")]))))

(defn segment-chunk
  [segment: AgentSegment
   highlighted?: Bool] -> Any
  (let [label (agentsegment-label segment)
        id (agentsegment-id segment)]
    (cond
      highlighted? (brightCyan label)
      (identical? id "failed") (brightRed label)
      (identical? id "blocked") (brightYellow label)
      (identical? id "running") (brightGreen label)
      :else (brightWhite label))))

(defn render-agent-strip
  [state: BridgeSnapshot
   focused?: Bool
   selected: Int] -> Any
  (let [segments (agent-segments (bridgesnapshot-agents state))
        chunks [(if focused? (brightCyan "› ") (brightBlack "  "))]]
    (.forEach
     segments
     (fn
       [segment: AgentSegment
        index: Int] -> Any
       (when (> index 0) (.push chunks (brightBlack STRIP-SEPARATOR)))
       (.push chunks (segment-chunk segment
                                    (and focused? (identical? index selected))))))
    (when focused?
      (.push chunks (brightBlack "   h/l segment · enter open · esc input")))
    (StyledText. chunks)))

(defn render-status
  [runtime: Any
   state: BridgeSnapshot] -> Any
  (let [workspace-notice (text (.-workspaceNotice runtime))
        notice (if (identical? workspace-notice "")
                 (visible-notice (bridgesnapshot-notice state)) workspace-notice)]
    (StyledText. [(brightBlack notice)])))

;; ---------------------------------------------------------------------------
;; The view bar. One row directly under the composer, two views: `Agents |
;; Threads`, and a tail past `> ` that belongs to whichever view is showing.
;; Threads spends it on that view's own tabs — `Agents | Threads > List Board
;; Graph`. Agents has no sub-views, so it spends it on the session identity —
;; `Agents | Threads > claude-fable-5 xhigh · ~ · main`. That identity used to
;; own a line of its own under the composer; it is chrome about the session, so
;; it lives with the rest of the chrome. The active thing is green, everything
;; else is faded, and every label is clickable. The CLI verb is `threads`; the
;; view that shows them says the same word.
;; ---------------------------------------------------------------------------

(def AGENTS-TAB-LABEL: String "Agents")
(def THREADS-TAB-LABEL: String "Threads")
(def FRAME-TAB-SEPARATOR: String " | ")
(def SUBVIEW-TAB-SEPARATOR: String " > ")

(def THREADS-TAB-START: Int
  (+ (.-length AGENTS-TAB-LABEL) (.-length FRAME-TAB-SEPARATOR)))

(def SUBVIEW-TAB-ORIGIN: Int
  (+ THREADS-TAB-START
     (.-length THREADS-TAB-LABEL)
     (.-length SUBVIEW-TAB-SEPARATOR)))

(def SUBVIEW-TAB-GAP: Int 2)

;; The Agents tail: who you are talking to and from where. Chunks, not a
;; StyledText, so the bar can splice them in after its own labels.
(defn push-session-identity!
  [chunks: Any
   session: Any] -> Any
  (push-chunk! chunks
               (brightYellow
                (str (text-or (.-sessionModel session) "model pending") " "
                     (text-or (.-sessionEffort session) "effort pending"))))
  (push-chunk! chunks (brightBlack " · "))
  (push-chunk! chunks
               (brightGreen (text-or (short-directory (.-sessionCwd session))
                                     "directory pending")))
  (push-chunk! chunks (brightBlack " · "))
  (push-chunk! chunks (dim (text-or (.-sessionBranch session) "branch pending"))))

(js/export
 (defn render-view-tabs!
  [frame: Any
   state: BridgeSnapshot
   view-id: String
   session: Any] -> Any
  (let [chunks []
        threads? (threads-frame? frame)
        views (view-list state)]
    (push-chunk! chunks ((if threads? brightBlack brightGreen) AGENTS-TAB-LABEL))
    (push-chunk! chunks (brightBlack FRAME-TAB-SEPARATOR))
    (push-chunk! chunks ((if threads? brightGreen brightBlack) THREADS-TAB-LABEL))
    (push-chunk! chunks (brightBlack SUBVIEW-TAB-SEPARATOR))
    (if threads?
      (do
        (.forEach
         views
         (fn
           [view: WorkView
            index: Int] -> Any
           (let [selected? (identical? (workview-id view) view-id)
                 title (workview-title view)]
             (push-chunk! chunks
                          ((if selected? brightGreen brightBlack)
                           (str (if selected? "[" " ") title (if selected? "]" " "))))
             (when (< index (- (.-length views) 1))
               (push-chunk! chunks (white "  "))))))
        (push-chunk! chunks (brightBlack "  ← switch →")))
      (push-session-identity! chunks session))
    (StyledText. chunks))))

(defn compact-text
  [value: Any
   width: Int] -> String
  (let [source (text value)
        limit (Math/max 1 width)]
    (if (> (.-length source) limit)
      (str (.slice source 0 (Math/max 0 (- limit 1))) "…")
      source)))

(defn cell-text
  [value: Any
   width: Int] -> String
  (.padEnd (compact-text value width) width " "))

(defn short-thread-id [item: WorkItem] -> String
  (.slice (workitem-id item) 0 8))

(defn push-condition!
  [chunks: Any
   condition: String
   label: String] -> Any
  (push-chunk! chunks
               ((cond
                  (identical? condition "active") brightCyan
                  (identical? condition "ready") brightGreen
                  (identical? condition "blocked") brightRed
                  :else brightYellow)
                label)))

(defn available-work-width
  [_runtime: Any
   _state: BridgeSnapshot] -> Int
  (available-frame-width))

(defn render-list-view!
  [runtime: Any
   items: (Vec WorkItem)
   selected: Int
   width: Int] -> Any
  (let [chunks []
        rows (list-rows runtime items)
        collapsed (.-collapsedListConditions runtime)]
    (.forEach
     rows
     (fn
       [row: ListRow
        visual-index: Int] -> Any
       (let [kind (listrow-kind row)
             condition (listrow-condition row)]
         (if (identical? kind "header")
           (let [collapsed? (.has collapsed condition)
                 header (str " " (if collapsed? "▸" "▾") "  "
                             (list-section-title condition) "  "
                             (listrow-count row))]
             (push-chunk! chunks
                          ((bg "#292c32")
                           (brightWhite (.padEnd header width " ")))))
           (let [index (listrow-index row)
                 item (aget items index)
                 title-width (Math/max 10 (- width 25))
                 title (compact-text (workitem-title item) title-width)
                 selected? (identical? index selected)]
             (push-chunk! chunks (brightBlack "  "))
             (push-chunk! chunks (if selected? (brightCyan "› ") (brightBlack "  ")))
             (push-condition! chunks (workitem-condition item)
                              (cell-text (.toUpperCase (workitem-condition item)) 9))
             (push-chunk! chunks ((if selected? brightWhite white) title))
             (push-chunk! chunks (dim (str "  @" (short-thread-id item))))))
         (when (< visual-index (- (.-length rows) 1))
           (push-chunk! chunks (white "\n"))))))
    (StyledText. chunks)))

(defn work-item-by-id
  [items: (Vec WorkItem)
   id: String] -> WorkItem?
  (.find items
         (fn [item: WorkItem] -> Bool
           (identical? (workitem-id item) id))))

(defn work-item-condition-for
  [items: (Vec WorkItem)
   id: String] -> String
  (.reduce items
           (fn
             [condition: String
              item: WorkItem] -> String
             (if (identical? (workitem-id item) id)
               (workitem-condition item)
               condition))
           ""))

(defn render-dag-view!
  [items: (Vec WorkItem)
   selected: Int
   width: Int] -> Any
  (let [chunks []]
    (.forEach
     items
     (fn
       [item: WorkItem
        index: Int] -> Any
       (let [condition (workitem-condition item)
             dependencies (workitem-dependencies item)
             selected? (identical? index selected)]
         (push-chunk! chunks (if selected? (brightCyan "› ") (brightBlack "  ")))
         (push-condition! chunks condition "● ")
         (push-chunk! chunks
                      ((if selected? brightWhite white)
                       (compact-text (workitem-title item) (Math/max 12 (- width 16)))))
         (push-chunk! chunks (dim (str "  @" (short-thread-id item) "\n")))
         (if (identical? (.-length dependencies) 0)
           (push-chunk! chunks (brightBlack "    ╰─ root\n"))
           (.forEach
            dependencies
            (fn [dependency: String] -> Any
              (let [target (work-item-by-id items dependency)]
                (push-chunk! chunks (brightBlack "    ╰─ requires ← "))
                (push-chunk! chunks
                             ((if target brightCyan brightBlack)
                              (str "@" (.slice dependency 0 8))))
                (push-chunk! chunks
                             (if target
                               (dim (str "  "
                                         (compact-text (workitem-title target)
                                                       (Math/max 8 (- width 28)))
                                         "\n"))
                               (brightBlack "  outside current board\n")))))))
         (when (< index (- (.-length items) 1))
           (push-chunk! chunks (white "\n"))))))
    (StyledText. chunks)))

(defn board-lane-items
  [items: (Vec WorkItem)
   lane-id: String] -> (Vec WorkItem)
  (.filter items
           (fn [item: WorkItem] -> Bool
             (identical? (board-lane-id (workitem-condition item)) lane-id))))

(defn compact-body
  [value: Any
   width: Int] -> String
  (let [lines (.filter
               (.map (.split (text value) "\n")
                     (fn [line: String] -> String (.trim line)))
               (fn [line: String] -> Bool (not (identical? line ""))))]
    (compact-text (.join lines " ") width)))

(defn board-card-id [thread-id: String] -> String
  (str "board-card-" thread-id))

(defn board-signature
  [items: (Vec WorkItem)
   selected: Int
   width: Int] -> String
  (str width "|" selected "|"
       (.join
        (.map items
              (fn [item: WorkItem] -> String
                (str (workitem-id item) "\u0001"
                     (workitem-title item) "\u0001"
                     (workitem-body item) "\u0001"
                     (workitem-condition item))))
        "\u0002")))

(defn board-card-node [source: Any] -> Any
  (loop [node source]
    (if (or (not node)
            (not (identical? (text (.-northThreadId node)) "")))
      node
      (recur (.-parent node)))))

(defn set-board-notice!
  [runtime: Any
   notice: String] -> Any
  (set! (.-workspaceNotice runtime) notice)
  (.render runtime))

(defn select-board-card!
  [runtime: Any
   ui: Any
   item: WorkItem
   index: Int] -> Any
  (set! (.-workIndex runtime) index)
  (set! (.-model runtime)
        (select-thread (.-model runtime) (workitem-id item)))
  (show-frame! runtime ui "threads")
  (.scrollChildIntoView (.-workScroll ui) (board-card-id (workitem-id item))))

(defn prefill-outcome!
  [runtime: Any
   ui: Any
   thread-id: String] -> Any
  (set! (.-value (.-composerInput ui)) (str "/outcome @" thread-id " "))
  (show-frame! runtime ui "threads")
  (set-board-notice! runtime
                     (str "Finish the outcome, then press Enter; Done is derived from north tell @"
                          thread-id " outcome <result>.")))

(defn move-ready-thread!
  [runtime: Any
   thread-id: String
   position: String
   anchor-id: String] -> (Promise Any)
  (let [argv (if (identical? anchor-id "")
               [(north-bin) "queue" "move" thread-id position]
               [(north-bin) "queue" "move" thread-id position anchor-id])
        output (js/await (run-command argv))]
    (set! (.-workspaceNotice runtime) (.trim (text output)))
    (js/await (refresh! runtime))))

(defn unsupported-drop-notice
  [source-condition: String
   target-lane: String] -> String
  (cond
    (terminal-condition? source-condition)
    "Done is derived from an outcome; reopening requires explicitly retracting that outcome."

    (identical? target-lane "in-progress")
    "In Progress is derived from a live run; dispatch or /launch the thread to start it."

    (identical? source-condition "active")
    "Active work is derived from its live run; /interrupt and settle that run before moving it."

    (not (identical? source-condition "ready"))
    "Only ready work has a durable queue order; resolve its prerequisites before reordering it."

    :else
    "That lane is derived from lifecycle facts; use the corresponding North lifecycle action."))

(defn handle-board-drop!
  [runtime: Any
   ui: Any
   target-lane: String
   target-card: Any
   event: Any] -> Any
  (.preventDefault event)
  (.stopPropagation event)
  (.stopAutoScroll (.-workScroll ui))
  (let [source-card (board-card-node (.-source event))
        source-id (if source-card (bare (.-northThreadId source-card)) "")
        state (snapshot (.-model runtime))
        items (bridgesnapshot-board state)
        source-condition (work-item-condition-for items source-id)
        source-lane (board-lane-id source-condition)
        target-id (if target-card (bare (.-northThreadId target-card)) "")
        target-condition (work-item-condition-for items target-id)]
    (cond
      (identical? source-id "")
      (set-board-notice! runtime "Drop ignored: the dragged source was not a North work card.")

      (and (identical? target-lane "done")
           (not (terminal-condition? source-condition)))
      (prefill-outcome! runtime ui source-id)

      (and (identical? source-lane "not-started")
           (identical? target-lane "not-started")
           (identical? source-condition "ready")
           (or (identical? target-id "")
               (identical? target-condition "ready")))
      (if (identical? source-id target-id)
        (set-board-notice! runtime "Queue order unchanged: a card cannot be moved relative to itself.")
        (let [position (if (identical? target-id "")
                         (if (< (.-x event)
                                (+ (.-screenX (.-currentTarget event))
                                   (/ (.-width (.-currentTarget event)) 2)))
                           "first" "last")
                         (if (< (.-x event)
                                (+ (.-screenX target-card) (/ (.-width target-card) 2)))
                           "before" "after"))]
          (report-promise! runtime
                           (move-ready-thread! runtime source-id position target-id))))

      :else
      (set-board-notice! runtime
                         (unsupported-drop-notice source-condition target-lane)))))

(defn card-content
  [item: WorkItem
   width: Int] -> Any
  (let [body (compact-body (workitem-body item) (Math/max 8 (- width 4)))
        fallback (str "@" (short-thread-id item))]
    (StyledText.
     [(brightWhite (compact-text (workitem-title item) (Math/max 8 (- width 4))))
      (white "\n")
      (dim (if (identical? body "") fallback body))])))

(defn make-board-card!
  [runtime: Any
   ui: Any
   item: WorkItem
   index: Int
   lane-index: Int
   width: Int] -> Any
  (let [renderer (.-renderer runtime)
        thread-id (workitem-id item)
        condition (workitem-condition item)
        selected? (identical? index (.-workIndex runtime))
        next-up? (and (identical? condition "ready") (identical? lane-index 0))
        card (BoxRenderable. renderer
                             {:id (board-card-id thread-id)
                              :width width :height 4 :flexShrink 0 :paddingX 1
                              :border true :borderColor (if selected? "#22d3ee" "#64748b")
                              :title (if next-up? "Next Up" nil)
                              :titleColor (if next-up? "#4ade80" "#94a3b8")})
        content (TextRenderable. renderer
                                 {:width "100%" :height 2 :selectable false
                                  :wrapMode "none" :truncate true
                                  :content (card-content item width)})]
    (set! (.-northThreadId card) thread-id)
    (set! (.-northCondition card) condition)
    (set! (.-onMouseDown card)
          (fn [event: Any] -> Any
            (when (identical? (.-button event) 0)
              (.preventDefault event)
              (.stopPropagation event)
              (select-board-card! runtime ui item index))))
    (set! (.-onMouseDrag card)
          (fn [event: Any] -> Any
            (set! (.-dragThreadId runtime) thread-id)
            (.updateAutoScroll (.-workScroll ui) (.-x event) (.-y event))))
    (set! (.-onMouseDragEnd card)
          (fn [_event: Any] -> Any
            (set! (.-dragThreadId runtime) "")
            (.stopAutoScroll (.-workScroll ui))))
    (set! (.-onMouseOver card)
          (fn [_event: Any] -> Any
            (set! (.-borderColor card) "#22d3ee")))
    (set! (.-onMouseOut card)
          (fn [_event: Any] -> Any
            (set! (.-borderColor card) (if selected? "#22d3ee" "#64748b"))))
    (set! (.-onMouseDrop card)
          (fn [event: Any] -> Any
            (handle-board-drop! runtime ui (board-lane-id condition) card event)))
    (.add card content)
    card))

(defn make-board-lane!
  [runtime: Any
   ui: Any
   lane: BoardLane
   items: (Vec WorkItem)
   card-width: Int] -> Any
  (let [renderer (.-renderer runtime)
        lane-id (boardlane-id lane)
        title (boardlane-title lane)
        lane-items (board-lane-items items lane-id)
        lane-box (BoxRenderable. renderer
                                 {:width "100%" :flexDirection "column" :flexShrink 0
                                  :border ["bottom"] :borderColor "#334155" :paddingBottom 1})
        header (TextRenderable. renderer
                                {:width "100%" :height 1 :flexShrink 0 :selectable false
                                 :wrapMode "none"
                                 :content (StyledText.
                                           [(brightGreen title)
                                            (brightBlack (str "  " (.-length lane-items)))] )})
        cards (BoxRenderable. renderer
                              {:width "100%" :minHeight 4 :flexDirection "row" :flexWrap "wrap"
                               :flexShrink 0 :gap 1 :rowGap 1})]
    (set! (.-northLaneId cards) lane-id)
    (set! (.-onMouseOver cards)
          (fn [_event: Any] -> Any
            (set! (.-borderColor lane-box) "#4ade80")))
    (set! (.-onMouseOut cards)
          (fn [_event: Any] -> Any
            (set! (.-borderColor lane-box) "#334155")))
    (set! (.-onMouseDrop cards)
          (fn [event: Any] -> Any
            (handle-board-drop! runtime ui lane-id nil event)))
    (.forEach
     lane-items
     (fn
       [item: WorkItem
        lane-index: Int] -> Any
       (.add cards
             (make-board-card! runtime ui item (.indexOf items item) lane-index card-width))))
    (.add lane-box header)
    (.add lane-box cards)
    lane-box))

(defn clear-board! [root: Any] -> Any
  (.forEach (.getChildren root)
            (fn [child: Any] -> Any (.destroyRecursively child))))

(defn sync-board!
  [runtime: Any
   ui: Any
   items: (Vec WorkItem)
   selected: Int
   width: Int] -> Any
  (let [signature (board-signature items selected width)]
    (when (not (identical? signature (text (.-boardSignature runtime))))
      (set! (.-boardSignature runtime) signature)
      (clear-board! (.-boardRoot ui))
      (let [card-width (if (>= width 54) 25 (Math/max 18 (- width 3)))]
        (.forEach BOARD-LANES
                  (fn [lane: BoardLane] -> Any
                    (.add (.-boardRoot ui)
                          (make-board-lane! runtime ui lane items card-width)))))
      (when (and (>= selected 0) (< selected (.-length items)))
        (.scrollChildIntoView (.-workScroll ui)
                              (board-card-id (workitem-id (aget items selected))))))))

(defn work-content!
  [runtime: Any
   state: BridgeSnapshot
   view: WorkView
   selected: Int] -> Any
  (let [items (workview-items view)
        width (available-work-width runtime state)]
    (if (identical? (.-length items) 0)
      (StyledText. [(brightBlack (str "No " (workview-title view) " items"))])
      (cond
        (identical? (workview-id view) "graph")
        (render-dag-view! items selected width)

        :else
        (render-list-view! runtime items selected width)))))

;; Pure: the grey hint in the composer. It used to name the command set the
;; focused frame answers to; the view bar sits directly under the composer and
;; already says which frame is active, so the suffix was explaining twice.
(js/export
 (defn composer-hint
  [pane: String
   label: String] -> String
  (if (identical? pane "agents")
    (str "Message " label "…")
    "/list, /board, /graph, /capture, /filter, /assign")))

(defn minibuffer-placeholder [runtime: Any] -> String
  (composer-hint (text (.-frame runtime)) (main-agent-label)))

;; Pure: rows the slash palette may draw at once. `docked` is whatever the
;; detail panel is already spending, so an open switchboard shrinks the palette
;; instead of overflowing the frame.
(defn palette-visible-count
  [total: Int
   rows: Int
   docked: Int] -> Int
  (fitted-window total rows (+ CHROME-ROWS MIN-WORKSPACE-ROWS docked)))

;; Pure: option rows inside the window. When the list overflows, one row of the
;; window is spent on the "… N more" line instead of an option.
(defn palette-option-rows
  [total: Int
   window: Int] -> Int
  (if (and (> total window) (> window 1)) (- window 1) window))

;; Pure: what the overflow line reports, 0 when there is nothing to report or
;; no row to report it on.
(defn palette-overflow
  [total: Int
   window: Int
   rows: Int] -> Int
  (if (and (> total rows) (> window rows)) (- total rows) 0))

(defn render-minibuffer!
  [runtime: Any
   ui: Any] -> (Vec SlashCommand)
  (let [frame (text (.-frame runtime))
        input (.-composerInput ui)
        options (palette-options frame (text (.-value input)))
        total (.-length options)
        index (Math/max 0 (Math/min (.-paletteIndex runtime) (Math/max 0 (- total 1))))
        docked (if (detail-open? runtime) (detail-height runtime) 0)
        window (palette-visible-count total (terminal-rows) docked)
        rows (palette-option-rows total window)
        start (window-start index total rows)]
    (set! (.-paletteIndex runtime) index)
    (set! (.-paletteStart runtime) start)
    (set! (.-paletteRows runtime) rows)
    (set! (.-placeholder input) (minibuffer-placeholder runtime))
    (set! (.-visible (.-composerPalette ui)) (> total 0))
    (set! (.-height (.-composerPalette ui)) window)
    (set! (.-content (.-composerPalette ui))
          (if (> total 0)
            (render-command-palette! (.slice options start (+ start rows))
                                     (- index start)
                                     (palette-overflow total window rows))
            ""))
    options))

(defn render-ui!
  [runtime: Any
   ui: Any] -> Any
  (when (not (.-disposed runtime))
    (let [state (snapshot (.-model runtime))
        agents (bridgesnapshot-agents state)
        views (view-list state)
        requested (bridgesnapshot-active-view-id state)
        current (selected-view state requested)
        items (workview-items current)
        agent-max (Math/max 0 (- (.-length agents) 1))
        work-max (Math/max 0 (- (.-length items) 1))
        board? (identical? (workview-id current) "board")]
    (set! (.-agentIndex runtime) (Math/max 0 (Math/min (.-agentIndex runtime) agent-max)))
    (set! (.-workIndex runtime) (Math/max 0 (Math/min (.-workIndex runtime) work-max)))
    (apply-frame-visibility! runtime ui)
    (set! (.-content (.-viewTabsText ui))
          (render-view-tabs! (.-frame runtime) state (workview-id current) runtime))
    (set! (.-content (.-agentsText ui))
          (roster-text state (.-agentIndex runtime)
                       (text (.-supervisorId runtime))
                       (banner-visible? runtime)))
    (set! (.-content (.-transcriptText ui)) (render-conversation! runtime))
    (set! (.-visible (.-workText ui)) (not board?))
    (set! (.-visible (.-boardRoot ui)) board?)
    (if board?
      (sync-board! runtime ui items (.-workIndex runtime)
                   (available-work-width runtime state))
      (set! (.-content (.-workText ui))
            (work-content! runtime state current (.-workIndex runtime))))
    (set! (.-content (.-statusText ui)) (render-status runtime state))
    (set! (.-content (.-agentStatusText ui)) (render-status runtime state))
    ;; One status line, inside whichever view is showing.
    (set! (.-visible (.-agentStatusText ui))
          (not (threads-frame? (.-frame runtime))))
    (render-prompt! runtime (.-composerPrompt ui))
    (let [segments (agent-segments agents)
          strip-max (Math/max 0 (- (.-length segments) 1))]
      (set! (.-stripIndex runtime)
            (Math/max 0 (Math/min (.-stripIndex runtime) strip-max)))
      (set! (.-content (.-agentStripText ui))
            (render-agent-strip state (.-stripFocused runtime)
                                (.-stripIndex runtime))))
    (let [open? (detail-open? runtime)]
      (set! (.-visible (.-detailPanel ui)) open?)
      (when open?
        (set! (.-height (.-detailPanel ui)) (detail-height runtime))
        (set! (.-content (.-detailText ui)) (render-detail-panel! runtime))))
    (render-minibuffer! runtime ui)
      (set! (.-activeView runtime) (workview-id current))
      views)))

(defn bridge-agent!
  [runtime: Any
   execution-id: String
   role: String
   status: String] -> Any
  (let [state (snapshot (.-model runtime))
        agents (bridgesnapshot-agents state)
        prior-id (selected-agent-id state (.-agentIndex runtime))
        existing (.find agents
                        (fn [agent: Agent] -> Bool
                          (identical? (agent-id agent) execution-id)))
        updated (->Agent execution-id
                         (if (identical? role "supervisor")
                           (main-agent-label)
                           (str "Codex " (.slice execution-id 0 8)))
                         status
                         (if (identical? role "supervisor")
                           "Northbridge control session"
                           "Bridge execution")
                         "" "" "" "" "" "" "" "" "")]
    (.add (.-bridgeExecutions runtime) execution-id)
    (when (identical? role "supervisor")
      (set! (.-supervisorId runtime) execution-id))
    (set! (.-model runtime)
          (upsert-agent (.-model runtime)
                        (if existing (agent-with-route updated existing) updated)))
    (reconcile-agent-selection! runtime
                                (text-or prior-id
                                         (if (identical? role "supervisor") execution-id ""))))
  (.render runtime))

(defn record-line [line: String] -> ParsedRecord?
  (let [close (.indexOf line "] ")]
    (if (or (not (.startsWith line "[")) (< close 0))
      nil
      (let [rest (.slice line (+ close 2))
            space (.indexOf rest " ")
            kind (if (< space 0) rest (.slice rest 0 space))
            payload (if (< space 0) "" (.trim (.slice rest (+ space 1))))]
        (try
          (->ParsedRecord kind (if (identical? payload "") {} (JSON/parse payload)))
          (catch Error _ nil))))))

(defn event-item-id
  [execution-id: String
   item-id: Any] -> String
  (str execution-id ":" (text item-id)))

(defn append-item-delta!
  [runtime: Any
   id: String
   kind: String
   title: String
   delta: String
   status: String] -> Any
  (let [existing (conversation-item-by-id runtime id)
        prior (if existing (conversationitem-body existing) "")
        actual-title (if existing (conversationitem-title existing) title)]
    (upsert-conversation!
     runtime
     (conversation-item-with-data! id kind actual-title (clipped (str prior delta) 6000) status
                                   (if existing (conversationitem-data existing) nil)))))

(defn wire-content-text [value: Any] -> String
  (cond
    (nil? value) ""
    (identical? (js/typeof value) "string") value
    (Array/isArray value)
    (.join
     (.filter
      (.map value (fn [part: Any] -> String (wire-content-text part)))
      (fn [part: String] -> Bool (not (identical? part ""))))
     "\n")
    :else (safe-json value)))

(defn adopt-wire-model!
  [runtime: Any
   model: Any
   effort: Any] -> Any
  (when model
    (let [provider (text (.-provider model))
          tier (text (.-tier model))
          label (cond
                  (and (not (identical? provider ""))
                       (not (identical? tier ""))) (str provider "/" tier)
                  (not (identical? provider "")) provider
                  :else "")]
      (when (not (identical? label "")) (set! (.-sessionModel runtime) label))))
  (let [effort-label (text effort)]
    (when (not (identical? effort-label ""))
      (set! (.-sessionEffort runtime) effort-label))))

(defn intermediate-provider-session-replacement? [data: Any] -> Bool
  (and (identical? (text (.-status data)) "failed")
       (identical? (text (.-origin data)) "north")
       (identical? (text (.-errorCode data)) "provider_session_replaced")))

(defn handle-wire-message!
  [runtime: Any
   stream-state: Any
   data: Any] -> Any
  (let [role (text (.-role data))
        stage (text (.-stage data))
        execution-id (text (.-executionId stream-state))
        id (event-item-id execution-id (.-messageId data))
        body (clean-text (wire-content-text (.-content data)))
        existing (conversation-item-by-id runtime id)]
    (when (and (identical? role "assistant") (not (.-booting stream-state)))
      (cond
        (identical? stage "started")
        (upsert-conversation! runtime (conversation-item id "assistant" "" "" "running"))

        (identical? stage "delta")
        (append-item-delta! runtime id "assistant" "" body "running")

        (identical? stage "completed")
        (let [completed-body (if (identical? body "")
                               (if existing (conversationitem-body existing) "")
                               body)]
          (set! (.-lastAssistantText runtime) completed-body)
          (upsert-conversation!
           runtime (conversation-item id "assistant" "" completed-body "done")))

        :else nil))))

(defn handle-wire-tool!
  [runtime: Any
   stream-state: Any
   data: Any
   kind: String] -> Any
  (let [id (event-item-id (text (.-executionId stream-state)) (.-toolCallId data))
        existing (conversation-item-by-id runtime id)]
    (cond
      (identical? kind "tool.admitted")
      (upsert-conversation!
       runtime
       (conversation-item id "tool" (text (.-name data))
                          (clean-text (.-argumentPreview data)) "running"))

      (identical? kind "tool.progress")
      (append-item-delta! runtime id "tool"
                          (if existing (conversationitem-title existing) "Tool activity")
                          (wire-content-text (.-progress data)) "running")

      (identical? kind "tool.terminal")
      (upsert-conversation!
       runtime
       (conversation-item id "tool"
                          (if existing (conversationitem-title existing) "Tool activity")
                          (text-or (.-resultPreview data)
                                   (if existing (conversationitem-body existing) ""))
                          (if (identical? (text (.-status data)) "succeeded")
                            "done" "failed")))

      :else nil)))

(defn handle-record!
  [runtime: Any
   stream-state: Any
   record: ParsedRecord] -> Any
  (let [kind (parsedrecord-kind record)
        data (or (parsedrecord-data record) {})
        execution-id (text (.-executionId stream-state))]
    (cond
      (identical? kind "execution.accepted")
      (let [cwd (text (.-cwd data))]
        (when (not (identical? cwd ""))
          (set! (.-sessionCwd runtime) cwd)))

      (identical? kind "model-call.started")
      (do (adopt-wire-model! runtime (.-model data) (.-effort data))
          (set-working! runtime true "Agent is working")
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id (text (.-role stream-state)) "working")))

      (identical? kind "message.recorded")
      (handle-wire-message! runtime stream-state data)

      (or (identical? kind "tool.admitted")
          (identical? kind "tool.progress")
          (identical? kind "tool.terminal"))
      (handle-wire-tool! runtime stream-state data kind)

      (identical? kind "run.progress")
      (let [progress (or (.-progress data) {})
            action (text (.-currentAction progress))
            lifecycle (text (.-lifecycle data))]
        (adopt-wire-model! runtime (.-model progress) (.-effort progress))
        (when (.-branch progress)
          (set! (.-sessionBranch runtime) (text (.-name (.-branch progress)))))
        (if (identical? lifecycle "waiting")
          (set-working! runtime false "")
          (when (not (identical? action "")) (set-working! runtime true action))))

      (identical? kind "artifact.published")
      (upsert-conversation!
       runtime
       (conversation-item (event-item-id execution-id (.-artifactId data)) "change"
                          (text-or (.-label data) "Published artifact")
                          (text (.-mediaType data)) "done"))

      (identical? kind "model-call.completed")
      (when (not (intermediate-provider-session-replacement? data))
        (set-working! runtime false ""))

      (identical? kind "session.idle")
      (let [disposition (text (.-disposition data))
            pending-inputs (Number (or (.-pendingInputs data) 0))
            booting (.-booting stream-state)]
        (set-working! runtime false "")
        (cond
          booting (play-sound-event! runtime stream-state "ready")
          (identical? disposition "interrupted")
          (play-sound-event! runtime stream-state "interrupted")
          (and (identical? disposition "completed")
               (<= pending-inputs 0))
          (play-sound-event! runtime stream-state "done")
          :else nil)
        (set! (.-booting stream-state) false)
        (when (not (identical? execution-id ""))
          (bridge-agent! runtime execution-id (text (.-role stream-state)) "ready")))

      (identical? kind "run.terminated")
      (do (set-working! runtime false "")
          (when (or (identical? (text (.-lifecycle data)) "failed")
                    (identical? (text (.-lifecycle data)) "blocked"))
            (play-sound-event! runtime stream-state "failed")
            (append-error! runtime (failure-summary (.-reason data))))
          (when (not (identical? execution-id ""))
            (bridge-agent! runtime execution-id
                           (text (.-role stream-state)) "offline")))

      (identical? kind "execution.failure")
      (do (set-working! runtime false "")
          (append-error! runtime (str kind ": " (failure-summary data))))

      :else nil)))

(js/export
 (defn parse-bridge-stream!
  [runtime: Any
   stream-state: Any
   chunk: String] -> Any
  (let [lines (.split (str (.-buffer stream-state) chunk) "\n")
        remainder (.pop lines)]
    (set! (.-buffer stream-state) remainder)
    (.forEach
     lines
     (fn [raw-line: String] -> Any
       (let [line (.trim raw-line)]
         (cond
           (.startsWith line "execution ")
           (let [execution-id (.trim (.slice line 10))]
             (set! (.-executionId stream-state) execution-id)
             (set! (.-soundLive stream-state) true)
             (bridge-agent! runtime execution-id (text (.-role stream-state)) "starting"))

           (.startsWith line "attached ")
           (set! (.-soundLive stream-state) true)

           (.startsWith line "[")
           (let [record (record-line line)]
             (when record (handle-record! runtime stream-state record)))

           ;; The client replaced a stale daemon on its own. That is not an
           ;; error and not a chore — it is one grey line, and then the session
           ;; it was asked for.
           (.startsWith line "northd: ")
           (publish-line! runtime (.slice line 8))

           (.startsWith line "north bridge:")
           (append-error! runtime line)

           :else nil)))))))

(defn supervisor-provider-flag [] -> String
  (let [value (.trim (text (.-NORTH_BRIDGE_PROVIDER (.-env process))))]
    (cond
      (identical? value "anthropic") "--claude"
      (identical? value "openai") "--openai"
      :else "")))

;; What the control session is *called* on screen. The role it plays inside the
;; runtime is still "supervisor" — that identifier reaches northd, the journal,
;; and msg routing, and is deliberately not what this returns.
(defn main-agent-label [] -> String
  (let [value (.trim (text (.-NORTH_BRIDGE_PROVIDER (.-env process))))]
    (cond
      (identical? value "anthropic") "Claude Main"
      (identical? value "openai") "Codex Main"
      :else "Main")))

(defn launch-agent!
  [runtime: Any
   prompt: String
   role: String] -> (Promise Any)
  (when (identical? (.trim prompt) "")
    (throw (Error. "launch requires a prompt")))
  (when (not (identical? role "supervisor"))
    (upsert-conversation!
     runtime
     (conversation-item (next-item-id! runtime "user") "user" "" (.trim prompt) "done")))
  (set-working! runtime true (str "Starting " (main-agent-label)))
  (let [stream-state {:buffer "" :stderr "" :executionId "" :role role
                      :booting (identical? role "supervisor") :soundLive false}
        exit-code
        (js/await
         (stream-command
          (let [flag (supervisor-provider-flag)
                base [(north-bin) "bridge" "--role"
                      (if (identical? role "supervisor") "director" "implementer")]]
            (if (identical? flag "")
              (conj base prompt)
              (conj (conj base flag) prompt)))
          (fn [chunk: String] -> Any
            (parse-bridge-stream! runtime stream-state chunk))
          (fn [chunk: String] -> Any
            (set! (.-stderr stream-state)
                  (clipped (str (.-stderr stream-state) chunk) 6000)))))]
    (when (not (identical? exit-code 0))
      (set-working! runtime false "")
      (append-error! runtime
                     (str "Bridge exited " exit-code
                          (if (identical? (.trim (text (.-stderr stream-state))) "") ""
                            (str "\n" (.trim (text (.-stderr stream-state))))))))))

(defn popout!
  [runtime: Any
   view-id: String] -> Any
  (let [ghostty (.which Bun "ghostty")
        kitty (.which Bun "kitty")
        wezterm (.which Bun "wezterm")
        foot (.which Bun "foot")
        xterm (.which Bun "xterm")
        argv (cond
               ghostty [ghostty "-e" (north-bin) "bridge" "app" "--view-id" view-id]
               kitty [kitty "--detach" (north-bin) "bridge" "app" "--view-id" view-id]
               wezterm [wezterm "start" "--always-new-process" "--" (north-bin) "bridge" "app" "--view-id" view-id]
               foot [foot (north-bin) "bridge" "app" "--view-id" view-id]
               xterm [xterm "-e" (north-bin) "bridge" "app" "--view-id" view-id]
               :else nil)]
    (when (nil? argv)
      (throw (Error. "no supported terminal found for pop-out")))
    (let [child (.spawn Bun {:cmd argv :stdin "ignore" :stdout "ignore" :stderr "ignore"})]
      (.unref child)
      (publish-line! runtime (str "opened " view-id " in a separate terminal")))))

(defn selected-work
  [runtime: Any
   selection: WorkSelection] -> WorkItem?
  (let [state (snapshot (.-model runtime))
        view-id (text-or (workselection-view selection) (text (.-activeView runtime)))
        view (selected-view state view-id)
        items (workview-items view)
        index (workselection-index selection)]
    (if (and (>= index 0) (< index (.-length items)))
      (let [item (aget items index)]
        (if (or (not (identical? (workview-id view) "list"))
                (not (.has (.-collapsedListConditions runtime)
                           (list-section-id (workitem-condition item)))))
          item
          nil))
      nil)))

;; Capture takes nothing from the frame it was typed in: a title, the `north`
;; CLI, and a refresh of the threads the agents frame may not even be showing.
;; Both frames call this, which is why /capture is in both command sets.
(defn capture-thread!
  [runtime: Any
   title: String] -> (Promise Any)
  (when (identical? title "") (throw (Error. "capture requires a title")))
  (let [output (js/await (run-command [(north-bin) "capture" title]))]
    (publish-line! runtime (.trim (text output))))
  (js/await (refresh! runtime)))

;; A cancelled turn gives the message back. The text that started it is
;; remembered at submit time and returned to the composer here, cursor at the
;; end (the input's value setter puts it there), so the thought survives the
;; cancel and can be edited and sent again.
(js/export
 (defn restore-submitted-text!
  [runtime: Any
   ui: Any] -> Any
  (let [pending (text (.-lastSubmitted runtime))
        input (.-composerInput ui)]
    (when (and (not (identical? pending "")) input)
      (set! (.-lastSubmitted runtime) "")
      (set! (.-value input) pending)
      (.focus input)))))

;; The one way a turn ends early, whether it was /interrupt, escape or ctrl-c
;; that asked. Everything downstream of "stop" belongs here so the three
;; entrances cannot drift apart.
(defn cancel-turn!
  [runtime: Any
   ui: Any
   target: String] -> (Promise Any)
  (when (not (.has (.-bridgeExecutions runtime) target))
    (throw (Error. "interrupt is available for Bridge-launched executions")))
  (js/await (run-command [(north-bin) "bridge" "interrupt" target]))
  (set-working! runtime false "")
  (append-interrupted! runtime)
  (restore-submitted-text! runtime ui))

(defn submit-agent!
  [runtime: Any
   ui: Any
   input: String
   selection: String] -> (Promise Any)
  (let [trimmed (.trim input)
        slash? (.startsWith trimmed "/")
        parsed (command input)
        name (parsedcommand-name parsed)
        rest (parsedcommand-rest parsed)
        target (text-or selection (text (.-supervisorId runtime)))]
    (if (handle-local-command! runtime ui input)
      nil
      (cond
      (and slash? (identical? name "launch")) (js/await (launch-agent! runtime rest "worker"))
      (and slash? (identical? name "capture")) (js/await (capture-thread! runtime rest))
      (and slash? (identical? name "refresh")) (js/await (refresh! runtime))
      (and slash? (identical? name "popout"))
      (popout! runtime (text-or rest (text (.-activeView runtime))))
      :else
      (do
        (when (identical? target "")
          (throw (Error. "select an agent before messaging or interrupting")))
        (if (and slash? (identical? name "interrupt"))
          (js/await (cancel-turn! runtime ui target))
          ;; Plain text is the message. There is no command spelling of it:
          ;; typing into the composer already messages the selected agent, so
          ;; a /msg verb would only be ceremony in front of the same path.
          (let [message trimmed]
            (when (identical? message "") (throw (Error. "nothing to send")))
            (upsert-conversation!
             runtime
             (conversation-item (next-item-id! runtime "user") "user" "" message "done"))
            ;; What a cancel would hand back: the message this turn started with.
            (set! (.-lastSubmitted runtime) message)
            (set-working! runtime true "Codex is working")
            (if (.has (.-bridgeExecutions runtime) target)
              (js/await (run-command [(north-bin) "bridge" "msg" target message]))
              (js/await (run-command [(north-bin) "msg" target message])))
            (.render runtime))))))))

(defn submit-work!
  [runtime: Any
   ui: Any
   input: String
   selection: WorkSelection] -> (Promise Any)
  (let [trimmed (.trim input)
        slash? (.startsWith trimmed "/")
        parsed (command input)
        name (parsedcommand-name parsed)
        rest (parsedcommand-rest parsed)]
    (if (not slash?)
      (js/await (submit-agent! runtime ui input (.-supervisorId runtime)))
      (if (handle-local-command! runtime ui input)
      nil
      (cond
      (identical? name "filter")
      (do (set! (.-model runtime) (set-filter (.-model runtime) rest)) (.render runtime))

      (identical? name "refresh") (js/await (refresh! runtime))
      (identical? name "popout") (popout! runtime (if (identical? rest "") (.-activeView runtime) rest))

      (identical? name "capture") (js/await (capture-thread! runtime rest))

      (identical? name "assign")
      (let [item (selected-work runtime selection)
            words (.filter (.split rest " ") (fn [word: String] -> Bool (not (identical? (.trim word) ""))))
            current (if item (workitem-driver item) "")
            prior (if (> (.-length words) 1) (aget words 0) current)
            next-driver (if (> (.-length words) 1)
                          (aget words 1)
                          (text (aget words 0)))
            thread-id (if item (workitem-id item) "")]
        (when (identical? thread-id "") (throw (Error. "select a thread before assigning")))
        (when (identical? prior "") (throw (Error. "an unassigned thread requires: /assign <prior-driver> <next-driver>")))
        (when (identical? next-driver "") (throw (Error. "assign requires a new driver")))
        (publish-line! runtime "driver reassignment is a retract-then-tell operation")
        (js/await (run-command [(north-bin) "retract" thread-id "driver" prior]))
        (js/await (run-command [(north-bin) "tell" thread-id "driver" next-driver]))
        (publish-line! runtime (str "assigned @" thread-id " to " next-driver))
        (js/await (refresh! runtime)))

      (identical? name "outcome")
      (let [split-at (.indexOf rest " ")
            thread-id (if (< split-at 0) "" (bare (.slice rest 0 split-at)))
            result (if (< split-at 0) "" (.trim (.slice rest (+ split-at 1))))]
        (when (identical? thread-id "")
          (throw (Error. "outcome requires: /outcome <thread-id> <result>")))
        (when (identical? result "")
          (throw (Error. "outcome requires a result")))
        (js/await (run-command [(north-bin) "tell" thread-id "outcome" result]))
        (set! (.-workspaceNotice runtime) (str "Recorded outcome for @" thread-id "."))
        (js/await (refresh! runtime)))


      :else
      (throw (Error. "unknown thread command; use /help")))))))

(defn report-promise!
  [runtime: Any
   promise: Any] -> Any
  (.catch promise
          (fn [error: Any] -> Any
            (publish-line! runtime (str "error: " (error-message error))))))

(defn select-frame!
  [runtime: Any
   frame: String] -> Any
  (set! (.-frame runtime) frame)
  (set! (.-paletteIndex runtime) 0)
  (set! (.-workspaceNotice runtime) "")
  (clear-strip-focus! runtime))

;; Swapping which view is on screen. The composer is shared by both and keeps
;; the cursor throughout — there is no pane to focus, only a view to show.
(defn show-frame!
  [runtime: Any
   ui: Any
   frame: String] -> Any
  (select-frame! runtime frame)
  (.focus (.-composerInput ui))
  (.render runtime))

;; Naming a thread view names the Threads view too: typed from Agents, /board
;; is "show me the board", not "silently rearrange a screen I am not looking
;; at".
(defn show-thread-view!
  [runtime: Any
   ui: Any
   view-id: String] -> Any
  (set! (.-model runtime) (focus-view (.-model runtime) (canonical-work-view view-id)))
  (set! (.-workIndex runtime) 0)
  (.scrollTo (.-workScroll runtime) 0)
  (show-frame! runtime ui "threads"))

(defn strip-segments [runtime: Any] -> (Vec AgentSegment)
  (agent-segments (bridgesnapshot-agents (snapshot (.-model runtime)))))

(defn focus-strip!
  [runtime: Any
   ui: Any] -> Any
  ;; The composer keeps its content; it only loses the cursor, so nothing the
  ;; operator types can be swallowed by the strip's h/l/j/k bindings.
  (set! (.-stripFocused runtime) true)
  (.blur (.-composerInput ui))
  (.render runtime))

(defn leave-strip!
  [runtime: Any
   ui: Any] -> Any
  (set! (.-stripFocused runtime) false)
  (when (detail-showing? runtime "agents") (close-detail! runtime))
  (.focus (.-composerInput ui))
  (.render runtime))

(defn clear-strip-focus! [runtime: Any] -> Any
  (when (.-stripFocused runtime)
    (set! (.-stripFocused runtime) false)
    (when (detail-showing? runtime "agents") (close-detail! runtime))))

(defn show-segment-detail!
  [runtime: Any
   index: Int] -> Any
  (let [segments (strip-segments runtime)]
    (when (> (.-length segments) 0)
      (let [selected (clamped-index index (.-length segments))]
        (set! (.-stripIndex runtime) selected)
        (set! (.-detailSegment runtime)
              (agentsegment-id (aget segments selected)))
        (set! (.-detailIndex runtime) 0)
        (open-detail! runtime "agents")))))

(defn toggle-segment-detail! [runtime: Any] -> Any
  (if (detail-showing? runtime "agents")
    (close-detail! runtime)
    (show-segment-detail! runtime (.-stripIndex runtime))))

(defn move-strip-segment!
  [runtime: Any
   delta: Int] -> Any
  (let [segments (strip-segments runtime)
        total (.-length segments)]
    (when (> total 0)
      (let [next-index (mod (+ (.-stripIndex runtime) delta total) total)]
        (set! (.-stripIndex runtime) next-index)
        (set! (.-detailIndex runtime) 0)
        (when (detail-showing? runtime "agents")
          (set! (.-detailSegment runtime)
                (agentsegment-id (aget segments next-index))))))))

(defn move-detail-cursor!
  [runtime: Any
   delta: Int] -> Any
  (let [total (.-length (detail-agents runtime))]
    (when (> total 0)
      (set! (.-detailIndex runtime)
            (mod (+ (clamped-index (.-detailIndex runtime) total) delta total)
                 total)))))

(defn active-input
  [_runtime: Any
   ui: Any] -> Any
  (.-composerInput ui))

(defn active-palette-options
  [runtime: Any
   ui: Any] -> (Vec SlashCommand)
  (let [frame (text (.-frame runtime))
        input (active-input runtime ui)]
    (palette-options frame (text (.-value input)))))

;; The composer's editing keys. Nothing else registers a layer any more: with
;; one view on screen there are no window chords to arbitrate.
(defn install-composer-keymap! [runtime: Any] -> Any
  (let [keymap (createDefaultOpenTuiKeymap (.-renderer runtime))]
    (registerEmacsBindings keymap)
    (registerEscapeClearsPendingSequence keymap)
    (set! (.-keymap runtime) keymap)))

;; The text completion writes for an entry: its completion when it carries one,
;; its own name otherwise, plus the space an argument is going to need. One
;; definition, so "did completion already run?" is answerable by comparison.
(defn palette-completion-text [candidate: SlashCommand] -> String
  (let [completion (slashcommand-completion candidate)]
    (if (identical? completion "")
      (str (slashcommand-name candidate)
           (if (slashcommand-arguments candidate) " " ""))
      completion)))

(defn palette-candidate
  [runtime: Any
   commands: (Vec SlashCommand)] -> SlashCommand
  (aget commands
        (Math/max 0 (Math/min (.-paletteIndex runtime) (- (.-length commands) 1)))))

(defn complete-palette!
  [runtime: Any
   ui: Any
   commands: (Vec SlashCommand)] -> Any
  (when (> (.-length commands) 0)
    (let [candidate (palette-candidate runtime commands)
          input (active-input runtime ui)]
      (set! (.-value input) (palette-completion-text candidate))
      (set! (.-paletteIndex runtime) 0)
      (.focus input)
      (render-minibuffer! runtime ui))))

;; The one way a line leaves the composer, whether the user typed it and hit
;; enter or the palette fired a command on their behalf. The composer is
;; cleared first so the frame never shows a line that is already in flight.
(defn submit-input!
  [runtime: Any
   ui: Any
   input: String] -> Any
  (when (not (identical? input ""))
    (set! (.-value (.-composerInput ui)) "")
    (set! (.-paletteIndex runtime) 0)
    (if (not (threads-frame? (.-frame runtime)))
      (let [state (snapshot (.-model runtime))
            selected (selected-agent-id state (.-agentIndex runtime))]
        (report-promise! runtime (submit-agent! runtime ui input selected)))
      (report-promise! runtime
                       (submit-work! runtime ui input
                                     (->WorkSelection (.-activeView runtime)
                                                      (.-workIndex runtime)))))))

;; Pure: what enter means while the palette is open, given the highlighted
;; entry. A command that takes no arguments has nothing left to say, so enter
;; runs it — one keystroke, not two. A command that takes arguments completes
;; into the composer instead, because firing it bare would only earn an error;
;; the same goes for the emoji and glyph pickers, whose entries are text to
;; insert rather than commands. Once the composer already holds exactly what
;; completion would write, enter has nothing left to complete and fires.
(js/export
 (defn palette-enter-action
  [matches: Int
   takes-arguments?: Bool
   insert-only?: Bool
   completed?: Bool] -> String
  (cond
    (< matches 1) ""
    completed? "fire"
    (or insert-only? takes-arguments?) "complete"
    :else "fire")))

(defn install-input!
  [runtime: Any
   ui: Any] -> Any
  (.on (.-composerInput ui) (.-INPUT InputRenderableEvents)
       (fn [_value: Any] -> Any
         (set! (.-paletteIndex runtime) 0)
         (render-minibuffer! runtime ui)))
  (.on (.-composerInput ui) (.-ENTER InputRenderableEvents)
       (fn [] -> Any
         (submit-input! runtime ui (.trim (text (.-value (.-composerInput ui))))))))

;; Pure: which thread view owns a column past the sub-view origin, "" for the
;; gaps. The row is derived from view-list and the origin from the labels, so
;; reordering the views or renaming a label moves the hit boxes with them —
;; there are no hand-counted column ranges left to drift out of step.
(defn subview-tab-id-at
  [views: (Vec WorkView)
   column: Int] -> String
  (let [cursor {:x SUBVIEW-TAB-ORIGIN :id ""}]
    (.forEach views
              (fn [view: WorkView] -> Any
                (let [start (.-x cursor)
                      ;; "[Title]" when selected, " Title " otherwise: same width.
                      width (+ (.-length (workview-title view)) 2)]
                  (when (and (>= column start) (< column (+ start width)))
                    (set! (.-id cursor) (workview-id view)))
                  (set! (.-x cursor) (+ start width SUBVIEW-TAB-GAP)))))
    (text (.-id cursor))))

;; Pure: what a column on the view bar means — "agents", "threads", a thread
;; view id, or "" for the parts that are not a label. The sub-view tabs are only
;; there, and only clickable, while Threads is showing.
(js/export
 (defn view-tab-id-at
  [frame: Any
   views: (Vec WorkView)
   column: Int] -> String
  (cond
    (and (>= column 0) (< column (.-length AGENTS-TAB-LABEL))) "agents"
    (and (>= column THREADS-TAB-START)
         (< column (+ THREADS-TAB-START (.-length THREADS-TAB-LABEL)))) "threads"
    (and (threads-frame? frame) (>= column SUBVIEW-TAB-ORIGIN))
    (subview-tab-id-at views column)
    :else "")))

(defn view-tab-at
  [runtime: Any
   tabs: Any
   event: Any
   views: (Vec WorkView)] -> String
  (view-tab-id-at (.-frame runtime)
                  views
                  (Math/floor (- (.-x event) (.-x tabs)))))

(defn complete-clicked-palette!
  [runtime: Any
   ui: Any
   frame: String
   palette-renderable: Any
   event: Any] -> Any
  (when (identical? (.-button event) 0)
    (select-frame! runtime frame)
    (let [input (.-composerInput ui)
          options (palette-options frame (text (.-value input)))
          row (Math/floor (- (.-y event) (.-y palette-renderable)))
          ;; The palette scrolls, so screen row N is option start+N. Rows past
          ;; the option rows are the overflow line, which is not clickable.
          scrolled (.-paletteStart runtime)
          start (if scrolled scrolled 0)
          drawn (.-paletteRows runtime)
          rows (if drawn drawn 0)
          picked (+ start row)]
      (when (and (>= row 0) (< row rows) (< picked (.-length options)))
        (.preventDefault event)
        (.stopPropagation event)
        (set! (.-paletteIndex runtime) picked)
        (complete-palette! runtime ui options)))))

(defn visible-list-indices
  [runtime: Any
   items: (Vec WorkItem)] -> (Vec Int)
  (.map
   (.filter (list-rows runtime items)
            (fn [row: ListRow] -> Bool
              (identical? (listrow-kind row) "item")))
   (fn [row: ListRow] -> Int (listrow-index row))))

(defn next-visible-list-index
  [runtime: Any
   items: (Vec WorkItem)
   current: Int
   delta: Int] -> Int
  (let [indices (visible-list-indices runtime items)
        position (.indexOf indices current)
        start (if (>= position 0) position (if (> delta 0) -1 (.-length indices)))
        next (Math/max 0 (Math/min (- (.-length indices) 1) (+ start delta)))]
    (if (> (.-length indices) 0) (aget indices next) current)))

(defn select-visible-list-fallback!
  [runtime: Any
   items: (Vec WorkItem)] -> Any
  (let [indices (visible-list-indices runtime items)
        current (.-workIndex runtime)]
    (when (and (> (.-length indices) 0)
               (not (.includes indices current)))
      (let [index (aget indices 0)
            item (aget items index)]
        (set! (.-workIndex runtime) index)
        (set! (.-model runtime)
              (select-thread (.-model runtime) (workitem-id item)))))))

(defn handle-list-click!
  [runtime: Any
   ui: Any
   event: Any] -> Any
  (when (identical? (.-button event) 0)
    (let [state (snapshot (.-model runtime))
          view (selected-view state (.-activeView runtime))]
      (when (identical? (workview-id view) "list")
        (let [items (workview-items view)
              rows (list-rows runtime items)
              row-index (Math/floor (- (.-y event) (.-screenY (.-workText ui))))]
          (when (and (>= row-index 0) (< row-index (.-length rows)))
            (let [row (aget rows row-index)]
              (.preventDefault event)
              (.stopPropagation event)
              (if (identical? (listrow-kind row) "header")
                (let [condition (listrow-condition row)
                      collapsed (.-collapsedListConditions runtime)]
                  (if (.has collapsed condition)
                    (.delete collapsed condition)
                    (.add collapsed condition))
                  (select-visible-list-fallback! runtime items))
                (let [index (listrow-index row)
                      item (aget items index)]
                  (set! (.-workIndex runtime) index)
                  (set! (.-model runtime)
                        (select-thread (.-model runtime) (workitem-id item)))))
              (.render runtime))))))))

(defn install-mouse!
  [runtime: Any
   ui: Any] -> Any
  (set! (.-onMouseDown (.-composer ui))
        (fn [event: Any] -> Any
          (when (identical? (.-button event) 0)
            (.stopPropagation event)
            (clear-strip-focus! runtime)
            (.focus (.-composerInput ui))
            (.render runtime))))
  (set! (.-onMouseDown (.-agentStripText ui))
        (fn [event: Any] -> Any
          (when (identical? (.-button event) 0)
            (.preventDefault event)
            (.stopPropagation event)
            (let [segments (strip-segments runtime)
                  column (Math/floor (- (.-x event)
                                        (.-screenX (.-agentStripText ui))))
                  index (segment-at-column segments column)]
              (when (>= index 0) (show-segment-detail! runtime index))
              (focus-strip! runtime ui)))))
  (set! (.-onMouseDown (.-composerPalette ui))
        (fn [event: Any] -> Any
          (complete-clicked-palette! runtime ui (text (.-frame runtime))
                                     (.-composerPalette ui) event)))
  (set! (.-onMouseDown (.-workText ui))
        (fn [event: Any] -> Any
          (handle-list-click! runtime ui event)))
  (set! (.-onMouseDown (.-viewTabsText ui))
        (fn [event: Any] -> Any
          (when (identical? (.-button event) 0)
            (let [tab (view-tab-at runtime (.-viewTabsText ui) event
                                   (view-list (snapshot (.-model runtime))))]
              (when (not (identical? tab ""))
                (.preventDefault event)
                (.stopPropagation event)
                (if (identical? tab "agents")
                  (show-frame! runtime ui "agents")
                  (if (identical? tab "threads")
                    (show-frame! runtime ui "threads")
                    (show-thread-view! runtime ui tab)))))))))

;; Climb one rung, whoever asked. The key and the four spellings of the command
;; share this, so "what does escape do here" has exactly one answer. Returns
;; whether anything was claimed, which is what tells the key handler to swallow
;; the keystroke and the command handler that it was a command.
(defn escape-step!
  [runtime: Any
   ui: Any
   from-key?: Bool] -> Bool
  (let [palette (active-palette-options runtime ui)
        action (escape-rung (> (.-length palette) 0)
                            (panel-filtering? runtime)
                            (detail-open? runtime)
                            (if (.-stripFocused runtime) true false)
                            (threads-frame? (.-frame runtime))
                            (if (.-working runtime) true false)
                            from-key?)]
    (cond
      (identical? action "close-palette")
      (do (set! (.-value (active-input runtime ui)) "")
          (render-minibuffer! runtime ui)
          true)

      (identical? action "clear-filter")
      (do (clear-panel-filter! runtime) (.render runtime) true)

      (identical? action "close-detail")
      ;; The keyboard goes back where it came from: the panel had it while it
      ;; was open, and the composer gets it the moment the panel is gone.
      (do (close-detail! runtime) (focus-composer! runtime ui) (.render runtime)
          true)

      (identical? action "focus-composer")
      (do (leave-strip! runtime ui) (.render runtime) true)

      (identical? action "show-agents")
      (do (show-frame! runtime ui "agents") true)

      (identical? action "cancel-turn")
      (let [target (text (.-supervisorId runtime))]
        (when (not (identical? target ""))
          (report-promise! runtime (cancel-turn! runtime ui target)))
        true)

      (identical? action "quit")
      (do (destroy! runtime) true)

      :else false)))

;; The panel tenants that are lists of rows, which is what there is to filter.
;; The agent roster is a list too, but it is reached through the strip, whose
;; keymap already spends the bare letters on navigation — it would be filtering
;; and steering with the same keystroke, so it keeps the keys it has.
(defn panel-filterable? [runtime: Any] -> Bool
  (or (detail-showing? runtime "config") (detail-showing? runtime "help")))

;; Pure: the one character this keystroke types into a query, or "" for
;; everything that is not a character — chords, function keys, the arrows the
;; panel already spends on its cursor. Space is deliberately absent: inside an
;; open panel it flips the selected row, and stealing it for the query would
;; take away the panel's own verb.
(js/export
 (defn filter-character
  [name: String
   sequence: String
   ctrl?: Bool
   meta?: Bool] -> String
  (if (or ctrl? meta?
          (identical? name "space")
          (not (identical? (.-length sequence) 1))
          (< (.charCodeAt sequence 0) 32))
    ""
    sequence)))

;; Pure: what a keystroke means to the filter. `/` opens it, a character types
;; into it, backspace edits it — and a backspace on an empty query is the way
;; out, the same "one more press and the thing you opened is gone" the ladder
;; spells with escape.
(js/export
 (defn filter-key-action
  [filtering?: Bool
   query: String
   name: String
   character: String] -> String
  (cond
    (and (not filtering?) (identical? character "/")) "open"
    (not filtering?) ""
    (identical? name "backspace")
    (if (identical? query "") "close" "erase")
    (not (identical? character "")) "type"
    :else "")))

(defn ctrl-down-key?
  [name: String
   key: Any] -> Bool
  (and (.-ctrl key) (identical? name "j")))

(defn bare-letter?
  [name: String
   key: Any
   letter: String] -> Bool
  (and (identical? name letter)
       (not (.-ctrl key))
       (not (or (.-meta key) (.-option key)))))

;; The arrows fold the tree, and so do h and l — the convention every tree in a
;; terminal already keeps. The letters stand down while a filter is up: there
;; they are two characters of a query, and a key cannot be both.
(defn fold-key?
  [runtime: Any
   name: String
   key: Any] -> Bool
  (or (identical? name "left")
      (identical? name "right")
      (and (not (panel-filtering? runtime))
           (or (bare-letter? name key "h") (bare-letter? name key "l")))))

;; Carry out one fold decision. Every key that folds — the arrows, h and l, tab —
;; decides with its own pure function and lands here, so the decisions stay
;; separable and the effect stays one thing.
(defn apply-fold-action!
  [runtime: Any
   rows: Any
   node: String
   action: String] -> Any
  (cond
    (identical? action "expand") (set-node-expanded! runtime node true)
    (identical? action "collapse") (set-node-expanded! runtime node false)
    (identical? action "climb")
    (let [at (.findIndex rows
                         (fn [row: Any] -> Bool
                           (and (identical? (configentry-kind row) "dir")
                                (identical? (configentry-name row) node))))]
      (when (>= at 0) (set! (.-configIndex runtime) at)))
    :else nil))

;; One press of a fold key, on whatever row the cursor is on. `l` opens the node
;; you are on; `h` shuts it, or climbs to the node when you are inside one, and
;; the cursor lands on the row you just folded so the next press has something
;; to act on.
(defn fold-step!
  [runtime: Any
   open-key?: Bool] -> Any
  (let [rows (config-panel-rows runtime)
        total (.-length rows)]
    (when (> total 0)
      (let [index (clamped-index (.-configIndex runtime) total)
            entry (aget rows index)
            dir? (identical? (configentry-kind entry) "dir")
            node (config-row-node entry)]
        (apply-fold-action!
         runtime rows node
         (fold-key-action dir?
                          (config-node-expanded? (panel-expanded runtime) node)
                          open-key?))))))

;; One press of tab inside the panel: the fold, toggled rather than split across
;; an open key and a shut one, because a key that has to be discoverable can
;; only carry one verb.
(js/export
 (defn tab-fold-step! [runtime: Any] -> Any
  (let [rows (config-panel-rows runtime)
        total (.-length rows)]
    (when (> total 0)
      (let [index (clamped-index (.-configIndex runtime) total)
            entry (aget rows index)
            dir? (identical? (configentry-kind entry) "dir")
            node (config-row-node entry)]
        (apply-fold-action!
         runtime rows node
         (tab-action "panel" dir?
                     (config-node-expanded? (panel-expanded runtime) node))))))))

(defn ctrl-up-key?
  [name: String
   key: Any] -> Bool
  (and (.-ctrl key) (identical? name "k")))

(defn bare-key?
  [name: String
   key: Any
   letter: String] -> Bool
  (and (identical? name letter)
       (not (.-ctrl key))
       (not (or (.-meta key) (.-option key)))))

;; Keys the strip claims once it holds focus. Everything else falls through to
;; the branches below, so nothing the strip does not name is stolen.
(defn strip-key?
  [name: String
   key: Any] -> Bool
  (or (identical? name "left")
      (identical? name "right")
      (identical? name "up")
      (identical? name "down")
      (submit-key? name)
      (ctrl-down-key? name key)
      (ctrl-up-key? name key)
      (bare-key? name key "h")
      (bare-key? name key "l")
      (bare-key? name key "j")
      (bare-key? name key "k")))

(defn install-keys!
  [runtime: Any
   ui: Any] -> Any
  (.on (.-keyInput (.-renderer runtime)) "keypress"
       (fn [key: Any] -> Any
         (when (and (not (.-defaultPrevented key))
                    (not (.-propagationStopped key)))
           (let [name (.toLowerCase (text (.-name key)))
                 meta (or (.-meta key) (.-option key))
                 palette (active-palette-options runtime ui)
                 palette-open (> (.-length palette) 0)
                 plain-view-arrow
                 (and (threads-frame? (.-frame runtime))
                      (identical? (.trim (text (.-value (.-composerInput ui)))) "")
                      (not (.-ctrl key))
                      (not meta)
                      (or (identical? name "left") (identical? name "right")))]
             (cond
             ;; Escape is the ladder and nothing else: one rung per press, and
             ;; whatever rung it lands on, no other branch below gets a say.
             (or (identical? name "escape") (identical? name "esc"))
             (when (escape-step! runtime ui true)
               (.preventDefault key)
               (.stopPropagation key))

             ;; The docked switchboard owns the arrows only while the composer
             ;; is quiet, and it owns them over the filtered rows: the cursor
             ;; walks what is on screen, never the rows a query hid.
             ;; ctrl-j is "down into the docked thing" wherever the cursor is.
             ;; With a panel open and unfocused — you pressed `@` and went back
             ;; to your sentence — it is how you climb back into it, which is
             ;; the same key that descends into the strip and one fewer verb to
             ;; learn.
             (and (detail-open? runtime)
                  (not (panel-focused? runtime))
                  (not palette-open)
                  (ctrl-down-key? name key))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (focus-panel! runtime ui)
                 (.render runtime))

             (and (detail-showing? runtime "config")
                  (panel-focused? runtime)
                  (not palette-open)
                  (or (identical? name "up") (identical? name "down")
                      (ctrl-up-key? name key) (ctrl-down-key? name key)
                      (identical? name "space") (submit-key? name)
                      ;; Tab is claimed here before the composer's view swap can
                      ;; see it: with the panel focused the keyboard is the
                      ;; panel's, and one key cannot mean two things at once.
                      (identical? name "tab")
                      (fold-key? runtime name key)))
             (let [up? (or (identical? name "up") (ctrl-up-key? name key))
                   down? (or (identical? name "down") (ctrl-down-key? name key))]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (or up? down?)
                 (let [total (.-length (config-panel-rows runtime))]
                   (when (> total 0)
                     (let [raw (.-configIndex runtime)
                           current (if raw raw 0)
                           delta (if up? -1 1)]
                       (set! (.-configIndex runtime)
                             (mod (+ current delta total) total)))))

                 (identical? name "tab") (tab-fold-step! runtime)

                 (fold-key? runtime name key)
                 (fold-step! runtime
                             (or (identical? name "right")
                                 (bare-key? name key "l")))

                 (identical? name "space")
                 (report-promise! runtime (toggle-config-entry! runtime))

                 :else
                 (report-promise! runtime (edit-config-entry! runtime)))
               (.render runtime))

             ;; `@` writes the selected row into the sentence you are about to
             ;; send, and hands the keyboard back so you can finish it. The
             ;; panel stays open behind the composer, dimmed, because you are
             ;; probably about to reference a second row.
             (and (detail-showing? runtime "config")
                  (panel-focused? runtime)
                  (not (panel-filtering? runtime))
                  (not palette-open)
                  (identical? (filter-character name (text (.-sequence key))
                                                (if (.-ctrl key) true false)
                                                (if meta true false))
                              "@"))
             (let [rows (config-panel-rows runtime)
                   total (.-length rows)]
               (.preventDefault key)
               (.stopPropagation key)
               (when (> total 0)
                 (let [entry (aget rows (clamped-index (.-configIndex runtime)
                                                       total))
                       input (active-input runtime ui)]
                   (set! (.-value input)
                         (str (text (.-value input))
                              (config-reference-text (configentry-kind entry)
                                                     (configentry-name entry))))
                   (focus-composer! runtime ui)
                   (render-minibuffer! runtime ui)))
               (.render runtime))

             ;; `/` inside an open panel starts a filter rather than a slash
             ;; command: the rows in front of you are what a slash means while
             ;; you are looking at them. Everything typed after it goes to the
             ;; query and never to the composer, so a filtered panel cannot
             ;; leave half a search sitting in the message you send next.
             (and (panel-filterable? runtime)
                  (panel-focused? runtime)
                  (not palette-open)
                  (not (identical?
                        (filter-key-action
                         (panel-filtering? runtime)
                         (panel-query runtime)
                         name
                         (filter-character name (text (.-sequence key))
                                           (if (.-ctrl key) true false)
                                           (if meta true false)))
                        "")))
             (let [character (filter-character name (text (.-sequence key))
                                               (if (.-ctrl key) true false)
                                               (if meta true false))
                   query (panel-query runtime)
                   action (filter-key-action (panel-filtering? runtime) query
                                             name character)]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (identical? action "open") (set-panel-query! runtime "")
                 (identical? action "type")
                 (set-panel-query! runtime (str query character))
                 (identical? action "erase")
                 (set-panel-query! runtime
                                   (.slice query 0 (- (.-length query) 1)))
                 :else (clear-panel-filter! runtime))
               (.render runtime))

             ;; A focused panel eats the rest of the alphabet. Outside filter
             ;; mode the letters mean nothing here, and letting them fall
             ;; through to the composer is exactly the split brain this focus
             ;; model exists to end: keys you press while looking at a list must
             ;; not silently accumulate in a message you are not writing.
             (and (panel-focused? runtime)
                  (not palette-open)
                  (not (identical? (filter-character name
                                                     (text (.-sequence key))
                                                     (if (.-ctrl key) true false)
                                                     (if meta true false))
                                   "")))
             (do (.preventDefault key)
                 (.stopPropagation key))

             (and (.-stripFocused runtime) (strip-key? name key))
             (let [expanded? (detail-showing? runtime "agents")
                   up? (or (identical? name "up")
                           (ctrl-up-key? name key)
                           (bare-key? name key "k"))
                   down? (or (identical? name "down")
                             (ctrl-down-key? name key)
                             (bare-key? name key "j"))
                   left? (or (identical? name "left") (bare-key? name key "h"))
                   right? (or (identical? name "right") (bare-key? name key "l"))]
               (.preventDefault key)
               (.stopPropagation key)
               (cond
                 (submit-key? name) (toggle-segment-detail! runtime)
                 left? (move-strip-segment! runtime -1)
                 right? (move-strip-segment! runtime 1)
                 up? (if expanded?
                       (move-detail-cursor! runtime -1)
                       (leave-strip! runtime ui))
                 down? (if expanded?
                         (move-detail-cursor! runtime 1)
                         (toggle-segment-detail! runtime))
                 :else nil)
               (.render runtime))

             (and palette-open
                  (or (identical? name "up")
                      (identical? name "down")
                      (and (.-ctrl key)
                           (or (identical? name "j") (identical? name "k")))))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (set! (.-paletteIndex runtime)
                       (mod (+ (.-paletteIndex runtime)
                               (if (or (identical? name "up")
                                       (and (.-ctrl key) (identical? name "k")))
                                 -1 1)
                               (.-length palette))
                            (.-length palette)))
                 (.focus (active-input runtime ui))
                 (render-minibuffer! runtime ui))

             ;; Tab always completes; that is all tab has ever meant here.
             (and palette-open (identical? name "tab"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (complete-palette! runtime ui palette))

             (and palette-open (submit-key? name))
             (let [candidate (palette-candidate runtime palette)
                   completed (palette-completion-text candidate)
                   current (text (.-value (active-input runtime ui)))
                   action (palette-enter-action (.-length palette)
                                                (slashcommand-arguments candidate)
                                                (slashcommand-emoji candidate)
                                                (identical? current completed))]
               (.preventDefault key)
               (.stopPropagation key)
               (if (identical? action "fire")
                 (submit-input! runtime ui (.trim completed))
                 (complete-palette! runtime ui palette)))

             ;; Down leaves the composer only when the composer has nothing to
             ;; move through: no palette open and an empty line. Ctrl-J is the
             ;; unconditional way in, so the strip is never unreachable.
             (and (not (.-stripFocused runtime))
                  (not palette-open)
                  (or (ctrl-down-key? name key)
                      (and (identical? name "down")
                           (not (.-ctrl key))
                           (not meta)
                           (identical? (.trim (text (.-value (.-composerInput ui)))) ""))))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (focus-strip! runtime ui))

             (or (identical? name "tab") (identical? name "f2"))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (show-frame! runtime ui (tab-swap-frame (text (.-frame runtime)))))

             (identical? name "f1")
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (toggle-help! runtime ui))

             (or (identical? name "f3")
                 plain-view-arrow
                 (and meta (or (identical? name "h") (identical? name "l"))))
             (let [state (snapshot (.-model runtime))
                   views (view-list state)
                   current (selected-view state (.-activeView runtime))
                   index (.findIndex views
                                     (fn [view: WorkView] -> Bool
                                       (identical? (workview-id view)
                                                   (workview-id current))))
                   delta (if (or (identical? name "left")
                                 (and meta (identical? name "h"))) -1 1)
                   next-index (mod (+ index delta (.-length views)) (.-length views))
                   next-id (text (.-id (aget views next-index)))]
               (.preventDefault key)
               (.stopPropagation key)
               ;; Same rule as /list: naming a thread view brings it on screen
               ;; rather than rearranging something you are not looking at.
               (show-thread-view! runtime ui next-id))

             (or (identical? name "f5") (and (.-ctrl key) (identical? name "r")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (report-promise! runtime (refresh! runtime)))

             (or (identical? name "f6") (and (.-ctrl key) (identical? name "o")))
             (do (.preventDefault key)
                 (.stopPropagation key)
                 (popout! runtime (.-activeView runtime)))

             (and meta (or (identical? name "j") (identical? name "k")))
             (let [state (snapshot (.-model runtime))
                   delta (if (identical? name "k") -1 1)]
               (.preventDefault key)
               (.stopPropagation key)
               (if (not (threads-frame? (.-frame runtime)))
                 (let [agents (bridgesnapshot-agents state)
                       max-index (Math/max 0 (- (.-length agents) 1))
                       next-index (Math/max 0 (Math/min max-index (+ (.-agentIndex runtime) delta)))
                       selected-agent-id (if (> (.-length agents) 0)
                                           (agent-id (aget agents next-index)) "")]
                   (set! (.-agentIndex runtime) next-index)
                   (set! (.-model runtime)
                         (select-agent (.-model runtime) selected-agent-id)))
                 (let [view (selected-view state (.-activeView runtime))
                       items (workview-items view)
                       max-index (Math/max 0 (- (.-length items) 1))
                       next-index (if (identical? (workview-id view) "list")
                                    (next-visible-list-index runtime items
                                                             (.-workIndex runtime) delta)
                                    (Math/max 0 (Math/min max-index
                                                         (+ (.-workIndex runtime) delta))))
                       thread-id (if (> (.-length items) 0)
                                   (workitem-id (aget items next-index)) "")]
                   (set! (.-workIndex runtime) next-index)
                   (set! (.-model runtime) (select-thread (.-model runtime) thread-id))
                   (.scrollBy (.-workScroll ui)
                              (* delta
                                 (cond
                                   (identical? (workview-id view) "board") 2
                                   (identical? (workview-id view) "graph") 3
                                   :else 1))
                              "step")))
               (.render runtime))

             ;; Ctrl-C means one thing and only one thing here: stop the turn in
             ;; flight. With nothing running it does nothing at all — it is
             ;; never a way out of Northbridge, /q is.
             (and (.-ctrl key) (identical? name "c"))
             (let [target (text (.-supervisorId runtime))]
               (.preventDefault key)
               (.stopPropagation key)
               (when (and (.-working runtime) (not (identical? target "")))
                 (report-promise! runtime (cancel-turn! runtime ui target))))

             :else nil))))))

(defn open-app!
  [view-id: String
   source-identity: String] -> (Promise Any)
  (let [view (canonical-work-view view-id)
        renderer (js/await (createCliRenderer {:exitOnCtrlC false :clearOnShutdown true}))
        runtime {:model (make-model view)
                 :renderer renderer
                 :disposed false
                 :frame BOOT-FRAME
                 :activeView view
                 :agentIndex 0
                 :workIndex 0
                 :collapsedListConditions (Set. ["blocked" "dormant" "draft"
                                                   "terminal" "other"])
                 :workScroll nil
                 :boardSignature ""
                 :dragThreadId ""
                 :bridgeExecutions (Set.)
                 :supervisorId ""
                 :conversation []
                 :itemSequence 0
                 :lastAssistantText ""
                 ;; The text a cancel hands back to the composer.
                 :lastSubmitted ""
                 :working false
                 :workingLabel ""
                 :workingSince 0
                 :spinnerIndex 0
                 :spinnerTimer nil
                 :stripFocused false
                 :stripIndex 0
                 :detailView ""
                 :detailSegment "all"
                 :detailIndex 0
                 :paletteIndex 0
                 :paletteStart 0
                 :paletteRows 0
                 :promptGlyph DEFAULT-PROMPT-GLYPH
                 :soundEnabled (sound-enabled-from-env
                                (text (.-NORTH_BRIDGE_SOUND (.-env process))))
                 :soundPack (sound-pack-from-env
                             (text (.-NORTH_BRIDGE_SOUND_PACK (.-env process))))
                 :soundDirectory (sound-directory-from-env
                                  (text (.-NORTH_BRIDGE_SOUND_DIR (.-env process))))
                 :soundPlayer (discover-sound-player)
                 :soundChildren (Set.)
                 :soundWarningShown false
                 :soundSequence 0
                 :lastSoundPath ""
                 :lastSoundAt 0
                 :workspaceNotice ""
                 :keymap nil
                 :sessionModel (text-or (.-NORTH_BRIDGE_MODEL (.-env process))
                                        (text (.-AGENT_MODEL (.-env process))))
                 :sessionEffort (text-or (.-AGENT_REASONING (.-env process))
                                         (text (.-AGENT_EFFORT (.-env process))))
                 :sessionCwd (text (.cwd process))
                 :sessionBranch ""
                 ;; Reported by the session, not guessed here: until it says,
                 ;; the banner says `pending` rather than a mode nobody set.
                 :sessionPermissions ""
                 :sourceIdentity source-identity
                 :renderConversation (fn [] -> Any nil)
                 :render (fn [] -> Any nil)}
        root (BoxRenderable. renderer
                             ;; Symmetric side margins, one row of headroom on
                             ;; top, and nothing below: the bottom stack is
                             ;; anchored flush to the terminal's last row.
                             {:flexDirection "column" :width "100%" :height "100%"
                              :gap 0 :paddingTop 1 :paddingBottom 0
                              :paddingLeft 1 :paddingRight 1
                              :onSizeChange (fn [] -> Any (.render runtime))})
        ;; One view at a time, so the workspace holds two full-width
        ;; containers and shows exactly one of them.
        workspace (BoxRenderable. renderer {:flexDirection "row" :width "100%"
                                             :flexGrow 1 :gap 0})
        view-tabs-text (TextRenderable. renderer {:height 1 :width "100%" :flexShrink 0
                                                    :wrapMode "none" :truncate true})
        agents-pane (BoxRenderable. renderer {:flexDirection "column" :width "100%"})
        work-pane (BoxRenderable. renderer {:flexDirection "column" :width "100%"})
        agents-text (TextRenderable. renderer {:height 4 :flexShrink 0 :wrapMode "word"})
        transcript-scroll (ScrollBoxRenderable. renderer {:flexGrow 1 :scrollY true
                                                           :stickyScroll true :stickyStart "bottom"
                                                           :viewportCulling true
                                                           :verticalScrollbarOptions {:visible false}})
        transcript-text-view (TextRenderable. renderer {:width "100%" :flexShrink 0 :wrapMode "word"})
        work-scroll (ScrollBoxRenderable. renderer {:flexGrow 1 :scrollY true :viewportCulling true
                                                     :verticalScrollbarOptions {:visible false}})
        work-text-view (TextRenderable. renderer {:width "100%" :flexShrink 0
                                                   :wrapMode "none" :truncate true})
        board-root (BoxRenderable. renderer {:visible false :width "100%"
                                             :flexDirection "column" :flexShrink 0 :gap 1})
        status-text (TextRenderable. renderer {:flexShrink 0 :wrapMode "word"})
        agent-status-text (TextRenderable. renderer {:visible false :flexShrink 0 :wrapMode "word"})
        composer-palette (TextRenderable. renderer {:visible false :height 1 :width "100%" :flexShrink 0
                                                     :wrapMode "none" :truncate true :bg "#25272d"})
        ;; One line high: the InputRenderable is always a single row, so the
        ;; box owes it exactly one and no vertical padding. The fill stays.
        composer (BoxRenderable. renderer {:flexDirection "row" :width "100%" :height 1
                                            :paddingLeft 1 :paddingRight 1
                                            :flexShrink 0 :backgroundColor "#25272d"})
        agent-strip-text (TextRenderable. renderer {:height 1 :width "100%" :flexShrink 0
                                                     :wrapMode "none" :truncate true})
        detail-panel (BoxRenderable. renderer {:visible false :width "100%" :height 5
                                               :flexDirection "column" :flexShrink 0
                                               :border true :borderColor "#64748b"
                                               :paddingLeft 1 :paddingRight 1})
        detail-text (TextRenderable. renderer {:width "100%" :flexGrow 1 :wrapMode "none"})
        composer-prompt (TextRenderable. renderer {:width 2 :height 1 :flexShrink 0 :wrapMode "none"
                                                   :content (StyledText. [(brightCyan "❯ ")])})
        composer-input (InputRenderable. renderer
                                         ;; No explicit width: a `100%` here
                                         ;; resolves against the composer's
                                         ;; content box and then sits *after*
                                         ;; the prompt, spilling the input's
                                         ;; fill past the right margin. Grow
                                         ;; from zero into what's left instead.
                                         {:flexGrow 1 :flexShrink 1 :flexBasis 0 :minWidth 0
                                          :backgroundColor "#25272d" :focusedBackgroundColor "#25272d"
                                          :textColor "#e5e7eb" :focusedTextColor "#f8fafc"
                                          :placeholderColor "#6b7280"
                                          :placeholder (composer-hint "agents" (main-agent-label))})
        ui {:root root :agentsPane agents-pane :workPane work-pane
            :viewTabsText view-tabs-text
            :agentsText agents-text :transcriptText transcript-text-view
            :workScroll work-scroll
            :workText work-text-view :boardRoot board-root
            :statusText status-text :agentStatusText agent-status-text
            :composerPalette composer-palette :composer composer
            :composerPrompt composer-prompt :composerInput composer-input
            :agentStripText agent-strip-text
            :detailPanel detail-panel :detailText detail-text}]
    (.add agents-pane agents-text)
    (.add transcript-scroll transcript-text-view)
    (.add agents-pane transcript-scroll)
    (.add agents-pane agent-status-text)
    (.add work-scroll work-text-view)
    (.add work-scroll board-root)
    (.add work-pane work-scroll)
    (.add work-pane status-text)
    (.add composer composer-prompt)
    (.add composer composer-input)
    (.add workspace agents-pane)
    (.add workspace work-pane)
    ;; Everything above is content; everything below the workspace is the
    ;; bottom cluster, in reading order: composer, the view bar it switches,
    ;; the agent strip, then the docked panel growing upward off the last row.
    (.add root workspace)
    (.add root composer-palette)
    (.add root composer)
    (.add root view-tabs-text)
    (.add root agent-strip-text)
    (.add detail-panel detail-text)
    (.add root detail-panel)
    (.add (.-root renderer) root)
    (set! (.-visible (.-verticalScrollBar transcript-scroll)) false)
    (set! (.-visible (.-horizontalScrollBar transcript-scroll)) false)
    (set! (.-visible (.-verticalScrollBar work-scroll)) false)
    (set! (.-visible (.-horizontalScrollBar work-scroll)) false)
    (set! (.-workScroll runtime) work-scroll)
    (set! (.-renderConversation runtime)
          (fn [] -> Any
            (set! (.-content transcript-text-view) (render-conversation! runtime))))
    (set! (.-render runtime) (fn [] -> Any (render-ui! runtime ui)))
    (install-input! runtime ui)
    (install-mouse! runtime ui)
    (install-composer-keymap! runtime)
    (install-process-cleanup! runtime)
    (install-global-exit! runtime)
    (install-keys! runtime ui)
    (.render runtime)
    (.focus composer-input)
    (report-promise! runtime (discover-session-branch! runtime))
    (report-promise! runtime (refresh! runtime))
    (report-promise! runtime (launch-agent! runtime SUPERVISOR-BOOT-PROMPT "supervisor"))
    runtime))

(js/export
 (defn run-northbridge-app! [options: Any] -> (Promise Any)
   (open-app! (text-or (.-viewId options) "list")
              (text (.-sourceIdentity options)))))
