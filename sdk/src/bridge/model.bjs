#lang beagle/js

(ns north.bridge.model)

;; Execution sessions remain Bridge runtime state. Product catalog rows are
;; separate tracked identities read from one canonical Store snapshot; a live
;; session never becomes a semantic Agent merely by appearing in the roster.
(js/export
 (defrecord Agent
   [id String
    name String
    status String
    task String
    provider String
    provider-target String
    provider-label String
    model String
    model-display String
    effort String
    orchestration-provenance String
    goal String
    state String]))

;; Retained as the execution-view row used by transcript and launch mechanics.
;; Tracked-thing product views use TrackedThing below.
(js/export
 (defrecord WorkItem
   [id String
    title String
    body String
    condition String
    driver String
    dependencies (Vec String)]))

(js/export
 (defrecord TrackedThing
   [id String
    title String
    desired-outcome (U String Nil)
    agent Bool
    plan Bool
    project Bool
    task Bool
    assignee (U String Nil)
    assignee-title (U String Nil)
    status (U String Nil)]))

(defrecord BridgeModel
  [agents (Vec Agent)
   list (Vec WorkItem)
   board (Vec WorkItem)
   tracked-things (Vec TrackedThing)
   store-space String
   store-version Int
   layout String
   active-view-id String
   selected-agent String
   selected-tracked-thing String
   filter-text String
   notice String])

(js/export
 (defrecord BridgeSnapshot
   [agents (Vec Agent)
    list (Vec WorkItem)
    board (Vec WorkItem)
    tracked-things (Vec TrackedThing)
    semantic-agents (Vec TrackedThing)
    goals (Vec TrackedThing)
    all (Vec TrackedThing)
    store-space String
    store-version Int
    layout String
    active-view-id String
    selected-agent String
    selected-tracked-thing String
    notice String]))

(def TOP-LEVEL-VIEWS (Vec String) ["agents" "goals" "all"])

(defn canonical-view [view-id String] String
  (if (.includes TOP-LEVEL-VIEWS view-id) view-id "agents"))

(js/export
 (defn make-model [view-id String] BridgeModel
  (let [view String (canonical-view view-id)]
    (->BridgeModel [] [] [] [] "" 0 "vertical" view "" "" "" ""))))

;; Execution-focused tests and runtime events still replace their own
;; projection without changing the canonical semantic catalog.
(js/export
 (defn replace-projection
   [model BridgeModel
    agents (Vec Agent)
    list-items (Vec WorkItem)
    board-items (Vec WorkItem)] BridgeModel
   (with model
    [:agents agents]
    [:list list-items]
    [:board board-items])))

(js/export
 (defn replace-catalog
   [model BridgeModel
    tracked-things (Vec TrackedThing)
    store-space String
    store-version Int] BridgeModel
   (with model
    [:tracked-things tracked-things]
    [:store-space store-space]
    [:store-version store-version])))

(js/export
 (defn upsert-agent
   [model BridgeModel
    agent Agent] BridgeModel
   (let [agents Any (.filter (bridgemodel-agents model)
                        (fn [existing Agent] Bool
                          (not (identical? (agent-id existing) (agent-id agent)))))]
    (with model [:agents (.concat agents agent)]))))

;; A session replaced by the execution host is absent rather than retained as
;; a stale roster row.
(js/export
 (defn remove-agent
   [model BridgeModel
    removed-id String] BridgeModel
   (with model
    [:agents (.filter (bridgemodel-agents model)
                      (fn [existing Agent] Bool
                        (not (identical? (agent-id existing) removed-id))))])))

(js/export
 (defn focus-view
   [model BridgeModel
    view-id String] BridgeModel
   (let [view String (canonical-view view-id)]
    (with model
      [:active-view-id view]
      [:notice (str "view " view)]))))

(defn set-layout
  [model BridgeModel
   layout String] BridgeModel
  (with model
    [:layout (if (identical? layout "horizontal") "horizontal" "vertical")]))

(js/export
 (defn select-agent
   [model BridgeModel
    agent-id String] BridgeModel
   (with model
    [:selected-agent agent-id]
    [:notice ""])))

(js/export
 (defn select-tracked-thing
   [model BridgeModel
    tracked-thing-id String] BridgeModel
   (with model
    [:selected-tracked-thing tracked-thing-id]
    [:notice (if (identical? tracked-thing-id "")
               "no tracked thing selected"
               (str "selected " tracked-thing-id))])))

(js/export
 (defn set-filter
   [model BridgeModel
    filter-text String] BridgeModel
   (let [trimmed String (.trim filter-text)]
    (with model
      [:filter-text (.toLowerCase trimmed)]
      [:notice (if (identical? trimmed "")
                 "filter cleared"
                 (str "filter: " filter-text))]))))

(defn visible-work
  [model BridgeModel
   source (Vec WorkItem)] (Vec WorkItem)
  (let [needle String (bridgemodel-filter-text model)]
    (.filter source
             (fn [item WorkItem] Bool
               (or (identical? needle "")
                   (.includes
                    (.toLowerCase
                     (str (workitem-id item) " "
                          (workitem-title item) " "
                          (workitem-body item) " "
                          (workitem-condition item) " "
                          (workitem-driver item)))
                    needle))))))

(defn optional-search-text [value (U String Nil)] String
  (if value value ""))

(defn tracked-thing-search-text [item TrackedThing] String
  (str (trackedthing-id item) " "
       (trackedthing-title item) " "
       (optional-search-text (trackedthing-desired-outcome item)) " "
       (optional-search-text (trackedthing-assignee item)) " "
       (optional-search-text (trackedthing-assignee-title item)) " "
       (optional-search-text (trackedthing-status item))))

(defn visible-tracked-things
  [model BridgeModel
   source (Vec TrackedThing)] (Vec TrackedThing)
  (let [needle String (bridgemodel-filter-text model)]
    (.filter source
             (fn [item TrackedThing] Bool
               (or (identical? needle "")
                   (.includes (.toLowerCase (tracked-thing-search-text item))
                              needle))))))

(defn semantic-agent? [item TrackedThing] Bool
  (trackedthing-agent item))

(defn semantic-goal? [item TrackedThing] Bool
  (let [outcome (U String Nil) (trackedthing-desired-outcome item)]
    (if outcome true false)))

(js/export
 (defn snapshot [model BridgeModel] BridgeSnapshot
  (let [tracked-things (Vec TrackedThing) (bridgemodel-tracked-things model)
        visible (Vec TrackedThing) (visible-tracked-things model tracked-things)
        semantic-agents (Vec TrackedThing) (.filter visible semantic-agent?)
        goals (Vec TrackedThing) (.filter visible semantic-goal?)]
    (->BridgeSnapshot
     (bridgemodel-agents model)
     (visible-work model (bridgemodel-list model))
     (visible-work model (bridgemodel-board model))
     tracked-things
     semantic-agents
     goals
     visible
     (bridgemodel-store-space model)
     (bridgemodel-store-version model)
     (bridgemodel-layout model)
     (bridgemodel-active-view-id model)
     (bridgemodel-selected-agent model)
     (bridgemodel-selected-tracked-thing model)
     (bridgemodel-notice model)))))
