#lang beagle/js

(ns north.sdk.routing-economics)

;; Assessment, pin, catalog, and environment payloads cross one foreign
;; boundary. Each is decoded once; routing economics uses canonical objects.

(declare-extern [process Object Array JSON Number String Set Date] JsObject)
(declare-extern Error (Fn [String] JsObject))
(declare-extern undefined JsObject)

(def node-module JsObject (.getBuiltinModule process "node:module"))
(def create-require (Fn [String] (Fn [String] JsObject))
  (: (.-createRequire node-module) (Fn [String] (Fn [String] JsObject))))
(def require-module (Fn [String] JsObject)
  (create-require (.-url (js/import-meta))))

(def path-module JsObject (.getBuiltinModule process "node:path"))
(def fs-module JsObject (.getBuiltinModule process "node:fs"))
(def crypto-module JsObject (.getBuiltinModule process "node:crypto"))
(def child-process-module JsObject
  (.getBuiltinModule process "node:child_process"))
(def resolve-path (Fn [String & String] String)
  (: (.-resolve path-module) (Fn [String & String] String)))
(def read-file-text (Fn [String String] String)
  (: (.-readFileSync fs-module) (Fn [String String] String)))
(def read-file-bytes (Fn [String] JsObject)
  (: (.-readFileSync fs-module) (Fn [String] JsObject)))
(def create-hash (Fn [String] JsObject)
  (: (.-createHash crypto-module) (Fn [String] JsObject)))
(def spawn-sync (Fn [String (Vec String) JsObject] JsObject)
  (: (.-spawnSync child-process-module)
     (Fn [String (Vec String) JsObject] JsObject)))

(def orchestration-staffing-module JsObject
  (require-module "./orchestration-staffing"))
(def DEFAULT-ORCHESTRATION-STAFFING-PATH String
  (.-DEFAULT_ORCHESTRATION_STAFFING_PATH orchestration-staffing-module))
(def resource-policy-module JsObject (require-module "./resource-policy"))
(def DEFAULT-ROUTING-POLICY-PATH String
  (.-DEFAULT_ROUTING_POLICY_PATH resource-policy-module))
(def orchestration-graph-source-module JsObject
  (require-module "./orchestration-graph-source"))
(def staffing-source (Fn [] String)
  (.-staffingSource orchestration-graph-source-module))
(def catalog-graph-pin-for-admission (Fn [] JsObject)
  (.-catalogGraphPinForAdmission orchestration-graph-source-module))
(def orchestration-policy-pin-module JsObject
  (require-module "./orchestration-policy-pin"))
(def verify-policy-digest-pin (Fn [Any String] String)
  (.-verifyPolicyDigestPin orchestration-policy-pin-module))

(defalias ForeignValue (U JsObject JsArray String Number Bool Nil))
(defalias RoutingAssessmentPolicyVersion String)
(defalias RoutingPinPolicyVersion String)
(defalias RoutingExceptionCode String)
(defalias RoutingPinKind String)
(defalias RoutingPinReasonCode String)
(defalias DecisionOwnership String)
(defalias SeamScope String)
(defalias ErrorExposure String)
(defalias OracleStrength String)
(defalias FoundationalImpact String)
(defalias DependencyShape String)
(defalias ReasoningShape String)
(defalias CapabilityFloor String)
(defalias ServiceClass String)
(defalias ReasoningLevel String)
(defalias RoutingOverrideField String)

(js/declare-type RoutingAssessmentPolicyVersion
  (js/literal "minimum-sufficient-v2"))
(js/declare-type RoutingPinPolicyVersion
  (js/literal "north-routing-pin-v1"))
(js/declare-type RoutingExceptionCode
  (js/enum "explicit-human-floor" "recent-lower-capability-failure"
           "calibration-experiment" "unmodeled-risk"))
(js/declare-type RoutingPinKind (js/enum "provider" "account" "model"))
(js/declare-type RoutingPinReasonCode
  (js/enum "explicit-human-request" "provider-recovery"
           "capability-requirement" "calibration-experiment"))
(js/declare-type DecisionOwnership
  (js/enum "none" "bounded" "cross-boundary" "system-shaping"
           "open-solution-class"))
(js/declare-type SeamScope
  (js/enum "none" "established" "consequential" "system-wide"))
(js/declare-type ErrorExposure
  (js/enum "contained-reversible" "material-recoverable"
           "high-or-hard-to-reverse"))
(js/declare-type OracleStrength
  (js/enum "not-applicable" "objective-local" "objective-end-to-end"
           "partial" "judgment-only"))
(js/declare-type FoundationalImpact
  (js/enum "none" "implementation-only" "invariant-decision-owned"))
(js/declare-type DependencyShape
  (js/enum "atomic-cohesive" "deterministic-workflow" "parallel-breadth"
           "dynamic-decomposition" "tightly-coupled-sequential"))
(js/declare-type ReasoningShape
  (js/enum "deterministic" "bounded-branching" "multi-hypothesis"
           "system-synthesis" "exceptional"))
(js/declare-type CapabilityFloor
  (js/enum "baseline" "standard" "advanced" "frontier"))
(js/declare-type ServiceClass
  (js/enum "economy" "fast" "balanced" "premium"))
(js/declare-type ReasoningLevel
  (js/enum "low" "medium" "high" "xhigh" "max"))
(js/declare-type RoutingOverrideField
  (js/enum "taskGrade" "domainRequirements" "capabilityFloor"
           "serviceClass" "reasoning" "posture"))
(js/declare-record RoutingTemplateComposition
  [kind (js/literal "template") id String
   overrides (Vec RoutingOverrideField)
   overrideReason (js/optional String)])
(js/declare-record RoutingBespokeComposition
  [kind (js/literal "bespoke") id String])
(js/declare-type RoutingComposition
  (U RoutingTemplateComposition RoutingBespokeComposition))
(js/declare-record RoutingRequest
  [role String taskGrade String domainRequirements (Vec String)
   topology String capabilityFloor CapabilityFloor serviceClass ServiceClass
   reasoning ReasoningLevel posture String composition RoutingComposition])

(js/declare-record RoutingAssessmentSignals
  [decisionOwnership DecisionOwnership
   seamScope SeamScope
   errorExposure ErrorExposure
   oracleStrength OracleStrength
   foundationalImpact FoundationalImpact
   dependencyShape DependencyShape
   reasoningShape ReasoningShape])
(js/declare-record RoutingAssessmentDerived
  [minimumCapabilityFloor CapabilityFloor
   minimumReasoning ReasoningLevel
   ruleCodes (Vec String)])
(js/declare-record RoutingAssessmentSelected
  [capabilityFloor CapabilityFloor reasoning ReasoningLevel])
(js/declare-record RoutingAssessmentException
  [code RoutingExceptionCode detail String])
(js/declare-record RoutingAssessment
  [$schema (js/optional String)
   version RoutingAssessmentPolicyVersion
   signals RoutingAssessmentSignals
   derived RoutingAssessmentDerived
   selected RoutingAssessmentSelected
   exception (js/optional RoutingAssessmentException)
   exceptionalDeliberation (js/optional String)])
(js/declare-record RoutingPin [kind RoutingPinKind value String])
(js/declare-record RoutingPinEvidence
  [policyVersion RoutingPinPolicyVersion
   issuedAt String expiresAt String
   reasonCode RoutingPinReasonCode detail String pins (Vec RoutingPin)])
(js/declare-record RoutingReceiptAxes
  [taskGrade String topology String
   capabilityFloor CapabilityFloor
   serviceClass ServiceClass
   reasoning String posture String])
(js/declare-record RoutingOverrideEvidence
  [changedAxes (Vec RoutingOverrideField)
   status String exceptionCode (js/optional RoutingExceptionCode)])
(js/declare-record RoutingAdmissionReceipt
  [version Number
   routingRequestSha256 String
   routingAssessmentSha256 (js/optional String)
   pinEvidenceSha256 (js/optional String)
   staffingCatalogSha256 (js/optional String)
   providerCatalogsSha256 (js/optional String)
   routingPolicySha256 String
   stockAxes (js/optional RoutingReceiptAxes)
   appliedAxes RoutingReceiptAxes
   overrideEvidence RoutingOverrideEvidence
   pinEvidenceStatus String
   orchestrationPolicyPinSha256 (js/optional String)
   orchestrationCatalogDigestSha256 (js/optional String)
   orchestrationCatalogVersion (js/optional Number)
   orchestrationCatalogTxVersion (js/optional Number)])
(js/declare-record AdmittedRoutingEconomics
  [assessment (js/optional RoutingAssessment)
   pinEvidence (js/optional RoutingPinEvidence)
   receipt RoutingAdmissionReceipt])
(js/declare-record RoutingEconomicsArgs
  [request RoutingRequest
   routingAssessment (js/optional ForeignValue)
   pinEvidence (js/optional ForeignValue)
   provider (js/optional String)
   target (js/optional String)
   model (js/optional String)
   now (js/optional JsDate)
   surface (js/optional String)])

(js/export
  (def ROUTING_ASSESSMENT_POLICY_VERSION RoutingAssessmentPolicyVersion
    "minimum-sufficient-v2"))
(js/export
  (def ROUTING_PIN_POLICY_VERSION RoutingPinPolicyVersion
    "north-routing-pin-v1"))
(js/export (def MAX_PIN_LIFETIME_MS Int 86400000))

(def AGENT-MACHINERY String
  (resolve-path (.-dir (js/import-meta)) "../.." "agent-machinery"))

(def SIGNAL-KEYS (Vec String)
  ["decisionOwnership" "seamScope" "errorExposure" "oracleStrength"
   "foundationalImpact" "dependencyShape" "reasoningShape"])
(def SIGNAL-VALUES JsObject
  #js {:decisionOwnership
       ["none" "bounded" "cross-boundary" "system-shaping"
        "open-solution-class"]
       :seamScope ["none" "established" "consequential" "system-wide"]
       :errorExposure
       ["contained-reversible" "material-recoverable"
        "high-or-hard-to-reverse"]
       :oracleStrength
       ["not-applicable" "objective-local" "objective-end-to-end" "partial"
        "judgment-only"]
       :foundationalImpact
       ["none" "implementation-only" "invariant-decision-owned"]
       :dependencyShape
       ["atomic-cohesive" "deterministic-workflow" "parallel-breadth"
        "dynamic-decomposition" "tightly-coupled-sequential"]
       :reasoningShape
       ["deterministic" "bounded-branching" "multi-hypothesis"
        "system-synthesis" "exceptional"]})

(def ASSESSMENT-FIELDS (Vec String)
  ["$schema" "version" "signals" "derived" "selected" "exception"
   "exceptionalDeliberation"])
(def DERIVED-FIELDS (Vec String)
  ["minimumCapabilityFloor" "minimumReasoning" "ruleCodes"])
(def SELECTED-FIELDS (Vec String) ["capabilityFloor" "reasoning"])
(def EXCEPTION-FIELDS (Vec String) ["code" "detail"])
(def PIN-FIELDS (Vec String)
  ["policyVersion" "issuedAt" "expiresAt" "reasonCode" "detail" "pins"])
(def PIN-ITEM-FIELDS (Vec String) ["kind" "value"])
(def CAPABILITY-FLOORS (Vec String)
  ["baseline" "standard" "advanced" "frontier"])
(def SERVICE-CLASSES (Vec String) ["economy" "fast" "balanced" "premium"])
(def REASONING-LEVELS (Vec String) ["low" "medium" "high" "xhigh" "max"])
(def EXCEPTION-CODES (Vec String)
  ["explicit-human-floor" "recent-lower-capability-failure"
   "calibration-experiment" "unmodeled-risk"])
(def PIN-REASON-CODES (Vec String)
  ["explicit-human-request" "provider-recovery" "capability-requirement"
   "calibration-experiment"])
(def PIN-KINDS (Vec String) ["provider" "account" "model"])

(defn error! [message String] Nil (throw (new Error message)))

(defn as-object [value ForeignValue] JsObject
  (: (aget (js-obj "value" value) "value") JsObject))
(defn as-array [value ForeignValue] JsArray
  (: (aget (js-obj "value" value) "value") JsArray))
(defn as-string [value ForeignValue] String
  (: (aget (js-obj "value" value) "value") String))

(defn foreign-object!
  [value ForeignValue
   label String] JsObject
  (when (or (nil? value)
            (not (identical? (js/typeof value) "object"))
            (Array/isArray value))
    (error! (str label " must be an object")))
  (as-object value))

(defn exact-fields!
  [value JsObject
   expected (Vec String)
   label String] Nil
  (let [unknown (Vec String) (.filter (Object/keys value)
          (fn [field String] Bool (not (.includes expected field))))]
    (when (not (zero? (count unknown)))
      (error! (str label " has unknown field(s): " (.join unknown ", "))))
    nil))

(defn required-string!
  [value ForeignValue
   label String] String
  (when (or (not (identical? (js/typeof value) "string"))
            (identical? (.trim (as-string value)) ""))
    (error! (str label " must be a non-empty string")))
  (.trim (as-string value)))

(defn enum-value!
  [value ForeignValue
   allowed (Vec String)
   label String] String
  (when (or (not (identical? (js/typeof value) "string"))
            (not (.includes allowed (as-string value))))
    (error! (str label " has an unsupported value")))
  (as-string value))

(defn unique-strings!
  [value ForeignValue
   label String] (Vec String)
  (when (or (not (Array/isArray value))
            (zero? (.-length (as-array value))))
    (error! (str label " must be a non-empty array")))
  (let [raw JsArray (as-array value)
        normalized (Vec String) (for [index (range (alength raw))]
          (required-string! (: (aget raw index) ForeignValue)
                            (str label "[" index "]")))]
    (when (not (identical? (.-size (new Set normalized)) (count normalized)))
      (error! (str label " must not contain duplicates")))
    normalized))

(defn iso-instant!
  [value ForeignValue
   label String] JsObject
  (let [source String (required-string! value label)
        time Number (Date/parse source)]
    (when (or (not (Number/isFinite time)) (not (.includes source "T")))
      (error! (str label " must be an ISO instant")))
    #js {:source (.toISOString (new Date time)) :time time}))

(defn deep-freeze [value JsObject] JsObject
  (when (and value (identical? (js/typeof value) "object")
             (not (Object/isFrozen value)))
    (doseq [child (Object/values value)] (deep-freeze child))
    (Object/freeze value))
  value)

(defn canonical [value Any] Any
  (cond
    (Array/isArray value)
    (.map (: value JsArray) (fn [child Any] Any (canonical child)))

    (and value (identical? (js/typeof value) "object"))
    (let [entries JsArray (.sort (Object/entries value)
            (fn
              [left JsArray
               right JsArray] Number
              (.localeCompare (: (aget left 0) String)
                              (: (aget right 0) String))))]
      (Object/fromEntries
        (.map entries
          (fn [entry JsArray] JsArray
            (into-array
              [(: (aget entry 0) String) (canonical (aget entry 1))])))))

    :else value))

(defn canonical-json-value [value Any] String
  (JSON/stringify (canonical value)))

(js/export
  (def canonicalJson (Fn [ForeignValue] String)
    (fn [value ForeignValue] String (canonical-json-value value))))
(js/declare-export canonicalJson (Fn [ForeignValue] String))

(defn digest [value Any] String
  (.digest (.update (create-hash "sha256") (canonical-json-value value)) "hex"))

(defn file-digest [path String] String
  (try
    (.digest (.update (create-hash "sha256") (read-file-bytes path)) "hex")
    (catch Error _error "unavailable")))

(defn admitted-signals!
  [raw JsObject
   surface String] JsObject
  (exact-fields! raw SIGNAL-KEYS (str surface ".signals"))
  (let [signals JsObject (js-obj)]
    (doseq [key String SIGNAL-KEYS]
      (aset signals key
        (enum-value! (: (aget raw key) ForeignValue)
                     (: (aget SIGNAL-VALUES key) (Vec String))
                     (str surface ".signals." key))))
    signals))

(defn admit-routing-assessment!
  ([value ForeignValue
    request JsObject] (U JsObject Nil)
    (admit-routing-assessment! value request
     "managed North routing assessment"))
  ([value ForeignValue
    request JsObject
    surface String] (U JsObject Nil)
    (if (identical? value undefined)
     nil
     (let [raw JsObject (foreign-object! value surface)]
       (exact-fields! raw ASSESSMENT-FIELDS surface)
       (when (not (identical? (aget raw "version")
                             ROUTING_ASSESSMENT_POLICY_VERSION))
         (error! (str surface ".version must be "
                      ROUTING_ASSESSMENT_POLICY_VERSION)))
       (let [schema (U String Nil) (if (identical? (aget raw "$schema") undefined)
               nil
               (required-string! (: (aget raw "$schema") ForeignValue)
                                 (str surface ".$schema")))
             signals JsObject (admitted-signals!
               (foreign-object! (: (aget raw "signals") ForeignValue)
                                (str surface ".signals")) surface)
             raw-derived JsObject (foreign-object! (: (aget raw "derived") ForeignValue)
                              (str surface ".derived"))
             _derived-fields Nil (exact-fields! raw-derived DERIVED-FIELDS (str surface ".derived"))
             derived JsObject #js {:minimumCapabilityFloor
                  (enum-value!
                    (: (aget raw-derived "minimumCapabilityFloor") ForeignValue)
                    CAPABILITY-FLOORS
                    (str surface ".derived.minimumCapabilityFloor"))
                  :minimumReasoning
                  (enum-value!
                    (: (aget raw-derived "minimumReasoning") ForeignValue)
                    REASONING-LEVELS
                    (str surface ".derived.minimumReasoning"))
                  :ruleCodes
                  (unique-strings! (: (aget raw-derived "ruleCodes") ForeignValue)
                                   (str surface ".derived.ruleCodes"))}
             raw-selected JsObject (foreign-object! (: (aget raw "selected") ForeignValue)
                              (str surface ".selected"))
             _selected-fields Nil (exact-fields! raw-selected SELECTED-FIELDS
                            (str surface ".selected"))
             selected JsObject #js {:capabilityFloor
                  (enum-value!
                    (: (aget raw-selected "capabilityFloor") ForeignValue)
                    CAPABILITY-FLOORS
                    (str surface ".selected.capabilityFloor"))
                  :reasoning
                  (enum-value!
                    (: (aget raw-selected "reasoning") ForeignValue)
                    REASONING-LEVELS
                    (str surface ".selected.reasoning"))}]
         (when (or (not (identical? (.-capabilityFloor selected)
                                    (.-capabilityFloor request)))
                   (not (identical? (.-reasoning selected)
                                    (.-reasoning request))))
           (error! (str surface
             ".selected must equal the admitted RoutingRequest capabilityFloor/reasoning")))
         (let [changed Bool (or (not (identical? (.-capabilityFloor selected)
                                    (.-minimumCapabilityFloor derived)))
                   (not (identical? (.-reasoning selected)
                                    (.-minimumReasoning derived))))
               exception (U JsObject Nil) (if (identical? (aget raw "exception") undefined)
                 nil
                 (let [candidate JsObject (foreign-object! (: (aget raw "exception") ForeignValue)
                                        (str surface ".exception"))]
                   (exact-fields! candidate EXCEPTION-FIELDS
                                  (str surface ".exception"))
                   #js {:code
                        (enum-value! (: (aget candidate "code") ForeignValue)
                                     EXCEPTION-CODES
                                     (str surface ".exception.code"))
                        :detail
                        (required-string!
                          (: (aget candidate "detail") ForeignValue)
                          (str surface ".exception.detail"))}))]
           (when (not (identical? changed (not (nil? exception))))
             (error! (str surface
               ".exception is required exactly when selected differs from derived")))
           (let [maximum Bool (or (identical? (.-minimumReasoning derived) "max")
                     (identical? (.-reasoning selected) "max"))
                 exceptional-deliberation (U String Nil) (if (identical? (aget raw "exceptionalDeliberation") undefined)
                   nil
                   (required-string!
                     (: (aget raw "exceptionalDeliberation") ForeignValue)
                     (str surface ".exceptionalDeliberation")))]
             (when (not (identical? maximum
                                    (not (nil? exceptional-deliberation))))
               (error! (str surface
                 ".exceptionalDeliberation is required exactly when derived or selected reasoning is max")))
             (let [admitted JsObject #js {:version ROUTING_ASSESSMENT_POLICY_VERSION
                        :signals signals :derived derived :selected selected}]
               (when schema (aset admitted "$schema" schema))
               (when exception (aset admitted "exception" exception))
               (when exceptional-deliberation
                 (aset admitted "exceptionalDeliberation"
                       exceptional-deliberation))
               (let [env JsObject (.-env process)
                     validator String (or (.-ORCHESTRATION_SELECTION_ASSESSMENT_MODULE env)
                         (resolve-path AGENT-MACHINERY
                           "scripts/selection-assessment.mjs"))
                     validation JsObject (spawn-sync (.-execPath process)
                       ["--eval"
                        "import {pathToFileURL} from 'node:url';const m=await import(pathToFileURL(process.argv[1]).href);let s='';for await(const c of process.stdin)s+=c;process.stdout.write(JSON.stringify(m.validateSelectionAssessment(JSON.parse(s))));"
                        validator]
                       #js {:input (JSON/stringify admitted)
                            :encoding "utf8" :timeout 5000})]
                 (when (or (.-error validation)
                           (not (identical? (.-status validation) 0)))
                   (let [stderr String (if (identical? (js/typeof (.-stderr validation)) "string")
                           (.trim (.-stderr validation)) "")
                         error-message String (if (and (.-error validation)
                                  (.-message (.-error validation)))
                           (.-message (.-error validation)) "")]
                     (error! (str surface
                       " failed canonical Orchestration validation: "
                       (or stderr error-message "canonical validator failed")))))
                 (let [canonical-assessment JsObject (try
                         (JSON/parse (.-stdout validation))
                         (catch Error _error
                           (error! (str surface
                             " canonical Orchestration validator returned invalid JSON"))
                           (js-obj)))]
                   (when (not (identical?
                                (canonical-json-value canonical-assessment)
                                (canonical-json-value admitted)))
                     (error! (str surface
                       " canonical Orchestration validator changed the admitted assessment")))
                   (deep-freeze admitted)))))))))))

(js/export
  (def admitRoutingAssessment
    (U (Fn [ForeignValue JsObject] (U JsObject Nil))
       (Fn [ForeignValue JsObject String] (U JsObject Nil)))
    admit-routing-assessment!))
(js/declare-export admitRoutingAssessment
  (U (Fn [ForeignValue RoutingRequest] (js/optional RoutingAssessment))
     (Fn [ForeignValue RoutingRequest String]
         (js/optional RoutingAssessment))))

(defn admit-routing-pin-evidence!
  ([value ForeignValue
    pins JsObject] (U JsObject Nil)
    (admit-routing-pin-evidence! value pins (new Date)
     "managed North routing pin evidence"))
  ([value ForeignValue
    pins JsObject
    now JsDate] (U JsObject Nil)
    (admit-routing-pin-evidence! value pins now
     "managed North routing pin evidence"))
  ([value ForeignValue
    pins JsObject
    now JsDate
    surface String] (U JsObject Nil)
    (if (identical? value undefined)
     nil
     (let [raw JsObject (foreign-object! value surface)]
       (exact-fields! raw PIN-FIELDS surface)
       (when (not (identical? (aget raw "policyVersion")
                             ROUTING_PIN_POLICY_VERSION))
         (error! (str surface ".policyVersion must be "
                      ROUTING_PIN_POLICY_VERSION)))
       (let [issued JsObject (iso-instant! (: (aget raw "issuedAt") ForeignValue)
                           (str surface ".issuedAt"))
             expires JsObject (iso-instant! (: (aget raw "expiresAt") ForeignValue)
                           (str surface ".expiresAt"))
             issued-time Number (: (.-time issued) Number)
             expires-time Number (: (.-time expires) Number)
             now-time Number (.getTime now)]
         (when (> issued-time (+ now-time 60000))
           (error! (str surface ".issuedAt is in the future")))
         (when (<= expires-time now-time)
           (error! (str surface " is expired")))
         (when (or (<= expires-time issued-time)
                   (> (- expires-time issued-time)
                      MAX_PIN_LIFETIME_MS))
           (error! (str surface
                        " lifetime must be positive and no more than 24 hours")))
         (let [raw-pins-value ForeignValue (: (aget raw "pins") ForeignValue)]
           (when (or (not (Array/isArray raw-pins-value))
                     (zero? (.-length (as-array raw-pins-value))))
             (error! (str surface ".pins must be non-empty")))
           (let [raw-pins JsArray (as-array raw-pins-value)
                 admitted-pins (Vec JsObject) (for [index (range (alength raw-pins))]
                   (let [label String (str surface ".pins[" index "]")
                         pin JsObject (foreign-object! (: (aget raw-pins index) ForeignValue)
                                          label)]
                     (exact-fields! pin PIN-ITEM-FIELDS label)
                     #js {:kind
                          (enum-value! (: (aget pin "kind") ForeignValue)
                                       PIN-KINDS (str label ".kind"))
                          :value
                          (required-string! (: (aget pin "value") ForeignValue)
                                            (str label ".value"))}))
                 unique-kinds JsObject (new Set (.map admitted-pins
                            (fn [pin JsObject] String (.-kind pin))))]
             (when (not (identical? (.-size unique-kinds)
                                    (count admitted-pins)))
               (error! (str surface
                            ".pins may contain each kind at most once")))
             (let [expected JsArray (.filter (Object/entries pins)
                     (fn [entry JsArray] Bool (not (nil? (aget entry 1)))))]
               (when (or
                       (not (identical? (.-length expected)
                                        (count admitted-pins)))
                       (.some expected
                         (fn [entry JsArray] Bool
                           (let [kind String (: (aget entry 0) String)
                                 expected-value Any (aget entry 1)]
                             (not (.some admitted-pins
                               (fn [pin JsObject] Bool
                                 (and (identical? (.-kind pin) kind)
                                      (identical? (.-value pin)
                                                  expected-value)))))))))
                 (error! (str surface
                   ".pins must exactly match explicit provider/account/model selectors"))))
             (deep-freeze
               #js {:policyVersion ROUTING_PIN_POLICY_VERSION
                    :issuedAt (.-source issued)
                    :expiresAt (.-source expires)
                    :reasonCode
                    (enum-value! (: (aget raw "reasonCode") ForeignValue)
                                 PIN-REASON-CODES
                                 (str surface ".reasonCode"))
                    :detail
                    (required-string! (: (aget raw "detail") ForeignValue)
                                      (str surface ".detail"))
                    :pins admitted-pins}))))))))

(js/export
  (def admitRoutingPinEvidence
    (U (Fn [ForeignValue JsObject] (U JsObject Nil))
       (Fn [ForeignValue JsObject JsDate] (U JsObject Nil))
       (Fn [ForeignValue JsObject JsDate String] (U JsObject Nil)))
    admit-routing-pin-evidence!))
(js/declare-export admitRoutingPinEvidence
  (U (Fn [ForeignValue JsObject] (js/optional RoutingPinEvidence))
     (Fn [ForeignValue JsObject JsDate] (js/optional RoutingPinEvidence))
     (Fn [ForeignValue JsObject JsDate String]
         (js/optional RoutingPinEvidence))))

(def policy-pin-cache JsObject #js {:digest undefined})
(defn graph-policy-pin! [surface String] String
  (when (nil? (.-digest policy-pin-cache))
    (aset policy-pin-cache "digest"
          (verify-policy-digest-pin undefined surface)))
  (let [digest-value (U String Nil) (.-digest policy-pin-cache)]
    (if digest-value
      digest-value
      (do (error! "routing policy pin was not established") ""))))

(def catalog-pin-cache JsObject #js {:pin undefined})
(defn graph-catalog-pin! [] JsObject
  (when (nil? (.-pin catalog-pin-cache))
    (aset catalog-pin-cache "pin" (catalog-graph-pin-for-admission)))
  (let [pin-value (U JsObject Nil) (.-pin catalog-pin-cache)]
    (if pin-value
      pin-value
      (do (error! "routing catalog pin was not established") (js-obj)))))

(defn stock-axes! [request JsObject] (U JsObject Nil)
  (if (not (identical? (.-kind (.-composition request)) "template"))
    nil
    (let [env JsObject (.-env process)
          catalog JsObject (JSON/parse
            (read-file-text
              (or (.-ORCHESTRATION_STAFFING_CATALOG env)
                  DEFAULT-ORCHESTRATION-STAFFING-PATH) "utf8"))
          template-id String (.-id (.-composition request))
          presets (Vec JsObject) (or (.-presets catalog) [])
          preset (U JsObject Nil) (.find presets
            (fn [candidate JsObject] Bool
              (identical? (.-name candidate) template-id)))]
      (when (nil? preset)
        (error! (str "Orchestration stock preset " template-id
          " is absent while issuing admission receipt")))
      #js {:taskGrade (String (.-taskGrade preset))
           :topology (String (.-topology preset))
           :capabilityFloor
           (enum-value! (: (.-capabilityFloor preset) ForeignValue)
                        CAPABILITY-FLOORS
                        (str "Orchestration stock preset " template-id
                             ".capabilityFloor"))
           :serviceClass
           (enum-value! (: (.-serviceClass preset) ForeignValue)
                        SERVICE-CLASSES
                        (str "Orchestration stock preset " template-id
                             ".serviceClass"))
           :reasoning (String (.-deliberation preset))
           :posture (String (.-posture preset))})))

(defn admit-routing-economics! [args JsObject] JsObject
  (let [surface String (or (.-surface args) "managed North routing economics")
        request JsObject (.-request args)
        assessment (U JsObject Nil) (admit-routing-assessment!
          (: (.-routingAssessment args) ForeignValue) request surface)
        explicit-pins JsObject (js-obj)]
    (when (and (.-provider args)
               (not (identical? (.-provider args) "auto")))
      (aset explicit-pins "provider" (.-provider args)))
    (when (.-target args) (aset explicit-pins "account" (.-target args)))
    (when (.-model args) (aset explicit-pins "model" (.-model args)))
    (let [pin-evidence (U JsObject Nil) (admit-routing-pin-evidence!
            (: (.-pinEvidence args) ForeignValue) explicit-pins
            (or (.-now args) (new Date)) (str surface " pin evidence"))]
      (when (and (identical? (.-reasoning request) "max")
                 (nil? assessment))
        (error! (str surface
          " reasoning=max requires a canonical routingAssessment with exceptional deliberation")))
      (when (and (> (.-length (Object/keys explicit-pins)) 0)
                 (nil? pin-evidence))
        (error! (str surface
          " explicit provider/account/model selectors require current typed pinEvidence")))
      (let [graph-mode Bool (identical? (staffing-source) "graph")
            policy-pin (U String Nil) (if graph-mode (graph-policy-pin! surface) nil)
            catalog-pin (U JsObject Nil) (if graph-mode (graph-catalog-pin!) nil)
            env JsObject (.-env process)
            orchestration-root String (resolve-path
              (or (.-NORTH_AGENT_RUNTIME_HOME env)
                  (resolve-path (.-dir (js/import-meta)) ".." ".."
                    "agent-runtime/orchestration")))
            provider-digests (U JsObject Nil) (if graph-mode nil
              #js {:anthropic
                   (file-digest
                     (resolve-path orchestration-root
                                   "providers/anthropic.json"))
                   :openai
                   (file-digest
                     (resolve-path orchestration-root
                                   "providers/openai.json"))})
            stock (U JsObject Nil) (stock-axes! request)
            overrides (Vec String) (if (identical? (.-kind (.-composition request)) "template")
              (into [] (.-overrides (.-composition request))) [])
            receipt JsObject #js {:version 1
                 :routingRequestSha256 (digest request)
                 :routingPolicySha256
                 (file-digest
                   (or (.-NORTH_ROUTING_POLICY env)
                       DEFAULT-ROUTING-POLICY-PATH))
                 :appliedAxes
                 #js {:taskGrade (.-taskGrade request)
                      :topology (.-topology request)
                      :capabilityFloor (.-capabilityFloor request)
                      :serviceClass (.-serviceClass request)
                      :reasoning (.-reasoning request)
                      :posture (.-posture request)}
                 :overrideEvidence
                 #js {:changedAxes overrides
                      :status
                      (if (and assessment (.-exception assessment))
                        "assessment-exception"
                        (if (not (zero? (count overrides)))
                          "composition-only" "none"))}
                 :pinEvidenceStatus
                 (if (zero? (.-length (Object/keys explicit-pins)))
                   "none" "current")}]
        (when assessment
          (aset receipt "routingAssessmentSha256" (digest assessment)))
        (when pin-evidence
          (aset receipt "pinEvidenceSha256" (digest pin-evidence)))
        (when (not graph-mode)
          (aset receipt "staffingCatalogSha256"
            (file-digest
              (or (.-ORCHESTRATION_STAFFING_CATALOG env)
                  DEFAULT-ORCHESTRATION-STAFFING-PATH)))
          (aset receipt "providerCatalogsSha256" (digest provider-digests)))
        (when stock (aset receipt "stockAxes" stock))
        (when (and assessment (.-exception assessment))
          (aset (.-overrideEvidence receipt) "exceptionCode"
                (.-code (.-exception assessment))))
        (when policy-pin
          (aset receipt "orchestrationPolicyPinSha256" policy-pin))
        (when catalog-pin
          (aset receipt "orchestrationCatalogDigestSha256"
                (.-catalogDigestSha256 catalog-pin))
          (aset receipt "orchestrationCatalogVersion"
                (.-catalogVersion catalog-pin))
          (aset receipt "orchestrationCatalogTxVersion"
                (.-coordinatorVersion catalog-pin)))
        (let [result JsObject #js {:receipt receipt}]
          (when assessment (aset result "assessment" assessment))
          (when pin-evidence (aset result "pinEvidence" pin-evidence))
          (deep-freeze result))))))

(js/export
  (def admitRoutingEconomics (Fn [JsObject] JsObject)
    admit-routing-economics!))
(js/declare-export admitRoutingEconomics
  (Fn [RoutingEconomicsArgs] AdmittedRoutingEconomics))

(defn json-env! [name String] ForeignValue
  (let [source Any (aget (.-env process) name)]
    (if (nil? source)
      (: undefined ForeignValue)
      (try
        (: (JSON/parse source) ForeignValue)
        (catch Error _error
          (error! (str name " must contain valid JSON"))
          (: undefined ForeignValue))))))

(defn routing-economics-from-env! [request JsObject] JsObject
  (let [env JsObject (.-env process)]
    (admit-routing-economics!
      #js {:request request
           :routingAssessment (json-env! "AGENT_ROUTING_ASSESSMENT")
           :pinEvidence (json-env! "NORTH_ROUTING_PIN_EVIDENCE")
           :provider (.-AGENT_PROVIDER env)
           :target (.-AGENT_TARGET env)
           :model (.-AGENT_MODEL env)
           :surface "managed North environment routing economics"})))

(js/export
  (def routingEconomicsFromEnv (Fn [JsObject] JsObject)
    routing-economics-from-env!))
(js/declare-export routingEconomicsFromEnv
  (Fn [RoutingRequest] AdmittedRoutingEconomics))
