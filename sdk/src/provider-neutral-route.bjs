#lang beagle/js

(ns north.provider-neutral-route)

(declare-extern require (Fn [String] JsObject))
(declare-extern Error (Fn [String] JsObject))

(def catalog-module JsObject (require "./providers/catalog"))
(def providerSupportsRoute
  (U (Fn [String String String String] Bool)
     (Fn [String String String String (U String Nil)] Bool))
  (.-providerSupportsRoute catalog-module))

;; Provider-neutral admission is expressed in the three independent selection
;; axes. Service class influences ranking, while capability and reasoning are
;; hard eligibility constraints in the provider catalog.
(js/export
  (defn requireProviderNeutralRoute
    [capability-floor String
     service-class String
     reasoning String] Nil
    (when (not (or (providerSupportsRoute "anthropic"
                                          capability-floor
                                          service-class
                                          reasoning)
                   (providerSupportsRoute "openai"
                                          capability-floor
                                          service-class
                                          reasoning)))
      (throw (new Error
                  (str "unsupported route: capability floor '" capability-floor
                       "' with service class '" service-class
                       "' and deliberation '" reasoning
                       "' resolves through no provider catalog"))))
    nil))
