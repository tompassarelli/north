(defn foreign-call!
  [module JsObject
   name String
   arguments JsArray] JsObject
  (: (Reflect/apply (aget module name) nil arguments) JsObject))

(defn foreign-new!
  [module JsObject
   name String
   arguments JsArray] JsObject
  (: (Reflect/construct (aget module name) arguments) JsObject))

(defn foreign-call-async!
  [module JsObject
   name String
   arguments JsArray] (Promise JsObject)
  (: (Reflect/apply (aget module name) nil arguments) (Promise JsObject)))

