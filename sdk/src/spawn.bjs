     (Fn [(Vec String)] Bool)))
(def NO_PROVIDER_TERMINAL_DETAIL String
  (: (.-NO_PROVIDER_TERMINAL_DETAIL execution-outcome) String))
(def PROVIDER_PROCESS_DEATH_OUTCOME String
  (: (.-PROVIDER_PROCESS_DEATH_OUTCOME execution-outcome) String))
