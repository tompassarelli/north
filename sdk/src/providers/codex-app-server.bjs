        details String (if (nil? (providerGet warning "details"))
                         ""
                         (boundedProviderProse
                          (providerGet warning "details")
                          "Codex config warning details"
                          8192.0))
        text String (str summary "\n" details)
        project-config String (resolve (launchcontract-projectRoot contract) ".codex")
        user-config String (resolve (launchcontract-codexHome contract) "config.toml")]
    (when (not (projectConfigWarningCorrelates text project-config user-config))
      (throw (ex-info "Codex config warning omitted the exact project or trust authority" {})))
    nil))

