(js/export
 (defn projectConfigWarningCorrelates
   [text String
    project-config String
    user-config String] Bool
   (and (.includes text project-config)
        (or (.includes text user-config)
            (and (.includes text "marked as untrusted")
                 (.includes text "effective configuration"))))))

