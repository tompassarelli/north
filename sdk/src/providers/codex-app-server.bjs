(defn projectRuntimeItemEffects!
  [method String
   value TypeScriptUnknownV1
   state RuntimeNotificationState] (U Nil String)
  (let [params JsonObject (record value (str "Codex " method " notification"))]
    (let [item JsonObject (record (providerGet params "item") (str "Codex " method " item"))]
      (let [itemId String (protocolId (providerGet item "id") (str "Codex " method " item id"))]
        (let [itemType String (boundedString (providerGet item "type") (str "Codex " method " item type") 128)]
          (let [completed Bool (identical? method "item/completed")]
            (let [started (U Nil TypeScriptAnonymousObjectV8) (if completed
                    (.get (runtimenotificationstate-openItems state) itemId)
                    nil)]
              (let [timestamp Number (: (: (providerGet params (if completed "completedAtMs" "startedAtMs")) Any) Number)]
                (do
                  (when (and completed (openAIWireCountsAsToolItem itemType))
                    (set! (.-toolItems state)
                          (+ (runtimenotificationstate-toolItems state) 1)))
                  (when (and (not completed) (identical? itemType "commandExecution"))
                    (startedNativeCommand item state))
                  (when (and completed (identical? itemType "agentMessage"))
                    (do
                      (when (not (identical? (js/typeof (providerGet item "text")) "string"))
                        (throw (ex-info "Codex agent message text is invalid" {})))
                      (set! (.-text state) (: (: (providerGet item "text") Any) String))))
                  (when (and completed (identical? itemType "mcpToolCall"))
                    (.observe
                     (runtimenotificationstate-mcpActivity state)
                     (str (runtimenotificationstate-threadId state) ":"
                          (runtimenotificationstate-turnId state) ":" itemId)
                     (normalizeCodexMcpIdentity
                      (providerGet item "server")
                      (providerGet item "tool"))
                     (mcpReceiptMetadata
                      (providerGet item "arguments")
                      (providerGet item "result")
                      (if (and started (identical? (.-kind started) "mcpToolCall"))
                        (- timestamp (.-startedAtMs started))
                        nil))))
                  (when (and completed (identical? itemType "commandExecution"))
                    (completedNativeCommand item state))
                  (let [result (U Nil String) (if completed itemId nil)]
                    result))))))))))

(defn validateProgressNotification!
  [method String
   value TypeScriptUnknownV1
   state RuntimeNotificationState] (U Nil String)
  (if (or (identical? method "item/started")
          (identical? method "item/completed"))
    (do
      (validateProgressNotificationBase! method value state)
      (projectRuntimeItemEffects! method value state))
    (validateProgressNotificationBase! method value state)))

