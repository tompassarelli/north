(defn strictJsonLimits
  [maxBytes Number
   maxDepth (U Nil Number)
   maxNodes (U Nil Number)] JsObject
  (: (clj->js
      (merge {}
             {"maxBytes" maxBytes}
             (if (nil? maxDepth) {} {"maxDepth" maxDepth})
             (if (nil? maxNodes) {} {"maxNodes" maxNodes})))
     JsObject))

(defn strictJsonlLimits
  [label String
   maxLineBytes Number
   maxTotalBytes Number
   maxMessages Number] JsObject
  (: (clj->js
      {"label" label
       "maxLineBytes" maxLineBytes
       "maxTotalBytes" maxTotalBytes
       "maxMessages" maxMessages})
     JsObject))

