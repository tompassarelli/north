#lang beagle/js

(ns north.providers.codex-app-server)

;; The remaining North modules are still legacy TypeScript authorities. Decode
;; their runtime exports once here; typed aliases keep that foreign boundary
;; from propagating module objects into the provider's owned semantics.
(declare-extern require (Fn [String] JsObject))
(declare-extern Reflect JsObject)

;; Beagle maps retain key identity with tagged host properties. Every value
;; crossing JSON's JavaScript-object boundary is externalized in one place so
;; RPC and configuration payloads carry their actual wire keys.
(defn jsonStringify [value Any] String
  (: (JSON/stringify (clj->js value)) String))

(defn externalized-spawn
  [spawn-process (Fn [String (Vec String) JsObject] JsObject)
   command String
   arguments (Vec String)
   options Any] JsObject
  (spawn-process command arguments (: (clj->js options) JsObject)))

(defn hostObjectKeys [value Any] (Vec String)
  (: (Object/keys (: (clj->js value) JsObject)) (Vec String)))

(defn hostObjectEntries [value Any] Any
  (Object/entries (: (clj->js value) JsObject)))

(defn decodeJsonValue [value Any] TypeScriptUnknownV1
  (: (js->clj value) TypeScriptUnknownV1))

(defn providerGet
  [collection Any
   key Any] Any
  (if (and collection
           (identical? (js/typeof collection) "object")
           (Object/hasOwn (: collection JsObject) key))
    (.get Reflect (: collection JsObject) key)
    (get collection key)))

(defn providerContains?
  [collection Any
   key Any] Bool
  (if (and collection
           (identical? (js/typeof collection) "object")
           (Object/hasOwn (: collection JsObject) key))
    true
    (contains? collection key)))

(defn foreign-string-property
  [object JsObject
   key String] (U Nil String)
  (let [value Any (.get Reflect object key)]
    (if (identical? (js/typeof value) "string")
      (: value String)
      nil)))

(defrecord TypeScriptStdoutV1 [isTTY (U Bool Nil)])

(defrecord TypeScriptProcessV1
  [stdout TypeScriptStdoutV1
   env JsObject
   pid Number
   platform String
   execPath String
   getBuiltinModule (Fn [String] JsObject)])

(declare-extern process TypeScriptProcessV1)

(defalias ChildProcessWithoutNullStreams JsObject)

(def child-process-module JsObject (.getBuiltinModule process "node:child_process"))
(def spawn (Fn [String (Vec String) JsObject] JsObject)
  (: (.-spawn child-process-module) (Fn [String (Vec String) JsObject] JsObject)))

(def crypto-module JsObject (.getBuiltinModule process "node:crypto"))
(def createHash (Fn [String] JsObject)
  (: (.-createHash crypto-module) (Fn [String] JsObject)))

(def fs-module JsObject (.getBuiltinModule process "node:fs"))
(def accessSync (Fn [String Number] Nil)
  (: (.-accessSync fs-module) (Fn [String Number] Nil)))
(def closeSync (Fn [Number] Nil)
  (: (.-closeSync fs-module) (Fn [Number] Nil)))
(def constants JsObject (.-constants fs-module))
(def FS_X_OK Number (: (.-X_OK constants) Number))
(def FS_O_CREAT Number (: (.-O_CREAT constants) Number))
(def FS_O_EXCL Number (: (.-O_EXCL constants) Number))
(def FS_O_WRONLY Number (: (.-O_WRONLY constants) Number))
(def FS_O_NOFOLLOW (U Nil Number) (: (.-O_NOFOLLOW constants) (U Nil Number)))
(def fsyncSync (Fn [Number] Nil)
  (: (.-fsyncSync fs-module) (Fn [Number] Nil)))
(def lstatSync (Fn [String] JsObject)
  (: (.-lstatSync fs-module) (Fn [String] JsObject)))
(def mkdtempSync (Fn [String] String)
  (: (.-mkdtempSync fs-module) (Fn [String] String)))
(def openSync (Fn [String Number Number] Number)
  (: (.-openSync fs-module) (Fn [String Number Number] Number)))
(def realpathSync (Fn [String] String)
  (: (.-realpathSync fs-module) (Fn [String] String)))
(def renameSync (Fn [String String] Nil)
  (: (.-renameSync fs-module) (Fn [String String] Nil)))
(def rmSync JsObject (.-rmSync fs-module))
(def statSync (Fn [String] JsObject)
  (: (.-statSync fs-module) (Fn [String] JsObject)))
(def unlinkSync (Fn [String] Nil)
  (: (.-unlinkSync fs-module) (Fn [String] Nil)))
(def writeFileSync JsObject (.-writeFileSync fs-module))

(def os-module JsObject (.getBuiltinModule process "node:os"))
(def homedir (Fn [] String) (: (.-homedir os-module) (Fn [] String)))
(def tmpdir (Fn [] String) (: (.-tmpdir os-module) (Fn [] String)))

(def path-module JsObject (.getBuiltinModule process "node:path"))
(def delimiter String (.-delimiter path-module))
(def dirname (Fn [String] String)
  (: (.-dirname path-module) (Fn [String] String)))
(def join (Fn [String & String] String)
  (: (.-join path-module) (Fn [String & String] String)))
(def resolve (Fn [String & String] String)
  (: (.-resolve path-module) (Fn [String & String] String)))

(def writeStringToFdSync (Fn [Number String] Nil)
  (: (: writeFileSync Any) (Fn [Number String] Nil)))

(def syncFdSync (Fn [Number] Nil)
  (: fsyncSync (Fn [Number] Nil)))

(def closeFdSync (Fn [Number] Nil)
  (: closeSync (Fn [Number] Nil)))

(defrecord SupervisorRemovalOptions
  [recursive Bool
   force Bool])

(def removeTreeSync (Fn [String SupervisorRemovalOptions] Nil)
  (: (: rmSync Any) (Fn [String SupervisorRemovalOptions] Nil)))

