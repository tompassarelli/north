      (jsonStringify
       (canonical
        (: (:
            (mapv
             (fn [raw TypeScriptUnknownV1] TypeScriptStructuralObjectV3
               (let [layer JsonObject (record raw "Codex config layer")]
                 (let [disabledReason TypeScriptUnknownV1 (providerGet layer "disabledReason")]
                   (->TypeScriptStructuralObjectV3
                    (if (nil? disabledReason)
                      nil
                      (: (: disabledReason Any) TypeScriptAnonymousObjectV7))
                    (providerGet layer "name")
                    (providerGet layer "version")
                    (providerGet layer "config")))))
             (: (: (providerGet body "layers") Any) (Vec TypeScriptUnknownV1)))
            Any)
           JsArray))))))

