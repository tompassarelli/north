(defn createSupervisorControl! [] SupervisorControl
  (let [directory String (mkdtempSync (join (tmpdir) "north-codex-control-"))]
    (let [sequence (Atom Number) (atom 0)]
      (let [closed (Atom Bool) (atom false)]
        (->SupervisorControl
         directory
         (: (.resolve Promise) (Promise Nil))
         (fn
           [line String
            callback (Fn [(U Nil Error)] Nil)] Nil
           (if (or (deref closed)
                   (> (.byteLength Buffer line "utf8") MAX_LINE_BYTES))
             (do
               (callback (new Error "managed Codex supervisor control is unavailable"))
               nil)
             (do
               (swap! sequence + 1)
               (let [stem String (.padStart (String (deref sequence)) 12 "0")]
                 (let [temporary String (join directory
                             (str "." stem "." (.-pid process) ".tmp"))]
                   (let [request String (join directory (str stem ".req"))]
                     (let [fd (Atom (U Nil Number)) (atom nil)]
                       (try
                         (do
                           (reset! fd
                                   (openSync
                                    temporary
                                    (+ FS_O_CREAT
                                       FS_O_EXCL
                                       FS_O_WRONLY
                                       (let [nofollow (U Nil Number) FS_O_NOFOLLOW]
                                         (if (nil? nofollow) 0 nofollow)))
                                    384))
                           (let [payloadLength Number (.byteLength Buffer line "utf8")]
                             (let [digest String (.digest (.update (createHash "sha256") line "utf8") "hex")]
                               (let [framed String (str SUPERVISOR_MESSAGE_PREFIX
                                          payloadLength " " digest "\n" line)]
                                 (do
                                   (writeStringToFdSync
                                    (: (: (deref fd) Any) Number)
                                    framed)
                                   (syncFdSync (: (: (deref fd) Any) Number))
                                   (closeFdSync (: (: (deref fd) Any) Number))
                                   (reset! fd nil)
                                   (renameSync temporary request)
                                   (callback nil))))))
                         (catch Any error
                           (do
                             (when (not (nil? (deref fd)))
                               (try
                                 (closeFdSync (: (: (deref fd) Any) Number))
                                 (catch Any ignored nil)))
                             (try (unlinkSync temporary) (catch Any ignored nil))
                             (callback
                              (if (instance? Error error)
                                (: (: error Any) Error)
                                (new Error "managed Codex supervisor control failed")))))))))
               nil))))
         (fn [] Nil
           (if (deref closed)
             nil
             (do
               (reset! closed true)
               (try
                 (removeTreeSync directory (->SupervisorRemovalOptions true true))
                 (catch Any ignored nil))
               nil))))))))

