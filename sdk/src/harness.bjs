(js/declare-type Effort
  (js/enum "low" "medium" "high" "xhigh" "max"))

(def REPO String (resolve (.-dir (js/import-meta)) "../.."))
(def ENGINE String (str REPO "/bin/north"))
(def MCP String (str REPO "/bin/north-mcp"))
(def MSG-CLI String (str REPO "/cli/msg-cli.clj"))

(defn is-store-repo? [repo String] Bool
  (.startsWith repo "/nix/store/"))

(def STABLE-SYSTEM-BIN String
  (.join ["" "run" "current-system" "sw" "bin"] "/"))
(def STABLE-SYSTEM-BINARIES JsObject (new Set ["north" "concern"]))

(defn stable-bin-path
  ([name String] String (stable-bin-path name REPO))
  ([name String
    repo String] String
    (if (not (is-store-repo? repo))
     (str repo "/bin/" name)
     (if (.has STABLE-SYSTEM-BINARIES name)
       (str STABLE-SYSTEM-BIN "/" name)
       name))))

(defn eso-spec-path
  ([] String (eso-spec-path (.-env process) REPO))
  ([env ProcessEnv] String (eso-spec-path env REPO))
  ([env ProcessEnv
    repo String] String
    (let [relative-path String "sdk/src/vendor/eso/SPEC.md"]
     (if (not (is-store-repo? repo))
       (str repo "/" relative-path)
       (let [checkout (U String Nil) (.-NORTH_HOME env)]
         (if (and checkout (not (is-store-repo? checkout)))
           (let [candidate String (resolve checkout relative-path)]
             (if (existsSync candidate) candidate (str repo "/" relative-path)))
           (str repo "/" relative-path)))))))

(defn north-port [] String (or (.-NORTH_PORT (.-env process)) "7977"))
(defn peer-bb [] String (or (.-NORTH_PEER_BB (.-env process)) "bb"))

(defn current-path-executable
  ([name String] String (current-path-executable name (.-env process)))
  ([name String
    env ProcessEnv] String
    (if (.includes name "/")
     name
     (loop [directories (Vec String) (.split (or (.-PATH env) "") delimiter)]
       (if (empty? directories)
         name
         (let [directory String (first directories)]
           (if (identical? directory "")
             (recur (rest directories))
             (let [candidate String (resolve directory name)]
               (try
                 (do (accessSync candidate (.-X_OK constants)) candidate)
                 (catch Error _error
                   (recur (rest directories))))))))))))

(defn presence-bb [] String
  (current-path-executable (or (.-NORTH_PEER_BB (.-env process)) "bb")))

(defn edn-value [value JsObject] String
  (if (or (identical? (js/typeof value) "number")
          (identical? (js/typeof value) "boolean"))
    (str value)
    (let [text String (if (and (identical? (js/typeof value) "object") (not (nil? value)))
            (JSON/stringify value)
            (str value))]
      (if (.test (new RegExp "^[@:]" "u") text)
        text
        (JSON/stringify text)))))

(defn edn-args [args JsObject] String
  (str "{"
       (.join
        (.map (Object/entries args)
              (fn [entry JsArray] String
                 (str ":" (aget entry 0) " " (edn-value (aget entry 1)))))
         " ")
       "}"))

(def PEER-ROUTING-FIELDS (Vec String)
  ["role" "taskGrade" "domainRequirements" "topology" "capabilityFloor"
   "serviceClass" "reasoning" "posture" "composition"])
(def PEER-ROUTE-ADAPTER-FIELDS (Vec String) ["provider" "target" "model"])
(defalias PeerOperation String)

(defn exact-peer-fields!
  [args JsObject
   allowed (Vec String)
   operation String] Nil
  (let [unknown (Vec String) (.filter (Object/keys args)
                 (fn [field String] Bool (not (.includes allowed field))))]
    (when (> (count unknown) 0)
      (throw (new Error
                  (str operation " has unknown field(s): " (.join unknown ", ")))))
    nil))

(defn non-empty-object-string?
  [args JsObject
   field String] Bool
  (let [value JsObject (aget args field)]
    (and (identical? (js/typeof value) "string")
         (not (identical? (.trim value) "")))))

(defn validate-peer-command-args!
  [op PeerOperation
   args JsObject] Nil
  (when (or (nil? args)
              (not (identical? (js/typeof args) "object"))
              (Array/isArray args))
      (throw (new Error (str op " args must be an object"))))
    (cond
      (identical? op "tell")
      (do
        (exact-peer-fields! args ["id" "pred" "value"] op)
        (when (not (.every ["id" "pred" "value"]
                           (fn [field String] Bool
                             (non-empty-object-string? args field))))
          (throw (new Error "tell requires id, pred, and value")))
        (when (identical? (.-pred args) "judgment_grade")
          (requireJudgmentGrade (.-value args))))

      (identical? op "acquire")
      (do
        (exact-peer-fields! args ["resource" "holder"] op)
        (when (not (non-empty-object-string? args "resource"))
          (throw (new Error "acquire requires resource"))))

      :else
      (let [work-field String (if (identical? op "spawn") "prompt" "thread")
            allowed (Vec String) (.concat [work-field] PEER-ROUTING-FIELDS PEER-ROUTE-ADAPTER-FIELDS)]
        (exact-peer-fields! args allowed op)
        (when (or (not (non-empty-object-string? args work-field))
                  (not (non-empty-object-string? args "role")))
          (throw (new Error
                      (str op " requires " work-field
                           " and an explicit Orchestration role"))))
        (let [present-routing (Vec String) (.filter PEER-ROUTING-FIELDS
                       (fn [field String] Bool (Object/hasOwn args field)))]
          (when (not (identical? (count present-routing)
                                 (count PEER-ROUTING-FIELDS)))
            (let [missing (Vec String) (.filter PEER-ROUTING-FIELDS
                           (fn [field String] Bool
                             (not (Object/hasOwn args field))))]
              (throw (new Error
                          (str op
                               " requires the complete nine-field Orchestration request; missing: "
                               (.join missing ", ")
                               " (recover the valid payload shape: north show @contract:dispatch)")))))
          (let [metadata JsObject (js-obj)]
            (doseq [field present-routing]
              (aset metadata field (aget args field)))
            (admitRoutingRequest metadata (str "managed peer " op))))))
    nil)

;; Effect-bearing implementations keep Beagle's `!`; these aliases preserve the
;; established JavaScript API names at the foreign boundary.
(js/export
  (def validatePeerCommandArgs
    (Fn [String JsObject] Nil)
    validate-peer-command-args!))

(defn send-peer-command!
  [self String
   to String
   op PeerOperation
   args JsObject] String
  (assertCoordinationAuthority (str "command_peer:" op))
    (when (or (identical? op "spawn") (identical? op "dispatch"))
      (throw (new Error
                  (str "peer " op
                       " is unsupported until atomic command claim + child reconciliation land; use North MCP/CLI "
                       op))))
    (validate-peer-command-args! op args)
    (execFileSync
      (peer-bb)
      (beagleStoreBabashkaArguments
        [MSG-CLI (north-port) "send-cmd" self to op (edn-args args)])
      #js {:encoding "utf8"
           :env (beagleStoreEnvironment)
           :timeout (beagleStoreCoordinatorChildTimeout)}))

(js/export
  (def sendPeerCommand
    (Fn [String String String JsObject] String)
    send-peer-command!))

(js/export
  (def COORDINATION_TOOLS (Vec String)
    ["mcp__north__capture" "mcp__north__tell" "mcp__north__evidence_record"
     "mcp__north__show" "mcp__north__search" "mcp__north__artifact_read"
     "mcp__north__ready" "mcp__north__next"]))

(js/export
  (def ORCHESTRATION_TOOLS (Vec String)
    ["mcp__north__dispatch" "mcp__north__spawn"
     "mcp__north-peer__command_peer"]))

(js/export
  (def NATIVE_AGENT_TOOLS (Vec String) ["Agent" "Task" "Workflow"]))

(js/export
  (def NORTH_MCP_TOOL_NAMES (Vec String)
    ["ready" "next" "blocked" "agenda" "leverage" "needs_review" "validate"
     "show" "search" "artifact_read" "capture" "tell" "evidence_record"
     "retract" "presentation" "linear_get" "linear_import" "linear_plan"
     "linear_sync" "dispatch" "spawn"]))

(def ALL-NORTH-MCP-TOOLS (Vec String)
  (.map NORTH_MCP_TOOL_NAMES
        (fn [name String] String (str "mcp__north__" name))))

(def CAPABILITY-TOOLS JsObject
  #js {"filesystem.read" ["Read"]
   "filesystem.search" ["Grep" "Glob"]
   "filesystem.write" ["Edit" "Write" "NotebookEdit"]
   "shell" ["Bash"]
   "shell.readonly" [READONLY_SHELL_TOOL]
   "web" ["WebSearch" "WebFetch"]
   "coordination" ORCHESTRATION_TOOLS})

(def ALL-CAPABILITY-TOOLS (Vec String)
  (vec (new Set (.flat (Object/values CAPABILITY-TOOLS)))))

(js/declare-record ManagedToolPolicyDeclaration
  [tools (Vec String)
   allowedTools (Vec String)
   disallowedTools (Vec String)])

(js/export
  (defn managedToolPolicy [capabilities (Vec OrchestrationCapability)] JsObject
    (let [selected-capability-tools (Vec String) (vec
            (new Set
                 (.flatMap capabilities
                           (fn [capability OrchestrationCapability] JsArray
                             (aget CAPABILITY-TOOLS capability)))))
          orchestration-allowed Bool (.includes capabilities "coordination")
          allowed-tools (Vec String) (vec
            (new Set
                 (.concat selected-capability-tools
                          COORDINATION_TOOLS
                          (if orchestration-allowed ORCHESTRATION_TOOLS []))))
          disallowed-tools (Vec String) (vec
            (new Set
                 (.concat
                   NATIVE_AGENT_TOOLS
                   (.filter ALL-CAPABILITY-TOOLS
                            (fn [tool-name String] Bool
                              (not (.includes selected-capability-tools tool-name))))
                   (.filter ALL-NORTH-MCP-TOOLS
                            (fn [tool-name String] Bool
                              (not (.includes allowed-tools tool-name))))
                   (if orchestration-allowed []
                     ["mcp__north-peer__command_peer"]))))]
      #js {:tools
       (.filter selected-capability-tools
                (fn [tool-name String] Bool
                  (not (.startsWith tool-name "mcp__"))))
       :allowedTools allowed-tools
       :disallowedTools disallowed-tools})))

(js/declare-export managedToolPolicy
  (Fn [(Vec String)] ManagedToolPolicyDeclaration))

(defn error-message [error Error] String
  (or (.-stderr error) (.-message error) (str error)))

(defn peer-command-handler!
  [self String
   input JsObject] JsObject
  (try
    (let [to String (.-to input)
          op PeerOperation (.-op input)
          args JsObject (.-args input)
          output String (send-peer-command! self to op args)]
      #js {:content
           [#js {:type "text"
                 :text (.trim (str "sent {:op :" op "} -> " to "\n" output))}]})
    (catch Error error
      #js {:content
           [#js {:type "text"
                 :text (str "command_peer failed: " (error-message error))}]
           :isError true})))

(defn peer-command-server! [self String] JsObject
    (createSdkMcpServer
      #js {:name "north-peer"
           :version "0.1.0"
           :tools
           [(tool
          "command_peer"
          (str "Command a peer over the North fact feed with repeat-safe operations: "
               "tell {id, pred, value} | acquire {resource}. Managed spawn/dispatch "
               "use North's canonical MCP/CLI tools.")
          #js {:to (.describe
                     (.string z)
                     "exact recipient agent handle or held role; use literal '*' to broadcast")
               :op (.enum z ["tell" "acquire"])
               :args (.describe
                       (.record z (.string z) (.unknown z))
                       "op-specific repeat-safe fact arguments")}
          (fn [input JsObject] JsObject (peer-command-handler! self input)))]}))

(js/export
  (def peerCommandServer (Fn [String] JsObject) peer-command-server!))

(defn ^:async readonly-shell-handler
  [cwd String
   environment ProcessEnv
   abort-signal (U JsObject Nil)
   input JsObject] (Promise JsObject)
  (try
    (let [result JsObject (await (: (runReadonlyShell
                        (.-command input) cwd (.-timeoutMs input)
                        environment abort-signal)
                      (Promise JsObject)))]
      (if (.-ok result)
        #js {:content [#js {:type "text" :text (JSON/stringify result)}]}
        #js {:content [#js {:type "text" :text (JSON/stringify result)}]
             :isError true}))
    (catch Error error
      #js {:content
           [#js {:type "text"
                 :text
                 (JSON/stringify
                   #js {:ok false
                        :error (or (.-code error) "readonly_shell_unavailable")
                        :message (or (.-message error) (str error))})}]
           :isError true})))

(defn readonly-shell-server
  [cwd String
   environment ProcessEnv
   abort-signal (U JsObject Nil)] JsObject
  (createSdkMcpServer
    #js {:name READONLY_SHELL_SERVER
         :version "0.1.0"
         :tools
         [(tool
        "run"
        (str "Run one command in North's network-isolated read-only shell. The checkout and host "
             "filesystem are read-only; only an ephemeral /tmp is writable.")
        #js {:command
             (.describe
               (.max (.min (.string z) 1) MAX_READONLY_COMMAND_BYTES)
               "Command interpreted intentionally by bash -lc inside the read-only sandbox")
             :timeoutMs
             (.describe
               (.optional (.max (.min (.int (.finite (.number z))) 100) 120000))
               "Bounded command timeout in milliseconds (default: 30000; maximum: 120000)")}
        (fn [input JsObject] (Promise JsObject)
          (readonly-shell-handler cwd environment abort-signal input)))]}))

