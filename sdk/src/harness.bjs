#lang beagle/js

(ns north.sdk.harness)

;; The imported SDK and Node APIs are foreign object boundaries. Domain values
;; below use closed Beagle records or declaration-only wire records; JsObject is
;; retained only where the runtime contract itself is an open JavaScript object.
(declare-extern
  require (Fn [String] JsObject))

(declare-extern
  [process Bun
   console Buffer
   TextDecoder RegExp
   Error Object
   Array Date
   Number Boolean
   JSON Map
   Set WeakMap
   Promise Reflect] JsObject)

