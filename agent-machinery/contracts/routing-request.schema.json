{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-machinery:schema:routing-request:v3",
  "title": "Agent-run provider-neutral routing request",
  "description": "Structural shape only. Use the catalog-advertised validateContract export for normative structural and semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "taskGrade", "domainRequirements", "topology", "capabilityFloor", "serviceClass", "reasoning", "posture", "composition"],
  "properties": {
    "role": { "$ref": "#/$defs/roleId" },
    "taskGrade": { "enum": ["novice", "junior", "mid", "senior", "staff", "principal", "distinguished"] },
    "domainRequirements": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "topology": {
      "enum": ["worker", "orchestrator"],
      "description": "Coordination jurisdiction: worker is terminal; orchestrator may recursively staff freshly admitted children through an enforcing harness."
    },
    "capabilityFloor": {
      "enum": ["baseline", "standard", "advanced", "frontier"],
      "description": "Minimum semantic competence; it does not encode price, latency, or provider preference."
    },
    "serviceClass": {
      "enum": ["economy", "fast", "balanced", "premium"],
      "description": "Selection objective for price-quality-latency tradeoffs; it never lowers capabilityFloor."
    },
    "reasoning": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "posture": { "enum": ["explore", "deliver", "preserve", "prune", "evaluate"] },
    "composition": {
      "description": "Behavior contract and template provenance. A composition ID is independent of role and is not a ninth routing field.",
      "oneOf": [
        { "$ref": "#/$defs/templateComposition" },
        { "$ref": "#/$defs/bespokeComposition" }
      ]
    }
  },
  "$defs": {
    "overrideField": {
      "enum": ["taskGrade", "domainRequirements", "capabilityFloor", "serviceClass", "reasoning", "posture"]
    },
    "templateComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "overrides"],
      "properties": {
        "kind": { "const": "template" },
        "id": { "$ref": "#/$defs/roleId" },
        "overrides": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/overrideField" }
        },
        "overrideReason": { "type": "string", "minLength": 1 }
      }
    },
    "bespokeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibility", "deliverable", "capabilities", "mayDecide", "mustEscalate", "doneWhen", "report"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "deliverable": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "mayDecide": { "$ref": "#/$defs/nonEmptyStrings" },
        "mustEscalate": { "$ref": "#/$defs/nonEmptyStrings" },
        "doneWhen": { "$ref": "#/$defs/nonEmptyStrings" },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "bespokeComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "bespokeReason", "promotionCandidate", "contract"],
      "properties": {
        "kind": { "const": "bespoke" },
        "id": { "$ref": "#/$defs/roleId" },
        "nearestTemplate": { "$ref": "#/$defs/roleId" },
        "bespokeReason": { "type": "string", "minLength": 1 },
        "promotionCandidate": { "type": "boolean" },
        "contract": { "$ref": "#/$defs/bespokeContract" }
      }
    },
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["filesystem.read", "filesystem.search", "filesystem.write", "shell", "shell.readonly", "web", "coordination"] }
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
