{
  "name": "@tompassarelli/agent-machinery",
  "version": "0.1.0",
  "description": "Provider-independent agent doctrine, contracts, and procedures",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./index.mjs",
    "./catalog": "./catalog.json",
    "./catalog.schema": "./catalog.schema.json",
    "./doctrine": "./doctrine.md",
    "./contracts/*": "./contracts/*",
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "build:ownership": "beagle build scripts/work-ownership.bjs scripts/work-ownership.js",
    "refresh:guides": "bun scripts/refresh-guides.mjs",
    "check:guides": "bun scripts/refresh-guides.mjs --check",
    "build": "bun run build:ownership",
    "check:ownership": "beagle check scripts/work-ownership.bjs && beagle fmt --check scripts/work-ownership.bjs && bun scripts/check-work-ownership-generated.mjs",
    "check": "bun run check:ownership && bun scripts/validate.mjs",
    "test": "bun test tests/*.test.mjs"
  },
  "files": [
    "index.mjs",
    "catalog.json",
    "catalog.schema.json",
    "doctrine.md",
    "contracts",
    "skills",
    "scripts",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "PROVENANCE.md"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
