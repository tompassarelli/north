{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "north.agent-catalog-config/v1",
  "title": "North agent catalog owner configuration",
  "oneOf": [
    {"$ref": "#/$defs/sourceConfig"},
    {"$ref": "#/$defs/operatorConfig"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path"],
      "properties": {
        "repo": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targets"],
      "properties": {
        "type": {"enum": ["skill", "instructions", "hook", "agentTemplates", "providerAdapter", "projectPackage"]},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type":"string","pattern":"^(shared|codex|code|north|bridge|firn|claude|project:[a-z0-9][a-z0-9-]*)$"}
        },
        "owner": {"$ref": "#/$defs/owner"},
        "adapterId": {"type": "string", "minLength": 1}
      }
    },
    "sourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["skill", "hook", "module"]},
        "title": {"type": "string", "minLength": 1},
        "triggerDescription": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {"if":{"properties":{"kind":{"const":"module"}}},"then":{"required":["members"]}},
        {"if":{"properties":{"kind":{"enum":["skill","hook"]}}},"then":{"not":{"required":["members"]}}}
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner"],
      "properties": {
        "kind": {"enum": ["skill", "hook"]},
        "category": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "distributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "targets"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/owner"},
        "targets": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["shared","codex","code"]}}
      }
    },
    "providerSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/owner"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "sourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema", "role", "units"],
      "properties": {
        "$schema": {"type": "string"},
        "schema": {"const": "north.agent-catalog-config/v1"},
        "role": {"const": "source"},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceUnit"}}
      }
    },
    "operatorConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema", "role", "rootOrder", "baselines", "providerSupport", "registrations", "activation"],
      "properties": {
        "$schema": {"type": "string"},
        "schema": {"const": "north.agent-catalog-config/v1"},
        "role": {"const": "operator"},
        "rootOrder": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "baselines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/baseline"}},
        "providerSupport": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/providerSupport"}},
        "registrations": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/registration"}},
        "activation": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/activation"}}
      }
    }
  }
}
