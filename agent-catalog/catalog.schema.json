{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "north.agent-catalog/v1",
  "title": "North authoritative agent unit catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baselines", "providerSupport", "rootOrder", "units"],
  "properties": {
    "schema": {"const": "north.agent-catalog/v1"},
    "baselines": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/baseline"}},
    "providerSupport": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/providerSupport"}},
    "rootOrder": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unitId"}},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "unitId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["repo", "path"],
      "properties": {"repo": {"$ref": "#/$defs/unitId"}, "path": {"type": "string", "minLength": 1}}
    },
    "baseline": {
      "type":"object","additionalProperties":false,"required":["id","owner","targets"],
      "properties":{"id":{"$ref":"#/$defs/unitId"},"owner":{"$ref":"#/$defs/owner"},
                    "targets":{"type":"array","minItems":1,"uniqueItems":true,
                               "items":{"enum":["shared","codex","code"]}}}
    },
    "providerSupport": {
      "type":"object","additionalProperties":false,"required":["id","owner","path"],
      "properties":{"id":{"$ref":"#/$defs/unitId"},"owner":{"$ref":"#/$defs/owner"},
                    "path":{"type":"string","minLength":1}}
    },
    "distribution": {
      "type": "object",
      "required": ["type", "targets"],
      "properties": {
        "type": {"enum": ["skill", "instructions", "hook", "agentTemplates", "providerAdapter", "projectPackage"]},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true,
                    "items": {"type":"string","pattern":"^(shared|codex|code|north|bridge|firn|claude|project:[a-z0-9][a-z0-9-]*)$"}},
        "owner": {"$ref": "#/$defs/owner"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "distributions"],
      "properties": {
        "id": {"$ref": "#/$defs/unitId"},
        "kind": {"enum": ["skill", "hook", "set"]},
        "title": {"type": "string", "minLength": 1},
        "triggerDescription": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "members": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unitId"}},
        "supports": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unitId"}},
        "distributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    }
  }
}
