[ci]
	budget = cargo.yml 162 600
	budget = harness.yml 80 600
[land]
	check = ** :: bun "$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs" run --class moderate --owner land-check --timeout-seconds 1800 -- nix develop -c cargo run --offline --bin north -- config agents check-owners --north-root "$PWD" --south-root "$HOME/code/south/main" --nixos-root "$HOME/code/nixos-config/main"
	check = src/,tests/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=\"$HOME/.cache/cargo-target/north\" bun \"$(dirname \"$(agents path machine-capacity)\")/scripts/machine-capacity.mjs\" run --class heavy --owner land-check --timeout-seconds 1800 -- ./bin/depbox run -- nix develop -c cargo test --locked --offline
	check = bin/,lib/,harness/hooks/,harness/lib/,harness/scripts/ :: CARGO_TARGET_DIR=\"$HOME/.cache/cargo-target/north\" bash harness/scripts/land-checks.sh
	check = "agent-machinery/ :: bun \"$(dirname \"$(agents path machine-capacity)\")/scripts/machine-capacity.mjs\" run --class moderate --owner land-check --timeout-seconds 1800 -- bash -euc 'cd agent-machinery; depbox run -- bun test; depbox run -- bun run check'"
