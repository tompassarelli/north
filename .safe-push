[landing]
	capacity = north capacity host run --class heavy --owner land-check --priority tom-ask --timeout-seconds 3600 --
	exact = true
	queue = lander
	lander-host = whiterabbit
	push-app = lander
	remote-hosts = gex45
	after-runs = 3
	warm = "CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets --workspace --locked --offline -- -D warnings && CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --workspace --locked --offline --no-run"
[mutant]
	class = heavy
	run = ./bin/head-north --code crates/north-capacity/src/capacity/dev_shell.rs,src/cli/ capacity dev-shell run -- bash harness/scripts/mutant-tests.sh
	source = ":(glob)src/**/*.rs"
	source = ":(glob)crates/*/src/**/*.rs"
	source = ":(exclude,glob)**/*tests*.rs"
	source = ":(exclude,glob)**/tests/**"
[flake]
	build = CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-build-system/src/,crates/north-landing-gates/src/landing/flake.rs,src/cli/ land fails-first-runs
	owner = NixOS
	owner = tompassarelli
	owner = oxalica
[ci]
	budget = buck2.yml 574 1148
	budget = harness.yml 80 600
[land]
	check = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets ${SAFE_PUSH_LAND_CHANGED:---workspace} --locked --offline -- -D warnings
	check = @enqueue,Cargo.toml,Cargo.lock,crates/,BUCK,build/,third-party/,toolchains/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-buck/src/,crates/north-build-system/src/,src/cli/ --no-build buck targets --check
	check = @enqueue,@lane,harness/gates.toml,.safe-push :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/gate_shadow.rs,src/cli/ --no-build land scan gate-shadow ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = Cargo.lock,:(glob)**/BUCK,:(glob)**/*.bzl,build/,third-party/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-checks/src/,crates/north-build-system/src/,src/cli/ --no-build land graph-build
	check = src/,crates/ :: CARGO_TARGET_DIR=target ./bin/head-north land scan tool-removal ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = crates/north-base/src/lifecycle.rs,crates/north-base/src/lifecycle/,crates/north-base/src/land_ticket.rs,crates/north-base/src/dispatch_pause_lifecycle.rs,crates/north-machine-model/,crates/north-fleet-store/src/session_lifecycle.rs,crates/north-session-host/src/row_delivery.rs,crates/north-fleet-supervisor/src/fleet/registry/launching.rs,crates/north-land-scans/src/withdrawal.rs,crates/north-landing/src/land/enqueue.rs,crates/north-landing/src/land/after_landing_lifecycle.rs,crates/north-capacity/src/capacity/lease_lifecycle.rs,crates/north-fleet-store/src/gate_lifecycle.rs,crates/north-threads/src/threads/claims/lifecycle.rs,crates/north-threads/src/threads/client/spool.rs,crates/north-check-environment/src/lib.rs,crates/north-runtime/src/runtime/lifecycle.rs,src/cli/machines.rs,docs/rationale/state-machines/ :: CARGO_TARGET_DIR=target ./bin/head-north check machines --root .
	check = src/,crates/,.safe-push :: CARGO_TARGET_DIR=target ./bin/head-north check machines --registry --root .
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/detector_proof.rs,src/cli/ --no-build land scan detector-proof ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/holdlist.rs,src/cli/ --no-build land scan holdlist-guards-resolve ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/holdlist.rs,crates/north-land-scans/src/turn_scope.rs,src/cli/ --no-build land scan turn-scope ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/holdlist.rs,crates/north-land-scans/src/host_cases.rs,src/cli/ --no-build land scan host-cases ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/holdlist.rs,crates/north-land-scans/src/review_accept.rs,src/cli/ --no-build land scan review-accept ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/holdlist.rs,crates/north-land-scans/src/review_accept.rs,crates/north-land-scans/src/safe_push_keys.rs,src/cli/ --no-build land scan safe-push-keys ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/leftovers.rs,src/cli/ --no-build land scan leftovers ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,harness/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/agent_config_check/ --no-build check harness tree-policy
	check = @enqueue,harness/mayday/ :: harness/mayday/mayday --self-test # mayday-self-test
	check = .,:(exclude)third-party/BUCK,:(exclude)third-party/fixups/ :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail ${SAFE_PUSH_LAND_PACKAGES:---workspace} $([[ ${SAFE_PUSH_LAND_PACKAGES:-} == '-p north' ]] || echo --lib) --bins ${SAFE_PUSH_LAND_IT:---test it -E kind(lib)|kind(bin)|kind(test)}
	check = "@rust-input,src/,crates/,tests/,examples/,harness/,Cargo.toml,Cargo.lock,build.rs,rust-toolchain.toml,structure/,structure.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail -p north-base -p north-code-health -p north-guard -p north-runtime -p north-threads --lib -E '(binary_id(=north-code-health) & test(=code_health::habits_tests::the_north_tree_keeps_its_rust_habits)) | (binary_id(=north-guard) & test(=guard::heavy_command_tests::a_build_beside_a_file_or_index_write_is_refused_and_a_read_only_one_still_offloads)) | (binary_id(=north-base) & test(=run_time_data::tests::every_default_on_main_declares_a_range_it_sits_inside)) | (binary_id(=north-base) & test(=run_time_data::tests::every_entry_of_an_array_of_tables_keeps_the_keys_all_earlier_entries_had)) | (binary_id(=north-runtime) & test(=runtime::reuse::tests::every_file_a_source_embeds_at_compile_time_counts_as_a_rust_input)) | (binary_id(=north-runtime) & test(=runtime::reuse::tests::no_source_or_test_embeds_a_table_the_runtime_reads_from_its_tree)) | (binary_id(=north-threads) & test(=threads::incidents::corrections::tests::every_class_in_the_harness_table_has_a_paraphrase_an_owner_and_a_guard))'"
	check = crates/north-graph/src/store/,crates/north-graph/src/store_tests.rs,crates/north-core/src/grounding/store.rs,crates/north-core/src/grounding/store_tests.rs,crates/north-threads/src/threads/schema.rs,crates/north-threads/src/threads/ledger.sql,crates/north-threads/src/threads/client.rs,crates/north-fleet-store/src/store/,crates/north-capacity/src/capacity/lease_lifecycle.rs,crates/north-capacity-host/src/capacity/host/database.rs,crates/north-capacity-host/src/capacity/host/database_tests.rs,crates/north-base/src/lifecycle/store.rs :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail -p north-graph -p north-threads -p north-capacity -p north-capacity-host -p north-fleet-store -E 'test(/old_state/)'
	check = crates/north-land-sandbox/,crates/north-base/src/verdict_cache/,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail -p north-land-sandbox --test enforce
	check = "@enqueue,tests/it/main.rs,tests/it/crates.txt :: ! grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort | uniq -d | grep . && comm -3 <(sed -n 's/^mod //p' tests/it/main.rs | tr -d ';' | LC_ALL=C sort -u) <(grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort -u) | { ! grep .; }"
	check = @enqueue,structure/,structure.toml,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health layers ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,structure/,structure.toml,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health gate ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,structure/,structure.toml,ambient-test-,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health habits --new-since ${SAFE_PUSH_LAND_BASE}
	check = docs/features/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/features_index.rs --no-build docs features-index && ! git ls-files --error-unmatch docs/features.md
	check = src/cli/help.txt,src/cli/help/,crates/north-docs/src/docs.rs,crates/north-docs/src/help_index.rs :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/help_index.rs --no-build docs help-index --check
	check = src/cli/reference.txt,src/cli/reference/,crates/north-docs/src/docs.rs,crates/north-docs/src/reference_index.rs,crates/north-registries/src/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/reference_index.rs,crates/north-registries/src/ --no-build docs reference-index --check
	check = src/cli/verbs.rs,src/cli/verbs/,crates/north-docs/src/docs.rs,crates/north-docs/src/verbs_index.rs,crates/north-registries/src/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/verbs_index.rs,crates/north-registries/src/ --no-build docs verbs-index --check
	check = structure.toml,structure/,crates/north-docs/src/docs.rs,crates/north-docs/src/structure_index.rs,crates/north-registries/src/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/structure_index.rs,crates/north-registries/src/ --no-build docs structure-index --check
	check = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-docs/src/docs.rs,crates/north-docs/src/rationale_index.rs --no-build docs rationale-index --check
	check = @enqueue,flake.lock,harness/nix/lock-allow.toml :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/doctor_nix/,src/cli/ --no-build check nix --lock flake.lock --allow harness/nix/lock-allow.toml
	check = "@enqueue,@lane,src/,crates/,tests/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/ --no-build land scan test-admission kills --remote-north \"CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/\" ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}"
	check = @enqueue,** :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-claims/src/citation_check/ --no-build check citations --root $PWD
	check = @enqueue,harness/scripts/,harness/lib/,bin/,.safe-push,flake.nix :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/nix_entry.rs --no-build land scan nix-entry ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,.safe-push,src/,crates/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/safe_push_verbs.rs,src/cli/ --no-build land scan safe-push-verbs ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-flow/src/experiments/ --no-build check experiments --root .
	check = @enqueue,harness/,north-data/private-checks.toml,north-data/expectations.toml,docs/feedback-loop.md :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-base/src/run_time_data.rs,crates/north-base/src/run_time_data/allowed.rs,crates/north-base/src/build_inputs.rs --no-build land scan run-time-data ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = src/,crates/ :: ! git grep -l 'code/south' -- src crates ':!*test*' ':!crates/north-shared-config/src/lib.rs' | grep .
	check = src/cli/operator.rs,src/cli/operator/,crates/north-ops/src/ops/credentials/ :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/operator/ config operator check $HOME/code/south/main # hardcoded-repo-path:allow
	check = examples/operator/,structure.toml,src/cli/operator.rs,src/cli/operator/,crates/north-core/src/agent_catalog,crates/north-core/src/catalog/ :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/operator/,crates/north-core/src/catalog/ config operator init --check examples/operator
	check = src/cli/operator.rs,src/cli/operator/ :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/operator/ config operator check src/cli/operator/template --distinct-from $HOME/code/south/main # hardcoded-repo-path:allow
	deadline = "2100 :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/ --no-build land scan test-admission kills --remote-north \"CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/\" ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}"
	after = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	after = @enqueue,** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	after = src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only portable
	after = @lane,src/,crates/,tests/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission.rs,crates/north-landing-gates/src/landing/fails_first.rs,crates/north-landing-gates/src/landing/flake.rs,src/cli/ land scan test-admission run ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound
	machine-bound = reads the graph database the landed code wrote, which no lane tree holds, and its guards are in shadow so it fails only when a guard cannot be read or run :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	host-input = ~/.local/state/north/graph.db :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	machine-bound = reads the south and nixos-config checkouts beside north :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	machine-bound = reads the south checkout beside north, which no lane tree holds, so the operator schemas are judged on the build host that owns it :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/operator/ config operator check $HOME/code/south/main # hardcoded-repo-path:allow
	machine-bound = reads the south checkout beside north, which no lane tree holds, so a template value equal to the owner's is judged on the build host that owns it :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/operator/ config operator check src/cli/operator/template --distinct-from $HOME/code/south/main # hardcoded-repo-path:allow
	machine-bound = resolves this host's Claude Code runtime, account token file and south checkout, which no Actions runner holds :: harness/mayday/mayday --self-test # mayday-self-test
	machine-bound = "needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests) :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound"
	machine-bound = runs the live runtime's north when the citation checker is unchanged since it :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-claims/src/citation_check/ check citations --root $PWD
	runner = build-host
	after-only = the code-comment habit is debt on the after-landing gate debt issue and never refuses a lane :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health habits --base ${SAFE_PUSH_LAND_BASE} --head ${SAFE_PUSH_LAND_HEAD}
	after-only = every whole-tree habit finding is debt on the after-landing gate debt issue and never refuses a lane :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health habits
	after-only = it reads the graph database the landed code wrote, which no lane tree holds, and its guards are in shadow :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	after-only = it judges north against the south and nixos-config checkouts on main beside the host, which a lane tree does not hold :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	after-only = the changed portable integration tests are the slowest land check, 125 s on the critical path of a landing (docs/rationale/landing-latency.md), and the lane's unit and changed-crate tests run before it lands :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only portable
	after-only = it replays each added test on a scratch checkout of base through the fails-first runner on a build host, a second build of the workspace per lane :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission.rs,crates/north-landing-gates/src/landing/fails_first.rs,crates/north-landing-gates/src/landing/flake.rs,src/cli/ land scan test-admission run ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after-only = needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests), which an offload slot does not have :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound
	after-only = "the lane test line decides on the landed commit and a red after-landing run reverts the lane, by the owner's direction of 2026-11-13 that a change making landing faster goes live with its revert ready and is proven by backtest, since the line costs 83 to 112 s of a one-line core change, and it still runs before landing for a lane on a trust_boundary_paths path and whenever tests_after_landing is off (north#1036) :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail ${SAFE_PUSH_LAND_PACKAGES:---workspace} $([[ ${SAFE_PUSH_LAND_PACKAGES:-} == '-p north' ]] || echo --lib) --bins ${SAFE_PUSH_LAND_IT:---test it -E kind(lib)|kind(bin)|kind(test)}"
	after-only = it plants a fault in a scratch copy of the landed main and checks buck2 test, clippy and the portable skill check still catch it, which judges the gates, not a lane :: .github/workflows/canary.yml:rust
	after-only = it plants a fault in a scratch copy of the landed main and checks the harness tests still catch it, which judges the gates, not a lane :: .github/workflows/canary.yml:harness
	after-only = it runs every Buck2 test and the clippy gate of the workspace on a clean runner with no store and no remote execution, where the changed crates' tests and clippy run before it lands as land checks :: .github/workflows/buck2.yml:test
	after-only = it reports the tree's Rust line-budget excess on its issue and refuses no lane for size :: ./bin/land-shell --dev -- north code-health budget --json | CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ code-health over-budget
	after-only = it runs every shell and Python harness test on a clean runner, where the changed ones run as the machine-bound land tests on the lander :: .github/workflows/harness.yml:test
[test-admission]
	contract = file-or-wire-format :: a format another program or a past north writes or reads: ledgers, trailers, transcripts, the GitHub and Claude APIs, git output

[after-landing]
check = rust line budget issue :: ./bin/land-shell --dev -- north code-health budget --json | CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ code-health over-budget
advisory = code-comment habit :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ code-health habits --base ${SAFE_PUSH_LAND_BASE} --head ${SAFE_PUSH_LAND_HEAD}
advisory = whole-tree habits :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ code-health habits
