[landing]
	capacity = bun \"$PWD/harness/skills/machine-capacity/scripts/machine-capacity.mjs\" run --class heavy --owner land-check --timeout-seconds 3600 --
	exact = true
	queue = lander
	lander-host = whiterabbit
	push-app = lander
	remote-hosts = gex45
	slots = 3
[mutant]
	class = heavy
	run = nix develop --no-update-lock-file -c bash harness/scripts/mutant-tests.sh
[flake]
	build = cargo test --locked --offline --no-run --message-format=json-render-diagnostics
[ci]
	budget = cargo.yml 162 600
	budget = harness.yml 80 600
[land]
	check = ** :: CARGO_TARGET_DIR=target bash harness/scripts/check-owners.sh
	check = src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets --locked --offline -- -D warnings
	check = harness/,agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo run --locked --offline --bin north -- agent-config-check tree-policy
	check = docs/features.md,docs/features/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo run --offline --bin north -- docs features-index --check
	check = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo run --offline --bin north -- docs rationale-index --check
	check = harness/defaults.toml,harness/skills/machine-capacity/scripts/ :: harness/skills/machine-capacity/scripts/build-machine-capacity --check
	check = ** :: CARGO_TARGET_DIR=target bash harness/scripts/citation-check.sh
	after = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target bash harness/scripts/land-checks.sh machine-bound
	after = flake.nix,flake.lock,rust-toolchain.toml,tests/dev-shell.test.sh :: ./bin/depbox run -- bash tests/dev-shell.test.sh
	after = "agent-machinery/ :: bash -euc 'cd agent-machinery; ../bin/land-shell -- bun install --frozen-lockfile; ../bin/land-shell -- bun test; ../bin/land-shell -- bun run check'"
	machine-bound = reads the south and nixos-config checkouts beside north :: CARGO_TARGET_DIR=target bash harness/scripts/check-owners.sh
	machine-bound = "needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests) :: CARGO_TARGET_DIR=target bash harness/scripts/land-checks.sh machine-bound"
	machine-bound = "tests the Nix dev shell, which the Actions runner does not build :: ./bin/depbox run -- bash tests/dev-shell.test.sh"
	machine-bound = "main's CI does not run the agent-machinery bun tests :: bash -euc 'cd agent-machinery; ../bin/land-shell -- bun install --frozen-lockfile; ../bin/land-shell -- bun test; ../bin/land-shell -- bun run check'"
	machine-bound = runs the held north runtime when the CLI and the checker are unchanged since it :: CARGO_TARGET_DIR=target bash harness/scripts/citation-check.sh
	runner = build-host
