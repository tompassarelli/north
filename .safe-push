[landing]
	capacity = north capacity host run --class heavy --owner land-check --priority tom-ask --timeout-seconds 3600 --
	exact = true
	queue = lander
	lander-host = whiterabbit
	push-app = lander
	remote-hosts = gex45
	after-runs = 3
	warm = "CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets --workspace --locked --offline -- -D warnings && CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --workspace --locked --offline --no-run"
[mutant]
	class = heavy
	run = ./bin/head-north --code crates/north-capacity/src/capacity/dev_shell.rs,src/cli/ capacity dev-shell run -- bash harness/scripts/mutant-tests.sh
	source = ":(glob)src/**/*.rs"
	source = ":(glob)crates/*/src/**/*.rs"
	source = ":(exclude,glob)**/*tests*.rs"
	source = ":(exclude,glob)**/tests/**"
[flake]
	build = cargo test --locked --offline --no-run --message-format=json-render-diagnostics
[ci]
	budget = cargo.yml 162 600
	budget = harness.yml 80 600
[land]
	check = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets ${SAFE_PUSH_LAND_CHANGED:---workspace} --locked --offline -- -D warnings
	check = @enqueue,harness/gates.toml,.safe-push :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/gate_shadow.rs,src/cli/ --no-build land scan gate-shadow ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = src/,crates/ :: CARGO_TARGET_DIR=target ./bin/head-north land scan tool-removal ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/detector_proof.rs,src/cli/ --no-build land scan detector-proof ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,harness/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/agent_config_check/ --no-build check harness tree-policy
	check = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail ${SAFE_PUSH_LAND_PACKAGES:---workspace} --lib --bins ${SAFE_PUSH_LAND_IT:---test it -E kind(lib)|kind(bin)|binary_id(north::it)}
	check = "@rust-input,src/,crates/,tests/,examples/,harness/,Cargo.toml,Cargo.lock,build.rs,rust-toolchain.toml,structure.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail -p north-base -p north-code-health -p north-guard -p north-runtime -p north-threads --lib -E '(binary_id(=north-code-health) & test(=code_health::habits_tests::the_north_tree_keeps_its_rust_habits)) | (binary_id(=north-guard) & test(=guard::heavy_command_tests::a_build_beside_a_file_or_index_write_is_refused_and_a_read_only_one_still_offloads)) | (binary_id(=north-base) & test(=run_time_data::tests::every_default_on_main_declares_a_range_it_sits_inside)) | (binary_id(=north-base) & test(=run_time_data::tests::every_entry_of_an_array_of_tables_keeps_the_keys_all_earlier_entries_had)) | (binary_id(=north-runtime) & test(=runtime::reuse::tests::every_file_a_source_embeds_at_compile_time_counts_as_a_rust_input)) | (binary_id(=north-runtime) & test(=runtime::reuse::tests::no_source_or_test_embeds_a_table_the_runtime_reads_from_its_tree)) | (binary_id(=north-threads) & test(=threads::incidents::corrections::tests::every_class_in_the_harness_table_has_a_paraphrase_an_owner_and_a_guard))'"
	check = crates/north-land-sandbox/,crates/north-base/src/verdict_cache/,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline --no-tests=fail -p north-land-sandbox --test enforce
	check = "@enqueue,src/cli/verbs.rs :: sed -n '/VerbKinds::new(&[[]$/,/^]);$/{//!p}' src/cli/verbs.rs | LC_ALL=C sort -c -u"
	check = "@enqueue,tests/it/main.rs,tests/it/crates.txt :: ! grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort | uniq -d | grep . && comm -3 <(sed -n 's/^mod //p' tests/it/main.rs | tr -d ';' | LC_ALL=C sort -u) <(grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort -u) | { ! grep .; }"
	check = @enqueue,structure.toml,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health layers ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	check = src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-code-health/src/code_health/ --no-build code-health habits --base ${SAFE_PUSH_LAND_BASE} --head ${SAFE_PUSH_LAND_HEAD} --shadow
	check = @enqueue,docs/features.md,docs/features/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/features_index/ --no-build docs features-index --check
	check = @enqueue,docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/rationale_index/ --no-build docs rationale-index --check
	check = @enqueue,flake.lock,harness/nix/lock-allow.toml :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/doctor_nix/,src/cli/ --no-build check nix --lock flake.lock --allow harness/nix/lock-allow.toml
	check = "@enqueue,src/,crates/,tests/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/ --no-build land scan test-admission kills --remote-north \"./bin/land-shell --dev -- ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/\" ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}"
	check = @enqueue,** :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-ops/src/ops/citation_check/ --no-build check citations --root $PWD
	check = @enqueue,harness/scripts/,harness/lib/,bin/,.safe-push,flake.nix :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/nix_entry.rs --no-build land scan nix-entry ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,.safe-push,src/,crates/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/safe_push_verbs.rs,src/cli/ --no-build land scan safe-push-verbs ${SAFE_PUSH_LAND_HEAD}
	check = @enqueue,docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-flow/src/experiments/ --no-build check experiments --root .
	check = @enqueue,harness/,north-data/private-checks.toml,north-data/expectations.toml,docs/feedback-loop.md :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-base/src/run_time_data.rs,crates/north-base/src/run_time_data/allowed.rs,crates/north-base/src/build_inputs.rs --no-build land scan run-time-data ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	check = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-coverage/ --no-build test coverage test ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	deadline = "2100 :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/ --no-build land scan test-admission kills --remote-north \"./bin/land-shell --dev -- ./bin/head-north --code crates/north-land-scans/src/test_admission/,src/cli/\" ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}"
	after = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	after = @enqueue,** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	after = src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only portable
	after = src/,crates/,tests/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission.rs,crates/north-landing-gates/src/landing/fails_first.rs,src/cli/ land scan test-admission run ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound
	machine-bound = reads the graph database the landed code wrote, which no lane tree holds, and its guards are in shadow so it fails only when a guard cannot be read or run :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	host-input = ~/.local/state/north/graph.db :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	machine-bound = reads the south and nixos-config checkouts beside north :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	machine-bound = "needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests) :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound"
	machine-bound = runs the live runtime's north when the citation checker is unchanged since it :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-ops/src/ops/citation_check/ check citations --root $PWD
	runner = build-host
	after-only = it reads the graph database the landed code wrote, which no lane tree holds, and its guards are in shadow :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-graph/,src/cli/ graph guards harness/graph-guards --shadow
	after-only = it judges north against the south and nixos-config checkouts on main beside the host, which a lane tree does not hold :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	after-only = the changed portable integration tests are the slowest land check, 125 s on the critical path of a landing (docs/rationale/landing-latency.md), and the lane's unit and changed-crate tests run before it lands :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only portable
	after-only = it replays each added test on a scratch checkout of base through the fails-first runner on a build host, a second build of the workspace per lane :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-land-scans/src/test_admission.rs,crates/north-landing-gates/src/landing/fails_first.rs,src/cli/ land scan test-admission run ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after-only = needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests), which an offload slot does not have :: CARGO_TARGET_DIR=target ./bin/head-north land tests --select changed --only machine-bound
[test-admission]
	contract = file-or-wire-format :: a format another program or a past north writes or reads: ledgers, trailers, transcripts, the GitHub and Claude APIs, git output
