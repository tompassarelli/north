[landing]
	capacity = bun \"$PWD/harness/skills/machine-capacity/scripts/machine-capacity.mjs\" run --class moderate --owner land-check --timeout-seconds 3600 --
	exact = true
	queue = lander
	lander-host = whiterabbit
[mutant]
	class = heavy
	run = nix develop --no-update-lock-file -c bash harness/scripts/mutant-tests.sh
[ci]
	budget = cargo.yml 162 600
	budget = harness.yml 80 600
[land]
	workflow = land-check.yml
	check = ** :: CARGO_TARGET_DIR=target bash harness/scripts/check-owners.sh
	check = bin/,src/,crates/,tests/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml,structure.toml,harness/scripts/cargo-tests.sh :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- bash harness/scripts/cargo-tests.sh
	check = src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets --locked --offline -- -D warnings
	check = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target bash harness/scripts/land-checks.sh portable
	check = harness/,agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo run --locked --offline --bin north -- agent-config-check tree-policy
	check = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target bash harness/scripts/land-checks.sh machine-bound
	check = harness/defaults.toml,harness/skills/machine-capacity/scripts/ :: harness/skills/machine-capacity/scripts/build-machine-capacity --check
	check = flake.nix,flake.lock,rust-toolchain.toml,tests/dev-shell.test.sh :: ./bin/depbox run -- bash tests/dev-shell.test.sh
	check = "agent-machinery/ :: bash -euc 'cd agent-machinery; ../bin/land-shell -- bun install --frozen-lockfile; ../bin/land-shell -- bun test; ../bin/land-shell -- bun run check'"
	check = ** :: CARGO_TARGET_DIR=target bash harness/scripts/citation-check.sh
	local-only = reads the south and nixos-config checkouts beside north :: CARGO_TARGET_DIR=target bash harness/scripts/check-owners.sh
	local-only = "needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests) :: CARGO_TARGET_DIR=target bash harness/scripts/land-checks.sh machine-bound"
	local-only = "tests the Nix dev shell, which the Actions runner does not build :: ./bin/depbox run -- bash tests/dev-shell.test.sh"
	local-only = runs the held north runtime when the CLI and the checker are unchanged since it :: CARGO_TARGET_DIR=target bash harness/scripts/citation-check.sh
	runner = build-host
