[landing]
	capacity = north capacity host run --class heavy --owner land-check --priority tom-ask --timeout-seconds 3600 --
	exact = true
	queue = lander
	lander-host = whiterabbit
	push-app = lander
	remote-hosts = gex45 ccx33
[mutant]
	class = heavy
	run = ./bin/head-north --code crates/north-core/src/capacity/dev_shell.rs,src/cli/ dev-shell run -- bash harness/scripts/mutant-tests.sh
	source = ":(glob)src/**/*.rs"
	source = ":(glob)crates/*/src/**/*.rs"
	source = ":(exclude,glob)**/*tests*.rs"
	source = ":(exclude,glob)**/tests/**"
[flake]
	build = cargo test --locked --offline --no-run --message-format=json-render-diagnostics
[ci]
	budget = cargo.yml 162 600
	budget = harness.yml 80 600
[land]
	check-local = true
	check = "src/cli/verbs.rs :: sed -n '/VerbKinds::new(&[[]$/,/^]);$/{//!p}' src/cli/verbs.rs | LC_ALL=C sort -c -u"
	check = "tests/it/main.rs,tests/it/crates.txt :: ! grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort | uniq -d | grep . && comm -3 <(sed -n 's/^mod //p' tests/it/main.rs | tr -d ';' | LC_ALL=C sort -u) <(grep -v '^#' tests/it/crates.txt | cut -d ' ' -f1 | LC_ALL=C sort -u) | { ! grep .; }"
	check = structure.toml,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-guard/src/code_health/ --no-build code-health layers ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	check = harness/,agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/agent_config_check/ --no-build agent-config-check tree-policy
	check = agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/package_check.rs --no-build config check
	check = docs/features.md,docs/features/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/features_index/ --no-build docs features-index --check
	check = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/rationale_index/ --no-build docs rationale-index --check
	check = flake.lock,harness/nix/lock-allow.toml :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/doctor_nix/ --no-build doctor nix --lock flake.lock --allow harness/nix/lock-allow.toml
	check = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/citation_check/ --no-build citation-check --root $PWD
	check = harness/scripts/,harness/lib/,bin/,.safe-push,flake.nix :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-landing/src/land/scans/nix_entry.rs --no-build land scan nix-entry ${SAFE_PUSH_LAND_HEAD}
	check = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/experiments/ --no-build experiments check --root .
	check = harness/,agent-machinery/file-skills.toml,north-data/private-checks.toml,north-data/expectations.toml,docs/feedback-loop.md :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-base/src/run_time_data.rs,crates/north-base/src/run_time_data/allowed.rs,crates/north-base/src/build_inputs.rs --no-build land scan run-time-data ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	after = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,flake.nix,flake.lock,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo clippy --all-targets ${SAFE_PUSH_LAND_CHANGED:---workspace} --locked --offline -- -D warnings
	after = structure.toml,src/,crates/,tests/,examples/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-guard/src/code_health/ code-health layers ${SAFE_PUSH_LAND_BASE} ${SAFE_PUSH_LAND_HEAD}
	after = harness/,agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/agent_config_check/ agent-config-check tree-policy
	after = agent-machinery/ :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/package_check.rs config check
	after = docs/features.md,docs/features/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/features_index/ docs features-index --check
	after = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-ops/src/ops/docs.rs,crates/north-ops/src/ops/rationale_index/ docs rationale-index --check
	after = flake.lock,harness/nix/lock-allow.toml :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/doctor_nix/,src/cli/ doctor nix --lock flake.lock --allow harness/nix/lock-allow.toml
	after = ** :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-ops/src/ops/citation_check/ citation-check --root $PWD
	after = harness/scripts/,harness/lib/,bin/,.safe-push,flake.nix :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-landing/src/land/scans/nix_entry.rs land scan nix-entry ${SAFE_PUSH_LAND_HEAD}
	after = docs/rationale/,src/,crates/,Cargo.toml,Cargo.lock :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-ops/src/ops/experiments/ experiments check --root .
	after = harness/,agent-machinery/file-skills.toml,north-data/private-checks.toml,north-data/expectations.toml,docs/feedback-loop.md :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-base/src/run_time_data.rs,crates/north-base/src/build_inputs.rs land scan run-time-data ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after = @rust-input,src/,crates/,tests/,examples/,Cargo.toml,Cargo.lock,build.rs,rust-toolchain.toml :: CARGO_TARGET_DIR=target ./bin/land-shell --dev -- cargo nextest run --locked --offline ${SAFE_PUSH_LAND_PACKAGES:---workspace} --lib --bins ${SAFE_PUSH_LAND_IT:---test it -E kind(lib)|kind(bin)|binary_id(north::it)}
	after = src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land-tests --select changed --only portable
	after = src/,crates/,tests/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-landing/src/land/scans/test_admission.rs,crates/north-landing/src/landing/fails_first.rs,src/cli/ land scan test-admission run ${SAFE_PUSH_LAND_BASE}..${SAFE_PUSH_LAND_HEAD}
	after = bin/,lib/,harness/,src/,crates/,Cargo.toml,Cargo.lock,build.rs :: CARGO_TARGET_DIR=target ./bin/head-north land-tests --select changed --only machine-bound
	after = "agent-machinery/ :: bash -euc 'cd agent-machinery; ../bin/land-shell -- bun install --frozen-lockfile; ../bin/land-shell -- bun test'"
	machine-bound = reads the south and nixos-config checkouts beside north :: CARGO_TARGET_DIR=target ./bin/head-north --code crates/north-core/src/catalog/,crates/north-core/src/agent_catalog.rs,crates/north-base/ config agents check-owners --north-root $PWD --south-root $HOME/code/south/main --nixos-root $HOME/code/nixos-config/main # hardcoded-repo-path:allow
	machine-bound = "needs ~/code checkouts, a systemd user manager, live agent state or shellcheck 0.11 (harness/machine-bound-tests) :: CARGO_TARGET_DIR=target ./bin/head-north land-tests --select changed --only machine-bound"
	machine-bound = "main's CI does not run the agent-machinery bun tests :: bash -euc 'cd agent-machinery; ../bin/land-shell -- bun install --frozen-lockfile; ../bin/land-shell -- bun test'"
	machine-bound = runs the live runtime's north when the citation checker is unchanged since it :: CARGO_TARGET_DIR=target ./bin/head-north --code src/cli/,crates/north-ops/src/ops/citation_check/ citation-check --root $PWD
	runner = build-host
[test-admission]
	contract = file-or-wire-format :: a format another program or a past north writes or reads: ledgers, trailers, transcripts, the GitHub and Claude APIs, git output
