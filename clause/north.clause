    ?view = "goals"
    ?north next view handler ?next
    ?north previous view handler ?previous
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
  include
    ?north active view "chat"
    ?north next view handler "view-chat-next"
    ?north previous view handler "view-chat-previous"

on view-goals-previous ?north
  when
