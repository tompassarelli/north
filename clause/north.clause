on command-archived ?north ?command
  when
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "archived-conversations"
    ?north effect payload remaining-words(?command)

on command-archive ?north ?command
  when
    (remaining-words(?command) = "confirm") = false
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice "Archive this conversation and its related agents? Run /archive confirm. Restore conversations from /archived."

on command-archive ?north ?command
  when
    remaining-words(?command) = "confirm"
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context turn readiness ?readiness
    (?readiness = "turn-ready") = false
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice "Finish or interrupt the current request before archiving."

on command-archive ?north ?command
  when
    remaining-words(?command) = "confirm"
    ?north active conversation ?conversation
    (?conversation = "") = false
    ?context conversation id ?conversation
    ?context turn readiness "turn-ready"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "archive-conversation"
    ?north effect payload ?conversation

on observe-archived ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context turn readiness ?readiness
    ?context context attached ?attached
  withdraw
    ?context turn readiness ?readiness
    ?context context attached ?attached
  include
    ?context turn readiness "turn-paused"
    ?context context attached false

on observe-restored ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context turn readiness ?readiness
  withdraw
    ?context turn readiness ?readiness
  include
    ?context turn readiness "turn-ready"

on history-action-completed ?north ?action
  when
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice if(?action = "rename", "Conversation renamed.", if(?action = "archive", "Conversation archived. Restore it from /archived.", "Conversation restored."))

on command-model ?north ?command
  when
    ?command = "/model"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "select-model"
    ?north effect payload ""

on command-effort ?north ?command
