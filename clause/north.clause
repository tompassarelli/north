relation chat-appearance
  reads appearance of {kind: Text} with {status: Text} as {style: Text}
  mode given kind status yields style: maybe

law chat-appearance
  if
    ?kind = ?kind
    ?status = ?status
  then
    appearance of ?kind with ?status as if(?kind = "userMessage", "operator", if(?kind = "operator", "operator", if(?kind = "agentMessage", "markdown", if(?kind = "commandExecution", if(?status = "completed", "command-success", if(?status = "inProgress", "command-running", "command-failure")), if(?kind = "fileChange", "diff", if(?kind = "diff", "diff", ?kind))))))

derive chat-appearance

