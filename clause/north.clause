connection-state:
  ?example:
    north: North
    value: Text
    ?north:
      connection state: ?value

mode connection-state given north yields value: one

north-main connection state "connected"

on connection-lost ?north
  when
    ?north connection state ?prior
    ?north notice ?notice
  withdraw
    ?north connection state ?prior
    ?north notice ?notice
  include
    ?north connection state "disconnected"
    ?north notice "Connection lost. Drafts and queued messages are kept; unconfirmed messages will not be resent."

on pause-disconnected-inputs ?north
  when
    ?north known pending input ?input
    ?input input status ?status
    (?status = "accepted") = false
  withdraw
    ?input input status ?status
  include
    ?input input status if(?status = "queued", "paused", if(?status = "waiting to steer", "not sent", if(?status = "sending", "delivery unknown", if(?status = "submitted", "delivery unknown", if(?status = "sending correction", "delivery unknown", ?status)))))

on disconnect-prompts ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt live ?live
    ?live = true
    ?prompt prompt status ?status
  withdraw
    ?prompt prompt live ?live
    ?prompt prompt status ?status
  include
    ?prompt prompt live false
    ?prompt prompt status if(?status = "resolved", "resolved", if(?status = "waiting", "disconnected", "delivery unknown"))

on begin-reconnect ?north
  when
    ?north connection state ?prior
    ?prior = "disconnected"
    ?north notice ?notice
  withdraw
    ?north connection state ?prior
    ?north notice ?notice
  include
    ?north connection state "connecting"
    ?north notice "Reconnecting…"

on finish-reconnect ?north ?success
  when
    ?north connection state ?prior
    ?north notice ?notice
  withdraw
    ?north connection state ?prior
    ?north notice ?notice
  include
    ?north connection state if(?success, "connected", "failed")
    ?north notice if(?success, "Reconnected. Paused messages need review; Alt+↑ edits the next unsent message.", "Could not reconnect. Drafts are kept. Use /reconnect to try again.")

on command-reconnect ?north ?command
  when
    ?north connection state ?prior
    ?north notice ?notice
  withdraw
    ?north connection state ?prior
    ?north notice ?notice
  include
    ?north connection state if(?prior = "failed", "disconnected", ?prior)
    ?north notice if(?prior = "connected", "Already connected.", "Reconnecting…")

on begin-conversation-reconciliation ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?context turn readiness ?ready
    ?context active turn ?turn
  withdraw
    ?context phase ?phase
    ?context turn readiness ?ready
    ?context active turn ?turn
  include
    ?context phase "idle"
    ?context turn readiness "turn-ready"
    ?context active turn ""

