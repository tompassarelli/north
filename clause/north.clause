relation goal-action
  reads goal action of {input: Text} as {action: Text}
  mode given input yields action: maybe

law parse-goal-action
  if
    ?input = ?input
  then
    goal action of ?input as if(first-word(remaining-words(?input)) = "edit", "edit", if(first-word(remaining-words(?input)) = "clear", "clear", "set"))

relation goal-text
  reads goal text of {input: Text} as {text: Text}
  mode given input yields text: maybe

law parse-goal-text
  if
    ?input = ?input
  then
    goal text of ?input as trim(if(first-word(remaining-words(?input)) = "set", remaining-words(remaining-words(?input)), if(first-word(remaining-words(?input)) = "edit", remaining-words(remaining-words(?input)), if(first-word(remaining-words(?input)) = "clear", remaining-words(remaining-words(?input)), remaining-words(?input)))))

derive parse-goal-action
derive parse-goal-text

