relation known-reference
  reads {north: North} known reference {value: Reference}
  subject north
  mode given north yields value: many
relation reference-name
  reads {reference: Reference} reference name {value: Text}
  subject reference
  mode given reference yields value: one
relation reference-description
  reads {reference: Reference} reference description {value: Text}
  subject reference
  mode given reference yields value: one
relation reference-kind
  reads {reference: Reference} reference kind {value: Text}
  subject reference
  mode given reference yields value: one
relation reference-path
