referent North
referent NorthPhase
referent TurnReadiness
referent AgentRunIdentity
referent ConversationChange
referent ConversationIdentity
referent F64
referent idle
referent dispatching
referent delegating
referent settling
referent completed
referent failed
referent turn-ready
referent turn-active
referent no-agent-run
referent conversation-ready
referent conversation-opening
referent conversation-switching
referent no-conversation

relation phase
  reads {north: North} phase {value: NorthPhase}
  subject north
  mode given north yields value: one

relation active-delegated-child
  reads {north: North} active delegated child {value: AgentRunIdentity}
  subject north
  mode given north yields value: one

relation terminal-delegated-child
  reads {north: North} terminal delegated child {value: AgentRunIdentity}
  subject north
  mode given north yields value: one

relation turn-readiness
  reads {north: North} turn readiness {value: TurnReadiness}
  subject north
  mode given north yields value: one

relation conversation-change
  reads {north: North} conversation change {value: ConversationChange}
  subject north
  mode given north yields value: one

relation active-conversation
  reads {north: North} active conversation {value: ConversationIdentity}
  subject north
  mode given north yields value: one

relation pending-conversation
  reads {north: North} pending conversation {value: ConversationIdentity}
  subject north
  mode given north yields value: one

relation known-conversation
  reads {north: North} known conversation {value: ConversationIdentity}
  subject north
  mode given north yields value: many

relation draft-number
  reads {north: North} draft number {value: F64}
  subject north
  mode given north yields value: one

relation next-attachment-number
  reads {north: North} next attachment number {value: F64}
  subject north
  mode given north yields value: one

relation draft-attachment
  reads {north: North} draft attachment {value: F64}
  subject north
  mode given north yields value: many

relation submitted-attachment
  reads {north: North} submitted attachment {value: F64}
  subject north
  mode given north yields value: many

north-main ∈ North
north-main phase idle
north-main turn readiness turn-ready
north-main active delegated child no-agent-run
north-main terminal delegated child no-agent-run
north-main conversation change conversation-ready
north-main active conversation no-conversation
north-main pending conversation no-conversation
north-main draft number 1.0
north-main next attachment number 1.0

on inspect ?north
  when
    ?north phase ?phase
  withdraw
    ?north phase ?phase
  include
    ?north phase ?phase

on observe-conversation ?north ?conversation
  when
    ?north conversation change ?change
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change ?change
    ?north known conversation ?conversation

on attach-image ?north
  when
    ?north next attachment number ?attachment
  withdraw
    ?north next attachment number ?attachment
  include
    ?north next attachment number ?attachment + 1.0
    ?north draft attachment ?attachment

on detach-image ?north ?attachment
  when
    ?north next attachment number ?next
    ?north draft attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?north draft attachment ?attachment
  include
    ?north next attachment number ?next

on copy-submission-attachment ?north ?attachment
  when
    ?north draft number ?draft
    ?north draft attachment ?attachment
  withdraw
    ?north draft number ?draft
  include
    ?north draft number ?draft
    ?north submitted attachment ?attachment

on clear-submitted-attachment ?north ?attachment
  when
    ?north next attachment number ?next
    ?north submitted attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?north submitted attachment ?attachment
  include
    ?north next attachment number ?next

on request-new-conversation ?north
  when
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north conversation change ?change
    ?change = conversation-ready
    ?north pending conversation ?pending
    ?pending = no-conversation
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change conversation-opening
    ?north pending conversation no-conversation

on settle-new-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = conversation-opening
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = no-conversation
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
  include
    ?north conversation change conversation-ready
    ?north active conversation ?conversation
    ?north known conversation ?conversation

on fail-new-conversation ?north
  when
    ?north conversation change ?change
    ?change = conversation-opening
    ?north pending conversation ?pending
    ?pending = no-conversation
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change conversation-ready

on request-switch-conversation ?north ?conversation
  when
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north conversation change ?change
    ?change = conversation-ready
    ?north known conversation ?conversation
    ?north pending conversation ?pending
    ?pending = no-conversation
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change conversation-switching
    ?north pending conversation ?conversation

on settle-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = conversation-switching
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
    ?north pending conversation ?pending
  include
    ?north conversation change conversation-ready
    ?north active conversation ?conversation
    ?north pending conversation no-conversation

on fail-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = conversation-switching
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change conversation-ready
    ?north pending conversation no-conversation

on submit ?north
  when
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?north terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?north phase dispatching
    ?north turn readiness turn-active
    ?north terminal delegated child no-agent-run
    ?north draft number ?draft + 1.0

on delegate ?north
  when
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?north terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?north phase delegating
    ?north turn readiness turn-active
    ?north terminal delegated child no-agent-run
    ?north draft number ?draft + 1.0

on child-spawned ?north ?child
  when
    ?north phase ?phase
    ?phase = delegating
    ?north active delegated child ?previous-child
    ?previous-child = no-agent-run
  withdraw
    ?north phase ?phase
    ?north active delegated child ?previous-child
  include
    ?north phase settling
    ?north active delegated child ?child

on settle-success ?north
  when
    ?north phase ?phase
    ?phase = dispatching
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase completed
    ?north turn readiness turn-ready

on settle-failure ?north
  when
    ?north phase ?phase
    ?phase = dispatching
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north turn readiness turn-ready

on settle-delegation-success ?north ?child
  when
    ?north phase ?phase
    ?phase = settling
    ?north active delegated child ?active-child
    ?active-child = ?child
    ?north terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = no-agent-run
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north active delegated child ?active-child
    ?north terminal delegated child ?previous-terminal-child
    ?north turn readiness ?readiness
  include
    ?north phase completed
    ?north active delegated child no-agent-run
    ?north terminal delegated child ?child
    ?north turn readiness turn-ready

on fail-delegation-before-child ?north
  when
    ?north phase ?phase
    ?phase = delegating
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north turn readiness turn-ready

on fail-delegation-after-child ?north ?child
  when
    ?north phase ?phase
    ?phase = settling
    ?north active delegated child ?active-child
    ?active-child = ?child
    ?north terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = no-agent-run
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north active delegated child ?active-child
    ?north terminal delegated child ?previous-terminal-child
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north active delegated child no-agent-run
    ?north terminal delegated child ?child
    ?north turn readiness turn-ready
