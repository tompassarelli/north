relation phase
  reads {north: North} phase {value: Text}
  subject north
  mode given north yields value: one

relation known-chat-entry
  reads {north: North} known chat entry {entry: ChatEntry}
  subject north
  mode given north yields entry: many

relation next-chat-order
  reads {north: North} next chat order {value: F64}
  subject north
  mode given north yields value: one

