relation input-editable
  reads input status {status: Text} editable {allowed: Bool}
  mode given status yields allowed: maybe

law editable-input-status
  if
    ?status = ?status
  then
    input status ?status editable if(?status = "queued", true, if(?status = "not sent", true, ?status = "waiting to steer"))

derive editable-input-status

