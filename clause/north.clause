    ?north next view handler "view-chat-next"
    ?north previous view handler "view-chat-previous"



on observe-conversation ?north ?conversation
  when
    ?north conversation change ?change
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change ?change
    ?north known conversation ?conversation

on attach-image ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north next attachment number ?attachment
  withdraw
    ?north next attachment number ?attachment
  include
    ?north next attachment number ?attachment + 1.0
    ?context draft attachment ?attachment

on detach-image ?north ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north next attachment number ?next
    ?context draft attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?context draft attachment ?attachment
  include
    ?north next attachment number ?next

on copy-submission-attachment ?north ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north draft number ?draft
    ?context draft attachment ?attachment
  withdraw
    ?north draft number ?draft
  include
    ?north draft number ?draft
    ?context submitted attachment ?attachment

on clear-submitted-attachment ?north ?conversation ?attachment
  when
    ?context conversation id ?conversation
    ?north next attachment number ?next
    ?context submitted attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?context submitted attachment ?attachment
  include
    ?north next attachment number ?next

on request-new-conversation ?north
  when
    ?north conversation change ?change
    ?change = "conversation-ready"
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-opening"
    ?north pending conversation ""

on settle-new-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-opening"
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
  include
    ?north conversation change "conversation-ready"
    ?north active conversation ?conversation
    ?north known conversation ?conversation

on fail-new-conversation ?north
  when
    ?north conversation change ?change
    ?change = "conversation-opening"
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change "conversation-ready"

on request-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-ready"
    ?north known conversation ?conversation
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-switching"
    ?north pending conversation ?conversation

on settle-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-switching"
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-ready"
    ?north active conversation ?conversation
    ?north pending conversation ""

on fail-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-switching"
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-ready"
    ?north pending conversation ""

on submit ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?context phase "dispatching"
    ?context turn readiness "turn-active"
    ?context terminal delegated child ""
    ?north draft number ?draft + 1.0

on delegate ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?context phase "delegating"
    ?context turn readiness "turn-active"
    ?context terminal delegated child ""
    ?north draft number ?draft + 1.0

on child-spawned ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "delegating"
    ?context active delegated child ?previous-child
    ?previous-child = ""
  withdraw
    ?context phase ?phase
    ?context active delegated child ?previous-child
  include
    ?context phase "settling"
    ?context active delegated child ?child

on settle-success ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "dispatching"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "completed"
    ?context turn readiness "turn-ready"

on abandon-turn ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"
    ?context active delegated child ""
    ?context terminal delegated child ?child

on settle-interrupted ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  include
    ?context phase "interrupted"
    ?context turn readiness "turn-ready"
    ?context active delegated child ""
    ?context terminal delegated child ?child

on settle-failure ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "dispatching"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"

on settle-delegation-success ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "settling"
    ?context active delegated child ?active-child
    ?active-child = ?child
    ?context terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = ""
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context active delegated child ?active-child
    ?context terminal delegated child ?previous-terminal-child
    ?context turn readiness ?readiness
  include
    ?context phase "completed"
    ?context active delegated child ""
    ?context terminal delegated child ?child
    ?context turn readiness "turn-ready"

on fail-delegation-before-child ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "delegating"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"

on fail-delegation-after-child ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "settling"
    ?context active delegated child ?active-child
    ?active-child = ?child
    ?context terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = ""
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context active delegated child ?active-child
    ?context terminal delegated child ?previous-terminal-child
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context active delegated child ""
    ?context terminal delegated child ?child
    ?context turn readiness "turn-ready"
