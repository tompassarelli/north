north-main menu kind ""
north-main menu title ""
north-main menu query ""
north-main menu help "Type to search · ↑/↓ choose · Enter open · Esc close"
north-main menu empty "No matching conversations"
north-main menu selection 0.0
north-main menu count 0.0
north-main menu row count 0.0

on clear-menu-rows ?north
  when
    ?north known menu row ?row
    ?row menu row key ?key
    ?row menu row label ?label
    ?row menu row description ?description
    ?row menu row annotation ?annotation
    ?row menu row order ?order
    ?row menu row position ?position
    ?row menu row visible ?visible
  withdraw
    ?north known menu row ?row
    ?row menu row key ?key
    ?row menu row label ?label
    ?row menu row description ?description
    ?row menu row annotation ?annotation
    ?row menu row order ?order
    ?row menu row position ?position
    ?row menu row visible ?visible

on open-history-menu ?north ?kind
  when
    ?north menu kind ?prior-kind
    ?north menu title ?prior-title
    ?north menu row count ?count
  withdraw
    ?north menu kind ?prior-kind
    ?north menu title ?prior-title
    ?north menu row count ?count
  include
    ?north menu kind ?kind
    ?north menu title if(?kind = "archived-history", "Archived Conversations", "Resume Conversation")
    ?north menu row count 0.0

on open-settings-menu ?north ?kind ?title
  when
    ?north menu kind ?prior-kind
    ?north menu title ?prior-title
    ?north menu row count ?count
  withdraw
    ?north menu kind ?prior-kind
    ?north menu title ?prior-title
    ?north menu row count ?count
  include
    ?north menu kind ?kind
    ?north menu title ?title
    ?north menu row count 0.0

on offer-settings-row ?north ?key ?label ?description ?annotation
  when
    ?north menu row count ?count
  create
    ?row
      member of: MenuRow
  withdraw
    ?north menu row count ?count
  include
    ?north menu row count ?count + 1.0
    ?north known menu row ?row
    ?row menu row key ?key
    ?row menu row label ?label
    ?row menu row description ?description
    ?row menu row annotation ?annotation
    ?row menu row order ?count
    ?row menu row position ?count
    ?row menu row visible true

on offer-history-row ?north ?key ?label ?description
  when
    ?north menu row count ?count
    ?north active conversation ?conversation
  create
    ?row
      member of: MenuRow
  withdraw
    ?north menu row count ?count
  include
    ?north menu row count ?count + 1.0
    ?north known menu row ?row
    ?row menu row key ?key
    ?row menu row label ?label
    ?row menu row description ?description
    ?row menu row annotation if(?key = ?conversation, "current", "")
    ?row menu row order ?count
    ?row menu row position ?count
    ?row menu row visible true

on query-menu ?north ?query
  when
    ?north menu query ?prior
    ?north menu selection ?selection
  withdraw
    ?north menu query ?prior
    ?north menu selection ?selection
  include
    ?north menu query ?query
    ?north menu selection 0.0

on filter-menu ?north
  when
    ?north menu query ?query
    ?north known menu row ?row
    ?row menu row key ?key
    ?row menu row label ?label
    ?row menu row description ?description
    ?row menu row order ?order
    ?row menu row position ?position
    ?row menu row visible ?visible
    sum 1.0 given ?north ?order ?query where { ?north known menu row ?prior; ?prior menu row order ?number; ?number < ?order; ?prior menu row key ?prior-key; ?prior menu row label ?prior-label; ?prior menu row description ?prior-description; contains-text(lowercase(?prior-label ++ " " ++ ?prior-description ++ " " ++ ?prior-key), lowercase(?query)) = true } as ?rank
  withdraw
    ?row menu row position ?position
    ?row menu row visible ?visible
  include
    ?row menu row position ?rank
    ?row menu row visible contains-text(lowercase(?label ++ " " ++ ?description ++ " " ++ ?key), lowercase(?query))

on count-menu ?north
  when
    ?north menu count ?count
    sum 1.0 given ?north where { ?north known menu row ?row; ?row menu row visible true } as ?matched
  withdraw
    ?north menu count ?count
  include
    ?north menu count ?matched

on move-menu ?north ?delta
  when
    ?north menu count ?count
    ?count > 0.0
    ?north menu selection ?selected
  withdraw
    ?north menu selection ?selected
  include
    ?north menu selection if(?selected + ?delta < 0.0, ?count - 1.0, if(?selected + ?delta >= ?count, 0.0, ?selected + ?delta))

on close-menu ?north
  when
    ?north menu kind ?kind
  withdraw
    ?north menu kind ?kind
  include
    ?north menu kind ""

on accept-menu ?north
  when
    ?north menu kind ?kind
    if(?kind = "history", true, ?kind = "archived-history") = true
    ?north menu selection ?selected
    ?north known menu row ?row
    ?row menu row visible true
    ?row menu row position ?selected
    ?row menu row key ?conversation
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north menu kind ?kind
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north menu kind ""
    ?north host effect if(?kind = "archived-history", "restore-conversation", "switch-conversation")
    ?north effect payload ?conversation

on accept-menu ?north
  when
    ?north menu kind ?kind
    if(?kind = "models", true, if(?kind = "efforts", true, ?kind = "config")) = true
    ?north menu selection ?selected
    ?north known menu row ?row
    ?row menu row visible true
    ?row menu row position ?selected
    ?row menu row key ?key
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north menu kind ?kind
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north menu kind ""
    ?north host effect if(?kind = "models", "select-model", if(?kind = "efforts", "select-effort", "toggle-config"))
    ?north effect payload ?key



