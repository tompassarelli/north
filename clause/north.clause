  then
    goal text of ?input as trim(if(first-word(remaining-words(?input)) = "set", remaining-words(remaining-words(?input)), if(first-word(remaining-words(?input)) = "edit", remaining-words(remaining-words(?input)), if(first-word(remaining-words(?input)) = "clear", remaining-words(remaining-words(?input)), remaining-words(?input)))))

derive parse-goal-action
derive parse-goal-text

