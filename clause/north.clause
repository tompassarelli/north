on observe-prompt ?north ?request ?conversation ?turn ?kind ?cancellation
  when
    ?north next prompt number ?number
    sum 1.0 given ?request ?conversation where { ?prior prompt request ?request; ?prior prompt conversation ?conversation; ?prior prompt live true } as ?count
    ?count = 0.0
  create
    ?prompt
      member of: Prompt
  withdraw
    ?north next prompt number ?number
  include
    ?north next prompt number ?number + 1.0
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt request ?request
    ?prompt prompt conversation ?conversation
    ?prompt prompt turn ?turn
    ?prompt prompt kind ?kind
    ?prompt prompt status "waiting"
    ?prompt prompt live true
    ?prompt prompt visible false
    ?prompt prompt current 1.0
    ?prompt prompt cancellation ?cancellation
    ?prompt prompt outcome "answer"

on observe-prompt-question ?north ?number ?position ?key ?header ?text ?secret ?other ?codec ?multiple ?optional
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    sum 1.0 given ?prompt ?position where { ?prompt prompt question ?prior; ?prior question number ?position } as ?count
    ?count = 0.0
  create
    ?question
      member of: PromptQuestion
  include
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question key ?key
    ?question question header ?header
    ?question question text ?text
    ?question question secret ?secret
    ?question question other ?other
    ?question question selected 1.0
    ?question question answer ""
    ?question question answered false
    ?question question text entry false
    ?question question codec ?codec
    ?question question multiple ?multiple
    ?question question optional ?optional
    ?question question problem ""

on observe-prompt-option ?north ?number ?position ?index ?label ?description ?value
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt question ?question
    ?question question number ?position
    sum 1.0 given ?question ?index where { ?question question option ?prior; ?prior option number ?index } as ?count
    ?count = 0.0
  create
    ?option
      member of: PromptOption
  include
    ?question question option ?option
    ?option option number ?index
    ?option option label ?label
    ?option option description ?description
    ?option option value ?value
    ?option option checked false

on focus-prompts ?north
  when
    ?north active conversation ?active
    ?north known prompt ?prompt
    ?prompt prompt conversation ?conversation
    ?prompt prompt number ?number
    ?prompt prompt status ?status
    ?prompt prompt live ?live
    ?prompt prompt visible ?visible
    sum 1.0 given ?conversation ?number where { ?earlier prompt conversation ?conversation; ?earlier prompt number ?prior; ?prior < ?number; ?earlier prompt status ?state; (?state = "resolved") = false; ?earlier prompt live true } as ?count
  withdraw
    ?prompt prompt visible ?visible
  include
    ?prompt prompt visible if(?live, if(?conversation = ?active, if(?status = "resolved", false, ?count = 0.0), false), false)

on present-prompt-questions ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt question ?question
    ?question question selected ?selected
    ?question question other ?other
    ?question question multiple ?multiple
    ?question question text entry ?prior
    sum 1.0 given ?question where { ?question question option ?option } as ?count
  withdraw
    ?question question text entry ?prior
  include
    ?question question text entry if(?multiple = true, false, if(?count = 0.0, true, if(?other = true, ?selected = 0.0, false)))

on navigate-prompt ?north ?direction
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question selected ?selected
    ?question question other ?other
    sum 1.0 given ?question where { ?question question option ?option } as ?count
    ?count > 0.0
  withdraw
    ?question question selected ?selected
  include
    ?question question selected if(?direction > 0.0, if(?selected >= ?count, if(?other = true, 0.0, 1.0), ?selected + 1.0), if(?selected <= if(?other = true, 0.0, 1.0), ?count, ?selected - 1.0))

on answer-prompt-choice ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple false
    ?question question selected ?selected
    ?question question option ?option
    ?option option number ?selected
    ?option option value ?value
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?value
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on toggle-prompt-option ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple true
    ?question question selected ?selected
    ?question question option ?option
    ?option option number ?selected
    ?option option checked ?checked
  withdraw
    ?option option checked ?checked
  include
    ?option option checked (?checked = false)

on answer-prompt-multiple ?north ?text
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple true
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?text
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on skip-prompt-question ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question optional true
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer "null"
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on prompt-answer-problem ?north ?problem
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question problem ?prior
  withdraw
    ?question question problem ?prior
  include
    ?question question problem ?problem

on answer-prompt-text ?north ?text
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question selected ?selected
    ?question question other ?other
    sum 1.0 given ?question where { ?question question option ?option } as ?count
    if(?count = 0.0, true, if(?other = true, ?selected = 0.0, false)) = true
    (trim(?text) = "") = false
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?text
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on prepare-prompt-response ?north
  when
    ?north connection state "connected"
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt number ?number
    ?prompt prompt outcome ?outcome
    sum 1.0 given ?prompt where { ?prompt prompt question ?question; ?question question answered false } as ?unanswered
    if(?outcome = "cancel", true, ?unanswered = 0.0) = true
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?prompt prompt status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?prompt prompt status "sending"
    ?north host effect "answer-prompt"
    ?north effect payload ""
    ?north effect input number ?number

on cancel-prompt ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt outcome ?outcome
    ?prompt prompt cancellation ?cancellation
    (?cancellation = "") = false
  withdraw
    ?prompt prompt outcome ?outcome
  include
    ?prompt prompt outcome "cancel"

on prompt-response-written ?north ?number ?result
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt status ?status
    ?status = "sending"
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status ?result

on resolve-prompt ?north ?conversation ?request
  when
    ?north known prompt ?prompt
    ?prompt prompt live true
    ?prompt prompt conversation ?conversation
    ?prompt prompt request ?request
    ?prompt prompt status ?status
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status "resolved"

on close-turn-prompts ?north ?conversation ?turn
  when
    ?north known prompt ?prompt
    ?prompt prompt conversation ?conversation
    ?prompt prompt turn ?turn
    ?prompt prompt status ?status
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status "resolved"

on clear-resolved-answers ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt status ?status
    ?status = "resolved"
    ?prompt prompt question ?question
    ?question question answer ?answer
  withdraw
    ?question question answer ?answer
  include
    ?question question answer ""

on observe-turn ?north ?conversation ?turn
  when
    ?context conversation id ?conversation
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  withdraw
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context active turn ?turn
    ?context phase if(?readiness = "turn-ready", "dispatching", ?phase)
    ?context turn readiness "turn-active"

on observe-stored-turn ?north ?conversation ?turn ?status
  when
    ?status = "inProgress"
    ?context conversation id ?conversation
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  withdraw
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context active turn ?turn
    ?context phase if(?readiness = "turn-ready", "dispatching", ?phase)
    ?context turn readiness "turn-active"

on clear-turn ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context active turn ?turn
  withdraw
    ?context active turn ?turn
  include
    ?context active turn ""

on finish-observed-turn ?north ?conversation ?turn
  when
    ?context conversation id ?conversation
    ?context active turn ?turn
  withdraw
    ?context active turn ?turn
  include
    ?context active turn ""

on expire-steering ?north ?conversation
  when
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input status ?status
    ?status = "waiting to steer"
  withdraw
    ?input input status ?status
  include
    ?input input status "not sent"

on retain-input ?north ?text ?mode
  when
    ?north connection state ?connection
    ?north active conversation ?conversation
    ?north draft number ?number
  create
    ?input
      member of: PendingInput
  withdraw
    ?north draft number ?number
  include
    ?north draft number ?number + 1.0
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status if(?connection = "connected", if(?mode = "queue", "queued", if(?mode = "direct", "sending", "waiting to steer")), "paused")
    ?input input client id ""

on bind-input-client-id ?north ?number ?client
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input client id ?prior
    ?prior = ""
  withdraw
    ?input input client id ?prior
  include
    ?input input client id ?client

on observe-input-acceptance ?north ?conversation ?client
  when
    (?client = "") = false
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input client id ?client
    ?input input status ?status
  withdraw
    ?input input status ?status
  include
    ?input input status "accepted"

on record-input-acceptance ?north ?number ?result
  when
    ?result = "accepted"
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status ?status
    if(?status = "sending correction", true, ?status = "submitted") = true
    ?input input client id ?client
    ?north next chat order ?order
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat order ?order
    ?entry chat conversation ?conversation
    ?entry chat turn ""
    ?entry chat key ?client
    ?entry chat kind "userMessage"
    ?entry chat text ?text
    ?entry chat status "completed"
    ?entry chat style "operator"
    ?entry chat visible false

on input-receipt ?north ?number ?result
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    if(?status = "sending correction", true, if(?status = "sending", true, ?status = "submitted")) = true
  withdraw
    ?input input status ?status
  include
    ?input input status ?result

on prepare-steering ?north
  when
    ?north connection state "connected"
    ?context conversation id ?conversation
    ?context active turn ?turn
    (?turn = "") = false
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input text ?text
    ?input input status ?status
    ?status = "waiting to steer"
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input status ?earlier-status; if(?earlier-status = "waiting to steer", true, ?earlier-status = "sending correction") = true; ?earlier input number ?prior; ?prior < ?number } as ?count
    ?count = 0.0
    sum 1.0 given ?number where { ?earlier input number ?prior; ?prior < ?number; ?earlier input status "waiting to steer"; ?earlier input conversation ?thread; ?other conversation id ?thread; ?other active turn ?active; (?active = "") = false } as ?earlier-ready
    ?earlier-ready = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "sending correction"
    ?north host effect "send-steering"
    ?north effect payload ?text
    ?north effect input number ?number

on retain-queued-attachment ?north ?number ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north known pending input ?input
    ?input input number ?number
    ?context draft attachment ?attachment
  withdraw
    ?context draft attachment ?attachment
  include
    ?input input attachment ?attachment

on prepare-queued-input ?north
  when
    ?north connection state "connected"
    ?context conversation id ?conversation
    ?context phase ?phase
    (?phase = "failed") = false
    (?phase = "interrupted") = false
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input status ?status
    ?status = "queued"
    ?input input text ?text
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input status ?earlier-status; ?earlier-status = "queued"; ?earlier input number ?prior; ?prior < ?number } as ?count
    ?count = 0.0
    sum 1.0 given ?number where { ?earlier input number ?prior; ?prior < ?number; ?earlier input status "queued"; ?earlier input conversation ?thread; ?other conversation id ?thread; ?other turn readiness "turn-ready"; ?other phase ?other-phase; (?other-phase = "failed") = false; (?other-phase = "interrupted") = false } as ?earlier-ready
    ?earlier-ready = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "sending"
    ?north host effect "submit-queued"
    ?north effect payload ?text
    ?north effect input number ?number

on submit-queued ?north ?number
  when
    ?context conversation id ?conversation
    ?context turn readiness ?readiness
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input status ?status
    ?status = "sending"
    ?readiness = "turn-ready"
    ?context phase ?phase
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?input input status ?status
  include
    ?context phase "dispatching"
    ?context turn readiness "turn-active"
    ?input input status "submitted"

on copy-queued-to-submitted ?north ?number ?attachment
  when
    ?context conversation id ?conversation
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input status ?status
    ?status = "sending"
    ?input input attachment ?attachment
  include
    ?context submitted attachment ?attachment

on prepare-input-edit ?north
  when
    ?north active conversation ?conversation
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input text ?text
    ?input input status ?status
    input status ?status editable ?allowed
    ?allowed = true
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input number ?prior; ?prior < ?number; ?earlier input status ?earlier-status; input status ?earlier-status editable ?editable; ?editable = true } as ?count
    ?count = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "editing"
    ?north host effect "edit-pending"
    ?north effect payload ?text
    ?north effect input number ?number

on restore-input-attachment ?north ?number ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    ?status = "editing"
    ?input input attachment ?attachment
  include
    ?context draft attachment ?attachment

on forget-input-attachment ?north ?number ?attachment
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    if(?status = "accepted", true, ?status = "editing") = true
    ?input input attachment ?attachment
  withdraw
    ?input input attachment ?attachment

on forget-input ?north ?number
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input client id ?client
    ?input input status ?status
    if(?status = "accepted", true, ?status = "editing") = true
  withdraw
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input client id ?client
    ?input input status ?status

on append-chat ?north ?conversation ?kind ?text
  when
    ?north next chat order ?order
    appearance of ?kind with "completed" as ?style
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ""
    ?entry chat key ""
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status "completed"
    ?entry chat style ?style
    ?entry chat order ?order

    ?entry chat visible false

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when
    ?north next chat order ?order
    appearance of ?kind with ?status as ?style
    sum 1.0 given ?conversation ?turn ?key ?kind where { ?entry chat conversation ?conversation; ?entry chat turn ?prior-turn; ?entry chat key ?key; if(?prior-turn = ?turn, true, if(?kind = "userMessage", (?key = "") = false, false)) = true } as ?count
    ?count = 0.0
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order

    ?entry chat visible false

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?prior-turn
    ?entry chat key ?key
    if(?prior-turn = ?turn, true, if(?kind = "userMessage", (?key = "") = false, false)) = true
    ?entry chat kind ?prior-kind
    ?entry chat text ?prior-text
    ?entry chat status ?prior-status
    ?entry chat style ?prior-style
    appearance of ?kind with ?status as ?style
  withdraw
    ?entry chat turn ?prior-turn
    ?entry chat kind ?prior-kind
    ?entry chat text ?prior-text
    ?entry chat status ?prior-status
    ?entry chat style ?prior-style
  include
    ?entry chat turn ?turn
    ?entry chat kind ?kind
    ?entry chat text if(?mode = "append", ?prior-text ++ ?text, ?text)
    ?entry chat status ?status
    ?entry chat style ?style

on clear-chat ?north
  when
    ?north active conversation ?conversation
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order
    ?entry chat visible ?visible
  withdraw
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order
    ?entry chat visible ?visible

on initialize ?north
  when
    ?north initialized ?initialized
    ?initialized = "false"
  create
    ?new-command
      member of: Command
    ?resume-command
      member of: Command
    ?model-command
      member of: Command
    ?effort-command
      member of: Command
    ?config-command
      member of: Command
    ?delegate-command
      member of: Command
    ?goal-command
      member of: Command
    ?goals-command
      member of: Command
    ?agents-command
      member of: Command
    ?quit-command
      member of: Command
    ?rename-command
      member of: Command
    ?fork-command
      member of: Command
    ?archive-command
      member of: Command
    ?archived-command
      member of: Command
    ?usage-command
      member of: Command
    ?compact-command
      member of: Command
    ?reconnect-command
      member of: Command
  withdraw
    ?north initialized ?initialized
  include
    ?north initialized "true"
    ?north known command ?new-command
    ?new-command name "/new"
    ?new-command description "start a new conversation"
    ?new-command handler "command-new"
    ?new-command command order 1.0
    ?north known command ?resume-command
    ?resume-command name "/resume"
    ?resume-command description "switch to a previous conversation"
    ?resume-command handler "command-resume"
    ?resume-command command order 2.0
    ?north known command ?model-command
    ?model-command name "/model"
    ?model-command description "choose the active model and reasoning effort"
    ?model-command handler "command-model"
    ?model-command command order 3.0
    ?north known command ?effort-command
    ?effort-command name "/effort"
    ?effort-command description "change reasoning effort for the active model"
    ?effort-command handler "command-effort"
    ?effort-command command order 4.0
    ?north known command ?config-command
    ?config-command name "/config"
    ?config-command description "toggle the context switchboard"
    ?config-command handler "command-config"
    ?config-command command order 5.0
    ?north known command ?delegate-command
    ?delegate-command name "/delegate"
    ?delegate-command description "delegate one explicit task"
    ?delegate-command handler "command-delegate"
    ?delegate-command command order 6.0
    ?north known command ?goal-command
    ?goal-command name "/goal"
    ?goal-command description "set, edit, or clear the selected goal"
    ?goal-command handler "command-goal"
    ?goal-command command order 7.0
    ?north known command ?goals-command
    ?goals-command name "/goals"
    ?goals-command description "inspect Goals"
    ?goals-command handler "command-goals"
    ?goals-command command order 9.0
    ?north known command ?agents-command
    ?agents-command name "/agents"
    ?agents-command description "change selected agent"
    ?agents-command handler "command-agents"
    ?agents-command command order 10.0
    ?north known command ?quit-command
    ?quit-command name "/q"
    ?quit-command description "quit North"
    ?quit-command handler "command-quit"
    ?quit-command command order 12.0
    ?north known command ?rename-command
    ?rename-command name "/rename"
    ?rename-command description "rename the selected conversation"
    ?rename-command handler "command-rename"
    ?rename-command command order 13.0
    ?north known command ?fork-command
    ?fork-command name "/fork"
    ?fork-command description "continue a copy of this conversation"
    ?fork-command handler "command-fork"
    ?fork-command command order 14.0
    ?north known command ?archive-command
    ?archive-command name "/archive"
    ?archive-command description "archive this conversation and its related agents"
    ?archive-command handler "command-archive"
    ?archive-command command order 15.0
    ?north known command ?archived-command
    ?archived-command name "/archived"
    ?archived-command description "find and restore archived conversations"
    ?archived-command handler "command-archived"
    ?archived-command command order 16.0
    ?north known command ?usage-command
    ?usage-command name "/usage"
    ?usage-command description "inspect context, limits, and reset availability"
    ?usage-command handler "command-usage"
    ?usage-command command order 17.0
    ?north known command ?compact-command
    ?compact-command name "/compact"
    ?compact-command description "make more room in this conversation"
    ?compact-command handler "command-compact"
    ?compact-command command order 18.0
    ?north known command ?reconnect-command
    ?reconnect-command name "/reconnect"
    ?reconnect-command description "restore the connection without resending messages"
    ?reconnect-command handler "command-reconnect"
    ?reconnect-command command order 19.0

on inspect ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
  withdraw
    ?context phase ?phase
  include
    ?context phase ?phase

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = true
    ?north known command ?command
    ?command name ?name
    ?name = first-word(?input)
    ?command handler ?handler
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  include
    ?north input dispatch ?handler
    ?north input payload trim(?input)
    ?north input kind "command"

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = false
    ?north input handler ?handler
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  include
    ?north input dispatch ?handler
    ?north input payload ?input
    ?north input kind "message"

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = true
    sum 1.0 given ?north ?input where { ?north known command ?command; ?command name ?name; ?name = first-word(?input) } as ?count
    ?count = 0.0
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
    ?north notice ?notice
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
    ?north notice ?notice
  include
    ?north input dispatch ""
    ?north input payload ""
    ?north input kind "command"
    ?north notice "Unknown command: " ++ first-word(?input)

on select-goal ?north ?goal
  when
    ?north known goal ?goal
    ?north active goal ?previous
  withdraw
    ?north active goal ?previous
  include
    ?north active goal ?goal

on command-new ?north ?command
  when
    ?command = "/new"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "new-conversation"
    ?north effect payload ""

on command-resume ?north ?command
  when
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "resume-conversation"
    ?north effect payload remaining-words(?command)

on command-rename ?north ?command
  when
    (remaining-words(?command) = "") = false
    ?north active conversation ?conversation
    (?conversation = "") = false
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "rename-conversation"
    ?north effect payload remaining-words(?command)

on command-rename ?north ?command
  when
    remaining-words(?command) = ""
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice "Usage: /rename New conversation name"

on command-fork ?north ?command
  when
