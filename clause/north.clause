  subject reference
  mode given reference yields value: one
relation reference-number
  reads {reference: Reference} reference number {value: F64}
  subject reference
  mode given reference yields value: one
relation reference-query
  reads {north: North} reference query {value: Text}
  subject north
  mode given north yields value: one
relation reference-count
  reads {north: North} reference count {value: F64}
  subject north
  mode given north yields value: one
relation reference-selection
