  subject north
  mode given north yields value: one
relation references-open
  reads {north: North} references open {value: Bool}
  subject north
  mode given north yields value: one

north-main reference query ""
north-main reference count 0.0
north-main reference selection 0.0
north-main references open false

on clear-references ?north
  when
    ?north known reference ?reference
    ?reference reference name ?name
    ?reference reference description ?description
    ?reference reference kind ?kind
    ?reference reference path ?path
    ?reference reference number ?number
  withdraw
    ?north known reference ?reference
    ?reference reference name ?name
    ?reference reference description ?description
    ?reference reference kind ?kind
    ?reference reference path ?path
    ?reference reference number ?number

on query-references ?north ?query
  when
    ?north reference query ?prior
    ?north reference count ?count
    ?north reference selection ?selection
    ?north references open ?open
  withdraw
    ?north reference query ?prior
    ?north reference count ?count
    ?north reference selection ?selection
    ?north references open ?open
  include
    ?north reference query ?query
    ?north reference count 0.0
    ?north reference selection 0.0
    ?north references open true

on offer-reference ?north ?name ?description ?kind ?path
  when
    ?north reference query ?query
    ?north reference count ?count
    if(?kind = "file", true, if(?kind = "skill", true, ?kind = "hook")) = true
    if(contains-text(lowercase(?name), lowercase(?query)), true, contains-text(lowercase(?description), lowercase(?query))) = true
  create
    ?reference
      member of: Reference
  withdraw
    ?north reference count ?count
  include
    ?north reference count ?count + 1.0
    ?north known reference ?reference
    ?reference reference name ?name
    ?reference reference description ?description
    ?reference reference kind ?kind
    ?reference reference path ?path
    ?reference reference number ?count

on move-reference ?north ?delta
  when
    ?north reference selection ?selected
    ?north reference count ?count
    ?count > 0.0
  withdraw
    ?north reference selection ?selected
  include
    ?north reference selection if(?selected + ?delta < 0.0, ?count - 1.0, if(?selected + ?delta >= ?count, 0.0, ?selected + ?delta))

on dismiss-references ?north
  when
    ?north references open ?open
  withdraw
    ?north references open ?open
  include
    ?north references open false

relation known-context
  reads {north: North} known context {value: Conversation}
  subject north
  mode given north yields value: many

relation conversation-id
  reads {context: Conversation} conversation id {value: Text}
  subject context
  mode given context yields value: one

relation saved-draft
  reads {context: Conversation} saved draft {value: Text}
  subject context
  mode given context yields value: one

relation transcript-query
  reads {context: Conversation} transcript query {value: Text}
  subject context
  mode given context yields value: one

relation transcript-offset
  reads {context: Conversation} transcript offset {value: F64}
  subject context
  mode given context yields value: one

relation transcript-limit
  reads {context: Conversation} transcript limit {value: F64}
  subject context
  mode given context yields value: one

relation transcript-changes
  reads {context: Conversation} transcript changes {value: Bool}
  subject context
  mode given context yields value: one

relation chat-visible
  reads {entry: ChatEntry} chat visible {value: Bool}
  subject entry
  mode given entry yields value: one

on filter-transcript ?north
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context transcript query ?query
    ?context transcript changes ?changes
    ?north known chat entry ?entry
    ?entry chat conversation ?thread
    ?entry chat text ?text
    ?entry chat kind ?kind
    ?entry chat visible ?visible
  withdraw
    ?entry chat visible ?visible
  include
    ?entry chat visible if(?thread = ?conversation, if(?changes = true, if(?kind = "fileChange", contains-text(lowercase(?text), lowercase(?query)), if(?kind = "diff", contains-text(lowercase(?text), lowercase(?query)), false)), contains-text(lowercase(?text), lowercase(?query))), false)

on search-transcript ?north ?query
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context transcript query ?prior
    ?context transcript offset ?offset
  withdraw
    ?context transcript query ?prior
    ?context transcript offset ?offset
  include
    ?context transcript query ?query
    ?context transcript offset 0.0

on scroll-transcript ?north ?delta
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context transcript offset ?offset
    ?context transcript limit ?limit
  withdraw
    ?context transcript offset ?offset
  include
    ?context transcript offset if(?offset + ?delta < 0.0, 0.0, if(?offset + ?delta > ?limit, ?limit, ?offset + ?delta))

on size-transcript ?north ?limit
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context transcript offset ?offset
    ?context transcript limit ?prior
  withdraw
    ?context transcript offset ?offset
    ?context transcript limit ?prior
  include
    ?context transcript offset if(?offset > ?limit, ?limit, ?offset)
    ?context transcript limit ?limit

on toggle-changes ?north
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context transcript changes ?changes
    ?context transcript offset ?offset
  withdraw
    ?context transcript changes ?changes
    ?context transcript offset ?offset
  include
    ?context transcript changes (?changes = false)
    ?context transcript offset 0.0

relation context-model
  reads {context: Conversation} context model {value: Text}
  subject context
  mode given context yields value: one

relation context-effort
  reads {context: Conversation} context effort {value: Text}
  subject context
  mode given context yields value: one

relation context-attached
  reads {context: Conversation} context attached {value: Bool}
  subject context
  mode given context yields value: one

on observe-settings ?north ?conversation ?model ?effort
  when
    ?context conversation id ?conversation
    ?context context model ?prior-model
    ?context context effort ?prior-effort
    ?context context attached ?attached
  withdraw
    ?context context model ?prior-model
    ?context context effort ?prior-effort
    ?context context attached ?attached
  include
    ?context context model ?model
    ?context context effort ?effort
    ?context context attached true

on ensure-context ?north ?conversation
  when
    ?north active conversation ?active
    sum 1.0 given ?conversation where { ?context conversation id ?conversation } as ?count
    ?count = 0.0
  create
    ?context
      member of: Conversation
  include
    ?north known context ?context
    ?context conversation id ?conversation
    ?context phase "idle"
    ?context active turn ""
    ?context turn readiness "turn-ready"
    ?context active delegated child ""
    ?context terminal delegated child ""
    ?context saved draft ""
    ?context transcript query ""
    ?context transcript offset 0.0
    ?context transcript limit 0.0
    ?context transcript changes false
    ?context context model "Codex default"
    ?context context effort "default"
    ?context context attached false

on save-draft ?north ?text
  when
    ?north active conversation ?conversation
    ?context conversation id ?conversation
    ?context saved draft ?prior
  withdraw
    ?context saved draft ?prior
  include
    ?context saved draft ?text

