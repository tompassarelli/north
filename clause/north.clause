on observe-prompt ?north ?request ?conversation ?turn ?kind ?cancellation
  when
    ?north next prompt number ?number
    sum 1.0 given ?request ?conversation where { ?prior prompt request ?request; ?prior prompt conversation ?conversation } as ?count
    ?count = 0.0
  create
    ?prompt
      member of: Prompt
  withdraw
    ?north next prompt number ?number
  include
    ?north next prompt number ?number + 1.0
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt request ?request
    ?prompt prompt conversation ?conversation
    ?prompt prompt turn ?turn
    ?prompt prompt kind ?kind
    ?prompt prompt status "waiting"
    ?prompt prompt visible false
    ?prompt prompt current 1.0
    ?prompt prompt cancellation ?cancellation
    ?prompt prompt outcome "answer"

on observe-prompt-question ?north ?number ?position ?key ?header ?text ?secret ?other ?codec ?multiple ?optional
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    sum 1.0 given ?prompt ?position where { ?prompt prompt question ?prior; ?prior question number ?position } as ?count
    ?count = 0.0
  create
    ?question
      member of: PromptQuestion
  include
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question key ?key
    ?question question header ?header
    ?question question text ?text
    ?question question secret ?secret
    ?question question other ?other
    ?question question selected 1.0
    ?question question answer ""
    ?question question answered false
    ?question question text entry false
    ?question question codec ?codec
    ?question question multiple ?multiple
    ?question question optional ?optional
    ?question question problem ""

on observe-prompt-option ?north ?number ?position ?index ?label ?description ?value
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt question ?question
    ?question question number ?position
    sum 1.0 given ?question ?index where { ?question question option ?prior; ?prior option number ?index } as ?count
    ?count = 0.0
  create
    ?option
      member of: PromptOption
  include
    ?question question option ?option
    ?option option number ?index
    ?option option label ?label
    ?option option description ?description
    ?option option value ?value
    ?option option checked false

on focus-prompts ?north
  when
    ?north active conversation ?active
    ?north known prompt ?prompt
    ?prompt prompt conversation ?conversation
    ?prompt prompt number ?number
    ?prompt prompt status ?status
    ?prompt prompt visible ?visible
    sum 1.0 given ?conversation ?number where { ?earlier prompt conversation ?conversation; ?earlier prompt number ?prior; ?prior < ?number; ?earlier prompt status ?state; (?state = "resolved") = false } as ?count
  withdraw
    ?prompt prompt visible ?visible
  include
    ?prompt prompt visible if(?conversation = ?active, if(?status = "resolved", false, ?count = 0.0), false)

on present-prompt-questions ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt question ?question
    ?question question selected ?selected
    ?question question other ?other
    ?question question multiple ?multiple
    ?question question text entry ?prior
    sum 1.0 given ?question where { ?question question option ?option } as ?count
  withdraw
    ?question question text entry ?prior
  include
    ?question question text entry if(?multiple = true, false, if(?count = 0.0, true, if(?other = true, ?selected = 0.0, false)))

on navigate-prompt ?north ?direction
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question selected ?selected
    ?question question other ?other
    sum 1.0 given ?question where { ?question question option ?option } as ?count
    ?count > 0.0
  withdraw
    ?question question selected ?selected
  include
    ?question question selected if(?direction > 0.0, if(?selected >= ?count, if(?other = true, 0.0, 1.0), ?selected + 1.0), if(?selected <= if(?other = true, 0.0, 1.0), ?count, ?selected - 1.0))

on answer-prompt-choice ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple false
    ?question question selected ?selected
    ?question question option ?option
    ?option option number ?selected
    ?option option value ?value
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?value
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on toggle-prompt-option ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple true
    ?question question selected ?selected
    ?question question option ?option
    ?option option number ?selected
    ?option option checked ?checked
  withdraw
    ?option option checked ?checked
  include
    ?option option checked (?checked = false)

on answer-prompt-multiple ?north ?text
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question multiple true
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?text
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on skip-prompt-question ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question optional true
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer "null"
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on prompt-answer-problem ?north ?problem
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question problem ?prior
  withdraw
    ?question question problem ?prior
  include
    ?question question problem ?problem

on answer-prompt-text ?north ?text
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt current ?position
    ?prompt prompt question ?question
    ?question question number ?position
    ?question question selected ?selected
    ?question question other ?other
    sum 1.0 given ?question where { ?question question option ?option } as ?count
    if(?count = 0.0, true, if(?other = true, ?selected = 0.0, false)) = true
    (trim(?text) = "") = false
    ?question question answer ?prior
    ?question question answered ?answered
  withdraw
    ?question question answer ?prior
    ?question question answered ?answered
    ?prompt prompt current ?position
  include
    ?question question answer ?text
    ?question question answered true
    ?prompt prompt current ?position + 1.0

on prepare-prompt-response ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt number ?number
    ?prompt prompt outcome ?outcome
    sum 1.0 given ?prompt where { ?prompt prompt question ?question; ?question question answered false } as ?unanswered
    if(?outcome = "cancel", true, ?unanswered = 0.0) = true
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?prompt prompt status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?prompt prompt status "sending"
    ?north host effect "answer-prompt"
    ?north effect payload ""
    ?north effect input number ?number

on cancel-prompt ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt visible true
    ?prompt prompt status ?status
    ?status = "waiting"
    ?prompt prompt outcome ?outcome
    ?prompt prompt cancellation ?cancellation
    (?cancellation = "") = false
  withdraw
    ?prompt prompt outcome ?outcome
  include
    ?prompt prompt outcome "cancel"

on prompt-response-written ?north ?number ?result
  when
    ?north known prompt ?prompt
    ?prompt prompt number ?number
    ?prompt prompt status ?status
    ?status = "sending"
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status ?result

on resolve-prompt ?north ?conversation ?request
  when
    ?north known prompt ?prompt
    ?prompt prompt conversation ?conversation
    ?prompt prompt request ?request
    ?prompt prompt status ?status
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status "resolved"

on close-turn-prompts ?north ?conversation ?turn
  when
    ?north known prompt ?prompt
    ?prompt prompt conversation ?conversation
    ?prompt prompt turn ?turn
    ?prompt prompt status ?status
  withdraw
    ?prompt prompt status ?status
  include
    ?prompt prompt status "resolved"

on clear-resolved-answers ?north
  when
    ?north known prompt ?prompt
    ?prompt prompt status ?status
    ?status = "resolved"
    ?prompt prompt question ?question
    ?question question answer ?answer
  withdraw
    ?question question answer ?answer
  include
    ?question question answer ""

on observe-turn ?north ?conversation ?turn
  when
    ?context conversation id ?conversation
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  withdraw
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context active turn ?turn
    ?context phase if(?readiness = "turn-ready", "dispatching", ?phase)
    ?context turn readiness "turn-active"

on observe-stored-turn ?north ?conversation ?turn ?status
  when
    ?status = "inProgress"
    ?context conversation id ?conversation
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  withdraw
    ?context active turn ?prior
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context active turn ?turn
    ?context phase if(?readiness = "turn-ready", "dispatching", ?phase)
    ?context turn readiness "turn-active"

on clear-turn ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context active turn ?turn
  withdraw
    ?context active turn ?turn
  include
    ?context active turn ""

on finish-observed-turn ?north ?conversation ?turn
  when
    ?context conversation id ?conversation
    ?context active turn ?turn
  withdraw
    ?context active turn ?turn
  include
    ?context active turn ""

on expire-steering ?north ?conversation
  when
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input status ?status
    ?status = "waiting to steer"
  withdraw
    ?input input status ?status
  include
    ?input input status "not sent"

on retain-input ?north ?text ?mode
  when
    ?north active conversation ?conversation
    ?north draft number ?number
  create
    ?input
      member of: PendingInput
  withdraw
    ?north draft number ?number
  include
    ?north draft number ?number + 1.0
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status if(?mode = "queue", "queued", "waiting to steer")

on record-input-acceptance ?north ?number ?result
  when
    ?result = "accepted"
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status ?status
    if(?status = "sending correction", true, ?status = "submitted") = true
    ?north next chat order ?order
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat order ?order
    ?entry chat conversation ?conversation
    ?entry chat turn ""
    ?entry chat key ""
    ?entry chat kind "operator"
    ?entry chat text ?text
    ?entry chat status "completed"
    ?entry chat style "operator"
    ?entry chat visible false

on input-receipt ?north ?number ?result
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    if(?status = "sending correction", true, if(?status = "sending", true, ?status = "submitted")) = true
  withdraw
    ?input input status ?status
  include
    ?input input status ?result

on prepare-steering ?north
  when
    ?context conversation id ?conversation
    ?context active turn ?turn
    (?turn = "") = false
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input text ?text
    ?input input status ?status
    ?status = "waiting to steer"
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input status ?earlier-status; if(?earlier-status = "waiting to steer", true, ?earlier-status = "sending correction") = true; ?earlier input number ?prior; ?prior < ?number } as ?count
    ?count = 0.0
    sum 1.0 given ?number where { ?earlier input number ?prior; ?prior < ?number; ?earlier input status "waiting to steer"; ?earlier input conversation ?thread; ?other conversation id ?thread; ?other active turn ?active; (?active = "") = false } as ?earlier-ready
    ?earlier-ready = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "sending correction"
    ?north host effect "send-steering"
    ?north effect payload ?text
    ?north effect input number ?number

on retain-queued-attachment ?north ?number ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north known pending input ?input
    ?input input number ?number
    ?context draft attachment ?attachment
  withdraw
    ?context draft attachment ?attachment
  include
    ?input input attachment ?attachment

on prepare-queued-input ?north
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    (?phase = "failed") = false
    (?phase = "interrupted") = false
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input status ?status
    ?status = "queued"
    ?input input text ?text
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input status ?earlier-status; ?earlier-status = "queued"; ?earlier input number ?prior; ?prior < ?number } as ?count
    ?count = 0.0
    sum 1.0 given ?number where { ?earlier input number ?prior; ?prior < ?number; ?earlier input status "queued"; ?earlier input conversation ?thread; ?other conversation id ?thread; ?other turn readiness "turn-ready"; ?other phase ?other-phase; (?other-phase = "failed") = false; (?other-phase = "interrupted") = false } as ?earlier-ready
    ?earlier-ready = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "sending"
    ?north host effect "submit-queued"
    ?north effect payload ?text
    ?north effect input number ?number

on submit-queued ?north ?number
  when
    ?context conversation id ?conversation
    ?context turn readiness ?readiness
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input status ?status
    ?status = "sending"
    ?readiness = "turn-ready"
    ?context phase ?phase
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?input input status ?status
  include
    ?context phase "dispatching"
    ?context turn readiness "turn-active"
    ?input input status "submitted"

on copy-queued-to-submitted ?north ?number ?attachment
  when
    ?context conversation id ?conversation
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input status ?status
    ?status = "sending"
    ?input input attachment ?attachment
  include
    ?context submitted attachment ?attachment

on prepare-input-edit ?north
  when
    ?north active conversation ?conversation
    ?north known pending input ?input
    ?input input conversation ?conversation
    ?input input number ?number
    ?input input text ?text
    ?input input status ?status
    input status ?status editable ?allowed
    ?allowed = true
    sum 1.0 given ?conversation ?number where { ?earlier input conversation ?conversation; ?earlier input number ?prior; ?prior < ?number; ?earlier input status ?earlier-status; input status ?earlier-status editable ?editable; ?editable = true } as ?count
    ?count = 0.0
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  withdraw
    ?input input status ?status
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north effect input number ?prior-number
  include
    ?input input status "editing"
    ?north host effect "edit-pending"
    ?north effect payload ?text
    ?north effect input number ?number

on restore-input-attachment ?north ?number ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    ?status = "editing"
    ?input input attachment ?attachment
  include
    ?context draft attachment ?attachment

on forget-input-attachment ?north ?number ?attachment
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input status ?status
    if(?status = "accepted", true, ?status = "editing") = true
    ?input input attachment ?attachment
  withdraw
    ?input input attachment ?attachment

on forget-input ?north ?number
  when
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status ?status
    if(?status = "accepted", true, ?status = "editing") = true
  withdraw
    ?north known pending input ?input
    ?input input number ?number
    ?input input conversation ?conversation
    ?input input text ?text
    ?input input status ?status

on append-chat ?north ?conversation ?kind ?text
  when
    ?north next chat order ?order
    appearance of ?kind with "completed" as ?style
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ""
    ?entry chat key ""
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status "completed"
    ?entry chat style ?style
    ?entry chat order ?order

    ?entry chat visible false

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when
    ?north next chat order ?order
    appearance of ?kind with ?status as ?style
    sum 1.0 given ?conversation ?turn ?key where { ?entry chat conversation ?conversation; ?entry chat turn ?turn; ?entry chat key ?key } as ?count
    ?count = 0.0
  create
    ?entry
      member of: ChatEntry
  withdraw
    ?north next chat order ?order
  include
    ?north next chat order ?order + 1.0
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order

    ?entry chat visible false

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?prior-kind
    ?entry chat text ?prior-text
    ?entry chat status ?prior-status
    ?entry chat style ?prior-style
    appearance of ?kind with ?status as ?style
  withdraw
    ?entry chat kind ?prior-kind
    ?entry chat text ?prior-text
    ?entry chat status ?prior-status
    ?entry chat style ?prior-style
  include
    ?entry chat kind ?kind
    ?entry chat text if(?mode = "append", ?prior-text ++ ?text, ?text)
    ?entry chat status ?status
    ?entry chat style ?style

on clear-chat ?north
  when
    ?north active conversation ?conversation
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order
    ?entry chat visible ?visible
  withdraw
    ?north known chat entry ?entry
    ?entry chat conversation ?conversation
    ?entry chat turn ?turn
    ?entry chat key ?key
    ?entry chat kind ?kind
    ?entry chat text ?text
    ?entry chat status ?status
    ?entry chat style ?style
    ?entry chat order ?order
    ?entry chat visible ?visible

on initialize ?north
  when
    ?north initialized ?initialized
    ?initialized = "false"
  create
    ?new-command
      member of: Command
    ?resume-command
      member of: Command
    ?model-command
      member of: Command
    ?effort-command
      member of: Command
    ?config-command
      member of: Command
    ?delegate-command
      member of: Command
    ?goal-command
      member of: Command
    ?goals-command
      member of: Command
    ?agents-command
      member of: Command
    ?quit-command
      member of: Command
  withdraw
    ?north initialized ?initialized
  include
    ?north initialized "true"
    ?north known command ?new-command
    ?new-command name "/new"
    ?new-command description "start a new conversation"
    ?new-command handler "command-new"
    ?new-command command order 1.0
    ?north known command ?resume-command
    ?resume-command name "/resume"
    ?resume-command description "switch to a previous conversation"
    ?resume-command handler "command-resume"
    ?resume-command command order 2.0
    ?north known command ?model-command
    ?model-command name "/model"
    ?model-command description "choose the active model and reasoning effort"
    ?model-command handler "command-model"
    ?model-command command order 3.0
    ?north known command ?effort-command
    ?effort-command name "/effort"
    ?effort-command description "change reasoning effort for the active model"
    ?effort-command handler "command-effort"
    ?effort-command command order 4.0
    ?north known command ?config-command
    ?config-command name "/config"
    ?config-command description "toggle the context switchboard"
    ?config-command handler "command-config"
    ?config-command command order 5.0
    ?north known command ?delegate-command
    ?delegate-command name "/delegate"
    ?delegate-command description "delegate one explicit task"
    ?delegate-command handler "command-delegate"
    ?delegate-command command order 6.0
    ?north known command ?goal-command
    ?goal-command name "/goal"
    ?goal-command description "set, edit, or clear the selected goal"
    ?goal-command handler "command-goal"
    ?goal-command command order 7.0
    ?north known command ?goals-command
    ?goals-command name "/goals"
    ?goals-command description "inspect Goals"
    ?goals-command handler "command-goals"
    ?goals-command command order 9.0
    ?north known command ?agents-command
    ?agents-command name "/agents"
    ?agents-command description "change selected agent"
    ?agents-command handler "command-agents"
    ?agents-command command order 10.0
    ?north known command ?quit-command
    ?quit-command name "/q"
    ?quit-command description "quit North"
    ?quit-command handler "command-quit"
    ?quit-command command order 12.0

on inspect ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
  withdraw
    ?context phase ?phase
  include
    ?context phase ?phase

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = true
    ?north known command ?command
    ?command name ?name
    ?name = first-word(?input)
    ?command handler ?handler
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  include
    ?north input dispatch ?handler
    ?north input payload trim(?input)
    ?north input kind "command"

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = false
    ?north input handler ?handler
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
  include
    ?north input dispatch ?handler
    ?north input payload ?input
    ?north input kind "message"

on resolve-input ?north ?input
  when
    starts-with(trim(?input), "/") = true
    sum 1.0 given ?north ?input where { ?north known command ?command; ?command name ?name; ?name = first-word(?input) } as ?count
    ?count = 0.0
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
    ?north notice ?notice
  withdraw
    ?north input dispatch ?dispatch
    ?north input payload ?payload
    ?north input kind ?kind
    ?north notice ?notice
  include
    ?north input dispatch ""
    ?north input payload ""
    ?north input kind "command"
    ?north notice "Unknown command: " ++ first-word(?input)

on select-goal ?north ?goal
  when
    ?north known goal ?goal
    ?north active goal ?previous
  withdraw
    ?north active goal ?previous
  include
    ?north active goal ?goal

on command-new ?north ?command
  when
    ?command = "/new"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "new-conversation"
    ?north effect payload ""

on command-resume ?north ?command
  when
    ?command = "/resume"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "resume-conversation"
    ?north effect payload ""

on command-model ?north ?command
  when
    ?command = "/model"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "select-model"
    ?north effect payload ""

on command-effort ?north ?command
  when
    ?command = "/effort"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "select-effort"
    ?north effect payload ""

on command-config ?north ?command
  when
    ?command = "/config"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "open-switchboard"
    ?north effect payload ""

on command-quit ?north ?command
  when
    ?command = "/q"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "quit"
    ?north effect payload ""

on command-delegate ?north ?command
  when
    ?command = "/delegate"
    ?north input handler ?handler
    ?handler = "submit-input"
    ?north notice ?notice
  withdraw
    ?north input handler ?handler
    ?north notice ?notice
  include
    ?north input handler "delegate-task"
    ?north notice "Describe the task to delegate"

on delegate-task ?north ?task
  when
    ?north input handler ?handler
    ?handler = "delegate-task"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?north notice ?notice
  withdraw
    ?north input handler ?handler
    ?north host effect ?effect
    ?north effect payload ?payload
    ?north notice ?notice
  include
    ?north input handler "submit-input"
    ?north host effect "delegate"
    ?north effect payload ?task
    ?north notice ""

on submit-input ?north ?input
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north input handler ?handler
    ?handler = "submit-input"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
    ?context turn readiness ?readiness
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect if(?readiness = "turn-active", "steer", "submit")
    ?north effect payload ?input

on clear-host-effect ?north
  when
    ?north host effect ?effect
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect ""
    ?north effect payload ""

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "set"
    goal text of ?command as ?text
    ?text = ""
    ?north input handler ?handler
    ?handler = "submit-input"
    ?north pending goal title ?pending-title
    ?north notice ?notice
  withdraw
    ?north input handler ?handler
    ?north pending goal title ?pending-title
    ?north notice ?notice
  include
    ?north input handler "goal-title"
    ?north pending goal title ""
    ?north notice "Name the Goal"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "set"
    goal text of ?command as ?objective
    (?objective = "") = false
    ?north input handler ?handler
    ?north next goal order ?order
    ?north active goal ?previous
    ?north notice ?notice
  create
    ?goal
      member of: Goal
  withdraw
    ?north input handler ?handler
    ?north next goal order ?order
    ?north active goal ?previous
    ?north notice ?notice
  include
    ?north input handler "submit-input"
    ?north next goal order ?order + 1.0
    ?north known goal ?goal
    ?north active goal ?goal
    ?goal title ?objective
    ?goal objective ?objective
    ?goal status "active"
    ?goal order ?order
    ?goal next revision 1.0
    ?north notice "Goal set"

on goal-title ?north ?title
  when
    ?north input handler ?handler
    ?handler = "goal-title"
    ?north pending goal title ?pending-title
    ?north notice ?notice
  withdraw
    ?north input handler ?handler
    ?north pending goal title ?pending-title
    ?north notice ?notice
  include
    ?north input handler "goal-objective"
    ?north pending goal title ?title
    ?north notice "Describe the desired outcome"

on goal-objective ?north ?objective
  when
    ?north input handler ?handler
    ?handler = "goal-objective"
    ?north pending goal title ?title
    ?north next goal order ?order
    ?north active goal ?previous
    ?north notice ?notice
  create
    ?goal
      member of: Goal
  withdraw
    ?north input handler ?handler
    ?north pending goal title ?title
    ?north next goal order ?order
    ?north active goal ?previous
    ?north notice ?notice
  include
    ?north input handler "submit-input"
    ?north pending goal title ""
    ?north next goal order ?order + 1.0
    ?north known goal ?goal
    ?north active goal ?goal
    ?goal title ?title
    ?goal objective ?objective
    ?goal status "active"
    ?goal order ?order
    ?goal next revision 1.0
    ?north notice "Goal created"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "edit"
    goal text of ?command as ?text
    ?text = ""
    ?north input handler ?handler
    ?north active goal ?goal
    ?goal objective ?objective
    ?north notice ?notice
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north input handler ?handler
    ?north notice ?notice
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north input handler "goal-edit-input"
    ?north notice "Edit the desired outcome"
    ?north host effect "edit-draft"
    ?north effect payload ?objective

on goal-edit-input ?north ?objective
  when
    ?north input handler ?handler
    ?handler = "goal-edit-input"
    (trim(?objective) = "") = false
    ?north active goal ?goal
    ?goal objective ?previous
    ?goal status ?status
    ?status = "active"
    ?goal next revision ?revision-order
    ?north notice ?notice
  create
    ?revision
      member of: GoalRevision
  withdraw
    ?north input handler ?handler
    ?goal objective ?previous
    ?goal next revision ?revision-order
    ?north notice ?notice
  include
    ?north input handler "submit-input"
    ?goal known revision ?revision
    ?revision revision objective ?previous
    ?revision revision order ?revision-order
    ?goal next revision ?revision-order + 1.0
    ?goal objective ?objective
    ?north notice "Goal updated"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "edit"
    goal text of ?command as ?objective
    (?objective = "") = false
    ?north input handler ?handler
    ?north active goal ?goal
    ?goal objective ?previous
    ?goal status ?status
    ?status = "active"
    ?goal next revision ?revision-order
    ?north notice ?notice
  create
    ?revision
      member of: GoalRevision
  withdraw
    ?north input handler ?handler
    ?goal objective ?previous
    ?goal next revision ?revision-order
    ?north notice ?notice
  include
    ?north input handler "submit-input"
    ?goal known revision ?revision
    ?revision revision objective ?previous
    ?revision revision order ?revision-order
    ?goal next revision ?revision-order + 1.0
    ?goal objective ?objective
    ?north notice "Goal updated"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "clear"
    goal text of ?command as ?text
    ?text = ""
    ?north active goal ?goal
    ?north known goal ?goal
    ?goal status ?status
    ?north input handler ?handler
    ?north notice ?notice
  withdraw
    ?north active goal ?goal
    ?goal status ?status
    ?north input handler ?handler
    ?north notice ?notice
  include
    ?north active goal no-goal
    ?goal status "cleared"
    ?north input handler "submit-input"
    ?north notice "Goal cleared"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    (?action = "set") = false
    ?north active goal no-goal
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice "No selected goal"

on command-goal ?north ?command
  when
    goal action of ?command as ?action
    ?action = "clear"
    goal text of ?command as ?text
    (?text = "") = false
    ?north active goal ?goal
    ?north known goal ?goal
    ?north notice ?notice
  withdraw
    ?north notice ?notice
  include
    ?north notice "Usage: /goal clear"

on command-goals ?north ?command
  when
    ?command = "/goals"
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
    ?north notice ?notice
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
    ?north notice ?notice
  include
    ?north active view "goals"
    ?north next view handler "view-goals-next"
    ?north previous view handler "view-goals-previous"
    ?north notice ""

on command-agents ?north ?command
  when
    ?command = "/agents"
    ?north host effect ?effect
    ?effect = ""
    ?north effect payload ?payload
  withdraw
    ?north host effect ?effect
    ?north effect payload ?payload
  include
    ?north host effect "select-agent"
    ?north effect payload "{\"limit\":100,\"sortKey\":\"recency_at\",\"sortDirection\":\"desc\",\"sourceKinds\":[\"appServer\",\"cli\",\"vscode\",\"unknown\",\"subAgent\",\"subAgentThreadSpawn\",\"subAgentOther\",\"subAgentReview\",\"subAgentCompact\"],\"useStateDbOnly\":true}"

on show-chat ?north
  when
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
    ?north notice ?notice
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
    ?north notice ?notice
  include
    ?north active view "chat"
    ?north next view handler "view-chat-next"
    ?north previous view handler "view-chat-previous"
    ?north notice ""


on view-chat-next ?north
  when
    ?north active view ?view
    ?view = "chat"
    ?north next view handler ?next
    ?north previous view handler ?previous
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
  include
    ?north active view "goals"
    ?north next view handler "view-goals-next"
    ?north previous view handler "view-goals-previous"

on view-chat-previous ?north
  when
    ?north active view ?view
    ?view = "chat"
    ?north next view handler ?next
    ?north previous view handler ?previous
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
  include
    ?north active view "goals"
    ?north next view handler "view-goals-next"
    ?north previous view handler "view-goals-previous"

on view-goals-next ?north
  when
    ?north active view ?view
    ?view = "goals"
    ?north next view handler ?next
    ?north previous view handler ?previous
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
  include
    ?north active view "chat"
    ?north next view handler "view-chat-next"
    ?north previous view handler "view-chat-previous"

on view-goals-previous ?north
  when
    ?north active view ?view
    ?view = "goals"
    ?north next view handler ?next
    ?north previous view handler ?previous
  withdraw
    ?north active view ?view
    ?north next view handler ?next
    ?north previous view handler ?previous
  include
    ?north active view "chat"
    ?north next view handler "view-chat-next"
    ?north previous view handler "view-chat-previous"



on observe-conversation ?north ?conversation
  when
    ?north conversation change ?change
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change ?change
    ?north known conversation ?conversation

on attach-image ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north next attachment number ?attachment
  withdraw
    ?north next attachment number ?attachment
  include
    ?north next attachment number ?attachment + 1.0
    ?context draft attachment ?attachment

on detach-image ?north ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north next attachment number ?next
    ?context draft attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?context draft attachment ?attachment
  include
    ?north next attachment number ?next

on copy-submission-attachment ?north ?attachment
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?north draft number ?draft
    ?context draft attachment ?attachment
  withdraw
    ?north draft number ?draft
  include
    ?north draft number ?draft
    ?context submitted attachment ?attachment

on clear-submitted-attachment ?north ?conversation ?attachment
  when
    ?context conversation id ?conversation
    ?north next attachment number ?next
    ?context submitted attachment ?attachment
  withdraw
    ?north next attachment number ?next
    ?context submitted attachment ?attachment
  include
    ?north next attachment number ?next

on request-new-conversation ?north
  when
    ?north conversation change ?change
    ?change = "conversation-ready"
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-opening"
    ?north pending conversation ""

on settle-new-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-opening"
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
  include
    ?north conversation change "conversation-ready"
    ?north active conversation ?conversation
    ?north known conversation ?conversation

on fail-new-conversation ?north
  when
    ?north conversation change ?change
    ?change = "conversation-opening"
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
  include
    ?north conversation change "conversation-ready"

on request-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-ready"
    ?north known conversation ?conversation
    ?north pending conversation ?pending
    ?pending = ""
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-switching"
    ?north pending conversation ?conversation

on settle-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-switching"
    ?north active conversation ?previous
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north active conversation ?previous
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-ready"
    ?north active conversation ?conversation
    ?north pending conversation ""

on fail-switch-conversation ?north ?conversation
  when
    ?north conversation change ?change
    ?change = "conversation-switching"
    ?north pending conversation ?pending
    ?pending = ?conversation
  withdraw
    ?north conversation change ?change
    ?north pending conversation ?pending
  include
    ?north conversation change "conversation-ready"
    ?north pending conversation ""

on submit ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?context phase "dispatching"
    ?context turn readiness "turn-active"
    ?context terminal delegated child ""
    ?north draft number ?draft + 1.0

on delegate ?north
  when
    ?north active conversation ?context-id
    ?context conversation id ?context-id
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-ready"
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context terminal delegated child ?previous-terminal-child
    ?north draft number ?draft
  include
    ?context phase "delegating"
    ?context turn readiness "turn-active"
    ?context terminal delegated child ""
    ?north draft number ?draft + 1.0

on child-spawned ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "delegating"
    ?context active delegated child ?previous-child
    ?previous-child = ""
  withdraw
    ?context phase ?phase
    ?context active delegated child ?previous-child
  include
    ?context phase "settling"
    ?context active delegated child ?child

on settle-success ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "dispatching"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "completed"
    ?context turn readiness "turn-ready"

on abandon-turn ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"
    ?context active delegated child ""
    ?context terminal delegated child ?child

on settle-interrupted ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
    ?context active delegated child ?child
    ?context terminal delegated child ?prior
  include
    ?context phase "interrupted"
    ?context turn readiness "turn-ready"
    ?context active delegated child ""
    ?context terminal delegated child ?child

on settle-failure ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "dispatching"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"

on settle-delegation-success ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "settling"
    ?context active delegated child ?active-child
    ?active-child = ?child
    ?context terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = ""
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context active delegated child ?active-child
    ?context terminal delegated child ?previous-terminal-child
    ?context turn readiness ?readiness
  include
    ?context phase "completed"
    ?context active delegated child ""
    ?context terminal delegated child ?child
    ?context turn readiness "turn-ready"

on fail-delegation-before-child ?north ?conversation
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "delegating"
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context turn readiness "turn-ready"

on fail-delegation-after-child ?north ?conversation ?child
  when
    ?context conversation id ?conversation
    ?context phase ?phase
    ?phase = "settling"
    ?context active delegated child ?active-child
    ?active-child = ?child
    ?context terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = ""
    ?context turn readiness ?readiness
    ?readiness = "turn-active"
  withdraw
    ?context phase ?phase
    ?context active delegated child ?active-child
    ?context terminal delegated child ?previous-terminal-child
    ?context turn readiness ?readiness
  include
    ?context phase "failed"
    ?context active delegated child ""
    ?context terminal delegated child ?child
    ?context turn readiness "turn-ready"
