#!/bin/sh
set -eu
here=$(dirname "$(readlink -f "$0")")
git -C "$here" rev-parse --show-toplevel > /dev/null 2>&1 \
  || { echo "eval-x: $here is not inside a git checkout; start evals/x/run from a checkout of main, where the tools are built" >&2; exit 1; }
runtime=${EVAL_X_RUNTIME:-$(readlink -f "$HOME/.local/state/north/current" 2> /dev/null)} || runtime=
[ -n "$runtime" ] || { echo "eval-x: no live north runtime at ~/.local/state/north/current; the run stops before its first trial" >&2; exit 1; }
[ -f "$runtime/tree/evals/x/arm" ] || { echo "eval-x: the live runtime $runtime has no $runtime/tree/evals/x/arm; the run stops before its first trial" >&2; exit 1; }
root=$(readlink -f "$here/../..")
build() { north capacity dev-shell run --dir "$root" -- sh -c 'cd "$1" && shift && exec cargo build -q --locked "$@" --target-dir target' sh "$@" >&2; }
build "$here/runner"
build "$root/evals/t" --offline
# Rootless podman maps the subordinate ids with the setuid newuidmap wrapper, which must come before the store's copy.
EVAL_X_DIR=$runtime/tree/evals/x EVAL_T_TOOL=$root/evals/t/target/debug/eval-t PATH=/run/wrappers/bin:$PATH \
  exec "$here/runner/target/debug/eval-x-runner" "$@"
