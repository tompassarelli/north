#!/bin/sh
set -eu
here=$(dirname "$(readlink -f "$0")")
if [ -z "${EVAL_X_TREE:-}" ]; then
  runtime=$(readlink -f "$HOME/.local/state/north/current" 2> /dev/null) || runtime=
  [ -n "$runtime" ] || { echo "eval-x: no live north runtime at ~/.local/state/north/current; the run stops before its first trial" >&2; exit 1; }
  [ -f "$runtime/tree/evals/x/run" ] || { echo "eval-x: the live runtime $runtime has no $runtime/tree/evals/x/run; the run stops before its first trial" >&2; exit 1; }
  exec env EVAL_X_TREE="$runtime/tree" "$runtime/tree/evals/x/run" "$@"
fi
north capacity dev-shell run --dir "$here/../.." -- \
  sh -c 'cd "$1" && exec cargo build -q --locked --target-dir target' sh "$here/runner" >&2
# Rootless podman maps the subordinate ids with the setuid newuidmap wrapper, which must come before the store's copy.
EVAL_X_DIR=$here PATH=/run/wrappers/bin:$PATH exec "$here/runner/target/debug/eval-x-runner" "$@"
