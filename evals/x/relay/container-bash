#!/bin/sh
log=${EVAL_X_SHELL_LOG:?names the file each call is appended to}
{
  printf 'CALL pid=%s ppid=%s cwd=%s stdin=%s\n' "$$" "$PPID" "$PWD" "$(readlink /proc/$$/fd/0)"
  n=0
  for a in "$@"; do
    n=$((n + 1))
    printf 'ARG %s: %s\n' "$n" "$a"
  done
  printf 'ENV-NAMES: %s\n' "$(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ')"
  printf 'ENV-CLAUDE: %s\n' "$(env | grep -E '^(CLAUDECODE|CLAUDE_CODE_ENTRYPOINT|CLAUDE_PROJECT_DIR|SHELL|PWD|OLDPWD)=' | tr '\n' ' ')"
} >> "$log"
"${EVAL_X_REAL_SHELL:-bash}" "$@"
status=$?
printf 'EXIT pid=%s status=%s\n' "$$" "$status" >> "$log"
exit "$status"
