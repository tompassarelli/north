#!/bin/sh
# One trial of one harness on one Eval X task, on the host. Both arms run north's evals/t/arm with the task's working
# directory as their repository; the hand-off stub writes TRIAL/prompt.json, and this writes STATE/arm.json then
# TRIAL/done.json. The container mounts TRIAL, so everything a harness writes goes to STATE, which no container sees.
set -eu
here=$(dirname "$(readlink -f "$0")")
usage="usage: evals/x/arm --arm north|t3 --trial DIR --state DIR --cwd CWD --account A --model M --effort E [--limit SECONDS]"
arm= trial= state= cwd= account= model= effort= limit=600
while [ $# -gt 1 ]; do
  case $1 in
    --arm) arm=$2 ;;
    --trial) trial=$2 ;;
    --state) state=$2 ;;
    --cwd) cwd=$2 ;;
    --account) account=$2 ;;
    --model) model=$2 ;;
    --effort) effort=$2 ;;
    --limit) limit=$2 ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift 2
done
[ $# -eq 0 ] && [ -n "$arm" ] && [ -n "$trial" ] && [ -n "$state" ] && [ -n "$cwd" ] && [ -n "$account" ] && [ -n "$model" ] && [ -n "$effort" ] || { echo "$usage" >&2; exit 2; }
case $arm in north | t3) ;; *) echo "$usage" >&2; exit 2 ;; esac
relay=$here/relay/container-bash
[ -x "$relay" ] || { echo "eval-x arm $arm: no shell relay at $relay" >&2; exit 1; }
mkdir -p "$trial" "$state"
trial=$(readlink -f "$trial") state=$(readlink -f "$state") cwd=$(readlink -f "$cwd")
case $state/ in "$trial"/*) echo "eval-x arm $arm: the state directory must lie outside the trial directory" >&2; exit 2 ;; esac
prompt='[.params.prompt[] | select(.type == "text") | .text] | join("")'
for _ in $(seq "${EVAL_X_HANDOFF_S:-900}"); do
  jq -e "$prompt" "$trial/prompt.json" > /dev/null 2>&1 && break
  sleep 1
done
jq -j "$prompt" "$trial/prompt.json" > "$state/prompt.txt" 2> /dev/null \
  || { echo "eval-x arm $arm: no hand-off in $trial/prompt.json" >&2; exit 1; }
ln -sfn "$cwd" "$state/repo"
runner=${EVAL_X_RUNNER:?evals/x/arm is started by the runner, which names its own binary in EVAL_X_RUNNER}
rm -f "$state/end.json" "$state/nudged" "$state/quiet"
start=$(date +%s) rc=0
case $arm in north) settled="$runner session-end --state $state" ;; *) settled="$runner plain-end --state $state" ;; esac
SHELL=$relay EVAL_X_TRIAL=$trial EVAL_T_ACCOUNT=$account EVAL_T_MODEL=$model EVAL_T_EFFORT=$effort EVAL_T_LIMIT_S=$limit \
  EVAL_T_SETTLED=$settled "$here/../t/arm" "$arm" "$state" > "$state/arm.log" 2>&1 || rc=$?
end=$(date +%s)
session_end=$(cat "$state/end.json" 2> /dev/null) || session_end=null
jq -n --arg arm "$arm" --arg cwd "$cwd" --arg account "$account" --arg model "$model" --arg effort "$effort" \
  --arg transcript "$state/transcript.jsonl" --argjson start "$start" --argjson end "$end" --argjson rc "$rc" \
  --argjson limit "$limit" --argjson session_end "$session_end" \
  '{arm: $arm, cwd: $cwd, account: $account, model: $model, effort_requested: $effort, limit_s: $limit,
    wall_s: ($end - $start), exit: $rc, transcript: $transcript,
    session_end: ($session_end | if . == null then null else . + {ended: (.ended // "limit")} end)}' > "$state/arm.json.tmp"
mv "$state/arm.json.tmp" "$state/arm.json"
jq -n --argjson rc "$rc" '{done: true, exit: $rc}' > "$trial/done.json.tmp"
mv "$trial/done.json.tmp" "$trial/done.json"
exit "$rc"
