load(":defs.bzl", "execution_platform")

_HOST = [
    "prelude//cpu/constraints:x86_64",
    "prelude//os/constraints:linux",
]

_REMOTE = {"OSFamily": "linux"} if read_root_config("buck2_re_client", "engine_address") else {}

platform(
    name = "dev",
    constraint_values = _HOST + ["//mode:dev"],
    visibility = ["PUBLIC"],
)

platform(
    name = "release",
    constraint_values = _HOST + ["//mode:release"],
    visibility = ["PUBLIC"],
)

execution_platform(
    name = "exec",
    constraint_values = _HOST + ["//mode:dev"],
    remote_execution_properties = _REMOTE,
    visibility = ["PUBLIC"],
)
