#lang beagle

(ns north.session-core-fixture
  (:require [north.session-core :as session]))

(def root session/SessionEvent
  (session/->SessionEvent "event/root" 0 "session/root" nil nil :message "root"))
(def root-ledger session/SessionLedger (session/append-event session/empty-ledger root))

(def compacted session/SessionEvent
  (session/->SessionEvent "event/compact" 1 "session/root" "event/root" nil :compaction "summary"))
(def compacted-ledger session/SessionLedger (session/append-event root-ledger compacted))

(def tail session/SessionEvent
  (session/->SessionEvent "event/tail" 2 "session/root" "event/compact" nil :message "tail"))
(def projected-ledger session/SessionLedger (session/append-event compacted-ledger tail))

(def branch session/BranchProvenance (session/->BranchProvenance "session/root" "event/compact"))
(def branch-root session/SessionEvent
  (session/->SessionEvent "event/branch-root" 3 "session/branch" "event/compact" branch :message "branch root"))
(def branched-ledger session/SessionLedger (session/append-event projected-ledger branch-root))

(def context session/ContextProjection (session/context-projection branched-ledger "session/root"))
