#lang beagle

(ns north.thread-core-fixture
  (:require [north.thread-core :as core]))

(defn admitted-world [result core/WorldAdmission] core/ThreadWorld
  (match result
    [(core/WorldAdmitted world) world]
    [(core/WorldRejected reason) core/empty-world]))

(defn admitted? [result core/WorldAdmission] Bool
  (match result
    [(core/WorldAdmitted world) true]
    [(core/WorldRejected reason) false]))

(defn blocked? [status core/ThreadStatus?] Bool
  (if (some? status)
    (instance? core/ThreadBlocked status)
    false))

(defn resolved? [status core/ThreadStatus?] Bool
  (if (some? status)
    (instance? core/ThreadResolved status)
    false))

(defn main [] Int
  (let [launch core/Thread (core/->Thread "thread/launch" "Land live harness" "operator")
        check core/Thread (core/->Thread "thread/check" "Verify harness" "worker")
        first core/WorldAdmission (core/admit-thread core/empty-world launch)
        with-launch core/ThreadWorld (admitted-world first)
        second core/WorldAdmission (core/admit-thread with-launch check)
        with-threads core/ThreadWorld (admitted-world second)
        part core/WorldAdmission
        (core/admit-part-of with-threads (core/->ThreadEdge "thread/check" "thread/launch"))
        with-part core/ThreadWorld (admitted-world part)
        dependency core/WorldAdmission
        (core/admit-depends-on with-part (core/->ThreadEdge "thread/launch" "thread/check"))
        with-edges core/ThreadWorld (admitted-world dependency)
        blocked core/WorldAdmission
        (core/admit-fact with-edges
          (core/->ThreadFact "fact/blocked" "thread/launch" :thread/blocked "probe pending"
            (core/->Observed "worker" "probe/1")))
        blocked-world core/ThreadWorld (admitted-world blocked)
        resolved core/WorldAdmission
        (core/admit-fact blocked-world
          (core/->ThreadFact "fact/resolved" "thread/launch" :thread/resolved "probe passed"
            (core/->Derived "rule/probe-passed" ["fact/blocked"])))
        resolved-world core/ThreadWorld (admitted-world resolved)
        effect core/WorldAdmission
        (core/admit-effect resolved-world
          (core/->ThreadEffect "effect/release" "thread/launch" :effect/released "released"
            (core/->EffectRecord "effect/release" "worker")))]
    (if (and (admitted? first)
             (admitted? second)
             (admitted? part)
             (admitted? dependency)
             (admitted? blocked)
             (admitted? resolved)
             (admitted? effect)
             (= "operator" (core/thread-owner resolved-world "thread/launch"))
             (blocked? (core/status-for blocked-world "thread/launch"))
             (resolved? (core/status-for resolved-world "thread/launch"))
             (not (admitted? (core/admit-thread resolved-world launch))))
      0
      1)))
