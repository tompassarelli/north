#lang beagle

(ns north.replay-core-fixture
  (:require [north.replay-core :as replay]))

(defn appended-journal [result replay/JournalAppend] replay/ReplayJournal
  (match result
    [(replay/JournalAppended journal) journal]
    [(replay/JournalRejected code detail) (replay/empty-journal "")]))

(defn appended? [result replay/JournalAppend] Bool
  (match result
    [(replay/JournalAppended journal) true]
    [(replay/JournalRejected code detail) false]))

(defn divergent-at-one? [result replay/ReplayComparison] Bool
  (match result
    [(replay/ReplayDiverged stable-count expected observed) (= stable-count 1)]
    [(replay/ReplayEqual stable-count) false]
    [(replay/ReplayExpectedPrefix stable-count) false]
    [(replay/ReplayObservedPrefix stable-count) false]
    [(replay/ReplayInvalid code detail) false]))

(defn observed-prefix? [result replay/ReplayComparison] Bool
  (match result
    [(replay/ReplayObservedPrefix stable-count) (= stable-count 1)]
    [(replay/ReplayEqual stable-count) false]
    [(replay/ReplayExpectedPrefix stable-count) false]
    [(replay/ReplayDiverged stable-count expected observed) false]
    [(replay/ReplayInvalid code detail) false]))

(defn terminal-provenance [result replay/TerminalSummary] replay/TerminalProvenance
  (match result
    [(replay/TerminalSummarized provenance) provenance]
    [(replay/TerminalNotReady code detail)
     (replay/->TerminalProvenance "" (replay/->ReplayEvent 0 "" :replay/terminal "") 0)]))

(defn contradiction? [result replay/ProvenanceAdmission] Bool
  (match result
    [(replay/ProvenanceRejected code detail) (= code :provenance/contradiction)]
    [(replay/ProvenanceRecorded provenance) false]))

(defn main [] Int
  (let [initial replay/ReplayJournal (replay/empty-journal "run-a")
        started replay/JournalAppend
        (replay/append-event initial
          (replay/->ReplayEvent 0 "task-a" :replay/step "started"))
        resumable replay/ReplayJournal (appended-journal started)
        terminal-result replay/JournalAppend
        (replay/append-event resumable
          (replay/->ReplayEvent 1 "task-a" :replay/terminal "completed"))
        terminal-journal replay/ReplayJournal (appended-journal terminal-result)
        contradictory-terminal replay/ReplayJournal
        (replay/->ReplayJournal
          "run-a"
          [(replay/->ReplayEvent 0 "task-a" :replay/step "started")
           (replay/->ReplayEvent 1 "task-a" :replay/terminal "failed")])
        summary replay/TerminalProvenance
        (terminal-provenance (replay/terminal-summary terminal-journal))
        contradiction replay/ProvenanceAdmission
        (replay/admit-provenance
          summary
          (replay/->TerminalProvenance
            "run-a"
            (replay/->ReplayEvent 1 "task-a" :replay/terminal "failed")
            2))]
    (if (and
         (appended? started)
         (appended? terminal-result)
         (not (appended?
               (replay/append-event terminal-journal
                 (replay/->ReplayEvent 2 "task-a" :replay/step "late"))))
         (not (appended?
               (replay/append-event resumable
                 (replay/->ReplayEvent 2 "task-a" :replay/step "skipped"))))
         (divergent-at-one?
          (replay/compare-replay terminal-journal contradictory-terminal))
         (observed-prefix?
          (replay/compare-replay terminal-journal resumable))
         (contradiction? contradiction))
      0
      1)))
