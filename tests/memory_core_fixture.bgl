#lang beagle

(ns north.memory-core-fixture
  (:require [north.memory-core :as memory]))

(def scope memory/MemoryScope
  (memory/->MemoryScope "north" "operator"))

(def request memory/RecallRequest
  (memory/->RecallRequest scope "deploy-status" 100 60 4 2))

(defn assertion-fact
  [fact-id String
   text String
   supersedes (Vec String)] memory/MemoryFact
  (memory/->MemoryFact
   fact-id scope "deploy-status" (memory/->Assertion text)
   (memory/->HumanSource "operator" "observation")
   (memory/->Trust 80) (memory/->Supported "observation")
   0 nil supersedes []))

(def stale memory/MemoryFact
  (assertion-fact "status-old" "deployment pending" []))

(def current memory/MemoryFact
  (assertion-fact "status-current" "deployment ready" ["status-old"]))

(def invalidate-current memory/MemoryFact
  (memory/->MemoryFact
   "status-retracted" scope "deploy-status"
   (memory/->Invalidation "receipt revoked")
   (memory/->ToolSource "receipt-check" "run-9")
   (memory/->Trust 95) (memory/->Supported "receipt-9")
   0 nil [] ["status-current"]))

(defn ready-with-current? [decision memory/RecallDecision] Bool
  (match decision
    [(memory/ContextReady facts)
     (and (= 1 (count facts))
          (= "status-current" (memory/memoryfact-fact-id (first facts))))]
    [(memory/NoContext reason) false]))

(defn no-context? [decision memory/RecallDecision reason Keyword] Bool
  (match decision
    [(memory/ContextReady facts) false]
    [(memory/NoContext observed) (= reason observed)]))

(defn main [] Int
  (let [ready-page memory/StoreMemoryPage
        (memory/->StoreMemoryPage [stale current] true)
        incomplete-page memory/StoreMemoryPage
        (memory/->StoreMemoryPage [stale current] false)
        invalidated-page memory/StoreMemoryPage
        (memory/->StoreMemoryPage [stale current invalidate-current] true)]
    (if (and (ready-with-current? (memory/recall ready-page request))
             (no-context? (memory/recall incomplete-page request)
                          :memory/incomplete-page)
             (no-context? (memory/recall invalidated-page request)
                          :memory/no-admissible-facts))
      0
      1)))
