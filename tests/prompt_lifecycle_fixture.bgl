#lang beagle
(ns north.prompt-lifecycle-fixture
  (:require [north.prompt-lifecycle :as lifecycle]))

(defn closes-only-one-unfinished-attempt? [] Bool
  (let [ledger (Vec lifecycle/PromptEvent)
        [(->lifecycle/PromptStarted "prompt-1" "attempt-1")
         (->lifecycle/PromptStarted "prompt-2" "attempt-2")]
        reconciliation lifecycle/Reconciliation
        (lifecycle/reconcile-interrupted ledger "attempt-2")]
    (and (= (count (lifecycle/reconciliation-ledger reconciliation)) 3)
         (lifecycle/reconciliation-complete?
          (lifecycle/reconciliation-status reconciliation)))))

(defn reports-ambiguous-attempt? [] Bool
  (let [ledger (Vec lifecycle/PromptEvent)
        [(->lifecycle/PromptStarted "prompt-1" "attempt-1")
         (->lifecycle/PromptStarted "prompt-2" "attempt-1")]
        reconciliation lifecycle/Reconciliation
        (lifecycle/reconcile-interrupted ledger "attempt-1")
        status lifecycle/ReconciliationStatus
        (lifecycle/reconciliation-status reconciliation)]
    (and (= (count (lifecycle/reconciliation-ledger reconciliation)) 2)
         (= (lifecycle/reconciliation-ambiguity-count status) 2))))
