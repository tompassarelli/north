#lang beagle

(ns north.recovery-context-core-fixture
  (:require [north.recovery-context-core :as recovery]
            [north.replay-core :as replay]
            [north.session-core :as session]))

(def raw-provider-session-id "provider-session-must-not-survive")

(defn projected-context
  [result recovery/RecoveryProjection] recovery/RecoveryContextProjection
  (match result
    [(recovery/RecoveryProjected projection) projection]
    [(recovery/RecoveryUnavailable code detail)
     (recovery/->RecoveryContextProjection
      ""
      (replay/->TerminalProvenance
       ""
       (replay/->ReplayEvent 0 "" :replay/terminal "")
       0)
      ""
      []
      [])]))

(defn successor-admitted?
  [result recovery/SuccessorContextAdmission
   successor-run-id String] Bool
  (match result
    [(recovery/SuccessorContextAdmitted context)
     (= (recovery/successorrecoverycontext-successor-run-id context)
        successor-run-id)]
    [(recovery/SuccessorContextRejected code detail) false]))

(defn successor-rejected?
  [result recovery/SuccessorContextAdmission] Bool
  (match result
    [(recovery/SuccessorContextAdmitted context) false]
    [(recovery/SuccessorContextRejected code detail) true]))

(defn terminal-process-died?
  [projection recovery/RecoveryContextProjection] Bool
  (= "provider_process_died"
     (replay/replayevent-evidence
      (replay/terminalprovenance-terminal-event
       (recovery/recoverycontextprojection-terminal-provenance projection)))))

(defn exact-completed-tail?
  [projection recovery/RecoveryContextProjection] Bool
  (let [tail (Vec recovery/CompletedContextEntry) (recovery/recoverycontextprojection-completed-tail projection)]
    (and (= 1 (count tail))
         (and (= "event/tail"
                 (recovery/completedcontextentry-event-id (nth tail 0)))
              (= "assistant completed"
                 (recovery/completedcontextentry-body (nth tail 0)))))))

(defn exact-unknown-tool?
  [projection recovery/RecoveryContextProjection] Bool
  (let [effects (Vec recovery/UnsettledEffect) (recovery/recoverycontextprojection-unsettled-effects projection)]
    (and (= 1 (count effects))
         (and (= "tool/write-42"
                 (recovery/unsettledeffect-effect-id (nth effects 0)))
              (= :unknown
                 (recovery/unsettledeffect-disposition (nth effects 0)))))))

(defn raw-provider-id-absent?
  [projection recovery/RecoveryContextProjection] Bool
  (let [tail (Vec recovery/CompletedContextEntry) (recovery/recoverycontextprojection-completed-tail projection)
        effects (Vec recovery/UnsettledEffect) (recovery/recoverycontextprojection-unsettled-effects projection)]
    (and (not= raw-provider-session-id
               (recovery/recoverycontextprojection-source-run-id projection))
         (and (not= raw-provider-session-id
                    (recovery/recoverycontextprojection-compaction-summary projection))
              (and
               (or (= 0 (count tail))
                   (not= raw-provider-session-id
                          (recovery/completedcontextentry-body (nth tail 0))))
               (or (= 0 (count effects))
                   (not= raw-provider-session-id
                          (recovery/unsettledeffect-effect-id
                           (nth effects 0)))))))))

(defn exact-projection?
  [projection recovery/RecoveryContextProjection] Bool
  (and (= "run/source"
          (recovery/recoverycontextprojection-source-run-id projection))
       (and (= "summary/v1"
               (recovery/recoverycontextprojection-compaction-summary projection))
            (and (terminal-process-died? projection)
                 (and (exact-completed-tail? projection)
                      (and (exact-unknown-tool? projection)
                           (raw-provider-id-absent? projection)))))))

(defn main [] Int
  (let [root session/SessionEvent (session/->SessionEvent
         "event/root" 0 "session/internal" nil nil :message "root completed")
        compaction session/SessionEvent (session/->SessionEvent
         "event/compact" 1 "session/internal" "event/root" nil
         :compaction "summary/v1")
        tail session/SessionEvent (session/->SessionEvent
         "event/tail" 2 "session/internal" "event/compact" nil
         :message "assistant completed")
        pending-input session/SessionEvent (session/->SessionEvent
         "event/pending-input" 3 "session/internal" "event/tail" nil
         :input raw-provider-session-id)
        restored-ledger session/SessionLedger (session/->SessionLedger [root compaction tail pending-input])
        restored-journal replay/ReplayJournal (replay/->ReplayJournal
         "run/source"
         [(replay/->ReplayEvent
           0 "event/root" :context/completed "store/event-root")
          (replay/->ReplayEvent
           1 "event/tail" :context/completed "store/event-tail")
          (replay/->ReplayEvent
           2 "tool/write-42" :effect/admitted "tool/write")
          (replay/->ReplayEvent
           3 "run/source" :replay/terminal "provider_process_died")])
        first recovery/RecoveryContextProjection (projected-context
         (recovery/project-recovery-context
          restored-ledger "session/internal" restored-journal))
        second recovery/RecoveryContextProjection (projected-context
         (recovery/project-recovery-context
          restored-ledger "session/internal" restored-journal))
        wrong-source recovery/SuccessorContextAdmission (recovery/admit-successor-context
         first
         (recovery/->SuccessorContextRequest "run/other" "run/successor"))
        no-successor recovery/SuccessorContextAdmission (recovery/admit-successor-context
         first
         (recovery/->SuccessorContextRequest "run/source" ""))
        admitted recovery/SuccessorContextAdmission (recovery/admit-successor-context
         first
         (recovery/->SuccessorContextRequest "run/source" "run/successor"))]
    (if (and (exact-projection? first)
             (and (exact-projection? second)
                  (and (successor-rejected? wrong-source)
                       (and (successor-rejected? no-successor)
                            (successor-admitted? admitted "run/successor")))))
      0
      1)))
