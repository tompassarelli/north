#lang beagle/clj
(ns north.projections
  "Read-only dependency-derived views over canonical Beagle Store Triples.")

(require [store.types :as t])
(require [store.kernel-classify :as kc])
(require [clojure.string :as str])

;; Triple slots are Any because Beagle Store's recursive Term ABI cannot be expressed
;; in-place. The Triple constructor validates the recursive Term boundary.
(defalias TermKey (Vec Any))
(defalias SingleIndex (Map TermKey Any))
(defalias MultiIndex (Map TermKey (Vec Any)))
(defalias ReverseIndex (Map Any (Vec Any)))

(defrecord ProjectionIndex
  [single SingleIndex
   many MultiIndex
   subjects (Vec Any)
   subject-set (Map Any Bool)
   reverse-dependencies ReverseIndex
   reference-predicates (Vec String)
   acyclic-predicates (Vec String)])

(def no-terms (Vec Any) [])
(def fallback-reference-predicates (Vec String)
  ["depends_on" "part_of" "relates_to" "clarifies" "amends"])
(def fallback-acyclic-predicates (Vec String) ["depends_on" "part_of"])

(defn- schema-predicate-name [subject String] String
  (if (str/starts-with? subject "@") (subs subject 1) subject))

(defn- set-string-membership
  [members (Vec String)
   value String
   present? Bool] (Vec String)
  (if present?
    (if (kc/vec-member? members value) members (conj members value))
    (filterv (fn [member String] Bool (not (= member value))) members)))

(defn index-triples [triples (Vec t/Triple)] ProjectionIndex
  (let [base ProjectionIndex (reduce
         (fn
           [index ProjectionIndex
            triple t/Triple] ProjectionIndex
           (let [subject Any (t/triple-t1 triple)
                 predicate Any (t/triple-t2 triple)
                 value Any (t/triple-t3 triple)
                 key TermKey [subject predicate]
                 values (Vec Any) (conj (get (projectionindex-many index) key no-terms) value)
                 reverse ReverseIndex (if (= predicate "depends_on")
                   (assoc (projectionindex-reverse-dependencies index)
                          value
                          (conj (get (projectionindex-reverse-dependencies index)
                                     value no-terms)
                                subject))
                   (projectionindex-reverse-dependencies index))
                 known-subject Bool (contains? (projectionindex-subject-set index) subject)]
             (->ProjectionIndex
              (assoc (projectionindex-single index) key value)
              (assoc (projectionindex-many index) key values)
              (if known-subject
                (projectionindex-subjects index)
                (conj (projectionindex-subjects index) subject))
              (if known-subject
                (projectionindex-subject-set index)
                (assoc (projectionindex-subject-set index) subject true))
              reverse
              (projectionindex-reference-predicates index)
              (projectionindex-acyclic-predicates index))))
         (->ProjectionIndex {} {} [] {} {} [] [])
         triples)
        schema (Vec (Vec String)) (reduce
         (fn
           [rows (Vec (Vec String))
            subject Any] (Vec (Vec String))
           (if (string? subject)
             (let [value-kind Any (get (projectionindex-single base) [subject "value_kind"])
                   acyclic Any (get (projectionindex-single base) [subject "acyclic"])]
               (if (or (string? value-kind) (string? acyclic))
                 (conj rows [(schema-predicate-name subject)
                             (if (string? value-kind) value-kind "")
                             (if (string? acyclic) acyclic "")])
                 rows))
             rows))
         []
         (projectionindex-subjects base))
        reference-predicates (Vec String) (reduce
         (fn
           [predicates (Vec String)
            row (Vec String)] (Vec String)
           (let [kind String (nth row 1)]
             (if (= kind "") predicates
                 (set-string-membership predicates (nth row 0) (= kind "ref")))))
         fallback-reference-predicates
         schema)
        acyclic-predicates (Vec String) (reduce
         (fn
           [predicates (Vec String)
            row (Vec String)] (Vec String)
           (let [declared String (nth row 2)]
             (if (= declared "") predicates
                 (set-string-membership predicates (nth row 0) (= declared "true")))))
         fallback-acyclic-predicates
         schema)]
    (->ProjectionIndex
     (projectionindex-single base)
     (projectionindex-many base)
     (projectionindex-subjects base)
     (projectionindex-subject-set base)
     (projectionindex-reverse-dependencies base)
     reference-predicates
     acyclic-predicates)))

(defn value-at
  [index ProjectionIndex
   subject Any
   predicate Any] Any
  (get (projectionindex-single index) [subject predicate]))

(defn values-at
  [index ProjectionIndex
   subject Any
   predicate Any] (Vec Any)
  (get (projectionindex-many index) [subject predicate] no-terms))

(defn string-value-at
  [index ProjectionIndex
   subject Any
   predicate Any] String?
  (let [value Any (value-at index subject predicate)]
    (if (string? value) value nil)))

(defn string-values-at
  [index ProjectionIndex
   subject Any
   predicate Any] (Vec String)
  (reduce
   (fn
     [values (Vec String)
      value Any] (Vec String)
     (if (string? value) (conj values value) values))
   []
   (values-at index subject predicate)))

(defn all-subjects [index ProjectionIndex] (Vec String)
  (reduce
   (fn
     [subjects (Vec String)
      subject Any] (Vec String)
     (if (string? subject) (conj subjects subject) subjects))
   []
   (projectionindex-subjects index)))

(defn subject?
  [index ProjectionIndex
   subject String] Bool
  (contains? (projectionindex-subject-set index) subject))

(def configured-single-predicates (Vec String)
  (let [configured String? (System/getenv "BEAGLE_STORE_SINGLE_VALUED")]
    (if (and (some? configured) (not (str/blank? configured)))
      (vec (str/split configured #"\s+"))
      [])))

(defn single-valued?
  [index ProjectionIndex
   predicate String] Bool
  (let [declared String? (string-value-at index (str "@" predicate) "cardinality")]
    (kc/single-eff? (some? declared)
                    (= declared "single")
                    (kc/configured-single? configured-single-predicates predicate)
                    predicate)))

(defn thread-subjects [index ProjectionIndex] (Vec String)
  (reduce
   (fn
     [subjects (Vec String)
      subject Any] (Vec String)
     (if (and (string? subject)
              (some? (string-value-at index subject "title")))
       (conj subjects subject)
       subjects))
   []
   (projectionindex-subjects index)))

(defn dependents-of
  [index ProjectionIndex
   subject String] (Vec String)
  (reduce
   (fn
     [subjects (Vec String)
      candidate Any] (Vec String)
     (if (string? candidate) (conj subjects candidate) subjects))
   []
   (get (projectionindex-reverse-dependencies index) subject no-terms)))

;; --- lifecycle vocab + derivation (moved out of the Store kernel) -------------
;; Lifecycle is DERIVED, never a stored status: the engine stores the facts but
;; north OWNS the derivation. terminal = resolved (outcome/abandoned/
;; superseded_by); withdrawn = a depends_on target that's suspect to depend on
;; (abandoned). The vocab mirrors the env contract bin/north exports
;; (BEAGLE_STORE_TERMINAL_PREDS / BEAGLE_STORE_WITHDRAWN_PREDS); the defaults ARE the north
;; lifecycle vocab.
(def terminal-preds (Vec String)
  (let [env String? (System/getenv "BEAGLE_STORE_TERMINAL_PREDS")]
    (if (and (some? env) (not (= env "")))
      (vec (str/split env #"\s+"))
      ["outcome" "abandoned" "superseded_by"])))

(def withdrawn-preds (Vec String)
  (let [env String? (System/getenv "BEAGLE_STORE_WITHDRAWN_PREDS")]
    (if (and (some? env) (not (= env "")))
      (vec (str/split env #"\s+"))
      ["abandoned"])))

(defn- any-of-i?
  [idx ProjectionIndex
   te String
   preds (Vec String)] Bool
  (loop [ps (Vec String) preds]
    (if (empty? ps) false
      (if (some? (string-value-at idx te (first ps))) true (recur (rest ps))))))

;; terminal = resolved: any of terminal-preds present (default outcome/abandoned/superseded_by).
(defn terminal-i?
  [idx ProjectionIndex
   te String] Bool
  (any-of-i? idx te terminal-preds))

;; withdrawn = canceled: any of withdrawn-preds present (default abandoned).
(defn withdrawn-i?
  [idx ProjectionIndex
   te String] Bool
  (any-of-i? idx te withdrawn-preds))

;; --- work-thread set (moved out of the Store kernel) --------------------------
;; WORK semantics, not a structural engine concern: which titled nodes are
;; actionable work vs grouping anchors. A grouping anchor is a node synthesized
;; only to be a relates_to target (former tags), never authored work — a valid
;; edge target (validation still sees it) but NOT actionable, so WORK projections
;; exclude it. The discriminator is STRUCTURAL: a titled, committed node carrying
;; NO work axis at all (no completion / activity / blocked / schedule /
;; composition / planning / accountability / chronology / navigation predicate).
(defn anchor-i?
  [idx ProjectionIndex
   te String] Bool
  (and (some? (string-value-at idx te "title"))
       (and (some? (string-value-at idx te "committed"))
            (and (not (terminal-i? idx te))
                 (and (nil? (string-value-at idx te "driver"))
                      (and (empty? (string-values-at idx te "depends_on"))
                           (and (nil? (string-value-at idx te "part_of"))
                                (and (nil? (string-value-at idx te "do_on"))
                                     (and (nil? (string-value-at idx te "valid_until"))
                                          (and (nil? (string-value-at idx te "estimate_hours"))
                                               (and (nil? (string-value-at idx te "lead"))
                                                    (and (empty? (string-values-at idx te "proposed_by"))
                                                         (and (nil? (string-value-at idx te "created_at"))
                                                              (and (nil? (string-value-at idx te "updated_at"))
                                                                   (nil? (string-value-at idx te "repo"))))))))))))))))

;; thread ids that are actual work (anchors excluded) — the basis for plate/
;; ready/next/leverage/agenda. Structural callers use thread-subjects directly.
(defn work-thread-ids-i [idx ProjectionIndex] (Vec String)
  (filterv (fn [s String] Bool (not (anchor-i? idx s)))
           (thread-subjects idx)))

;; Flat eligibility reads the shared index; recursive leverage owns the graph walk.

;; Direct deps of te that are known threads and not yet terminal.
(defn incomplete-deps
  [idx ProjectionIndex
   te String] (Vec String)
  (filterv (fn [d String] Bool
             (and (some? (string-value-at idx d "title"))
                  (not (terminal-i? idx d))))
           (string-values-at idx te "depends_on")))

(defn blocked?
  [idx ProjectionIndex
   te String] Bool
  (not (empty? (incomplete-deps idx te))))

;; Schedule axis (the-model §3/§7): a thread is DORMANT iff it carries a future
;; `do_on` (start date strictly after today) — it drops out of ready/next until
;; its date. A past/equal do_on is NOT dormant (it's live/overdue). today/before?
;; are threaded through callers exactly as staleness.bclj does (before? =
;; store.rt/str-lt?); projections has no clock access of its own.
(defn dormant?
  [idx ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)] Bool
  (let [d String? (string-value-at idx te "do_on")]
    (and (some? d) (before? today d))))

;; --- driver ACTIVITY is an explicit three-valued classifier input ------------
;; A `driver` fact is an assignment, not proof of activity now. The classifier
;; consumes one derived judgment per thread:
;;   LiveProven   — one valid, unexpired session lease proves activity;
;;   AbsentProven — the complete projection contains no driver assignment;
;;   Unresolved   — an assignment exists but its activity cannot be proved.
;; Only AbsentProven may fall through toward ready. Unknown judgment values fail
;; closed as unresolved, so malformed or conflicting evidence is never pull
;; authority. Production derives the judgment from the served Store snapshot;
;; tests inject a deterministic function.
(def live-proven "LiveProven")
(def absent-proven "AbsentProven")
(def unresolved "Unresolved")

(defn assigned?
  [idx ProjectionIndex
   te String] Bool
  (not (empty? (values-at idx te "driver"))))

;; The ONE shared precedence classifier (the-model §3): every single-bucket view
;; calls this, so two views can never disagree. EXACT precedence:
;;   terminal > blocked > active > unresolved > dormant > ready > draft
;; `active` requires LiveProven. An assigned thread without positive liveness is
;; unresolved, retained, and ineligible; it never falls through to ready.
;; `dormant` (a future do_on) dominates `ready`: a committed thread scheduled for
;; later is NOT pull-able now, so it drops out of ready/next EVERYWHERE (schedule
;; is an eligibility gate, not a display hint — the prior "committed dominates the
;; schedule" split let board call it ready while the work queue hid it).
(defn classify
  [idx ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   activity (Fn [ProjectionIndex String] String)] String
  (cond
    [(terminal-i? idx te) "terminal"]
    [(blocked? idx te) "blocked"]
    [:else
     (let [judgment String (activity idx te)]
       (cond
         [(= judgment live-proven) "active"]
         [(not (= judgment absent-proven)) "unresolved"]
         [(dormant? idx te today before?) "dormant"]
         [(some? (string-value-at idx te "committed")) "ready"]
         [:else "draft"]))]))

;; ELIGIBILITY is DERIVED from the one classifier, never a parallel filter: a
;; thread is pull-able now iff it classifies `ready` (committed + unblocked +
;; AbsentProven + not scheduled-later). ready/next/board's READY bucket all
;; reduce to this predicate, so their eligibility sets are identical by
;; construction.
(defn eligible?
  [idx ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   activity (Fn [ProjectionIndex String] String)] Bool
  (= (classify idx te today before? activity) "ready"))

(defn ready
  [idx ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   activity (Fn [ProjectionIndex String] String)] (Vec String)
  (filterv (fn [te String] Bool (eligible? idx te today before? activity))
           (work-thread-ids-i idx)))

;; One-line human/agent explanation of WHY a thread is (in)eligible — the state
;; plus its load-bearing reason. Shared by next (per-recommendation eligibility)
;; and grooming so the answer to "why isn't this in my queue?" is derived from the
;; same classifier, never re-explained ad hoc.
(defrecord Eligibility
  [state String
   eligible Bool
   reason String])

(defn explain
  [idx ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   activity (Fn [ProjectionIndex String] String)] Eligibility
  (let [st String (classify idx te today before? activity)]
    (->Eligibility
     st
     (= st "ready")
     (cond
       [(= st "terminal") "resolved (outcome/abandoned/superseded_by) — not workable"]
       [(= st "blocked") (str "waiting on " (count (incomplete-deps idx te)) " incomplete dependency(ies)")]
       [(= st "active") "a live driver is on it now — being worked, not pull-able"]
       [(= st "unresolved") "a driver is assigned but activity is not proved — retained, not pull-able"]
       [(= st "dormant") (str "scheduled for a future do_on (" (let [d String? (string-value-at idx te "do_on")] (if (some? d) d "?")) ") — dormant until then")]
       [(= st "ready") "committed, unblocked, assignment absence proved, not scheduled-later — pull anytime"]
       [:else "uncommitted draft — decide + commit before it is work"]))))

(defn blocked [idx ProjectionIndex] (Vec String)
  (filterv (fn [te String] Bool
             (and (not (terminal-i? idx te)) (blocked? idx te)))
           (work-thread-ids-i idx)))

;; Derived condition of a work thread — delegates to the ONE precedence classifier
;; so plate text + json + the blocked command all agree. activity is threaded
;; through exactly as today/before? are (the caller owns the evidence judgment).
(defn condition-i
  [idx ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   activity (Fn [ProjectionIndex String] String)] String
  (classify idx te today before? activity))

;; Presentation: a deterministic, user-configurable emoji per condition. Engine
;; defaults here; any is overridden by a fact `@ui emoji_<condition> "<glyph>"`,
;; so the map is data the user owns — not the LLM's stochastic choice.
(defn- default-emoji [c String] String
  (cond
    [(= c "active") "🔵"]
    [(= c "unresolved") "🟠"]
    [(= c "ready") "🟢"]
    [(= c "blocked") "🔴"]
    [(= c "dormant") "🟡"]
    [(= c "terminal") "⚫"]
    [(= c "draft") "⚪"]
    [:else "•"]))

(defn condition-emoji
  [idx ProjectionIndex
   c String] String
  (let [o String? (string-value-at idx "@ui" (str "emoji_" c))]
    (if (some? o) o (default-emoji c))))

;; --- leverage: transitive reverse-dep walk over the prebuilt revdep index ----

(defn transitive-dependents
  [idx ProjectionIndex
   te String] (Vec String)
  (loop [frontier (Vec String) (dependents-of idx te)
         seen (Map String Bool) {}
         ordered (Vec String) []]
    (if (empty? frontier)
      ordered
      (let [x String (first frontier)
            rest-f (Vec String) (vec (rest frontier))]
        (if (contains? seen x)
          (recur rest-f seen ordered)
          (recur (vec (concat rest-f (dependents-of idx x)))
                 (assoc seen x true)
                 (conj ordered x)))))))

(defn leverage-score
  [idx ProjectionIndex
   te String] Int
  (count (filterv (fn [d String] Bool
                    (and (not (= d te)) (not (terminal-i? idx d))))
                  (transitive-dependents idx te))))
