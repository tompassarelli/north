#lang beagle/clj
(ns north.main
  "North life CLI: the lifecycle/projection verbs (ready, blocked, leverage,
  next, agenda, threads, capture, needs-review, audit, boot, json). Runs on
  the Beagle Store engine (store.*); engine verbs (tell/import/...) are routed to
  the Beagle Store CLI by the bin/north wrapper."
  (:gen-class))

(require store.kernel-classify :as kc)
(require store.types :as t)
(require store.export :as exp)
(require north.projections :as proj)
(require north.validate :as val)
(require north.staleness :as stale)
(require north.audit :as audit)
(require clojure.string :as str)
(require cheshire.core)
(require store.rt)
(import java.util.Random)   ; non-java.lang classes need an explicit import
(import java.util.UUID)

;; North publishes mutations only through canonical Store RPC. Deliberately
;; omitting a storage writer keeps this client from opening Store log bytes.
(declare-extern store.rt/today-iso (Fn [] String))
(declare-extern store.rt/now-iso (Fn [] String))
(declare-extern store.rt/iso-to-seconds (Fn [String] Int))
(declare-extern store.rt/is-iso-datetime-19 (Fn [String] Bool))
(declare-extern store.rt/is-iso-datetime-16 (Fn [String] Bool))
(declare-extern store.rt/parse-int (Fn [String] Int))
(declare-extern store.rt/str-lt? (Fn [String String] Bool))
(declare-extern cheshire.core/generate-string (Fn [Any] String))
(declare-extern store.rt/ensure-dir (Fn [String] Nil))
(declare-extern store.rt/spit-file (Fn [String String] Nil))
(declare-extern store.rt/file-exists (Fn [String] Bool))
(declare-extern store.rt/delete-file (Fn [String] Nil))
(declare-extern store.rt/slugify (Fn [String] String))
(declare-extern store.rt/getenv (Fn [String] (U String Nil)))
(declare-extern clojure.core/ns-resolve (Fn [Any Any] Any))

(defn- getenv-or
  [name String
   default String] String
  (let [value (U String Nil) (store.rt/getenv name)]
    (if (nil? value) default value)))

(defn- to-json [value Any] String
  (cheshire.core/generate-string value))

(defn- threads-dir [] String
  (getenv-or "BEAGLE_STORE_THREADS" (str (System/getProperty "user.dir") "/threads")))

(defn- log-path [] String
  (getenv-or "BEAGLE_STORE_LOG" (str (System/getProperty "user.dir") "/coordination.log")))

(defn- string-term [value Any] String
  (if (string? value)
    value
    (throw (ex-info "North coordination data requires String Triple terms"
                    {:type :north/non-string-triple}))))

(defn- triple-subject [value t/Triple] String
  (string-term (t/triple-t1 value)))

(defn- triple-predicate [value t/Triple] String
  (string-term (t/triple-t2 value)))

(defn- triple-value [value t/Triple] String
  (string-term (t/triple-t3 value)))

;; bin/north preloads the Clojure coordination facade before loading this
;; compiled namespace. Resolve that runtime boundary lazily so pure projection
;; consumers can still require north.main without opening a socket or loading a
;; CLI script.
(defn- coord-invoke
  [operation String
   args (Vec Any)] Any
  (let [callable Any (clojure.core/ns-resolve (symbol "north.coord") (symbol operation))]
    (if (some? callable)
      (apply callable args)
      (throw (ex-info "north.coord must be loaded before a data operation"
                      {:type :north/coord-not-loaded
                       :operation operation})))))

(defn- coord-port [] Int
  (let [value Any (coord-invoke "port" [])]
    (if (int? value)
      value
      (throw (ex-info "north.coord returned an invalid port"
                      {:type :north/invalid-coord-port})))))

(defn- coord-propositions
  [operation String
   args (Vec Any)] (Vec t/Triple)
  (let [value Any (coord-invoke operation args)]
    (if (and (vector? value) (every? t/triple? value))
      value
      (throw (ex-info "north.coord returned a malformed Triple projection"
                      {:type :north/invalid-coord-projection
                       :operation operation})))))

(defn- coord-live-propositions [port Int] (Vec t/Triple)
  (coord-propositions "live-propositions" [port]))

(defn- coord-subject-propositions
  [port Int
   subject String] (Vec t/Triple)
  (coord-propositions "subject-propositions" [port subject]))

;; --- thread id: north-owned UUIDv7 minter --------------------------------
;; A UUIDv7 packs a 48-bit ms timestamp in the high bits, so ids are both
;; collision-proof and k-sortable (lexicographic order ~ chronological). This is
;; north-owned ON PURPOSE: store.rt/now-id (the @timestamp scheme) has other
;; callers and stays untouched. created_at — not the id's internal bits — is the
;; app's ordering/display key; the id carries only identity.
(defn uuidv7 [] String
  (let [ts Int (System/currentTimeMillis)
        r Any (Random.)
        msb Int (bit-or (bit-shift-left ts 16) 0x7000 (bit-and (.nextInt r) 0xFFF))
        lsb Int (bit-or (bit-shift-left 2 62) (bit-and (.nextLong r) 0x3FFFFFFFFFFFFFFF))]
    (str (UUID. msb lsb))))

;; --- display helpers --------------------------------------------------------

(defn- title-of
  [idx proj/ProjectionIndex
   te String]
  String
  (let [t (U String Nil) (proj/string-value-at idx te "title")] (if (some? t) t "")))

(defn- short-id [te String] String
  (if (str/starts-with? te "@") (subs te 1) te))

;; --- ref resolution: @id OR @handle -> canonical @id ------------------------
;; The view/boundary concern. An id is an opaque immutable key; a handle is an
;; optional mutable human alias. Beagle Store NEVER sees a handle — capture/tell/CLI hand
;; it a ref, this maps it to the canonical id first. Passthrough when the ref
;; already names a thread (has a title); else find a thread whose `handle` fact
;; equals the ref (sans @), latest created_at winning ties; else ref unchanged.
(defn resolve-ref
  [idx proj/ProjectionIndex
   ref String]
  String
  (if (some? (proj/string-value-at idx ref "title"))
    ref
    (let [bare String (short-id ref)
          matches (Vec String) (filterv (fn [te String] Bool
                             (let [h (U String Nil) (proj/string-value-at idx te "handle")]
                               (and (some? h) (= h bare))))
                           (proj/thread-subjects idx))]
      (if (empty? matches)
        ;; no handle match — try a UNIQUE id-prefix (the short form people paste).
        ;; Blank never prefix-matches (it would match every thread); an ambiguous
        ;; or unknown prefix resolves nothing here — cmd-resolve polices id-like
        ;; fallthrough so a truncated id is REFUSED instead of minting a phantom.
        (let [pms (Vec String) (if (str/blank? bare)
                    []
                    (filterv (fn [te String] Bool
                               (str/starts-with? (short-id te) bare))
                             (proj/thread-subjects idx)))]
          (if (= (count pms) 1) (first pms) ref))
        (reduce (fn
                  [best String
                   te String] String
                  (if (str/blank? best)
                    te
                    (let [bc String (let [c (U String Nil) (proj/string-value-at idx best "created_at")] (if (some? c) c ""))
                          tc String (let [c (U String Nil) (proj/string-value-at idx te "created_at")] (if (some? c) c ""))]
                      (if (store.rt/str-lt? bc tc) te best))))
                "" matches)))))

(defn- trunc
  [s String
   n Int] String
  (if (> (count s) n) (str (subs s 0 (- n 1)) "…") s))

;; --- entity KIND: the census classifier ------------------------------------
;; `entity_kind` is the structural authority and remains open: namespaced
;; extensions are rendered exactly as stored. Legacy `kind`, reserved namespaces,
;; shapes, and executable predicate metadata classify subjects without an
;; explicit `entity_kind` fact.
(defn- legacy-entity-kind [ek String] String
  (cond
    [(or (= ek "lane") (or (= ek "managed") (= ek "session"))) "agent"]
    [(or (= ek "msg") (= ek "command")) "message"]
    [(= ek "mine") "north/mine"]
    [:else ek]))

;; DEFINITIVE namespaces — a subject id in one of these is that kind regardless of
;; whether it also carries a title (an un-kinded concern still has a title; the
;; `concern-` namespace is exclusive — no thread id ever starts with it). "" = not
;; a reserved namespace, fall through to the title/predicate check.
(defn- namespace-kind [bare String] String
  (cond
    [(str/starts-with? bare "concern-") "concern"]
    [(str/starts-with? bare "agent:") "agent"]
    [(or (str/starts-with? bare "msg:") (str/starts-with? bare "cmd:")) "message"]
    [(str/starts-with? bare "topic-") "topic"]
    [(str/starts-with? bare "mine:") "north/mine"]
    [(or (str/starts-with? bare "run-") (str/starts-with? bare "run:")) "run"]
    [(or (str/starts-with? bare "session:")
         (or (str/starts-with? bare "sess-") (str/starts-with? bare "cc-"))) "agent"]
    [(str/starts-with? bare "denial:") "guard_denial"]
    [(str/starts-with? bare "arena-") "north/arena_run"]
    [:else ""]))

(defn- kind-of [idx proj/ProjectionIndex te String?] String
  ;; Historical malformed writes can leave an unrenderable subject in a warm
  ;; store. The census is a diagnostic read: keep it total and surface that
  ;; subject in `other` instead of crashing before the operator can inspect it.
  (if (nil? te)
    "other"
    (let [explicit (U String Nil) (proj/string-value-at idx te "entity_kind")]
      (if (some? explicit)
        explicit
        (let [legacy (U String Nil) (proj/string-value-at idx te "kind")]
          (if (some? legacy)
            (legacy-entity-kind legacy)
            (let [np String (namespace-kind (short-id te))]
              (if (not (str/blank? np))
                np
                (if (some? (proj/string-value-at idx te "title"))
                  "thread"
                  (if (some? (proj/string-value-at idx te "display_name"))
                    "person"
                    ;; schema-as-facts predicate subject (cardinality/value_kind/acyclic)?
                    (if (or (some? (proj/string-value-at idx te "cardinality"))
                            (or (some? (proj/string-value-at idx te "value_kind"))
                                (some? (proj/string-value-at idx te "acyclic"))))
                      "predicate"
                      "other")))))))))))

;; The human label for a thread's driver: its display_name if the agent carries
;; one, else the bare ref — board legibility (who's on what).
(defn- driver-label
  [idx proj/ProjectionIndex
   te String]
  String
  (let [d (U String Nil) (proj/string-value-at idx te "driver")]
    (if (nil? d)
      ""
      (let [dn (U String Nil) (proj/string-value-at idx d "display_name")]
        (if (some? dn) dn (short-id d))))))

(defrecord LevItem
  [te String
   score Int])
;; A next recommendation carries its SCORE and the orthogonal components that
;; produced it, each a DISTINCT documented axis (never silently summed into one
;; opaque number):
;;   leverage  — graph leverage: how many stuck threads finishing this frees
;;               (transitive dependents). The dependency-sequencing signal.
;;   urgency   — schedule pressure from do_on (overdue > today > none).
;;   momentum  — a parked driver is already attached (prior pickup to RESUME);
;;               live-driven threads are `active`, not `ready`, so never scored.
;;   priority  — the stored P0/P1/… fact. Orthogonal + currently INERT (does not
;;               move the score); surfaced so the human can override the ranking.
;; score = 3*leverage + urgency + momentum. priority stays out of the arithmetic.
(defrecord NextItem
  [te String
   score Int
   leverage Int
   urgency Int
   momentum Int
   priority String
   sequencing Int
   basis String])
(defrecord QueueDirective
  [te String
   version Int
   position String
   anchor String])
(defrecord AgendaItem
  [te String
   do_on String])

;; queue_rank is an imperative ordering receipt, not lifecycle state. Replaying
;; each thread's latest move over the leverage order lets one atomic fact move a
;; card without rewriting every sibling rank.
(defn queue-rank-value
  [version Int
   position String
   anchor String] String
  (str "v1|" version "|" position "|" (if (str/blank? anchor) "_" anchor)))

(defn- queue-directive
  [idx proj/ProjectionIndex
   te String]
  QueueDirective?
  (let [raw (U String Nil) (proj/string-value-at idx te "queue_rank")
        parts (Vec String) (if (some? raw) (vec (str/split raw #"\|")) [])
        version Int (if (= (count parts) 4) (store.rt/parse-int (nth parts 1)) -1)
        position String (if (= (count parts) 4) (nth parts 2) "")
        anchor-token String (if (= (count parts) 4) (nth parts 3) "")
        anchor String (if (= anchor-token "_") "" anchor-token)
        relative? Bool (or (= position "before") (= position "after"))
        edge? Bool (or (= position "first") (= position "last"))]
    (if (and (= (if (some? raw) (nth parts 0) "") "v1")
             (and (>= version 0)
                  (or (and edge? (str/blank? anchor))
                      (and relative? (str/starts-with? anchor "@")))))
      (->QueueDirective te version position anchor)
      nil)))

(defn- queue-index
  [items (Vec String)
   target String] Int
  (loop [i Int 0]
    (cond
      [(>= i (count items)) -1]
      [(= (nth items i) target) i]
      [:else (recur (+ i 1))])))

(defn- queue-insert
  [items (Vec String)
   target String
   at Int] (Vec String)
  (loop [i Int 0
         result (Vec String) []]
    (if (>= i (count items))
      (if (= at i) (conj result target) result)
      (let [with-target (Vec String) (if (= at i) (conj result target) result)]
        (recur (+ i 1) (conj with-target (nth items i)))))))

(defn- apply-queue-directive
  [items (Vec String)
   directive QueueDirective] (Vec String)
  (let [te String (:te directive)
        old-index Int (queue-index items te)
        remaining (Vec String) (filterv (fn [item String] Bool (not (= item te))) items)
        anchor-index Int (queue-index remaining (:anchor directive))
        fallback-index Int (if (< old-index 0) (count remaining)
                           (if (> old-index (count remaining)) (count remaining) old-index))
        insert-index Int (cond
          [(= (:position directive) "first") 0]
          [(= (:position directive) "last") (count remaining)]
          [(and (= (:position directive) "before") (>= anchor-index 0)) anchor-index]
          [(and (= (:position directive) "after") (>= anchor-index 0)) (+ anchor-index 1)]
          [:else fallback-index])]
    (queue-insert remaining te insert-index)))

(defn- queue-order-from-base
  [idx proj/ProjectionIndex
   base (Vec String)]
  (Vec String)
  (let [directives (Vec QueueDirective) (reduce
         (fn
           [found (Vec QueueDirective)
            te String] (Vec QueueDirective)
           (let [directive (U QueueDirective Nil) (queue-directive idx te)]
             (if (some? directive) (conj found directive) found)))
         [] base)]
    (reduce
     (fn
       [ordered (Vec String)
        directive QueueDirective] (Vec String)
       (apply-queue-directive ordered directive))
     base
     (vec (sort-by (fn [directive QueueDirective] Int (:version directive)) directives)))))

(defn queue-order
  [idx proj/ProjectionIndex
   tes (Vec String)]
  (Vec String)
  (queue-order-from-base
   idx
   (vec (sort-by (fn [te String] Int (- 0 (proj/leverage-score idx te))) tes))))

;; Reads are Store RPC-authoritative. North never opens Store log bytes as a
;; client-side fallback; the physical log path is projection identity only.
(defn- coord-version [port Int] Int
  (try
    (let [value Any (coord-invoke "version" [port])]
      (if (int? value) value -1))
    (catch (_ Exception) -1)))

(defn- live-facts [log String] (Vec t/Triple)
  (let [port Int (coord-port)
        version Int (coord-version port)]
    (if (< version 0)
      (throw (ex-info (str "North Store RPC read failed on 127.0.0.1:" port
                           " (code " version ")")
                      {:type :north/server-unavailable
                       :port port
                       :log log}))
      (coord-live-propositions port))))

(defn- live-idx [log String] proj/ProjectionIndex
  (proj/index-triples (live-facts log)))

;; A failed exact-subject query and an absent subject both yield no local rows,
;; so callers retain the whole-corpus Store RPC fallback.
(defn- live-subject-facts
  [log String
   te String] (Vec t/Triple)
  (try
    (coord-subject-propositions (coord-port) te)
    (catch (_ Exception) [])))

(defn- subject-facts
  [log String
   te String] (Vec t/Triple)
  (let [warm (Vec store.types/Triple) (live-subject-facts log te)]
    (if (empty? warm)
      (filterv (fn [triple t/Triple] Bool
                 (= te (triple-subject triple)))
               (live-facts log))
      warm)))

;; --- write through canonical Store RPC (serialized under concurrent agents) ---
(defn store-rpc-failure-message
  [code Int
   port Int
   log String
   consequence String] String
  (let [summary String (cond
          [(= code -1)
           (str "Store RPC SERVER UNREACHABLE on 127.0.0.1:" port)]
          [(= code -2)
           (str "Store RPC SPACE MISMATCH on 127.0.0.1:" port
                " (this command selected Store log database " log ")")]
          [(= code -3)
           (str "Store RPC PROTOCOL INCOMPATIBLE on 127.0.0.1:" port)]
          [:else
           (str "Store RPC preflight failed on 127.0.0.1:" port
                " (code " code ")")])
        remedy String (cond
          [(= code -1) "Start the configured Beagle Store service"]
          [(= code -2)
           "Select the intended Store log database and SpaceId before retrying"]
          [(= code -3)
           "Use one matched North + Beagle Store release"]
          [:else "Inspect `north doctor` before retrying"])]
    (str summary
         (if (str/blank? consequence) "" (str " — " consequence))
         ". " remedy ".")))

(defn- tell-once
  [port Int
   log String
   op String
   te String
   pred String
   rv String] String
  (let [v Int (coord-version port)]
    (if (< v 0)
      "server-unavailable"
      (try
        (let [response Any (if (= op "assert")
                (coord-invoke "assert-at-version!" [port te pred rv v])
                (coord-invoke "retract-at-version!" [port te pred rv v]))
              committed Any (:ok response)
              rejected Any (:reject response)]
          (if (some? committed)
            (str "ok:" committed)
            (if (= rejected :conflict) "conflict" (str rejected))))
        (catch (_ Exception) "server-unavailable")))))

(defn- tell-retry
  [port Int
   log String
   op String
   te String
   pred String
   rv String
   tries Int] String
  (let [resp String (tell-once port log op te pred rv)]
    (if (and (= resp "conflict") (> tries 0))
      (tell-retry port log op te pred rv (- tries 1))
      resp)))

;; --- terminal capture: a one-line thought -> a thread -> folded -------------
(defn- ctrl? [s String] Bool
  (or (str/includes? s "\n") (str/includes? s "\r")))

(defn- add-fact
  [acc (Vec t/Triple)
   te String
   p String
   v String]
  (Vec t/Triple)
  (if (str/blank? v) acc (conj acc (t/triple te p v))))

(defn- ref-or-blank [v String] String
  (if (str/blank? v) "" (str "@" v)))

;; NO `driver` at birth (operating-manual): making a thread active is a deliberate
;; pickup (`tell <id> driver @x`), never a capture default — a driver cell here is
;; exactly the "stray driver" pollution the-model warns about.
;; Every new thread self-identifies as kind=thread in the same Store RPC
;; publication, so schema and database views need no subject-prefix guess.
;; single-valued (bin/north BEAGLE_STORE_SINGLE_VALUED); mirrors concern-cli, which
;; already stamps kind=concern. NO backfill of old subjects (maintenance/migration).
;; the-model §7: `personal` is the IMPLICIT owner default — store `owner`
;; only for a non-personal owner, so absence == personal.
;; created_at is an explicit full-ISO fact (now-iso), asserted at capture —
;; the id is opaque now (UUIDv7), so ordering/display read THIS, not the id.
(defn- capture-facts
  [te String
   title String
   owner String
   source String
   author String
   lead String
   proposed String
   created-at String
   today String] (Vec t/Triple)
  (let [c (Vec store.types/Triple) (add-fact [] te "title" title)
        c (Vec store.types/Triple) (add-fact c te "kind" "thread")
        c (Vec store.types/Triple) (if (= owner "personal") c (add-fact c te "owner" owner))
        c (Vec store.types/Triple) (add-fact c te "source" source)
        c (Vec store.types/Triple) (add-fact c te "created_by" (ref-or-blank author))
        c (Vec store.types/Triple) (add-fact c te "lead" (ref-or-blank lead))
        c (Vec store.types/Triple) (add-fact c te "proposed_by" (ref-or-blank proposed))
        c (Vec store.types/Triple) (add-fact c te "created_at" created-at)
        c (Vec store.types/Triple) (add-fact c te "updated_at" today)
        c (Vec store.types/Triple) (add-fact c te "committed" today)]
    c))

(defrecord CaptureReceipt
  [id String
   thread String
   title String
   path String
   expected Int
   committed Int
   complete Bool
   reason String])

(defn- structured-capture? [] Bool
  ;; Internal machine boundary for adapters that must bind the exact minted
  ;; thread without scraping human prose. Environment control keeps the mode
  ;; impossible to trigger accidentally through a title or owner argument.
  (= "1" (getenv-or "NORTH_CAPTURE_STRUCTURED" "")))

(defn- print-capture-receipt
  [id String
   te String
   title String
   path String
   expected Int
   committed Int
   complete Bool
   reason String] Nil
  (println
   (to-json
    (->CaptureReceipt id te title path expected committed complete reason))))

(defn- retract-committed-capture-facts
  [port Int
   log String
   facts (Vec t/Triple)
   results (Vec String)
   i Int] Bool
  (if (>= i (count facts))
    true
    ;; Always attempt every acknowledged write. A failed early retraction
    ;; must not prevent later facts from being compensated.
    (let [fact store.types/Triple (nth facts i)
          result String (nth results i)
          current-ok Bool (if (str/starts-with? result "ok:")
            (str/starts-with?
             (tell-retry port log "retract" (triple-subject fact) (triple-predicate fact) (triple-value fact) 5)
             "ok:")
            true)
          remaining-ok Bool (retract-committed-capture-facts
           port log facts results (+ i 1))]
      (and current-ok remaining-ok))))

;; Structured capture owns this freshly minted UUID, so it can compensate
;; exactly the facts acknowledged by this attempt. Prove both graph and view
;; absence before describing the rollback as clean.
(defn- cleanup-partial-capture
  [port Int
   log String
   te String
   path String
   facts (Vec t/Triple)
   results (Vec String)] Bool
  (let [retracted Bool (retract-committed-capture-facts port log facts results 0)
        _ Nil (store.rt/delete-file path)
        remaining (Vec store.types/Triple) (filterv (fn [fact t/Triple] Bool (= te (triple-subject fact)))
                 (coord-live-propositions port))]
    (and retracted
         (empty? remaining)
         (not (store.rt/file-exists path)))))

(defn cmd-capture
  [threads-dir String
   log String
   title String
   owner String] Nil
  (let [source String (getenv-or "NORTH_SOURCE" "self")
        author String (getenv-or "NORTH_AUTHOR" "you")
        lead String (getenv-or "NORTH_LEAD" "")
        proposed String (getenv-or "NORTH_PROPOSED_BY" "")]
    (cond
    [(or (str/blank? title) (ctrl? title))
     (println "usage: capture <title> [owner]   (title must be a non-empty single line)")]
    [(ctrl? owner)
     (println "capture: owner must be a single line")]
    [(or (ctrl? source) (ctrl? author) (ctrl? lead) (ctrl? proposed))
     (println "capture: NORTH_SOURCE/AUTHOR/LEAD/PROPOSED_BY must each be a single line")]
    [:else
     (do
       (store.rt/ensure-dir threads-dir)
       ;; Publish each capture fact through the same Store RPC path as `tell`, then
       ;; render the .md from Store log state. The file remains a regenerated view.
       ;; UUIDv7 is collision-proof, so capture no longer reserves a file-lock id
       ;; (the old now-id/reserve-id dance guarded same-second timestamp clashes).
       (let [id String (uuidv7)
             slug String (store.rt/slugify title)
             today String (store.rt/today-iso)
             created-at String (store.rt/now-iso)
             te String (str "@" id)
             path String (str threads-dir "/" id "-" slug ".md")
             port Int (coord-port)
             server-v Int (coord-version port)]
         (if (< server-v 0)
           (if (structured-capture?)
             (print-capture-receipt
              id te title path 0 0 false "store-rpc-unavailable")
             (println (store-rpc-failure-message
                       server-v port log "capture was not recorded")))
           (let [facts (Vec store.types/Triple) (capture-facts te title owner source author lead proposed created-at today)
                 results (Vec String) (mapv (fn [c t/Triple] String
                                 (tell-retry port log "assert" (triple-subject c) (triple-predicate c) (triple-value c) 5))
                               facts)
                 oks Int (count (filterv (fn [r String] Bool (str/starts-with? r "ok:")) results))]
             (if (= oks (count facts))
               (do
                 ;; Freshly minted id: an empty warm read-back means the read failed,
                 ;; never that the subject is absent.
                 ;; thread-md resolves predicate metadata out of the vector it is handed,
                 ;; so a value_kind declared on a capture predicate renders as its
                 ;; fallback kind here until the next whole-database re-render.
                 (store.rt/spit-file
                  path
                  (exp/thread-md
                   (let [warm (Vec store.types/Triple) (live-subject-facts log te)]
                     (if (empty? warm) facts warm))
                   te))
                 (if (structured-capture?)
                   (print-capture-receipt
                    id te title path (count facts) oks true "captured")
                   (println (str "captured -> " te "  " title "  [owner: " owner "]\n"
                                 "  file:      " path "\n"
                                 "  committed: " oks " facts via Store RPC. Next: north tell " id " <pred> <value>"))))
               (if (structured-capture?)
                 (let [cleaned Bool (cleanup-partial-capture
                        port log te path facts results)]
                   (print-capture-receipt
                    id te title path (count facts) oks false
                    (if cleaned "partial-cleaned"
                        "partial-cleanup-failed")))
                 (println (str "capture PARTIAL: only " oks "/" (count facts)
                               " fact(s) committed (Store RPC publication failure). Re-run — nothing is stranded in files."))))))))])))

;; Resolve a thread ref (@id OR @handle) to its canonical @id and print it. The
;; bin/north wrapper calls this before routing tell/untell to Beagle Store, so a
;; handle ref (`north tell @perf ...`) lands on the right thread — Store itself
;; is handle-blind and only ever sees the canonical id.
;; FAIL-CLOSED: a ref that LOOKS like an id (hex/date chars + dashes only) but
;; resolved to nothing prints "ERROR ..." — the wrapper aborts the write instead
;; of letting Store mint a phantom subject under the truncated id. Human handles
;; (any other chars) still pass through untouched.
(defn- id-like? [bare String] Bool
  ;; hex+dash only AND (dashed OR >=8 chars): catches uuidv7/date ids and their
  ;; truncations (dashed like 019f20b1-7a98, dashless like 019f20b1) while a real
  ;; human handle (letters beyond a-f, or short) still passes through.
  (and (not (str/blank? bare))
       (str/blank? (str/replace bare #"[0-9a-f-]" ""))
       (or (str/includes? bare "-") (>= (count bare) 8))))

(defn cmd-resolve
  [log String
   ref String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        r String (resolve-ref idx ref)]
    (if (and (= r ref)
             (id-like? (short-id ref))
             (nil? (proj/string-value-at idx (str "@" (short-id ref)) "title")))
      (println (str "ERROR unresolved id-like ref " ref
                    " — not a thread id, unique prefix, or handle"
                    " (ambiguous/truncated? `north show " (short-id ref) "` lists candidates)"))
      (println r))))

;; Done-bars echo (friction gradient): bin/north calls this at outcome-write
;; time so closing a barred thread SEES its bars — a reminder at the moment of
;; judgment, never a reject (the gate teaches; it does not block a human
;; closing their own thread). Silent when the thread has no bars, so the tell
;; path can invoke it unconditionally. ✓/○ per bar = evidence containment
;; (a bar_evidence fact quoting the bar text).
(defn cmd-done-bars
  [log String
   ref String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        te String (resolve-ref idx (if (str/starts-with? ref "@") ref (str "@" ref)))
        bars (Vec String) (proj/string-values-at idx te "done_when")
        evs (Vec String) (proj/string-values-at idx te "bar_evidence")]
    (if (empty? bars)
      nil
      (do
        (println (str "DONE BARS on " te " — this outcome claims they are met; cite probe + observed result:"))
        (doseq [b bars] (println (str "  " (stale/bar-mark evs b) " " b)))
        (println (str "  evidence: north tell " (short-id te) " bar_evidence \"<bar> → <observed result>\""))))))

;; Entity-drift audit: repo path-form collisions (tags retired with relates_to).
(defn cmd-audit [log String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        rd (Vec north.audit/DriftGroup) (audit/repo-drift idx)]
    (println (str "REPO DRIFT — " (count rd) " group(s):"))
    (doseq [g rd]
      (println (str "  " (:norm g) ": " (str/join ", " (:forms g)))))))

;; Integrity check = engine-generic structural rules (cycles, dangling refs) ++
;; north's WORK rules (abandoned deps, person/role refs) — north.validate.
;; The Beagle Store CLI `validate` only runs the generic half; this is the full check, so
;; bin/north routes `validate` here (and the MCP validate tool through it).
(defn cmd-validate [log String] Int
  (let [idx north.projections/ProjectionIndex (live-idx log)
        ids (Vec String) (proj/thread-subjects idx)
        problems (Vec String) (reduce
                  (fn
                    [acc (Vec String)
                     te String] (Vec String)
                    (reduce (fn
                              [a (Vec String)
                               v String] (Vec String)
                              (conj a (str (short-id te) ": " v)))
                            acc (val/violations-i idx te)))
                  []
                  ids)]
    (if (empty? problems)
      (do
        (println (str "OK — " (count ids) " threads, no violations."))
        0)
      (do (doseq [p problems] (println (str "  " p)))
          (println (str (count problems) " violation(s)."))
          1))))

;; --- driver LIVENESS: is a driver plausibly active NOW? ----------------------
;; A `driver` fact is never retired, so treating assignment as liveness calls
;; every historical pickup "active" — the board's ACTIVE section drowned in
;; drivers dead since May. The canonical live? DERIVES liveness (never stores it)
;; by combining two honest signals, in strict preference order:
;;   (a) AGENT presence lease — the strong positive. A session driver renews an
;;       @lease:session:<handle> lease (30-min TTL, bumped on every tool call);
;;       live iff its exp is still in the Store RPC server's future. SAME renewable-lease
;;       rule concern-cli/coord.clj `online?` uses for STALE concerns — reused, not
;;       forked, so "online" can't drift between the two. Leases ride the warm
;;       :facts view (in-memory ephemeral transactions the server exposes), so
;;       they are already in the index — no extra Store RPC round-trip here.
;;   (b) RECENCY fallback — a human driver (e.g. Tom Passarelli) holds no session
;;       lease, so lease-absence is not death. Fall back to `updated_at`, the most
;;       honest liveness signal carried in the warm triple view: the day the thread
;;       was last mutated. (The driver-fact TX time would be crisper but lives in
;;       fold provenance the board's warm read deliberately doesn't carry.) Fresh
;;       iff updated within NORTH_DRIVER_STALE_DAYS (default 14) — a human works a
;;       thread across days/weeks, so the window is loose vs the lease's minutes.
;;       This fallback also rescues an agent whose lease lapsed but whose thread
;;       still saw activity inside the window.
;; This is the ONE production liveness notion the canonical classifier consumes:
;; ready/board/next/JSON/grooming all classify against `live-driver-pred`, so a
;; parked driver reads the same (not-active -> its committed/schedule state)
;; everywhere. `--all` changes scope only; it never changes lifecycle semantics.
(defn- lease-exp-secs [idx proj/ProjectionIndex driverref String] Int
  ;; exp of @lease:session:<handle> in EPOCH SECONDS, or -1 if no lease. Lease value
  ;; is "holder|exp-ms|epoch"; slice exp-ms to seconds (drop the last 3 chars) —
  ;; parse-int is 32-bit, so 13-digit ms overflows while 10-digit secs (good to
  ;; ~2038) don't.
  (let [handle String (short-id driverref)
        v (U String Nil) (proj/string-value-at idx (str "@lease:session:" handle) "lease")]
    (if (nil? v)
      -1
      (let [parts (Vec String) (str/split v #"\|")]
        (if (< (count parts) 2)
          -1
          (let [expms String (nth parts 1)]
            (if (> (count expms) 3)
              (store.rt/parse-int (subs expms 0 (- (count expms) 3)))
              -1)))))))

(defn- dt->secs [s String] Int
  ;; ISO date OR datetime -> epoch seconds; -1 on any unparseable shape. Never
  ;; throws: iso-to-seconds parses validated shapes only, so every call is gated on
  ;; the shape check first (a bare date is padded to midnight).
  (cond
    [(store.rt/is-iso-datetime-19 s) (store.rt/iso-to-seconds s)]
    [(store.rt/is-iso-datetime-16 s) (store.rt/iso-to-seconds s)]
    [(and (= 10 (count s)) (store.rt/is-iso-datetime-19 (str s "T00:00:00")))
     (store.rt/iso-to-seconds (str s "T00:00:00"))]
    [:else -1]))

(defn- driver-live?
  [idx proj/ProjectionIndex
   te String
   now-secs Int
   window-secs Int]
  Bool
  (let [d (U String Nil) (proj/string-value-at idx te "driver")]
    (if (nil? d)
      false
      (let [e Int (lease-exp-secs idx d)]
        (if (and (> e 0) (> e now-secs))
          true
          (let [u (U String Nil) (proj/string-value-at idx te "updated_at")]
            (if (nil? u)
              false
              (let [us Int (dt->secs u)]
                (and (> us 0) (< (- now-secs us) window-secs))))))))))

(defn- driver-stale-window-secs [] Int
  ;; NORTH_DRIVER_STALE_DAYS (default 14) -> seconds. Mirrors the env-config pattern
  ;; projections uses for the terminal/withdrawn vocab.
  (let [d Int (store.rt/parse-int (getenv-or "NORTH_DRIVER_STALE_DAYS" "14"))]
    (* (if (> d 0) d 14) 86400)))

;; The canonical live? predicate the classifier consumes, curried over a fixed
;; now/window so every thread in one command is judged against the same instant.
(defn- live-driver-pred
  [now-secs Int
   window-secs Int] (Fn [proj/ProjectionIndex String] Bool)
  (fn
    [idx proj/ProjectionIndex
     te String] Bool
    (driver-live? idx te now-secs window-secs)))

;; Build the canonical live? for "right now" — one clock read, reused for the whole
;; command. Callers that already hold now-secs/window use live-driver-pred directly.
(defn- default-live? [] (Fn [proj/ProjectionIndex String] Bool)
  (live-driver-pred (store.rt/iso-to-seconds (store.rt/now-iso)) (driver-stale-window-secs)))

;; Assignment and activity are orthogonal. A parked assignment remains visible
;; for cleanup even though it no longer forces the lifecycle to `active`.
(defn- parked-assignment?
  [idx proj/ProjectionIndex
   te String
   live? (Fn [proj/ProjectionIndex String] Bool)]
  Bool
  (and (proj/assigned? idx te) (not (live? idx te))))

(defn- parked-assignments
  [idx proj/ProjectionIndex
   tes (Vec String)
   live? (Fn [proj/ProjectionIndex String] Bool)]
  (Vec String)
  (filterv (fn [te String] Bool (parked-assignment? idx te live?)) tes))

;; default scopes to WORK THREADS (kind=thread) — concerns/mine/telemetry
;; also satisfy the ready predicate but are not actionable work items;
;; --all keeps the old unscoped full list unchanged.
;; Manual queue moves replay over leverage, so the default stays
;; high-signal until an operator explicitly orders it.
(defn cmd-ready
  [log String
   all Bool] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)
        raw (Vec String) (proj/ready idx today store.rt/str-lt? live?)
        rs (Vec String) (if all raw
             (filterv (fn [te String] Bool (= (kind-of idx te) "thread")) raw))
        ranked (Vec String) (queue-order idx rs)
        shown (Vec String) (if all ranked (vec (take 15 ranked)))
        rs-count Int (count rs)
        shown-count Int (count shown)]
    (if all
      (println (str "READY NOW — " (count rs)))
      (println (str "READY NOW — top " (count shown) " of " (count rs)
                    " by queue order (leverage fallback)")))
    (println "  ready = committed + unblocked + no live driver + not future-scheduled (vs open = merely nonterminal)")
    (doseq [te shown]
      (println (str "  " (short-id te) "  " (trunc (title-of idx te) 56))))
    (when (and (not all) (> rs-count shown-count))
      (println (str "  … +" (- rs-count shown-count) " more · north ready --all")))))

(defn cmd-blocked [log String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)
        bs (Vec String) (filterv (fn [te String] Bool (= (proj/condition-i idx te today before? live?) "blocked"))
                    (proj/work-thread-ids-i idx))]
    (println (str "BLOCKED — " (count bs)))
    (doseq [te bs]
      (println (str "  " (short-id te) "  " (trunc (title-of idx te) 48)
                    "  (waiting on " (count (proj/incomplete-deps idx te)) ")")))))

(defn cmd-leverage [log String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        cands (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te)))
                       (proj/work-thread-ids-i idx))
        items (Vec LevItem) (filterv (fn [it LevItem] Bool (> (:score it) 0))
                       (mapv (fn [te String] LevItem
                               (->LevItem te (proj/leverage-score idx te)))
                             cands))
        ranked (Vec LevItem) (vec (take 15 (sort-by (fn [it LevItem] Int (- 0 (:score it))) items)))]
    (println "TOP UNBLOCKERS — finishing this transitively frees the most stuck threads")
    (doseq [it ranked]
      (println (str "  unblocks " (:score it) "  " (short-id (:te it))
                    "  " (trunc (title-of idx (:te it)) 46))))))

(defn- next-item
  [idx proj/ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)]
  NextItem
  ;; ready EXCLUDES live-driven (active) threads, so a driver fact here is a
  ;; PARKED pickup — momentum = resume-ability, not "someone's on it".
  (let [lev Int (proj/leverage-score idx te)
        doo (U String Nil) (proj/string-value-at idx te "do_on")
        urg Int (if (some? doo)
              (cond
                [(store.rt/str-lt? doo today) 5]
                [(= doo today) 3]
                [:else 0])
              0)
        mom Int (if (some? (proj/string-value-at idx te "driver")) 2 0)
        pri String (let [p (U String Nil) (proj/string-value-at idx te "priority")] (if (some? p) p ""))
        sequencing Int (count (proj/incomplete-deps idx te))
        eligibility north.projections/Eligibility (proj/explain idx te today before? live?)]
    (->NextItem te (+ (* 3 lev) (+ urg mom)) lev urg mom pri sequencing (:reason eligibility))))

(defn cmd-next [log String] Nil
  ;; candidate set = the ONE eligibility rule (proj/ready = classify "ready"):
  ;; committed, unblocked, no live driver, not scheduled-later. Identical to
  ;; the set `ready` and the board's READY bucket render — they cannot diverge.
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)
        items (Vec NextItem) (mapv (fn [te String] NextItem (next-item idx te today before? live?))
                    (proj/ready idx today before? live?))
        score-order (Vec String) (mapv (fn [it NextItem] String (:te it))
                          (vec (sort-by (fn [it NextItem] Int (- 0 (:score it))) items)))
        ranked (Vec NextItem) (mapv (fn [te String] NextItem (next-item idx te today before? live?))
                     (vec (take 12 (queue-order-from-base idx score-order))))]
    (println (str "WHAT TO WORK ON — top picks (" today ")"))
    (println "  eligible = ready (committed + unblocked + no live driver + not scheduled-later)")
    (println "  manual queue order is primary · fallback score = 3·graph-leverage + do_on urgency + parked-assignment momentum")
    (println "  stored priority is orthogonal human intent (shown, never silently scored)")
    (doseq [it ranked]
      (println (str "  [" (:score it) "] " (short-id (:te it)) "  "
                    (trunc (title-of idx (:te it)) 46)))
      (println (str "      eligible: " (:basis it)))
      (println (str "      score: 3×" (:leverage it) " leverage + " (:urgency it)
                    " urgency + " (:momentum it) " momentum = " (:score it)
                    " · sequencing: " (:sequencing it) " incomplete deps"
                    " · priority: " (if (str/blank? (:priority it)) "none" (:priority it))
                    " (not scored)")))))

(defn cmd-agenda [log String] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        cands (Vec String) (filterv (fn [te String] Bool
                         (and (not (proj/terminal-i? idx te)) (some? (proj/string-value-at idx te "do_on"))))
                       (proj/work-thread-ids-i idx))
        items (Vec AgendaItem) (mapv (fn [te String] AgendaItem
                      (->AgendaItem te (let [d (U String Nil) (proj/string-value-at idx te "do_on")] (if (some? d) d ""))))
                    cands)
        overdue (Vec AgendaItem) (vec (sort-by (fn [it AgendaItem] String (:do_on it))
                              (filterv (fn [it AgendaItem] Bool (store.rt/str-lt? (:do_on it) today)) items)))
        todayb (Vec AgendaItem) (filterv (fn [it AgendaItem] Bool (= (:do_on it) today)) items)
        upcoming (Vec AgendaItem) (vec (sort-by (fn [it AgendaItem] String (:do_on it))
                               (filterv (fn [it AgendaItem] Bool (store.rt/str-lt? today (:do_on it))) items)))]
    (println (str "AGENDA — " today))
    (println (str "OVERDUE (" (count overdue) ")"))
    (doseq [it overdue] (println (str "  " (:do_on it) "  " (short-id (:te it)) "  " (trunc (title-of idx (:te it)) 44))))
    (println (str "TODAY (" (count todayb) ")"))
    (doseq [it todayb] (println (str "  " (:do_on it) "  " (short-id (:te it)) "  " (trunc (title-of idx (:te it)) 44))))
    (println (str "UPCOMING (" (count upcoming) ")"))
    (doseq [it upcoming] (println (str "  " (:do_on it) "  " (short-id (:te it)) "  " (trunc (title-of idx (:te it)) 44))))))

(defn- board-group
  [idx proj/ProjectionIndex
   label String
   grp (Vec String)]
  Nil
  (when (not (empty? grp))
    (println (str "\n" (proj/condition-emoji idx label) " " label " (" (count grp) ")"))
    (doseq [te grp]
      (println (str "  " (short-id te) "  " (trunc (title-of idx te) 52))))))

(defn- in-condition
  [idx proj/ProjectionIndex
   nonterm (Vec String)
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   c String]
  (Vec String)
  (filterv (fn [te String] Bool (= (proj/condition-i idx te today before? live?) c)) nonterm))

(defn- parked-group
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   grp (Vec String)]
  Nil
  (when (not (empty? grp))
    (println (str "\nPARKED ASSIGNMENTS (" (count grp) ") — stale driver retained; lifecycle is not active"))
    (doseq [te grp]
      (println (str "  " (driver-label idx te) "  " (short-id te) "  "
                    (proj/condition-i idx te today before? live?) "  "
                    (trunc (title-of idx te) 42))))))

;; thread overview
;; DEFAULT = SIGNAL: active drivers (who's on what) + top-15 ready by queue order +
;; a counts line. The full per-condition kanban dump moved behind `--all` (chaos
;; was the census diagnosis: the flat dump drowned the ~15 threads that matter).
(defn- board-full
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   nonterm (Vec String)]
  Nil
  (do
    (println (str "THREADS — " (count nonterm) " open"))
    (board-group idx "active" (in-condition idx nonterm today before? live? "active"))
    (board-group idx "ready" (queue-order idx (in-condition idx nonterm today before? live? "ready")))
    (board-group idx "blocked" (in-condition idx nonterm today before? live? "blocked"))
    (board-group idx "dormant" (in-condition idx nonterm today before? live? "dormant"))
    (board-group idx "draft" (in-condition idx nonterm today before? live? "draft"))
    (parked-group idx today before? live? (parked-assignments idx nonterm live?))))

;; SCOPE TO WORK THREADS: concerns/telemetry/mine also carry `title` (so
;; thread-ids-i sees them), which is exactly what drowned the old board — 200+
;; concern rows rendering as "active". kind-of excludes them; the full --all
;; dump keeps the unscoped set unchanged. Facts do the filtering: a concern
;; self-identifies kind=concern, a thread kind=thread (or is un-kinded legacy).
(defn- board-curated
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   nonterm (Vec String)]
  Nil
  ;; cheap concern count: subjects that classify as a concern (kind fact or
  ;; concern- prefix). NOT stale-decayed — concern liveness/decay is the
  ;; concern-lane's projection; the board reports the raw open count.
  (let [threads (Vec String) (filterv (fn [te String] Bool (= (kind-of idx te) "thread")) nonterm)
        active (Vec String) (in-condition idx threads today before? live? "active")
        parked (Vec String) (parked-assignments idx threads live?)
        nparked Int (count parked)
        readyl (Vec String) (in-condition idx threads today before? live? "ready")
        blockedl (Vec String) (in-condition idx threads today before? live? "blocked")
        nconcern Int (count (filterv (fn [s String] Bool (= (kind-of idx s) "concern"))
                                 (proj/all-subjects idx)))
        ashow (Vec String) (vec (take 20 active))
        active-count Int (count active)
        ashow-count Int (count ashow)
        rranked (Vec LevItem) (mapv (fn [te String] LevItem (->LevItem te (proj/leverage-score idx te)))
                      (vec (take 15 (queue-order idx readyl))))
        readyl-count Int (count readyl)
        rranked-count Int (count rranked)]
    (println (str "THREADS — " (count threads) " open threads · " (count active) " active · "
                  (count readyl) " ready · " (count blockedl) " blocked · "
                  nconcern " concerns   (north threads --all for the full kanban)"))
    ;; self-teaching legend: the counts above are derived conditions, not obvious labels —
    ;; spell out what each word means so "open" vs "ready" needs no outside explanation.
    (println "  open = not terminal · active = live driver · ready = committed + unblocked + no live driver + not future-scheduled")
    (when (not (empty? active))
      (println (str "\n" (proj/condition-emoji idx "active") " ACTIVE — who's on what (" (count active) ")"))
      (doseq [te ashow]
        (println (str "  " (let [dl String (driver-label idx te)] (if (str/blank? dl) "?" dl))
                      "  " (short-id te) "  " (trunc (title-of idx te) 44))))
      (when (> active-count ashow-count)
        (println (str "  … +" (- active-count ashow-count) " more · north threads --all"))))
    (when (> nparked 0)
      (let [pshow (Vec String) (vec (take 10 parked))
            pshow-count Int (count pshow)]
        (println (str "\nPARKED ASSIGNMENTS — stale driver retained, lifecycle demoted (" nparked ")"))
        (doseq [te pshow]
          (println (str "  " (driver-label idx te) "  " (short-id te) "  "
                        (proj/condition-i idx te today before? live?) "  "
                        (trunc (title-of idx te) 36))))
        (when (> nparked pshow-count)
          (println (str "  … +" (- nparked pshow-count) " more · north needs-review")))))
    (println (str "\n" (proj/condition-emoji idx "ready") " READY — top " (count rranked)
                  " of " (count readyl) " by queue order (leverage fallback)"))
    (doseq [it rranked]
      (println (str "  unblocks " (:score it) "  " (short-id (:te it)) "  " (trunc (title-of idx (:te it)) 44))))
    (when (> readyl-count rranked-count)
      (println (str "  … +" (- readyl-count rranked-count) " more · north threads --all")))
    (println "  machinery/agents/daemons → north dashboard")))

(defn cmd-board
  [log String
   all Bool] Nil
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)
        nonterm (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te)))
                         (proj/work-thread-ids-i idx))]
    (if all
      (board-full idx today before? live? nonterm)
      (board-curated idx today before? live? nonterm))))

;; A compact Store-only operator read. Account and session rows are deliberately
;; shaped by their public facts: providers may add those facts without teaching
;; this terminal projection about provider-private process state.
(defn- cockpit-thread-line
  [idx proj/ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)] String
  (let [condition String (proj/condition-i idx te today before? live?)
        owner (U String Nil) (proj/string-value-at idx te "owner")
        estimate (U String Nil) (proj/string-value-at idx te "estimate_hours")
        deps (Vec String) (proj/incomplete-deps idx te)]
    (str "  " (short-id te) "  " condition
         " · " (trunc (title-of idx te) 38)
         " · owner " (if (some? owner) owner "personal")
         " · blocks " (count deps)
         (if (some? estimate) (str " · est " estimate "h") ""))))

(defn cmd-cockpit [log String] Nil
  (let [idx proj/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [proj/ProjectionIndex String] Bool) (default-live?)
        threads (Vec String) (filterv (fn [te String] Bool (= (kind-of idx te) "thread"))
                                        (proj/work-thread-ids-i idx))
        open (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te))) threads)
        sessions (Vec String) (filterv (fn [te String] Bool (= (kind-of idx te) "session"))
                                         (proj/all-subjects idx))
        accounts (Vec String) (filterv (fn [te String] Bool (= (kind-of idx te) "account"))
                                         (proj/all-subjects idx))
        landings (Vec String) (vec (take 8 (reverse (sort-by
          (fn [te String] String (let [at (U String Nil) (proj/string-value-at idx te "updated_at")]
                                    (if (some? at) at "")))
          (filterv (fn [te String] Bool
                     (and (some? (proj/string-value-at idx te "candidate_rev"))
                          (some (fn [reached String] Bool (= reached "landed"))
                                (proj/string-values-at idx te "reached"))))
                   (proj/all-subjects idx))))))]
    (println (str "NORTH LIVE — " (count open) " open threads · Store facts at read time"))
    (println "THREADS")
    (doseq [te (take 12 (sort-by (fn [te String] String (title-of idx te)) open))]
      (println (cockpit-thread-line idx te today before? live?)))
    (println "SESSIONS")
    (if (empty? sessions)
      (println "  no live-session fact projection")
      (doseq [te (take 12 sessions)]
        (let [thread (U String Nil) (proj/string-value-at idx te "current_thread")
              parent (U String Nil) (proj/string-value-at idx te "parent_thread")]
          (println (str "  " (short-id te) " · thread " (if (some? thread) (short-id thread) "—")
                        " · parent " (if (some? parent) (short-id parent) "—"))))))
    (println "ACCOUNTS")
    (if (empty? accounts)
      (println "  no account headroom fact projection")
      (doseq [te (take 12 accounts)]
        (let [headroom (U String Nil) (proj/string-value-at idx te "headroom")
              usage (U String Nil) (proj/string-value-at idx te "used_percent")]
          (println (str "  " (short-id te) " · headroom " (if (some? headroom) headroom "—")
                        " · used " (if (some? usage) usage "—"))))))
    (println "LATEST PUBLIC LANDINGS")
    (if (empty? landings)
      (println "  no landed candidate revision facts")
      (doseq [te landings]
        (let [rev (U String Nil) (proj/string-value-at idx te "candidate_rev")]
          (println (str "  " (if (some? rev) (trunc rev 12) "—") " · " (trunc (title-of idx te) 54))))))
    (println "CONTROL")
    (println "  north tell <thread> driver <agent> · north interrupt <agent> <message>")
    (println "  north msg <agent> <message> · north account availability --json")))

;; --- structured (JSON) projections for the MCP edge --------------------------
(defrecord JThread
  [id String
   title String
   condition String
   emoji String])
(defrecord JPresentation
  [active String
   ready String
   blocked String
   draft String])
(defrecord JReview
  [id String
   title String
   pred String
   detail String])
(defrecord JFact
  [predicate String
   value String])
(defrecord JSubjectFact
  [subject String
   predicate String
   value String])
(defrecord JChildSettlementProjection
  [protocol String
   version Int
   coordinator String
   children (Vec JSubjectFact)
   runs (Vec JSubjectFact)])
(defrecord JAgentFact
  [id String
   predicate String
   value String])

(defn- jthread
  [idx proj/ProjectionIndex
   te String
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)]
  JThread
  (let [c String (proj/condition-i idx te today before? live?)]
    (->JThread (short-id te) (title-of idx te) c (proj/condition-emoji idx c))))

;; CURATED JSON = the SAME slice the human board/ready render, so the AI-facing
;; MCP edge gets parity with the CLI instead of the raw 700+-item dump (149KB).
;; The curation the CLI applies (kind=thread scope + queue order + top-slice)
;; lived ONLY in cmd-board/cmd-ready; the JSON path bypassed it. These helpers
;; move it into the JSON path too, gated on all? — --all restores the full,
;; unscoped dump that discover.ts/analysis consumers still want.
(defn- ready-curated-tes
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   all? Bool]
  (Vec String)
  (let [raw (Vec String) (proj/ready idx today before? live?)
        rs (Vec String) (if all? raw (filterv (fn [te String] Bool (= (kind-of idx te) "thread")) raw))
        ranked (Vec String) (queue-order idx rs)]
    (if all? ranked (vec (take 15 ranked)))))

(defn- board-curated-tes
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)
   all? Bool]
  (Vec String)
  (let [nonterm (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te)))
                         (proj/work-thread-ids-i idx))]
    (if all?
      nonterm
      ;; kind=thread scope (drop concern-* / unkinded ephemera), then the curated
      ;; kanban content: live-driven ACTIVE ++ top-15 READY by queue order. Blocked
      ;; is a count-only bucket on the human board, so it stays out of the slice.
      (let [threads (Vec String) (filterv (fn [te String] Bool (= (kind-of idx te) "thread")) nonterm)
            active (Vec String) (in-condition idx threads today before? live? "active")
            ready (Vec String) (vec (take 15 (queue-order idx
                                             (in-condition idx threads today before? live? "ready"))))]
        (vec (concat active ready))))))

(defn- recent-terminal-tes [idx proj/ProjectionIndex] (Vec String)
  (let [terminal (Vec String) (filterv
         (fn [te String] Bool
           (and (= (kind-of idx te) "thread") (proj/terminal-i? idx te)))
         (proj/work-thread-ids-i idx))]
    (vec
     (take 15
           (reverse
            (sort-by
             (fn [te String] String
               (let [updated (U String Nil) (proj/string-value-at idx te "updated_at")
                     created (U String Nil) (proj/string-value-at idx te "created_at")]
                 (str (if (some? updated) updated "") "|"
                      (if (some? created) created "") "|" te)))
             terminal))))))

(defn- matching-subjects
  [facts (Vec t/Triple)
   predicate String
   value String]
  (Map String Bool)
  (reduce
   (fn
     [subjects (Map String Bool)
      fact t/Triple] (Map String Bool)
     (if (and (= (triple-predicate fact) predicate) (= (triple-value fact) value))
       (assoc subjects (triple-subject fact) true)
       subjects))
   {} facts))

(defn- direct-child-subjects
  [facts (Vec t/Triple)
   coordinator String]
  (Map String Bool)
  (reduce
   (fn
     [subjects (Map String Bool)
      fact t/Triple] (Map String Bool)
     (if (and (= (triple-predicate fact) "coordinator")
              (= (triple-value fact) coordinator)
              (str/starts-with? (triple-subject fact) "@agent:"))
       (assoc subjects (triple-subject fact) true)
       subjects))
   {} facts))

(defn- child-agent-ids [subjects (Map String Bool)] (Map String Bool)
  (reduce-kv
   (fn
     [ids (Map String Bool)
      subject String
      _present Bool] (Map String Bool)
     (assoc ids (subs subject (count "@agent:")) true))
   {} subjects))

(defn- child-run-subjects
  [facts (Vec t/Triple)
   children (Map String Bool)
   committed-runs (Map String Bool)]
  (Map String Bool)
  (reduce
   (fn
     [subjects (Map String Bool)
      fact t/Triple] (Map String Bool)
     (if (and (= (triple-predicate fact) "agent")
              (get children (triple-value fact) false)
              (get committed-runs (triple-subject fact) false))
       (assoc subjects (triple-subject fact) true)
       subjects))
   {} facts))

(defn- subject-fact-projection
  [facts (Vec t/Triple)
   subjects (Map String Bool)]
  (Vec JSubjectFact)
  (mapv
   (fn [fact t/Triple] JSubjectFact
     (->JSubjectFact (short-id (triple-subject fact)) (triple-predicate fact) (triple-value fact)))
   (filterv
    (fn [fact t/Triple] Bool (get subjects (triple-subject fact) false))
    facts)))

;; Grooming consumes the same liveness decision as ready/board/next. The
;; staleness module owns judgment provenance and remains clock/lease agnostic;
;; this composition layer removes its raw-driver done-bar false positives and
;; adds explicit parked-assignment reviews without mutating lifecycle facts.
(defn- parked-assignment-reviews
  [idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)]
  (Vec stale/Review)
  (reduce
   (fn
     [acc (Vec stale/Review)
      te String] (Vec stale/Review)
     (if (and (= (kind-of idx te) "thread")
              (and (not (proj/terminal-i? idx te))
                   (parked-assignment? idx te live?)))
       (let [d (U String Nil) (proj/string-value-at idx te "driver")
             eligibility north.projections/Eligibility (proj/explain idx te today before? live?)]
         (conj acc
               (stale/->Review
                te "driver"
                (str "parked assignment " (if (some? d) d "?")
                     " has no live lease or recent activity; lifecycle=" (:state eligibility)
                     " — reassign or retract driver"))))
       acc))
   []
   (proj/work-thread-ids-i idx)))

(defn- canonical-grooming-reviews
  [idx proj/ProjectionIndex
   live-idx proj/ProjectionIndex
   today String
   before? (Fn [String String] Bool)
   live? (Fn [proj/ProjectionIndex String] Bool)]
  (Vec stale/Review)
  (let [base (Vec stale/Review) (vec (concat (stale/time-stale idx today before?)
                          (vec (concat (stale/edge-stale idx)
                                       (vec (concat (stale/bars-missing idx)
                                                    (stale/bars-unevidenced idx)))))))
        live-base (Vec north.staleness/Review) (filterv
                   (fn [rv stale/Review] Bool
                     (if (= (:pred rv) "done_when")
                       (live? live-idx (:te rv))
                       true))
                   base)]
    (vec (concat live-base (parked-assignment-reviews live-idx today before? live?)))))

;; Split out of cmd-json's database-wide let so a single-subject show never binds
;; live-facts: the whole point is that this verb touches ONE subject.
(defn- cmd-json-show
  [log String
   arg String] Nil
  (println (to-json
            (mapv (fn [c t/Triple] JFact (->JFact (triple-predicate c) (triple-value c)))
                  (subject-facts log (str "@" arg))))))

(defn- cmd-json-database
  [log String
   what String
   arg String
   all? Bool] Nil
  (let [facts (Vec store.types/Triple) (live-facts log)
        idx north.projections/ProjectionIndex (proj/index-triples facts)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)]
    (cond
      [(= what "board")
       (println (to-json
                 (mapv (fn [te String] JThread (jthread idx te today before? live?))
                       (board-curated-tes idx today before? live? all?))))]
      [(= what "ready")
       (println (to-json (mapv (fn [te String] JThread (jthread idx te today before? live?))
                                       (ready-curated-tes idx today before? live? all?))))]
      [(= what "blocked")
       (println (to-json (mapv (fn [te String] JThread (jthread idx te today before? live?))
                                       (filterv (fn [te String] Bool (= (proj/condition-i idx te today before? live?) "blocked"))
                                                (proj/work-thread-ids-i idx)))))]
      [(= what "done")
       (println (to-json
                 (mapv (fn [te String] JThread (jthread idx te today before? live?))
                       (recent-terminal-tes idx))))]
      [(= what "needs-review")
       (let [reviews (Vec north.staleness/Review) (canonical-grooming-reviews idx idx today before? live?)]
         (println (to-json
                   (mapv (fn [rv stale/Review] JReview
                           (->JReview (short-id (:te rv)) (title-of idx (:te rv)) (:pred rv) (:detail rv)))
                         reviews))))]
      [(= what "show-many")
       (let [subjects (Vec String) (filterv (fn [s String] Bool (not (str/blank? s)))
                               (mapv (fn [s String] String (short-id s))
                                     (vec (str/split arg #","))))
             subject-set (Map String Bool) (reduce (fn
                                                     [m (Map String Bool)
                                                      s String] (Map String Bool)
                                                     (assoc m (str "@" s) true))
                                 {} subjects)]
         (println (to-json
                   (mapv (fn [c t/Triple] JSubjectFact
                           (->JSubjectFact (short-id (triple-subject c)) (triple-predicate c) (triple-value c)))
                         (filterv (fn [c t/Triple] Bool (get subject-set (triple-subject c) false))
                                  facts)))))]
      [(= what "child-settlement")
       ;; One warm fact-vector projection is a coherent read. The SDK used to
       ;; compose child/run state from four separate CLI reads; process startup
       ;; consumed the deadline and concurrent child growth made the result only
       ;; consistency-checked, never atomic. Keep this read mechanical and return
       ;; every fact needed for the SDK's strict independent validation.
       (let [children (Map String Bool) (direct-child-subjects facts arg)
             child-ids (Map String Bool) (child-agent-ids children)
             committed-runs (Map String Bool) (matching-subjects facts "kind" "run")
             runs (Map String Bool) (child-run-subjects facts child-ids committed-runs)]
         (println
          (to-json
           (->JChildSettlementProjection
            "north.child-settlement"
            1
            arg
            (subject-fact-projection facts children)
            (subject-fact-projection facts runs)))))]
      [(= what "children")
       ;; One warm live-facts reverse lookup replaces the SDK's former cold
       ;; Datalog read. Map keys make children unique; sort makes the JSON
       ;; contract deterministic, and a leaf emits [].
       (println (to-json
                 (vec (sort (mapv short-id
                                  (set (keys (matching-subjects facts "part_of" (str "@" arg)))))))))]
      [(= what "agents")
       (println (to-json
                 (mapv (fn [c t/Triple] JAgentFact
                         (->JAgentFact (subs (triple-subject c) (count "@agent:")) (triple-predicate c) (triple-value c)))
                       ;; The Store RPC server's unified warm view can contain
                       ;; lease-only/tombstone-shaped rows with no subject. They
                       ;; are not agent facts. One such row must not crash the
                       ;; whole bulk identity projection and erase every valid
                       ;; agent card from `north agents`.
                       (filterv (fn [c t/Triple] Bool
                                  (let [l String (triple-subject c)]
                                    (and (some? l) (str/starts-with? l "@agent:"))))
                                facts))))]
      [(= what "presentation")
       (println (to-json
                 (->JPresentation (proj/condition-emoji idx "active") (proj/condition-emoji idx "ready")
                                  (proj/condition-emoji idx "blocked") (proj/condition-emoji idx "draft"))))]
      [:else (println "usage: json board|ready|blocked|done|needs-review|show <id>|show-many <id,id,...>|children <parent>|child-settlement <coordinator>|agents|presentation")])))

(defn cmd-json
  [log String
   what String
   arg String
   all? Bool] Nil
  (if (= what "show")
    (cmd-json-show log arg)
    (cmd-json-database log what arg all?)))

(defn cmd-needs-review [log String] Nil
  (let [live-idx-now north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)
        reviews (Vec north.staleness/Review) (canonical-grooming-reviews live-idx-now live-idx-now today before? live?)
        promo (Vec String) (stale/promotable live-idx-now)]
    (println (str "NEEDS REVIEW — " (count reviews) " judgment(s) whose inputs moved (" today ")"))
    (doseq [rv reviews]
      (println (str "  [" (:pred rv) "] " (short-id (:te rv)) "  " (trunc (title-of live-idx-now (:te rv)) 44)))
      (println (str "      " (:detail rv))))
    (println (str "\nPROMOTABLE — " (count promo) " uncommitted draft(s) that grew real structure"))
    (doseq [te promo]
      (println (str "  " (short-id te) "  " (trunc (title-of live-idx-now te) 52))))))

;; --- boot: the one-screen session-start view --------------------------------
(defrecord EntryPoint
  [te String
   note String
   created String])

;; The SESSION ENTRY POINT note on a thread ("" if none).
(defn- entry-note
  [idx proj/ProjectionIndex
   te String]
  String
  (reduce (fn
            [acc String
             v String] String
            (if (and (str/blank? acc) (str/starts-with? v "SESSION ENTRY POINT")) v acc))
          "" (proj/string-values-at idx te "note")))

;; The most-recent (by created_at) thread carrying a SESSION ENTRY POINT note.
(defn- find-entry [idx proj/ProjectionIndex] EntryPoint
  (reduce (fn
            [best EntryPoint
             te String] EntryPoint
            (let [note String (entry-note idx te)]
              (if (str/blank? note)
                best
                (let [c String (let [cc (U String Nil) (proj/string-value-at idx te "created_at")] (if (some? cc) cc ""))]
                  (if (or (str/blank? (:te best)) (store.rt/str-lt? (:created best) c))
                    (->EntryPoint te note c)
                    best)))))
          (->EntryPoint "" "" "")
          (proj/thread-subjects idx)))

(defn cmd-boot [log String] Nil
  ;; 1. ENTRY POINT — the standing note + learnings, FULL (no truncation).
  (let [idx north.projections/ProjectionIndex (live-idx log)
        today String (store.rt/today-iso)
        before? (Fn [String String] Bool) store.rt/str-lt?
        live? (Fn [north.projections/ProjectionIndex String] Bool) (default-live?)]
    (let [e EntryPoint (find-entry idx)]
      (if (str/blank? (:te e))
        (println "\nENTRY POINT — none (no thread carries a `SESSION ENTRY POINT` note)")
        (do
          (println (str "\nENTRY POINT — " (short-id (:te e)) "  " (title-of idx (:te e))))
          (println (:note e))
          (let [ls (Vec String) (proj/string-values-at idx (:te e) "learning")]
            (when (not (empty? ls))
              (println "\nSTANDING MANDATES (learning):")
              (doseq [l ls] (println (str "  - " l))))))))
    ;; 2. board counts by derived condition.
    (let [nonterm (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te)))
                           (proj/work-thread-ids-i idx))]
      (println (str "\nBOARD — active " (count (in-condition idx nonterm today before? live? "active"))
                    "  ready " (count (in-condition idx nonterm today before? live? "ready"))
                    "  blocked " (count (in-condition idx nonterm today before? live? "blocked"))
                    "  draft " (count (in-condition idx nonterm today before? live? "draft"))))
      ;; 3. top 5 by leverage (finishing these frees the most stuck threads).
      (let [cands (Vec String) (filterv (fn [te String] Bool (not (proj/terminal-i? idx te))) nonterm)
            items (Vec LevItem) (filterv (fn [it LevItem] Bool (> (:score it) 0))
                           (mapv (fn [te String] LevItem
                                   (->LevItem te (proj/leverage-score idx te)))
                                 cands))
            ranked (Vec LevItem) (vec (take 5 (sort-by (fn [it LevItem] Int (- 0 (:score it))) items)))]
        (println "TOP LEVERAGE — finishing these transitively frees the most stuck threads")
        (doseq [it ranked]
          (println (str "  unblocks " (:score it) "  " (short-id (:te it)) "  " (title-of idx (:te it)))))))))

;; --- tools: NORTH's curated tool surface (NOT the generated per-predicate one) -
;; Store engine dispatch would print the generated per-predicate catalog; north
;; owns its AI surface, so `north tools` lists the curated MCP verbs (bin/north-mcp
;; is authoritative) and notes the engine core + that vocabulary is DATA.
(defn cmd-tools [] Nil
  (do
    (println "NORTH — curated tool surface (the MCP verbs; bin/north-mcp is authoritative):")
    (println "  work queue : ready · next · threads · blocked · agenda · leverage · needs-review")
    (println "  vocabulary : schema (census by kind) · predicate (metadata + connected examples) · teaching-coverage")
    (println "  read/write : show · capture · tell · retract · validate")
    (println "  agents     : dispatch · spawn")
    (println "  view       : presentation")
    (println "")
    (println "Engine core underneath: Beagle Store = 10 tools (tell/retract/show/ask/validate + 5 graph-edit verbs).")
    (println "Vocabulary is DATA, not tools: `north show <pred>` reveals metadata and connected teaching facts")
    (println "(cardinality/value_kind/acyclic/predicate_example facts). Govern it with `north predicate`.")))

;; --- schema: the vocabulary census (generated from graph authority) ----------
;; "What schemas exist in north?" answered as a standing tool: subjects + live-fact
;; counts grouped by entity kind (kind-of), top predicates per kind, and the
;; declared predicate metadata (cardinality/value_kind/acyclic — schema-as-facts).
;; ONE fold (live-facts) then pure map-reduce; sorted by fact count so the biggest
;; blobs — the session/run telemetry bulk — name themselves loudly with numbers.
(defrecord PredCount
  [pred String
   n Int])
(defrecord KindStat
  [kind String
   subjects Int
   facts Int
   preds (Vec PredCount)])

;; composite-key sep for the (kind, pred) tally — neither kind nor pred contains it.
(def ^:private KP-SEP String "")

(defn- census
  [idx proj/ProjectionIndex
   facts (Vec t/Triple)]
  (Vec KindStat)
  ;; subject -> kind (computed ONCE per subject, then reused per fact)
  ;; kind -> subject count
  ;; kind -> fact count
  ;; (kind KP-SEP pred) -> fact count  (flat map; nested Map-of-Map avoided)
  (let [subj-list (Vec String) (proj/all-subjects idx)
        skind (Map String String) (reduce (fn
                                            [m (Map String String)
                                             s String] (Map String String)
                                            (assoc m s (kind-of idx s)))
                      {} subj-list)
        ksub (Map String Int) (reduce (fn
                                        [m (Map String Int)
                                         s String] (Map String Int)
                                        (let [kd String (get skind s "other")]
                         (assoc m kd (+ 1 (int (get m kd 0))))))
                     {} subj-list)
        kfacts (Map String Int) (reduce (fn
                                          [m (Map String Int)
                                           c t/Triple] (Map String Int)
                                          (let [kd String (get skind (triple-subject c) "other")]
                           (assoc m kd (+ 1 (int (get m kd 0))))))
                       {} facts)
        kpreds (Map String Int) (reduce (fn
                                          [m (Map String Int)
                                           c t/Triple] (Map String Int)
                                          (let [kd String (get skind (triple-subject c) "other")
                                                kk String (str kd KP-SEP (triple-predicate c))]
                                            (assoc m kk (+ 1 (int (get m kk 0))))))
                       {} facts)
        kp-keys (Vec String) (vec (sort (set (keys kpreds))))
        stats (Vec KindStat) (mapv (fn [kd String] KindStat
                      (let [pfx String (str kd KP-SEP)
                            off Int (+ (count kd) 1)
                            plist (Vec PredCount) (mapv (fn [kk String] PredCount
                                          (->PredCount (subs kk off) (int (get kpreds kk 0))))
                                        (filterv (fn [kk String] Bool (str/starts-with? kk pfx)) kp-keys))
                            ptop (Vec PredCount) (vec (take 8 (sort-by (fn [pc PredCount] Int (- 0 (:n pc))) plist)))]
                        (->KindStat kd (int (get ksub kd 0)) (int (get kfacts kd 0)) ptop)))
                    (vec (sort (set (keys ksub)))))]
    (vec (sort-by (fn [ks KindStat] Int (- 0 (:facts ks))) stats))))

;; --- per-kind field spec (`north schema <kind>`) ----------------------------
;; A schema here is a shape DERIVED from the live propositions, not a declared record:
;; for one kind, split its predicates into REQUIRED (carried by ≥98% of that
;; kind's subjects — effectively "always present") vs OPTIONAL (show coverage %),
;; and annotate declared cardinality/value_kind where the predicate carries it.
;; Coverage is DISTINCT SUBJECTS per predicate (multi-valued preds counted once
;; per subject), not fact count — "how many of this kind have it", not "how often".

(def ^:private SP24 String "                        ")
(defn- padr
  [s String
   n Int] String
  (if (>= (count s) n) s (str s (subs SP24 0 (- n (count s))))))
(defn- pad7 [n Int] String
  (let [s String (str n)] (if (>= (count s) 7) s (str (subs "0000000" 0 (- 7 (count s))) s))))

(defn- kind-subjects
  [idx proj/ProjectionIndex
   kind String]
  (Vec String)
  (filterv (fn [s String] Bool (= (kind-of idx s) kind)) (proj/all-subjects idx)))

;; distinct-subject coverage per predicate over a subject set (one pass over facts).
(defrecord CovAcc
  [seen (Map String Bool)
   pc (Map String Int)])
(defn- coverage
  [facts (Vec t/Triple)
   subjset (Map String Bool)]
  (Map String Int)
  (:pc (reduce (fn
                 [a CovAcc
                  c t/Triple] CovAcc
                 (if (get subjset (triple-subject c) false)
                   (let [sk String (str (triple-subject c) KP-SEP (triple-predicate c))]
                     (if (get (:seen a) sk false)
                       a
                       (->CovAcc (assoc (:seen a) sk true)
                                 (assoc (:pc a) (triple-predicate c) (+ 1 (int (get (:pc a) (triple-predicate c) 0)))))))
                   a))
               (->CovAcc {} {}) facts)))

(defrecord FieldStat
  [pred String
   subs Int
   pct Int
   required Bool])
(defn- schema-fields
  [idx proj/ProjectionIndex
   facts (Vec t/Triple)
   kind String]
  (Vec FieldStat)
  ;; required := ≥98% coverage (integer-exact, no rounding boundary).
  ;; required first, then by coverage desc, then predicate name — a stable spec order.
  (let [ksubs (Vec String) (kind-subjects idx kind)
        total Int (count ksubs)
        subjset (Map String Bool) (reduce (fn
                                            [m (Map String Bool)
                                             s String] (Map String Bool)
                                            (assoc m s true)) {} ksubs)
        pc (Map String Int) (coverage facts subjset)
        stats (Vec FieldStat) (mapv (fn [p String] FieldStat
                      (let [n Int (int (get pc p 0))
                            pct Int (if (> total 0) (quot (* 100 n) total) 0)
                            req Bool (if (> total 0) (>= (* n 100) (* total 98)) false)]
                        (->FieldStat p n pct req)))
                    (vec (sort (set (keys pc)))))]
    (vec (sort-by (fn [fs FieldStat] String
                    (str (if (:required fs) "0" "1") "|"
                         (pad7 (- 9999999 (:subs fs))) "|" (:pred fs)))
                  stats))))

;; declared cardinality/value_kind for a predicate, if present (`predicate
;; define` writes @<pred> subjects; tolerate a bare legacy subject too).
(defn- pred-ann
  [idx proj/ProjectionIndex
   p String]
  String
  (let [ps String (if (or (some? (proj/string-value-at idx (str "@" p) "cardinality"))
                   (some? (proj/string-value-at idx (str "@" p) "value_kind")))
             (str "@" p) p)
        card (U String Nil) (proj/string-value-at idx ps "cardinality")
        vk (U String Nil) (proj/string-value-at idx ps "value_kind")]
    (str (if (some? card) (str "  cardinality=" card) "")
         (if (some? vk) (str " value_kind=" vk) ""))))

;; WRITERS map: a schema here is a set of FACTS, so its "file location" is the code
;; that WRITES that kind. Curated + each entry grep-verified against source.
(defn- kind-writer [kind String] String
  (cond
    [(= kind "thread") "north capture -> src/north/main.bclj capture-facts (title, kind=thread, created_at, committed, …)"]
    [(= kind "concern") "concern declare -> cli/concern-cli.clj (put! kind=concern, intent, touches, reached)"]
    [(= kind "agent") "agent identity -> sdk/src/identity.ts writeIdentity + bin/north-on-spawn (tell agent:<id> kind/role/display_name)"]
    [(= kind "run") "managed task telemetry -> sdk/src/telemetry.ts recordRun (kind=run)"]
    [(= kind "message") "mail + commands -> cli/msg-cli.clj (@msg: mail, @cmd: commands)"]
    [(= kind "north/mine") "personal notes -> cli/north-mine.clj (@mine:<stem> facts)"]
    [(= kind "predicate") "executable schema -> north predicate define"]
    [(= kind "topic") "topic grouping anchors (topic- prefix)"]
    [:else "(writer not curated — query canonical Store log state for this kind's writer)"]))

(defn- print-schema-kind
  [idx proj/ProjectionIndex
   facts (Vec t/Triple)
   kind String]
  Nil
  (let [ksubs (Vec String) (kind-subjects idx kind)
        total Int (count ksubs)]
    (if (= total 0)
      (println (str "SCHEMA · " kind " — no subjects of this kind. `north schema` lists the kinds in use."))
      (let [fields (Vec FieldStat) (schema-fields idx facts kind)
            req (Vec FieldStat) (filterv (fn [fs FieldStat] Bool (:required fs)) fields)
            opt (Vec FieldStat) (filterv (fn [fs FieldStat] Bool (not (:required fs))) fields)]
        (println (str "SCHEMA · " kind " — " total " subjects · " (count fields) " distinct predicates"))
        (println (str "  REQUIRED — carried by ≥98% of " kind " subjects (≈ every one):"))
        (doseq [fs req]
          (println (str "    " (padr (:pred fs) 20) " " (:pct fs) "%" (pred-ann idx (:pred fs)))))
        (when (empty? req) (println "    (none)"))
        (println "  OPTIONAL — coverage % of subjects that carry it:")
        (doseq [fs opt]
          (println (str "    " (padr (:pred fs) 20) " " (:pct fs) "%" (pred-ann idx (:pred fs)))))
        (when (empty? opt) (println "    (none)"))
        (println (str "  written by: " (kind-writer kind)))))))

;; `north schema`        -> the kind census (one screen: kinds + counts + hint)
;; `north schema <kind>` -> the per-kind field spec (required/optional + writers)
(defn cmd-schema
  [log String
   kind String] Nil
  (let [facts (Vec store.types/Triple) (live-facts log)
        idx north.projections/ProjectionIndex (proj/index-triples facts)]
    (if (not (str/blank? kind))
      (print-schema-kind idx facts kind)
      (let [stats (Vec KindStat) (census idx facts)
            pred-subs (Vec String) (filterv (fn [s String] Bool
                                 (or (some? (proj/string-value-at idx s "cardinality"))
                                     (or (some? (proj/string-value-at idx s "value_kind"))
                                         (some? (proj/string-value-at idx s "acyclic")))))
                               (proj/all-subjects idx))]
        (println (str "SCHEMA — " (count (proj/all-subjects idx)) " subjects / " (count facts)
                      " live facts across " (count stats) " kinds"))
        (doseq [ks stats]
          (println (str "  " (padr (:kind ks) 20) " " (:subjects ks) " subjects · " (:facts ks) " facts")))
        (println (str "  " (padr "predicate-meta" 20) " " (count pred-subs)
                      " predicate(s) carry declared cardinality/value_kind/acyclic"))
        (println "→ north schema <kind> for the field spec — required vs optional preds, coverage %, who writes it")))))

;; Teaching is graph data: predicate entities point at normalized example
;; entities. This projection intentionally counts only that live connection.
(defn cmd-teaching-coverage [log String] Nil
  (let [facts (Vec store.types/Triple) (live-facts log)
        idx north.projections/ProjectionIndex (proj/index-triples facts)
        predicates (Vec String) (filterv (fn [s String] Bool
                              (= (proj/string-value-at idx s "entity_kind") "predicate"))
                            (proj/all-subjects idx))
        taught (Vec String) (filterv (fn [s String] Bool
                           (not (empty? (proj/string-values-at idx s "predicate_example"))))
                         predicates)
        missing (Vec String) (sort (map (fn [s String] String
                             (if (str/starts-with? s "@") (subs s 1) s))
                           (remove (set taught) predicates)))]
    (println (str "TEACHING COVERAGE — " (count taught) " / " (count predicates)
                  " predicate entities have connected examples"))
    (if (empty? missing)
      (println "  ✓ every executable predicate has a connected example")
      (do
        (println (str "  missing examples — " (str/join ", " missing)))
        (println "  add predicate_example graph facts; bootstrap tables are not authority")))))

;; --- dispatch (life verbs; engine verbs are routed to Beagle Store by the wrapper) ---
(defn- has-flag?
  [args (Vec String)
   f String] Bool
  (not (empty? (filterv (fn [a String] Bool (= a f)) args))))

(defn run
  [args (Vec String)
   threads-dir String
   log String] Nil
  (let [cmd String (if (empty? args) "" (first args))]
    (cond
      [(= cmd "capture")
       (if (and (>= (count args) 2)
                (or (= (nth args 1) "--help") (= (nth args 1) "-h")))
         (println "usage: capture <title> [owner]")
         (if (>= (count args) 2)
           (cmd-capture threads-dir log (nth args 1) (if (>= (count args) 3) (nth args 2) "personal"))
           (println "usage: capture <title> [owner]")))]
      [(= cmd "ready")    (cmd-ready log (has-flag? args "--all"))]
      [(= cmd "blocked")  (cmd-blocked log)]
      [(= cmd "leverage") (cmd-leverage log)]
      [(= cmd "next")     (cmd-next log)]
      [(= cmd "agenda")   (cmd-agenda log)]
      [(= cmd "threads")  (cmd-board log (has-flag? args "--all"))]
      [(= cmd "cockpit")  (cmd-cockpit log)]
      [(= cmd "schema")   (cmd-schema log (if (>= (count args) 2) (nth args 1) ""))]
      [(= cmd "teaching-coverage") (cmd-teaching-coverage log)]
      [(= cmd "needs-review") (cmd-needs-review log)]
      [(= cmd "audit")    (cmd-audit log)]
      [(= cmd "resolve")
       (if (>= (count args) 2)
         (cmd-resolve log (nth args 1))
         (println "usage: resolve <@handle|@id>"))]
      [(= cmd "done-bars")
       (if (>= (count args) 2)
         (cmd-done-bars log (nth args 1))
         (println "usage: done-bars <@id|@handle>"))]
      ;; Back-compatible direct `run` callers remain non-terminating. Callers
      ;; that need status use `run-status` below.
      [(= cmd "validate") (do (cmd-validate log) nil)]
      [(= cmd "tools")    (cmd-tools)]
      [(= cmd "boot")     (cmd-boot log)]
      [(= cmd "json")
       (cmd-json log (if (> (count args) 1) (nth args 1) "")
                 (if (> (count args) 2) (nth args 2) "")
                 (has-flag? args "--all"))]
      [:else (println "north usage: capture <title> [owner] | ready [--all] | blocked | leverage | next | agenda | threads [--all] | schema | teaching-coverage | needs-review | audit | resolve <@handle|@id> | validate | tools | boot | listen <agent-id> | json <...>   (threads/ready default to a curated top slice; --all for the full dump. engine verbs import/export/show/tell/retract/merge route to Beagle Store)")])))

;; Composable command boundary: returns the exact validation status without
;; terminating its host process; other commands succeed after their normal
;; `run` side effects.
(defn run-status
  [args (Vec String)
   threads-dir String
   log String] Int
  (cond
    [(and (not (empty? args)) (= (first args) "validate")) (cmd-validate log)]
    [:else (do (run args threads-dir log) 0)]))

(defn -main [& args] Nil
  (let [argv (Vec String) (vec args)
        threads-dir String (threads-dir)
        log String (log-path)
        status Int (run-status argv threads-dir log)]
    (when (not (= status 0)) (System/exit status))))
