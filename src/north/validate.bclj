#lang beagle/clj
(ns north.validate
  "North's integrity check over its executable predicate schema. Reference
  existence, acyclicity, thread shape, and lifecycle are application rules, so
  they live over North's Triple projection instead of the target-neutral Beagle Store
  kernel.

  Actor refs (lead/driver/proposed_by) are NOT integrity-checked; see the note
  in work-violations-i for why.")

(require [store.kernel-classify :as kc])
(require [north.projections :as proj])

(def thread-ref-preds (Vec String) ["part_of" "depends_on" "relates_to"])

(defn- reachable?
  [idx proj/ProjectionIndex
   predicate String
   target String
   frontier (Vec String)]
  Bool
  (loop [remaining (Vec String) frontier
         seen (Map String Bool) {}]
    (cond
      [(empty? remaining) false]
      [(= target (first remaining)) true]
      [(contains? seen (first remaining))
       (recur (vec (rest remaining)) seen)]
      [:else
       (recur
        (vec (concat (rest remaining)
                     (proj/string-values-at idx (first remaining) predicate)))
        (assoc seen (first remaining) true))])))

(defn- cycle?
  [idx proj/ProjectionIndex
   predicate String
   subject String]
  Bool
  (reachable? idx predicate subject
              (proj/string-values-at idx subject predicate)))

(defn structural-violations-i
  [idx proj/ProjectionIndex
   subject String]
  (Vec String)
  (let [reference-violations (Vec String) (reduce
         (fn
           [violations (Vec String)
            predicate String] (Vec String)
           (reduce
            (fn
              [found (Vec String)
               target String] (Vec String)
              (if (proj/subject? idx target)
                found
                (conj found
                      (str predicate " references missing entity " target))))
            violations
            (proj/string-values-at idx subject predicate)))
         []
         (proj/projectionindex-reference-predicates idx))]
    (reduce
     (fn
       [violations (Vec String)
        predicate String] (Vec String)
       (if (cycle? idx predicate subject)
         (conj violations (str predicate " cycle"))
         violations))
     reference-violations
     (proj/projectionindex-acyclic-predicates idx))))

(defn work-violations-i
  [idx proj/ProjectionIndex
   te String]
  (Vec String)
  ;; These three predicates are North thread relationships, not arbitrary
  ;; entity refs. Beagle Store verifies generic subject existence; North adds the
  ;; stronger title-bearing target rule. A missing target remains a thread
  ;; violation even when executable schema also classifies the predicate as
  ;; a generic ref; partial schema metadata cannot disable North integrity.
  (let [term? Bool (proj/terminal-i? idx te)
        v-thread (Vec String) (reduce
                  (fn
                    [acc (Vec String)
                     p String] (Vec String)
                    (reduce
                     (fn
                       [a (Vec String)
                        rt String] (Vec String)
                       (cond
                         [(and (proj/subject? idx rt)
                               (nil? (proj/string-value-at idx rt "title")))
                          (conj a (str p " references non-thread entity " rt))]
                         [(not (proj/subject? idx rt))
                          (conj a (str p " references missing thread " rt))]
                         [:else a]))
                     acc
                     (proj/string-values-at idx te p)))
                  []
                  thread-ref-preds)]
    (do
      ;; A depends_on edge to a withdrawn (abandoned) target is only suspect for
      ;; a still-open thread; a resolved thread's stale dependencies do not matter.
      (let [v-ab (Vec String) (reduce
                  (fn
                    [acc (Vec String)
                     d String] (Vec String)
                    (if (and (not term?) (proj/withdrawn-i? idx d))
                      (conj acc (str "depends_on points at abandoned " d))
                      acc))
                  v-thread
                  (proj/string-values-at idx te "depends_on"))]
        ;; Actor absence is ambiguous under retention, so lifecycle policy—not
        ;; structural validation—owns lead/driver/proposed_by durability. Thread
        ;; refs remain checked because thread identities are durable.
        v-ab))))

;; Full North validation over one thread = executable-schema structure + work.
(defn violations-i
  [idx proj/ProjectionIndex
   te String]
  (Vec String)
  (vec (concat (structural-violations-i idx te)
               (work-violations-i idx te))))
