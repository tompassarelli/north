#lang beagle/clj
(ns north.validate
  "North's integrity check: the engine's GENERIC structural rules (cycles,
  dangling refs — fram.kernel/violations-i) PLUS the WORK-semantics rules the
  engine no longer owns. The work rules were lifted out of the fram kernel to
  here: part_of/depends_on/relates_to targets must be threads, and a depends_on
  edge to a withdrawn (abandoned) thread is suspect. The kernel stays
  domain-free — it knows cycles and dangling entity refs, not thread shape or
  lifecycle.

  Actor refs (lead/driver/proposed_by) are NOT integrity-checked; see the note
  in work-violations-i for why.")

(require fram.kernel :as k)
(require north.projections :as proj)

;; WORK-semantics violations over the index (the rules lifted out of the kernel's
;; violations-i). Lifecycle-aware (terminal/withdrawn), which the generic
;; engine does not know.
(def thread-ref-preds :- (Vec String) ["part_of" "depends_on" "relates_to"])

(defn work-violations-i
  [idx :- k/Index
   te :- String] :- (Vec String)
  (let [term? (proj/terminal-i? idx te)
        ;; These three predicates are North thread relationships, not arbitrary
        ;; entity refs. Fram verifies generic subject existence; North adds the
        ;; stronger title-bearing target rule. When schema facts already make a
        ;; predicate generic-ref-valued, its missing-subject diagnostic comes
        ;; from Fram; otherwise this domain rule must still reject the missing
        ;; thread (partial schema metadata cannot disable North integrity).
        v-thread (reduce
                  (fn
                    [acc :- (Vec String)
                     p :- String] :- (Vec String)
                    (reduce
                     (fn
                       [a :- (Vec String)
                        rt :- String] :- (Vec String)
                       (cond
                         [(and (k/entity-i? idx rt)
                               (nil? (k/one-i idx rt "title")))
                          (conj a (str p " references non-thread entity " rt))]
                         [(and (not (k/entity-i? idx rt))
                               (not (k/vec-contains? (:ref-preds idx) p)))
                          (conj a (str p " references missing thread " rt))]
                         [:else a]))
                     acc
                     (k/many-i idx te p)))
                  []
                  thread-ref-preds)
        ;; a depends_on edge to a withdrawn (abandoned) target — only suspect for
        ;; a still-open thread (a resolved thread's stale deps don't matter).
        v-ab (reduce
              (fn
                [acc :- (Vec String)
                 d :- String] :- (Vec String)
                (if (and (not term?) (proj/withdrawn-i? idx d))
                  (conj acc (str "depends_on points at abandoned " d))
                  acc))
              v-thread
              (k/many-i idx te "depends_on"))
        ;; There is deliberately NO actor-ref check on lead/driver/proposed_by.
        ;; Three findings killed it, in order:
        ;;
        ;; 1. Requiring a display_name fact was never an integrity property.
        ;;    Actor ids are self-describing and collision-resistant already —
        ;;    `lane-ms2okiu4-<uuid>`, `native-<sha256>`, `cc-fram-d5523b3b` — and
        ;;    the agent entity carries a generated `display_handle` such as
        ;;    `openai-codex-...-sol-xhigh-orchestration-director-bccb6f89bee6`
        ;;    encoding provider, account, model, effort, role and hash. A second
        ;;    human alias adds nothing.
        ;; 2. The requirement induced FALSE DATA. To silence it, seed scripts
        ;;    (scripts/migrations/realize-the-model.sh and
        ;;    scripts/migrations/offline-migrate.clj) fabricated person
        ;;    entities named after products — `@claude-code`, `@codex`,
        ;;    `@claude` — putting a product name in an actor slot.
        ;; 3. Swapping in a real existence check did not help either: 1,455 refs
        ;;    still pointed at actors absent from the log (many pruned by the
        ;;    2026-07-26 clean-slate rotation). But absence here is AMBIGUOUS —
        ;;    it can mean reaped, pruned, never-registered, or written into the
        ;;    wrong namespace. Integrity validation cannot tell those apart, and
        ;;    a validator is the wrong surface to express a RETENTION POLICY on.
        ;;
        ;; Which agents should be durable — routable, accumulating competence
        ;; across runs — versus disposable is an open lifecycle design question,
        ;; and deliberately NOT decided here. Whatever that policy turns out to
        ;; be, it belongs in a lifecycle/retention surface that can say what an
        ;; absent actor MEANS, not in a structural check that can only say a
        ;; reference is broken. Encoding a retention stance here would silently
        ;; foreclose that design.
        ;;
        ;; Net: the check produced 5,837 findings, zero of which were real
        ;; defects, and kept `north validate` pinned at rc=1 so it could not
        ;; signal anything else. Thread-ref integrity above is retained —
        ;; threads are durable by definition (a thread IS its id + title), so a
        ;; dangling thread edge IS unambiguously a defect.
        ]
    v-ab))

;; Full north validate over one thread = engine-generic ++ north-work.
(defn violations-i
  [idx :- k/Index
   te :- String] :- (Vec String)
  (vec (concat (k/violations-i idx te) (work-violations-i idx te))))
