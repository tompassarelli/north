#lang beagle/clj

(ns north.worker-policy)

(def concern-idle-ms Int 1000)
(def concern-maximum-backoff-ms Int 30000)
(def attention-interval-ms Int 30000)
(def attention-maximum-backoff-ms Int 300000)
(def attention-reconcile-limit Int 64)

(defrecord WorkerDecision
  [action Keyword
   sleep-ms Int
   next-backoff-ms Int])

(defn bounded-double
  [value Int
   maximum Int]
  Int
  (let [(doubled Int) (* value 2)]
    (if (> doubled maximum) maximum doubled)))

(defn concern-reconciliation-decision
  [pending-count Int
   exit-code Int
   backoff-ms Int]
  WorkerDecision
  (cond
    (<= pending-count 0)
    (->WorkerDecision :sleep concern-idle-ms concern-idle-ms)

    (= exit-code 0)
    (->WorkerDecision :run 0 concern-idle-ms)

    (= exit-code 3)
    (->WorkerDecision :sleep concern-idle-ms concern-idle-ms)

    :else
    (->WorkerDecision
     :sleep
     backoff-ms
     (bounded-double backoff-ms concern-maximum-backoff-ms))))

(defn attention-reconciliation-decision
  [exit-code Int
   backoff-ms Int
   more-work Bool]
  WorkerDecision
  (cond
    (not (= exit-code 0))
    (->WorkerDecision
     :sleep
     backoff-ms
     (bounded-double backoff-ms attention-maximum-backoff-ms))

    more-work
    (->WorkerDecision :run 0 attention-interval-ms)

    :else
    (->WorkerDecision :sleep attention-interval-ms attention-interval-ms)))

(defn scheduled-task? [task Keyword] Bool
  (or (= task :stale-concerns)
      (or (= task :stale-lanes)
          (or (= task :worktrees)
              (or (= task :agent-logs)
                  (= task :spend-guard))))))

(defn task-cadence-ms [task Keyword] Int
  (cond
    (= task :spend-guard) 60000
    (= task :stale-lanes) 300000
    (= task :stale-concerns) 900000
    (= task :worktrees) 900000
    (= task :agent-logs) 3600000
    :else 0))

(defn task-timeout-ms [task Keyword] Int
  (cond
    (= task :spend-guard) 30000
    (= task :stale-lanes) 120000
    (= task :stale-concerns) 120000
    (= task :worktrees) 120000
    (= task :agent-logs) 120000
    :else 0))
