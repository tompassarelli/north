#lang beagle/clj

(ns north.store-runtime-manifest
  "Exact Store runtime identities and pure promotion transitions.")

(require [clojure.string :as str])

(def max-manifest-characters Int 4096)
(def manifest-format String "beagle-store-runtime/v1")
(def manifest-engine String "jvm-clojure")
(def manifest-native-backend String "experimental-non-production")
(def manifest-heap-policy String "fixed-xmx")
(def manifest-heap-max-bytes Int 2147483648)
(def manifest-protocol String "store-rpc")
(def manifest-protocol-version String "2.0")
(def manifest-readiness String "restore+listen+usable-rpc")
(def manifest-stopping String "before-drain")
(def manifest-relative-path String "libexec/store/runtime.manifest")

(def accepted-jvm-revision String
  "83cf2b176fb7529c39883e642e04c5dd043aba81")
(def accepted-jvm-tree String
  "5ce3add9336d31181f0105e550f65b0b1337508b")
(def accepted-jvm-nar-sha256 String
  "sha256-razZzp3OMKQ7OLK0qJS85xd5GE33Lgi2qnvSXaNF0sU=")
(def accepted-jvm-manifest-bytes Int 349)
(def accepted-jvm-manifest-sha256 String
  "5056f9e68581b2c5d06175c3767f9604212a99e9b606c9ae2f9d90688f8fc946")

(def north-user-state-root String
  (str "/" "home" "/tom/code/north-data"))
(def canonical-store-runtime-root String
  (str north-user-state-root "/store-runtime"))
(def store-artifacts-root String
  (str north-user-state-root "/store-artifacts"))
(def store-releases-root String
  (str north-user-state-root "/beagle-store-releases"))

(defrecord StoreRuntimeManifest
  [format String
   beagle-revision String
   source-tree String
   engine String
   native-backend String
   heap-policy String
   heap-max-bytes Int
   protocol String
   protocol-version String
   readiness String
   stopping String])

(defunion RuntimeMember
  (JVM
    [output String
     package-nar-sha256 String
     beagle-revision String
     beagle-tree String
     manifest-path String
     manifest-bytes Int
     manifest-sha256 String
     manifest StoreRuntimeManifest])
  (Native
    [release-root String
     beagle-revision String
     beagle-tree String
     artifact-root String
     closure-sha256 String
     server-artifact String
     server-sha256 String]))

(defrecord StoreRuntimeGeneration
  [current RuntimeMember
   previous RuntimeMember])

(defrecord StoreRuntimeAttestation
  [generation StoreRuntimeGeneration
   manifest StoreRuntimeManifest])

(defrecord StoreRuntimeEnvironment
  [state-root String
   generations-root String
   active-selector String
   selector-lock String])

(defn- fail
  [message String
   code Keyword
   data Any] Any
  (throw (ex-info message (assoc data :type code))))

(defn- exact-lower-oid? [value String] Bool
  (some? (re-matches #"[0-9a-f]{40}" value)))

(defn- exact-sha256? [value String] Bool
  (some? (re-matches #"[0-9a-f]{64}" value)))

(defn- exact-nar-sha256? [value String] Bool
  (some? (re-matches #"sha256-[A-Za-z0-9+/]{43}=" value)))

(defn canonical-package-root? [value String] Bool
  (some? (re-matches
          #"/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9][A-Za-z0-9+._?=-]*"
          value)))

(defn manifest-path-for [output String] String
  (str output "/" manifest-relative-path))

(defn jvm-dispatcher-path-for [output String] String
  (str output "/libexec/bin/beagle"))

(defn jvm-store-home-for [output String] String
  (str output "/libexec/store"))

(defn jvm-store-bin-for [output String] String
  (str (jvm-store-home-for output) "/bin"))

(defn jvm-store-out-for [output String] String
  (str (jvm-store-home-for output) "/out"))

(defn jvm-server-launcher-for [output String] String
  (str (jvm-store-bin-for output) "/beagle-store-server"))

(defn jvm-server-classpath-file-for [output String] String
  (str (jvm-store-home-for output) "/server.classpath"))

(defn native-client-classpath-for [release-root String] String
  (str release-root "/out"))

(defn native-client-path-for [release-root String] String
  (str release-root "/bin/beagle-store-cli.clj"))

(defn release-path-for [beagle-revision String] String
  (str store-releases-root "/" beagle-revision))

(defn native-artifact-path-for [closure-sha256 String] String
  (str store-artifacts-root "/" closure-sha256))

(defn native-server-path-for [artifact-root String] String
  (str artifact-root "/bin/beagle-store-server-native"))

(defn derive-runtime-environment! [state-root String] StoreRuntimeEnvironment
  (if (or (str/blank? state-root)
          (not (str/starts-with? state-root "/"))
          (str/ends-with? state-root "/")
          (str/includes? state-root "\n")
          (str/includes? state-root "\r")
          (str/includes? state-root "/../")
          (str/ends-with? state-root "/.."))
    (fail "Store runtime state root must be a canonical absolute path"
          :north.store-runtime-manifest/invalid-state-root
          {:actual state-root})
    (->StoreRuntimeEnvironment
     state-root
     (str state-root "/generations")
     (str state-root "/active")
     (str state-root "/.selector.lock"))))

(def canonical-runtime-environment StoreRuntimeEnvironment
  (derive-runtime-environment! canonical-store-runtime-root))

(defn- require-text!
  [field String
   actual String
   expected String] String
  (if (= actual expected)
    actual
    (fail (str "Store runtime " field " mismatch")
          :north.store-runtime-manifest/field-mismatch
          {:field field :expected expected :actual actual})))

(defn- validate-manifest-facts! [facts StoreRuntimeManifest] StoreRuntimeManifest
  (do
    (require-text! "manifest format" (:format facts) manifest-format)
    (if (exact-lower-oid? (:beagle-revision facts))
      (:beagle-revision facts)
      (fail "Store runtime manifest beagle_revision must be exactly 40 lowercase hexadecimal characters"
            :north.store-runtime-manifest/invalid-beagle-revision
            {:actual (:beagle-revision facts)}))
    (if (exact-lower-oid? (:source-tree facts))
      (:source-tree facts)
      (fail "Store runtime manifest source_tree must be exactly 40 lowercase hexadecimal characters"
            :north.store-runtime-manifest/invalid-source-tree
            {:actual (:source-tree facts)}))
    (require-text! "manifest engine" (:engine facts) manifest-engine)
    (require-text! "manifest native_backend"
                   (:native-backend facts)
                   manifest-native-backend)
    (require-text! "manifest heap_policy"
                   (:heap-policy facts)
                   manifest-heap-policy)
    (if (= (:heap-max-bytes facts) manifest-heap-max-bytes)
      (:heap-max-bytes facts)
      (fail "Store runtime manifest heap_max_bytes mismatch"
            :north.store-runtime-manifest/field-mismatch
            {:field "heap_max_bytes"
             :expected manifest-heap-max-bytes
             :actual (:heap-max-bytes facts)}))
    (require-text! "manifest protocol" (:protocol facts) manifest-protocol)
    (require-text! "manifest protocol_version"
                   (:protocol-version facts)
                   manifest-protocol-version)
    (require-text! "manifest readiness" (:readiness facts) manifest-readiness)
    (require-text! "manifest stopping" (:stopping facts) manifest-stopping)
    facts))

(defn canonical-manifest-text! [facts StoreRuntimeManifest] String
  (let [checked StoreRuntimeManifest (validate-manifest-facts! facts)]
    (str "format=" (:format checked) "\n"
         "beagle_revision=" (:beagle-revision checked) "\n"
         "source_tree=" (:source-tree checked) "\n"
         "engine=" (:engine checked) "\n"
         "native_backend=" (:native-backend checked) "\n"
         "heap_policy=" (:heap-policy checked) "\n"
         "heap_max_bytes=" (:heap-max-bytes checked) "\n"
         "protocol=" (:protocol checked) "\n"
         "protocol_version=" (:protocol-version checked) "\n"
         "readiness=" (:readiness checked) "\n"
         "stopping=" (:stopping checked) "\n")))

(def accepted-current-runtime-manifest StoreRuntimeManifest
  (->StoreRuntimeManifest
   manifest-format
   accepted-jvm-revision
   "6c54dc3b138b75d47eb4b9c7f64657b7eaff04cd"
   manifest-engine
   manifest-native-backend
   manifest-heap-policy
   manifest-heap-max-bytes
   manifest-protocol
   manifest-protocol-version
   manifest-readiness
   manifest-stopping))

(def accepted-runtime-manifest-text String
  (canonical-manifest-text! accepted-current-runtime-manifest))

(def accepted-native-runtime RuntimeMember
  (->Native
   (release-path-for "48f38823e42694578587f5624d8be5db9f962a77")
   "48f38823e42694578587f5624d8be5db9f962a77"
   "7d4dd724e1ba4c107162a24d47aea0849be119a5"
   (native-artifact-path-for
    "ec53c8a717424bec0f6d8212401632e3da0860f80abc6ad062500f68ea0ab554")
   "ec53c8a717424bec0f6d8212401632e3da0860f80abc6ad062500f68ea0ab554"
   (native-server-path-for
    (native-artifact-path-for
     "ec53c8a717424bec0f6d8212401632e3da0860f80abc6ad062500f68ea0ab554"))
   "b3de9e5692ba73303da4f2e38432e6fe0debacd4cf46ac3033d059f713225b69"))

(defn- line-value
  [line String
   field String] String
  (let [prefix String (str field "=")]
    (if (str/starts-with? line prefix)
      (subs line (count prefix))
      (fail (str "Store runtime manifest expected ordered field " field)
            :north.store-runtime-manifest/noncanonical-fields
            {:field field :line line}))))

(defn parse-runtime-manifest! [text String] StoreRuntimeManifest
  (if (> (count text) max-manifest-characters)
    (fail "Store runtime manifest exceeds the bounded input limit"
          :north.store-runtime-manifest/input-too-large
          {:maximum max-manifest-characters :actual (count text)})
    (if (str/includes? text "\r")
      (fail "Store runtime manifest must contain LF line endings and no CR characters"
            :north.store-runtime-manifest/noncanonical-line-endings
            {})
      (let [lines (Vec String) (vec (str/split text #"\n" -1))]
        (if (not (= (count lines) 12))
          (fail "Store runtime manifest must contain exactly eleven ordered LF-terminated fields"
                :north.store-runtime-manifest/noncanonical-fields
                {:line-count (count lines)})
          (if (not (= (nth lines 11) ""))
            (fail "Store runtime manifest must end with one LF"
                  :north.store-runtime-manifest/noncanonical-line-endings
                  {})
            (let [heap-text String (line-value (nth lines 6) "heap_max_bytes")
                  facts StoreRuntimeManifest (->StoreRuntimeManifest
                   (line-value (nth lines 0) "format")
                   (line-value (nth lines 1) "beagle_revision")
                   (line-value (nth lines 2) "source_tree")
                   (line-value (nth lines 3) "engine")
                   (line-value (nth lines 4) "native_backend")
                   (line-value (nth lines 5) "heap_policy")
                   (if (= heap-text "2147483648")
                     manifest-heap-max-bytes
                     (fail "Store runtime manifest heap_max_bytes is not canonical"
                           :north.store-runtime-manifest/noncanonical-integer
                           {:actual heap-text}))
                   (line-value (nth lines 7) "protocol")
                   (line-value (nth lines 8) "protocol_version")
                   (line-value (nth lines 9) "readiness")
                   (line-value (nth lines 10) "stopping"))]
              (validate-manifest-facts! facts))))))))

(defn validate-runtime-member! [member RuntimeMember] RuntimeMember
  (match member
    [(JVM output package-nar-sha256 beagle-revision beagle-tree
          manifest-path manifest-bytes manifest-sha256 manifest)
     (do
       (if (canonical-package-root? output)
         output
         (fail "Store JVM output is not a canonical immutable /nix/store root"
               :north.store-runtime-manifest/invalid-package-root
               {:actual output}))
       (if (exact-nar-sha256? package-nar-sha256)
         package-nar-sha256
         (fail "Store JVM NAR is not a canonical SHA-256 SRI"
               :north.store-runtime-manifest/invalid-package-nar
               {:actual package-nar-sha256}))
       (require-text! "JVM NAR"
                      package-nar-sha256
                      accepted-jvm-nar-sha256)
       (require-text! "JVM revision" beagle-revision accepted-jvm-revision)
       (require-text! "JVM tree" beagle-tree accepted-jvm-tree)
       (require-text! "JVM manifest path"
                      manifest-path
                      (manifest-path-for output))
       (if (= manifest-bytes accepted-jvm-manifest-bytes)
         manifest-bytes
         (fail "Store JVM manifest byte count mismatch"
               :north.store-runtime-manifest/manifest-size-mismatch
               {:expected accepted-jvm-manifest-bytes :actual manifest-bytes}))
       (if (exact-sha256? manifest-sha256)
         manifest-sha256
         (fail "Store JVM manifest SHA-256 is not canonical"
               :north.store-runtime-manifest/invalid-manifest-sha256
               {:actual manifest-sha256}))
       (require-text! "JVM manifest SHA-256"
                      manifest-sha256
                      accepted-jvm-manifest-sha256)
       (if (= (validate-manifest-facts! manifest)
              accepted-current-runtime-manifest)
         member
         (fail "Store JVM manifest facts do not equal the accepted runtime"
               :north.store-runtime-manifest/binding-mismatch
               {:expected accepted-current-runtime-manifest :actual manifest})))]
    [(Native release-root beagle-revision beagle-tree artifact-root
             closure-sha256 server-artifact server-sha256)
     (do
       (if (exact-lower-oid? beagle-revision)
         beagle-revision
         (fail "Store Native revision is not an exact lowercase Git object id"
               :north.store-runtime-manifest/invalid-native-revision
               {:actual beagle-revision}))
       (if (exact-lower-oid? beagle-tree)
         beagle-tree
         (fail "Store Native tree is not an exact lowercase Git object id"
               :north.store-runtime-manifest/invalid-native-tree
               {:actual beagle-tree}))
       (if (exact-sha256? closure-sha256)
         closure-sha256
         (fail "Store Native closure SHA-256 is not canonical"
               :north.store-runtime-manifest/invalid-native-closure
               {:actual closure-sha256}))
       (if (exact-sha256? server-sha256)
         server-sha256
         (fail "Store Native server SHA-256 is not canonical"
               :north.store-runtime-manifest/invalid-native-server
               {:actual server-sha256}))
       (require-text! "Native release root"
                      release-root
                      (release-path-for beagle-revision))
       (require-text! "Native artifact root"
                      artifact-root
                      (native-artifact-path-for closure-sha256))
       (require-text! "Native server artifact"
                      server-artifact
                      (native-server-path-for artifact-root))
       (if (= member accepted-native-runtime)
         member
         (fail "Store Native member does not equal the accepted recovery runtime"
               :north.store-runtime-manifest/native-mismatch
               {:expected accepted-native-runtime :actual member})))]))

(defn runtime-member-kind [member RuntimeMember] String
  (match member
    [(JVM _ _ _ _ _ _ _ _) "jvm"]
    [(Native _ _ _ _ _ _ _) "native"]))

(defn validate-runtime-generation! [generation StoreRuntimeGeneration] StoreRuntimeGeneration
  (let [current RuntimeMember (validate-runtime-member! (:current generation))
        previous RuntimeMember (validate-runtime-member! (:previous generation))]
    (match current
      [(JVM _ _ _ _ _ _ _ _)
       (match previous
         [(Native _ _ _ _ _ _ _) generation]
         [(JVM _ _ _ _ _ _ _ _)
          (fail "Store runtime generation must contain one JVM and one Native member"
                :north.store-runtime-manifest/invalid-generation-shape
                {})])]
      [(Native _ _ _ _ _ _ _)
       (match previous
         [(JVM _ _ _ _ _ _ _ _) generation]
         [(Native _ _ _ _ _ _ _)
          (fail "Store runtime generation must contain one JVM and one Native member"
                :north.store-runtime-manifest/invalid-generation-shape
                {})])])))

(defn accepted-jvm-runtime!
  [output String
   observed-nar-sha256 String
   observed-manifest-sha256 String
   manifest-text String] RuntimeMember
  (let [facts StoreRuntimeManifest (parse-runtime-manifest! manifest-text)
        member RuntimeMember (->JVM
         output
         observed-nar-sha256
         accepted-jvm-revision
         accepted-jvm-tree
         (manifest-path-for output)
         (count manifest-text)
         observed-manifest-sha256
         facts)]
    (if (= manifest-text accepted-runtime-manifest-text)
      (validate-runtime-member! member)
      (fail "Store JVM manifest bytes do not equal the accepted producer text"
            :north.store-runtime-manifest/manifest-bytes-mismatch
            {}))))

(defn accepted-runtime-generation-for!
  [output String
   observed-nar-sha256 String
   observed-manifest-sha256 String
   manifest-text String] StoreRuntimeGeneration
  (validate-runtime-generation!
   (->StoreRuntimeGeneration
    (accepted-jvm-runtime!
     output observed-nar-sha256 observed-manifest-sha256 manifest-text)
    accepted-native-runtime)))

(defn- jvm-member! [generation StoreRuntimeGeneration] RuntimeMember
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! generation)]
    (match (:current checked)
      [(JVM _ _ _ _ _ _ _ _) (:current checked)]
      [(Native _ _ _ _ _ _ _) (:previous checked)])))

(defn- native-member! [generation StoreRuntimeGeneration] RuntimeMember
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! generation)]
    (match (:current checked)
      [(JVM _ _ _ _ _ _ _ _) (:previous checked)]
      [(Native _ _ _ _ _ _ _) (:current checked)])))

(defn attest-runtime-manifest!
  [text String
   generation StoreRuntimeGeneration] StoreRuntimeAttestation
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! generation)
        member RuntimeMember (jvm-member! checked)
        actual StoreRuntimeManifest (parse-runtime-manifest! text)]
    (match member
      [(JVM _ _ _ _ _ manifest-bytes _ expected)
       (if (not (= (count text) manifest-bytes))
         (fail "Store runtime manifest byte count does not equal the accepted binding"
               :north.store-runtime-manifest/manifest-size-mismatch
               {:expected manifest-bytes :actual (count text)})
         (if (not (= text accepted-runtime-manifest-text))
           (fail "Store runtime manifest bytes do not equal the accepted binding"
                 :north.store-runtime-manifest/manifest-bytes-mismatch
                 {})
           (if (= actual expected)
             (->StoreRuntimeAttestation checked actual)
             (fail "Store runtime manifest facts do not equal the expected immutable binding"
                   :north.store-runtime-manifest/binding-mismatch
                   {:expected expected :actual actual}))))]
      [(Native _ _ _ _ _ _ _)
       (fail "Store runtime generation has no JVM member"
             :north.store-runtime-manifest/missing-jvm
             {})])))

(defn promote-transition!
  [selected StoreRuntimeGeneration
   candidate RuntimeMember] StoreRuntimeGeneration
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! selected)
        promoted RuntimeMember (validate-runtime-member! candidate)]
    (match promoted
      [(JVM _ _ _ _ _ _ _ _)
       (if (= promoted (:current checked))
         checked
         (validate-runtime-generation!
          (->StoreRuntimeGeneration promoted (native-member! checked))))]
      [(Native _ _ _ _ _ _ _)
       (fail "Only an accepted JVM member can be promoted"
             :north.store-runtime-manifest/invalid-promotion
             {})])))

(defn initial-promotion-transition! [candidate RuntimeMember] StoreRuntimeGeneration
  (let [promoted RuntimeMember (validate-runtime-member! candidate)]
    (match promoted
      [(JVM _ _ _ _ _ _ _ _)
       (validate-runtime-generation!
        (->StoreRuntimeGeneration promoted accepted-native-runtime))]
      [(Native _ _ _ _ _ _ _)
       (fail "Only an accepted JVM member can initialize promotion"
             :north.store-runtime-manifest/invalid-promotion
             {})])))

(defn rollback-transition! [selected StoreRuntimeGeneration] StoreRuntimeGeneration
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! selected)]
    (validate-runtime-generation!
     (->StoreRuntimeGeneration (:previous checked) (:current checked)))))

(defn restore-transition! [selected StoreRuntimeGeneration] StoreRuntimeGeneration
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! selected)]
    (match (:current checked)
      [(JVM _ _ _ _ _ _ _ _) checked]
      [(Native _ _ _ _ _ _ _)
       (validate-runtime-generation!
        (->StoreRuntimeGeneration (jvm-member! checked)
                                  (native-member! checked)))])))

(defn runtime-member-status-lines
  [prefix String
   member RuntimeMember] (Vec String)
  (match member
    [(JVM output package-nar-sha256 beagle-revision beagle-tree
          manifest-path manifest-bytes manifest-sha256 _)
     [(str prefix ".kind=jvm")
      (str prefix ".output=" output)
      (str prefix ".nar=" package-nar-sha256)
      (str prefix ".revision=" beagle-revision)
      (str prefix ".tree=" beagle-tree)
      (str prefix ".manifest_path=" manifest-path)
      (str prefix ".manifest_bytes=" manifest-bytes)
      (str prefix ".manifest_sha256=" manifest-sha256)]]
    [(Native release-root beagle-revision beagle-tree artifact-root
             closure-sha256 server-artifact server-sha256)
     [(str prefix ".kind=native")
      (str prefix ".release_root=" release-root)
      (str prefix ".revision=" beagle-revision)
      (str prefix ".tree=" beagle-tree)
      (str prefix ".artifact_root=" artifact-root)
      (str prefix ".closure_sha256=" closure-sha256)
      (str prefix ".server=" server-artifact)
      (str prefix ".server_sha256=" server-sha256)]]))

(defn generation-status-lines! [generation StoreRuntimeGeneration] (Vec String)
  (let [checked StoreRuntimeGeneration (validate-runtime-generation! generation)]
    (vec (concat
          (runtime-member-status-lines "current" (:current checked))
          (runtime-member-status-lines "previous" (:previous checked))))))
