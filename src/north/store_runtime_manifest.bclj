#lang beagle/clj

(ns north.store-runtime-manifest
  "Strict identity and capability equality for the Beagle Store JVM package.")

(require [clojure.string :as str])

(def max-manifest-characters Int 4096)
(def manifest-format String "beagle-store-runtime/v1")
(def manifest-engine String "jvm-clojure")
(def manifest-native-backend String "experimental-non-production")
(def manifest-heap-policy String "fixed-xmx")
(def manifest-heap-max-bytes Int 2147483648)
(def manifest-protocol String "store-rpc")
(def manifest-protocol-version String "2.0")
(def manifest-readiness String "restore+listen+usable-rpc")
(def manifest-stopping String "before-drain")
(def manifest-relative-path String "libexec/store/runtime.manifest")

(defrecord StoreRuntimeManifest
  [format String
   beagle-revision String
   source-tree String
   engine String
   native-backend String
   heap-policy String
   heap-max-bytes Int
   protocol String
   protocol-version String
   readiness String
   stopping String])

;; A binding is an expected immutable package and its concrete producer facts.
;; It is not evidence that a process started or served a request.
(defrecord StoreRuntimeBinding
  [package-root String
   manifest-path String
   expected StoreRuntimeManifest])

(defrecord StoreRuntimeAttestation
  [package-root String
   manifest-path String
   manifest StoreRuntimeManifest])

(defn- fail
  [message String
   code Keyword
   data Any] Any
  (throw (ex-info message (assoc data :type code))))

(defn- exact-lower-oid? [value String] Bool
  (some? (re-matches #"[0-9a-f]{40}" value)))

(defn canonical-package-root? [value String] Bool
  (some? (re-matches
          #"/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9][A-Za-z0-9+._?=-]*"
          value)))

(defn manifest-path-for [package-root String] String
  (str package-root "/" manifest-relative-path))

(defn- require-text!
  [field String
   actual String
   expected String] String
  (if (= actual expected)
    actual
    (fail (str "Store runtime manifest " field " mismatch")
          :north.store-runtime-manifest/field-mismatch
          {:field field :expected expected :actual actual})))

(defn- validate-manifest-facts! [facts StoreRuntimeManifest] StoreRuntimeManifest
  (do
    (require-text! "format" (:format facts) manifest-format)
    (if (exact-lower-oid? (:beagle-revision facts))
      (:beagle-revision facts)
      (fail "Store runtime manifest beagle_revision must be exactly 40 lowercase hexadecimal characters"
            :north.store-runtime-manifest/invalid-beagle-revision
            {:actual (:beagle-revision facts)}))
    (if (exact-lower-oid? (:source-tree facts))
      (:source-tree facts)
      (fail "Store runtime manifest source_tree must be exactly 40 lowercase hexadecimal characters"
            :north.store-runtime-manifest/invalid-source-tree
            {:actual (:source-tree facts)}))
    (require-text! "engine" (:engine facts) manifest-engine)
    (require-text! "native_backend" (:native-backend facts) manifest-native-backend)
    (require-text! "heap_policy" (:heap-policy facts) manifest-heap-policy)
    (if (= (:heap-max-bytes facts) manifest-heap-max-bytes)
      (:heap-max-bytes facts)
      (fail "Store runtime manifest heap_max_bytes mismatch"
            :north.store-runtime-manifest/field-mismatch
            {:field "heap_max_bytes"
             :expected manifest-heap-max-bytes
             :actual (:heap-max-bytes facts)}))
    (require-text! "protocol" (:protocol facts) manifest-protocol)
    (require-text! "protocol_version" (:protocol-version facts) manifest-protocol-version)
    (require-text! "readiness" (:readiness facts) manifest-readiness)
    (require-text! "stopping" (:stopping facts) manifest-stopping)
    facts))

(defn canonical-manifest-text! [facts StoreRuntimeManifest] String
  (let [checked StoreRuntimeManifest (validate-manifest-facts! facts)]
    (str "format=" (:format checked) "\n"
         "beagle_revision=" (:beagle-revision checked) "\n"
         "source_tree=" (:source-tree checked) "\n"
         "engine=" (:engine checked) "\n"
         "native_backend=" (:native-backend checked) "\n"
         "heap_policy=" (:heap-policy checked) "\n"
         "heap_max_bytes=" (:heap-max-bytes checked) "\n"
         "protocol=" (:protocol checked) "\n"
         "protocol_version=" (:protocol-version checked) "\n"
         "readiness=" (:readiness checked) "\n"
         "stopping=" (:stopping checked) "\n")))

(defn- line-value
  [line String
   field String] String
  (let [prefix String (str field "=")]
    (if (str/starts-with? line prefix)
      (subs line (count prefix))
      (fail (str "Store runtime manifest expected ordered field " field)
            :north.store-runtime-manifest/noncanonical-fields
            {:field field :line line}))))

(defn parse-runtime-manifest! [text String] StoreRuntimeManifest
  (if (> (count text) max-manifest-characters)
    (fail "Store runtime manifest exceeds the bounded input limit"
          :north.store-runtime-manifest/input-too-large
          {:maximum max-manifest-characters :actual (count text)})
    (if (str/includes? text "\r")
      (fail "Store runtime manifest must contain LF line endings and no CR characters"
            :north.store-runtime-manifest/noncanonical-line-endings
            {})
      (let [lines (Vec String) (vec (str/split text #"\n" -1))]
        (if (not (= (count lines) 12))
          (fail "Store runtime manifest must contain exactly eleven ordered LF-terminated fields"
                :north.store-runtime-manifest/noncanonical-fields
                {:line-count (count lines)})
          (if (not (= (nth lines 11) ""))
            (fail "Store runtime manifest must end with one LF"
                  :north.store-runtime-manifest/noncanonical-line-endings
                  {})
            (let [heap-text String (line-value (nth lines 6) "heap_max_bytes")
                  facts StoreRuntimeManifest (->StoreRuntimeManifest
                   (line-value (nth lines 0) "format")
                   (line-value (nth lines 1) "beagle_revision")
                   (line-value (nth lines 2) "source_tree")
                   (line-value (nth lines 3) "engine")
                   (line-value (nth lines 4) "native_backend")
                   (line-value (nth lines 5) "heap_policy")
                   (if (= heap-text "2147483648")
                     manifest-heap-max-bytes
                     (fail "Store runtime manifest heap_max_bytes is not canonical"
                           :north.store-runtime-manifest/noncanonical-integer
                           {:actual heap-text}))
                   (line-value (nth lines 7) "protocol")
                   (line-value (nth lines 8) "protocol_version")
                   (line-value (nth lines 9) "readiness")
                   (line-value (nth lines 10) "stopping"))]
              (validate-manifest-facts! facts))))))))

(defn attest-runtime-manifest!
  [text String
   binding StoreRuntimeBinding] StoreRuntimeAttestation
  (let [package-root String (:package-root binding)
        manifest-path String (:manifest-path binding)
        expected StoreRuntimeManifest (validate-manifest-facts! (:expected binding))]
    (if (not (canonical-package-root? package-root))
      (fail "Store runtime binding package root is not a canonical immutable /nix/store package root"
            :north.store-runtime-manifest/invalid-package-root
            {:actual package-root})
      (let [derived-path String (manifest-path-for package-root)]
        (if (not (= manifest-path derived-path))
          (fail "Store runtime binding manifest path does not derive from its package root"
                :north.store-runtime-manifest/manifest-path-substitution
                {:expected derived-path :actual manifest-path})
          (let [actual StoreRuntimeManifest (parse-runtime-manifest! text)]
            (if (= actual expected)
              (->StoreRuntimeAttestation package-root manifest-path actual)
              (fail "Store runtime manifest facts do not equal the expected immutable binding"
                    :north.store-runtime-manifest/binding-mismatch
                    {:expected expected :actual actual}))))))))
