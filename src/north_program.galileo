on connection-lost ?north
  then ?north.connection-state = "disconnected"
  and ?north.notice = "Connection lost. Drafts and queued messages are kept; unconfirmed messages will not be resent."
  may skip

on pause-disconnected-inputs ?north
  when ?north known pending input ?input
  and (?input.status == "accepted") == false
  then ?input.status = if ?input.status == "queued" then "paused" else if ?input.status == "waiting to steer" then "not sent" else if ?input.status == "sending" then "delivery unknown" else if ?input.status == "submitted" then "delivery unknown" else if ?input.status == "sending correction" then "delivery unknown" else ?input.status
  may skip

on disconnect-prompts ?north
  when ?north known prompt ?prompt
  and ?prompt.live
  then ?prompt.live = false
  and ?prompt.status = if ?prompt.status == "resolved" then "resolved" else if ?prompt.status == "waiting" then "disconnected" else "delivery unknown"
  may skip

on begin-reconnect ?north
  when ?north.connection-state == "disconnected"
  then ?north.connection-state = "connecting"
  and ?north.notice = "Reconnecting…"
  may skip

on finish-reconnect ?north ?success
  then ?north.connection-state = if ?success then "connected" else "failed"
  and ?north.notice = if ?success then "Reconnected. Paused messages need review; Alt+↑ edits the next unsent message." else "Could not reconnect. Drafts are kept. Use /reconnect to try again."
  may skip

on command-reconnect ?north ?command
  then ?north.connection-state = if ?north.connection-state == "failed" then "disconnected" else ?north.connection-state
  and ?north.notice = if ?north.connection-state == "connected" then "Already connected." else "Reconnecting…"
  may skip

on begin-conversation-reconciliation ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.phase = "idle"
  and ?context.turn-readiness = "turn-ready"
  and ?context.active-turn = ""
  may skip

on count-usage ?north
  when ?north.menu-kind == "usage"
  and ?count = count where ?north known usage row ?row and ?row.visible
  then ?north.menu-count = ?count
  and ?north.menu-selection = if ?north.menu-selection >= ?count then (if ?count > 0 then ?count - 1 else 0) else ?north.menu-selection
  may skip

on present-usage ?north
  when ?north known usage row ?row
  then ?row.visible = ?row.owner == "" or ?row.owner == ?north.active-conversation
  may skip

on withdraw-usage-row ?north ?owner ?key
  when ?north known usage row ?row
  and ?row.owner == ?owner
  and ?row.key == ?key
  then not ?row is a UsageRow
  may skip

on observe-context-usage ?north ?conversation ?used ?window ?total
  then ?north.usage-next-row = ?north.usage-next-row + 2
  and ?north known usage row ?context
  and ?north known usage row ?tokens
  and ?context is a new UsageRow {key: "context", owner: ?conversation, label: "Context used", value: if ?window > 0 then ?used * 100 / ?window else 0, known: (?window > 0), unit: "%", order: ?north.usage-next-row, visible: false}
  and ?tokens is a new UsageRow {key: "tokens", owner: ?conversation, label: "Conversation total", value: ?total, known: true, unit: " tokens", order: ?north.usage-next-row + 1, visible: false}
  may skip

on observe-quota-window ?north ?key ?name ?used ?duration ?reset ?now
  then ?north.usage-next-row = ?north.usage-next-row + 3
  and ?north known usage row ?quota
  and ?north known usage row ?window
  and ?north known usage row ?time
  and ?quota is a new UsageRow {?key, owner: "", label: "{?name} — remaining", value: if ?used > 100 then 0 else 100 - ?used, known: true, unit: "%", order: ?north.usage-next-row, visible: false}
  and ?window is a new UsageRow {?key, owner: "", label: "{?name} — window", value: ?duration, known: (?duration > 0), unit: " min", order: ?north.usage-next-row + 1, visible: false}
  and ?time is a new UsageRow {?key, owner: "", label: "{?name} — next reset", value: if ?reset > ?now then (?reset - ?now) / 60 else 0, known: (?reset > 0), unit: " min from update", order: ?north.usage-next-row + 2, visible: false}
  may skip

on observe-reset-credits ?north ?count ?known
  then ?north.usage-next-row = ?north.usage-next-row + 1
  and ?north known usage row ?row
  and ?row is a new UsageRow {key: "reset-credits", owner: "", label: "Available rate-limit resets", value: ?count, ?known, unit: "", order: ?north.usage-next-row, visible: false}
  may skip

on command-usage ?north ?command
  when ?north.host-effect == ""
  then ?north.menu-kind = "usage"
  and ?north.menu-title = "Context and usage"
  and ?north.host-effect = "read-usage"
  and ?north.effect-payload = ""
  and ?north requests host effect "read-usage" with payload ""
  may skip

on compaction-completed ?north
  then ?north.notice = "Conversation now has more room."
  may skip

on command-compact ?north ?command
  when ?command == "/compact"
  and (?north.active-conversation == "") == false
  and ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?context.turn-readiness == "turn-ready"
  and ?north.host-effect == ""
  then ?context.turn-readiness = "turn-active"
  and ?context.phase = "dispatching"
  and ?north.host-effect = "compact-conversation"
  and ?north.effect-payload = ?north.active-conversation
  and ?north.menu-kind = ""
  and ?north.notice = "Making room in this conversation…"
  and ?north requests host effect "compact-conversation" with payload ?north.active-conversation
  may skip

on command-compact ?north ?command
  when ?command == "/compact"
  and ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and (?context.turn-readiness == "turn-ready") == false
  then ?north.notice = "Finish or interrupt the current request before making more room."
  may skip

on clear-menu-rows ?north
  when ?north known menu row ?row
  then not ?row is a MenuRow
  may skip

on open-history-menu ?north ?kind
  then ?north.menu-kind = ?kind
  and ?north.menu-title = if ?kind == "archived-history" then "Archived Conversations" else "Resume Conversation"
  and ?north.menu-row-count = 0
  may skip

on open-settings-menu ?north ?kind ?title
  then ?north.menu-kind = ?kind
  and ?north.menu-title = ?title
  and ?north.menu-row-count = 0
  and ?north.menu-help = if ?kind == "document" then "↑/↓ scroll · Esc close · /work claim, release, need, unneed or close to edit" else if ?kind == "work" then "Type to filter · ↑/↓ choose · Enter open · Esc close · /work search TEXT includes closed issues" else "Type to search · ↑/↓ choose · Enter open · Esc close"
  and ?north.menu-empty = if ?kind == "work" then "No matching work items" else "No matching entries"
  may skip

on accept-menu ?north
  when ?north.menu-kind == "work"
  and ?north known menu row ?row
  and ?row.visible
  and ?row.position == ?north.menu-selection
  and ?north.host-effect == ""
  then ?north.host-effect = "work-show"
  and ?north.effect-payload = ?row.key
  and ?north requests host effect "work-show" with payload ?row.key
  may skip

on query-menu ?north ?query
  then ?north.menu-query = ?query
  and ?north.menu-selection = 0
  may skip

on filter-menu ?north
  when ?north known menu row ?row
  then ?row.position = count where ?north known menu row ?prior and ?prior.order < ?row.order and contains(lowercase("{?prior.label} {?prior.description} {?prior.key}"), lowercase(?north.menu-query))
  and ?row.visible = contains(lowercase("{?row.label} {?row.description} {?row.key}"), lowercase(?north.menu-query))
  may skip

on count-menu ?north
  then ?north.menu-count = count where ?north known menu row ?row and ?row.visible
  may skip

on move-menu ?north ?delta
  when ?north.menu-count > 0
  then ?north.menu-selection = if ?north.menu-selection + ?delta < 0 then ?north.menu-count - 1 else if ?north.menu-selection + ?delta >= ?north.menu-count then 0 else ?north.menu-selection + ?delta
  may skip

on close-menu ?north
  then ?north.menu-kind = ""
  may skip

on accept-menu ?north
  when ?north.menu-kind in ["history", "archived-history"]
  and ?north known menu row ?row
  and ?row.visible
  and ?row.position == ?north.menu-selection
  and ?north.host-effect == ""
  and ?effect = if ?north.menu-kind == "archived-history" then "restore-conversation" else "switch-conversation"
  then ?north.menu-kind = ""
  and ?north.host-effect = ?effect
  and ?north.effect-payload = ?row.key
  and ?north requests host effect ?effect with payload ?row.key
  may skip

on accept-menu ?north
  when ?north.menu-kind in ["models", "efforts", "config"]
  and ?north known menu row ?row
  and ?row.visible
  and ?row.position == ?north.menu-selection
  and ?north.host-effect == ""
  and ?effect = if ?north.menu-kind == "models" then "select-model" else if ?north.menu-kind == "efforts" then "select-effort" else "toggle-config"
  then ?north.menu-kind = ""
  and ?north.host-effect = ?effect
  and ?north.effect-payload = ?row.key
  and ?north requests host effect ?effect with payload ?row.key
  may skip

on clear-references ?north
  when ?north known reference ?reference
  then not ?reference is a Reference
  may skip

on query-references ?north ?query
  then ?north.reference-query = ?query
  and ?north.reference-count = 0
  and ?north.reference-selection = 0
  and ?north.references-open = true
  may skip

on offer-reference ?north ?name ?description ?kind ?path
  when ?kind in ["file", "skill", "hook"]
  and contains(lowercase(?name), lowercase(?north.reference-query)) or contains(lowercase(?description), lowercase(?north.reference-query))
  then ?north.reference-count = ?north.reference-count + 1
  and ?north known reference ?reference
  and ?reference is a new Reference {?name, ?description, ?kind, ?path, number: ?north.reference-count}
  may skip

on move-reference ?north ?delta
  when ?north.reference-count > 0
  then ?north.reference-selection = if ?north.reference-selection + ?delta < 0 then ?north.reference-count - 1 else if ?north.reference-selection + ?delta >= ?north.reference-count then 0 else ?north.reference-selection + ?delta
  may skip

on dismiss-references ?north
  then ?north.references-open = false
  may skip

on filter-transcript ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?north known chat entry ?entry
  then ?entry.chat-visible = if ?entry.chat-conversation == ?north.active-conversation then (if ?context.transcript-changes then (if ?entry.chat-kind == "fileChange" then contains(lowercase(?entry.chat-text), lowercase(?context.transcript-query)) else if ?entry.chat-kind == "diff" then contains(lowercase(?entry.chat-text), lowercase(?context.transcript-query)) else false) else contains(lowercase(?entry.chat-text), lowercase(?context.transcript-query))) else false
  may skip

on search-transcript ?north ?query
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.transcript-query = ?query
  and ?context.transcript-offset = 0
  may skip

on scroll-transcript ?north ?delta
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.transcript-offset = if ?context.transcript-offset + ?delta < 0 then 0 else if ?context.transcript-offset + ?delta > ?context.transcript-limit then ?context.transcript-limit else ?context.transcript-offset + ?delta
  may skip

on size-transcript ?north ?limit
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.transcript-offset = if ?context.transcript-offset > ?limit then ?limit else ?context.transcript-offset
  and ?context.transcript-limit = ?limit
  may skip

on toggle-changes ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.transcript-changes = (?context.transcript-changes == false)
  and ?context.transcript-offset = 0
  may skip

on observe-settings ?north ?conversation ?model ?effort
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.context-model = ?model
  and ?context.context-effort = ?effort
  and ?context.context-attached = true
  may skip

on ensure-context ?north ?conversation
  when ?count = count where ?existing-context is a Conversation and ?existing-context.id == ?conversation
  and ?count == 0
  then ?north known context ?context
  and ?context is a new Conversation {id: ?conversation, saved-draft: "", transcript-query: "", transcript-offset: 0, transcript-limit: 0, transcript-changes: false, context-model: "Codex default", context-effort: "default", context-attached: false, active-turn: "", phase: "idle", active-delegated-child: "", terminal-delegated-child: "", turn-readiness: "turn-ready"}
  may skip

on save-draft ?north ?text
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.saved-draft = ?text
  may skip

on observe-prompt ?north ?request ?conversation ?turn ?kind ?cancellation
  when ?count = count where ?prior is a Prompt and (?prior.request == ?request and ?prior.conversation == ?conversation and ?prior.live)
  and ?count == 0
  then ?north.next-prompt-number = ?north.next-prompt-number + 1
  and ?north known prompt ?prompt
  and ?prompt is a new Prompt {number: ?north.next-prompt-number, ?request, ?conversation, ?turn, ?kind, status: "waiting", visible: false, live: true, current: 1, ?cancellation, outcome: "answer"}
  may skip

on observe-prompt-question ?north ?number ?position ?key ?header ?text ?secret ?other ?codec ?multiple ?optional
  when ?north known prompt ?prompt
  and ?prompt.number == ?number
  and ?count = count where ?prompt prompt question ?prior and ?prior.question-number == ?position
  and ?count == 0
  then ?prompt prompt question ?question
  and ?question is a new PromptQuestion {question-number: ?position, question-key: ?key, question-header: ?header, question-text: ?text, question-secret: ?secret, question-other: ?other, question-selected: 1, question-answer: "", question-answered: false, question-text-entry: false, question-codec: ?codec, question-multiple: ?multiple, question-optional: ?optional, question-problem: ""}
  may skip

on observe-prompt-option ?north ?number ?position ?index ?label ?description ?value
  when ?north known prompt ?prompt
  and ?prompt.number == ?number
  and ?prompt prompt question ?question
  and ?question.question-number == ?position
  and ?count = count where ?question question option ?prior and ?prior.option-number == ?index
  and ?count == 0
  then ?question question option ?option
  and ?option is a new PromptOption {option-checked: false, option-number: ?index, option-label: ?label, option-description: ?description, option-value: ?value}
  may skip

on focus-prompts ?north
  when ?north known prompt ?prompt
  and ?count = count where ?earlier is a Prompt and (?earlier.conversation == ?prompt.conversation and ?earlier.number < ?prompt.number and (?earlier.status == "resolved") == false and ?earlier.live)
  then ?prompt.visible = if ?prompt.live then (if ?prompt.conversation == ?north.active-conversation then (if ?prompt.status == "resolved" then false else ?count == 0) else false) else false
  may skip

on present-prompt-questions ?north
  when ?north known prompt ?prompt
  and ?prompt prompt question ?question
  and ?count = count where ?question question option ?option
  then ?question.question-text-entry = if ?question.question-multiple then false else ?count == 0 or if ?question.question-other then ?question.question-selected == 0 else false
  may skip

on navigate-prompt ?north ?direction
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?count = count where ?question question option ?option
  and ?count > 0
  then ?question.question-selected = if ?direction > 0 then (if ?question.question-selected >= ?count then (if ?question.question-other then 0 else 1) else ?question.question-selected + 1) else if ?question.question-selected <= (if ?question.question-other then 0 else 1) then ?count else ?question.question-selected - 1
  may skip

on answer-prompt-choice ?north
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?question.question-multiple == false
  and ?question question option ?option
  and ?option.option-number == ?question.question-selected
  then ?question.question-answer = ?option.option-value
  and ?question.question-answered = true
  and ?prompt.current = ?prompt.current + 1
  may skip

on toggle-prompt-option ?north
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?question.question-multiple
  and ?question question option ?option
  and ?option.option-number == ?question.question-selected
  then ?option.option-checked = (?option.option-checked == false)
  may skip

on answer-prompt-multiple ?north ?text
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?question.question-multiple
  then ?question.question-answer = ?text
  and ?question.question-answered = true
  and ?prompt.current = ?prompt.current + 1
  may skip

on skip-prompt-question ?north
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?question.question-optional
  then ?question.question-answer = "null"
  and ?question.question-answered = true
  and ?prompt.current = ?prompt.current + 1
  may skip

on prompt-answer-problem ?north ?problem
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  then ?question.question-problem = ?problem
  may skip

on answer-prompt-text ?north ?text
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?prompt prompt question ?question
  and ?question.question-number == ?prompt.current
  and ?count = count where ?question question option ?option
  and ?count == 0 or if ?question.question-other then ?question.question-selected == 0 else false
  and (trim(?text) == "") == false
  then ?question.question-answer = ?text
  and ?question.question-answered = true
  and ?prompt.current = ?prompt.current + 1
  may skip

on prepare-prompt-response ?north
  when ?north.connection-state == "connected"
  and ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and ?unanswered = count where ?prompt prompt question ?question and ?question.question-answered == false
  and ?prompt.outcome == "cancel" or ?unanswered == 0
  and ?north.host-effect == ""
  then ?prompt.status = "sending"
  and ?north.host-effect = "answer-prompt"
  and ?north.effect-payload = ""
  and ?north.effect-input-number = ?prompt.number
  and ?north requests host effect "answer-prompt" with payload ""
  may skip

on cancel-prompt ?north
  when ?north known prompt ?prompt
  and ?prompt.visible
  and ?prompt.status == "waiting"
  and (?prompt.cancellation == "") == false
  then ?prompt.outcome = "cancel"
  may skip

on prompt-response-written ?north ?number ?result
  when ?north known prompt ?prompt
  and ?prompt.number == ?number
  and ?prompt.status == "sending"
  then ?prompt.status = ?result
  may skip

on resolve-prompt ?north ?conversation ?request
  when ?north known prompt ?prompt
  and ?prompt.live
  and ?prompt.conversation == ?conversation
  and ?prompt.request == ?request
  then ?prompt.status = "resolved"
  may skip

on close-turn-prompts ?north ?conversation ?turn
  when ?north known prompt ?prompt
  and ?prompt.conversation == ?conversation
  and ?prompt.turn == ?turn
  then ?prompt.status = "resolved"
  may skip

on clear-resolved-answers ?north
  when ?north known prompt ?prompt
  and ?prompt.status == "resolved"
  and ?prompt prompt question ?question
  then ?question.question-answer = ""
  may skip

on observe-turn ?north ?conversation ?turn
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.active-turn = ?turn
  and ?context.phase = if ?context.turn-readiness == "turn-ready" then "dispatching" else ?context.phase
  and ?context.turn-readiness = "turn-active"
  may skip

on observe-stored-turn ?north ?conversation ?turn ?status
  when ?status == "inProgress"
  and ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.active-turn = ?turn
  and ?context.phase = if ?context.turn-readiness == "turn-ready" then "dispatching" else ?context.phase
  and ?context.turn-readiness = "turn-active"
  may skip

on clear-turn ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.active-turn = ""
  may skip

on finish-observed-turn ?north ?conversation ?turn
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.active-turn == ?turn
  then ?context.active-turn = ""
  may skip

on expire-steering ?north ?conversation
  when ?north known pending input ?input
  and ?input.conversation == ?conversation
  and ?input.status == "waiting to steer"
  then ?input.status = "not sent"
  may skip

on retain-input ?north ?text ?mode
  then ?north.draft-number = ?north.draft-number + 1
  and ?north known pending input ?input
  and ?input is a new PendingInput {number: ?north.draft-number, conversation: ?north.active-conversation, ?text, status: if ?north.connection-state == "connected" then (if ?mode == "queue" then "queued" else if ?mode == "direct" then "sending" else "waiting to steer") else "paused", client-id: ""}
  may skip

on bind-input-client-id ?north ?number ?client
  when ?north known pending input ?input
  and ?input.number == ?number
  and ?input.client-id == ""
  then ?input.client-id = ?client
  may skip

on observe-input-acceptance ?north ?conversation ?client
  when (?client == "") == false
  and ?north known pending input ?input
  and ?input.conversation == ?conversation
  and ?input.client-id == ?client
  then ?input.status = "accepted"
  may skip

on record-input-acceptance ?north ?number ?result
  when ?result == "accepted"
  and ?north known pending input ?input
  and ?input.number == ?number
  and ?input.status in ["sending correction", "submitted"]
  then ?north.next-chat-order = ?north.next-chat-order + 1
  and ?north known chat entry ?entry
  and ?entry is a new ChatEntry {chat-visible: false, chat-conversation: ?input.conversation, chat-turn: "", chat-key: ?input.client-id, chat-kind: "userMessage", chat-text: ?input.text, chat-status: "completed", chat-style: "operator", chat-order: ?north.next-chat-order}
  may skip

on input-receipt ?north ?number ?result
  when ?north known pending input ?input
  and ?input.number == ?number
  and ?input.status in ["sending correction", "sending", "submitted"]
  then ?input.status = ?result
  may skip

on prepare-steering ?north
  when ?north.connection-state == "connected"
  and ?context is a Conversation
  and (?context.active-turn == "") == false
  and ?north known pending input ?input
  and ?input.conversation == ?context.id
  and ?input.status == "waiting to steer"
  and ?count = count where ?earlier is a PendingInput and (?earlier.conversation == ?context.id and ?earlier.status in ["waiting to steer", "sending correction"] and ?earlier.number < ?input.number)
  and ?count == 0
  and ?earlier-ready = count where ?earlier is a PendingInput and ?other is a Conversation and (?earlier.number == ?earlier.number and ?earlier.number < ?input.number and ?earlier.status == "waiting to steer" and ?other.id == ?earlier.conversation and (?other.active-turn == "") == false)
  and ?earlier-ready == 0
  and ?north.host-effect == ""
  then ?input.status = "sending correction"
  and ?north.host-effect = "send-steering"
  and ?north.effect-payload = ?input.text
  and ?north.effect-input-number = ?input.number
  and ?north requests host effect "send-steering" with payload ?input.text
  may skip

on retain-queued-attachment ?north ?number ?attachment
  when ?context.id == ?north.active-conversation
  and ?north known pending input ?input
  and ?input.number == ?number
  and ?context draft attachment ?attachment
  then ?input input attachment ?attachment
  and not ?context draft attachment ?attachment
  may skip

on prepare-queued-input ?north
  when ?north.connection-state == "connected"
  and ?context is a Conversation
  and (?context.phase == "failed") == false
  and (?context.phase == "interrupted") == false
  and ?context.turn-readiness == "turn-ready"
  and ?north known pending input ?input
  and ?input.conversation == ?context.id
  and ?input.status == "queued"
  and ?count = count where ?earlier is a PendingInput and (?earlier.conversation == ?context.id and ?earlier.status == "queued" and ?earlier.number < ?input.number)
  and ?count == 0
  and ?earlier-ready = count where ?earlier is a PendingInput and ?other is a Conversation and (?earlier.number == ?earlier.number and ?earlier.number < ?input.number and ?earlier.status == "queued" and ?other.id == ?earlier.conversation and ?other.turn-readiness == "turn-ready" and (?other.phase == "failed") == false and (?other.phase == "interrupted") == false)
  and ?earlier-ready == 0
  and ?north.host-effect == ""
  then ?input.status = "sending"
  and ?north.host-effect = "submit-queued"
  and ?north.effect-payload = ?input.text
  and ?north.effect-input-number = ?input.number
  and ?north requests host effect "submit-queued" with payload ?input.text
  may skip

on submit-queued ?north ?number
  when ?context is a Conversation
  and ?north known pending input ?input
  and ?input.conversation == ?context.id
  and ?input.number == ?number
  and ?input.status == "sending"
  and ?context.turn-readiness == "turn-ready"
  then ?context.phase = "dispatching"
  and ?context.turn-readiness = "turn-active"
  and ?input.status = "submitted"
  may skip

on copy-queued-to-submitted ?north ?number ?attachment
  when ?context is a Conversation
  and ?north known pending input ?input
  and ?input.number == ?number
  and ?input.conversation == ?context.id
  and ?input.status == "sending"
  and ?input input attachment ?attachment
  then ?context submitted attachment ?attachment
  may skip

on prepare-input-edit ?north
  when ?north known pending input ?input
  and ?input.conversation == ?north.active-conversation
  and input-editable(?input.status)
  and ?count = count where ?earlier is a PendingInput and (?earlier.conversation == ?north.active-conversation and ?earlier.number < ?input.number and input-editable(?earlier.status))
  and ?count == 0
  and ?north.host-effect == ""
  then ?input.status = "editing"
  and ?north.host-effect = "edit-pending"
  and ?north.effect-payload = ?input.text
  and ?north.effect-input-number = ?input.number
  and ?north requests host effect "edit-pending" with payload ?input.text
  may skip

on restore-input-attachment ?north ?number ?attachment
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?north known pending input ?input
  and ?input.number == ?number
  and ?input.status == "editing"
  and ?input input attachment ?attachment
  then ?context draft attachment ?attachment
  may skip

on forget-input-attachment ?north ?number ?attachment
  when ?north known pending input ?input
  and ?input.number == ?number
  and ?input.status in ["accepted", "editing"]
  and ?input input attachment ?attachment
  then not ?input input attachment ?attachment
  may skip

on forget-input ?north ?number
  when ?north known pending input ?input
  and ?input.number == ?number
  and ?input.status in ["accepted", "editing"]
  then not ?input is a PendingInput
  may skip

on append-chat ?north ?conversation ?kind ?text
  then ?north.next-chat-order = ?north.next-chat-order + 1
  and ?north known chat entry ?entry
  and ?entry is a new ChatEntry {chat-visible: false, chat-conversation: ?conversation, chat-turn: "", chat-key: "", chat-kind: ?kind, chat-text: ?text, chat-status: "completed", chat-style: chat-appearance(?kind, "completed"), chat-order: ?north.next-chat-order}
  may skip

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when ?count = count where ?existing-entry is a ChatEntry and (?existing-entry.chat-conversation == ?conversation and ?existing-entry.chat-key == ?key and (?existing-entry.chat-turn == ?turn or if ?kind == "userMessage" then (?key == "") == false else false))
  and ?count == 0
  then ?north.next-chat-order = ?north.next-chat-order + 1
  and ?north known chat entry ?entry
  and ?entry is a new ChatEntry {chat-visible: false, chat-conversation: ?conversation, chat-turn: ?turn, chat-key: ?key, chat-kind: ?kind, chat-text: ?text, chat-status: ?status, chat-style: chat-appearance(?kind, ?status), chat-order: ?north.next-chat-order}
  may skip

on observe-chat-item ?north ?conversation ?turn ?key ?kind ?text ?status ?mode
  when ?north known chat entry ?entry
  and ?entry.chat-conversation == ?conversation
  and ?entry.chat-key == ?key
  and ?entry.chat-turn == ?turn or if ?kind == "userMessage" then (?key == "") == false else false
  then ?entry.chat-turn = ?turn
  and ?entry.chat-kind = ?kind
  and ?entry.chat-text = if ?mode == "append" then "{?entry.chat-text}{?text}" else ?text
  and ?entry.chat-status = ?status
  and ?entry.chat-style = chat-appearance(?kind, ?status)
  may skip

on clear-chat ?north
  when ?north known chat entry ?entry
  and ?entry.chat-conversation == ?north.active-conversation
  then not ?entry is a ChatEntry
  may skip

on initialize ?north
  when ?north.initialized == "false"
  then ?north.initialized = "true"
  and ?north known command ?new-command
  and ?north known command ?resume-command
  and ?north known command ?model-command
  and ?north known command ?effort-command
  and ?north known command ?config-command
  and ?north known command ?delegate-command
  and ?north known command ?goal-command
  and ?north known command ?goals-command
  and ?north known command ?agents-command
  and ?north known command ?quit-command
  and ?north known command ?rename-command
  and ?north known command ?fork-command
  and ?north known command ?archive-command
  and ?north known command ?archived-command
  and ?north known command ?usage-command
  and ?north known command ?compact-command
  and ?north known command ?reconnect-command
  and ?north known command ?work-command
  and ?new-command is a new Command {name: "/new", description: "start a new conversation", handler: "command-new", order: 1}
  and ?resume-command is a new Command {name: "/resume", description: "switch to a previous conversation", handler: "command-resume", order: 2}
  and ?model-command is a new Command {name: "/model", description: "choose the active model and reasoning effort", handler: "command-model", order: 3}
  and ?effort-command is a new Command {name: "/effort", description: "change reasoning effort for the active model", handler: "command-effort", order: 4}
  and ?config-command is a new Command {name: "/config", description: "toggle the context switchboard", handler: "command-config", order: 5}
  and ?delegate-command is a new Command {name: "/delegate", description: "delegate one explicit task", handler: "command-delegate", order: 6}
  and ?goal-command is a new Command {name: "/goal", description: "set, edit, or clear the selected goal", handler: "command-goal", order: 7}
  and ?goals-command is a new Command {name: "/goals", description: "inspect Goals", handler: "command-goals", order: 9}
  and ?agents-command is a new Command {name: "/agents", description: "change selected agent", handler: "command-agents", order: 10}
  and ?quit-command is a new Command {name: "/q", description: "quit North", handler: "command-quit", order: 12}
  and ?rename-command is a new Command {name: "/rename", description: "rename the selected conversation", handler: "command-rename", order: 13}
  and ?fork-command is a new Command {name: "/fork", description: "continue a copy of this conversation", handler: "command-fork", order: 14}
  and ?archive-command is a new Command {name: "/archive", description: "archive this conversation and its related agents", handler: "command-archive", order: 15}
  and ?archived-command is a new Command {name: "/archived", description: "find and restore archived conversations", handler: "command-archived", order: 16}
  and ?usage-command is a new Command {name: "/usage", description: "inspect context, limits, and reset availability", handler: "command-usage", order: 17}
  and ?compact-command is a new Command {name: "/compact", description: "make more room in this conversation", handler: "command-compact", order: 18}
  and ?reconnect-command is a new Command {name: "/reconnect", description: "restore the connection without resending messages", handler: "command-reconnect", order: 19}
  and ?work-command is a new Command {name: "/work", description: "list, search, open and edit work items", handler: "command-work", order: 20}
  may skip

on command-work ?north ?command
  when ?north.host-effect == ""
  and ?effect = "work-" ++ (if trim(rest-words(?command)) == "" then "list" else first-word(rest-words(?command)))
  then ?north.host-effect = ?effect
  and ?north.effect-payload = rest-words(rest-words(?command))
  and ?north requests host effect ?effect with payload rest-words(rest-words(?command))
  may skip

on inspect ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?context.phase = ?context.phase
  may skip

on resolve-input ?north ?input
  when starts-with(trim(?input), "/")
  and ?north known command ?command
  and ?command.name == first-word(?input)
  then ?north.input-dispatch = ?command.handler
  and ?north.input-payload = trim(?input)
  and ?north.input-kind = "command"
  may skip

on resolve-input ?north ?input
  when starts-with(trim(?input), "/") == false
  then ?north.input-dispatch = ?north.input-handler
  and ?north.input-payload = ?input
  and ?north.input-kind = "message"
  may skip

on resolve-input ?north ?input
  when starts-with(trim(?input), "/")
  and ?count = count where ?north known command ?command and ?command.name == first-word(?input)
  and ?count == 0
  then ?north.input-dispatch = ""
  and ?north.input-payload = ""
  and ?north.input-kind = "command"
  and ?north.notice = "Unknown command: " ++ first-word(?input)
  may skip

on select-goal ?north ?goal
  when ?north known goal ?goal
  then ?north.active-goal = ?goal
  may skip

on command-new ?north ?command
  when ?command == "/new"
  and ?north.host-effect == ""
  then ?north.host-effect = "new-conversation"
  and ?north.effect-payload = ""
  and ?north requests host effect "new-conversation" with payload ""
  may skip

on command-resume ?north ?command
  when ?north.host-effect == ""
  then ?north.host-effect = "resume-conversation"
  and ?north.effect-payload = rest-words(?command)
  and ?north requests host effect "resume-conversation" with payload rest-words(?command)
  may skip

on command-rename ?north ?command
  when (rest-words(?command) == "") == false
  and (?north.active-conversation == "") == false
  and ?north.host-effect == ""
  then ?north.host-effect = "rename-conversation"
  and ?north.effect-payload = rest-words(?command)
  and ?north requests host effect "rename-conversation" with payload rest-words(?command)
  may skip

on command-rename ?north ?command
  when rest-words(?command) == ""
  then ?north.notice = "Usage: /rename New conversation name"
  may skip

on command-fork ?north ?command
  when ?command == "/fork"
  and (?north.active-conversation == "") == false
  and ?north.host-effect == ""
  then ?north.host-effect = "fork-conversation"
  and ?north.effect-payload = ?north.active-conversation
  and ?north requests host effect "fork-conversation" with payload ?north.active-conversation
  may skip

on command-archived ?north ?command
  when ?north.host-effect == ""
  then ?north.host-effect = "archived-conversations"
  and ?north.effect-payload = rest-words(?command)
  and ?north requests host effect "archived-conversations" with payload rest-words(?command)
  may skip

on command-archive ?north ?command
  when (rest-words(?command) == "confirm") == false
  then ?north.notice = "Archive this conversation and its related agents? Run /archive confirm. Restore conversations from /archived."
  may skip

on command-archive ?north ?command
  when rest-words(?command) == "confirm"
  and ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and (?context.turn-readiness == "turn-ready") == false
  then ?north.notice = "Finish or interrupt the current request before archiving."
  may skip

on command-archive ?north ?command
  when rest-words(?command) == "confirm"
  and (?north.active-conversation == "") == false
  and ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?context.turn-readiness == "turn-ready"
  and ?north.host-effect == ""
  then ?north.host-effect = "archive-conversation"
  and ?north.effect-payload = ?north.active-conversation
  and ?north requests host effect "archive-conversation" with payload ?north.active-conversation
  may skip

on observe-archived ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.turn-readiness = "turn-paused"
  and ?context.context-attached = false
  may skip

on observe-restored ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  then ?context.turn-readiness = "turn-ready"
  may skip

on history-action-completed ?north ?action
  then ?north.notice = if ?action == "rename" then "Conversation renamed." else if ?action == "archive" then "Conversation archived. Restore it from /archived." else "Conversation restored."
  may skip

on command-model ?north ?command
  when ?command == "/model"
  and ?north.host-effect == ""
  then ?north.host-effect = "select-model"
  and ?north.effect-payload = ""
  and ?north requests host effect "select-model" with payload ""
  may skip

on command-effort ?north ?command
  when ?command == "/effort"
  and ?north.host-effect == ""
  then ?north.host-effect = "select-effort"
  and ?north.effect-payload = ""
  and ?north requests host effect "select-effort" with payload ""
  may skip

on command-config ?north ?command
  when ?command == "/config"
  and ?north.host-effect == ""
  then ?north.host-effect = "open-switchboard"
  and ?north.effect-payload = ""
  and ?north requests host effect "open-switchboard" with payload ""
  may skip

on command-quit ?north ?command
  when ?command == "/q"
  and ?north.host-effect == ""
  then ?north.host-effect = "quit"
  and ?north.effect-payload = ""
  and ?north requests host effect "quit" with payload ""
  may skip

on command-delegate ?north ?command
  when ?command == "/delegate"
  and ?north.input-handler == "submit-input"
  then ?north.input-handler = "delegate-task"
  and ?north.notice = "Describe the task to delegate"
  may skip

on delegate-task ?north ?task
  when ?north.input-handler == "delegate-task"
  and ?north.host-effect == ""
  then ?north.input-handler = "submit-input"
  and ?north.host-effect = "delegate"
  and ?north.effect-payload = ?task
  and ?north.notice = ""
  and ?north requests host effect "delegate" with payload ?task
  may skip

on submit-input ?north ?input
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?north.input-handler == "submit-input"
  and ?north.host-effect == ""
  and ?effect = if ?north.connection-state == "connected" then (if ?context.turn-readiness == "turn-active" then "steer" else "submit") else "retain-disconnected"
  then ?north.host-effect = ?effect
  and ?north.effect-payload = ?input
  and ?north requests host effect ?effect with payload ?input
  may skip

on clear-host-effect ?north
  then ?north.host-effect = ""
  and ?north.effect-payload = ""
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "set"
  and goal-text(?command) == ""
  and ?north.input-handler == "submit-input"
  then ?north.input-handler = "goal-title"
  and ?north.pending-goal-title = ""
  and ?north.notice = "Name the Goal"
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "set"
  and (goal-text(?command) == "") == false
  then ?north.input-handler = "submit-input"
  and ?north.next-goal-order = ?north.next-goal-order + 1
  and ?north known goal ?goal
  and ?north.active-goal = ?goal
  and ?north.notice = "Goal set"
  and ?goal is a new Goal {title: goal-text(?command), objective: goal-text(?command), status: "active", order: ?north.next-goal-order, next-goal-revision: 1}
  may skip

on goal-title ?north ?title
  when ?north.input-handler == "goal-title"
  then ?north.input-handler = "goal-objective"
  and ?north.pending-goal-title = ?title
  and ?north.notice = "Describe the desired outcome"
  may skip

on goal-objective ?north ?objective
  when ?north.input-handler == "goal-objective"
  then ?north.input-handler = "submit-input"
  and ?north.pending-goal-title = ""
  and ?north.next-goal-order = ?north.next-goal-order + 1
  and ?north known goal ?goal
  and ?north.active-goal = ?goal
  and ?north.notice = "Goal created"
  and ?goal is a new Goal {title: ?north.pending-goal-title, ?objective, status: "active", order: ?north.next-goal-order, next-goal-revision: 1}
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "edit"
  and goal-text(?command) == ""
  and ?goal = ?north.active-goal
  and ?goal is a Goal
  and ?north.host-effect == ""
  then ?north.input-handler = "goal-edit-input"
  and ?north.notice = "Edit the desired outcome"
  and ?north.host-effect = "edit-draft"
  and ?north.effect-payload = ?goal.objective
  and ?north requests host effect "edit-draft" with payload ?goal.objective
  may skip

on goal-edit-input ?north ?objective
  when ?north.input-handler == "goal-edit-input"
  and (trim(?objective) == "") == false
  and ?goal = ?north.active-goal
  and ?goal is a Goal
  and ?goal.status == "active"
  then ?north.input-handler = "submit-input"
  and ?goal known revision ?revision
  and ?goal.next-goal-revision = ?goal.next-goal-revision + 1
  and ?goal.objective = ?objective
  and ?north.notice = "Goal updated"
  and ?revision is a new GoalRevision {revision-objective: ?goal.objective, revision-order: ?goal.next-goal-revision}
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "edit"
  and (goal-text(?command) == "") == false
  and ?goal = ?north.active-goal
  and ?goal is a Goal
  and ?goal.status == "active"
  then ?north.input-handler = "submit-input"
  and ?goal known revision ?revision
  and ?goal.next-goal-revision = ?goal.next-goal-revision + 1
  and ?goal.objective = goal-text(?command)
  and ?north.notice = "Goal updated"
  and ?revision is a new GoalRevision {revision-objective: ?goal.objective, revision-order: ?goal.next-goal-revision}
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "clear"
  and goal-text(?command) == ""
  and ?goal = ?north.active-goal
  and ?north known goal ?goal
  then ?north.active-goal = no-goal
  and ?goal.status = "cleared"
  and ?north.input-handler = "submit-input"
  and ?north.notice = "Goal cleared"
  may skip

on command-goal ?north ?command
  when (goal-action(?command) == "set") == false
  and ?north.active-goal == no-goal
  then ?north.notice = "No selected goal"
  may skip

on command-goal ?north ?command
  when goal-action(?command) == "clear"
  and (goal-text(?command) == "") == false
  and ?north known goal ?north.active-goal
  then ?north.notice = "Usage: /goal clear"
  may skip

on command-goals ?north ?command
  when ?command == "/goals"
  then ?north.active-view = "goals"
  and ?north.next-view-handler = "view-goals-next"
  and ?north.previous-view-handler = "view-goals-previous"
  and ?north.notice = ""
  may skip

on command-agents ?north ?command
  when ?command == "/agents"
  and ?north.host-effect == ""
  then ?north.host-effect = "select-agent"
  and ?north.effect-payload = "\{\"limit\":100,\"sortKey\":\"recency_at\",\"sortDirection\":\"desc\",\"sourceKinds\":[\"appServer\",\"cli\",\"vscode\",\"unknown\",\"subAgent\",\"subAgentThreadSpawn\",\"subAgentOther\",\"subAgentReview\",\"subAgentCompact\"],\"useStateDbOnly\":true}"
  and ?north requests host effect "select-agent" with payload "\{\"limit\":100,\"sortKey\":\"recency_at\",\"sortDirection\":\"desc\",\"sourceKinds\":[\"appServer\",\"cli\",\"vscode\",\"unknown\",\"subAgent\",\"subAgentThreadSpawn\",\"subAgentOther\",\"subAgentReview\",\"subAgentCompact\"],\"useStateDbOnly\":true}"
  may skip

on show-chat ?north
  then ?north.active-view = "chat"
  and ?north.next-view-handler = "view-chat-next"
  and ?north.previous-view-handler = "view-chat-previous"
  and ?north.notice = ""
  may skip

on view-chat-next ?north
  when ?north.active-view == "chat"
  then ?north.active-view = "goals"
  and ?north.next-view-handler = "view-goals-next"
  and ?north.previous-view-handler = "view-goals-previous"
  may skip

on view-chat-previous ?north
  when ?north.active-view == "chat"
  then ?north.active-view = "goals"
  and ?north.next-view-handler = "view-goals-next"
  and ?north.previous-view-handler = "view-goals-previous"
  may skip

on view-goals-next ?north
  when ?north.active-view == "goals"
  then ?north.active-view = "chat"
  and ?north.next-view-handler = "view-chat-next"
  and ?north.previous-view-handler = "view-chat-previous"
  may skip

on view-goals-previous ?north
  when ?north.active-view == "goals"
  then ?north.active-view = "chat"
  and ?north.next-view-handler = "view-chat-next"
  and ?north.previous-view-handler = "view-chat-previous"
  may skip

on observe-conversation ?north ?conversation
  then ?north.conversation-change = ?north.conversation-change
  and ?north known conversation ?conversation
  may skip

on attach-image ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  then ?north.next-attachment-number = ?north.next-attachment-number + 1
  and ?context draft attachment ?north.next-attachment-number
  may skip

on detach-image ?north ?attachment
  when ?context.id == ?north.active-conversation
  and ?context draft attachment ?attachment
  then ?north.next-attachment-number = ?north.next-attachment-number
  and not ?context draft attachment ?attachment
  may skip

on copy-submission-attachment ?north ?attachment
  when ?context.id == ?north.active-conversation
  and ?context draft attachment ?attachment
  then ?north.draft-number = ?north.draft-number
  and ?context submitted attachment ?attachment
  may skip

on clear-submitted-attachment ?north ?conversation ?attachment
  when ?context.id == ?conversation
  and ?context submitted attachment ?attachment
  then ?north.next-attachment-number = ?north.next-attachment-number
  and not ?context submitted attachment ?attachment
  may skip

on request-new-conversation ?north
  when ?north.conversation-change == "conversation-ready"
  and ?north.pending-conversation == ""
  then ?north.conversation-change = "conversation-opening"
  and ?north.pending-conversation = ""
  may skip

on settle-new-conversation ?north ?conversation
  when ?north.conversation-change == "conversation-opening"
  and ?north.pending-conversation == ""
  then ?north.conversation-change = "conversation-ready"
  and ?north.active-conversation = ?conversation
  and ?north known conversation ?conversation
  may skip

on fail-new-conversation ?north
  when ?north.conversation-change == "conversation-opening"
  and ?north.pending-conversation == ""
  then ?north.conversation-change = "conversation-ready"
  may skip

on request-switch-conversation ?north ?conversation
  when ?north.conversation-change == "conversation-ready"
  and ?north known conversation ?conversation
  and ?north.pending-conversation == ""
  then ?north.conversation-change = "conversation-switching"
  and ?north.pending-conversation = ?conversation
  may skip

on settle-switch-conversation ?north ?conversation
  when ?north.conversation-change == "conversation-switching"
  and ?north.pending-conversation == ?conversation
  then ?north.conversation-change = "conversation-ready"
  and ?north.active-conversation = ?conversation
  and ?north.pending-conversation = ""
  may skip

on fail-switch-conversation ?north ?conversation
  when ?north.conversation-change == "conversation-switching"
  and ?north.pending-conversation == ?conversation
  then ?north.conversation-change = "conversation-ready"
  and ?north.pending-conversation = ""
  may skip

on submit ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?context.turn-readiness == "turn-ready"
  then ?context.phase = "dispatching"
  and ?context.turn-readiness = "turn-active"
  and ?context.terminal-delegated-child = ""
  and ?north.draft-number = ?north.draft-number + 1
  may skip

on delegate ?north
  when ?context is a Conversation
  and ?context.id == ?north.active-conversation
  and ?context.turn-readiness == "turn-ready"
  then ?context.phase = "delegating"
  and ?context.turn-readiness = "turn-active"
  and ?context.terminal-delegated-child = ""
  and ?north.draft-number = ?north.draft-number + 1
  may skip

on child-spawned ?north ?conversation ?child
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "delegating"
  and ?context.active-delegated-child == ""
  then ?context.phase = "settling"
  and ?context.active-delegated-child = ?child
  may skip

on settle-success ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "dispatching"
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "completed"
  and ?context.turn-readiness = "turn-ready"
  may skip

on abandon-turn ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "failed"
  and ?context.turn-readiness = "turn-ready"
  and ?context.active-delegated-child = ""
  and ?context.terminal-delegated-child = ?context.active-delegated-child
  may skip

on settle-interrupted ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "interrupted"
  and ?context.turn-readiness = "turn-ready"
  and ?context.active-delegated-child = ""
  and ?context.terminal-delegated-child = ?context.active-delegated-child
  may skip

on settle-failure ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "dispatching"
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "failed"
  and ?context.turn-readiness = "turn-ready"
  may skip

on settle-delegation-success ?north ?conversation ?child
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "settling"
  and ?context.active-delegated-child == ?child
  and ?context.terminal-delegated-child == ""
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "completed"
  and ?context.active-delegated-child = ""
  and ?context.terminal-delegated-child = ?child
  and ?context.turn-readiness = "turn-ready"
  may skip

on fail-delegation-before-child ?north ?conversation
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "delegating"
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "failed"
  and ?context.turn-readiness = "turn-ready"
  may skip

on fail-delegation-after-child ?north ?conversation ?child
  when ?context is a Conversation
  and ?context.id == ?conversation
  and ?context.phase == "settling"
  and ?context.active-delegated-child == ?child
  and ?context.terminal-delegated-child == ""
  and ?context.turn-readiness == "turn-active"
  then ?context.phase = "failed"
  and ?context.active-delegated-child = ""
  and ?context.terminal-delegated-child = ?child
  and ?context.turn-readiness = "turn-ready"
  may skip

event offer-row North ?key: Text ?label: Text ?description: Text ?annotation: Text

on offer-row ?north ?key ?label ?description ?annotation
  then ?north.menu-row-count = ?north.menu-row-count + 1
  and ?north known menu row ?row
  and ?row is a new MenuRow {?key, ?label, ?description, annotation: if ?north.menu-kind in ["history", "archived-history"] and ?key == ?north.active-conversation then "current" else ?annotation, order: ?north.menu-row-count, position: ?north.menu-row-count, visible: true}

view Menu for North
  kind: ?north.menu-kind
  title: ?north.menu-title
  query: ?north.menu-query
  help: ?north.menu-help
  empty: ?north.menu-empty
  selection: ?north.menu-selection
  rows: all {?row, ?row.key, ?row.label, ?row.description, ?row.annotation, ?row.position} where ?north known menu row ?row and ?row.visible, sorted by ?row.order
