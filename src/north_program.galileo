  at most one per step
  settled by clear-host-effect

define input-editable(status: Text): Bool
  status in ["queued", "paused", "not sent", "waiting to steer"]

define chat-appearance(kind: Text, status: Text): Text
  if kind == "userMessage" then "operator"
  else if kind == "operator" then "operator"
  else if kind == "agentMessage" then "markdown"
  else if kind == "commandExecution" then (if status == "completed" then "command-success" else if status == "inProgress" then "command-running" else "command-failure")
  else if kind == "fileChange" then "diff"
  else if kind == "diff" then "diff"
  else kind

define goal-action(input: Text): Text
  if first-word(rest-words(input)) == "edit" then "edit"
  else if first-word(rest-words(input)) == "clear" then "clear"
  else "set"

define goal-text(input: Text): Text
  trim(if first-word(rest-words(input)) == "set" then rest-words(rest-words(input)) else if first-word(rest-words(input)) == "edit" then rest-words(rest-words(input)) else if first-word(rest-words(input)) == "clear" then rest-words(rest-words(input)) else rest-words(input))

initially
