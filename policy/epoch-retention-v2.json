{
  "version": "retention-v2",
  "ttl_days": 14,
  "retain_kinds": ["thread", "topic", "predicate", "predicate_example", "schema", "template", "tier_row", "model", "provider_catalog", "doctrine_block", "staffing_catalog", "estimate", "subscription"],
  "retain_kind_prefixes": ["selection_", "client_"],
  "ephemeral_kinds": ["run", "run_event", "notification", "session", "lane", "message", "worktree_allocation", "worktree_reservation", "guard_denial"],
  "ephemeral_kind_prefixes": ["rebuild-"],
  "drop_subject_prefixes": ["@lease:", "@cmd:"],
  "identity_predicates": ["title", "kind", "display_name"],
  "identity_fallback_predicates": ["name", "role", "agent", "thread", "run_reservation_agent"],
  "registry_predicates": ["cardinality", "value_kind", "acyclic"],
  "log_identity_cursors": [
    {
      "cursor": "rebuild_queue.legacy",
      "log": "coordination.log",
      "repair": "north rebuild repair-legacy-cursor"
    }
  ]
}
