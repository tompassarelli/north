;; Registry of the human CLI surface; share/help/* are projections of it — regenerate: bb cli/surface-gen.clj.
;; cli/tests/surface-sync-test.clj welds :commands (+ :aliases) to bin/north's case arms both ways.
;; Field semantics live in cli/surface-gen.clj's header.
{:product "north — coordinate work, agents, and time"
 :topics
 [{:id :work    :title "WORK"    :subtitle "threads: thought → fact → outcome"}
  {:id :agents  :title "AGENTS"  :subtitle "delegate work, drive and observe agents"}
  {:id :comms   :title "COMMS"   :subtitle "attention between people and agents"}
  {:id :routing :title "ROUTING" :subtitle "providers, accounts, dispatch posture"}
  {:id :store   :title "STORE"   :subtitle "the fact corpus and its schema"}
  {:id :ops     :title "OPS"     :subtitle "daemons, health, deployment"}]
 :card-sections
 [{:id :now    :title "NOW"}
  {:id :work   :title "WORK"}
  {:id :agents :title "AGENTS"}
  {:id :system :title "SYSTEM"}]
 :passthrough
 "any other verb passes through to the fram engine (ask, watch, …)"
 :commands
 [;; ---------------------------------------------------------------- work
  {:verb "capture" :form "north capture \"<title>\" [owner]" :topic :work
   :summary "mint a committed thread from one thought (zero ceremony)"
   :card {:section :work :form "north capture \"<thought>\""
          :text "one thought → one committed thread"}}
  {:verb "show" :form "north show <id|slug|substring>" :topic :work
   :summary "one thread's facts + body; resolves id, slug, substring"
   :card {:section :work :form "north show <id>"
          :text "a thread's facts + body"}}
  {:verb "tell" :form "north tell <id> <pred> <value>" :topic :work
   :summary "assert a fact through the fact server (serialized, rule-checked)"
   :card {:section :work :form "north tell <id> <pred> <val>"
          :text "assert a fact (retract removes)"}}
  {:verb "retract" :form "north retract <id> <pred> <value>" :topic :work
   :aliases ["untell"]
   :summary "retract a fact through the fact server"}
  {:verb "threads" :form "north threads [--all]" :topic :work
   :aliases ["board" "plate"]
   :summary "thread-kind overview: active drivers, top ready, counts"
   :card {:section :work :form "north threads"
          :text "active / ready / blocked overview"}}
  {:verb "ready" :form "north ready [--all]" :topic :work
   :summary "committed + unblocked work; manual queue order, leverage fallback"
   :card {:section :now :rank 2 :form "north ready"
          :text "what you could start now; queue order, leverage fallback"}}
  {:verb "queue" :form "north queue move <thread> <before|after|first|last> [anchor]" :topic :work
   :summary "durably reorder the derived ready lane without mutating status"}
  {:verb "next" :form "north next" :topic :work
   :summary "the recommended next pull"}
  {:verb "report" :form "north report" :topic :work
   :summary "recent shipped outcomes"}
  {:verb "blocked" :form "north blocked" :topic :work
   :summary "threads waiting on a depends_on target"}
  {:verb "leverage" :form "north leverage" :topic :work
   :summary "what unblocks the most downstream work"}
  {:verb "agenda" :form "north agenda" :topic :work
   :summary "calendar projection over do_on: overdue / today / upcoming"
   :card {:section :now :rank 4 :form "north agenda"
          :text "dated and overdue work"}}
  {:verb "needs-review" :form "north needs-review" :topic :work
   :summary "judgments whose inputs moved; unevidenced bars; promotable drafts"}
  {:verb "resolve" :form "north resolve <ref>" :topic :work
   :summary "canonical thread id for a ref (id, slug, or substring)"}
  {:verb "evidence" :form "north evidence record \"<bar>\" \"<result>\"" :topic :work
   :summary "bind done-bar evidence to this exact managed run"
   :details ["--thread <id> — no reservation in env: record unreserved thread evidence"]}
  {:verb "bars" :form "north bars list|prune <thread>" :topic :work
   :summary "groom a thread's done_when set; prune retires evidenced bars"}
  {:verb "worktrees" :form "north worktrees [repo] [--json]" :topic :work
   :summary "every repo's wt-* trees: drift, dirt, age, owning lane/concern"}
  {:verb "worktree" :form "north worktree lander [repo]" :topic :work
   :summary "landing reconciliation: harvest lane refs already merged to main"}
  {:verb "linear" :form "north linear get|import|plan|sync" :topic :work
   :summary "mechanical Linear bridge (sync is plan-only unless --apply)"}
  {:verb "merge" :form "north merge <from> <to>" :topic :work :dispatch :fram
   :summary "fold one node into another; refs follow"}

  ;; -------------------------------------------------------------- agents
  {:verb "delegate" :form "north delegate \"<task>\"" :topic :agents
   :summary "hand work to a new lane; intake classifies atomic vs composite"
   :details ["--role <worker> — atomic: exactly one selected worker"
             "--composite — 2+ independent pieces: hydrates an orchestrator"
             "--thread <id> — bind an existing thread"
             "in chat, /delegate does this with session context riding along"]
   :card {:section :agents :form "north delegate \"<task>\""
          :text "hand work to a new lane"}}
  {:verb "agents" :form "north agents [--json]" :topic :agents
   :summary "live agents now + the stable machine roster"
   :card {:section :agents :form "north agents"
          :text "who's live now"}}
  {:verb "lanes" :form "north lanes" :topic :agents
   :summary "last 24h lane receipts: done, failed, working, killed, or never acknowledged"
   :card {:section :agents :form "north lanes"
          :text "postmortem lane liveness from durable receipts"}}
  {:verb "spawn" :form "north spawn <role> \"<prompt>\"" :topic :agents
   :summary "compose a worker from Orchestration's staffing catalog"
   :details ["--provider auto|anthropic|openai — select or auto-route the provider"
             "--taskGrade/--domain — independently override stock staffing axes"
             "--topology — bespoke compositions only; stock topology is fixed"
             "--tier/--reasoning/--posture — capability, deliberation, posture"
             "--assessment JSON|@file — selection sidecar (required for max)"
             "--pin-evidence JSON|@file — typed reason + <=24h expiry for exact pins"
             "--rationale \"why\" — required for a bespoke role"
             "--doctor [--deep|--canary|--json] — test every dispatch invariant at once"
             "in-harness agents dispatch via MCP: mcp__north__dispatch / spawn"]}
  {:verb "templates" :form "north templates" :topic :agents
   :summary "Orchestration's reusable stock templates and routing defaults"
   :card {:section :agents :form "north templates"
          :text "stock templates and routing defaults"}}
  {:verb "watch" :form "north watch <id>" :topic :agents
   :summary "tail an agent's transcript"
   :card {:section :agents :form "north watch <id>"
          :text "tail one agent's transcript"}}
  {:verb "msg" :form "north msg <id> \"<msg>\"" :topic :agents
   :summary "inject a message into a running agent"
   :card {:section :agents :form "north msg <id> \"<msg>\""
          :text "nudge it mid-flight"}}
  {:verb "goal" :form "north goal <id> \"<goal>\"" :topic :agents
   :summary "redirect a running agent's goal"}
  {:verb "trace" :form "north trace <id>" :topic :agents
   :summary "diagnose one agent's lifecycle; flags the first failing stage"}
  {:verb "wip" :form "north wip [--check]" :topic :agents
   :summary "live managed lanes vs floor (--check: exit 3 on shortfall)"}
  {:verb "escalate" :form "north escalate needs-replan …" :topic :agents
   :summary "checkpoint scope overrun; route it up the live parent chain"
   :details ["--summary/--checkpoint/--seam/--propose — the structured payload"]}
  {:verb "listen" :form "north listen <agent-id>" :topic :agents
   :summary "arm the real-time interrupt listener (background task; dormant)"}
  {:verb "request" :form "north request|fork|req" :topic :agents
   :aliases ["fork" "req"] :status :legacy
   :summary "legacy spawn aliases"}
  {:verb "delivery" :form "north delivery attest <agent-id>" :topic :agents
   :status :unavailable
   :summary "unavailable until verifier lanes have OS isolation"}

  ;; --------------------------------------------------------------- comms
  {:verb "inbox" :form "north inbox [--as <recipient>]" :topic :comms
   :aliases ["notifications"]
   :summary "durable messages waiting on you"
   :details ["--as <recipient> — inspect another recipient's inbox"]
   :card {:section :now :rank 3 :form "north inbox"
          :text "messages waiting on you"}}
  {:verb "mention" :form "north mention <recipient> \"<body>\"" :topic :comms
   :summary "durable sender-driven request; offline recipient allowed"
   :details ["--about <thread> — attach the request to a thread"]}
  {:verb "interrupt" :form "north interrupt <recipient> \"<body>\"" :topic :comms
   :summary "urgent sender-driven request; live recipient required"}
  ;; ------------------------------------------------------------- routing
  {:verb "config" :form "north config" :topic :routing
   :summary "every posture setting + routing policy, one report"
   :details ["north config dispatch <mode> — native · managed · auto"
             "north config guards on|off — value-aware kill-switch for authoring guards"
             "north config routing — allocation detail inside auto: provider order, pressure, reserves, envelopes"
             "north config learning — frozen known-best or learning bounded experimental assignment"]
   :card {:section :system :form "north config"
          :text "posture: dispatch surface, guards, routing"}}
  {:verb "providers" :form "north providers [--json]" :topic :routing
   :summary "provider readiness and the auto-route decision"}
  {:verb "learning" :form "north learning compare <experiment-id> [--json]" :topic :routing
   :summary "descriptive exact-task cohorts from immutable learning facts"
   :details ["retains excluded attempts, retry lineage, propensities, and unknown measurements"
             "observed cohort summaries are descriptive only, never causal effects"]}
  {:verb "account" :form "north account <sub>" :topic :routing
   :summary "isolated provider subscription accounts"
   :details ["add|login|status|list|usage|availability — homes under ~/.local/state/north/accounts"]}
  {:verb "failover" :form "north failover check|fire" :topic :routing
   :summary "classify active rungs; compose/launch a provider-recovery lead"
   :details ["fire --thread ID --brief PATH [--dry-run] — only fire may launch"]}
  {:verb "spend" :form "north spend status|init|override" :topic :routing
   :summary "API-billing budget: cap, reserved, settled, headroom"}
  {:verb "ccr" :form "north ccr prepare|retrieve" :topic :routing
   :summary "default-off structured-output CCR canary"}
  {:verb "handoff" :form "north handoff" :topic :routing :status :legacy
   :summary "renamed — use north failover"}
  {:verb "provider-observe" :form "north provider-observe" :topic :routing
   :status :internal
   :summary "machine-ingestion surface for provider telemetry"}

  ;; --------------------------------------------------------------- store
  {:verb "schema" :form "north schema" :topic :store
   :summary "vocabulary census: subjects/facts by kind + predicate metadata"}
  {:verb "predicate" :form "north predicate ls|show|define" :topic :store
   :summary "inspect or extend executable predicate entities"}
  {:verb "validate" :form "north validate" :topic :store
   :summary "full integrity check: engine rules + north work rules"}
  {:verb "audit" :form "north audit" :topic :store
   :summary "corpus-health report"}
  {:verb "history" :form "north history <id>" :topic :store
   :summary "a subject's full fact history from the log"}
  {:verb "json" :form "north json <view>" :topic :store
   :summary "machine-readable projections (plate, ready, show, …)"}
  {:verb "tools" :form "north tools" :topic :store
   :summary "the curated MCP tool surface + the fram engine core"}
  {:verb "boot" :form "north boot" :topic :store
   :summary "session orientation from the live coordination projection"}
  {:verb "import" :form "north import" :topic :store :dispatch :fram
   :summary "fold threads/ file edits into the log (idempotent, safe anytime)"}
  {:verb "export" :form "north export <out-dir>" :topic :store :dispatch :fram
   :summary "regenerate threads/ from the log — never during concurrent work"}
  {:verb "set" :form "north set …" :topic :store :dispatch :fram :status :legacy
   :summary "direct log append — single-writer/offline only; races otherwise"}
  ;; ----------------------------------------------------------------- ops
  {:verb "dashboard" :form "north dashboard [--once]" :topic :ops
   :summary "live fleet, health, board, and accounts snapshots"
   :card {:section :now :rank 1 :form "north dashboard"
          :text "fleet, health, board, accounts — one screen"}}
  {:verb "bridge" :form "north bridge <prompt>|dashboard|pending|accept|attach|msg|interrupt <execution-id>" :topic :ops
   :summary "dashboard, launch, attach, or control a journaled local Codex session"
   :details ["dashboard — render the Bridge operator cockpit (north dashboard remains an alias)"
             "pending [--consume <id>] — list or consume durable terminal lane completions"
             "accept — run the two-session reconnect/control/journal acceptance demo"
             "msg <id> <text> — queue input for the next turn on the same provider thread"
             "interrupt <id> — interrupt the active turn without terminating its session"]}
  {:verb "doctor" :form "north doctor" :topic :ops
   :summary "is everything healthy: fact server, daemons, rev skew, env, hooks"
   :card {:section :system :form "north doctor"
          :text "is everything healthy: daemons, skew, hooks"}}
  {:verb "health" :form "north health" :topic :ops
   :summary "coordination rollup: lanes ran/died, stale concerns, zombies"}
  {:verb "hotspots" :form "north hotspots" :topic :ops
   :summary "where time goes and what fails, ranked from live telemetry"}
  {:verb "coord-ready" :form "north coord-ready" :topic :ops
   :summary "cheap exact runtime identity for every active writer"}
  {:verb "coord-safety" :form "north coord-safety" :topic :ops
   :summary "runtime identity + strict log-fence round trip"}
  {:verb "acp" :form "north acp" :topic :ops
   :summary "serve the bounded local ACP endpoint over stdio"}
  {:verb "stream-sync" :form "north stream-sync" :topic :ops
   :summary "cursor-based transcript log-shipping"}
  {:verb "stream-distill" :form "north stream-distill --project-root DIR --stream-thread ID [--lineage SHA256]" :topic :ops
   :summary "claim one settled mirror and publish its Tier 1 distillation"}
  {:verb "panic" :form "north panic" :topic :ops :dispatch :pre-case
   :summary "minimal recovery path; works with bb/fram/coordinator down"}
  {:verb "help" :form "north help [<topic>|--all]" :topic :ops
   :summary "the card; a topic page; or the complete reference"}]}
