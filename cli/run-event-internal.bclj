#lang beagle/clj
(ns user)

;; Retry-idempotent exact WireEvent publication. Every fact projection retains
;; the canonical event bytes; Beagle Store serializes each append and rejects forks.
(require '[cheshire.core :as json]
         '[clojure.java.io :as io]
         '[clojure.java.shell :as shell]
         '[clojure.string :as str])

(declare-extern load-file (Fn [String] Any))
(declare-extern .toString (Fn [Any String] String))
(declare-extern
  [north.run-ledger/max-projection-batch-bytes
   north.run-ledger/max-batch-events]
  Int)
(declare-extern north.run-ledger/canonical-entity! (Fn [Any String] Any))
(declare-extern north.run-ledger/validate-event-facts! (Fn [Any Any] Any))
(declare-extern north.run-ledger/event-subject (Fn [Any Int] Any))
(declare-extern north.coord/query-rows! (Fn [Any Any] Any))
(declare-extern north.coord/assert-batch-after-read!
  (Fn [Any Any (Fn [] Any)] Any))

(def cli-dir Any (.getParent (io/file (or *file* (System/getProperty "babashka.file")))))
(load-file (str cli-dir "/coord.clj"))
(load-file (str cli-dir "/run-ledger.clj"))
(def wire-jsonl-decoder Any
  (.getCanonicalPath (io/file cli-dir "../sdk/src/wire/jsonl.ts")))

(defn fail! [message Any data Any] Any (throw (ex-info message data)))
(defn checked! [result Any operation Any] Any
  (when (get result :reject) (fail! "coordinator rejected wire event publication" {:operation operation}))
  result)

(defn bounded-stdin! [] Any
  (let [buffer Any (byte-array 8192)
        output Any (java.io.ByteArrayOutputStream.)]
    (loop [total Int 0]
      (let [read Int (.read System/in buffer)]
        (if (neg? read)
          (.toString output "UTF-8")
          (let [next-total Int (+ total read)]
            (when (> next-total north.run-ledger/max-projection-batch-bytes)
              (fail! "wire event batch exceeds its encoded byte bound"
                     {:limit north.run-ledger/max-projection-batch-bytes}))
            (.write output buffer 0 read)
            (recur next-total)))))))

(defn fact-payload! [parsed Any] Any
  (when-not (sequential? parsed) (fail! "wire event facts must be an array" {}))
  (mapv (fn [entry Any] Any
          (when-not (and (sequential? entry) (= 2 (count entry))
                         (every? string? entry) (every? (fn [__north_anon_1 Any] Any (not (str/blank? __north_anon_1))) entry))
            (fail! "wire event facts must be nonblank string pairs" {:entry entry}))
          (vec entry))
        parsed))

(defn event-entry! [subject-s Any facts Any] Any
  (let [subject Any (north.run-ledger/canonical-entity! subject-s "event subject")
        event Any (north.run-ledger/validate-event-facts! subject facts)]
    {:subject subject :facts facts :event event}))

(defn validate-batch-semantics! [events Any] Any
  (let [wire-jsonl Any (str (str/join "\n" (map (fn [__north_anon_1 Any] Any (get __north_anon_1 "json")) events)) "\n")
        bun Any (or (System/getenv "NORTH_BUN") "bun")
        validator Any (str "import { decodeWireJsonl } from " (pr-str wire-jsonl-decoder) ";"
                       "decodeWireJsonl(await Bun.stdin.text());")
        {:keys [exit]} Any (shell/sh bun "-e" validator :in wire-jsonl)]
    (when-not (zero? exit)
      (fail! "wire event batch violates the canonical reducer contract" {}))))

(defn batch-payload! [raw Any] Any
  (let [parsed Any (try (json/parse-string (str raw))
                    (catch Exception error
                      (fail! "invalid wire event batch JSON" {:cause (.getMessage error)})))]
    (when-not (and (sequential? parsed) (seq parsed)
                   (<= (count parsed) north.run-ledger/max-batch-events))
      (fail! "wire event batch must be nonempty and bounded" {}))
    (let [entries Any
          (mapv
           (fn [entry Any] Any
             (when-not (and (map? entry) (= #{"subject" "facts"} (set (keys entry))))
               (fail! "wire event batch entries require only subject and facts" {:entry entry}))
             (event-entry! (get entry "subject") (fact-payload! (get entry "facts"))))
           parsed)
          events Any (mapv (fn [entry Any] Any (get entry :event)) entries)
          sequences Any (mapv (fn [__north_anon_1 Any] Any (get __north_anon_1 "sequence")) events)
          first-sequence Int (first sequences)
          lineage-keys Any ["run" "thread" "agent" "parentThread" "coordinator"]]
      (when-not (= sequences (vec (range first-sequence (+ first-sequence (count entries)))))
        (fail! "wire event batch requires a contiguous sequence" {:sequences sequences}))
      (when-not (= 1 (count (set (map (fn [__north_anon_1 Any] Any (select-keys __north_anon_1 lineage-keys)) events))))
        (fail! "wire event batch lineage must remain constant" {}))
      (when (and (zero? (first sequences))
                 (not= "run.started" (get (first events) "kind")))
        (fail! "wire event sequence zero must be run.started" {}))
      (when (some (fn [__north_anon_1 Any] Any (= "run.terminated" (get __north_anon_1 "kind"))) (butlast events))
        (fail! "wire event batch cannot continue after run.terminated" {}))
      entries)))

(defn facts-of! [port Any subject Any] Any
  (let [rows Any (north.coord/query-rows!
              port {:find "wire_event_writer_fact"
                    :rules [{:head {:rel "wire_event_writer_fact"
                                    :args [{:var "p"} {:var "r"}]}
                             :body [{:rel "triple"
                                     :args [subject {:var "p"} {:var "r"}]}]}]})]
    (reduce (fn [acc Any [predicate value] Any] Any (update acc predicate (fnil conj #{}) value)) {} rows)))

(defn fact-map [facts Any] Any
  (reduce (fn [acc Any [predicate value] Any] Any (update acc predicate (fnil conj #{}) value)) {} facts))

(defn stored-event! [port Any subject Any] Any
  (let [stored Any (facts-of! port subject)]
    (when (seq stored)
      (north.run-ledger/validate-event-facts!
       subject
       (mapv (fn [[predicate values] Any] Any
               (when-not (= 1 (count values))
                 (fail! "stored wire event predicate is not singleton"
                        {:subject subject :predicate predicate}))
               [predicate (first values)])
             stored)))))

(defn previous-subject [event Any] Any
  (let [sequence Int (get event "sequence")]
    (when (pos? sequence)
      (north.run-ledger/event-subject (get event "run") (dec sequence)))))

(defn committed-prefix! [port Any event Any] Any
  (mapv (fn [sequence Any] Any
          (let [subject Any (north.run-ledger/event-subject (get event "run") sequence)
                committed Any (stored-event! port subject)]
            (when-not committed
              (fail! "wire event batch requires its committed predecessor"
                     {:previous subject}))
            committed))
        (range (get event "sequence"))))

(defn preflight! [port Any entries Any] Any
  (doseq [{:keys [subject facts]} entries
          :let [stored (facts-of! port subject)]
          :when (and (seq stored) (not= stored (fact-map facts)))]
    (fail! "wire event subject conflicts with an existing projection" {:subject subject}))
  (let [first-entry Any (first entries)
        first-event Any (get first-entry :event)
        predecessor-subject Any (previous-subject first-event)
        prefix Any (when predecessor-subject (committed-prefix! port first-event))]
    (when predecessor-subject
      (let [predecessor Any (stored-event! port predecessor-subject)]
        (when-not predecessor
          (fail! "wire event batch requires its committed predecessor"
                 {:subject (get first-entry :subject) :previous predecessor-subject}))
        (when-not (= (get predecessor "run") (get first-event "run"))
          (fail! "wire event predecessor belongs to another run" {}))
        (when (= "run.terminated" (get predecessor "kind"))
          (fail! "wire event publication cannot append after run.terminated" {}))))
    (validate-batch-semantics!
     (into (vec (or prefix [])) (map (fn [entry Any] Any (get entry :event)) entries)))))

(defn publish-event! [port Any {:keys [subject facts event]} Any] Any
  (let [expected Any (fact-map facts)
        predecessor-subject Any (previous-subject event)]
    (checked!
     (north.coord/assert-batch-after-read!
      port subject
      (fn [] Any
        (let [stored Any (facts-of! port subject)]
          (cond
            (= stored expected) {:done true}
            (seq stored)
            (fail! "wire event subject conflicts with an existing projection" {:subject subject})
            :else
            (do
              (when predecessor-subject
                (let [predecessor Any (stored-event! port predecessor-subject)]
                  (when-not predecessor
                    (fail! "wire event publication requires its committed predecessor"
                           {:subject subject :previous predecessor-subject}))
                  (when (= "run.terminated" (get predecessor "kind"))
                    (fail! "wire event publication cannot append after run.terminated"
                           {:subject subject :previous predecessor-subject}))))
              (north.run-ledger/validate-event-facts! subject facts)
              {:facts (mapv (fn [[predicate value] Any] Any {:p predicate :r value}) facts)})))))
     [:assert-batch-after-read subject])
    (when-not (= expected (facts-of! port subject))
      (fail! "wire event readback conflicts with submitted projection" {:subject subject}))
    {:subject subject :sequence (get event "sequence")}))

(defn publish-events! [port Any entries Any] Any
  ;; Preflight protects a clean batch from deterministic partial mutation.
  ;; If a process dies during publication, exact retry resumes the remaining
  ;; suffix because already-committed subjects compare byte-for-byte equal.
  (preflight! port entries)
  (mapv (fn [__north_anon_1 Any] Any (publish-event! port __north_anon_1)) entries))

(defn -main [& (args (Vec String))] Any
  (let [[port-s] Any args
        _ Any (when-not (= 1 (count args))
            (fail! "usage: run-event-internal.clj PORT < BATCH_JSON" {:argc (count args)}))
        port Any (Integer/parseInt (or port-s (or (System/getenv "NORTH_PORT") "7977")))
        entries Any (batch-payload! (bounded-stdin!))
        published Any (publish-events! port entries)]
    (println (json/generate-string
              {:ok true
               :count (count published)
               :firstSequence (get (first published) :sequence)
               :lastSequence (get (last published) :sequence)}))))

(when (= *file* (System/getProperty "babashka.file"))
  (apply -main *command-line-args*))
