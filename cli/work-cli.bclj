#lang beagle/clj

(ns north.work-cli
  "Typed command boundary for Store-backed tracked-thing operations.")

(require [cheshire.core :as json])
(require [clojure.java.io :as io])
(require [clojure.string :as str])

(declare-extern cheshire.core/generate-string (Fn [Any] String))
(declare-extern cheshire.core/parse-string (Fn [String] Any))
(declare-extern clojure.core/load-file (Fn [String] Any))
(declare-extern clojure.core/ns-resolve (Fn [Any Any] Any))
(declare-extern clojure.core/var-get (Fn [Any] Any))
(declare-extern java.time.Instant/now (Fn [] Any))
(declare-extern java.util.UUID/randomUUID (Fn [] Any))

(def semantic-receipt-protocol String "north.semantic-receipt")
(def semantic-view-protocol String "north.semantic-view")
(def semantic-history-protocol String "north.semantic-history")
(def semantic-inbox-protocol String "north.semantic-inbox")
(def semantic-catalog-protocol String "north.semantic-catalog")
(def semantic-protocol-version Int 1)

(defrecord CommandOption
  [flag String
   field Keyword])

(defrecord CommandSpec
  [action String
   kind Keyword
   positional-fields (Vec Keyword)
   required-positional-count Int
   options (Vec CommandOption)
   receipt-fields (Vec Keyword)])

(defrecord ParsedCommand
  [action String
   kind Keyword
   arguments (Map Keyword String)])

(defrecord CommandObservation
  [read-plan Any
   snapshot Any
   catalog Any])

;; B3 owns the ordering of every effect: observe committed Store state, ask the
;; semantic kernel for a pure plan, submit that exact expected-version
;; transaction, then give the canonical result back to the kernel for receipt
;; construction.
(defrecord CommandRuntime
  [observe! (Fn [Int ParsedCommand] Any)
   plan-mutation! (Fn [ParsedCommand Any] Any)
   plan-actions (Fn [Any] (Vec Any))
   plan-expected-version (Fn [Any] Int)
   transact! (Fn [Int (Vec Any) Int] Any)
   mutation-receipt! (Fn [ParsedCommand Any Any] Any)
   render-read! (Fn [ParsedCommand Any] Any)])

(def command-specs (Map String CommandSpec)
  {"track"
   (->CommandSpec "track" :mutation [:title] 1
                  [(->CommandOption "--tracked-by" :tracked-by)]
                  [:referent])
   "plan"
   (->CommandSpec "plan" :mutation [:referent] 1
                  [(->CommandOption "--path" :path)
                   (->CommandOption "--endorsed-by" :endorsed-by)]
                  [:referent :revision])
   "start"
   (->CommandSpec "start" :mutation [:referent] 1
                  [(->CommandOption "--revision" :revision)
                   (->CommandOption "--authorized-by" :authorized-by)
                   (->CommandOption "--signature" :signature)]
                  [:referent :occurrence])
   "assign"
   (->CommandSpec "assign" :mutation [:referent] 1
                  [(->CommandOption "--to" :to)
                   (->CommandOption "--assigned-by" :assigned-by)]
                  [:referent :assignment])
   "request"
   (->CommandSpec "request" :mutation [:about] 0
                  [(->CommandOption "--from" :from)
                   (->CommandOption "--to" :to)
                   (->CommandOption "--body" :body)]
                  [:request])
   "ack"
   (->CommandSpec "ack" :mutation [:request] 1
                  [(->CommandOption "--by" :by)]
                  [:request :ack])
   "result"
   (->CommandSpec "result" :mutation [:request] 1
                  [(->CommandOption "--result" :result)
                   (->CommandOption "--reported-by" :reported-by)
                   (->CommandOption "--outcome" :outcome)
                   (->CommandOption "--summary" :summary)]
                  [:request :result :outcome])
   "ownership"
   (->CommandSpec "ownership" :mutation [] 0
                  [(->CommandOption "--transition" :transition)]
                  [:transition :owner])
   "settle"
   (->CommandSpec "settle" :mutation [:assignment] 1
                  [(->CommandOption "--transition" :accepted-transition)
                   (->CommandOption "--by" :by)
                   (->CommandOption "--outcome" :outcome)
                   (->CommandOption "--summary" :summary)]
                  [:assignment :acceptedTransition :settlement :outcome])
   "show"
   (->CommandSpec "show" :read [:referent] 1 [] [])
   "history"
   (->CommandSpec "history" :read [:referent] 1 [] [])
   "inbox"
   (->CommandSpec "inbox" :read [:actor] 1 [] [])
   "catalog"
   (->CommandSpec "catalog" :catalog [] 0 [] [])})

(def usage-text String
  (str
   "usage: north work <command> ... --json\n"
   "\n"
   "tracked things\n"
   "  track TITLE --tracked-by ACTOR --json\n"
   "  plan TRACKED-THING --path PATH --endorsed-by ACTOR --json\n"
   "  start TRACKED-THING --revision PLAN-REVISION"
   " --authorized-by ACTOR --signature SIGNATURE --json\n"
   "  assign TRACKED-THING --to ACTOR --assigned-by ACTOR --json\n"
   "  request [TRACKED-THING] --from ACTOR --to ACTOR --body BODY --json\n"
   "  ack REQUEST --by ACTOR --json\n"
   "  result REQUEST --result RESULT --reported-by ACTOR"
   " --outcome OUTCOME --summary SUMMARY --json\n"
   "  ownership --transition WORK-OWNERSHIP-V1-JSON --json\n"
   "  settle ASSIGNMENT --transition TRANSITION --by ACTOR"
   " --outcome OUTCOME --summary SUMMARY --json\n"
   "  show TRACKED-THING --json\n"
   "  history TRACKED-THING --json\n"
   "  inbox ACTOR --json\n"
   "  catalog --json\n"
   "\n"
   "views: Agents | Goals | All\n"))

(defn fail!
  [message String
   data Any] Any
  (throw (ex-info message data)))

(defn exact-text!
  [label String
   value Any] String
  (if (and (string? value)
           (not (empty? value))
           (= value (str/trim value))
           (not (str/includes? value "\u0000")))
    value
    (fail! (str label " must be exact nonblank text")
           {:type :invalid-work-command-value :field label})))

(defn- exact-text? [value Any] Bool
  (and (string? value)
       (not (empty? value))
       (= value (str/trim value))
       (not (str/includes? value "\u0000"))))

(defn- command-spec! [action Any] CommandSpec
  (let [action String (exact-text! "command" action)
        spec Any (get command-specs action)]
    (if (some? spec)
      spec
      (fail! "unknown tracked-thing command"
             {:type :unknown-work-command :command action}))))

(defn- add-argument!
  [values (Map Keyword String)
   field Keyword
   label String
   value Any] (Map Keyword String)
  (if (contains? values field)
    (fail! (str label " may appear exactly once")
           {:type :duplicate-work-command-value :field field})
    (assoc values field (exact-text! label value))))

(defn parse-command! [argv (Vec String)] ParsedCommand
  (if (empty? argv)
    (fail! "tracked-thing command is required"
           {:type :missing-work-command})
    (let [spec CommandSpec (command-spec! (first argv))]
      (loop [tokens (Vec String) (vec (rest argv))
             positional-index Int 0
             option-seen? Bool false
             json-seen? Bool false
             values (Map Keyword String) {}]
        (if (empty? tokens)
          (do
            (if (not json-seen?)
              (fail! "--json is required for the stable command protocol"
                     {:type :missing-json-protocol :command (:action spec)})
              true)
            (if (or (< positional-index (:required-positional-count spec))
                    (> positional-index (count (:positional-fields spec))))
              (fail! "tracked-thing command has the wrong positional arity"
                     {:type :invalid-work-command-arity
                      :command (:action spec)})
              true)
            (let [missing (Vec CommandOption) (filterv
                          (fn [option CommandOption] Bool
                            (not (contains? values (:field option))))
                          (:options spec))]
              (if (seq missing)
                (fail! "tracked-thing command is missing required options"
                       {:type :missing-work-command-options
                        :command (:action spec)
                        :fields (mapv
                                 (fn [option CommandOption] Keyword
                                   (:field option))
                                 missing)})
                (->ParsedCommand (:action spec) (:kind spec) values))))
          (let [token String (first tokens)]
            (cond
              (= token "--json")
              (if json-seen?
                (fail! "--json may appear exactly once"
                       {:type :duplicate-json-protocol})
                (recur (vec (rest tokens)) positional-index true true values))

              (str/starts-with? token "--")
              (let [option CommandOption? (some
                           (fn [candidate CommandOption] Any
                             (when (= token (:flag candidate)) candidate))
                           (:options spec))]
                (if (nil? option)
                  (fail! "unknown tracked-thing command option"
                         {:type :unknown-work-command-option
                          :command (:action spec) :option token})
                  (if (< (count tokens) 2)
                    (fail! "tracked-thing command option requires a value"
                           {:type :missing-work-command-option-value
                            :command (:action spec) :option token})
                    (let [value String (second tokens)]
                      (if (str/starts-with? value "--")
                        (fail! "tracked-thing command option requires a value"
                               {:type :missing-work-command-option-value
                                :command (:action spec) :option token})
                        (recur (vec (drop 2 tokens))
                               positional-index
                               true
                               json-seen?
                               (add-argument! values (:field option)
                                              token value)))))))

              option-seen?
              (fail! "positional values must precede tracked-thing options"
                     {:type :misplaced-work-command-value
                      :command (:action spec) :value token})

              (>= positional-index (count (:positional-fields spec)))
              (fail! "tracked-thing command has too many positional values"
                     {:type :invalid-work-command-arity
                      :command (:action spec)})

              :else
              (let [field Keyword (nth (:positional-fields spec)
                                       positional-index)]
                (recur (vec (rest tokens))
                       (inc positional-index)
                       false
                       json-seen?
                       (add-argument! values field (name field) token))))))))))

(defn command-argument!
  [command ParsedCommand
   field Keyword] String
  (let [value Any (get (:arguments command) field)]
    (if (string? value)
      value
      (fail! "parsed command omitted a required value"
             {:type :malformed-parsed-command
              :command (:action command) :field field}))))

(defn mutation-command? [command ParsedCommand] Bool
  (= :mutation (:kind command)))

(defn catalog-command? [command ParsedCommand] Bool
  (= :catalog (:kind command)))

(defn- exact-map-keys?
  [value Any
   expected Any] Bool
  (and (map? value) (= expected (set (keys value)))))

(defn- nonnegative-store-version? [value Any] Bool
  (and (integer? value) (not (neg? value))))

(defn- required-receipt-id!
  [receipt Any
   field Keyword] String
  (exact-text! (name field) (get receipt field)))

(defn- mutation-receipt-fields
  [spec CommandSpec
   command ParsedCommand
   receipt Any] (Vec Keyword)
  (if (or (and (= "request" (:action command))
               (contains? (:arguments command) :about))
          (and (= "result" (:action command))
               (map? receipt)
               (contains? receipt :referent)))
    (conj (:receipt-fields spec) :referent)
    (:receipt-fields spec)))

(defn validate-mutation-receipt!
  [command ParsedCommand
   receipt Any] Any
  (let [spec CommandSpec (command-spec! (:action command))
        receipt-fields (Vec Keyword) (mutation-receipt-fields spec command receipt)
        expected Any (set (concat [:protocol :version :action :storeVersion]
                                  receipt-fields))]
    (if (and (mutation-command? command)
             (exact-map-keys? receipt expected)
             (= semantic-receipt-protocol (:protocol receipt))
             (= semantic-protocol-version (:version receipt))
             (= (:action command) (:action receipt))
             (nonnegative-store-version? (:storeVersion receipt)))
      (do
        (doseq [field receipt-fields]
          (required-receipt-id! receipt field))
        receipt)
      (fail! "semantic mutation returned an invalid committed receipt"
             {:type :invalid-semantic-receipt
              :command (:action command)}))))

(defn- validate-read-receipt!
  [command ParsedCommand
   receipt Any] Any
  (let [action String (:action command)
        expected Any (cond
          (= action "show") #{:protocol :version :referent :facts :derived}
          (= action "history") #{:protocol :version :referent :occurrences}
          (= action "inbox") #{:protocol :version :actor :requests}
          :else #{})
        protocol String (cond
          (= action "show") semantic-view-protocol
          (= action "history") semantic-history-protocol
          (= action "inbox") semantic-inbox-protocol
          :else "")
        identity-field Keyword (if (= action "inbox") :actor :referent)
        collection-field Keyword (cond
          (= action "show") :facts
          (= action "history") :occurrences
          :else :requests)]
    (if (and (not (mutation-command? command))
             (exact-map-keys? receipt expected)
             (= protocol (:protocol receipt))
             (= semantic-protocol-version (:version receipt))
             (vector? (get receipt collection-field))
             (or (not= action "show") (vector? (:derived receipt))))
      (do
        (required-receipt-id! receipt identity-field)
        receipt)
      (fail! "semantic read returned an invalid committed view"
             {:type :invalid-semantic-read :command action}))))

(def catalog-row-fields Any
  #{:id :title :desiredOutcome :agent :work :plan :project :task
    :assignee :assigneeTitle :status})

(defn- nullable-string? [value Any] Bool
  (or (nil? value) (string? value)))

(defn- valid-catalog-row? [row Any] Bool
  (and (exact-map-keys? row catalog-row-fields)
       (exact-text? (:id row))
       (exact-text? (:title row))
       (nullable-string? (:desiredOutcome row))
       (boolean? (:agent row))
       (boolean? (:work row))
       (boolean? (:plan row))
       (boolean? (:project row))
       (boolean? (:task row))
       (nullable-string? (:assignee row))
       (nullable-string? (:assigneeTitle row))
       (nullable-string? (:status row))))

(defn validate-catalog-receipt! [receipt Any] Any
  (let [expected Any #{:protocol :version :storeSpace :storeVersion :trackedThings}
        rows Any (:trackedThings receipt)
        ids Any (if (vector? rows)
          (mapv (fn [row Any] Any (:id row)) rows)
          [])]
    (if (and (exact-map-keys? receipt expected)
             (= semantic-catalog-protocol (:protocol receipt))
             (= semantic-protocol-version (:version receipt))
             (exact-text? (:storeSpace receipt))
             (nonnegative-store-version? (:storeVersion receipt))
             (vector? rows)
             (every? valid-catalog-row? rows)
             (= ids (vec (sort ids)))
             (= (count ids) (count (set ids))))
      receipt
      (fail! "semantic catalog returned an invalid committed view"
             {:type :invalid-semantic-catalog}))))

(defn- fresh-id [kind String] String
  (str "@" kind ":" (java.util.UUID/randomUUID)))

(def preallocated-occurrence-fields (Map String Keyword)
  {"request" :request-occurrence
   "ack" :ack-occurrence
   "settle" :settlement-occurrence})

(defn- prepare-command! [command ParsedCommand] ParsedCommand
  (let [field Any (get preallocated-occurrence-fields (:action command))]
    (if (keyword? field)
      (assoc command :arguments
             (assoc (:arguments command) field (fresh-id "occurrence")))
      command)))

(defn invoke-command!
  [runtime CommandRuntime
   port Int
   command ParsedCommand] Any
  (let [command ParsedCommand (prepare-command! command)
        observation Any ((:observe! runtime) port command)]
    (cond
      (mutation-command? command)
      (let [plan Any ((:plan-mutation! runtime) command observation)
            actions (Vec Any) ((:plan-actions runtime) plan)
            expected-version Int ((:plan-expected-version runtime) plan)
            committed Any ((:transact! runtime) port actions expected-version)
            receipt Any ((:mutation-receipt! runtime) command plan committed)]
        (validate-mutation-receipt! command receipt))

      (catalog-command? command)
      (validate-catalog-receipt!
       ((:render-read! runtime) command observation))

      :else
      (validate-read-receipt!
       command ((:render-read! runtime) command observation)))))

(defn render-command-json!
  [runtime CommandRuntime
   port Int
   argv (Vec String)] String
  (str (json/generate-string
        (invoke-command! runtime port (parse-command! argv)))
       "\n"))

(defn coordination-port! [] Int
  (let [parsed Any (parse-long (or (System/getenv "NORTH_PORT") "7977"))]
    (if (and (integer? parsed) (<= 1 parsed 65535))
      (int parsed)
      (fail! "NORTH_PORT must be an integer from 1 through 65535"
             {:type :invalid-coordination-port}))))

(def work-cli-dir Any (.getParentFile (io/file *file*)))
(def work-root Any (.getParentFile work-cli-dir))
(def runtime-module-paths (Map String String)
  {"north.coord" (str work-cli-dir "/coord.clj")
   "north.referents" (str work-root "/src/north/referents.clj")
   "north.work-occurrences" (str work-root "/src/north/work_occurrences.clj")
   "north.work-catalog" (str work-cli-dir "/work-catalog.clj")})

(def runtime-loaded-modules (Atom Any) (atom #{}))

(defn- load-runtime-module! [module String] Nil
  (do
    (when-not (contains? @runtime-loaded-modules module)
      (let [path Any (get runtime-module-paths module)]
        (when-not (and (string? path) (.isFile (io/file path)))
          (fail! "semantic runtime module is unavailable"
                 {:type :semantic-runtime-module-unavailable
                  :namespace module
                  :path path}))
        (clojure.core/load-file path)
        (swap! runtime-loaded-modules conj module)))
    nil))

(defn- ensure-runtime-loaded! [namespace String] Nil
  (do
    (cond
      (= "north.coord" namespace)
      (load-runtime-module! "north.coord")

      (= "store.types" namespace)
      (load-runtime-module! "north.coord")

      (= "north.work-occurrences" namespace)
      (doseq [module String
              ["north.coord" "north.referents" "north.work-occurrences"]]
        (load-runtime-module! module))

      (= "north.work-catalog" namespace)
      (doseq [module String
              ["north.coord" "north.referents" "north.work-catalog"]]
        (load-runtime-module! module))

      :else
      (fail! "semantic runtime namespace is unavailable"
             {:type :semantic-runtime-namespace-unavailable
              :namespace namespace}))
    nil))

(defn- runtime-function!
  [namespace String
   operation String] Any
  (do
    (ensure-runtime-loaded! namespace)
    (let [resolved Any (clojure.core/ns-resolve (symbol namespace) (symbol operation))]
      (if (some? resolved)
        (clojure.core/var-get resolved)
        (fail! "semantic runtime function is unavailable"
               {:type :semantic-runtime-function-unavailable
                :namespace namespace
                :operation operation})))))

(defn- runtime-call!
  [namespace String
   operation String
   arguments (Vec Any)] Any
  (apply (runtime-function! namespace operation) arguments))

(defn- work-call!
  [operation String
   arguments (Vec Any)] Any
  (runtime-call! "north.work-occurrences" operation arguments))

(defn- coord-call!
  [operation String
   arguments (Vec Any)] Any
  (runtime-call! "north.coord" operation arguments))

(defn- now-text [] String
  (str (java.time.Instant/now)))

(defn- query-variable [name String] Any
  {:var name})

(defn- triple-literal
  [subject Any
   predicate Any
   value Any] Any
  {:rel "triple" :args [subject predicate value]})

(defn- query-rule
  [relation String
   subject Any
   predicate Any
   value Any
   body (Vec Any)] Any
  {:head {:rel relation :args [subject predicate value]}
   :body body})

(defn- direct-subject-rules
  [relation String
   subjects (Vec String)
   predicates (Vec String)] (Vec Any)
  (vec
   (for [subject subjects
         predicate predicates]
     (let [value Any (query-variable "value")]
       (query-rule relation subject predicate value
                   [(triple-literal subject predicate value)])))))

(defn- anchored-rules
  [relation String
   anchor String
   identity String
   predicates (Vec String)] (Vec Any)
  (vec
   (for [predicate predicates]
     (let [subject Any (query-variable "subject")
           value Any (query-variable "value")]
       (query-rule
        relation subject predicate value
        [(triple-literal subject anchor identity)
         (triple-literal subject predicate value)])))))

(defn- followed-subject-rules
  [relation String
   subjects (Vec String)
   follow-predicates (Vec String)
   followed-predicates (Vec String)] (Vec Any)
  (vec
   (for [subject subjects
         follow-predicate follow-predicates
         followed-predicate followed-predicates]
     (let [followed Any (query-variable "followed")
           value Any (query-variable "value")]
       (query-rule
        relation followed followed-predicate value
        [(triple-literal subject follow-predicate followed)
         (triple-literal followed followed-predicate value)])))))

(defn- followed-anchor-rules
  [relation String
   anchor String
   identity String
   follow-predicates (Vec String)
   followed-predicates (Vec String)] (Vec Any)
  (vec
   (for [follow-predicate follow-predicates
         followed-predicate followed-predicates]
     (let [subject Any (query-variable "subject")
           followed Any (query-variable "followed")
           value Any (query-variable "value")]
       (query-rule
        relation followed followed-predicate value
        [(triple-literal subject anchor identity)
         (triple-literal subject follow-predicate followed)
         (triple-literal followed followed-predicate value)])))))

(defn- read-plan-query! [plan Any] Any
  (let [relation String "north_work_snapshot"
        mode Any (:mode plan)
        identity String (exact-text! "read identity" (:identity plan))
        subjects (Vec String) (:subjects plan)
        predicates (Vec String) (:predicates plan)
        follow-predicates (Vec String) (:follow-predicates plan)
        followed-predicates (Vec String) (:followed-predicates plan)
        rules (Vec Any) (cond
          (= :subjects mode)
          (vec
           (concat
            (direct-subject-rules relation subjects predicates)
            (followed-subject-rules relation subjects follow-predicates
                                    followed-predicates)))

          (= :about mode)
          (vec
           (concat
            (anchored-rules relation "about" identity predicates)
            (followed-anchor-rules relation "about" identity
                                   follow-predicates followed-predicates)))

          (= :inbox mode)
          (vec
           (concat
            (anchored-rules relation "to" identity predicates)
            (followed-anchor-rules relation "to" identity
                                   follow-predicates followed-predicates)))

          :else
          (fail! "semantic read plan has an unsupported mode"
                 {:type :invalid-semantic-read-plan
                  :mode mode}))]
    {:find relation :rules rules}))

(defn- snapshot-triple! [row Any] Any
  (if (and (vector? row)
           (= 3 (count row))
           (every? string? row))
    (runtime-call! "store.types" "triple" row)
    (fail! "semantic Store query returned a malformed fact"
           {:type :malformed-semantic-store-fact
            :row row})))

(defn- coordination-store-space! [port Int] String
  (let [status Any (coord-call! "status!" [port])]
    (exact-text! "coordination Store space" (:space-id status))))

(defn- execute-read-plan!
  [port Int
   plan Any] Any
  (let [limit Any (:limit plan)]
    (when-not (and (integer? limit) (pos? limit))
      (fail! "semantic read plan has an invalid row bound"
             {:type :invalid-semantic-read-plan
              :limit limit}))
    (let [store-space String (coordination-store-space! port)
          response Any (coord-call! "bounded-query!"
                       [port (read-plan-query! plan) limit])
          store-version Any (:served-version response)
          rows Any (:rows response)]
      (when-not (vector? rows)
        (fail! "semantic Store query omitted its fact rows"
               {:type :malformed-semantic-store-read}))
      (work-call! "canonical-snapshot!"
                  [store-space store-version
                   (mapv snapshot-triple! rows)]))))

(defn- command-read-plan! [command ParsedCommand] Any
  (let [action String (:action command)]
    (cond
      (= "request" action)
      (work-call! "request-read-plan!"
                  [(command-argument! command :request-occurrence)])

      (= "start" action)
      (work-call! "start-read-plan!"
                  [(command-argument! command :referent)
                   (command-argument! command :revision)])

      (= "ack" action)
      (work-call! "ack-read-plan!"
                  [(command-argument! command :request)
                   (command-argument! command :ack-occurrence)])

      (= "result" action)
      (work-call! "result-read-plan!"
                  [(command-argument! command :request)
                   (command-argument! command :result)])

      (= "settle" action)
      (work-call! "settle-read-plan!"
                  [(command-argument! command :assignment)
                   (command-argument! command :accepted-transition)
                   (command-argument! command :settlement-occurrence)])

      (= "show" action)
      (work-call! "show-read-plan!"
                  [(command-argument! command :referent)])

      (= "history" action)
      (work-call! "history-read-plan!"
                  [(command-argument! command :referent)])

      (= "inbox" action)
      (work-call! "inbox-read-plan!"
                  [(command-argument! command :actor)])

      :else nil)))

(defn- observe-command!
  [port Int
   command ParsedCommand] CommandObservation
  (if (catalog-command? command)
    (->CommandObservation
     nil nil
     (runtime-call! "north.work-catalog" "catalog-envelope!" [port]))
    (let [read-plan Any (command-read-plan! command)
          snapshot Any (if (some? read-plan)
            (execute-read-plan! port read-plan)
            (work-call! "canonical-snapshot!"
                        [(coordination-store-space! port)
                         (coord-call! "cur-ver!" [port]) []]))]
      (->CommandObservation read-plan snapshot nil))))

(defn- plan-command-mutation!
  [command ParsedCommand
   observation Any] Any
  (let [action String (:action command)
        snapshot Any (:snapshot observation)
        occurred-at String (now-text)]
    (cond
      (= "track" action)
      (work-call! "track-plan!"
                  [(fresh-id "referent")
                   (command-argument! command :title)
                   (command-argument! command :tracked-by)
                   occurred-at snapshot])

      (= "plan" action)
      (work-call! "plan-revision-plan!"
                  [(command-argument! command :referent)
                   (fresh-id "occurrence")
                   (command-argument! command :path)
                   (command-argument! command :endorsed-by)
                   occurred-at snapshot])

      (= "start" action)
      (let [referent String (command-argument! command :referent)
            revision String (command-argument! command :revision)
            plan Any (work-call! "decode-plan-snapshot!"
                        [snapshot referent revision])]
        (work-call! "start-plan!"
                    [(fresh-id "occurrence") plan revision
                     (command-argument! command :authorized-by)
                     (command-argument! command :signature)
                     occurred-at snapshot]))

      (= "assign" action)
      (work-call! "assignment-plan!"
                  [(fresh-id "occurrence")
                   (command-argument! command :referent)
                   (command-argument! command :assigned-by)
                   (command-argument! command :to)
                   occurred-at snapshot])

      (= "request" action)
      (work-call! "request-plan!"
                  [(command-argument! command :request-occurrence)
                   (get (:arguments command) :about)
                   (command-argument! command :from)
                   (command-argument! command :to)
                   (command-argument! command :body)
                   occurred-at snapshot])

      (= "ack" action)
      (let [request Any (work-call! "decode-request-snapshot!"
                        [snapshot (command-argument! command :request)])]
        (work-call! "ack-plan!"
                    [(command-argument! command :ack-occurrence) request
                     (command-argument! command :by) occurred-at snapshot]))

      (= "result" action)
      (let [request Any (work-call! "decode-request-snapshot!"
                        [snapshot (command-argument! command :request)])]
        (work-call! "result-plan!"
                    [(command-argument! command :result) request
                     (command-argument! command :reported-by)
                     (command-argument! command :outcome)
                     (command-argument! command :summary)
                     occurred-at snapshot]))

      (= "ownership" action)
      (let [transition Any (work-call! "decode-ownership-transition!"
                        [(json/parse-string
                          (command-argument! command :transition))])]
        (work-call! "ownership-transition-plan!"
                    [(fresh-id "occurrence") transition occurred-at
                     snapshot]))

      (= "settle" action)
      (let [assignment Any (work-call! "decode-assignment-snapshot!"
                        [snapshot (command-argument! command :assignment)])
            accepted Any (work-call! "decode-ownership-occurrence!"
                        [snapshot
                         (command-argument! command :accepted-transition)])]
        (work-call! "settlement-plan!"
                    [(command-argument! command :settlement-occurrence)
                     assignment accepted
                     (command-argument! command :by)
                     (command-argument! command :outcome)
                     (command-argument! command :summary)
                     occurred-at snapshot]))

      :else
      (fail! "semantic mutation planner does not support the command"
             {:type :unsupported-semantic-mutation
              :command action}))))

(defn- planned-actions! [plan Any] (Vec Any)
  (let [actions Any (work-call! "publication-actions" [plan])]
    (if (vector? actions)
      actions
      (fail! "semantic mutation plan omitted its Store actions"
             {:type :invalid-semantic-mutation-plan}))))

(defn- planned-version! [plan Any] Int
  (let [options Any (work-call! "publication-options" [plan])
        version Any (:expected-version options)]
    (if (and (= #{:expected-version} (set (keys options)))
             (nonnegative-store-version? version))
      version
      (fail! "semantic mutation plan omitted its exact Store version"
             {:type :invalid-semantic-mutation-plan}))))

(defn- transact-plan!
  [port Int
   actions (Vec Any)
   expected-version Int] Any
  (coord-call! "transact!"
               [port actions {:expected-version expected-version}]))

(defn- committed-receipt!
  [_command ParsedCommand
   plan Any
   committed Any] Any
  (work-call! "semantic-receipt!"
              [plan (work-call! "publication-options" [plan]) committed]))

(defn- render-semantic-read!
  [command ParsedCommand
   observation Any] Any
  (let [action String (:action command)
        read-plan Any (:read-plan observation)
        snapshot Any (:snapshot observation)]
    (cond
      (= "catalog" action) (:catalog observation)
      (= "show" action)
      (work-call! "semantic-view!" [read-plan snapshot])
      (= "history" action)
      (work-call! "semantic-history!" [read-plan snapshot])
      (= "inbox" action)
      (work-call! "semantic-inbox!" [read-plan snapshot])
      :else
      (fail! "semantic read projector does not support the command"
             {:type :unsupported-semantic-read
              :command action}))))

(defn default-runtime! [] CommandRuntime
  (->CommandRuntime observe-command! plan-command-mutation!
                    planned-actions! planned-version! transact-plan!
                    committed-receipt! render-semantic-read!))

(def ^:dynamic *command-runtime* CommandRuntime (default-runtime!))

(defn run-cli! [argv (Vec String)] Any
  (if (or (= argv ["help"]) (= argv ["--help"]))
    (print usage-text)
    (print (render-command-json! *command-runtime*
                                 (coordination-port!)
                                 argv))))

(def script-file String (.getCanonicalPath (io/file *file*)))

(defn- direct-invocation? [] Bool
  (let [candidate Any (System/getProperty "babashka.file")]
    (and (string? candidate)
         (= script-file (.getCanonicalPath (io/file candidate))))))

(when (direct-invocation?)
  (try
    (run-cli! (vec *command-line-args*))
    (catch Exception error
      (do
        (binding [*out* *err*]
          (println (str "north work: " (.getMessage error))))
        (System/exit 2)))))
