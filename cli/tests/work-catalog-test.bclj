#lang beagle/clj

(ns north.work-catalog-test
  (:require [clojure.java.io :as io]
            [north.projections :as proj]
            [north.referents :as referents]
            [store.types :as t]))

(declare-extern load-file (Fn [String] Any))
(declare-extern ns-resolve (Fn [Any Any] Any))
(declare-extern with-redefs-fn (Fn [(Map Any Any) (Fn [] Any)] Any))
(declare-extern north.coord/live-facts-view! (Fn [Int] Any))
(declare-extern north.work-catalog/catalog-envelope
  (Fn [String Int (Vec t/Triple)] Any))
(declare-extern north.work-catalog/catalog-envelope! (Fn [Int] Any))

(def test-file Any (.getCanonicalPath (io/file *file*)))
(def tests-dir Any (.getParentFile (io/file test-file)))
(def cli-dir Any (.getParentFile tests-dir))
(load-file (str cli-dir "/coord.clj"))
(load-file (str cli-dir "/work-catalog.clj"))

(def live-facts-view-var Any
  (or (ns-resolve (symbol "north.coord") (symbol "live-facts-view!"))
      (throw
       (ex-info
        "north.coord/live-facts-view! is unavailable"
        {:type :missing-test-var}))))

(def telemetry-partition-enabled-var Any
  (or (ns-resolve (symbol "north.coord")
                  (symbol "telemetry-partition-enabled?"))
      (throw (ex-info "coord telemetry selector is unavailable"
                      {:type :missing-test-var}))))

(def with-client-var Any
  (or (ns-resolve (symbol "north.coord") (symbol "with-client!"))
      (throw (ex-info "coord client boundary is unavailable"
                      {:type :missing-test-var}))))

(def scan-all-var Any
  (or (ns-resolve (symbol "north.store-rpc-client") (symbol "scan-all!"))
      (throw (ex-info "Store scan boundary is unavailable"
                      {:type :missing-test-var}))))

(defrecord Check
  [label String
   passed Bool])

(def checks (Atom (Vec Check)) (atom []))

(defn check!
  [label String
   passed Any] Nil
  (do
    (swap! checks conj (->Check label (boolean passed)))
    nil))

(defn denied-type [operation (Fn [] Any)] (U Keyword Nil)
  (try
    (do (operation) nil)
    (catch Throwable error (:type (ex-data error)))))

(def tracker String "@agent:tracker")
(def worker String "@agent:worker")
(def goal String "@tracked:goal")
(def plan String "@tracked:plan")
(def plain String "@tracked:plain")
(def revision String "@occurrence:revision")
(def start String "@occurrence:start")
(def assignment String "@occurrence:assignment")
(def request String "@occurrence:request")

(def catalog-facts (Vec t/Triple)
  (vec
   (concat
    (referents/tracked-thing-facts!
     tracker "Tracker" tracker "2026-08-30T10:00:00Z")
    (referents/agent-role-facts! tracker)
    (referents/tracked-thing-facts!
     worker "Worker" tracker "2026-08-30T10:00:01Z")
    (referents/agent-role-facts! worker)
    (referents/tracked-thing-facts!
     goal "Goal" tracker "2026-08-30T10:00:02Z")
    (referents/desired-outcome-facts! goal "Ship the catalog")
    (referents/tracked-thing-facts!
     plan "Plan" tracker "2026-08-30T10:00:03Z")
    (referents/plan-revision-facts!
     plan revision "Implement the catalog" tracker
     "2026-08-30T10:01:00Z")
    (referents/start-facts!
     start plan revision tracker "sig:accepted"
     "2026-08-30T10:02:00Z")
    (referents/assignment-facts!
     assignment plan tracker worker "2026-08-30T10:03:00Z")
    (referents/tracked-thing-facts!
     plain "Plain" tracker "2026-08-30T10:00:04Z")
    (referents/occurrence-facts!
     request "request" tracker "2026-08-30T10:04:00Z")
    (referents/occurrence-about-facts! request plan))))

(def envelope Any
  (north.work-catalog/catalog-envelope
   "catalog-test" 42 catalog-facts))
(def rows (Vec Any) (:trackedThings envelope))
(def rows-by-id Any
  (into {} (map (fn [row Any] Any [(:id row) row]) rows)))
(def plan-row Any (get rows-by-id plan))
(def goal-row Any (get rows-by-id goal))
(def plain-row Any (get rows-by-id plain))

(check! "catalog envelope uses the exact protocol keys"
        (= #{:protocol :version :storeSpace :storeVersion :trackedThings}
           (set (keys envelope))))
(check! "catalog envelope binds one Store space and committed version"
        (and (= "north.semantic-catalog" (:protocol envelope))
             (= 1 (:version envelope))
             (= "catalog-test" (:storeSpace envelope))
             (= 42 (:storeVersion envelope))))
(check! "tracked rows use the exact public key set"
        (every?
         (fn [row Any] Bool
           (= #{:id :title :desiredOutcome :agent :work :plan :project :task
                :assignee :assigneeTitle :status}
              (set (keys row))))
         rows))
(check! "every tracked identity appears once in deterministic order"
        (= (vec (sort [tracker worker goal plan plain]))
           (mapv (fn [row Any] String (:id row)) rows)))
(check! "occurrence identities never appear as catalog rows"
        (empty?
         (filterv
          (fn [id String] Bool
            (contains? #{revision start assignment request} id))
          (mapv (fn [row Any] String (:id row)) rows))))
(check! "Goal derives only from a nonblank desired outcome"
        (and (= "Ship the catalog" (:desiredOutcome goal-row))
             (= false (:plan goal-row))
             (= nil (:desiredOutcome plain-row))))
(check! "Plan, Project, Task, and Assignment stay on one tracked identity"
        (and (= true (:work plan-row))
             (= true (:plan plan-row))
             (= true (:project plan-row))
             (= true (:task plan-row))
             (= worker (:assignee plan-row))
             (= "Worker" (:assigneeTitle plan-row))
             (= nil (:status plan-row))))
(check! "Agents are tracked identities playing the agent role"
        (and (= true (:agent (get rows-by-id tracker)))
             (= true (:agent (get rows-by-id worker)))
             (= false (:work goal-row))
             (= false (:agent plan-row))))

(check! "blank Store space is rejected"
        (= :north/invalid-semantic-catalog
           (denied-type
            (fn [] Any
              (north.work-catalog/catalog-envelope
               "" 42 catalog-facts)))))
(check! "negative Store version is rejected"
        (= :north/invalid-semantic-catalog
           (denied-type
            (fn [] Any
              (north.work-catalog/catalog-envelope
               "catalog-test" -1 catalog-facts)))))

(def missing-title-facts (Vec t/Triple)
  (filterv
   (fn [fact t/Triple] Bool
     (not (and (= plain (t/triple-t1 fact))
               (= "title" (t/triple-t2 fact)))))
   catalog-facts))

(check! "a tracked thing without one display title is rejected"
        (= :north/invalid-semantic-catalog
           (denied-type
            (fn [] Any
              (north.work-catalog/catalog-envelope
               "catalog-test" 42 missing-title-facts)))))

(def whitespace-identity-facts (Vec t/Triple)
  [(t/triple "   " "entity_kind" "referent")
   (t/triple "   " "title" "Whitespace identity")])

(check! "a whitespace-only tracked identity is rejected"
        (= :north/invalid-semantic-catalog
           (denied-type
            (fn [] Any
              (north.work-catalog/catalog-envelope
               "catalog-test" 42 whitespace-identity-facts)))))

(def second-assignment String "@occurrence:assignment-2")
(def ambiguous-assignment-facts (Vec t/Triple)
  (vec
   (concat
    catalog-facts
    (referents/assignment-facts!
     second-assignment plan tracker tracker "2026-08-30T10:05:00Z"))))

(check! "multiple complete Assignments are rejected instead of selected"
        (= :north/invalid-semantic-catalog
           (denied-type
            (fn [] Any
              (north.work-catalog/catalog-envelope
               "catalog-test" 43 ambiguous-assignment-facts)))))

(defn fact-row [fact t/Triple] (Vec String)
  [(t/triple-t1 fact) (t/triple-t2 fact) (t/triple-t3 fact)])

(let [bridge-command t/Triple (t/triple
       (str "@bridge-command:" (apply str (repeat 64 "a")) ":1")
       "bridge.command/ordinal"
       1)]
  (with-redefs-fn
   {telemetry-partition-enabled-var (fn [] Bool false)
    with-client-var
    (fn
      [_port Any
       _domain Any
       operation Any] Any
      (operation :fixture-client))
    scan-all-var
    (fn
      [_client Any
       _t1 Any
       _t2 Any
       _t3 Any
       _options Any] Any
      {:served-version 76 :rows (conj catalog-facts bridge-command)})}
   (fn [] Any
     (let [view Any (north.coord/live-facts-view! 43123)
           effectful Any (north.work-catalog/catalog-envelope! 43123)]
       (check! "typed Bridge command receipts stay outside the string catalog projection"
               (and (:complete view)
                    (= (mapv fact-row catalog-facts) (:facts view))))
       (check! "typed Bridge command receipts do not make the effectful catalog unavailable"
               (= (mapv (fn [row Any] String (:id row)) rows)
                  (mapv (fn [row Any] String (:id row))
                        (:trackedThings effectful))))))))

(let [seen-port (Atom Int) (atom 0)]
  (with-redefs-fn
   {live-facts-view-var
    (fn [port Int] Any
      (do
        (reset! seen-port port)
        {:domains
         {:coordination
          {:available true
           :version 77
           :facts (mapv fact-row catalog-facts)}}}))}
   (fn [] Any
     (let [effectful Any (north.work-catalog/catalog-envelope! 43123)]
       (check! "effectful entry projects the exact coordination snapshot"
               (and (= 43123 @seen-port)
                    (= "north-coordination" (:storeSpace effectful))
                    (= 77 (:storeVersion effectful))
                    (= (mapv (fn [row Any] String (:id row)) rows)
                       (mapv
                        (fn [row Any] String (:id row))
                        (:trackedThings effectful)))))))))

(check! "effectful entry rejects an unavailable Store snapshot"
        (= :north/semantic-catalog-store-unavailable
           (with-redefs-fn
            {live-facts-view-var
             (fn [_port Int] Any
               {:domains
                {:coordination
                 {:available false :error "fixture unavailable"}}})}
            (fn [] Any
              (denied-type
               (fn [] Any
                 (north.work-catalog/catalog-envelope! 43123)))))))

(let [results (Vec Check) @checks
      passed Int (count
       (filter
        (fn [result Check] Bool (check-passed result))
        results))]
  (doseq [result Check results]
    (println
     (format "  [%s] %s"
             (if (check-passed result) "PASS" "FAIL")
             (check-label result))))
  (println
   (format "\nWork catalog B5a: %d / %d PASS"
           passed (count results)))
  (System/exit (if (= passed (count results)) 0 1)))
