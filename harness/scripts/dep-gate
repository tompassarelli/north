#!/usr/bin/env python3
import json
import posixpath
import re
import ssl
import subprocess
import sys
import tomllib
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from datetime import datetime, timezone
from http.client import HTTPException, HTTPSConnection
from threading import Lock, local
from time import monotonic, sleep
from urllib.parse import quote, unquote, urlsplit


TRAILER_FORMAT = "Dependency: <name> — <reason> (ASCII - also accepted)"
MANIFESTS = {"package.json", "Cargo.toml", "pyproject.toml"}
LOCKS = {"bun.lock", "Cargo.lock", "flake.lock"}
COOLDOWN = 7 * 24 * 60 * 60
URGENT_FORMAT = "Dependency-Urgent: <name>@<version> <advisory-id>; flakes use node@locked.rev (otherwise locked.version or locked.narHash)"


@dataclass(frozen=True)
class Dependency:
    name: str
    source: str
    allowed: bool


@dataclass(frozen=True)
class LockCandidate:
    path: str
    ecosystem: str
    name: str
    version: str
    published: int | None = None

    @property
    def identity(self):
        return self.ecosystem, self.name, self.version


def table(value):
    if not isinstance(value, dict):
        raise ValueError("expected dependency table")
    return value


def string(value):
    if not isinstance(value, str) or not value.strip() or any(ord(c) < 32 for c in value):
        raise ValueError("expected nonempty dependency string")
    return value.strip()


def internal_path(path, manifest):
    path = unquote(string(path))
    if path.startswith(("/", "~")) or "\\" in path:
        return False
    resolved = posixpath.normpath(posixpath.join(posixpath.dirname(manifest), path))
    return resolved != ".." and not resolved.startswith("../")


def owned_github(source):
    source = source.removeprefix("git+")
    if re.fullmatch(r"tompassarelli/[^/#\s]+(?:#\S+)?", source):
        return True
    if source.startswith("github:"):
        return bool(re.fullmatch(r"github:tompassarelli/[^/#\s]+(?:#\S+)?", source))
    if source.startswith("git@github.com:"):
        source = "ssh://git@github.com/" + source[len("git@github.com:"):]
    parsed = urlsplit(source)
    parts = unquote(parsed.path).strip("/").split("/")
    return (parsed.scheme in {"https", "http", "ssh", "git"}
            and parsed.hostname == "github.com" and parsed.port in {None, 22, 80, 443}
            and len(parts) >= 2 and parts[0] == "tompassarelli" and bool(parts[1])
            and all(part not in {".", ".."} for part in parts))


def source_dependency(name, source, manifest, kind="npm"):
    name, source = string(name), string(source)
    if kind == "path":
        return Dependency(name, "path:" + source, internal_path(source, manifest))
    if source.startswith("workspace:"):
        value = source[len("workspace:"):]
        if value.startswith((".", "/", "~")):
            allowed = internal_path(value, manifest)
        else:
            allowed = bool(re.fullmatch(r"(?:\*|[~^]|[~^]?\d[^\s]*|@?[^\s:/]+(?:/[^\s:/]+)?@(?:\*|[~^]|[~^]?\d[^\s]*))", value))
        if not allowed:
            raise ValueError("invalid workspace relationship")
        return Dependency(name, source, True)
    if source.startswith("file:"):
        path = source[len("file:"):]
        resolved = posixpath.normpath(unquote(path))
        allowed = (internal_path(path, manifest) and resolved.startswith("vendor/") and not path.startswith("/"))
        return Dependency(name, source, allowed)
    if owned_github(source):
        return Dependency(name, source, True)
    if kind == "url" or re.search(r"[:/\\]", source) or source.startswith((".", "~")) or source.endswith((".tgz", ".tar.gz", ".tar", ".zip")):
        if source.startswith("npm:") and re.fullmatch(r"npm:(?:@[^/\s]+/)?[^@\s]+@[^\s:/]+", source):
            return Dependency(name, "registry", True)
        return Dependency(name, source, False)
    if not re.fullmatch(r"[A-Za-z0-9*^~<>=|+!., -]+", source):
        raise ValueError("unknown dependency specifier")
    return Dependency(name, "registry", True)


def declared_dependency(name, value, manifest, ecosystem):
    if isinstance(value, str):
        return source_dependency(name, value, manifest)
    if ecosystem == "npm":
        raise ValueError("expected npm dependency string")
    value = table(value)
    name = string(value.get("package", name))
    sources = [key for key in ("git", "url", "path", "file", "workspace") if key in value]
    if len(sources) > 1:
        raise ValueError("multiple dependency sources")
    if sources:
        key = sources[0]
        if key == "workspace":
            if value[key] is not True:
                raise ValueError("invalid workspace dependency")
            return Dependency(name, "workspace", True)
        kind = "path" if key == "path" else "url"
        dep = source_dependency(name, value[key], manifest, kind)
        identity = {k: value[k] for k in ("git", "url", "path", "file", "rev", "tag", "branch", "subdirectory") if k in value}
        return Dependency(dep.name, json.dumps(identity, sort_keys=True), dep.allowed)
    if "version" in value:
        string(value["version"])
        return Dependency(name, "registry", True)
    raise ValueError("dependency has no recognized source or version")


def requirement(value, manifest):
    value = string(value)
    match = re.fullmatch(r"([A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)(?:\[[A-Za-z0-9_,. -]+\])?\s*(.*)", value)
    if not match:
        raise ValueError("invalid Python dependency requirement")
    name = re.sub(r"[-_.]+", "-", match[1]).lower()
    tail = match[2].split(";", 1)[0].strip()
    if tail.startswith("@"):
        return source_dependency(name, tail[1:].strip(), manifest, "url")
    if tail and not re.fullmatch(r"\(?\s*(?:===|==|!=|~=|<=|>=|<|>)\s*[A-Za-z0-9*+!._-]+(?:\s*,\s*(?:===|==|!=|~=|<=|>=|<|>)\s*[A-Za-z0-9*+!._-]+)*\s*\)?", tail):
        raise ValueError("unknown Python dependency requirement")
    return Dependency(name, "registry", True)


def requirement_list(values, manifest):
    if not isinstance(values, list):
        raise ValueError("expected dependency list")
    result = []
    for value in values:
        if isinstance(value, dict) and set(value) == {"include-group"}:
            string(value["include-group"])
        else:
            result.append(requirement(value, manifest))
    return result


def dependencies(manifest, text):
    data = table(json.loads(text) if manifest.endswith("package.json") else tomllib.loads(text))
    result = []
    if manifest.endswith("package.json"):
        for section in ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies"):
            for name, value in table(data.get(section, {})).items():
                result.append(declared_dependency(name, value, manifest, "npm"))
    elif manifest.endswith("Cargo.toml"):
        def walk(node):
            for key, value in node.items():
                if key.endswith("dependencies"):
                    for name, spec in table(value).items():
                        result.append(declared_dependency(name, spec, manifest, "cargo"))
                elif isinstance(value, dict):
                    walk(value)
        walk(data)
    else:
        project = table(data.get("project", {}))
        result.extend(requirement_list(project.get("dependencies", []), manifest))
        for values in table(project.get("optional-dependencies", {})).values():
            result.extend(requirement_list(values, manifest))
        result.extend(requirement_list(table(data.get("build-system", {})).get("requires", []), manifest))
        for values in table(data.get("dependency-groups", {})).values():
            result.extend(requirement_list(values, manifest))
        tools = table(data.get("tool", {}))
        poetry = table(tools.get("poetry", {}))
        poetry_tables = [poetry.get("dependencies", {}), poetry.get("dev-dependencies", {})]
        poetry_tables.extend(table(group).get("dependencies", {}) for group in table(poetry.get("group", {})).values())
        for section in poetry_tables:
            for name, value in table(section).items():
                if name.lower() != "python":
                    variants = value if isinstance(value, list) else [value]
                    result.extend(declared_dependency(re.sub(r"[-_.]+", "-", name).lower(), v, manifest, "python") for v in variants)
        for values in table(table(tools.get("pdm", {})).get("dev-dependencies", {})).values():
            result.extend(requirement_list(values, manifest))
        for tool in ("uv", "rye"):
            result.extend(requirement_list(table(tools.get(tool, {})).get("dev-dependencies", []), manifest))
        for env in table(table(tools.get("hatch", {})).get("envs", {})).values():
            result.extend(requirement_list(table(env).get("dependencies", []), manifest))
        for name, value in table(table(tools.get("uv", {})).get("sources", {})).items():
            variants = value if isinstance(value, list) else [value]
            for spec in variants:
                spec = table(spec)
                if "index" in spec:
                    string(spec["index"])
                    if any(key in spec for key in ("git", "url", "path", "workspace")):
                        raise ValueError("multiple Python dependency sources")
                    result.append(Dependency(re.sub(r"[-_.]+", "-", name).lower(), "registry", True))
                else:
                    result.append(declared_dependency(re.sub(r"[-_.]+", "-", name).lower(), spec, manifest, "python"))
    return set(result)


def dependency_reasons(messages):
    reasons = {}
    for message in messages:
        paragraphs = re.split(r"\n\s*\n", message.strip())
        if len(paragraphs) < 2:
            continue
        lines = paragraphs[-1].splitlines()
        if any(not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*:\s+.+", line) for line in lines):
            continue
        for line in lines:
            match = re.fullmatch(r"Dependency:\s+(\S+)\s+(?:—|-)\s+(.+)", line)
            if match and match[2].strip():
                reasons[match[1]] = match[2].strip()
    return reasons


def violations(before, after, reasons):
    result = []
    for manifest in sorted(after):
        old = before.get(manifest, set())
        old_names = {dep.name for dep in old}
        for name in sorted({dep.name for dep in after[manifest]} - old_names - reasons.keys()):
            result.append(f"dep-gate: {manifest}: {name}: added dependency needs a reason")
        for name in sorted({dep.name for dep in after[manifest] - old if not dep.allowed}):
            result.append(f"dep-gate: {manifest}: {name}: forbidden new dependency source; use github.com/tompassarelli/* or file:vendor/…")
    return result


def jsonc(text):
    quoted = r'"(?:[^"\\]|\\.)*"'
    text = re.sub(quoted + r"|//[^\n]*|/\*[\s\S]*?\*/",
                  lambda m: m[0] if m[0].startswith('"') else " ", text)
    text = re.sub(quoted + r"|,\s*(?=[}\]])",
                  lambda m: m[0] if m[0].startswith('"') else "", text)
    return table(json.loads(text))


def locked_versions(path, text):
    result = set()
    if posixpath.basename(path) == "Cargo.lock":
        packages = tomllib.loads(text).get("package", [])
        if not isinstance(packages, list):
            raise ValueError("expected Cargo package list")
        for package in packages:
            package = table(package)
            if string(package.get("source", "local")).startswith("registry+"):
                result.add((string(package["name"]), string(package["version"])))
    else:
        for entry in table(jsonc(text).get("packages", {})).values():
            if not isinstance(entry, list) or not entry:
                raise ValueError("expected Bun package entry")
            resolution = string(entry[0])
            match = re.fullmatch(r"((?:@[^/@\s]+/)?[^/@\s]+)@(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?)", resolution)
            if match:
                result.add((match[1], match[2]))
    return result


def locked_nodes(text):
    return {name: table(node["locked"]) for name, node in table(json.loads(text).get("nodes", {})).items()
            if "locked" in table(node)}


def first_party_flake(locked):
    kind = locked.get("type")
    if kind == "github":
        return str(locked.get("owner", "")).casefold() == "tompassarelli"
    location = str(locked.get("url") if kind == "git" else locked.get("path") if kind == "path" else "")
    return bool(re.match(r"(?:(?:git\+)?https://github\.com/tompassarelli/|(?:git\+)?ssh://git@github\.com/tompassarelli/|(?:git\+)?file:///home/[^/]+/code/|/home/[^/]+/code/)", location, re.I))


def lock_candidates(before, after):
    result = []
    for path in sorted(after):
        if before.get(path) == after[path]:
            continue
        try:
            if posixpath.basename(path) == "flake.lock":
                old = locked_nodes(before[path]) if path in before else {}
                for name, locked in sorted(locked_nodes(after[path]).items()):
                    if old.get(name) != locked and not first_party_flake(locked):
                        version = next((string(locked[key]) for key in ("rev", "version", "narHash") if key in locked), "unknown")
                        timestamp = locked.get("lastModified")
                        result.append(LockCandidate(path, "flake", string(name), version,
                                                    timestamp if type(timestamp) is int else None))
            else:
                old = locked_versions(path, before[path]) if path in before else set()
                ecosystem = "cargo" if posixpath.basename(path) == "Cargo.lock" else "npm"
                result.extend(LockCandidate(path, ecosystem, name, version)
                              for name, version in sorted(locked_versions(path, after[path]) - old))
        except (ValueError, TypeError, KeyError) as error:
            raise ValueError(f"cannot parse {path}: {type(error).__name__}") from error
    return result


def urgent_dependencies(messages):
    result = set()
    for message in messages:
        paragraphs = re.split(r"\n\s*\n", message.strip())
        if len(paragraphs) < 2:
            continue
        lines = paragraphs[-1].splitlines()
        if any(not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*:\s+.+", line) for line in lines):
            continue
        for line in lines:
            match = re.fullmatch(r"Dependency-Urgent:\s+(\S+)@(\S+)\s+(\S+)", line)
            if match:
                result.add((match[1], match[2]))
    return result


def age_violations(candidates, publish_times, now, urgent):
    result = []
    for candidate in candidates:
        published = candidate.published if candidate.ecosystem == "flake" else publish_times.get(candidate.identity)
        identity = f"{candidate.name}@{candidate.version}"
        if published is None and (candidate.ecosystem == "flake" or (candidate.name, candidate.version) not in urgent):
            result.append(f"dep-gate: {candidate.path}: {identity}: missing {'lastModified' if candidate.ecosystem == 'flake' else 'publish time'}")
        elif published is not None and published > now - COOLDOWN and (candidate.name, candidate.version) not in urgent:
            result.append(f"dep-gate: {candidate.path}: {identity}: {'lastModified' if candidate.ecosystem == 'flake' else 'published'} less than 7 days ago")
    return result


class RegistryUnavailable(Exception):
    pass


def publish_times(candidates, urgent):
    identities = sorted({c.identity for c in candidates if c.ecosystem != "flake"
                         and (c.name, c.version) not in urgent})
    if not identities:
        return {}
    context = ssl.create_default_context()
    connections = local()
    opened = []
    groups = {}
    for ecosystem, name, version in identities:
        groups.setdefault((ecosystem, name), []).append(version)
    api_lock = Lock()
    last_api_read = [0.0]

    def read(host, path):
        if not hasattr(connections, "clients"):
            connections.clients = {}
        if host not in connections.clients:
            connection = HTTPSConnection(host, timeout=10, context=context)
            connections.clients[host] = connection
            opened.append(connection)
        connection = connections.clients[host]
        def response_body():
            connection.request("GET", path, headers={"User-Agent": "dep-gate (https://github.com/tompassarelli/north)"})
            response = connection.getresponse()
            body = response.read()
            if response.status != 200:
                raise HTTPException(f"registry HTTP status {response.status}")
            return body
        if host == "crates.io":
            with api_lock:
                sleep(max(0, 1 - (monotonic() - last_api_read[0])))
                last_api_read[0] = monotonic()
                return response_body()
        return response_body()

    def fetch(group):
        ecosystem, name = group
        try:
            if ecosystem == "npm":
                data = json.loads(read("registry.npmjs.org", f"/{quote(name, safe='')}"))["time"]
            else:
                lower = name.lower()
                prefix = (f"{len(lower)}" if len(lower) < 3 else f"3/{lower[0]}" if len(lower) == 3 else f"{lower[:2]}/{lower[2:4]}")
                data = {row["vers"]: row for row in
                        (json.loads(line) for line in read("index.crates.io", f"/{prefix}/{quote(lower, safe='')}").splitlines())}
            result = {}
            for version in groups[group]:
                if ecosystem == "npm":
                    timestamp = data[version]
                else:
                    row = data[version]
                    timestamp = row.get("pubtime")
                    if timestamp is None:
                        timestamp = json.loads(read("crates.io", f"/api/v1/crates/{quote(name, safe='')}/{quote(version, safe='')}"))["version"]["created_at"]
                published = datetime.fromisoformat(string(timestamp).replace("Z", "+00:00"))
                if published.tzinfo is None:
                    raise ValueError("publish time has no timezone")
                result[(ecosystem, name, version)] = published.timestamp()
            return result
        except (HTTPException, OSError, ValueError, TypeError, KeyError) as error:
            raise RegistryUnavailable(f"{ecosystem}: {name}: registry unavailable or invalid publish time; retry ({type(error).__name__})") from error

    try:
        with ThreadPoolExecutor(max_workers=8) as executor:
            return {identity: timestamp for result in executor.map(fetch, groups)
                    for identity, timestamp in result.items()}
    finally:
        for connection in opened:
            connection.close()


def git(*args):
    run = subprocess.run(["git", *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if run.returncode:
        raise ValueError(f"git {args[0]} failed (exit {run.returncode}); check repository and revisions")
    return run.stdout.decode("utf-8")


def read_manifests(revision):
    result = {}
    for path in git("ls-tree", "-r", "--name-only", "-z", revision).split("\0"):
        if path and not path.startswith("repos/") and posixpath.basename(path) in MANIFESTS:
            try:
                result[path] = dependencies(path, git("show", f"{revision}:{path}"))
            except (ValueError, TypeError, KeyError) as error:
                raise ValueError(f"cannot parse {path}: {type(error).__name__}") from error
    return result


def read_locks(revision):
    return {path: git("show", f"{revision}:{path}")
            for path in git("ls-tree", "-r", "--name-only", "-z", revision).split("\0")
            if path and not path.startswith("repos/") and posixpath.basename(path) in LOCKS}


def main(argv):
    if len(argv) != 2:
        print("usage: dep-gate BASE HEAD", file=sys.stderr)
        print(URGENT_FORMAT, file=sys.stderr)
        return 1
    try:
        if git("rev-parse", "--show-prefix").strip():
            raise ValueError("run dep-gate from the repository root")
        base, head = [git("rev-parse", "--verify", "--end-of-options", rev + "^{commit}").strip() for rev in argv]
        before, after = read_manifests(base), read_manifests(head)
        messages = git("log", "--format=%B%x00", f"{base}..{head}").split("\0")
        reasons = dependency_reasons(messages)
        failures = violations(before, after, reasons)
        if failures:
            print("\n".join([*failures, TRAILER_FORMAT]))
            return 1
        candidates = lock_candidates(read_locks(base), read_locks(head))
        urgent = urgent_dependencies(messages)
        times = publish_times(candidates, urgent)
        age_failures = age_violations(candidates, times, datetime.now(timezone.utc).timestamp(), urgent)
        if age_failures:
            print("\n".join([*age_failures, URGENT_FORMAT]))
            return 1
        return 0
    except RegistryUnavailable as error:
        print(f"dep-gate: {error}", file=sys.stderr)
        return 2
    except (ValueError, OSError, UnicodeError) as error:
        print(f"dep-gate: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
