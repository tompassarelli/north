{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "north:agent-catalog/catalog-config.schema.json",
  "title": "North agent catalog configuration",
  "type": "object",
  "required": ["schema", "role", "rootOrder", "registrations", "activation"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "north.agent-catalog-config/v1" },
    "role": { "type": "string" },
    "rootOrder": { "type": "array", "items": { "type": "string" } },
    "baselines": { "type": "object" },
    "providerSupport": { "type": "object" },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "owner"],
        "properties": {
          "kind": { "type": "string" },
          "category": { "type": "string" },
          "owner": {
            "type": "object",
            "required": ["repo"],
            "properties": {
              "repo": { "type": "string" },
              "module": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "activation": { "type": ["object", "array"] }
  }
}
